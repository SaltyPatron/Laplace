-- realize._synset_lemma — GH #862 / #860. No SET, real schema names.
DROP FUNCTION IF EXISTS laplace._realize_synset_lemma(bytea, bytea);
CREATE OR REPLACE FUNCTION realize._synset_lemma(p_id bytea, p_lang bytea DEFAULT NULL)
    RETURNS text
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    -- RANK FIRST, THEN RENDER ONCE FOR ALL CANDIDATES.
    -- The `s <> ''` filter means an unrenderable candidate must fall through to the
    -- next, so the surface cannot be dropped from the decision -- but it does not have
    -- to be produced one candidate at a time. realize.render_text_batch runs ONE
    -- constituents closure over every id (generate_walk.c fetch_constituents_closure
    -- with n_roots); the scalar form ran one closure per candidate. Measured on 40 ids,
    -- identical md5: 487 ms per-row, 106 ms batched.
    -- Ranked in full, not capped: the render filter can reject any prefix, and a LIMIT
    -- here would turn "unrenderable" into "no name".
    WITH ranked AS MATERIALIZED (
        -- The words a source says express the concept: word HAS_SENSE concept.
        -- The language is the binding's (the attestation context), not the word's.
        SELECT hs.subject_id AS id,
               row_number() OVER (ORDER BY EXISTS (
                            SELECT 1 FROM laplace.attestations a
                            WHERE a.subject_id = hs.subject_id AND a.type_id = hs.type_id
                              AND a.object_id = hs.object_id AND a.context_id = p_lang) DESC,
                        consensus.eff_mu(hs.rating, hs.rd) DESC, hs.subject_id) AS rn
        FROM laplace.v_consensus_unrefuted hs
        WHERE hs.object_id = p_id
          AND hs.type_id = laplace.relation_type_id('HAS_SENSE')
    ),
    lbl AS MATERIALIZED (
        SELECT realize.render_text_batch(array_agg(r.id ORDER BY r.rn)) AS s
        FROM ranked r
    )
    SELECT l.s[r.rn]
    FROM ranked r CROSS JOIN lbl l
    WHERE l.s[r.rn] IS NOT NULL AND l.s[r.rn] <> ''
    ORDER BY r.rn
    LIMIT 1;
END;
