<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Laplace.Chess.Uci</RootNamespace>
    <AssemblyName>laplace-uci</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Laplace.Ops carries the shared ops-logging foundation (LaplaceLogging) and pulls in
         the MEL abstractions transitively; Laplace.Core is a direct dependency of Ops. GH #602. -->
    <ProjectReference Include="..\Laplace.Ops\Laplace.Ops.csproj" />
    <ProjectReference Include="..\Laplace.Chess\Laplace.Chess.csproj" />
    <InternalsVisibleTo Include="Laplace.Chess.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pinned engine profiles travel with the binary (ChessEngineCatalog reads them beside it). -->
    <None Include="..\..\deploy\stockfish-profiles.json" Link="stockfish-profiles.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\deploy\lc0-profiles.json" Link="lc0-profiles.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The pinned releases match, ladder and check read (Lab/LabLocks), so a published laplace-uci needs no checkout. -->
    <None Include="..\..\deploy\chess-ladder-release.json" Link="chess-ladder-release.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\deploy\cutechess-release.json" Link="cutechess-release.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\deploy\zstd-release.json" Link="zstd-release.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\deploy\linux\stockfish-release.json" Link="stockfish-release.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
