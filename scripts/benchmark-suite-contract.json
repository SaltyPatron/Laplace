{
  "schema": "laplace.benchmark-suite-contract/v1",
  "registry": "scripts/benchmark-profiles.json",
  "runner": "scripts/benchmark_suite.py",
  "workflow": ".github/workflows/benchmark-evidence.yml",
  "triggers": [
    "workflow_dispatch",
    "explicit workflow_call",
    "push only to verify/chess-acceptance-* operator branches at the exact deployed revision"
  ],
  "source_core_mutability": "none_except_temporary_outputs",
  "artifact_binding": {
    "applies_to": "profiles executing the Laplace native core",
    "core": "build/engine/core/liblaplace_core.so",
    "t0": "build/engine/core/perfcache/laplace_t0_perfcache.bin",
    "require_sha256": true,
    "require_build_tree_loader_precedence": true
  },
  "chess_environment": {
    "profile": "chess-environment",
    "suite": "chess",
    "requires_laplace_core_artifacts": false,
    "require_actual_executable_sha256_and_uci_options": true,
    "require_cpu_affinity_and_cgroup_quota": true,
    "require_memory_budget_and_process_observations": true,
    "require_repeated_raw_measurements": true,
    "require_paired_color_match_records": true,
    "configuration_changes": "explicit operator selection only",
    "strength_claim": "environment throughput measurements do not establish playing strength"
  },
  "scaling": {
    "must_measure": true,
    "may_not_extrapolate_single_worker": true,
    "physical_cores_before_smt": true,
    "require_affinity_receipt": true,
    "require_speedup_and_efficiency": true
  },
  "sparse_complexity": {
    "representative_form": "O(log N)+O(K)",
    "require_N_definition": true,
    "require_K_definition": true,
    "require_address_provider": true,
    "require_actual_selected_algorithm": true,
    "permit_O1_address_provider": true,
    "forbid_unqualified_universal_claim": true
  },
  "accelerators": {
    "semantic_authority": false,
    "world_residency_required": false,
    "require_provider_identity": true,
    "require_selected_K": true,
    "require_transfer_bytes": true,
    "require_device_memory": true,
    "require_result_parity": true
  },
  "power": {
    "psu_nameplate_is_measured_draw": false,
    "rapl_is_whole_system_energy": false,
    "whole_system_requires_admitted_meter": true
  },
  "postgres_geometry": {
    "profile": "postgres-geometry",
    "suite": "geometry",
    "requires_laplace_core_artifacts": false,
    "source": "exact existing unique laplace.physicalities rows with non-null trajectories",
    "requires_logged_tables": true,
    "requires_synchronous_commit": true,
    "requires_exact_committed_binary_readback": true,
    "requires_payload_rows_vertices_bytes": true,
    "requires_full_source_and_target_index_constraint_definitions": true,
    "wal_scope": "cluster-wide LSN deltas include any concurrent unrelated work",
    "measurement_scope": "COPY plus acknowledged synchronous COMMIT; readback separate; no native admission or gameplay claim"
  },
  "recorded_chess": {
    "profile": "recorded-chess",
    "suite": "recorded",
    "requires_collector_core_build": false,
    "requires_complete_normal_games": true,
    "requires_synchronous_commit_and_exact_native_readback": true,
    "requires_duration_qualification_for_capacity_target": true,
    "minimum_duration_seconds": 30,
    "aggregate_denominator": "one enclosing collector wall interval across sequential complete workflows; no sum of stage or overlapping case durations",
    "requires_disjoint_new_playing_identities": true,
    "bounds": [
      "games per case",
      "complete case count",
      "total execution deadline",
      "individual and cumulative retained artifact bytes"
    ],
    "retained_ingestion_and_replay": "separately measured; neither is generated-and-recorded capacity",
    "daily_rate": "arithmetic extrapolation of the measured interval, never a day-long observation"
  },
  "explicit_acceptance": {
    "workflow_suite": "acceptance",
    "owner": "scripts/accept-chess-environment.py",
    "ordinary_delivery_dependency": false,
    "requires_exact_deployed_source_revision": true,
    "requires_installed_native_and_managed_byte_binding": true,
    "host_lock": "/build/laplace/work/host-resource.lock",
    "scope": [
      "official chess dependency provisioning and GUI interaction",
      "service restart through full application and configured account readiness",
      "full Stockfish corpus native readback and zero-amplification repeat",
      "complete recorded games with duration-qualified readback",
      "retained admission and exact zero-writer replay",
      "GeometryZM storage baseline",
      "Stockfish and Laplace UCI calibration"
    ],
    "game_capacity_authority": "complete generated-and-recorded collector only"
  }
}
