CREATE OR REPLACE FUNCTION converse.translations(p_word bytea, p_limit int DEFAULT 24)
    RETURNS TABLE(translation text, language text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql LAPLACE_STABLE_STRICT
BEGIN ATOMIC
    WITH src_langs AS (
        SELECT c.lang AS id FROM converse.word_language_candidates_batch(ARRAY[p_word]) c
    ),
    agg AS (
        SELECT sm.member, sm.lang, max(sm.mu) AS mu, max(sm.witnesses) AS witnesses,
               max(sm.sense_mu) AS sense_mu
        FROM lexical.synset_members(p_word) sm
        WHERE sm.lang IS NOT NULL
          AND sm.lang NOT IN (SELECT id FROM src_langs)
        GROUP BY sm.member, sm.lang
    ),
    ranked AS MATERIALIZED (
        SELECT member, lang, mu, witnesses,
               row_number() OVER (ORDER BY sense_mu DESC NULLS LAST, mu DESC, witnesses DESC, lang, member) AS rn
        FROM agg
        ORDER BY sense_mu DESC NULLS LAST, mu DESC, witnesses DESC, lang, member
        LIMIT p_limit
    ),
    rendered AS MATERIALIZED (
        SELECT ARRAY(SELECT NULLIF(lp_l.content,lp_l.entity::text) FROM unnest((array_agg(member ORDER BY rn))::bytea[]) WITH ORDINALITY lp_u(x,n) LEFT JOIN (SELECT DISTINCT ON (lp_d.entity) lp_d.entity,lp_d.content FROM public.laplace_labels(array_remove((array_agg(member ORDER BY rn))::bytea[],NULL)::public.blake3[]) lp_d) lp_l ON lp_l.entity=lp_u.x::public.blake3 ORDER BY lp_u.n) AS txt,
               ARRAY(SELECT lp_l.content FROM unnest((array_agg(lang ORDER BY rn))::bytea[]) WITH ORDINALITY lp_u(x,n) LEFT JOIN (SELECT DISTINCT ON (lp_d.entity) lp_d.entity,lp_d.content FROM public.laplace_labels(array_remove((array_agg(lang ORDER BY rn))::bytea[],NULL)::public.blake3[]) lp_d) lp_l ON lp_l.entity=lp_u.x::public.blake3 ORDER BY lp_u.n) AS lbl
        FROM ranked
    )
    SELECT NULLIF(btrim(r.txt[a.rn]), '') AS translation,
           r.lbl[a.rn] AS language,
           consensus.eff_mu_display(a.mu),
           a.witnesses
    FROM ranked a
    CROSS JOIN rendered r
    WHERE NULLIF(btrim(r.txt[a.rn]), '') IS NOT NULL
    ORDER BY a.rn;
END;
