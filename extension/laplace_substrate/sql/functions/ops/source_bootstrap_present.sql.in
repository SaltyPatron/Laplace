-- Does this source carry its relation-law rows (attestations of p_law_type
-- whose subject is a relation type)? The law relation arrives as an id, so the
-- probe prunes by type and source and EXISTS stops at the first row; nothing
-- is realized.
DROP FUNCTION IF EXISTS laplace.source_bootstrap_present(bytea);
DROP FUNCTION IF EXISTS laplace.source_bootstrap_present(bytea, bytea);

CREATE OR REPLACE FUNCTION ops.source_bootstrap_present(p_source bytea, p_law_type bytea)
    RETURNS boolean
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT EXISTS (
        SELECT 1
        FROM laplace.attestations
        WHERE type_id = p_law_type
          AND source_id = p_source
          AND consensus.relation_canonical(subject_id) IS NOT NULL);
END;
