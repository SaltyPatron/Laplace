-- The native batch owns the stored-row query through the SQL catalog, and the
-- scalar wrapper below depends on the batch.

-- Stored entities and cache-resident Unicode atoms share one native facet read.
CREATE OR REPLACE FUNCTION ops.entity_facets_batch(p_ids bytea[])
    RETURNS TABLE(entity_id bytea, tier smallint, type_id bytea)
    LANGUAGE sql STABLE PARALLEL SAFE
    SUPPORT @extschema@.array_length_rows_support
BEGIN ATOMIC
WITH ids AS MATERIALIZED (SELECT DISTINCT id,@extschema:laplace@.blake3_from_bytea(id) AS key FROM unnest(p_ids) u(id) WHERE id IS NOT NULL),
native AS MATERIALIZED (
 SELECT id,tier FROM @extschema:laplace@.laplace_entities(ARRAY(SELECT key FROM ids))
),
forms AS (SELECT i.id,coalesce(e.tier,t.tier) AS tier,t.type_id,
 @extschema:laplace@.laplace_codepoint(i.key) AS scalar FROM ids i
 LEFT JOIN native e ON e.id=i.key LEFT JOIN laplace.entities t ON t.id=i.id)
SELECT id,coalesce(tier,0)::smallint,
 coalesce(type_id,CASE WHEN scalar IS NOT NULL THEN laplace.entity_type_id('Codepoint') END)
FROM forms WHERE tier IS NOT NULL OR scalar IS NOT NULL ORDER BY id;
END;

CREATE OR REPLACE FUNCTION ops.entity_facets(p_id bytea)
    RETURNS TABLE(tier smallint, type_id bytea)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT f.tier, f.type_id FROM ops.entity_facets_batch(ARRAY[p_id]) f;
END;
