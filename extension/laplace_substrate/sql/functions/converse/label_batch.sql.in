-- Exact realize.label() cleanup/fallback over an aligned id array in native C.
CREATE OR REPLACE FUNCTION realize.label_batch(p_ids bytea[])
    RETURNS text[]
    AS 'EXECUTION_LIBRARY', 'pg_laplace_label_batch'
    LANGUAGE C STABLE PARALLEL SAFE;

CREATE OR REPLACE FUNCTION converse.label_or_hex_batch(p_ids bytea[])
    RETURNS text[]
    AS 'EXECUTION_LIBRARY', 'pg_laplace_label_or_hex_batch'
    LANGUAGE C STABLE PARALLEL SAFE;
