-- Gloss plus the IS_A ladder upward. Context ids disambiguate the sense.
CREATE OR REPLACE FUNCTION converse.recall_what_is_response(p_topic bytea, p_context_ids bytea[] DEFAULT NULL)
    RETURNS TABLE(reply text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
 AS $$
    WITH topic AS MATERIALIZED (SELECT realize.label(p_topic) AS label)
    SELECT t.label || ': ' || d.definition, d.eff_mu, d.witnesses
    FROM converse.define_fast(p_topic, COALESCE(p_context_ids, ARRAY[]::bytea[]), 3) d
    CROSS JOIN topic t
    UNION ALL
    SELECT repeat('  ', h.depth) || E'→ is ' || COALESCE(h.hypernym, '?')
           || COALESCE(': ' || h.gloss, ''), NULL::numeric, NULL::bigint
    FROM converse.hypernyms(p_topic, 6) h
    WHERE h.depth > 0
$$;
