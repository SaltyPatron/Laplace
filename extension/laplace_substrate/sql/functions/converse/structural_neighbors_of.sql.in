-- Entity-id keyed structural KNN with S³ coords (explore glome overlay).
-- Unlike structural.neighbors(text), does not re-resolve via prompt_state.
--
-- Shape axis: Frechet over REALIZED curves (entity_curve), never packed
-- laplace.physicalities.trajectory (Rule #3 / Issue 51).
-- GH #862 / #860: structural.neighbors_of, no SET, real schema names.
DROP FUNCTION IF EXISTS laplace.structural_neighbors_of(bytea, integer);
CREATE OR REPLACE FUNCTION structural.neighbors_of(
    p_id bytea,
    p_k  integer DEFAULT 10)
    RETURNS TABLE(
        neighbor_id bytea,
        neighbor    text,
        x           double precision,
        y           double precision,
        z           double precision,
        m           double precision,
        radius      double precision,
        geodesic    double precision,
        frechet     double precision)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH anchor AS MATERIALIZED (
        SELECT a.coord AS v_coord, structural.entity_curve(p_id) AS v_curve
        FROM structural.word_anchor(p_id) a
        WHERE a.coord IS NOT NULL
          AND public.laplace_direction_4d(a.coord) IS NOT NULL
    ),
    nearest AS MATERIALIZED (
        SELECT w.id AS entity_id, w.coord, w.radius_origin,
               public.laplace_angular_distance_4d(w.coord, a.v_coord) AS geo
        FROM anchor a
        JOIN laplace.v_word_points w ON w.id <> p_id
        WHERE public.laplace_direction_4d(w.coord) IS NOT NULL
        ORDER BY public.laplace_direction_4d(w.coord)
                 <<->> public.laplace_direction_4d(a.v_coord)
        LIMIT p_k
    ),
    ordered AS MATERIALIZED (
        SELECT n.entity_id, n.coord, n.radius_origin, n.geo,
               row_number() OVER (ORDER BY n.geo) AS ord
        FROM nearest n
    ),
    curves AS MATERIALIZED (
        SELECT o.entity_id, o.coord, o.radius_origin, o.geo, o.ord,
               structural.entity_curve(o.entity_id) AS curve
        FROM ordered o
    ),
    labels AS MATERIALIZED (
        SELECT realize.batch(array_agg(c.entity_id ORDER BY c.ord)) AS l
        FROM curves c
    )
    SELECT c.entity_id,
           COALESCE(NULLIF(labels.l[c.ord], ''), 'Unrealized entity'),
           public.ST_X(c.coord), public.ST_Y(c.coord), public.ST_Z(c.coord), public.ST_M(c.coord),
           c.radius_origin,
           c.geo,
           CASE WHEN c.curve IS NOT NULL AND a.v_curve IS NOT NULL
                THEN public.laplace_frechet_4d(c.curve, a.v_curve) END
    FROM curves c
    CROSS JOIN labels
    CROSS JOIN anchor a
    ORDER BY c.ord;
END;
