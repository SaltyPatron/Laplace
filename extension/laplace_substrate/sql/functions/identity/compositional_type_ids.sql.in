CREATE OR REPLACE FUNCTION laplace.compositional_type_ids()
RETURNS bytea[]
LANGUAGE sql
IMMUTABLE
-- No SET search_path: every reference below is already schema-qualified, and the clause would
-- block Postgres from inlining this constant id set into callers' predicates.
BEGIN ATOMIC
    SELECT ARRAY[
        laplace.entity_type_id('Codepoint'),
        laplace.entity_type_id('Grapheme'),
        laplace.entity_type_id('Word'),
        laplace.entity_type_id('Sentence'),
        laplace.entity_type_id('Document')
    ];
END;
