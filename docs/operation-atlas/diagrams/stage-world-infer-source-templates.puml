@startuml
!pragma layout smetana
skinparam backgroundColor #FAFCFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #385978
skinparam componentBackgroundColor #E6EFF7
skinparam classBackgroundColor #E6EFF7
title world.infer-source-templates — declared input/output contract
component "world.infer-source-templates" as operation
rectangle "qualified provider trees and receipts" as in0
in0 --> operation
rectangle "accepted generic recipes and source templates" as in1
in1 --> operation
rectangle "source documentation schemas examples counterexamples and licenses" as in2
in2 --> operation
rectangle "prior authority corrections" as in3
in3 --> operation
rectangle "candidate reusable structural mappings" as out0
operation --> out0
rectangle "source-specific academic semantic deltas" as out1
operation --> out1
rectangle "unresolved completion obligations" as out2
operation --> out2
rectangle "accepted immutable template versions after authority and conformance" as out3
operation --> out3
@enduml
