-- BEGIN ATOMIC: GH #764/#1008.  This is a distribution of witnessed structural
-- interpretations, not a count over the one-row canonical identity relation.
CREATE OR REPLACE FUNCTION laplace.compositional_tier_distribution()
RETURNS TABLE(tier smallint, n bigint)
LANGUAGE sql
STABLE
BEGIN ATOMIC
    SELECT i.tier, count(*)::bigint
    FROM laplace.entity_interpretations i
    WHERE i.type_id = ANY(laplace.compositional_type_ids())
    GROUP BY i.tier
    ORDER BY i.tier;
END;
