-- Model ingest is decomposition, not a second inference runtime.
DROP FUNCTION IF EXISTS generation.model_attention_row(integer, integer, text, integer);
DROP FUNCTION IF EXISTS generation.model_forward(bytea, text, integer);
DROP FUNCTION IF EXISTS generation.model_pair_cos(bytea, bytea, bytea, bytea);
DROP FUNCTION IF EXISTS generation.model_circuit_slices(text, integer, integer);
DROP FUNCTION IF EXISTS generation.pg_laplace_model_forward(bytea, bytea[], bytea, bytea, integer);
DROP FUNCTION IF EXISTS generation.model_row_topk(bytea, bytea, bytea, integer);
DROP FUNCTION IF EXISTS generation.model_pair_score(bytea, bytea, bytea, bytea);

DROP FUNCTION IF EXISTS laplace.model_attention_row(integer, integer, text, integer);
DROP FUNCTION IF EXISTS laplace.model_forward(bytea, text, integer);
DROP FUNCTION IF EXISTS laplace.model_pair_cos(bytea, bytea, bytea, bytea);
DROP FUNCTION IF EXISTS laplace.model_circuit_slices(text, integer, integer);
DROP FUNCTION IF EXISTS laplace.pg_laplace_model_forward(bytea, bytea[], bytea, bytea, integer);
DROP FUNCTION IF EXISTS laplace.model_row_topk(bytea, bytea, bytea, integer);
DROP FUNCTION IF EXISTS laplace.model_pair_score(bytea, bytea, bytea, bytea);

CREATE OR REPLACE FUNCTION generation.model_testimony_decode(
    p_trajectory_bits bytea)
RETURNS TABLE(
    token bytea,
    score_fp1e9 bigint,
    logical_ordinal integer,
    packed_ordinal integer,
    run_length integer)
AS 'MODULE_PATHNAME', 'pg_laplace_model_testimony_decode'
LANGUAGE C IMMUTABLE STRICT;

COMMENT ON FUNCTION generation.model_testimony_decode(bytea) IS
'Decode exact model-circuit TestimonyWalk payload retained by a physicality descriptor. '
'This reads Laplace-native decomposed structure only; it does not load checkpoint weights '
'or execute a conventional model.';
