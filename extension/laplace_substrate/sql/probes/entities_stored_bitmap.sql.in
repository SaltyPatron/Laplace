CREATE OR REPLACE FUNCTION laplace.entities_stored_bitmap(ids bytea[])
    RETURNS bytea
    AS 'MODULE_PATHNAME', 'pg_laplace_entities_stored_bitmap'
    LANGUAGE C STABLE;

-- Compatibility overload. Canonical entity storage is id-only/HASH(id): tier is
-- an interpretation projection and cannot participate in presence. Keep the
-- historical two-array call shape so mixed-version clients fail neither install
-- nor apply, but deliberately route to the same id-only stored-row primitive.
CREATE OR REPLACE FUNCTION laplace.entities_stored_bitmap(ids bytea[], tiers smallint[])
    RETURNS bytea
    LANGUAGE sql STABLE PARALLEL RESTRICTED
BEGIN ATOMIC
    SELECT laplace.entities_stored_bitmap(ids);
END;
