@startuml
!pragma layout smetana
skinparam backgroundColor #FAFCFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #385978
skinparam componentBackgroundColor #E6EFF7
skinparam classBackgroundColor #E6EFF7
title framework.execution — declared input/output contract
component "framework.execution" as operation
rectangle "typed recipes and AST programs" as in0
in0 --> operation
rectangle "immutable execution context" as in1
in1 --> operation
rectangle "authority envelope" as in2
in2 --> operation
rectangle "resource grant" as in3
in3 --> operation
rectangle "validated typed ISA and physical plan" as out0
operation --> out0
rectangle "typed AST and value outputs" as out1
operation --> out1
rectangle "effect disposition" as out2
operation --> out2
rectangle "execution receipt" as out3
operation --> out3
@enduml
