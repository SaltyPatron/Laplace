CREATE OR REPLACE FUNCTION chess_game(p_game bytea)
    RETURNS TABLE(white_id bytea, white text, black_id bytea, black text,
                  result text, played_on text, event text, eco text,
                  termination text, time_control text, tc_class text,
                  movetext text)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    -- One game, as its source recorded it. Every column here is a header the
    -- decomposer transcribed verbatim -- the record layer, untouched by any
    -- analysis. Nothing is replayed, evaluated or inferred: the calculated layer
    -- (positions, evals, motifs) hangs off the ChessAnalysis source and is read
    -- through the position surface (chess_moves), not here.
    --
    -- All eleven headers arrive in ONE index scan of the game's subject rows,
    -- and the short surfaces render in ONE realize_batch. The movetext is
    -- rendered on its own with the full depth budget: it is a tier-4 document
    -- whose constituent chain rebuilds the original PGN bytes exactly, so it is
    -- not a label lookup and must not be depth-clipped like one.
    WITH hdr AS MATERIALIZED (
        SELECT max(a.object_id) FILTER (
                   WHERE a.type_id = @extschema@.relation_type_id('HAS_WHITE')) AS white_id,
               max(a.object_id) FILTER (
                   WHERE a.type_id = @extschema@.relation_type_id('HAS_BLACK')) AS black_id,
               max(a.object_id) FILTER (
                   WHERE a.type_id = @extschema@.relation_type_id('HAS_RESULT')) AS result_id,
               max(a.object_id) FILTER (
                   WHERE a.type_id = @extschema@.relation_type_id('ON_DATE')) AS date_id,
               max(a.object_id) FILTER (
                   WHERE a.type_id = @extschema@.relation_type_id('HAS_EVENT')) AS event_id,
               max(a.object_id) FILTER (
                   WHERE a.type_id = @extschema@.relation_type_id('HAS_ECO')) AS eco_id,
               max(a.object_id) FILTER (
                   WHERE a.type_id = @extschema@.relation_type_id('HAS_TERMINATION')) AS term_id,
               max(a.object_id) FILTER (
                   WHERE a.type_id = @extschema@.relation_type_id('HAS_TIME_CONTROL')) AS tc_id,
               max(a.object_id) FILTER (
                   WHERE a.type_id = @extschema@.relation_type_id('HAS_TC_CLASS')) AS tcc_id,
               max(a.object_id) FILTER (
                   WHERE a.type_id = @extschema@.relation_type_id('HAS_MOVETEXT')) AS movetext_id
        FROM @extschema@.attestations a
        WHERE a.subject_id = p_game
          AND a.type_id IN (@extschema@.relation_type_id('HAS_WHITE'),
                            @extschema@.relation_type_id('HAS_BLACK'),
                            @extschema@.relation_type_id('HAS_RESULT'),
                            @extschema@.relation_type_id('ON_DATE'),
                            @extschema@.relation_type_id('HAS_EVENT'),
                            @extschema@.relation_type_id('HAS_ECO'),
                            @extschema@.relation_type_id('HAS_TERMINATION'),
                            @extschema@.relation_type_id('HAS_TIME_CONTROL'),
                            @extschema@.relation_type_id('HAS_TC_CLASS'),
                            @extschema@.relation_type_id('HAS_MOVETEXT'))
    ),
    surface_batch AS MATERIALIZED (
        SELECT COALESCE(array_agg(DISTINCT s), '{}'::bytea[]) AS ids
        FROM hdr h,
             LATERAL (VALUES (h.white_id), (h.black_id), (h.result_id), (h.date_id),
                             (h.event_id), (h.eco_id), (h.term_id), (h.tc_id),
                             (h.tcc_id)) v(s)
        WHERE s IS NOT NULL
    ),
    surface_text AS MATERIALIZED (
        SELECT p.id, t.txt
        FROM surface_batch b,
             LATERAL unnest(b.ids) WITH ORDINALITY AS p(id, i),
             LATERAL unnest(@extschema@.realize_batch(b.ids)) WITH ORDINALITY AS t(txt, j)
        WHERE p.i = t.j
    )
    SELECT h.white_id,
           COALESCE(NULLIF(w.txt, ''), encode(h.white_id, 'hex')),
           h.black_id,
           COALESCE(NULLIF(bl.txt, ''), encode(h.black_id, 'hex')),
           r.txt, d.txt, ev.txt, ec.txt, tm.txt, tc.txt, tcc.txt,
           @extschema@.render_text(h.movetext_id, 32)
    FROM hdr h
    LEFT JOIN surface_text w   ON w.id   = h.white_id
    LEFT JOIN surface_text bl  ON bl.id  = h.black_id
    LEFT JOIN surface_text r   ON r.id   = h.result_id
    LEFT JOIN surface_text d   ON d.id   = h.date_id
    LEFT JOIN surface_text ev  ON ev.id  = h.event_id
    LEFT JOIN surface_text ec  ON ec.id  = h.eco_id
    LEFT JOIN surface_text tm  ON tm.id  = h.term_id
    LEFT JOIN surface_text tc  ON tc.id  = h.tc_id
    LEFT JOIN surface_text tcc ON tcc.id = h.tcc_id
    WHERE h.white_id IS NOT NULL OR h.black_id IS NOT NULL
       OR h.movetext_id IS NOT NULL
$$;
