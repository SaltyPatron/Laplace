-- converse.resolve_last_word — GH #862 / #860. No SET, real schema names.
DROP FUNCTION IF EXISTS laplace.resolve_last_word(text);
CREATE OR REPLACE FUNCTION converse.resolve_last_word(p_phrase text)
    RETURNS bytea
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH words AS MATERIALIZED (SELECT p.*,row_number() OVER(ORDER BY ord) AS input_ordinal FROM converse.prompt_words(p_phrase) p),
    recorded AS MATERIALIZED (
      SELECT ordinal FROM @extschema:laplace@.laplace_present_ids(
        ARRAY(SELECT encode(id,'hex')::@extschema:laplace@.blake3 FROM words ORDER BY ord)))
    SELECT w.id FROM words w JOIN recorded r ON r.ordinal=w.input_ordinal
    ORDER BY w.ord DESC LIMIT 1;
END;
