-- Type membership is the entity row's type. What a value is used as follows from
-- the claims that use it; type is never recorded as testimony.
CREATE OR REPLACE FUNCTION consensus.entity_has_type(
    p_entity bytea,
    p_type bytea)
RETURNS boolean
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT EXISTS (
        SELECT 1
        FROM laplace.entities e
        WHERE e.id = p_entity
          AND e.type_id = p_type
    );
END;
