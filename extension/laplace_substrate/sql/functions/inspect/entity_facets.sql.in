DROP FUNCTION IF EXISTS laplace.entity_facets(bytea);
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.entity_facets(bytea)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(tier smallint, type_id bytea)'
             OR proargnames IS DISTINCT FROM ARRAY['p_id','tier','type_id']::text[])) THEN
        DROP FUNCTION ops.entity_facets(bytea);
    END IF;
END $upgrade_shape$;
-- LIVE-UPGRADE DEPENDENCIES. Parsed SQL bodies pin these exact OIDs:
--
--   consensus.browse_named_entities
--       -> structural.word_containers_containing_all
--       -> ops.entity_facets_batch
--
-- Preserve current shapes/OIDs; retire incompatible legacy shapes in dependent-
-- first order. The native batch now owns the stored-row query through the SQL
-- catalog, and the scalar wrapper below depends on the batch. Do not use CASCADE.
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('consensus.browse_named_entities(bytea[], bytea, int, int, int)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(entity_id bytea, tier smallint, type_id bytea, matched_name_id bytea, match_kind text, rating numeric, rd numeric, eff_mu numeric, witness_count bigint, candidate_name_count bigint, candidate_truncated boolean, matched_entity_count bigint)'
             OR proargnames IS DISTINCT FROM ARRAY['p_members','p_exact','p_offset','p_limit','p_capacity','entity_id','tier','type_id','matched_name_id','match_kind','rating','rd','eff_mu','witness_count','candidate_name_count','candidate_truncated','matched_entity_count']::text[])) THEN
        DROP FUNCTION consensus.browse_named_entities(bytea[], bytea, int, int, int);
    END IF;
END $upgrade_shape$;
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('structural.word_containers_containing_all(bytea[], int)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(entity_id bytea, candidate_count bigint, truncated boolean)'
             OR proargnames IS DISTINCT FROM ARRAY['p_members','p_capacity','entity_id','candidate_count','truncated']::text[])) THEN
        DROP FUNCTION structural.word_containers_containing_all(bytea[], int);
    END IF;
END $upgrade_shape$;

-- Stored entities and cache-resident Unicode atoms share one native facet read.
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.entity_facets_batch(bytea[])')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(entity_id bytea, tier smallint, type_id bytea)'
             OR proargnames IS DISTINCT FROM ARRAY['p_ids','entity_id','tier','type_id']::text[])) THEN
        DROP FUNCTION ops.entity_facets_batch(bytea[]);
    END IF;
END $upgrade_shape$;
CREATE OR REPLACE FUNCTION ops.entity_facets_batch(p_ids bytea[])
    RETURNS TABLE(entity_id bytea, tier smallint, type_id bytea)
    LANGUAGE sql STABLE PARALLEL SAFE
    SUPPORT @extschema@.array_length_rows_support
AS $native$
WITH ids AS MATERIALIZED (SELECT DISTINCT id,encode(id,'hex')::public.blake3 AS key FROM unnest(p_ids) u(id) WHERE id IS NOT NULL),
forms AS (SELECT i.id,e.tier,public.laplace_codepoint(i.key) AS scalar FROM ids i LEFT JOIN public.entity e ON e.id=i.key)
SELECT id,coalesce(tier,0)::smallint,
 CASE WHEN scalar IS NOT NULL THEN laplace.entity_type_id('Codepoint') ELSE NULL::bytea END
FROM forms WHERE tier IS NOT NULL OR scalar IS NOT NULL ORDER BY id
$native$;

CREATE OR REPLACE FUNCTION ops.entity_facets(p_id bytea)
    RETURNS TABLE(tier smallint, type_id bytea)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT f.tier, f.type_id FROM ops.entity_facets_batch(ARRAY[p_id]) f;
END;
