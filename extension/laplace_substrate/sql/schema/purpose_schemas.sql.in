-- Purpose schemas. Functions live in the namespace of the program family they
-- serve, keyed to spec 37's opcode families:
--
--   consensus   the fold and its edge reads          (WEIGHT, SCAN)
--   converse    the request program over a session   (SEQUENCE)
--   lexical     words, senses, definitions           (SENSE, RESOLVE)
--   taxonomy    hierarchy traversal                  (TRAVERSE)
--   generation  synthesis and the forward pass       (ELECT)
--   structural  geometry, coordinates, trajectories
--   chess       chess grammar and presentation over the shared web
--   realize     rendering and readback               (REALIZE)
--   ops         diagnostics, census, health          (WITNESS)
--
-- None of them is on any search_path, so every cross-family reference is
-- schema-qualified and bodies need no SET search_path, which keeps SQL
-- functions inlinable into the caller's plan. Tables and highway-mask bits
-- stay in the extension schema.
--
-- Every purpose schema is an extension member. CREATE SCHEMA IF NOT EXISTS is
-- rejected from an extension script when a non-member schema of that name
-- exists, so absent schemas are created and existing ones are absorbed with
-- ALTER EXTENSION ... ADD SCHEMA.
DO $purpose_schemas$
DECLARE
    s text;
BEGIN
    FOREACH s IN ARRAY ARRAY['consensus','converse','lexical','taxonomy',
                             'generation','structural','chess','realize','ops']
    LOOP
        IF to_regnamespace(s) IS NULL THEN
            EXECUTE format('CREATE SCHEMA %I', s);
        ELSIF NOT EXISTS (
            SELECT 1
            FROM pg_catalog.pg_depend d
            JOIN pg_catalog.pg_extension e ON e.oid = d.refobjid
            WHERE d.classid = 'pg_catalog.pg_namespace'::regclass
              AND d.objid = to_regnamespace(s)
              AND d.refclassid = 'pg_catalog.pg_extension'::regclass
              AND d.deptype = 'e'
              AND e.extname = 'laplace_substrate'
        ) THEN
            EXECUTE format('ALTER EXTENSION laplace_substrate ADD SCHEMA %I', s);
        END IF;
    END LOOP;
END
$purpose_schemas$;

COMMENT ON SCHEMA consensus  IS 'Laplace: the fold and its edge reads (spec 37 WEIGHT, SCAN).';
COMMENT ON SCHEMA converse   IS 'Laplace: the speaking loop (spec 37 SEQUENCE).';
COMMENT ON SCHEMA lexical    IS 'Laplace: words, senses, definitions (spec 37 SENSE, RESOLVE).';
COMMENT ON SCHEMA taxonomy   IS 'Laplace: hierarchy traversal (spec 37 TRAVERSE).';
COMMENT ON SCHEMA generation IS 'Laplace: synthesis and the forward pass (spec 37 ELECT).';
COMMENT ON SCHEMA structural IS 'Laplace: geometry, coordinates, trajectories.';
COMMENT ON SCHEMA chess      IS 'Laplace: the chess modality.';
COMMENT ON SCHEMA realize    IS 'Laplace: rendering and readback (spec 37 REALIZE).';
COMMENT ON SCHEMA ops        IS 'Laplace: diagnostics, census, health (spec 37 WITNESS).';

-- Same grants the extension schema carries. A reader that can call laplace.* can
-- call these; the split is about structure and planning, never about privilege.
DO $purpose$
DECLARE
    s text;
BEGIN
    FOREACH s IN ARRAY ARRAY['consensus','converse','lexical','taxonomy',
                             'generation','structural','chess','realize','ops']
    LOOP
        EXECUTE format('GRANT USAGE ON SCHEMA %I TO PUBLIC', s);
    END LOOP;
END
$purpose$;
