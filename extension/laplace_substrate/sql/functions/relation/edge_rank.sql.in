CREATE OR REPLACE FUNCTION consensus.edge_rank(p_type bytea, p_confidence double precision)
    RETURNS double precision
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    -- Relation-type salience rank times a standing read on Laplace-Native's
    -- scale (consensus.eff_mu: public.laplace_confidence, 0..1).
    --
    -- No SET search_path and NOT STRICT so it inlines into the caller's ORDER BY;
    -- NULL still propagates through relation_rank_resolved (STRICT) and the multiply.
    SELECT consensus.relation_rank_resolved(p_type) * p_confidence;
END;
