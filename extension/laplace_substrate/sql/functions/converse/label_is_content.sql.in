-- Legacy compatibility predicate.  Semantic/content classification cannot be
-- recovered from a rendered string: WordNet-looking ids, spaces, punctuation,
-- scripts, casing and delimiters are all valid content in some modality/language.
--
-- The former regex stoplist duplicated structural exclusions that now happen in id
-- space through relation families before realization.  Keep this installed signature
-- only for callers not yet retired; the only honest property of a text projection is
-- whether a non-empty realization exists.
DROP FUNCTION IF EXISTS laplace.label_is_content(text);
CREATE OR REPLACE FUNCTION converse.label_is_content(p_label text)
    RETURNS boolean
    LANGUAGE sql IMMUTABLE AS $$
    SELECT NULLIF(p_label, '') IS NOT NULL
$$;
