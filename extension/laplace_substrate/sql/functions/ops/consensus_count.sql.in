DROP FUNCTION IF EXISTS laplace.consensus_count(bytea);

CREATE OR REPLACE FUNCTION ops.consensus_count(p_type bytea DEFAULT NULL)
    RETURNS bigint
    LANGUAGE sql STABLE
BEGIN ATOMIC
    -- Branch on the optional filter so a given type plans as plain equality
    -- (an index-only count on consensus_type_btree); the OR-form plans
    -- generically with p_type unbound and cannot use the index.
    SELECT CASE
        WHEN p_type IS NULL
            THEN (SELECT count(*) FROM laplace.consensus)
            ELSE (SELECT count(*) FROM laplace.consensus c WHERE c.type_id = p_type)
    END;
END;
