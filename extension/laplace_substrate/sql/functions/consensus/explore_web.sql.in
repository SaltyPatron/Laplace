DROP FUNCTION IF EXISTS laplace.explore_web(bytea, int, int, int);
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('consensus.explore_web(bytea, int, int, int)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(source_id bytea, type_id bytea, object_id bytea, hop smallint, rating bigint, rd bigint, witness_count bigint)'
             OR proargnames IS DISTINCT FROM ARRAY['p_seed','p_hops','p_fanout','p_max_nodes','source_id','type_id','object_id','hop','rating','rd','witness_count']::text[])) THEN
        DROP FUNCTION consensus.explore_web(bytea, int, int, int);
    END IF;
END $upgrade_shape$;
-- Explicit execution policy shares the native crawl and filters reverse
-- directed relations before neighbor election, so they consume no fanout slots.
CREATE OR REPLACE FUNCTION consensus.explore_web(
    p_seeds bytea[], p_hops int, p_fanout int, p_max_nodes int,
    p_respect_direction boolean)
    RETURNS TABLE(
        source_id bytea, type_id bytea, object_id bytea, hop smallint,
        rating bigint, rd bigint, witness_count bigint)
    AS 'EXECUTION_LIBRARY', 'pg_laplace_explore_web'
    LANGUAGE C STABLE;

CREATE OR REPLACE FUNCTION consensus.explore_web(
    p_seeds bytea[],
    p_hops int DEFAULT 2,
    p_fanout int DEFAULT 10,
    p_max_nodes int DEFAULT NULL)
    RETURNS TABLE(
        source_id bytea,
        type_id bytea,
        object_id bytea,
        hop smallint,
        rating bigint,
        rd bigint,
        witness_count bigint)
    AS 'EXECUTION_LIBRARY', 'pg_laplace_explore_web'
    LANGUAGE C STABLE;

-- Scalar convenience delegates to the canonical multi-seed crawl. It is not a
-- second traversal implementation.
CREATE OR REPLACE FUNCTION consensus.explore_web(
    p_seed bytea,
    p_hops int DEFAULT 2,
    p_fanout int DEFAULT 10,
    p_max_nodes int DEFAULT NULL)
    RETURNS TABLE(
        source_id bytea,
        type_id bytea,
        object_id bytea,
        hop smallint,
        rating bigint,
        rd bigint,
        witness_count bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT * FROM consensus.explore_web(
        ARRAY[p_seed], p_hops, p_fanout, p_max_nodes);
END;
