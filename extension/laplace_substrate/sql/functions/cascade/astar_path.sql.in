DROP FUNCTION IF EXISTS laplace.astar_path(bytea, bytea[], int, bytea[], bool, bool);
CREATE OR REPLACE FUNCTION converse.astar_path(
    p_start bytea, p_goals bytea[], p_max_depth int DEFAULT 7,
    p_types bytea[] DEFAULT NULL, p_directed bool DEFAULT false,
    p_use_geometry bool DEFAULT false)
    RETURNS TABLE(step int, entity_id bytea, g double precision)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT * FROM converse.astar_path_raw(p_start, p_goals,
        COALESCE(p_types, ARRAY[
            laplace.relation_type_id('IS_A'), laplace.relation_type_id('IS_INSTANCE_OF'), laplace.relation_type_id('IS_SYNONYM_OF'),
            laplace.relation_type_id('IS_SIMILAR_TO'), laplace.relation_type_id('HAS_PART'), laplace.relation_type_id('HAS_MEMBER'),
            laplace.relation_type_id('HAS_SUBSTANCE'), laplace.relation_type_id('DERIVATIONALLY_RELATED'),
            laplace.relation_type_id('PERTAINS_TO'), laplace.relation_type_id('ALSO_SEE'), laplace.relation_type_id('IS_ANTONYM_OF'),
            laplace.relation_type_id('HAS_ATTRIBUTE'), laplace.relation_type_id('IN_VERB_GROUP_WITH')]),
        p_max_depth, p_directed, p_use_geometry);
END;
