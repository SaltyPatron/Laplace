-- ops.placement_health: placement confidence of the physical face, from
-- radius_origin. A composed coordinate is the centroid of its constituents'
-- unit vectors, so its radius is their resultant length, the concentration
-- statistic of directional statistics, and the only signal the geometry has
-- that a coordinate poorly summarizes its trajectory:
--   r = 1      constituents coincide, or an atom (on the sphere)
--   r -> 1     tight cluster; the centroid is a faithful bucket
--   r -> 0     dispersed constituents; the mean nearly cancels and the
--              normalised direction is dominated by accumulated float error
-- Below p_unreliable a coordinate should be treated as absent, not wrong: a
-- placement always looks like a valid 4-vector.
--
-- -log10(r) is the decimal digits lost to cancellation in forming the mean;
-- fp32_digits_left (7.22 - that) says whether a path may be narrowed to fp32.
-- Width governs placement; reduction order governs anything feeding a hash,
-- coord, hilbert_index, or trajectory.
--
-- Cohorts split on n_constituents = 0 (atom vs composed), which is on
-- physicalities, so the exact aggregate needs no join; radius_origin is stored.
-- placement_health_by_tier gives the per-tier cut. Inner aliases avoid the
-- RETURNS TABLE names, which are OUT parameters in scope over an atomic body.
DROP FUNCTION IF EXISTS ops.placement_health(double precision, double precision);
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.placement_health(double precision)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(cohort text, rows bigint, min_r numeric, avg_r numeric, off_sphere bigint, unreliable bigint, pct_unreliable numeric, worst_digits_lost numeric, fp32_digits_left numeric)'
             OR proargnames IS DISTINCT FROM ARRAY['p_unreliable','cohort','rows','min_r','avg_r','off_sphere','unreliable','pct_unreliable','worst_digits_lost','fp32_digits_left']::text[])) THEN
        DROP FUNCTION ops.placement_health(double precision);
    END IF;
END $upgrade_shape$;
CREATE OR REPLACE FUNCTION ops.placement_health(
    p_unreliable double precision DEFAULT 0.1)
RETURNS TABLE(cohort              text,
              rows                bigint,
              min_r               numeric,
              avg_r               numeric,
              off_sphere          bigint,
              unreliable          bigint,
              pct_unreliable      numeric,
              worst_digits_lost   numeric,
              fp32_digits_left    numeric)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT CASE WHEN a.is_tier0 THEN 'tier0 (on spiral)'::text
                ELSE 'composed (centroid)'::text END,
           a.n_rows,
           a.r_min,
           a.r_avg,
           a.n_off,
           a.n_unrel,
           round((100.0 * a.n_unrel / NULLIF(a.n_rows, 0))::numeric, 4),
           -- log() has only a (numeric, numeric) form; the raw minimum is cast
           -- instead of reusing the rounded r_min, which would truncate the
           -- cancellation figure to 6 decimal places before the logarithm.
           round(-log(10::numeric, GREATEST(a.r_min_raw, 1e-300)::numeric), 2),
           round(7.22 + log(10::numeric, GREATEST(a.r_min_raw, 1e-300)::numeric), 2)
    FROM (
        SELECT (p.n_constituents = 0)                                      AS is_tier0,
               count(*)                                                    AS n_rows,
               round(min(p.radius_origin)::numeric, 6)                     AS r_min,
               round(avg(p.radius_origin)::numeric, 6)                     AS r_avg,
               count(*) FILTER (WHERE abs(p.radius_origin - 1.0) > 1e-9)   AS n_off,
               count(*) FILTER (WHERE p.radius_origin < p_unreliable)      AS n_unrel,
               min(p.radius_origin)                                        AS r_min_raw
        FROM laplace.physicalities p
        GROUP BY (p.n_constituents = 0)
    ) a
    ORDER BY a.is_tier0 DESC;
END;

COMMENT ON FUNCTION ops.placement_health(double precision) IS
    'Exact placement confidence, tier0 vs composed, with the cancellation figure '
    'that decides whether a path may be narrowed to fp32.';


-- ops.placement_health_by_tier: the per-tier cut. It needs the entities join,
-- so it samples. plpgsql because TABLESAMPLE takes a literal, not a
-- parameter, so the percentage reaches the parser through format().
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.placement_health_by_tier(double precision, double precision)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(tier smallint, sampled bigint, min_r numeric, avg_r numeric, max_r numeric, off_sphere bigint, unreliable bigint, pct_unreliable numeric)'
             OR proargnames IS DISTINCT FROM ARRAY['p_sample_pct','p_unreliable','tier','sampled','min_r','avg_r','max_r','off_sphere','unreliable','pct_unreliable']::text[])) THEN
        DROP FUNCTION ops.placement_health_by_tier(double precision, double precision);
    END IF;
END $upgrade_shape$;
CREATE OR REPLACE FUNCTION ops.placement_health_by_tier(
    p_sample_pct  double precision DEFAULT 2.0,
    p_unreliable  double precision DEFAULT 0.1)
RETURNS TABLE(tier            smallint,
              sampled         bigint,
              min_r           numeric,
              avg_r           numeric,
              max_r           numeric,
              off_sphere      bigint,
              unreliable      bigint,
              pct_unreliable  numeric)
LANGUAGE plpgsql STABLE PARALLEL SAFE
AS $$
BEGIN
    -- Counts aggregate once inside; the percentage is derived outside.
    RETURN QUERY EXECUTE format($fmt$
        SELECT a.tier, a.sampled, a.min_r, a.avg_r, a.max_r, a.off_sphere,
               a.unreliable,
               round((100.0 * a.unreliable / NULLIF(a.sampled, 0))::numeric, 2)
        FROM (
            SELECT e.tier,
                   count(*)                                                  AS sampled,
                   round(min(p.radius_origin)::numeric, 6)                    AS min_r,
                   round(avg(p.radius_origin)::numeric, 6)                    AS avg_r,
                   round(max(p.radius_origin)::numeric, 6)                    AS max_r,
                   count(*) FILTER (WHERE abs(p.radius_origin - 1.0) > 1e-9)  AS off_sphere,
                   count(*) FILTER (WHERE p.radius_origin < %L)               AS unreliable
            FROM laplace.physicalities p TABLESAMPLE SYSTEM (%L)
            JOIN laplace.entities e ON e.id = p.entity_id
            GROUP BY e.tier
        ) a
        ORDER BY a.tier
    $fmt$, p_unreliable, p_sample_pct);
END;
$$;

COMMENT ON FUNCTION ops.placement_health_by_tier(double precision, double precision) IS
    'Sampled placement confidence broken out per tier. Tier 0 must be exactly 1.0; '
    'low r above tier 0 means the centroid is a poor summary of its trajectory.';


-- ops.placement_unreliable: the offending rows, lowest radius first. Labels
-- are realized by one converse.label_or_hex_batch over the LIMITed ids, not by
-- a scalar call per row.
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.placement_unreliable(double precision, integer)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(entity_id bytea, tier smallint, radius double precision, label text)'
             OR proargnames IS DISTINCT FROM ARRAY['p_threshold','p_limit','entity_id','tier','radius','label']::text[])) THEN
        DROP FUNCTION ops.placement_unreliable(double precision, integer);
    END IF;
END $upgrade_shape$;
CREATE OR REPLACE FUNCTION ops.placement_unreliable(
    p_threshold double precision DEFAULT 0.1,
    p_limit     integer          DEFAULT 50)
RETURNS TABLE(entity_id bytea, tier smallint, radius double precision, label text)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH picked AS (
        SELECT p.entity_id AS eid, e.tier AS etier, p.radius_origin AS r
        FROM laplace.physicalities p
        JOIN laplace.entities e ON e.id = p.entity_id
        WHERE p.radius_origin < p_threshold
        ORDER BY p.radius_origin, p.entity_id
        LIMIT p_limit
    ),
    ord AS (
        SELECT picked.eid, picked.etier, picked.r,
               row_number() OVER (ORDER BY picked.r, picked.eid) AS k
        FROM picked
    ),
    labs AS (
        SELECT converse.label_or_hex_batch(
                   array_agg(picked.eid ORDER BY picked.r, picked.eid)) AS l
        FROM picked
    )
    SELECT o.eid, o.etier, o.r, (labs.l)[o.k]
    FROM ord o CROSS JOIN labs
    ORDER BY o.k;
END;

COMMENT ON FUNCTION ops.placement_unreliable(double precision, integer) IS
    'Rows whose centroid is a poor summary of their trajectory. One batched '
    'label resolution over the LIMITed set.';
