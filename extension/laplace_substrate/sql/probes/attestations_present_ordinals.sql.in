-- Id-only attestation presence for diagnostics and preflight. Without the
-- subject key it cannot prune HASH(subject_id); bulk persist uses the keyed
-- native bitmap instead. intent_preflight calls this form.
CREATE OR REPLACE FUNCTION laplace.attestations_present_ordinals(p_ids bytea[])
    RETURNS TABLE(idx int)
    LANGUAGE sql STABLE PARALLEL RESTRICTED
    SUPPORT @extschema@.array_length_rows_support
    ROWS 100
AS $$
    SELECT (u.ord - 1)::int
    FROM unnest(p_ids) WITH ORDINALITY u(id, ord)
    JOIN laplace.attestations a ON a.id = u.id
$$;

-- Keyed presence is native (descent_probe.c); the three-array SQL form is dropped.
DROP FUNCTION IF EXISTS laplace.attestations_present_ordinals(bytea[], bytea[], bytea[]);
