SQL_QUERY("consensus.salient_facts_rendered", "bytea,int4",
    "WITH facts AS MATERIALIZED (SELECT * FROM ops.claim_facts($1,$2)), provenance AS MATERIALIZED (SELECT a.claim,count(*) AS witnesses FROM public.laplace_attested(ARRAY(SELECT claim FROM facts),false) a WHERE a.witness GROUP BY a.claim) SELECT f.type,f.fact,f.eff_mu,coalesce(p.witnesses,0)::bigint FROM facts f LEFT JOIN provenance p USING(claim) ORDER BY f.eff_mu DESC,f.claim")

SQL_QUERY("converse.contrast", "bytea,bytea,int4",
    "WITH xf AS MATERIALIZED(SELECT * FROM ops.claim_facts($1,NULL)),yf AS MATERIALIZED(SELECT * FROM ops.claim_facts($2,NULL)) SELECT CASE WHEN xf.claim IS NULL THEN 'y-only' WHEN yf.claim IS NULL THEN 'x-only' ELSE 'both' END,coalesce(xf.type,yf.type),coalesce(xf.fact,yf.fact),greatest(xf.eff_mu,yf.eff_mu) FROM xf FULL JOIN yf ON xf.predicate IS NOT DISTINCT FROM yf.predicate AND xf.object=yf.object ORDER BY (xf.claim IS NOT NULL AND yf.claim IS NOT NULL) DESC,greatest(xf.eff_mu,yf.eff_mu) DESC,coalesce(xf.predicate,yf.predicate),coalesce(xf.object,yf.object) LIMIT $3")

SQL_QUERY("consensus.relation_summary", "bytea,bytea",
    "SELECT * FROM consensus.relation_summary($1,$2)")

/* Inspection of the same Native coupling operator used by the forward program.
 * All admitted relation identities, containment and shape are eligible. The
 * second round reads the response field and the words' witnessed bindings.
 * Binding evidence governs which rows may be realized as lexical readings. */
/* Human lexical reads select admitted claims before realizing text or tracing support.
 * Stored consensus supplies standing; this query never refolds it. */
/* Resolve selected opaque endpoints through their own recorded descriptions.
 * This is a single indexed subject frontier, not another lexical expansion. */
SQL_QUERY("query.lexicon_descriptions", "bytea[]",
    "WITH roots AS MATERIALIZED (SELECT ARRAY(SELECT DISTINCT public.blake3_from_bytea(id) FROM unnest($1::bytea[]) u(id)) ids), "
    "claims AS MATERIALIZED (SELECT r.ids[c.i::int] anchor,c.entity claim,public.laplace_parts(c.path) parts,c.rating,c.deviation,c.matches "
    "FROM roots r CROSS JOIN LATERAL public.laplace_claims_each(r.ids,NULL::bigint, "
    "ARRAY[public.laplace_bank_bit('kind','claim')],'{}'::public.blake3[],1::smallint) c), "
    "identifiers AS MATERIALIZED (SELECT DISTINCT anchor FROM claims WHERE cardinality(parts)>=3 "
    "AND parts[2]=public.laplace_text_id('identifier vocabulary')), "
    "predicates AS MATERIALIZED (SELECT DISTINCT p.entity FROM public.laplace_constituents( "
    "ARRAY(SELECT DISTINCT parts[2] FROM claims WHERE cardinality(parts)>=3)) p "
    "WHERE p.child=ANY(ARRAY[public.laplace_text_id('definition'),public.laplace_text_id('definitions')]) UNION SELECT public.blake3_from_bytea(m.surface_id) FROM consensus.relation_metadata(ARRAY(SELECT DISTINCT public.blake3_send(parts[2]) FROM claims WHERE cardinality(parts)>=3)) m WHERE m.canonical='HAS_DEFINITION'), "
    "selected AS MATERIALIZED (SELECT c.* FROM claims c JOIN predicates p ON p.entity=c.parts[2] "
    "WHERE c.parts[1]=c.anchor AND cardinality(c.parts)>=3 AND c.matches>0), "
    "labels AS MATERIALIZED (SELECT * FROM converse.lexicon_texts(ARRAY(SELECT DISTINCT parts[cardinality(parts)] FROM selected))), "
    "descriptions AS MATERIALIZED (SELECT s.anchor,l.content,s.rating-2*s.deviation standing,s.claim FROM selected s "
    "JOIN labels l ON l.entity=s.parts[cardinality(s.parts)] AND l.textual), "
    "results AS (SELECT anchor FROM identifiers UNION SELECT anchor FROM descriptions) "
    "SELECT public.blake3_send(r.anchor),d.content,i.anchor IS NOT NULL FROM results r "
    "LEFT JOIN descriptions d ON d.anchor=r.anchor LEFT JOIN identifiers i ON i.anchor=r.anchor "
    "ORDER BY d.standing DESC NULLS LAST,r.anchor,d.claim")

SQL_QUERY("query.lexicon_field", "bytea[]",
    "WITH roots AS MATERIALIZED (\n"
    " SELECT ARRAY(SELECT public.blake3_from_bytea(id) FROM unnest($1::bytea[]) u(id)) ids\n"
    "), bindings AS MATERIALIZED (SELECT * FROM converse.binding_evidence($1,NULL,false)),\n"
    "lexical_matches AS MATERIALIZED (\n"
    " SELECT public.blake3_from_bytea(v.id) id,t.ordinal::int ordinal\n"
    " FROM bindings b CROSS JOIN LATERAL(VALUES(b.key),(b.binding)) v(id)\n"
    " CROSS JOIN roots k CROSS JOIN LATERAL unnest(k.ids) WITH ORDINALITY t(id,ordinal) WHERE b.term=public.blake3_send(t.id)\n"
    " UNION SELECT t.id,t.ordinal::int FROM roots k,unnest(k.ids) WITH ORDINALITY t(id,ordinal)\n"
    "), lexical_bindings AS MATERIALIZED (\n"
    " SELECT id,array_agg(DISTINCT ordinal ORDER BY ordinal) origins FROM lexical_matches GROUP BY id\n"
    "), anchors AS MATERIALIZED (SELECT ARRAY(SELECT id FROM lexical_bindings ORDER BY id) ids),\n"
    "claims AS MATERIALIZED (\n"
    " SELECT k.ids[c.i::int] anchor,c.entity via,public.laplace_parts(c.path) parts,c.matches,c.rating,c.deviation,c.volatility\n"
    " FROM anchors k CROSS JOIN LATERAL public.laplace_claims_each(k.ids,NULL::bigint,\n"
    " ARRAY[public.laplace_bank_bit('kind','claim')],'{}'::public.blake3[],3::smallint) c\n"
    "), candidates AS MATERIALIZED (\n"
    " SELECT c.*,CASE WHEN c.parts[1]=c.anchor THEN c.parts[cardinality(c.parts)] ELSE c.parts[1] END entity,\n"
    " CASE WHEN cardinality(c.parts)>=3 THEN c.parts[2] END rel,c.parts[1]=c.anchor outbound\n"
    " FROM claims c WHERE cardinality(c.parts)>=2\n"
    "), predicate_ids AS MATERIALIZED (SELECT ARRAY(SELECT DISTINCT public.blake3_send(rel) FROM candidates WHERE rel IS NOT NULL) ids),\n"
    "metadata AS MATERIALIZED (SELECT m.* FROM predicate_ids i,consensus.relation_metadata(i.ids) m),\n"
    "descriptive AS MATERIALIZED (\n"
    " SELECT DISTINCT p.entity FROM public.laplace_constituents(ARRAY(SELECT DISTINCT rel FROM candidates WHERE rel IS NOT NULL)) p\n"
    " WHERE p.child=ANY(ARRAY[public.laplace_text_id('definition'),public.laplace_text_id('definitions'),public.laplace_text_id('example'),public.laplace_text_id('examples')]) UNION SELECT public.blake3_from_bytea(m.surface_id) FROM metadata m WHERE m.canonical IN ('HAS_DEFINITION','HAS_EXAMPLE')\n"
    "), forms AS MATERIALIZED (\n"
    " SELECT entity id,mask,tier FROM public.laplace_physicalities(ARRAY(SELECT DISTINCT entity FROM candidates UNION SELECT DISTINCT rel FROM candidates WHERE rel IS NOT NULL))\n"
    "), bound AS MATERIALIZED (\n"
    " SELECT c.*,ab.origins anchors,coalesce(tb.origins,'{}'::int[]) targets,ef.tier,public.laplace_mask_value(ef.mask,'kind')=-1 textual\n"
    " FROM candidates c JOIN lexical_bindings ab ON ab.id=c.anchor\n"
    " LEFT JOIN lexical_bindings tb ON tb.id=c.entity LEFT JOIN forms ef ON ef.id=c.entity\n"
    " LEFT JOIN forms rf ON rf.id=c.rel LEFT JOIN descriptive d ON d.entity=c.rel\n"
    " LEFT JOIN metadata m ON m.surface_id=public.blake3_send(c.rel)\n"
    " WHERE c.rel<>public.laplace_text_id('identifier vocabulary') AND ((c.outbound AND d.entity IS NOT NULL)\n"
    " OR ((m.canonical IS NOT NULL OR public.laplace_mask_value(rf.mask,'kind')=-1)\n"
    " AND (EXISTS(SELECT FROM unnest(ab.origins) a(side),unnest(tb.origins) b(side) WHERE a.side<>b.side)\n"
    " OR (cardinality((SELECT ids FROM roots))=1 AND tb.id IS NULL AND (public.laplace_mask_value(ef.mask,'kind')=-1 OR ef.mask OPERATOR(public.?&) ARRAY[public.laplace_bank_bit('kind','tuple')])))))\n"
    "), ids AS MATERIALIZED (SELECT entity id FROM bound UNION SELECT anchor FROM bound UNION SELECT rel FROM bound WHERE rel IS NOT NULL),\n"
    "labels AS MATERIALIZED (SELECT * FROM converse.lexicon_texts(ARRAY(SELECT id FROM ids ORDER BY id)))\n"
    "SELECT 2::int round,r.anchors[1] occurrence,public.blake3_send(r.anchor),al.content,public.blake3_send(r.entity),\n"
    "coalesce(el.content,r.entity::text),0::smallint route,public.blake3_send(r.via),public.blake3_send(r.rel),rl.content,\n"
    "r.rating,r.deviation,r.volatility,r.matches,NULL::bigint witnesses,r.tier,NULL::double precision distance,r.outbound,\n"
    "r.anchors origins,r.targets,ARRAY(SELECT DISTINCT b.claim FROM bindings b WHERE public.blake3_send(r.anchor) IN(b.key,b.binding)) binding_claims,\n"
    "r.anchors,coalesce(el.textual,false),r.anchors reading_origins\n"
    "FROM bound r LEFT JOIN labels al ON al.entity=r.anchor LEFT JOIN labels el ON el.entity=r.entity LEFT JOIN labels rl ON rl.entity=r.rel\n"
    "ORDER BY r.anchor,r.entity,r.via")

/* Keep all typed responses. A structural response is an inspectable reference,
 * not a request to reconstruct its body for a label. Claim standing is already
 * stored; exact source ancestry belongs to the selected claim's inspection. */
SQL_QUERY("query.response_field", "bytea[],int4,int4",
    "WITH roots AS MATERIALIZED ("
    " SELECT ARRAY(SELECT public.blake3_from_bytea(id) FROM unnest($1::bytea[]) u(id)) AS ids"
    "), bindings AS MATERIALIZED (SELECT * FROM converse.binding_evidence($1,NULL,false)), first AS MATERIALIZED ("
    " SELECT 1 AS round,k.ids[c.occ] AS anchor,c.* FROM roots k"
    " CROSS JOIN LATERAL public.laplace_couple(k.ids,$2::bigint,'{}'::public.blake3[],0::smallint,0.0::float8,$3) c"
    "), frontier AS MATERIALIZED ("
    " SELECT ARRAY(SELECT entity FROM first UNION SELECT public.blake3_from_bytea(key) FROM bindings"
    " UNION SELECT public.blake3_from_bytea(binding) FROM bindings ORDER BY 1) AS ids"
    "), second AS MATERIALIZED ("
    " SELECT 2 AS round,k.ids[c.occ] AS anchor,c.* FROM frontier k"
    " CROSS JOIN LATERAL public.laplace_couple(k.ids,$2::bigint,'{}'::public.blake3[],-1::smallint,0.0::float8,0) c"
    "), responses AS MATERIALIZED (SELECT * FROM first UNION ALL SELECT * FROM second),"
    " anchors AS MATERIALIZED (SELECT ARRAY(SELECT DISTINCT anchor FROM responses WHERE route=0 ORDER BY anchor) AS ids),"
    " claims AS MATERIALIZED (SELECT k.ids[c.i::int] AS anchor,c.entity,public.laplace_parts(c.path) AS parts,c.matches,c.rating,c.deviation,c.volatility"
    " FROM anchors k CROSS JOIN LATERAL public.laplace_claims_each(k.ids,NULL::bigint,"
    " ARRAY[public.laplace_bank_bit('kind','claim')],'{}'::public.blake3[]) c),"
    " bound AS MATERIALIZED (SELECT DISTINCT ON (r.round,r.occ,r.route,r.entity,c.entity)"
    " r.round,r.occ,r.anchor,r.entity,r.route,c.entity AS via,"
    " CASE WHEN cardinality(c.parts)>=3 THEN c.parts[2] END AS rel,"
    " c.rating,c.deviation,c.volatility,c.matches,r.tier,r.distance,"
    " CASE WHEN c.entity IS NOT NULL THEN c.parts[1]=r.anchor END AS outbound"
    " FROM responses r LEFT JOIN claims c ON r.route=0 AND c.anchor=r.anchor AND r.entity=ANY(c.parts)"
    " AND (cardinality(c.parts)=2 OR c.parts[2]=r.rel)"
    " ORDER BY r.round,r.occ,r.route,r.entity,c.entity),"
    " ids AS MATERIALIZED (SELECT entity AS id FROM bound UNION SELECT anchor FROM bound WHERE anchor IS NOT NULL"
    " UNION SELECT rel FROM bound WHERE rel IS NOT NULL),"
    " lexical_matches AS MATERIALIZED (SELECT public.blake3_from_bytea(v.id) AS id,t.ordinal::int AS ordinal"
    " FROM bindings b CROSS JOIN LATERAL(VALUES(b.key),(b.binding)) v(id)"
    " CROSS JOIN roots k CROSS JOIN LATERAL unnest(k.ids) WITH ORDINALITY t(id,ordinal) WHERE b.term=public.blake3_send(t.id)"
    " UNION SELECT t.id,t.ordinal::int FROM roots k,unnest(k.ids) WITH ORDINALITY t(id,ordinal)),"
    " lexical_bindings AS MATERIALIZED (SELECT id,array_agg(DISTINCT ordinal ORDER BY ordinal) AS origins FROM lexical_matches GROUP BY id),"
    " entity_forms AS MATERIALIZED (SELECT entity AS id,mask FROM public.laplace_physicalities(ARRAY(SELECT id FROM ids ORDER BY id))),"
    " labels AS MATERIALIZED (SELECT * FROM public.laplace_labels(ARRAY("
    " SELECT entity id FROM bound WHERE route=0 UNION SELECT anchor FROM bound WHERE route=0"
    " UNION SELECT rel FROM bound WHERE route=0 AND rel IS NOT NULL ORDER BY 1)))"
    " SELECT r.round,r.occ,public.blake3_send(r.anchor),al.content,public.blake3_send(r.entity),"
    " coalesce(el.content,r.entity::text),r.route,public.blake3_send(r.via),public.blake3_send(r.rel),rl.content,"
    " r.rating,r.deviation,r.volatility,r.matches,NULL::bigint witnesses,r.tier,r.distance,r.outbound,"
    " CASE WHEN r.round=1 THEN ARRAY[r.occ::int] ELSE ARRAY(SELECT DISTINCT f.occ::int FROM first f WHERE f.route<>2 AND f.entity=r.anchor ORDER BY 1) END,"
    " coalesce(target_binding.origins,'{}'::int[]),"
    " ARRAY(SELECT DISTINCT b.claim FROM bindings b WHERE public.blake3_send(r.anchor) IN(b.key,b.binding)),"
    " coalesce(anchor_binding.origins,'{}'::int[]),coalesce(public.laplace_mask_value(ef.mask,'kind')=-1,false),"
    " ARRAY(SELECT t.ordinal::int FROM roots k,unnest(k.ids) WITH ORDINALITY t(id,ordinal) WHERE t.id=r.anchor"
    " UNION SELECT t.ordinal::int FROM bindings b CROSS JOIN roots k,unnest(k.ids) WITH ORDINALITY t(id,ordinal)"
    " WHERE b.term=public.blake3_send(t.id) AND public.blake3_send(r.anchor) IN(b.key,b.binding) ORDER BY 1)"
    " FROM bound r LEFT JOIN labels al ON al.entity=r.anchor LEFT JOIN labels el ON el.entity=r.entity"
    " LEFT JOIN labels rl ON rl.entity=r.rel"
    " LEFT JOIN lexical_bindings target_binding ON target_binding.id=r.entity"
    " LEFT JOIN lexical_bindings anchor_binding ON anchor_binding.id=r.anchor"
    " LEFT JOIN entity_forms ef ON ef.id=r.entity"
    " ORDER BY r.round,r.occ,r.route,r.entity,r.via,r.rel")

SQL_QUERY("ops.source_roster", "bytea,int4",
    "SELECT encode(subject_id, 'hex'), subject, relation,\n       encode(object_id, 'hex'), object, observations\nFROM ops.source_roster($1, $2)")

SQL_QUERY("ops.entity_primary_forms_batch", "bytea[]",
    "SELECT DISTINCT ON (p.ordinal) p.ordinal,p.x,p.y,p.z,p.m,p.radius,p.n_constituents\nFROM ops.entity_physicalities($1::bytea[]) p ORDER BY p.ordinal,p.type")

SQL_QUERY("structural.constellation_sample", "int4",
    "WITH bounds AS (\n"
    " SELECT g.i,((g.i::bigint*65536)/n.n)::integer AS lo16,(((g.i+1)::bigint*65536)/n.n)::integer AS hi16\n"
    " FROM (SELECT LEAST(GREATEST(COALESCE($1,0),0),1024) AS n) n\n"
    " CROSS JOIN LATERAL generate_series(0,n.n-1) AS g(i) WHERE n.n>0\n"
    "), sampled AS (\n"
    " SELECT b.i,e.id,e.coord,e.hilbert\n"
    " FROM bounds b\n"
    " CROSS JOIN LATERAL (\n"
    "  SELECT e.id,e.coord,e.hilbert FROM public.entity e\n"
    "  WHERE e.hilbert>=((b.lo16::bigint-32768)<<48)\n"
    "    AND (b.hi16>=65536 OR e.hilbert<((b.hi16::bigint-32768)<<48))\n"
    "  ORDER BY e.hilbert,e.id LIMIT 1) e\n"
    "), distinct_entities AS (\n"
    " SELECT s.*,row_number() OVER (PARTITION BY s.id ORDER BY s.i) AS entity_ord FROM sampled s\n"
    ")\n"
    "SELECT row_number() OVER (ORDER BY d.i)::integer,encode(public.blake3_send(d.id),'hex'),1::smallint,\n"
    " public.ST_X(d.coord),public.ST_Y(d.coord),public.ST_Z(d.coord),public.ST_M(d.coord),\n"
    " public.laplace_radius_origin(d.coord),COALESCE(public.laplace_path_length(p.path)::integer,0),\n"
    " encode(int8send(d.hilbert # '-9223372036854775808'::bigint),'hex')\n"
    "FROM distinct_entities d\n"
    "LEFT JOIN public.physicality p ON p.entity=d.id\n"
    "WHERE d.entity_ord=1\n"
    "ORDER BY d.i")

SQL_QUERY("ops.evidence_receipt", "bytea,int4",
    "SELECT encode(type_id,'hex'),type_label,encode(object_id,'hex'),object_label,source_labels,witness_count,eff_mu FROM ops.evidence_receipt($1,$2)")
SQL_QUERY("ops.evidence_series_receipt", "bytea,int4,bool",
    "SELECT encode(claim_id,'hex'),encode(type_id,'hex'),encode(object_id,'hex'),type_label,object_label,eff_mu,"
    "encode(source_id,'hex'),source_label,games,tokens,score,trust,encode(dependence_root,'hex'),\"position\" "
    "FROM ops.evidence_series_receipt($1,$2,$3)")

SQL_QUERY("ops.eval_ingest_fidelity_positives", "text,text,int4",
    "SELECT score FROM ops.eval_ingest_fidelity_positives($1, $2, $3)")

SQL_QUERY("ops.eval_ingest_fidelity_negatives", "text,int4",
    "SELECT score FROM ops.eval_ingest_fidelity_negatives($1, $2)")

SQL_QUERY("converse.recall_intent", "text,bytea,bytea,text,text,bytea[]",
    "SELECT reply, eff_mu, witnesses\nFROM converse.recall_intent($1, $2, $3, $4, $5, $6)")

SQL_QUERY("converse.recall", "text",
    "SELECT reply, eff_mu, witnesses FROM converse.recall($1)")

SQL_QUERY("consensus.gaps_for_prompt", "text",
    "SELECT missing_arena FROM consensus.gaps(converse.resolve_last_word($1))")

SQL_QUERY("structural.nearest_neighbors_4d", "text,int4",
    "SELECT neighbor, geodesic, frechet FROM structural.nearest_neighbors_4d($1, $2)")

SQL_QUERY("ops.consensus_out_readable_batch", "bytea[],int4",
    "SELECT u.ord, r.type, r.object, r.eff_mu, r.witnesses\nFROM unnest($1::bytea[]) WITH ORDINALITY AS u(id, ord)\nCROSS JOIN LATERAL ops.consensus_out_readable(u.id, $2)\n    WITH ORDINALITY AS r(type, object, eff_mu, witnesses, rord)\nORDER BY u.ord, r.rord")

SQL_QUERY("inspection.explore_resolve", "bytea,text",
    "SELECT id,label,CASE WHEN $2::text IS NULL THEN 'hex' ELSE 'word' END,present FROM ops.resolve_refs(ARRAY[$1::bytea],ARRAY[$2::text])")

SQL_QUERY("structural.explore_anchor_neighbors", "float8,float8,float8,float8,text,int4,int4,float8",
    "SELECT n.axis, encode(n.entity_id, 'hex'), n.label, n.tier, n.geodesic, n.frechet\nFROM structural.explore_anchor_neighbors(\n    $1, $2, $3, $4, $5, $6, $7, $8) n")

SQL_QUERY("ops.witnessed_words", "text[]",
    "WITH words AS MATERIALIZED (SELECT u.s,u.ordinal,converse.resolve_ref(u.s) AS id FROM unnest($1::text[]) WITH ORDINALITY u(s,ordinal)),\nadmitted AS MATERIALIZED (SELECT *,row_number() OVER(ORDER BY ordinal) AS n FROM words WHERE id IS NOT NULL),\ncounts AS MATERIALIZED (SELECT * FROM ops.entity_evidence_counts(ARRAY(SELECT id FROM admitted ORDER BY ordinal)))\nSELECT a.s,encode(a.id,'hex'),c.evidence FROM admitted a JOIN counts c ON c.ordinal=a.n ORDER BY a.ordinal")

SQL_QUERY("structural.neighbors_of", "bytea,int4",
    "SELECT encode(n.neighbor_id, 'hex'), n.neighbor,\n       n.geodesic, n.frechet, n.x, n.y, n.z, n.m, n.radius\nFROM structural.neighbors_of($1, $2) n")

SQL_QUERY("lexical.concept_members_rendered", "bytea,int4",
    "SELECT encode(m.member, 'hex'), m.kind,\n       COALESCE(NULLIF(realize.render_text_fast(m.member, 8), ''),\n                converse.label_or_hex(m.member)), m.mu, m.witnesses\nFROM lexical.concept_members($1) m\nORDER BY m.mu DESC NULLS LAST, m.member\nLIMIT $2")

SQL_QUERY("lexical.concept_peers", "bytea,int4",
    "SELECT peer, kind, strength FROM lexical.concept_peers($1, $2)")

SQL_QUERY("lexical.word_peer_ids_batch", "bytea[],int4",
    "SELECT word_id, peer_id, strength FROM lexical.word_peer_ids_batch($1, $2)")

SQL_QUERY("consensus.completions_rendered", "text,int4",
    "SELECT\n    encode(c.object_id, 'hex') AS object_id_hex,\n    encode(c.type_id, 'hex') AS type_id_hex,\n    c.eff_mu,\n    c.witnesses,\n    converse.label_or_hex(c.object_id) AS object_label\nFROM consensus.completions(converse.resolve($1), $2) c\nORDER BY c.eff_mu DESC")

SQL_QUERY("ops.evidence_counts_batch", "bytea[]",
    "SELECT ordinal,evidence FROM ops.entity_evidence_counts($1)")

SQL_QUERY("consensus.walk_branches_rendered", "text,int4,int4",
    "SELECT\n    gt.depth,\n    ARRAY(SELECT encode(x, 'hex') FROM unnest(gt.path) AS u(x)) AS path_hex,\n    ARRAY(SELECT encode(x, 'hex') FROM unnest(gt.types) AS u(x)) AS type_path_hex,\n    encode(gt.entity_id, 'hex') AS entity_id_hex,\n    converse.label_or_hex(gt.entity_id) AS entity_label,\n    gt.eff_mu,\n    gt.path_mu,\n    gt.witnesses\nFROM consensus.walk_branches(converse.resolve($1), NULL, $2, $3) gt\nORDER BY gt.depth, gt.path_mu DESC")

SQL_QUERY("ops.attestations_out_batch", "bytea[],int4",
    "SELECT u.ord,\n    encode(a.type_id, 'hex'),\n    encode(a.object_id, 'hex'),\n    encode(a.source_id, 'hex'),\n    CASE WHEN a.context_id IS NULL THEN NULL ELSE encode(a.context_id, 'hex') END,\n    a.outcome,\n    a.observation_count\nFROM unnest($1::bytea[]) WITH ORDINALITY AS u(id, ord)\nCROSS JOIN LATERAL ops.attestations_out(u.id, $2)\n    WITH ORDINALITY AS a(type_id, object_id, source_id, context_id, outcome, observation_count, aord)\nORDER BY u.ord, a.aord")

SQL_QUERY("ops.evidence_for_target", "bytea,text,int4",
    "WITH resolved AS MATERIALIZED (SELECT id,label FROM ops.resolve_refs(ARRAY[$1::bytea],ARRAY[$2::text]) WHERE present)\nSELECT r.id,r.label,encode(e.type_id,'hex'),e.type_label,encode(e.object_id,'hex'),e.object_label,e.source_labels,e.witness_count,e.eff_mu\nFROM resolved r LEFT JOIN LATERAL ops.evidence_receipt(r.id,$3) e ON true")

SQL_QUERY("inspection.embedding_lookup", "text,int4,bool,text[]",
    "WITH resolved AS (\n    SELECT converse.resolve_ref($1) AS id\n),\ndirect_meaning AS (\n    SELECT sf.type AS rel, sf.fact AS obj, sf.eff_mu, sf.witnesses, sf.ord\n    FROM resolved r\n    CROSS JOIN LATERAL consensus.salient_facts(r.id, NULL, $2)\n        WITH ORDINALITY AS sf(type, fact, eff_mu, witnesses, ord)\n    WHERE $3 AND r.id IS NOT NULL\n    UNION ALL\n    SELECT 'PEER'::text AS rel, cp.peer AS obj, round(cp.strength::numeric, 1) AS eff_mu, 1::bigint AS witnesses, (100 + cp.ord) AS ord\n    FROM resolved r\n    CROSS JOIN LATERAL lexical.concept_peers(r.id, GREATEST(4, $2 / 2))\n        WITH ORDINALITY AS cp(peer, kind, strength, ord)\n    WHERE $3 AND r.id IS NOT NULL\n),\nfallback_direct AS (\n    SELECT m.type AS rel, m.object AS obj, m.eff_mu, m.witnesses, (200 + m.ord) AS ord\n    FROM resolved r\n    CROSS JOIN LATERAL ops.consensus_out_readable(r.id, $2)\n        WITH ORDINALITY AS m(type, object, eff_mu, witnesses, ord)\n    WHERE $3 AND r.id IS NOT NULL\n      AND NOT EXISTS (SELECT 1 FROM direct_meaning)\n),\nconstituent_meaning AS (\n    SELECT (u.term || ':' || sf.type) AS rel, sf.fact AS obj, sf.eff_mu, sf.witnesses, (u.tord * 100 + sf.sord) AS ord\n    FROM resolved r\n    CROSS JOIN LATERAL unnest(COALESCE($4, ARRAY[]::text[])) WITH ORDINALITY AS u(term, tord)\n    CROSS JOIN LATERAL (SELECT converse.resolve_ref(u.term) AS wid) w\n    CROSS JOIN LATERAL consensus.salient_facts(w.wid, NULL, GREATEST(2, $2 / GREATEST(1, COALESCE(array_length($4, 1), 1))))\n        WITH ORDINALITY AS sf(type, fact, eff_mu, witnesses, sord)\n    WHERE $3 AND r.id IS NULL AND w.wid IS NOT NULL\n),\nall_meaning AS (\n    SELECT rel, obj, eff_mu, witnesses, ord FROM (\n        SELECT rel, obj, eff_mu, witnesses, ord FROM direct_meaning\n        UNION ALL\n        SELECT rel, obj, eff_mu, witnesses, ord FROM fallback_direct\n        UNION ALL\n        SELECT rel, obj, eff_mu, witnesses, ord FROM constituent_meaning\n    ) combined\n    ORDER BY ord\n    LIMIT $2\n)\nSELECT 0 AS kind, 0::bigint AS ord, r.id AS eid,\n       f.x, f.y, f.z, f.m, f.radius, f.n_constituents,\n       NULL::text, NULL::text, NULL::numeric, NULL::bigint\nFROM resolved r\nLEFT JOIN LATERAL (\n    SELECT x, y, z, m, radius, n_constituents\n    FROM ops.entity_physicalities(r.id)\n    ORDER BY type\n    LIMIT 1\n) f ON true\nUNION ALL\nSELECT 1 AS kind, m.ord, r.id,\n       NULL::float8, NULL::float8, NULL::float8, NULL::float8, NULL::float8, NULL::int,\n       m.rel, m.obj, m.eff_mu, m.witnesses\nFROM resolved r\nCROSS JOIN all_meaning m\nORDER BY kind, ord")

SQL_QUERY("consensus.top_relations_rendered", "int4",
    "WITH t AS MATERIALIZED (\n    SELECT r.subject_id, r.type_id, r.object_id, r.eff_mu, r.witnesses,\n           row_number() OVER () AS ord\n    FROM consensus.top_relations($1) r\n),\nids AS MATERIALIZED (\n    SELECT array_agg(v.id ORDER BY t.ord, v.slot) AS a\n    FROM t\n    CROSS JOIN LATERAL (VALUES (t.subject_id, 1), (t.object_id, 2)) AS v(id, slot)\n),\nrel AS MATERIALIZED (\n    SELECT d.type_id,\n           COALESCE(NULLIF(consensus.relation_canonical(d.type_id), ''),\n                    converse.label_or_hex(d.type_id)) AS relation\n    FROM (SELECT DISTINCT t.type_id FROM t) d\n),\nlbl AS MATERIALIZED (\n    SELECT realize.batch(ids.a, NULL) AS l FROM ids\n)\nSELECT\n    encode(t.subject_id, 'hex') AS subject_id_hex,\n    COALESCE(lbl.l[(t.ord - 1) * 2 + 1], converse.label_or_hex(t.subject_id)) AS subject_label,\n    encode(t.type_id, 'hex') AS type_id_hex,\n    rel.relation AS type_label,\n    encode(t.object_id, 'hex') AS object_id_hex,\n    COALESCE(lbl.l[(t.ord - 1) * 2 + 2], converse.label_or_hex(t.object_id)) AS object_label,\n    t.eff_mu,\n    t.witnesses\nFROM t\nJOIN rel ON rel.type_id = t.type_id\nCROSS JOIN lbl\nORDER BY t.ord")

SQL_QUERY("lexical.senses_rendered", "bytea",
    "WITH s AS MATERIALIZED (\n    SELECT sense_id, synset_id, eff_mu, witnesses, row_number() OVER () AS ord\n    FROM lexical.senses($1)\n), lang AS MATERIALIZED (\n    SELECT converse.word_language($1) AS id\n), ids AS MATERIALIZED (\n    SELECT COALESCE(array_agg(synset_id ORDER BY ord), '{}'::bytea[]) AS a FROM s\n), lex AS MATERIALIZED (\n    SELECT realize.lexicalize_batch(ids.a, lang.id) AS l, realize.render_text_batch(ids.a, 8) AS r\n    FROM ids CROSS JOIN lang\n)\nSELECT encode(s.sense_id, 'hex'), encode(s.synset_id, 'hex'),\n       COALESCE(\n           NULLIF(lex.l[s.ord::int], ''),\n           NULLIF(lex.r[s.ord::int], ''),\n           'Unrealized sense'),\n       s.eff_mu, s.witnesses\nFROM s CROSS JOIN lex\nORDER BY s.ord")

SQL_QUERY("realize.constituents_rendered", "bytea",
    "WITH children AS MATERIALIZED (SELECT * FROM realize.constituents($1)), labels AS MATERIALIZED (\n SELECT * FROM realize.display_label_batch(ARRAY(SELECT DISTINCT child_id FROM children ORDER BY child_id))\n) SELECT c.ordinal,encode(c.child_id,'hex'),c.run_length,c.flags,coalesce(l.label,encode(c.child_id,'hex'))\nFROM children c LEFT JOIN labels l ON l.id=c.child_id ORDER BY c.ordinal")

SQL_QUERY("inspection.packed_trajectory_vertices", "bytea",
    "SELECT c.ordinal,public.ST_X(v.vertex),public.ST_Y(v.vertex),public.ST_Z(v.vertex),public.ST_M(v.vertex),\n"
    " c.child::text,c.run_length,c.flags\n"
    "FROM public.laplace_constituents(ARRAY[public.blake3_from_bytea($1)]) c\n"
    "JOIN public.laplace_physicalities(ARRAY[public.blake3_from_bytea($1)]) p ON p.entity=c.entity\n"
    "CROSS JOIN LATERAL (SELECT public.ST_PointN(p.path,c.ordinal) AS vertex) v\n"
    "ORDER BY c.ordinal")

SQL_QUERY("inspection.realized_trajectory_vertices", "bytea",
    "WITH children AS MATERIALIZED (\n SELECT * FROM public.laplace_constituents(ARRAY[public.blake3_from_bytea($1)])\n), labels AS MATERIALIZED (\n SELECT * FROM public.laplace_labels(ARRAY(SELECT DISTINCT child FROM children ORDER BY child))\n), coords AS (\n SELECT c.ordinal,c.child,coalesce(e.coord,CASE WHEN public.laplace_codepoint(c.child)>=0 THEN\n public.ST_GeomFromEWKB(public.laplace_cp_coord_ewkb(public.laplace_codepoint(c.child))) END) AS coord\n FROM children c LEFT JOIN public.entity e ON e.id=c.child\n) SELECT c.ordinal,public.ST_X(c.coord),public.ST_Y(c.coord),public.ST_Z(c.coord),public.ST_M(c.coord),\n c.child::text,coalesce(l.content,c.child::text),public.laplace_radius_origin(c.coord)\nFROM coords c LEFT JOIN labels l ON l.entity=c.child WHERE c.coord IS NOT NULL\nUNION ALL\nSELECT c.ordinal,public.ST_X(p.coord),public.ST_Y(p.coord),public.ST_Z(p.coord),public.ST_M(p.coord),\n encode(c.child_id,'hex'),coalesce(nullif(realize.render_text_fast(c.child_id,8),''),'Unrealized entity'),p.radius_origin\nFROM realize.constituents($1) c JOIN laplace.physicalities p ON p.entity_id=c.child_id AND p.type=1\nWHERE p.coord IS NOT NULL AND NOT EXISTS(SELECT FROM public.entity WHERE id=public.blake3_from_bytea($1)) ORDER BY 1")

SQL_QUERY("consensus.explore_web_rendered", "bytea,int4,int4,int4",
    "SELECT encode(w.source_id, 'hex'), encode(w.type_id, 'hex'), encode(w.object_id, 'hex'),\n       w.hop, consensus.eff_mu(w.rating, w.rd)::numeric, w.witness_count,\n       consensus.walk_edge_weight(w.rating, w.rd),\n       consensus.refuted(w.rating, w.rd)\nFROM consensus.explore_web($1, $2, $3, $4) w")

SQL_QUERY("consensus.explore_induced_edges_rendered", "bytea[]",
    "SELECT encode(e.source_id, 'hex'), encode(e.type_id, 'hex'), encode(e.object_id, 'hex'),\n       e.rating::numeric / 1000000000::numeric,\n       e.rd::numeric / 1000000000::numeric,\n       e.volatility::numeric / 1000000000::numeric,\n       consensus.eff_mu(e.rating, e.rd)::numeric,\n       e.witness_count,\n       consensus.walk_edge_weight(e.rating, e.rd),\n       consensus.refuted(e.rating, e.rd)\nFROM consensus.explore_induced_edges($1) e")

SQL_QUERY("realize.labels_fast", "bytea[]",
    "WITH inp AS MATERIALIZED (\n    SELECT x.id, x.ord, e.tier\n    FROM unnest($1::bytea[]) WITH ORDINALITY AS x(id, ord)\n    LEFT JOIN laplace.entities e ON e.id = x.id\n), names AS MATERIALIZED (\n    SELECT realize.resolve_name_batch($1::bytea[]) AS labels\n), shallow_ids AS MATERIALIZED (\n    SELECT COALESCE(\n               array_agg(i.id ORDER BY i.ord) FILTER (WHERE i.tier <= 3),\n               '{}'::bytea[]) AS ids\n    FROM inp i\n), shallow_labels AS MATERIALIZED (\n    SELECT s.ids, realize.render_text_batch(s.ids, 3) AS labels\n    FROM shallow_ids s\n), shallow AS MATERIALIZED (\n    SELECT s.ids[n] AS id, s.labels[n] AS label\n    FROM shallow_labels s,\n         generate_subscripts(s.ids, 1) AS n\n)\nSELECT encode(i.id, 'hex'),\n       COALESCE(\n           NULLIF(n.name, ''),\n           NULLIF(names.labels[i.ord], ''),\n           NULLIF(shallow.label, '')),\n       i.tier\nFROM inp i\nCROSS JOIN names\nLEFT JOIN shallow ON shallow.id = i.id\nLEFT JOIN laplace.canonical_names n ON n.id = i.id\nORDER BY i.ord")

SQL_QUERY("consensus.edges_raw", "bytea,text,bytea[],int4,bool,text",
    "SELECT e.direction, e.type_id, e.neighbour_id,\n       e.rating, e.rd, e.witness_count\nFROM consensus.edges_raw($1, $2, $3, $4, $5, $6) e")

SQL_QUERY("consensus.best_outbound_by_subjects", "bytea[],bytea,bool",
    "SELECT s.id, e.neighbour_id,\n       consensus.eff_mu_display(e.rating, e.rd),\n       e.witness_count\nFROM unnest($1::bytea[]) AS s(id)\nCROSS JOIN LATERAL consensus.edges_raw(\n    s.id, 'out', ARRAY[$2]::bytea[], 1, $3, 'eff_mu') e")

SQL_QUERY("converse.translations", "text,int4",
    "SELECT t.translation, t.language, t.eff_mu, t.witnesses\nFROM converse.translations(converse.resolve_ref($1), $2) t")

SQL_QUERY("consensus.walk_branches_for_prompt", "text,text,text,int4,int4",
    "WITH node AS (SELECT CASE WHEN $2 IS NULL THEN converse.resolve($1)\n                          ELSE decode($2, 'hex') END AS id)\nSELECT w.depth,\n       realize.path(w.path, w.types) AS path,\n       w.eff_mu, w.path_mu, w.witnesses\nFROM node, consensus.walk_branches(\n         node.id,\n         CASE WHEN $3 IS NULL THEN NULL ELSE laplace.relation_type_id($3) END,\n         $4, $5) w\nORDER BY w.depth, w.path_mu DESC")

SQL_QUERY("ops.api_catalog", "text",
    "SELECT name, args, returns, kind FROM ops.api($1) ORDER BY name, args")

SQL_QUERY("consensus.band_facts", "bytea,int4[],int4",
    "WITH requested_bands AS MATERIALIZED (\n    SELECT b.band, b.name, b.rank\n    FROM converse.relation_band_catalog() b\n    WHERE $2::int[] IS NULL OR b.band = ANY($2::int[])\n), edges AS MATERIALIZED (\n    SELECT z.*, consensus.relation_rank(z.type_id) AS rel_rank\n    FROM consensus.edges_raw($1, 'both', NULL, GREATEST($3 * 4, 64), true, 'eff_mu') z\n), ranked AS (\n    SELECT b.name, b.rank, z.*\n    FROM edges z\n    JOIN requested_bands b ON b.rank = z.rel_rank\n)\nSELECT z.name || ' · ' || COALESCE(consensus.relation_canonical(z.type_id), converse.label_or_hex(z.type_id))\n         || CASE z.direction WHEN 'in' THEN ' ← ' ELSE ' → ' END\n         || converse.label_or_hex(z.neighbour_id) AS reply,\n       consensus.eff_mu_display(z.rating, z.rd) AS eff_mu,\n       z.witness_count\nFROM ranked z\nORDER BY z.rank DESC,\n         consensus.eff_mu(z.rating, z.rd) DESC,\n         z.neighbour_id,\n         z.type_id,\n         CASE z.direction WHEN 'out' THEN 0 ELSE 1 END\nLIMIT $3")

SQL_QUERY("consensus.walk_strongest_rendered", "bytea,int4",
    "SELECT converse.label_or_hex(w.entity_id)\n         || ' (' || consensus.relation_canonical(w.type_id) || ')' AS reply,\n       w.eff_mu, NULL::bigint\nFROM consensus.walk_strongest($1, NULL, $2) w\nORDER BY w.step")

SQL_QUERY("consensus.walk_branches_beam", "bytea,text,int4[],int4,int4,int4",
    "WITH mask AS (\n    SELECT CASE WHEN $3::int[] IS NULL THEN NULL\n                ELSE consensus.highway_mask_from_bits(\n                         (SELECT array_agg(DISTINCT bit)\n                          FROM unnest($3::int[]) AS b(band),\n                               LATERAL unnest(consensus.highway_mask_bits(\n                                   consensus.highway_band_mask(b.band))) AS t(bit)))\n           END AS m\n)\nSELECT repeat('  ', w.depth) || realize.path(w.path, w.types) AS reply,\n       w.path_mu, w.witnesses\nFROM mask, consensus.walk_branches(\n         $1,\n         CASE WHEN $2::text IS NULL THEN NULL\n              ELSE laplace.relation_type_id($2::text) END,\n         $4, $5, mask.m) w\nORDER BY w.path_mu DESC\nLIMIT $6")

SQL_QUERY("converse.astar_path_rendered", "bytea,bytea,int4,bool,bool",
    "SELECT repeat('  ', p.step) || converse.label_or_hex(p.entity_id) AS reply,\n       p.g::numeric, NULL::bigint\nFROM converse.astar_path($1, ARRAY[$2]::bytea[], $3, NULL,\n                        $4, $5) p\nORDER BY p.step")

SQL_QUERY("generation.walk_continuations_rendered", "bytea,int4,int4,float8,int4,int8",
    "SELECT converse.label_or_hex(w.entity) AS reply, NULL::numeric, NULL::bigint\nFROM generation.walk_continuations(ARRAY[$1]::bytea[], $2, $3,\n                                $4, $5, $6) w\nORDER BY w.step")

SQL_QUERY("ops.entity_counts_by_types", "bytea[]",
    "SELECT type_id, entities FROM ops.entity_counts_by_types($1)")

