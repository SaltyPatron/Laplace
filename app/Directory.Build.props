<Project>
  <Import Project="../scripts/win/machine-env.props" Condition="'$(OS)' == 'Windows_NT'" />
  <!--
    Build outputs follow the installed machine declaration (see scripts/win/machine-env.props).
    Native libraries and CLI tools are consumed from packaged Laplace-Native and Laplace-Engine
    artifacts resolved dynamically from LAPLACE_NATIVE_PACKAGE / LAPLACE_ENGINE_PACKAGE,
    components.lock.tsv pins under $(LAPLACE_BUILD)/packages, or local CMake builds.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <LAPLACE_BUILD Condition="'$(LAPLACE_BUILD)' == '' AND '$(OS)' == 'Windows_NT'">D:\Libraries\build\Laplace</LAPLACE_BUILD>
    <LAPLACE_BUILD Condition="'$(LAPLACE_BUILD)' == ''">$(MSBuildThisFileDirectory)../../build</LAPLACE_BUILD>
    <LaplacePackagesRoot>$(LAPLACE_BUILD)/packages</LaplacePackagesRoot>
    <_LaplaceLockFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../Laplace-Operations/components.lock.tsv'))</_LaplaceLockFile>
    <_LaplaceLockFile Condition="!Exists('$(_LaplaceLockFile)') AND '$(LAPLACE_OPERATIONS)' != '' AND Exists('$(LAPLACE_OPERATIONS)/components.lock.tsv')">$(LAPLACE_OPERATIONS)/components.lock.tsv</_LaplaceLockFile>
    <_LaplaceLockText Condition="Exists('$(_LaplaceLockFile)')">$([System.IO.File]::ReadAllText('$(_LaplaceLockFile)'))</_LaplaceLockText>
    <_LaplaceNativePin Condition="'$(_LaplaceLockText)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(_LaplaceLockText)', '(?m)^native\tLaplace-Native\t([0-9a-f]+)').Groups[1].Value)</_LaplaceNativePin>
    <_LaplaceEnginePin Condition="'$(_LaplaceLockText)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(_LaplaceLockText)', '(?m)^engine\tLaplace-Engine\t([0-9a-f]+)').Groups[1].Value)</_LaplaceEnginePin>
    <LAPLACE_ENGINE_BUILD Condition="'$(LAPLACE_ENGINE_BUILD)' == '' AND '$(OS)' == 'Windows_NT' AND '$(LAPLACE_BUILD_ROOT)' != ''">$(LAPLACE_BUILD_ROOT)\build-win</LAPLACE_ENGINE_BUILD>
    <LAPLACE_ENGINE_BUILD Condition="'$(LAPLACE_ENGINE_BUILD)' == '' AND '$(OS)' == 'Windows_NT'">$(LAPLACE_BUILD)\Laplace-Engine\icx-release</LAPLACE_ENGINE_BUILD>
    <LAPLACE_ENGINE_BUILD Condition="'$(LAPLACE_ENGINE_BUILD)' == ''">$(LAPLACE_BUILD)/Laplace-Engine/icx-release</LAPLACE_ENGINE_BUILD>
    <LaplaceBuildWin Condition="'$(LaplaceBuildWin)' == ''">$(LAPLACE_ENGINE_BUILD)</LaplaceBuildWin>
    <LaplaceNativeVersion Condition="'$(LaplaceNativeVersion)' == ''">0.1.0</LaplaceNativeVersion>
    <LaplaceNativeGenerated Condition="'$(LaplaceNativeGenerated)' == '' AND '$(LAPLACE_NATIVE_PACKAGE)' != '' AND Exists('$(LAPLACE_NATIVE_PACKAGE)/csharp/LaplaceNative.g.cs')">$(LAPLACE_NATIVE_PACKAGE)/csharp</LaplaceNativeGenerated>
    <LaplaceNativeGenerated Condition="'$(LaplaceNativeGenerated)' == '' AND Exists('$(LAPLACE_BUILD)/Laplace-Native/icx-release/csharp/LaplaceNative.g.cs')">$(LAPLACE_BUILD)/Laplace-Native/icx-release/csharp</LaplaceNativeGenerated>
    <LaplaceNativeGenerated Condition="'$(LaplaceNativeGenerated)' == '' AND Exists('$(LAPLACE_BUILD)/Laplace-Native/package/csharp/LaplaceNative.g.cs')">$(LAPLACE_BUILD)/Laplace-Native/package/csharp</LaplaceNativeGenerated>
    <LaplaceNativeGenerated Condition="'$(LaplaceNativeGenerated)' == '' AND Exists('$(LAPLACE_BUILD)/Laplace-Native/build/csharp/LaplaceNative.g.cs')">$(LAPLACE_BUILD)/Laplace-Native/build/csharp</LaplaceNativeGenerated>
    <LaplaceNativeGenerated Condition="'$(LaplaceNativeGenerated)' == '' AND '$(LAPLACE_SITE_BUILD)' != '' AND Exists('$(LAPLACE_SITE_BUILD)/csharp/LaplaceNative.g.cs')">$(LAPLACE_SITE_BUILD)/csharp</LaplaceNativeGenerated>
    <LaplaceNativeGenerated Condition="'$(LaplaceNativeGenerated)' == '' AND Exists('$(LAPLACE_BUILD)/Laplace/release/csharp/LaplaceNative.g.cs')">$(LAPLACE_BUILD)/Laplace/release/csharp</LaplaceNativeGenerated>
    <LaplaceNativeGenerated Condition="'$(LaplaceNativeGenerated)' == ''">$(MSBuildThisFileDirectory)../../../Laplace-Native/build/csharp</LaplaceNativeGenerated>
    <LaplaceNativeInteropProject Condition="'$(LAPLACE_NATIVE)' != '' AND Exists('$(LAPLACE_NATIVE)/bindings/csharp/Laplace.Native.Interop.csproj')">$(LAPLACE_NATIVE)/bindings/csharp/Laplace.Native.Interop.csproj</LaplaceNativeInteropProject>
    <LaplaceNativeInteropProject Condition="'$(LaplaceNativeInteropProject)' == '' AND Exists('$(MSBuildThisFileDirectory)../../Laplace-Native/bindings/csharp/Laplace.Native.Interop.csproj')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../Laplace-Native/bindings/csharp/Laplace.Native.Interop.csproj'))</LaplaceNativeInteropProject>
    <LaplaceNativeInteropProject Condition="'$(LaplaceNativeInteropProject)' == '' AND Exists('/repos/src/Laplace-Native/bindings/csharp/Laplace.Native.Interop.csproj')">/repos/src/Laplace-Native/bindings/csharp/Laplace.Native.Interop.csproj</LaplaceNativeInteropProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LAPLACE_BUILD_ROOT)' != ''">
    <BaseOutputPath>$(LAPLACE_BUILD_ROOT)\app\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(LAPLACE_BUILD_ROOT)\app\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Never compile leftovers from a previous in-repo output layout. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <!--
    dotnet test default filter: exclude Tier=perf, Tier=live, and Category=RequiresQualification
    unless overridden via /p:VSTestTestCaseFilter="...".
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) AND '$(VSTestTestCaseFilter)' == ''">
    <VSTestTestCaseFilter>Tier!=perf&amp;Tier!=live&amp;Category!=RequiresQualification</VSTestTestCaseFilter>
  </PropertyGroup>
  <ItemGroup>
    <!-- Outputs live outside the repo, so tests locate the repo root via metadata. -->
    <AssemblyMetadata Include="LaplaceRepoRoot"
                      Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))" />
  </ItemGroup>
  <PropertyGroup>
    <LAPLACE_INSTALL_PREFIX Condition="'$(LAPLACE_INSTALL_PREFIX)' == ''">/opt/laplace</LAPLACE_INSTALL_PREFIX>
  </PropertyGroup>
  <ItemGroup Condition="'$(OS)' != 'Windows_NT' AND '$(LAPLACE_REUSE_INSTALLED_NATIVE)' == '1'">
    <LaplaceNativeArtifact Include="$(LAPLACE_INSTALL_PREFIX)/lib/liblaplace.so*" />
    <LaplaceNativeArtifact Include="$(LAPLACE_INSTALL_PREFIX)/lib/liblaplace_engine_abi.so*" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' != 'Windows_NT' AND '$(LAPLACE_REUSE_INSTALLED_NATIVE)' != '1'">
    <LaplaceNativeArtifact Condition="'$(LAPLACE_NATIVE_PACKAGE)' != ''" Include="$(LAPLACE_NATIVE_PACKAGE)/lib/liblaplace.so*" />
    <LaplaceNativeArtifact Condition="'$(LAPLACE_ENGINE_PACKAGE)' != ''" Include="$(LAPLACE_ENGINE_PACKAGE)/lib/liblaplace_engine_abi.so*" />
    <LaplaceNativeArtifact Condition="'$(LAPLACE_NATIVE_PACKAGE)' == '' AND '$(_LaplaceNativePin)' != ''" Include="$(LaplacePackagesRoot)/laplace-native/$(_LaplaceNativePin)-*/lib/liblaplace.so*" />
    <LaplaceNativeArtifact Condition="'$(LAPLACE_ENGINE_PACKAGE)' == '' AND '$(_LaplaceEnginePin)' != ''" Include="$(LaplacePackagesRoot)/laplace-engine/$(_LaplaceEnginePin)-*/lib/liblaplace_engine_abi.so*" />
  </ItemGroup>
</Project>
