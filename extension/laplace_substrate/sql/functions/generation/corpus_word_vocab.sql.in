CREATE OR REPLACE FUNCTION generation.corpus_word_vocab(p_size int, p_trajs int DEFAULT 400000)
    RETURNS TABLE(surface text, weight bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC

    WITH t AS (
        SELECT DISTINCT ON (w.id) w.id AS entity_id, w.trajectory
        FROM (SELECT e.id, e.type_id, p.id AS physicality_id, p.trajectory
              FROM laplace.entities e JOIN laplace.physicalities p ON p.entity_id = e.id AND p.type = 1) w
        WHERE w.type_id IN (laplace.entity_type_id('Sentence'), laplace.entity_type_id('Document'))
          AND w.trajectory IS NOT NULL
        ORDER BY w.id, w.physicality_id LIMIT p_trajs
    ),
    w AS MATERIALIZED (
        SELECT tc.entity_id AS id, sum(GREATEST(tc.run_length, 1)) AS c
        FROM t CROSS JOIN LATERAL laplace_trajectory_constituents(t.trajectory) tc
        JOIN laplace.entities e ON e.id = tc.entity_id AND e.type_id = laplace.entity_type_id('Word')
        GROUP BY tc.entity_id
    ),



    -- Rank the complete candidate population, then render in caller-sized pages.
    -- The old `p_size * 4` head could underfill whenever lexical validity was
    -- below 25% in that prefix. Page width is a memory bound derived from the
    -- requested result cardinality; it does not remove candidates.
    ranked AS MATERIALIZED (
        SELECT id, c, row_number() OVER (ORDER BY c DESC, id) AS rn
        FROM w
    ), pages AS MATERIALIZED (
        SELECT ((rn - 1) / GREATEST(p_size, 1)) AS page,
               array_agg(id ORDER BY rn) AS ids
        FROM ranked
        WHERE p_size > 0
        GROUP BY ((rn - 1) / GREATEST(p_size, 1))
    ),
    rendered AS MATERIALIZED (
        SELECT i.id, i.s
        FROM pages p,
             LATERAL ROWS FROM (
                 unnest(p.ids), unnest(ARRAY(SELECT NULLIF(lp_l.content,lp_l.entity::text) FROM unnest((p.ids)::bytea[]) WITH ORDINALITY lp_u(x,n) LEFT JOIN (SELECT DISTINCT ON (lp_d.entity) lp_d.entity,lp_d.content FROM public.laplace_labels(array_remove((p.ids)::bytea[],NULL)::public.blake3[]) lp_d) lp_l ON lp_l.entity=lp_u.x::public.blake3 ORDER BY lp_u.n))
             ) AS i(id, s)
    )
    SELECT xr.s, xw.c
    FROM ranked xw
    JOIN rendered xr ON xr.id = xw.id
    WHERE xr.s ~ '^[A-Za-z][A-Za-z''.-]*$'
    ORDER BY xw.c DESC, xw.id
    LIMIT GREATEST(p_size, 0)
;
END;
