-- ops.reindex_invalid / ops.analyze_substrate: repair what ops.index_health
-- reports.
--
-- One COMMIT per index, so the rebuild is resumable and interruptible:
-- cancelling loses only the index in flight.
--
-- Not CONCURRENTLY: REINDEX CONCURRENTLY is barred inside a transaction block,
-- and a procedure body is always in one. A plain REINDEX locks the index's
-- table exclusively, and the targets are already invalid, so no read was
-- using them.
--
-- No SET clause: a procedure carrying one may not COMMIT, so references are
-- schema-qualified instead (the ops.evict_source rule).

CREATE OR REPLACE PROCEDURE ops.reindex_invalid(p_dry_run boolean DEFAULT false)
    LANGUAGE plpgsql AS $$
DECLARE
    ix        record;
    n         int := 0;
    t0        timestamptz := clock_timestamp();
    t_index   timestamptz;
BEGIN
    FOR ix IN
        SELECT h.index_name, h.table_name, h.schema_name,
               h.is_partitioned_parent, h.leaf_count
        FROM ops.index_health() h
        ORDER BY h.table_name, h.index_name
    LOOP
        n := n + 1;
        IF p_dry_run THEN
            RAISE LOG 'reindex_invalid: WOULD rebuild %.% (partitioned parent: %, leaves: %)',
                ix.table_name, ix.index_name, ix.is_partitioned_parent, ix.leaf_count;
            CONTINUE;
        END IF;

        t_index := clock_timestamp();
        RAISE LOG 'reindex_invalid: rebuilding %.% on %', ix.schema_name, ix.index_name, ix.table_name;
        -- %I on identifiers the catalog supplied, never caller text. The schema
        -- is needed: index names are unique only per schema.
        EXECUTE format('REINDEX INDEX %I.%I', ix.schema_name, ix.index_name);
        IF NOT EXISTS (
            SELECT FROM pg_catalog.pg_index i
            WHERE i.indexrelid = to_regclass(format('%I.%I', ix.schema_name, ix.index_name))
              AND i.indisvalid AND i.indisready) THEN
            RAISE EXCEPTION 'index recovery did not produce a usable %.%', ix.schema_name, ix.index_name;
        END IF;
        COMMIT;
        RAISE LOG 'reindex_invalid: % rebuilt in %s',
            ix.index_name, round(extract(epoch FROM clock_timestamp() - t_index)::numeric, 1);
    END LOOP;

    IF n = 0 THEN
        RAISE LOG 'reindex_invalid: no invalid index — nothing to repair';
    ELSE
        RAISE LOG 'reindex_invalid: % index(es) % in %s',
            n,
            CASE WHEN p_dry_run THEN 'would be rebuilt' ELSE 'rebuilt' END,
            round(extract(epoch FROM clock_timestamp() - t0)::numeric, 1);
    END IF;
END $$;

COMMENT ON PROCEDURE ops.reindex_invalid(boolean) IS
    'Rebuild every index ops.index_health() reports as non-valid, one COMMIT each '
    'so the run is resumable and cancellable. p_dry_run logs the plan without '
    'touching anything. Not CONCURRENTLY: barred inside a procedure, and the '
    'targets are already unusable for reads. CALL ops.reindex_invalid();';

-- ANALYZE is legal inside a transaction and so inside a procedure; VACUUM is
-- not, so a client issues it outside a transaction block.
--
-- No false success (Laplace#1879). ANALYZE by a role without MAINTAIN on a table,
-- or on any leaf partition of it, does not fail: it skips that relation with only a
-- WARNING, and a procedure cannot see a WARNING. So the privilege is checked up front
-- over every relation the run would touch, leaves included, and the run refuses
-- (42501, naming them) before analyzing anything. An ANALYZE that errors is recorded
-- and the run continues to the next table; at the end the procedure raises, naming
-- every table that failed, so a caller never reads a partial run as complete.

CREATE OR REPLACE PROCEDURE ops.analyze_substrate(p_tables text[] DEFAULT NULL)
    LANGUAGE plpgsql AS $$
DECLARE
    t       record;
    n       int := 0;
    t0      timestamptz := clock_timestamp();
    denied  text[];
    failed  text[] := '{}';
BEGIN
    SELECT array_agg(DISTINCT p.relid::regclass::text ORDER BY p.relid::regclass::text)
    INTO denied
    FROM pg_class c
    CROSS JOIN LATERAL pg_partition_tree(c.oid) p
    WHERE c.relnamespace IN ('laplace'::regnamespace, 'realize'::regnamespace,
                             'consensus'::regnamespace, 'generation'::regnamespace)
      AND c.relkind IN ('r', 'p')
      AND (p_tables IS NULL OR c.relname = ANY(p_tables))
      AND NOT pg_catalog.has_table_privilege(p.relid, 'MAINTAIN');
    IF denied IS NOT NULL THEN
        RAISE EXCEPTION 'analyze_substrate: role % may not analyze % relation(s); nothing was analyzed: %',
            current_user, cardinality(denied), array_to_string(denied, ', ')
            USING ERRCODE = 'insufficient_privilege',
                  HINT = 'GRANT MAINTAIN on the substrate tables (every partition) to this role, or run as their owner.';
    END IF;

    FOR t IN
        SELECT c.oid::regclass AS rel
        FROM pg_class c
        WHERE c.relnamespace IN ('laplace'::regnamespace, 'realize'::regnamespace,
                                 'consensus'::regnamespace, 'generation'::regnamespace)
          AND c.relkind IN ('r', 'p')
          AND (p_tables IS NULL OR c.relname = ANY(p_tables))
        ORDER BY c.relname
    LOOP
        n := n + 1;
        BEGIN
            EXECUTE format('ANALYZE %s', t.rel);
        EXCEPTION WHEN OTHERS THEN
            failed := failed || format('%s (%s)', t.rel, SQLERRM);
        END;
        COMMIT;
    END LOOP;

    IF cardinality(failed) > 0 THEN
        RAISE EXCEPTION 'analyze_substrate: % of % table(s) failed ANALYZE: %',
            cardinality(failed), n, array_to_string(failed, '; ');
    END IF;
    IF p_tables IS NOT NULL AND n < cardinality(p_tables) THEN
        RAISE EXCEPTION 'analyze_substrate: % table(s) named, % found in the substrate schemas',
            cardinality(p_tables), n;
    END IF;

    RAISE LOG 'analyze_substrate: % table(s) analyzed in %s',
        n, round(extract(epoch FROM clock_timestamp() - t0)::numeric, 1);
END $$;

COMMENT ON PROCEDURE ops.analyze_substrate(text[]) IS
    'Refresh planner statistics across the substrate schemas, one COMMIT per table. '
    'p_tables NULL = every ordinary and partitioned table. Fixes the class of '
    'slowdown where a correct index is present and the planner will not choose it. '
    'Raises, naming them, when the caller lacks MAINTAIN on any target or leaf partition '
    '(nothing is analyzed then), or when any table fails ANALYZE. '
    'CALL ops.analyze_substrate();';
