-- GENERATED by scripts/codegen-attestation-law.py — do not edit.
-- Highway-axis partitions: hot relations get HASH(subject_id) x8 partitions
-- on consensus + attestations; the low-volume tail shares DEFAULT.
-- Promoting a relation to hot on a POPULATED db is supported: the default
-- partition is detached, the new partitions created, its matching rows
-- drained back through the parent, and the default reattached.
DO $$
DECLARE
    hot text[] := ARRAY[
        'APPEARS_IN',
        'ATTENDS',
        'COMPLETES_TO',
        'CONTAINS',
        'CONTINUES_TO',
        'HAS_DEFINITION',
        'HAS_EXTERNAL_ID',
        'HAS_LANGUAGE',
        'HAS_POS',
        'HAS_SENSE',
        'HAS_SYNSET_KEY',
        'IS_A',
        'IS_SENSE_OF',
        'IS_SYNONYM_OF',
        'IS_TRANSLATION_OF',
        'MOVE',
        'OV_RELATES',
        'PRECEDES',
        'SIMILAR_TO',
        'TOKEN_MAPS_TO'
    ];
    r text; rid bytea; tbl text; part text; dflt text; i int;
    missing text[]; rids bytea[]; moved bigint; has_default boolean;
    -- storage params are per-LEAF (PG forbids them on partitioned parents)
    opts text := ' SET (autovacuum_analyze_scale_factor = 0.02, autovacuum_analyze_threshold = 100000)';
BEGIN
    IF (SELECT c.relkind FROM pg_class c JOIN pg_namespace ns ON ns.oid = c.relnamespace
        WHERE ns.nspname = current_schema() AND c.relname = 'consensus') <> 'p' THEN
        RETURN;  -- legacy plain tables: greenfield layout applies on fresh installs only
    END IF;
    FOREACH tbl IN ARRAY ARRAY['consensus', 'attestations'] LOOP
        -- Which hot relations still lack a partition on THIS table?
        missing := ARRAY(SELECT h FROM unnest(hot) AS h
                         WHERE to_regclass(current_schema() || '.' || tbl || '_r_' || lower(h)) IS NULL);
        IF cardinality(missing) = 0 THEN
            CONTINUE;  -- nothing to do: no lock, no scan
        END IF;
        rids := ARRAY(SELECT relation_type_id(h) FROM unnest(missing) AS h);
        dflt := tbl || '_rdefault';
        has_default := to_regclass(current_schema() || '.' || dflt) IS NOT NULL;
        -- Detach FIRST so each CREATE ... PARTITION OF skips the default's
        -- validation scan (PG scans the default once per new partition
        -- otherwise, and errors outright if it holds a matching row).
        IF has_default THEN
            EXECUTE format('ALTER TABLE %I DETACH PARTITION %I', tbl, dflt);
        END IF;
        FOREACH r IN ARRAY missing LOOP
            rid := relation_type_id(r);
            part := tbl || '_r_' || lower(r);
            EXECUTE format('CREATE TABLE %I PARTITION OF %I FOR VALUES IN (%L) PARTITION BY HASH (subject_id)', part, tbl, rid);
            FOR i IN 0..7 LOOP
                EXECUTE format('CREATE TABLE %I PARTITION OF %I FOR VALUES WITH (MODULUS 8, REMAINDER %s)', part || '_h' || i, part, i);
                EXECUTE format('ALTER TABLE %I', part || '_h' || i) || opts;
            END LOOP;
        END LOOP;
        IF has_default THEN
            -- Drain: rows for the newly-promoted relations move out of the
            -- detached default and back through the parent, which routes
            -- each to its new HASH leaf. Identity is untouched — this is a
            -- physical relocation, never a re-fold (no backfill law).
            EXECUTE format(
                'WITH m AS (DELETE FROM %I WHERE type_id = ANY($1) RETURNING *)'
                || ' INSERT INTO %I SELECT * FROM m', dflt, tbl)
                USING rids;
            GET DIAGNOSTICS moved = ROW_COUNT;
            EXECUTE format('ALTER TABLE %I ATTACH PARTITION %I DEFAULT', tbl, dflt);
            RAISE NOTICE 'laplace: adopted % relation(s) into % partitions (% rows drained from %)', cardinality(missing), tbl, moved, dflt;
        END IF;
    END LOOP;
END $$;
