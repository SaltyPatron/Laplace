<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Laplace.Engine.Core</RootNamespace>
    <AssemblyName>Laplace.Core</AssemblyName>
    <!-- Package queries from the same dependency tree as the linked parsers.
         Standalone seed builds do not inherit the build workflow's environment. -->
    <LaplaceNativeCache>$(LAPLACE_ENGINE_BUILD)/../CMakeCache.txt</LaplaceNativeCache>
    <LaplaceConfiguredExternal Condition="Exists('$(LaplaceNativeCache)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(LaplaceNativeCache)')), '(?m)^LAPLACE_EXTERNAL:(?:PATH|STRING)=([^\r\n]*)').Groups[1].Value)</LaplaceConfiguredExternal>
    <LaplaceGrammarRoot Condition="'$(LaplaceConfiguredExternal)' != ''">$(LaplaceConfiguredExternal)/tree-sitter-grammars</LaplaceGrammarRoot>
    <LaplaceGrammarRoot Condition="'$(LaplaceGrammarRoot)' == '' AND '$(LAPLACE_EXTERNAL)' != ''">$(LAPLACE_EXTERNAL)/tree-sitter-grammars</LaplaceGrammarRoot>
    <LaplaceGrammarRoot Condition="'$(LaplaceGrammarRoot)' == ''">../../external/tree-sitter-grammars</LaplaceGrammarRoot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Laplace.Substrate" />
    <InternalsVisibleTo Include="Laplace.Core.Tests" />
    <InternalsVisibleTo Include="Laplace.Substrate.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../engine/core/grammars/**/queries/*.scm">
      <LogicalName>Laplace.GrammarTags.owned.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(LaplaceGrammarRoot)/**/queries/tags.scm">
      <LogicalName>Laplace.GrammarTags.external.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="RequirePinnedGrammarQueries" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(LaplaceGrammarRoot)/tree-sitter-c/queries/tags.scm')"
           Text="Pinned grammar queries are missing from $(LaplaceGrammarRoot). Configure LAPLACE_ENGINE_BUILD or LAPLACE_EXTERNAL to the dependency tree used by the native parsers." />
  </Target>

</Project>
