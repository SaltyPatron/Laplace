-- Deposit highway-mask bits for the (entity, relation-type) pairs an epoch's
-- edges actually touched — the fold KNOWS every pair in RAM, so the mask is
-- populated at deposit time with ZERO consensus re-reads. This replaces the
-- per-epoch highway_mask_refresh recompute, whose object-side join probed every
-- consensus leaf per touched entity (measured: 75s of a 118s fold).
-- OR-accumulate is correct at ingest: edges are only ever ADDED, so bits only
-- ever turn on; idempotent and chunk-order-free. On a greenfield seed this
-- deposit IS the population — highway_mask_refresh/rebuild are legacy repair
-- verbs for pre-deposit databases and retire once no such DB exists.
--
-- Deposits are entity-sharded BEFORE this function is called. Every entity has
-- one stable writer lane for the run, so concurrent ingest calls are row-disjoint.
-- The former global advisory lock survived that writer correction and silently
-- collapsed the topology-derived mask fanout back to one connection.
--
-- External/online writers can still overlap an ingest. Their safety boundary is
-- deterministic target-row acquisition below: every statement locks `(id,tier)`
-- in bytewise order before the set UPDATE. Two overlapping writers therefore
-- cannot acquire the same rows in opposite order; disjoint ingest shards never
-- wait on each other and no process-global mutex remains.
--
-- History of the earlier shapes, retained so none are repeated:
--
--   bd10fcf  moved the deposit server-side and CONCURRENT → AB/BA deadlocks
--            between fold lanes on shared entity rows (hot words appear in
--            every delta), 10/10 whole-batch retries lost.
--   #729     ordered the locks WITHIN one statement → still deadlocked: the
--            transaction ran a SEQUENCE of chunk statements holding prior
--            chunks' locks.
--   #732/#733 sorted the pairs client-side and committed per chunk → deadlock
--            gone, replaced by a MEASURED 6.4 ms/row FOR NO KEY UPDATE tax
--            (EXPLAIN ANALYZE: 84 ms to find+sort 5,000 rows, 32,039 ms in
--            LockRows) — concurrent lockers minting multixacts per tuple.
--            Fold masks/s: 3,305 (crashing run) → 333 (correct, convoyed).
--   #1112    sharded the lock — hash entities into N buckets, take each chunk's
--            buckets in ASCENDING order. Deadlock-free by the ordered-resource
--            argument, and unlike #729 the ordering is over a bounded set so it
--            survives the sequence of chunk statements; unlike #732/#733 it mints
--            no multixacts. BENCHED, NOT SHIPPED, and it is a dead end: MEASURED
--            2026-08-16, 8 workers x 12 chunks x 70% overlap, 4,000 real row
--            updates, identical to the installed form on every axis —
--            0 deadlocks / 78% lock_wait / 11-12 ms deposit delta, both, twice.
--            The reason is arithmetic: a 500-entity chunk touches 16/16 shards,
--            64/64, 223/256, 399/1024, 475/4096. Hashing entities AFTER the chunk
--            is formed scatters them across every bucket, so "take only the shards
--            you need" is "take them all" plus N acquisitions. Sharding can only
--            pay if the WORK is partitioned shard-locally when the chunk is BUILT,
--            which is a writer change (ConsensusAccumulatingWriter), not a lock
--            change. scripts/tests/highway-deposit-concurrency.sh is the bench;
--            a fifth attempt must beat 0 deadlocks at 78% before it ships.
--
-- #1183 supplied the missing writer change identified above: work is now
-- partitioned shard-locally when the chunk is built. Retaining a global lock
-- after that change was pure serialization, not a correctness mechanism.
DROP FUNCTION IF EXISTS laplace.highway_mask_deposit(bytea[], bytea[]);
CREATE OR REPLACE FUNCTION consensus.highway_mask_deposit(p_entity_ids bytea[], p_type_ids bytea[])
    RETURNS bigint
    LANGUAGE plpgsql VOLATILE AS $$
DECLARE
    updated bigint;
    v_eids  bytea[];
    v_bits  int[];
BEGIN
    IF NOT consensus.highway_ready() THEN
        RAISE WARNING 'highway_mask_deposit: highway perfcache not configured — masks not deposited (set laplace_substrate.highway_perfcache_path)';
        RETURN 0;
    END IF;

    -- COMPUTE BEFORE TARGET ROW LOCKS. MEASURED 2026-08-01 on the English corpus:
    --   highway_mask_deposit        196 calls  651,955 ms  (3,321 ms mean)
    --   its pairs/types/tbits CTE   196 calls  468,420 ms  (2,390 ms mean)
    --   pg_advisory_xact_lock       196 calls  181,947 ms    (928 ms mean)
    -- 72% of each call was the CTE, and the lock was held across ALL of it, so every
    -- other fold lane queued behind work that never touches `entities`. 182 s of that
    -- run was pure convoy wait.
    --
    -- pairs/types/tbits read `consensus` and the unnested arguments and touch no entity
    -- row. Target rows are selected and locked only after this calculation. The UPDATE
    -- then re-reads e.highway_mask from those locked rows, so OR-accumulate cannot lose a
    -- bit even when an external writer reached an overlapping entity first.
    WITH pairs AS (
        SELECT DISTINCT u.eid, u.tid
        FROM unnest(p_entity_ids, p_type_ids) AS u(eid, tid)
    ),
    types AS (SELECT DISTINCT p.tid FROM pairs p),
    tbits AS (
        -- A DYNAMIC relation (EDEP_nsubj, FEAT_case, ...) has no bit of its own;
        -- it contributes its FAMILY ROOT's bit via its IS_A edge (SeedDynamic).
        -- Bounded: one probe per DISTINCT type this epoch (dozens), not per entity.
        SELECT t.tid,
               COALESCE(consensus.relation_highway_bit(t.tid),
                        consensus.relation_highway_bit(fam.object_id)) AS bit
        FROM types t
        LEFT JOIN laplace.consensus fam
          ON fam.subject_id = t.tid
         AND fam.type_id = laplace.relation_type_id('IS_A')
    )
    -- Flat parallel arrays, one element per (entity, bit). NOT array_agg of an int[]:
    -- that yields a 2-D array, and unnest() flattens multidimensional arrays completely
    -- rather than yielding rows of arrays, so the pairing would be silently destroyed.
    SELECT array_agg(y.eid), array_agg(y.bit)
      INTO v_eids, v_bits
    FROM (
        SELECT DISTINCT p.eid, tb.bit
        FROM pairs p
        JOIN tbits tb ON tb.tid = p.tid
        WHERE tb.bit IS NOT NULL
    ) y;

    IF v_eids IS NULL OR array_length(v_eids, 1) IS NULL THEN
        RETURN 0;
    END IF;

    WITH d AS (
        SELECT u.eid, array_agg(DISTINCT u.bit) AS bits
        FROM unnest(v_eids, v_bits) AS u(eid, bit)
        GROUP BY u.eid
    ),
    targets AS MATERIALIZED (
        SELECT e.id, e.tier, d.bits
        FROM laplace.entities e
        JOIN d ON d.eid = e.id
        WHERE e.highway_mask IS NULL
           OR NOT (consensus.highway_mask_bits(e.highway_mask) @> d.bits)
        ORDER BY e.id, e.tier
        FOR NO KEY UPDATE OF e
    ),
    upd AS (
        UPDATE laplace.entities e
        SET highway_mask = consensus.highway_mask_from_bits(
                COALESCE(consensus.highway_mask_bits(e.highway_mask), ARRAY[]::int[]) || t.bits)
        FROM targets t
        WHERE e.id = t.id AND e.tier = t.tier
        RETURNING 1
    )
    SELECT count(*) INTO updated FROM upd;
    RETURN updated;
END $$;
