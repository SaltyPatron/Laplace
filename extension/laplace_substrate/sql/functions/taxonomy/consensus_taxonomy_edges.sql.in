-- taxonomy.consensus_taxonomy_edges — GH #862. Real schema names, no install-time
-- schema placeholder (schema = 'laplace', relocatable = false: one possible expansion).

CREATE OR REPLACE FUNCTION taxonomy.consensus_taxonomy_edges_batch(
        p_subjects bytea[],
        p_types    bytea[])
    RETURNS TABLE(ord bigint, object_id bytea, type_id bytea, rating bigint, rd bigint)
    LANGUAGE plpgsql STABLE PARALLEL SAFE
AS $$
BEGIN
    IF COALESCE(cardinality(p_subjects), 0) = 0
       OR COALESCE(cardinality(p_types), 0) = 0 THEN
        RETURN;
    END IF;

    RETURN QUERY
    WITH frontier AS MATERIALIZED (
        SELECT u.id AS subject_id, u.ord
        FROM unnest(p_subjects) WITH ORDINALITY AS u(id, ord)
        WHERE u.id IS NOT NULL
    ),
    rel_reg AS MATERIALIZED (
        SELECT r.type_id FROM laplace.relation_registry() r
    ),
    raw_edges AS MATERIALIZED (
        SELECT e.subject_id, e.neighbour_id AS object_id,
               COALESCE(laplace.relation_type_id(consensus.relation_canonical(e.type_id)), e.type_id) AS type_id,
               e.rating, e.rd
        FROM consensus.edges_raw_batch(p_subjects, 'out', p_types, 64, false, 'eff_mu') e
        WHERE e.neighbour_id IS NOT NULL
          AND COALESCE(laplace.relation_type_id(consensus.relation_canonical(e.type_id)), e.type_id) = ANY (p_types)
          AND NOT EXISTS (SELECT 1 FROM rel_reg r WHERE r.type_id = e.neighbour_id)
    )
    SELECT f.ord, c.object_id, c.type_id, c.rating, c.rd
    FROM frontier f
    JOIN raw_edges c ON c.subject_id = f.subject_id
    ORDER BY f.ord;
END;
$$;

CREATE OR REPLACE FUNCTION taxonomy.consensus_taxonomy_edges(p_subject bytea, p_types bytea[])
    RETURNS TABLE(object_id bytea, type_id bytea, rating bigint, rd bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT b.object_id, b.type_id, b.rating, b.rd
    FROM taxonomy.consensus_taxonomy_edges_batch(
        CASE WHEN p_subject IS NULL THEN '{}'::bytea[] ELSE ARRAY[p_subject] END,
        p_types) b;
END;
