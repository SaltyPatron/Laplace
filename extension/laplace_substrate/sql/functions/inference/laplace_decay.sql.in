CREATE OR REPLACE FUNCTION generation.laplace_decay(
    p_subject  bytea, p_type  bytea, p_object  bytea,
    p_decay_factor float8 DEFAULT 0.95)
RETURNS void
LANGUAGE plpgsql VOLATILE AS $$
DECLARE
    v_id bytea := laplace.consensus_id(p_subject, p_type, p_object);
BEGIN
    UPDATE laplace.consensus
    SET rd = LEAST((rd / p_decay_factor)::bigint, consensus.glicko2_initial_rd())
    WHERE id = v_id;
END;
$$;
