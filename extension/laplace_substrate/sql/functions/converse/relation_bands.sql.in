-- The salience bands: the lens vocabulary.
--
-- A band is a set of relation types sharing a read-time rank, addressed by one
-- precomputed highway mask. Selecting bands is how a caller narrows a read
-- without naming a single relation and without naming a language.
--
-- relation_band_catalog() is immutable naming. Counts exposed as consensus_rows
-- are exact statement-snapshot counts, shared with ops.relation_band_census().
-- Planner MCV lists omit uncommon relation types and must never decide whether
-- a populated band is available to query.
DROP FUNCTION IF EXISTS laplace.relation_band_catalog();
CREATE OR REPLACE FUNCTION converse.relation_band_catalog()
    RETURNS TABLE(band integer, name text, rank double precision)
    LANGUAGE sql IMMUTABLE PARALLEL SAFE
BEGIN ATOMIC
    VALUES
      (0,  'mandate',              1.00::double precision),
      (1,  'definitional',         0.97),
      (2,  'taxonomic',            0.90),
      (3,  'equivalence',          0.82),
      (4,  'partitive',            0.73),
      (5,  'causal',               0.64),
      (6,  'oppositional',         0.45),
      (7,  'associative',          0.36),
      (8,  'tensor_calculation',   0.27),
      (9,  'lexical_glue',         0.18),
      (10, 'scalar_valued',        0.12),
      (11, 'standards_structural', 0.08),
      (12, 'probationary',         0.05);
END;

-- One aggregate over the registered consensus types. Do not replace absent
-- planner statistics with zero or execute a separate count for each type/band.
CREATE OR REPLACE FUNCTION ops.relation_band_census()
    RETURNS TABLE(band integer, name text, relation_types bigint, consensus_rows bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH members AS MATERIALIZED (
        SELECT r.band::integer AS band, r.type_id
        FROM laplace.relation_registry() r
    ), counted AS MATERIALIZED (
        SELECT c.type_id, count(*)::bigint AS rows
        FROM laplace.consensus c
        WHERE c.type_id IN (SELECT m.type_id FROM members m)
        GROUP BY c.type_id
    )
    SELECT b.band, b.name, count(m.type_id)::bigint, COALESCE(sum(k.rows), 0)::bigint
    FROM converse.relation_band_catalog() AS b
    LEFT JOIN members m ON m.band = b.band
    LEFT JOIN counted k ON k.type_id = m.type_id
    GROUP BY b.band, b.name
    ORDER BY b.band;
END;

DROP FUNCTION IF EXISTS laplace.relation_bands();
CREATE OR REPLACE FUNCTION converse.relation_bands()
    RETURNS TABLE(band integer, name text, rank double precision,
                  relation_types bigint, consensus_rows bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT c.band, c.name, b.rank, c.relation_types, c.consensus_rows
    FROM ops.relation_band_census() c
    JOIN converse.relation_band_catalog() b ON b.band = c.band
    ORDER BY c.band;
END;
