-- ops.cancel_backend / ops.terminate_backend: stop running work as a named
-- operation. ops.ingest_run_close edits the journal row only; these signal the
-- backend itself.
--
-- Both return what they acted on, captured before the signal; reading after
-- would race the backend's teardown. Three refusals, because the pid is free
-- text from a caller:
--   * a pid on another database (pg_cancel_backend is cluster-wide);
--   * this backend's own pid (the call would abort itself and report nothing);
--   * a pid that is not there (signalling it returns false, which would read
--     as a refusal).
--
-- Cancel ends the running statement and leaves the session to roll back.
-- Terminate drops the connection, for a backend that ignored a cancel; its
-- open transaction is lost.
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.cancel_backend(int)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(pid integer, signalled boolean, was_state text, was_query text, was_seconds double precision)'
             OR proargnames IS DISTINCT FROM ARRAY['p_pid','pid','signalled','was_state','was_query','was_seconds']::text[])) THEN
        DROP FUNCTION ops.cancel_backend(int);
    END IF;
END $upgrade_shape$;
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.terminate_backend(int)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(pid integer, signalled boolean, was_state text, was_query text, was_seconds double precision)'
             OR proargnames IS DISTINCT FROM ARRAY['p_pid','pid','signalled','was_state','was_query','was_seconds']::text[])) THEN
        DROP FUNCTION ops.terminate_backend(int);
    END IF;
END $upgrade_shape$;

CREATE OR REPLACE FUNCTION ops.cancel_backend(p_pid int)
    RETURNS TABLE(pid int, signalled boolean, was_state text, was_query text,
                  was_seconds double precision)
    LANGUAGE plpgsql VOLATILE
    AS $$
DECLARE
    a pg_stat_activity%ROWTYPE;
BEGIN
    SELECT * INTO a FROM pg_stat_activity s WHERE s.pid = p_pid;
    IF a.pid IS NULL THEN
        RAISE EXCEPTION 'cancel_backend: no backend with pid % is running', p_pid;
    END IF;
    IF a.datname IS DISTINCT FROM current_database() THEN
        RAISE EXCEPTION 'cancel_backend: pid % belongs to database %, not %',
            p_pid, COALESCE(a.datname, '(none)'), current_database();
    END IF;
    IF p_pid = pg_backend_pid() THEN
        RAISE EXCEPTION 'cancel_backend: pid % is this session — cancelling it aborts this call', p_pid;
    END IF;

    RETURN QUERY
    SELECT p_pid,
           pg_cancel_backend(p_pid),
           a.state,
           a.query,
           extract(epoch FROM clock_timestamp() - COALESCE(a.query_start, a.backend_start))::double precision;
END $$;

CREATE OR REPLACE FUNCTION ops.terminate_backend(p_pid int)
    RETURNS TABLE(pid int, signalled boolean, was_state text, was_query text,
                  was_seconds double precision)
    LANGUAGE plpgsql VOLATILE
    AS $$
DECLARE
    a pg_stat_activity%ROWTYPE;
BEGIN
    SELECT * INTO a FROM pg_stat_activity s WHERE s.pid = p_pid;
    IF a.pid IS NULL THEN
        RAISE EXCEPTION 'terminate_backend: no backend with pid % is running', p_pid;
    END IF;
    IF a.datname IS DISTINCT FROM current_database() THEN
        RAISE EXCEPTION 'terminate_backend: pid % belongs to database %, not %',
            p_pid, COALESCE(a.datname, '(none)'), current_database();
    END IF;
    IF p_pid = pg_backend_pid() THEN
        RAISE EXCEPTION 'terminate_backend: pid % is this session', p_pid;
    END IF;

    RETURN QUERY
    SELECT p_pid,
           pg_terminate_backend(p_pid),
           a.state,
           a.query,
           extract(epoch FROM clock_timestamp() - COALESCE(a.query_start, a.backend_start))::double precision;
END $$;

COMMENT ON FUNCTION ops.cancel_backend(int) IS
    'Cancel the running statement on one backend of THIS database, returning the '
    'state and query captured before the signal. Refuses another database, a dead '
    'pid, and this session. signalled=false means the role lacks pg_signal_backend.';

COMMENT ON FUNCTION ops.terminate_backend(int) IS
    'Drop one backend of THIS database — the escalation for a backend that ignored '
    'a cancel. Same refusals and same before-the-signal capture as ops.cancel_backend.';
