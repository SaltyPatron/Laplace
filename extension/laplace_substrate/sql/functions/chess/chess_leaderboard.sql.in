CREATE OR REPLACE FUNCTION chess_leaderboard(p_limit integer DEFAULT 200)
    RETURNS TABLE(rank bigint, player_id bytea, name text, games bigint,
                  wins bigint, draws bigint, losses bigint, unscored bigint,
                  score double precision)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    -- The roster of everyone the corpus has ever witnessed at a board, ranked by
    -- how much of him it witnessed. One pass over the two colour-header relations
    -- joined to HAS_RESULT scores every player at once -- 400k header rows for
    -- 200k games -- rather than 33k per-player round trips.
    --
    -- LIMIT is the only cut, as everywhere: no minimum-games floor, no rating
    -- threshold. A one-game player is a real witness with a one-game record and
    -- is simply further down the list.
    --
    -- Names come back through realize_batch (the native batched resolver), NOT
    -- per-row label(): resolving 200 names one at a time costs ~9s of render
    -- recursion and dominates the aggregate; batched it is ~0.2s. Callers that
    -- page this list should cache it -- the whole aggregate is ~10s cold and
    -- only moves when a new PGN lands.
    WITH sides AS MATERIALIZED (
        SELECT a.subject_id AS game, a.object_id AS player,
               (a.type_id = @extschema@.relation_type_id('HAS_WHITE')) AS white
        FROM @extschema@.attestations a
        WHERE a.type_id IN (@extschema@.relation_type_id('HAS_WHITE'),
                            @extschema@.relation_type_id('HAS_BLACK'))
    ),
    scored AS MATERIALIZED (
        SELECT s.player,
               @extschema@.chess_outcome(s.white, r.object_id) AS outcome
        FROM sides s
        LEFT JOIN @extschema@.attestations r
               ON r.subject_id = s.game
              AND r.type_id = @extschema@.relation_type_id('HAS_RESULT')
    ),
    rec AS MATERIALIZED (
        SELECT sc.player,
               count(*)::bigint AS games,
               count(*) FILTER (WHERE sc.outcome = 2)::bigint AS wins,
               count(*) FILTER (WHERE sc.outcome = 1)::bigint AS draws,
               count(*) FILTER (WHERE sc.outcome = 0)::bigint AS losses,
               count(*) FILTER (WHERE sc.outcome IS NULL)::bigint AS unscored
        FROM scored sc
        GROUP BY sc.player
        ORDER BY 2 DESC, 1
        LIMIT p_limit
    ),
    batch AS MATERIALIZED (
        SELECT COALESCE(array_agg(rec.player ORDER BY rec.games DESC, rec.player),
                        '{}'::bytea[]) AS ids
        FROM rec
    ),
    named AS (
        SELECT p.id, t.txt
        FROM batch b,
             LATERAL unnest(b.ids) WITH ORDINALITY AS p(id, i),
             LATERAL unnest(@extschema@.realize_batch(b.ids)) WITH ORDINALITY AS t(txt, j)
        WHERE p.i = t.j
    )
    SELECT row_number() OVER (ORDER BY rec.games DESC, rec.player)::bigint,
           rec.player,
           COALESCE(NULLIF(n.txt, ''), encode(rec.player, 'hex')),
           rec.games, rec.wins, rec.draws, rec.losses, rec.unscored,
           (rec.wins + rec.draws / 2.0)
           / NULLIF(rec.games - rec.unscored, 0)
    FROM rec
    LEFT JOIN named n ON n.id = rec.player
    ORDER BY rec.games DESC, rec.player
$$;
