CREATE TYPE @extschema@.consensus_fold_result AS (
    rating bigint, rd bigint, volatility bigint, witness_count bigint);
CREATE OR REPLACE FUNCTION @extschema@.consensus_fold_step(
        internal, boolean, bigint, bigint, bigint, bigint, bigint, bigint, bigint, bigint)
    RETURNS internal LANGUAGE C PARALLEL RESTRICTED
    AS 'MODULE_PATHNAME', 'pg_laplace_consensus_fold_step_v2';
CREATE OR REPLACE FUNCTION @extschema@.consensus_fold_step(
        internal, boolean, bigint, bigint, bigint, bigint, bigint, bigint, bigint)
    RETURNS internal LANGUAGE C PARALLEL RESTRICTED
    AS 'MODULE_PATHNAME', 'pg_laplace_consensus_fold_step';
CREATE OR REPLACE FUNCTION @extschema@.consensus_fold_final(internal)
    RETURNS @extschema@.consensus_fold_result LANGUAGE C PARALLEL RESTRICTED
    AS 'MODULE_PATHNAME', 'pg_laplace_consensus_fold_final';
CREATE AGGREGATE @extschema@.consensus_fold(
        boolean, bigint, bigint, bigint, bigint, bigint, bigint, bigint, bigint) (
    SFUNC     = @extschema@.consensus_fold_step,
    STYPE     = internal,
    FINALFUNC = @extschema@.consensus_fold_final
);
CREATE AGGREGATE @extschema@.consensus_fold(
        boolean, bigint, bigint, bigint, bigint, bigint, bigint, bigint) (
    SFUNC     = @extschema@.consensus_fold_step,
    STYPE     = internal,
    FINALFUNC = @extschema@.consensus_fold_final
);
