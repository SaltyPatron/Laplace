DROP FUNCTION IF EXISTS laplace.grapheme_floor_vocab(int, int);
CREATE OR REPLACE FUNCTION generation.grapheme_floor_vocab(p_size int DEFAULT 512, p_words int DEFAULT 50000)
    RETURNS TABLE(entity_id bytea, surface text, weight bigint)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    
    
    
    
    WITH t AS (
        SELECT w.trajectory
        FROM laplace.v_word_points w
        WHERE w.type_id = realize.canonical_id('Word')
          AND w.trajectory IS NOT NULL
        ORDER BY w.id LIMIT p_words
    ),
    g AS (
        SELECT tc.entity_id, tc.run_length
        FROM t CROSS JOIN LATERAL laplace_trajectory_constituents(t.trajectory) tc
    ),
    agg AS (
        
        
        SELECT g.entity_id, sum(GREATEST(g.run_length,1))::bigint AS cnt
        FROM g JOIN laplace.entities e ON e.id = g.entity_id AND e.type_id IN (realize.canonical_id('Codepoint'), realize.canonical_id('Grapheme'))
        GROUP BY g.entity_id
    ),
    named AS MATERIALIZED (
        SELECT a.entity_id, a.cnt
        FROM agg a ORDER BY a.cnt DESC, a.entity_id LIMIT p_size * 2
    ), ids AS MATERIALIZED (
        SELECT array_agg(entity_id ORDER BY cnt DESC, entity_id) AS a FROM named
    ), rendered AS MATERIALIZED (
        SELECT i.id, t.s
        FROM ids,
             LATERAL unnest(ids.a) WITH ORDINALITY AS i(id, ord),
             LATERAL unnest(realize.render_text_batch(ids.a, 8)) WITH ORDINALITY AS t(s, ord)
        WHERE i.ord = t.ord
    )
    SELECT n.entity_id, r.s, n.cnt
    FROM named n JOIN rendered r ON r.id = n.entity_id
    WHERE char_length(r.s) = 1 AND NOT realize.is_all_whitespace(r.s)
    ORDER BY n.cnt DESC LIMIT p_size
$$;
