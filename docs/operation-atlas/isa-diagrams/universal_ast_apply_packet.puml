@startuml
skinparam backgroundColor #FAFCFF
skinparam shadowing false
skinparam defaultFontName SansSerif
title Refactor ISA — universal_ast_apply_packet
start
:Entry after whole-program validation;

if (Isolated mutation-test build disables AST execution?) then (yes)
 :Return INPUT_OUT_OF_RANGE;
 stop
endif
if (Program, instruction or values absent?) then (yes)
 :Return INVALID_ARGUMENT;
 stop
endif
:laplace_universal_ast_packet_validate_words;
if (Native memory failure?) then (yes)
 :Return RESOURCE_INSUFFICIENT;
 stop
elseif (Other non-OK status?) then (yes)
 :Return INPUT_OUT_OF_RANGE;
 stop
endif
:Encode AST packet receipt;
:Set output.count = LAPLACE_UNIVERSAL_AST_RECEIPT_WORDS;
:Return ISA_OK;
stop
legend
Execute-wrapper source trace.
Validation and native semantic callees are separate boundaries.
No runtime acceptance asserted.
endlegend
@enduml
