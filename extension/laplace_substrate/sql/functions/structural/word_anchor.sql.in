-- Canonical Native point and packed path. hilbert_index carries the Native
-- 64-bit key in network byte order; it is not the retired 128-bit encoding.
DROP FUNCTION IF EXISTS laplace.word_anchor(bytea);
CREATE OR REPLACE FUNCTION structural.word_anchor(p_id bytea)
    RETURNS TABLE(
        id          bytea,
        type_id     bytea,
        tier        smallint,
        coord       geometry,
        trajectory  geometry,
        hilbert_index bytea)
    LANGUAGE sql STABLE PARALLEL SAFE
    -- STRUCTURAL bound, not an estimate: the body ends in LIMIT 1, so this
    -- returns at most one row. Undeclared, Postgres assumes 1000 -- a 1000x
    -- overestimate on the inner side of any join, which is what makes scanning
    -- look cheaper than probing.
    ROWS 1
BEGIN ATOMIC
    SELECT public.blake3_send(e.id),NULL::bytea,e.tier,e.coord,p.path,pg_catalog.int8send(e.hilbert)
    FROM public.laplace_entities(ARRAY[encode(p_id,'hex')::public.blake3]) e
    LEFT JOIN public.laplace_physicalities(ARRAY[encode(p_id,'hex')::public.blake3]) p ON p.entity=e.id;
END;
