-- Resident counts split by source family. Evidence shares come from the
-- planner-statistics source census, never an exact aggregate: chess and
-- multilingual by source name, the remainder as text evidence. Models count
-- their ATTENDS cells; documents count Document entities, since a document is
-- structure, not attestations.
DROP FUNCTION IF EXISTS laplace.modality_counts();

CREATE OR REPLACE FUNCTION ops.modality_counts()
    RETURNS TABLE(
        text_evidence bigint,
        chess bigint,
        models bigint,
        multilingual bigint,
        documents bigint)
    LANGUAGE sql
    STABLE
BEGIN ATOMIC
    WITH s AS (SELECT source, evidence_approx FROM ops.source_counts_approx()),
    parts AS (
      SELECT
        COALESCE((SELECT sum(evidence_approx) FROM s), 0)::bigint AS total,
        COALESCE((SELECT sum(evidence_approx) FROM s WHERE source ILIKE '%chess%'), 0)::bigint AS chess,
        (SELECT count(*) FROM laplace.consensus c
           WHERE c.type_id = laplace.relation_type_id('ATTENDS'))::bigint AS models,
        COALESCE((SELECT sum(evidence_approx) FROM s
           WHERE source ILIKE '%OMWDecomposer%' OR source ILIKE '%tatoeba%'), 0)::bigint AS multilingual,
        COALESCE(ops.entity_count(laplace.entity_type_id('Document')), 0)::bigint AS documents)
    SELECT greatest(0, p.total - p.chess - p.models - p.multilingual),
           p.chess, p.models, p.multilingual, p.documents
    FROM parts p;
END;
