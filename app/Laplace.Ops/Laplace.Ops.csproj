<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Laplace.Ops</RootNamespace>
    <AssemblyName>Laplace.Ops</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Laplace.Core.Tests" />
    <InternalsVisibleTo Include="Laplace.Endpoints.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Serilog owns structured routing, JSONL rolling and sink failure reporting.
         The CSV compatibility sink keeps the file_fdw pathname stable across
         bounded rollover. Core stays independent of the logging packages. -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Laplace.Core\Laplace.Core.csproj" />
  </ItemGroup>

</Project>
