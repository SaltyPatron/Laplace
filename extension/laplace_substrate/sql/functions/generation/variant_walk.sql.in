DROP FUNCTION IF EXISTS laplace.variant_walk(bytea, float8, int, int);
CREATE OR REPLACE FUNCTION generation.variant_walk(p_id bytea, p_swap float8 DEFAULT 0.3,
                          p_k int DEFAULT 6, p_depth int DEFAULT 4)
    RETURNS text
    AS 'MODULE_PATHNAME', 'pg_laplace_variant_walk'
    LANGUAGE C VOLATILE;
