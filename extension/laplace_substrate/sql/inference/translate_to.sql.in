


DROP FUNCTION IF EXISTS laplace.translate_to(bytea, text, int);
CREATE OR REPLACE FUNCTION converse.translate_to(p_word bytea, p_lang text DEFAULT NULL,
                                        p_limit int DEFAULT 24)
    RETURNS TABLE(translation text, language text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH src_langs AS (
        SELECT c.object_id AS id FROM laplace.consensus c
        WHERE c.subject_id = p_word AND c.type_id = laplace.relation_type_id('HAS_LANGUAGE')
          AND c.object_id IS NOT NULL
    ),
    want AS (SELECT NULLIF(btrim(lower(COALESCE(p_lang, ''))), '') AS name),
    agg AS MATERIALIZED (
        SELECT sm.member, sm.lang, max(sm.mu) AS mu, max(sm.witnesses) AS witnesses,
               max(sm.sense_mu) AS sense_mu
        FROM lexical.synset_members(p_word) sm
        WHERE sm.lang IS NOT NULL
          AND sm.lang NOT IN (SELECT id FROM src_langs)
        GROUP BY sm.member, sm.lang
    ),
    cand_langs AS MATERIALIZED (
        SELECT array_agg(DISTINCT lang ORDER BY lang) AS langs FROM agg
    ),
    cand_lang_labels AS MATERIALIZED (
        SELECT u.lang, u.lbl, lower(u.lbl) AS lower_lbl
        FROM cand_langs cl,
             LATERAL ROWS FROM (
                 unnest(cl.langs),
                 unnest(realize.label_batch(cl.langs))
             ) AS u(lang, lbl)
    ),
    lang_def_edges AS MATERIALIZED (
        SELECT d.subject_id AS lang, d.object_id AS def_id,
               row_number() OVER (ORDER BY d.subject_id, d.object_id) AS rn
        FROM laplace.consensus d, want w0, cand_langs cl
        WHERE w0.name IS NOT NULL
          AND cl.langs IS NOT NULL
          AND d.subject_id = ANY (cl.langs)
          AND d.type_id = laplace.relation_type_id('HAS_DEFINITION')
          AND consensus.eff_mu(d.rating, d.rd) > 0
    ),
    lang_def_rendered AS MATERIALIZED (
        SELECT realize.render_text_batch(array_agg(def_id ORDER BY rn)) AS txt
        FROM lang_def_edges
    ),
    lang_def_names AS MATERIALIZED (
        SELECT e.lang, lower(r.txt[e.rn]) AS dname
        FROM lang_def_edges e
        CROSS JOIN lang_def_rendered r
    ),
    lang_match AS (
        SELECT l.lang
        FROM cand_lang_labels l, want w
        WHERE w.name IS NULL
        UNION ALL
        SELECT l.lang
        FROM cand_lang_labels l, want w
        WHERE w.name IS NOT NULL
          AND (l.lower_lbl = w.name
               OR l.lang IN (SELECT ld.lang FROM lang_def_names ld WHERE ld.dname = w.name))
    ),
    ranked AS MATERIALIZED (
        SELECT a.member, a.lang, a.mu, a.witnesses,
               row_number() OVER (ORDER BY a.sense_mu DESC NULLS LAST, a.mu DESC, a.witnesses DESC, a.lang, a.member) AS rn
        FROM agg a
        WHERE a.lang IN (SELECT lang FROM lang_match)
        ORDER BY a.sense_mu DESC NULLS LAST, a.mu DESC, a.witnesses DESC, a.lang, a.member
        LIMIT p_limit
    ),
    rendered AS MATERIALIZED (
        SELECT realize.render_text_batch(array_agg(member ORDER BY rn)) AS txt
        FROM ranked
    )
    SELECT NULLIF(btrim(r.txt[a.rn]), '') AS translation,
           cl.lbl AS language,
           consensus.eff_mu_display(a.mu),
           a.witnesses
    FROM ranked a
    CROSS JOIN rendered r
    LEFT JOIN cand_lang_labels cl ON cl.lang = a.lang
    WHERE NULLIF(btrim(r.txt[a.rn]), '') IS NOT NULL
    ORDER BY a.rn;
END;
