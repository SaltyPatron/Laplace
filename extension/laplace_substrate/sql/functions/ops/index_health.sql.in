-- ops.index_health: every non-valid index in the extension's schemas (empty
-- set = healthy), with leaf coverage for partitioned parents so an empty shell
-- (leaves = 0) is distinguishable from a build in progress (indisvalid = false,
-- leaves > 0). One installed operation for every surface; floor checks call it.
-- BEGIN ATOMIC: pg_catalog oids are stable and the regnamespace literals name
-- schemas this extension guarantees.
-- schema_name is the last column: ops.reindex_invalid needs it because an index
-- name alone is ambiguous across the substrate schemas.
CREATE OR REPLACE FUNCTION ops.index_health()
    RETURNS TABLE(index_name text, table_name text, valid boolean,
                  is_partitioned_parent boolean, leaf_count bigint,
                  schema_name text)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT c.relname::text,
           t.relname::text,
           i.indisvalid,
           t.relkind = 'p',
           (SELECT count(*) FROM pg_catalog.pg_inherits h
             WHERE h.inhparent = i.indexrelid),
           t.relnamespace::regnamespace::text
    FROM pg_catalog.pg_index i
    JOIN pg_catalog.pg_class c ON c.oid = i.indexrelid
    JOIN pg_catalog.pg_class t ON t.oid = i.indrelid
    WHERE t.relnamespace IN ('laplace'::regnamespace, 'realize'::regnamespace,
                             'consensus'::regnamespace, 'generation'::regnamespace)
      AND NOT i.indisvalid
    ORDER BY 2, 1;
END;

COMMENT ON FUNCTION ops.index_health() IS
    'Every non-valid index in the substrate schemas. '
    'leaf_count 0 on a partitioned parent = the 2026-08-13 shell class: '
    'present in the catalog, unusable for reads, invisible to row counts.';
