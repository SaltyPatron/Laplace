-- Native, level-synchronous constituent closure.  The C SRF selects one
-- deterministic type-1 manifest for every frontier node, expands each packed
-- RLE record as an ordered edge (retaining run_length and flags), and performs
-- no recursive SQL or per-node query loop.
DROP FUNCTION IF EXISTS laplace.constituents_closure(bytea[], integer);
CREATE OR REPLACE FUNCTION realize.constituents_closure(
    p_roots bytea[],
    p_max_depth integer DEFAULT 0
)
RETURNS TABLE(
    parent_id bytea,
    ordinal integer,
    child_id bytea,
    run_length integer,
    flags bigint
)
AS 'MODULE_PATHNAME', 'pg_laplace_constituents_closure'
LANGUAGE C STABLE PARALLEL RESTRICTED;
