-- attestations: attributable testimony, HASH-partitioned on subject_id exactly
-- like consensus, so a working set's testimony and the cells it folds route to
-- the same leaf number. Relation types are content ids and unbounded; the layout
-- never depends on which relations exist. Leaf count is declared once here;
-- native routing reads it from the partition descriptor.
--
-- qualifier_mask carries the claim's governed qualifiers (engine/manifest/
-- qualifiers.toml): multi-select variant flags such as identifier/iso639-1 or
-- mapping/upper, so one relation per meaning holds every variant as one claim.
-- It is the sister of an entity's highway_mask, never a copy of the relation's
-- highway bit; the native intent-stage tuple layout writes it
-- (IntentStage.CopyColumnList).
--
-- PK includes the partition key; no FKs (see consensus.sql.in).
-- Additive witness fields must also migrate existing evidence in place.
CREATE TABLE IF NOT EXISTS attestations (
    id                bytea         NOT NULL CHECK (octet_length(id) = 16),
    subject_id        bytea         NOT NULL,
    type_id           bytea         NOT NULL,
    object_id         bytea,
    source_id         bytea         NOT NULL,
    context_id        bytea,
    outcome           smallint      NOT NULL CHECK (outcome IN (0, 1, 2)),
    last_observed_at  timestamptz   NOT NULL,
    observation_count bigint        NOT NULL DEFAULT 1 CHECK (observation_count >= 0),
    -- The fold's EXACT inputs, persisted so evidence is a complete record of
    -- what was folded (lawful refold/evict; exact scoped_consensus):
    --   sum_score_fp1e9   — total 1e9-fixed-point score across this row's
    --                       observations (score x games for per-row deposits;
    --                       the aggregated cell's total otherwise). Accumulates
    --                       additively on merge, exactly like observation_count.
    --   opponent_rd_fp1e9 — the per-deposit opponent phi (trust x rank via
    --                       laplace_attestation_witness_phi). Identity pins
    --                       (subject, type, object, source, context), so every
    --                       merge of the same row re-witnesses under the same
    --                       source and relation: the incoming phi IS the stored
    --                       phi, and the merge keeps the existing value.
    sum_score_fp1e9   bigint        NOT NULL,
    opponent_rd_fp1e9 bigint        NOT NULL,
    --   opponent_rating_fp1e9 — the per-deposit opponent RATING (GH #1321). Until
    --                       this column existed the fold passed
    --                       CONSENSUS_FOLD_NEUTRAL_MU as the opponent on every
    --                       call, so every cell replayed one match against a
    --                       constant 1500 and the rating degenerated into a
    --                       witness counter. The RD half was already stored here;
    --                       this is the half that carries the surprise term.
    --                       DEFAULT is neutral, not 0: a row that does not set it
    --                       must fold exactly as the substrate did before, not
    --                       against a rating-0 opponent.
    opponent_rating_fp1e9 bigint    NOT NULL DEFAULT 1500000000000,
    -- Transient-calibration receipts are durable categorical provenance but
    -- their continuous native score was consumed atomically at ingest and is
    -- deliberately unrecoverable.  Refold/evict must exclude these rows.
    fold_replayable    boolean       NOT NULL DEFAULT true,
    qualifier_mask    bytea         CHECK (qualifier_mask IS NULL OR octet_length(qualifier_mask) = 32),
    PRIMARY KEY (id, type_id, subject_id)
) PARTITION BY HASH (subject_id);


DO $$
DECLARE
    b int;
    suffix text;
    strategy "char";
    opts constant text := ' SET (autovacuum_analyze_scale_factor = 0.02, autovacuum_analyze_threshold = 100000)';
BEGIN
    SELECT p.partstrat INTO strategy
    FROM pg_partitioned_table p
    WHERE p.partrelid = (current_schema() || '.attestations')::regclass;
    IF strategy IS DISTINCT FROM 'h' THEN
        RAISE EXCEPTION
            'attestations uses an obsolete partition layout; this version requires HASH(subject_id). Create a new canonical database.';
    END IF;
    IF to_regclass(current_schema() || '.attestations_h00') IS NOT NULL THEN
        RETURN;
    END IF;
    FOR b IN 0..63 LOOP
        suffix := lpad(to_hex(b), 2, '0');
        EXECUTE format('CREATE TABLE attestations_h%s PARTITION OF attestations FOR VALUES WITH (MODULUS 64, REMAINDER %s)',
                       suffix, b);
        EXECUTE format('ALTER TABLE attestations_h%s', suffix) || opts;
    END LOOP;
END $$;


SELECT pg_extension_config_dump('attestations', '');
