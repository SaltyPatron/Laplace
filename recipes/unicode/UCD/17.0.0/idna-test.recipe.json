    {
      "syntaxPath": "record/@toAsciiNStatus",
      "propertyName": "toAsciiNStatus",
      "valueKind": "Text",
      "disposition": "Testimony",
      "relationName": "HAS_PARSE",
      "objectEntityType": "UTS46_Status",
      "objectParts": [
        {
          "path": "",
          "literal": "ToASCII"
        },
        {
          "path": "value()",
          "splitLast": "[], ",
          "side": "Each",
          "nested": true
        }
      ]
    },
    {
      "syntaxPath": "record/@toAsciiT",
      "propertyName": "toAsciiT",
      "valueKind": "Text",
      "disposition": "Testimony",
      "relationName": "NORMALIZES_TO",
