-- Band-masked attention centroid: where an entity's attention through a given
-- band lands on S³. This is the "general area" a concept occupies, as opposed
-- to its own coord, which is a function of its content (the composition of its
-- codepoints) and therefore says nothing about meaning — 'dog' and its
-- translations have unrelated coords by construction. The centroid over a
-- semantic band is where they converge.
--
-- Signature changed 2026-08-04: `concentration` added, so DROP before CREATE.
-- CREATE OR REPLACE cannot alter a return type.
-- FIX 1 (2026-08-04) — the band filter used to ask `laplace.entities` which band a
-- RELATION TYPE belongs to:
--
--     SELECT e.id FROM laplace.entities e
--     WHERE e.highway_mask IS NOT NULL
--       AND consensus.highway_mask_bits(e.highway_mask)
--           && consensus.highway_mask_bits(p_band_mask)
--
-- then joined that to consensus.type_id. A highway mask records which bands an
-- entity has EDGES IN; it is not a statement about which band a type BELONGS
-- TO. That is consensus.relation_highway_bit(type_id), from the manifest. Measured: the
-- CTE matched 0 rows for laplace.word_id('dog') against band 3 while dog carries 9
-- HAS_SENSE (bit 112) and 8 IS_SYNONYM_OF (bit 153), both band 3. Zero rows in,
-- NULL out, no error — on every call this function had ever served. It was also
-- a full scan of 4.34M laplace.entities with a set-returning function evaluated per row,
-- to build a set the manifest already determines and that has at most 233
-- members. GH #866.
--
-- FIX 2 (2026-08-04) — the mean is now projected back onto the sphere.
-- SUM(coord*w)/SUM(w) is the arithmetic mean of unit vectors, which is NOT a
-- unit vector: it lies strictly inside S³, and at the exact origin for an
-- antipodal pair. Measured immediately after FIX 1 landed, laplace.word_id('dog') band 3:
--
--     cx -0.00488  cy 0.03184  cz -0.22988  cm 0.15099   ||c|| = 0.27691
--
-- 0.277, not 1.0 — so every angular distance taken to that point was not an
-- angle, and laplace_forward_step was feeding it to a KNN over points that DO
-- lie on the sphere. The correct object is the Fréchet/Karcher mean under
-- geodesic distance; normalizing the weighted Euclidean sum is its standard
-- cheap approximation, exact for tightly clustered inputs and monotone
-- elsewhere.
--
-- The discarded norm is not noise — it is CONCENTRATION. 1.0 means every
-- attended point coincides; ~0 means they cancel, i.e. the entity attends in
-- every direction at once and its centroid carries no information. Returned
-- rather than thrown away, because "the centroid is meaningless here" is a
-- distinct answer from "the centroid is over there" and callers must be able to
-- tell them apart.
--
-- Degenerate case: norm = 0 (perfect cancellation, or a single antipodal pair)
-- has NO defined direction. Coordinates come back NULL with concentration 0 —
-- never a fabricated direction, and never a silent division by zero.
--
-- No SET search_path: it blocks inlining (pg_proc.proconfig, checked at
-- clauses.c:5168 for the set-returning path). Every reference is
-- schema-qualified instead. GH #860.
DROP FUNCTION IF EXISTS laplace.laplace_attention_centroid(bytea, bytea);
CREATE OR REPLACE FUNCTION generation.attention_centroid(
    p_entity   bytea,
    p_band_mask bytea)
RETURNS TABLE(cx float8, cy float8, cz float8, cm float8,
              total_weight float8, concentration float8)
LANGUAGE sql STABLE PARALLEL RESTRICTED
BEGIN ATOMIC
    WITH band_bits AS MATERIALIZED (
        SELECT consensus.highway_mask_bits(p_band_mask) AS bits
    ),
    attended AS (
        SELECT c.object_id,
               consensus.eff_mu(c.rating, c.rd)::float8 AS w
        FROM laplace.consensus c
        CROSS JOIN band_bits b
        WHERE c.subject_id = p_entity
          AND c.object_id IS NOT NULL
          AND consensus.relation_highway_bit(c.type_id) = ANY (b.bits)
          AND consensus.eff_mu(c.rating, c.rd) > 0
    ),
    weighted AS (
        SELECT w.coord, a.w
        FROM attended a
        JOIN laplace.v_word_points w ON w.id = a.object_id
        WHERE w.coord IS NOT NULL
    ),
    -- THIRD centroid path in this system, kept deliberately (GH #906 item 4).
    -- public.laplace_centroid_4d and the composer's math4d_centroid both exist and
    -- neither answers this: they take unweighted point sets, and this is a
    -- CONSENSUS-WEIGHTED mean -- each coordinate scaled by its edge's rated mass,
    -- normalized by total weight, then projected back onto the unit 3-sphere.
    -- Substituting either would silently drop the weighting, which IS the operation.
    --
    -- The parity that DOES hold, and the one a reader should check if this moves:
    -- with all weights equal this reduces exactly to math4d_centroid's arithmetic
    -- mean followed by its normalize step. Equal weights are the degenerate case, so
    -- any divergence there is a defect in one of the two, not a semantic difference.
    -- Unpinned by a test because no fixture yet builds an equal-weight attended set;
    -- that fixture is the missing gate, not a different centroid.
    summed AS (
        SELECT SUM(ST_X(coord) * w) / NULLIF(SUM(w), 0) AS mx,
               SUM(ST_Y(coord) * w) / NULLIF(SUM(w), 0) AS my,
               SUM(ST_Z(coord) * w) / NULLIF(SUM(w), 0) AS mz,
               SUM(ST_M(coord) * w) / NULLIF(SUM(w), 0) AS mm,
               SUM(w)                                   AS tw
        FROM weighted
    ),
    normed AS (
        SELECT s.*, sqrt(s.mx*s.mx + s.my*s.my + s.mz*s.mz + s.mm*s.mm) AS n
        FROM summed s
    )
    SELECT CASE WHEN n > 0 THEN mx / n END,
           CASE WHEN n > 0 THEN my / n END,
           CASE WHEN n > 0 THEN mz / n END,
           CASE WHEN n > 0 THEN mm / n END,
           tw,
           COALESCE(n, 0)
    FROM normed;
END;
