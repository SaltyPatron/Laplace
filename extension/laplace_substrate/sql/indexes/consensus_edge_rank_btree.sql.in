-- Global serving order for consensus.top_relations(): the manifest relation
-- rank times the conservative estimate (rating - 2*rd), so the ranked page is
-- an ordered index merge across leaves instead of a per-type probe of every
-- partition.
CREATE INDEX IF NOT EXISTS consensus_edge_rank_btree ON consensus (
    (consensus.relation_rank(type_id)
        * ((rating - 2 * rd)::double precision)) DESC,
    witness_count DESC,
    type_id,
    subject_id,
    object_id
) WHERE object_id IS NOT NULL
    AND consensus.relation_rank(type_id) IS NOT NULL;
