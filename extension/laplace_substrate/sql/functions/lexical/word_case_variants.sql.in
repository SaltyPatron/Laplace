-- Native, batched replacement for the word_case_variant_ids -> word_case_map_surface
-- (x3) -> grapheme_case_target SQL fan-out, which turned one lexical lookup into
-- O(3 * graphemes) non-inlinable consensus LIMIT-1 subqueries plus O(graphemes)
-- realize.render_text calls on the hot lexical_peers -> senses/define/bubble_up path.
-- Output-identical by delegation: case-map selection stays in one batched
-- DISTINCT ON ... ORDER BY consensus.eff_mu DESC over laplace.v_consensus_unrefuted, rendering
-- stays realize.render_text, minting stays laplace.word_id, the existence gate
-- stays consensus.entity_exists; the C only walks the grapheme trajectory once and
-- reproduces word_case_map_surface's string assembly. See src/lexical_case.c.
DROP FUNCTION IF EXISTS laplace.word_case_variants(bytea);
CREATE OR REPLACE FUNCTION lexical.word_case_variants(p_word bytea)
    RETURNS bytea[]
    AS 'MODULE_PATHNAME', 'pg_laplace_word_case_variants'
    LANGUAGE C STABLE;

-- True set form. The scalar function batches the graphemes of one word; this
-- batches trajectory unpack, case-map lookup, realization, word-id construction,
-- and existence testing across the complete input frontier.
DROP FUNCTION IF EXISTS laplace.word_case_variants_batch(bytea[]);
CREATE OR REPLACE FUNCTION lexical.word_case_variants_batch(p_words bytea[])
    RETURNS TABLE(word_id bytea, variant_id bytea)
    AS 'MODULE_PATHNAME', 'pg_laplace_word_case_variants_batch'
    LANGUAGE C STABLE STRICT PARALLEL SAFE;
