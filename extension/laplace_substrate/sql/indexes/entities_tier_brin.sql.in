-- Drops entities_tier_brin. Entities are HASH(id), so rows lie in hash order
-- and a BRIN on tier excludes no page range while charging every insert.
DO $do$
BEGIN
    IF EXISTS (SELECT FROM pg_depend d JOIN pg_extension e ON e.oid=d.refobjid
        WHERE d.classid='pg_class'::regclass AND d.objid=to_regclass('laplace.entities_tier_brin')
          AND d.refclassid='pg_extension'::regclass AND d.deptype='e'
          AND e.extname='laplace_substrate') THEN
        EXECUTE format('ALTER EXTENSION %I DROP INDEX laplace.entities_tier_brin',
                       'laplace_substrate');
    END IF;
    EXECUTE 'DROP INDEX IF EXISTS laplace.entities_tier_brin';
END $do$;
