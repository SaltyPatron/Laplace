-- Attestations with their five endpoint ids realized through label_or_hex,
-- the one id-display rule. Each row pays five realizations: read it only under
-- a selective predicate and LIMIT, never as the base of a fold, ingest, or
-- unbounded join.
CREATE OR REPLACE VIEW laplace.v_attestation_readable AS
SELECT a.id,
       a.subject_id,
       a.type_id,
       a.object_id,
       a.source_id,
       a.context_id,
       a.outcome,
       a.observation_count,
       a.sum_score_fp1e9,
       a.opponent_rd_fp1e9,
       a.last_observed_at,
       public.laplace_label_text((a.subject_id)::bytea, false) AS subject_label,
       (SELECT rl.label FROM consensus.relation_labels(ARRAY[a.type_id]) rl)    AS type_label,
       public.laplace_label_text((a.object_id)::bytea, false)  AS object_label,
       public.laplace_label_text((a.source_id)::bytea, false)  AS source_label,
       public.laplace_label_text((a.context_id)::bytea, false) AS context_label
FROM laplace.attestations a;
