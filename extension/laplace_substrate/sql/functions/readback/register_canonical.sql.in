DROP FUNCTION IF EXISTS laplace.register_canonical(text);
CREATE OR REPLACE FUNCTION realize.register_canonical(p_name text) RETURNS bytea
    LANGUAGE sql
BEGIN ATOMIC
    INSERT INTO laplace.canonical_names (id, name)
    VALUES (realize.canonical_id(p_name), p_name)
    ON CONFLICT (id) DO NOTHING;
    SELECT realize.canonical_id(p_name);
END;
