-- Per-file ingest ledger: one row per enumerated artifact per run, carrying the
-- file's content identity (file_id) where it has one, so a run's progress,
-- failure point, and the disposition of every file are readable. Resume reads
-- ingest_unit_completion; this ledger is the per-run record beside it.
--
-- Operational state, not substrate content: rows are never folded, never
-- walked, and not preserved across dump/restore.
--
-- Status vocabulary. The CHECK is a write gate: a status the writer emits and
-- this list omits raises 23514, the writer logs INGEST_FILE_JOURNAL_WRITE_FAILED
-- without aborting ingest, and the row stays 'running' like a killed file.
--   inventoried        admitted by the run snapshot; not opened yet
--   not-selected       inventoried with an explicit non-admitted disposition
--   running           opened, not yet finished
--   composed          extraction/composition complete; waiting for its boundary to apply
--   ok                applied to completion, marker deposited
--   skipped-complete  true-skipped before opening: marker already present
--   failed            raised; error carries the message
--   cancelled         no terminal write arrived (process killed, cluster bounced)
CREATE TABLE IF NOT EXISTS ingest_file_journal (
    run_id        uuid         NOT NULL,
    file_label    text         NOT NULL,
    source_name   text         NOT NULL,
    file_id       bytea        CHECK (file_id IS NULL OR octet_length(file_id) = 16),
    resume_fingerprint bytea    CHECK (resume_fingerprint IS NULL OR octet_length(resume_fingerprint) = 16),
    status        text         NOT NULL DEFAULT 'running'
        CHECK (status IN ('inventoried','not-selected','running','composed','ok',
                          'skipped-complete','failed','cancelled')),
    started_at    timestamptz  NOT NULL DEFAULT now(),
    ended_at      timestamptz,
    bytes         bigint       NOT NULL DEFAULT 0,
    records       bigint       NOT NULL DEFAULT 0,
    entities      bigint       NOT NULL DEFAULT 0,
    physicalities bigint       NOT NULL DEFAULT 0,
    attestations  bigint       NOT NULL DEFAULT 0,
    error         text,
    modified_at   timestamptz,
    artifact_id   text,
    relative_path text,
    disposition   text         NOT NULL DEFAULT 'admitted'
        CHECK (disposition IN ('admitted','equivalent-packaging','superseded',
                               'excluded-with-reason','unsupported-with-why-not','absent')),
    disposition_reason text,
    PRIMARY KEY (run_id, file_label)
);

-- Observed filesystem time is occurrence metadata, never file identity; NULL
-- when the input supplied no mtime.
ALTER TABLE ingest_file_journal
    ADD COLUMN IF NOT EXISTS modified_at timestamptz;
ALTER TABLE ingest_file_journal
    ADD COLUMN IF NOT EXISTS resume_fingerprint bytea
        CHECK (resume_fingerprint IS NULL OR octet_length(resume_fingerprint) = 16);
ALTER TABLE ingest_file_journal
    ADD COLUMN IF NOT EXISTS artifact_id text;
ALTER TABLE ingest_file_journal
    ADD COLUMN IF NOT EXISTS relative_path text;
ALTER TABLE ingest_file_journal
    ADD COLUMN IF NOT EXISTS disposition text NOT NULL DEFAULT 'admitted';
ALTER TABLE ingest_file_journal
    ADD COLUMN IF NOT EXISTS disposition_reason text;

-- Per run: which files finished, and which one was open when it stopped.
CREATE INDEX IF NOT EXISTS ingest_file_journal_run_status
    ON ingest_file_journal (run_id, status);

-- Across runs: one file of a source, newest run first.
CREATE INDEX IF NOT EXISTS ingest_file_journal_source_label
    ON ingest_file_journal (source_name, file_label, started_at DESC);

-- CREATE TABLE is IF NOT EXISTS, so the CHECK vocabularies are re-asserted on
-- every install; otherwise an installed table enforces the list it was created with.
DO $$
BEGIN
    ALTER TABLE ingest_file_journal DROP CONSTRAINT IF EXISTS ingest_file_journal_status_check;
    ALTER TABLE ingest_file_journal ADD CONSTRAINT ingest_file_journal_status_check
        CHECK (status IN ('inventoried','not-selected','running','composed','ok',
                          'skipped-complete','failed','cancelled'));
    ALTER TABLE ingest_file_journal DROP CONSTRAINT IF EXISTS ingest_file_journal_disposition_check;
    ALTER TABLE ingest_file_journal ADD CONSTRAINT ingest_file_journal_disposition_check
        CHECK (disposition IN ('admitted','equivalent-packaging','superseded',
                               'excluded-with-reason','unsupported-with-why-not','absent'));
END $$;
