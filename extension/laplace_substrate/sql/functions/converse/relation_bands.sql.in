-- The salience bands: the lens vocabulary.
--
-- A band is a set of relation types sharing a read-time rank, addressed by one
-- precomputed highway mask. Selecting bands is how a caller narrows a read
-- without naming a single relation and without naming a language.
--
-- relation_band_catalog() is immutable naming. relation_bands() reads band membership
-- from the relation registry and estimates each band's consensus rows from the hash
-- leaves' planner statistics, so an interactive catalog request never aggregates the
-- partitioned consensus tree. ops.relation_band_census() is the exact, explicit count.
DROP FUNCTION IF EXISTS laplace.relation_band_catalog();
CREATE OR REPLACE FUNCTION converse.relation_band_catalog()
    RETURNS TABLE(band integer, name text, rank double precision)
    LANGUAGE sql IMMUTABLE PARALLEL SAFE
BEGIN ATOMIC
    VALUES
      (0,  'mandate',              1.00::double precision),
      (1,  'definitional',         0.97),
      (2,  'taxonomic',            0.90),
      (3,  'equivalence',          0.82),
      (4,  'partitive',            0.73),
      (5,  'causal',               0.64),
      (6,  'oppositional',         0.45),
      (7,  'associative',          0.36),
      (8,  'tensor_calculation',   0.27),
      (9,  'lexical_glue',         0.18),
      (10, 'scalar_valued',        0.12),
      (11, 'standards_structural', 0.08),
      (12, 'probationary',         0.05);
END;

DROP FUNCTION IF EXISTS laplace.relation_bands();
CREATE OR REPLACE FUNCTION converse.relation_bands()
    RETURNS TABLE(band integer, name text, rank double precision,
                  relation_types bigint, consensus_rows bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH members AS MATERIALIZED (
        SELECT r.band::integer AS band, r.type_id
        FROM laplace.relation_registry() r
    ), estimated AS MATERIALIZED (
        -- Most-common-value frequency x leaf row estimate, summed over the hash
        -- leaves. A relation outside a leaf's MCV list contributes nothing, so this
        -- is a statistics estimate, not a census.
        SELECT u.type_id, sum(u.freq * c.reltuples)::bigint AS rows
        FROM pg_catalog.pg_stats s
        JOIN pg_catalog.pg_class c
          ON c.relname = s.tablename
         AND c.relnamespace = 'laplace'::regnamespace
        CROSS JOIN LATERAL unnest(s.most_common_vals::text::bytea[], s.most_common_freqs)
            AS u(type_id, freq)
        WHERE s.schemaname = 'laplace'
          AND s.tablename LIKE 'consensus\_h%'
          AND s.attname = 'type_id'
          AND c.reltuples > 0
        GROUP BY u.type_id
    )
    SELECT b.band,
           b.name,
           b.rank,
           count(m.type_id)::bigint,
           COALESCE(sum(e.rows), 0)::bigint
    FROM converse.relation_band_catalog() AS b
    LEFT JOIN members m ON m.band = b.band
    LEFT JOIN estimated e ON e.type_id = m.type_id
    GROUP BY b.band, b.name, b.rank
    ORDER BY b.band;
END;

-- Exact per-band consensus rows. Aggregates every consensus leaf; an explicit
-- operator census, never an interactive read.
CREATE OR REPLACE FUNCTION ops.relation_band_census()
    RETURNS TABLE(band integer, name text, relation_types bigint, consensus_rows bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH members AS MATERIALIZED (
        SELECT r.band::integer AS band, r.type_id
        FROM laplace.relation_registry() r
    ), counted AS MATERIALIZED (
        SELECT c.type_id, count(*)::bigint AS rows
        FROM laplace.consensus c
        WHERE c.type_id IN (SELECT m.type_id FROM members m)
        GROUP BY c.type_id
    )
    SELECT b.band, b.name, count(m.type_id)::bigint, COALESCE(sum(k.rows), 0)::bigint
    FROM converse.relation_band_catalog() AS b
    LEFT JOIN members m ON m.band = b.band
    LEFT JOIN counted k ON k.type_id = m.type_id
    GROUP BY b.band, b.name
    ORDER BY b.band;
END;
