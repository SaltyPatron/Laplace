CREATE OR REPLACE FUNCTION salient_facts(p_word bytea, p_lang bytea DEFAULT NULL,
                                    p_limit int DEFAULT 24)
    RETURNS TABLE(type text, fact text, eff_mu numeric, witnesses bigint)
-- No SET search_path — blocks inlining, costs the consensus index path. The
-- workaround below (fencing relation_in_family ONCE because its own SET clause
-- makes it uninlinable) is the same defect one level down. GH #860.
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    WITH reltypes AS MATERIALIZED (
        SELECT id FROM @extschema@.entities
        WHERE type_id = @extschema@.entity_type_id('RelationType')
    ), feat_dynamic AS MATERIALIZED (
        -- Dynamic HAS_FEATURE children (FEAT_case, FEAT_number, ...) carry an
        -- IS_A -> family-root edge in consensus (RelationTypeRegistry.SeedDynamic).
        -- Fenced ONCE here: the SQL wrapper relation_in_family() carries a SET
        -- search_path clause, so the planner can never inline it and its EXISTS
        -- probe would run per candidate row. (relation_type_in_family below is the
        -- C IMMUTABLE static check — cheap per row, unaffected.) Same truth table:
        -- static family via the C check, dynamic membership via this set.
        SELECT c.subject_id AS id FROM @extschema@.consensus c
        WHERE c.type_id = @extschema@.relation_type_id('IS_A')
          AND c.object_id = @extschema@.relation_type_id('HAS_FEATURE')
    ), lang AS (
        -- Resolved ONCE, not per candidate row. When p_lang is supplied COALESCE
        -- short-circuits and word_language() is never evaluated.
        SELECT COALESCE(p_lang, @extschema@.word_language(p_word)) AS l
    ), subj(id) AS (
        SELECT p_word UNION SELECT sn.synset_id FROM @extschema@.senses(p_word) sn
    ), top AS (
        SELECT cc.type_id, cc.object_id, cc.rating, cc.rd, cc.witness_count
        FROM subj s CROSS JOIN LATERAL (
            SELECT c.type_id, c.object_id, c.rating, c.rd, c.witness_count
            FROM @extschema@.v_consensus_unrefuted c
            LEFT JOIN reltypes obj_rt ON obj_rt.id = c.object_id
            WHERE c.subject_id = s.id AND c.object_id IS NOT NULL
              AND c.type_id IN (SELECT id FROM reltypes)
              AND NOT @extschema@.relation_type_in_family(c.type_id, 'HAS_POS')
              AND NOT @extschema@.relation_type_in_family(c.type_id, 'HAS_FEATURE')
              AND c.type_id NOT IN (SELECT id FROM feat_dynamic)
              AND c.type_id NOT IN (
                @extschema@.relation_type_id('HAS_SENSE'), @extschema@.relation_type_id('IS_SENSE_OF'),
                @extschema@.relation_type_id('HAS_LANGUAGE'), @extschema@.relation_type_id('PRECEDES'),
                @extschema@.relation_type_id('FOLLOWS'), @extschema@.relation_type_id('CO_OCCURS_WITH'),
                @extschema@.relation_type_id('OCCURS_IN_CONTEXT'), @extschema@.relation_type_id('HAS_LEX_CATEGORY'),
                @extschema@.relation_type_id('HAS_VERB_FRAME'),
                @extschema@.relation_type_id('IS_LEMMA_OF'), @extschema@.relation_type_id('IS_TRANSLATION_OF'),
                @extschema@.relation_type_id('HAS_EXAMPLE'), @extschema@.relation_type_id('EVOKES_FRAME'),
                @extschema@.relation_type_id('HAS_SYNSET_KEY'), @extschema@.relation_type_id('IS_TYPED_AS'),
                @extschema@.relation_type_id('HAS_NAME_ALIAS'))
              AND obj_rt.id IS NULL
            ORDER BY @extschema@.eff_mu(c.rating, c.rd) DESC LIMIT p_limit * 3
        ) cc
    ), ranked AS (
        -- Rank BEFORE labeling (mirrors evidence_receipt's Issue 52). The old
        -- shape ran realize() + type_label over EVERY row of `top` (dog: 413
        -- rows across 10 subjects) only to ORDER/LIMIT to p_limit afterwards --
        -- ~1.5ms/render x 413 dominated the call (~575ms warm on real data).
        -- Ranking needs only the eff_mu already in `top`, so it runs first over
        -- everything; labeling then runs over a small over-fetched pool
        -- (3x + 8 keeps top-N starvation implausible after the empty/ellipsis
        -- filters below drop rows). Same eff_mu order, same result set.
        SELECT t.type_id, t.object_id, t.rating, t.rd, t.witness_count,
               @extschema@.eff_mu(t.rating, t.rd) AS sort_mu
        FROM top t
        ORDER BY @extschema@.eff_mu(t.rating, t.rd) DESC
        LIMIT p_limit * 3 + 8
    )
    , ordered AS (
        SELECT r.*, row_number() OVER (ORDER BY r.sort_mu DESC) AS ord
        FROM ranked r
    ), labels AS (
        -- ONE realize_batch over the ranked pool (was: scalar realize per row).
        SELECT @extschema@.realize_batch(array_agg(o.object_id ORDER BY o.ord),
                             (SELECT l FROM lang)) AS l
        FROM ordered o
    )
    SELECT d.type, d.fact, d.eff_mu, d.witnesses FROM (
        SELECT @extschema@.type_label(o.type_id) AS type,
               labels.l[o.ord] AS fact,
               @extschema@.eff_mu_display(o.rating, o.rd) AS eff_mu, o.witness_count AS witnesses,
               o.sort_mu
        FROM ordered o, labels
    ) d
    WHERE d.fact IS NOT NULL AND d.fact <> ''
      AND right(d.fact, 1) <> U&'\2026' AND right(d.type, 1) <> U&'\2026'
    ORDER BY d.sort_mu DESC
    LIMIT p_limit
$$;
