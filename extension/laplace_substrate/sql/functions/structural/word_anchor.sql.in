-- Resolve one content id to its type=1 coord + trajectory. This is the seam
-- Rule #4 keeps catching: a correlated CTE reference to me.coord is NOT a
-- bound parameter for GiST KNN. Fetch through this function into locals (or a
-- MATERIALIZED CTE), then ORDER BY coord <<->> :anchor so the planner sees a
-- genuine parameter. LIMIT 1 matches every prior hand-rolled form.
--
-- PERFORMANCE: execution sub-millisecond on a known id (see laplace.v_word_points
-- contract). Requires trajectory IS NOT NULL — callers that only need coord
-- should `SELECT ... FROM laplace.v_word_points WHERE id = $1 AND coord IS NOT NULL
-- LIMIT 1` instead.
-- No SET search_path / no STRICT: both block SQL inlining (Rule #2 / #617).
DROP FUNCTION IF EXISTS laplace.word_anchor(bytea);
CREATE OR REPLACE FUNCTION structural.word_anchor(p_id bytea)
    RETURNS TABLE(
        id          bytea,
        type_id     bytea,
        tier        smallint,
        coord       geometry,
        trajectory  geometry,
        hilbert_index bytea)
    LANGUAGE sql STABLE PARALLEL SAFE
    -- STRUCTURAL bound, not an estimate: the body ends in LIMIT 1, so this
    -- returns at most one row. Undeclared, Postgres assumes 1000 -- a 1000x
    -- overestimate on the inner side of any join, which is what makes scanning
    -- look cheaper than probing.
    ROWS 1
BEGIN ATOMIC
    SELECT w.id, w.type_id, w.tier, w.coord, w.trajectory, w.hilbert_index
    FROM laplace.v_word_points w
    WHERE w.id = p_id
      AND w.trajectory IS NOT NULL
    LIMIT 1;
END;
