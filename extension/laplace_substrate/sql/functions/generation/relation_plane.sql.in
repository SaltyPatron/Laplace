-- 2026-07-09 vocab pushdown: the foundry read every consensus row of a type
-- over the wire so the client could keep the ~1% whose endpoints are in the
-- synthesis vocab (12 relation heads = 27.5M rows scanned, 358K kept, 550s of a
-- 608s synthesis). p_vocab probes consensus_type_subject_btree instead; the type
-- id is resolved into a local FIRST (a variable is a bound parameter and
-- therefore an index condition — Rule #4; a function call in the qual is
-- not, lesson L12).
DROP FUNCTION IF EXISTS laplace.relation_plane(text, text, int, bytea[]);
CREATE OR REPLACE FUNCTION generation.relation_plane(p_family text, p_name text, p_arg int DEFAULT NULL,
        p_vocab bytea[] DEFAULT NULL)
    RETURNS TABLE(subject_id bytea, object_id bytea, w double precision)
    LANGUAGE plpgsql VOLATILE AS $$
DECLARE
    g int;
    v_type bytea;
BEGIN
    IF p_family = 'consensus' THEN
        v_type := laplace.relation_type_id(p_name);
        IF p_vocab IS NULL THEN
            RETURN QUERY
            SELECT c.subject_id, c.object_id,
                   consensus.walk_edge_weight(c.rating, c.rd)
            FROM laplace.consensus c
            WHERE c.type_id = v_type AND c.object_id IS NOT NULL;
        ELSE
            RETURN QUERY
            WITH v(id) AS (SELECT DISTINCT u FROM unnest(p_vocab) AS u)
            SELECT c.subject_id, c.object_id,
                   consensus.walk_edge_weight(c.rating, c.rd)
            FROM v
            JOIN laplace.consensus c ON c.type_id = v_type AND c.subject_id = v.id
            JOIN v vo ON vo.id = c.object_id
            WHERE c.object_id IS NOT NULL;
        END IF;
        RETURN;
    END IF;

    IF p_family <> 'traj' THEN
        RAISE EXCEPTION 'relation_plane: unknown family % (consensus | traj)', p_family;
    END IF;

    g := CASE p_name
             WHEN 'next'   THEN 1
             WHEN 'gap'    THEN COALESCE(p_arg, 1)
             WHEN 'window' THEN COALESCE(p_arg, 4)
             ELSE NULL
         END;
    IF g IS NULL THEN
        RAISE EXCEPTION 'relation_plane: unknown traj plane % (next | gap | window)', p_name;
    END IF;

    -- One manifest read and one Native run-pair kernel serve exact gaps and
    -- windows. Aggregate exact multiplicities before normalization; objects
    -- outside the requested vocabulary remain in each subject's denominator.
    RETURN QUERY
    WITH counts AS MATERIALIZED (
        SELECT c.subject_id, c.object_id, sum(c.occurrences) AS n
        FROM generation.trajectory_pair_counts(p_vocab,
            CASE WHEN p_name = 'window' THEN 1 ELSE g END, g) c
        GROUP BY c.subject_id, c.object_id
    ), totals AS (
        SELECT c.*, sum(c.n) OVER (PARTITION BY c.subject_id) AS total
        FROM counts c
    )
    SELECT t.subject_id, t.object_id, (t.n / t.total)::double precision
    FROM totals t WHERE p_vocab IS NULL OR t.object_id = ANY(p_vocab);
END;
$$;
