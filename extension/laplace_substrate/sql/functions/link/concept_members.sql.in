DROP FUNCTION IF EXISTS laplace.concept_members(bytea);
CREATE OR REPLACE FUNCTION lexical.concept_members(p_concept bytea)
    RETURNS TABLE(member bytea, kind text, mu numeric, witnesses bigint)
    LANGUAGE sql STABLE STRICT PARALLEL SAFE
BEGIN ATOMIC
    WITH carriers AS MATERIALIZED (
        SELECT h.entity, public.laplace_parts(h.path) AS parts
        FROM public.physicality h
        WHERE h.path OPERATOR(public.@^) public.blake3_from_bytea(p_concept)
          AND h.mask OPERATOR(public.?&) ARRAY[public.laplace_bank_bit('kind', 'tuple')]
          AND public.laplace_path_length(h.path) = 3
    ),
    cells AS MATERIALIZED (
        SELECT c.entity, public.laplace_parts(c.path) AS parts, c.rating, c.deviation, c.matches
        FROM public.laplace_claims_each(ARRAY(SELECT DISTINCT entity FROM carriers), NULL::bigint,
            ARRAY[public.laplace_bank_bit('kind', 'claim')], '{}'::public.blake3[],
            3::smallint, NULL::public.blake3[], 3::bigint) c
    )
    -- Every entity linked to an anchor (a synset/ILI concept or a FrameNet
    -- frame), pivoting only on ids. Three content-addressed bridge kinds:
    --   synonym : member --IS_SYNONYM_OF--> synset
    --   sense   : member --HAS_SENSE--> concept (the member's binding to the key)
    --   frame   : member --EVOKES_FRAME--> frame
    -- Because the pivot is the anchor id, membership crosses language and
    -- surface for free (an English and a French lemma on the same ILI-seeded
    -- synset are both members). Pure id logic -- no realize.render_text/label here; the
    -- caller renders survivors at the display boundary.
    SELECT c.subject_id, 'synonym'::text, consensus.eff_mu_display(c.rating, c.rd), c.witness_count
    FROM laplace.v_consensus_unrefuted c
    WHERE c.object_id = p_concept AND c.type_id = laplace.relation_type_id('IS_SYNONYM_OF')
    UNION ALL
    SELECT hs.subject_id, 'sense'::text, consensus.eff_mu_display(hs.rating, hs.rd), hs.witness_count
    FROM laplace.v_consensus_unrefuted hs
    WHERE hs.object_id = p_concept AND hs.type_id = ANY (consensus.relation_set_ids('KEY_BINDING'))
    UNION ALL
    SELECT hs.subject_id, 'sense'::text,
           LEAST(consensus.eff_mu_display(hs.rating, hs.rd), consensus.eff_mu_display(ss.rating, ss.rd)),
           hs.witness_count + ss.witness_count
    FROM laplace.v_consensus_unrefuted ss
    JOIN laplace.v_consensus_unrefuted hs
      ON hs.object_id = ss.subject_id AND hs.type_id = ANY (consensus.relation_set_ids('KEY_BINDING'))
    WHERE ss.object_id = p_concept AND ss.type_id = laplace.relation_type_id('IS_SENSE_OF')
    UNION ALL
    -- A source-owned lexical member (for example VerbNet_Member) carries
    -- EVOKES_FRAME at its natural grain and exposes its surface through
    -- HAS_NAME. Preserve the public surface-member contract without
    -- requiring a duplicate surface->frame testimony edge.
    SELECT COALESCE(n.object_id, c.subject_id), 'frame'::text,
           consensus.eff_mu_display(c.rating, c.rd), c.witness_count
    FROM laplace.v_consensus_unrefuted c
    LEFT JOIN laplace.v_consensus_unrefuted n
     ON n.subject_id = c.subject_id
     AND n.type_id = ANY (consensus.relation_set_ids('NAME_EDGE'))
    WHERE c.object_id = p_concept AND c.type_id = laplace.relation_type_id('EVOKES_FRAME')
    UNION ALL
    -- Native 3-part lexicalizations [word, lang, synset] and 2-part incoming edges
    SELECT public.blake3_send(cr.parts[1]), 'sense'::text,
           COALESCE(consensus.eff_mu_display(round(cl.rating * 1e9)::bigint, round(cl.deviation * 1e9)::bigint), 1087.071::numeric),
           GREATEST(COALESCE(cl.matches, 1), 1)::bigint
    FROM carriers cr
    LEFT JOIN cells cl
      ON ((cl.parts[3] = cr.entity AND cl.parts[1] IN (cr.parts[1], cr.parts[3]))
          OR (cl.parts[1] = cr.entity AND cl.parts[3] IN (cr.parts[1], cr.parts[3])))
     AND (cl.rating - 2 * cl.deviation) > 0
    UNION ALL
    SELECT e.neighbour_id, 'sense'::text,
           consensus.eff_mu_display(e.rating, e.rd),
           e.witness_count
    FROM consensus.edges_raw(p_concept, 'in', NULL, 128, true, 'eff_mu') e
    WHERE e.neighbour_id IS NOT NULL
      AND consensus.relation_canonical(e.type_id) IN ('IS_SYNONYM_OF', 'HAS_SENSE', 'IS_SENSE_OF')
      AND NOT EXISTS (
          SELECT 1 FROM laplace.v_consensus_unrefuted c2
          WHERE c2.subject_id = e.neighbour_id AND c2.object_id = p_concept
      )
;
END;
