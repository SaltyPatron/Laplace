-- BEGIN ATOMIC: GH #764.
-- Planner-statistics form of entity_type_counts (MCV x reltuples).
DROP FUNCTION IF EXISTS laplace.entity_type_counts_approx();

CREATE OR REPLACE FUNCTION ops.entity_type_counts_approx()
    RETURNS TABLE(type text, type_id bytea, entities_approx bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    WITH st AS (
        SELECT s.most_common_vals::text::bytea[] AS vals,
               s.most_common_freqs               AS freqs
        FROM pg_stats s
        WHERE s.schemaname = 'laplace'
          AND s.tablename  = 'entities'
          AND s.attname    = 'type_id'
    ), rt AS (
        SELECT c.reltuples
        FROM pg_class c
        JOIN pg_namespace n ON n.oid = c.relnamespace
        WHERE n.nspname = 'laplace' AND c.relname = 'entities'
    )
    SELECT realize.render(m.tid)                        AS type,
           m.tid                                AS type_id,
           (m.freq * rt.reltuples)::bigint      AS entities_approx
    FROM st, rt, LATERAL unnest(st.vals, st.freqs) AS m(tid, freq)
    ORDER BY entities_approx DESC;
END;
