DROP FUNCTION IF EXISTS laplace.consensus_peer(bytea, int);
CREATE OR REPLACE FUNCTION generation.consensus_peer(p_id bytea, p_k int DEFAULT 6)
    RETURNS bytea
    LANGUAGE sql STABLE PARALLEL RESTRICTED
BEGIN ATOMIC
    WITH rel_winner AS MATERIALIZED (
        SELECT z.id
        FROM (
            SELECT x.id, sum(arms.contrib) AS score
            FROM (
                SELECT c2.subject_id AS peer,
                       LEAST(m.mu, consensus.eff_mu(c2.rating, c2.rd)) AS contrib
                FROM (
                    SELECT c.type_id AS rel, c.object_id AS partner,
                           consensus.eff_mu(c.rating, c.rd) AS mu
                    FROM laplace.v_consensus_unrefuted c
                    WHERE c.subject_id = p_id
                      AND c.object_id IS NOT NULL
                ) m
                JOIN laplace.v_consensus_unrefuted c2
                  ON c2.type_id = m.rel
                 AND c2.object_id = m.partner
                 AND c2.subject_id <> p_id
                UNION ALL
                SELECT c2.object_id AS peer,
                       LEAST(m.mu, consensus.eff_mu(c2.rating, c2.rd))
                FROM (
                    SELECT c.type_id AS rel, c.subject_id AS partner,
                           consensus.eff_mu(c.rating, c.rd) AS mu
                    FROM laplace.v_consensus_unrefuted c
                    WHERE c.object_id = p_id
                      AND c.subject_id IS DISTINCT FROM p_id
                ) m
                JOIN laplace.v_consensus_unrefuted c2
                  ON c2.type_id = m.rel
                 AND c2.subject_id = m.partner
                 AND c2.object_id <> p_id
            ) arms
            JOIN laplace.entities x ON x.id = arms.peer
            WHERE EXISTS (
                SELECT 1 FROM laplace.entities own
                JOIN laplace.entities peer ON peer.type_id = own.type_id
                WHERE own.id = p_id AND peer.id = x.id)
            GROUP BY x.id
            ORDER BY score DESC
            LIMIT GREATEST(p_k, 0)
        ) z
        ORDER BY public.laplace_hash128_blake3(z.id || p_id)
        LIMIT 1
    ),
    anchor AS MATERIALIZED (
        SELECT a.coord AS v_coord, structural.entity_curve(p_id) AS v_curve
        FROM structural.word_anchor(p_id) a
        WHERE NOT EXISTS (SELECT 1 FROM rel_winner rw WHERE rw.id IS NOT NULL)
    ),
    geo_winner AS (
        SELECT z.id
        FROM (
            SELECT knn.id
            FROM anchor an
            CROSS JOIN LATERAL (
                SELECT w.id, structural.entity_curve(w.id) AS curve
                FROM laplace.v_word_points w
                WHERE w.id <> p_id AND w.trajectory IS NOT NULL
                  AND EXISTS (
                      SELECT 1 FROM laplace.entities own
                      JOIN laplace.entities peer ON peer.type_id = own.type_id
                      WHERE own.id = p_id AND peer.id = w.id)
                ORDER BY w.coord <<->> an.v_coord
                LIMIT GREATEST(p_k, 0)
            ) knn
            WHERE an.v_coord IS NOT NULL AND an.v_curve IS NOT NULL AND knn.curve IS NOT NULL
            ORDER BY public.laplace_frechet_4d(knn.curve, an.v_curve) ASC
            LIMIT GREATEST(p_k, 0)
        ) z
        ORDER BY public.laplace_hash128_blake3(z.id || p_id)
        LIMIT 1
    )
    SELECT COALESCE(
        (SELECT rw.id FROM rel_winner rw LIMIT 1),
        (SELECT gw.id FROM geo_winner gw LIMIT 1)
    );
END;
