-- FORWARD DECLARATION ONLY (GH #532). Not an implementation.
--
-- Held a complete second body for the context overload of define(). Like its
-- siblings it differed from the final in its second arm (consensus read directly
-- for p_word, against the final's peer expansion) and won or lost on nothing but
-- manifest ordering.
--
-- The signature must match the final definition EXACTLY (name, argument types,
-- defaults, return type) or the real CREATE OR REPLACE fails instead of replacing
-- this.
CREATE OR REPLACE FUNCTION define(p_word bytea, p_context bytea[], p_limit int DEFAULT 5)
    RETURNS TABLE(definition text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    SELECT NULL::text, NULL::numeric, NULL::bigint WHERE false
$$;
