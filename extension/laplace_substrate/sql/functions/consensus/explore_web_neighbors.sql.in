-- Undirected consensus probe for the explore_web SPI beam. Thin wrapper over
-- consensus.edges_raw(); pins both directions, every type, eff_mu order and
-- refuted edges INCLUDED — the axes this lane has always used. outbound is the
-- direction the core already returns.
DROP FUNCTION IF EXISTS laplace.explore_web_neighbors(bytea, int);
CREATE OR REPLACE FUNCTION consensus.explore_web_neighbors(
    p_subject bytea,
    p_limit   int)
    RETURNS TABLE(
        nbr bytea,
        type_id bytea,
        rating bigint,
        rd bigint,
        witness_count bigint,
        outbound boolean)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    SELECT e.neighbour_id, e.type_id, e.rating, e.rd, e.witness_count,
           (e.direction = 'out')
    FROM consensus.edges_raw(p_subject, 'both', NULL, GREATEST(1, p_limit), true, 'eff_mu') e
$$;
