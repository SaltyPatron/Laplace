SQL_QUERY("maintenance.physicalities_constituents_gin", "", "CREATE INDEX IF NOT EXISTS physicalities_constituents_gin ON laplace.physicalities USING gin (public.laplace_trajectory_constituent_ids(trajectory)) WHERE type = 1 AND trajectory IS NOT NULL")

SQL_QUERY("maintenance.physicalities_traj_first_id_btree", "", "CREATE INDEX IF NOT EXISTS physicalities_traj_first_id_btree ON laplace.physicalities USING btree (((public.laplace_trajectory_constituent_ids(trajectory))[1])) WHERE trajectory IS NOT NULL AND type = 1")

SQL_QUERY("maintenance.physicalities_traj_probe", "", "CREATE INDEX IF NOT EXISTS physicalities_traj_probe ON laplace.physicalities USING btree (observed_at) WHERE type = 1 AND trajectory IS NOT NULL")

SQL_QUERY("maintenance.physicalities_observed_brin", "", "CREATE INDEX IF NOT EXISTS physicalities_observed_brin ON laplace.physicalities USING brin (observed_at)")

SQL_QUERY("maintenance.physicalities_hilbert_btree", "", "CREATE INDEX IF NOT EXISTS physicalities_hilbert_btree ON laplace.physicalities USING btree (hilbert_index)")

SQL_QUERY("maintenance.physicalities_direction_gist", "", "CREATE INDEX IF NOT EXISTS physicalities_direction_gist ON laplace.physicalities USING gist (public.laplace_direction_4d(coord) public.gist_geometry_ops_nd) WHERE type = 1 AND public.laplace_direction_4d(coord) IS NOT NULL")

SQL_QUERY("maintenance.physicalities_coord_gist", "", "CREATE INDEX IF NOT EXISTS physicalities_coord_gist ON laplace.physicalities USING gist (coord public.gist_geometry_ops_nd)")

SQL_QUERY("maintenance.physicalities_type_btree", "", "CREATE INDEX IF NOT EXISTS physicalities_type_btree ON laplace.physicalities USING btree (type)")

SQL_QUERY("maintenance.physicalities_entity_btree", "", "CREATE INDEX IF NOT EXISTS physicalities_entity_btree ON laplace.physicalities USING btree (entity_id)")
SQL_QUERY("migration.app_tables_present", "",
    "SELECT bool_and(to_regclass(name) IS NOT NULL) "
    "FROM unnest(ARRAY['app.users','app.external_identities','app.platform_roles',"
    "'app.api_keys','app.billing_quotes','app.billing_royalties']) AS required(name)")
/* Run transactionally with the declaration (db/schema), on every apply.
 * Native SPI binds installed objects independently of the caller's namespace.
 * Cache paths are server-side installed paths, not paths from the invoking client.
 * Native owns function bindings: direct ROM/index primitives, parsed SQL adapters,
 * and catalog-bound SQL/SPI entry points. Consumers restore that contract, not their own
 * per-function settings or exception lists. */
SQL_QUERY("migration.canonical_substrate", "",
    "CREATE EXTENSION IF NOT EXISTS laplace WITH SCHEMA public; "
    "ALTER EXTENSION laplace UPDATE; "
    "DO $canonical$ DECLARE cache record; cache_path text; BEGIN "
    "IF NOT EXISTS (SELECT FROM pg_extension e JOIN pg_namespace n ON n.oid=e.extnamespace "
    "WHERE e.extname='laplace' AND n.nspname='public') THEN "
    "RAISE EXCEPTION 'The canonical laplace extension must own the public substrate'; END IF; "
    "IF NOT EXISTS (SELECT FROM pg_type t JOIN pg_depend d ON d.objid=t.oid AND d.classid='pg_type'::regclass "
    "JOIN pg_extension e ON e.oid=d.refobjid AND d.refclassid='pg_extension'::regclass "
    "WHERE t.oid=to_regtype('public.blake3') AND t.typlen=16 AND e.extname='laplace' AND d.deptype='e') "
    "OR to_regtype('public.blake3[]') IS NULL THEN "
    "RAISE EXCEPTION 'Canonical fixed-width blake3 identity type is not installed'; END IF; "
    "PERFORM public.laplace_restore_function_bindings(); "
    "FOR cache IN SELECT * FROM (VALUES ('laplace.tier0','laplace_substrate.perfcache_path'), "
    "('laplace.highway','laplace_substrate.highway_perfcache_path')) AS paths(native_setting,installed_setting) LOOP "
    "cache_path := NULLIF(current_setting(cache.installed_setting,true),''); "
    "IF cache_path IS NOT NULL THEN "
    "PERFORM set_config(cache.native_setting,cache_path,true); "
    "EXECUTE format('ALTER DATABASE %I SET %s = %L',current_database(),cache.native_setting,cache_path); "
    "END IF; END LOOP; "
    "PERFORM public.laplace_fingerprint(); PERFORM public.laplace_highway_fingerprint(); "
    "PERFORM public.laplace_ensure_stage(); "
    "END $canonical$;")
SQL_QUERY("migration.canonical_substrate_status", "",
    "SELECT current_database(),extversion,public.laplace_fingerprint(),public.laplace_highway_fingerprint() "
    "FROM pg_extension WHERE extname='laplace'")
/* The declaration (db/schema) is applied on every create and every deploy; there is no journal.
 * Status applies it inside a transaction it rolls back and reports the catalog difference, so
 * "drift" is exactly what an apply would change. Rows are (key, value) pairs: objects, their
 * ACLs and definitions, default ACLs, role memberships and database settings. */
SQL_QUERY("migration.declared_snapshot", "",
    "WITH ns AS (SELECT oid,nspname FROM pg_namespace WHERE nspname !~ '^pg_' AND nspname<>'information_schema')\n"
    "SELECT key,value FROM (\n"
    "SELECT 'extension '||extname AS key,extversion AS value FROM pg_extension\n"
    "UNION ALL SELECT 'schema '||nspname,pg_get_userbyid(nspowner)||' '||coalesce(nspacl::text,'') FROM pg_namespace\n"
    "  WHERE nspname !~ '^pg_' AND nspname<>'information_schema'\n"
    "UNION ALL SELECT 'relation '||n.nspname||'.'||c.relname,\n"
    "  c.relkind::text||' '||pg_get_userbyid(c.relowner)||' '||coalesce(c.relacl::text,'')||' '||coalesce((SELECT md5(string_agg(\n"
    "    a.attname||':'||format_type(a.atttypid,a.atttypmod)||':'||a.attnotnull::text,',' ORDER BY a.attnum))\n"
    "    FROM pg_attribute a WHERE a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped),'')\n"
    "  FROM pg_class c JOIN ns n ON n.oid=c.relnamespace WHERE c.relkind IN ('r','p','v','m','f','S')\n"
    "UNION ALL SELECT 'index '||n.nspname||'.'||c.relname,pg_get_indexdef(c.oid)\n"
    "  FROM pg_class c JOIN ns n ON n.oid=c.relnamespace WHERE c.relkind IN ('i','I')\n"
    "UNION ALL SELECT 'trigger '||t.tgrelid::regclass::text||' '||t.tgname,pg_get_triggerdef(t.oid)\n"
    "  FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid JOIN ns n ON n.oid=c.relnamespace WHERE NOT t.tgisinternal\n"
    "UNION ALL SELECT 'constraint '||k.conrelid::regclass::text||' '||k.conname,pg_get_constraintdef(k.oid)\n"
    "  FROM pg_constraint k JOIN ns n ON n.oid=k.connamespace WHERE k.conrelid<>0\n"
    "UNION ALL SELECT 'function '||n.nspname||'.'||p.proname||'('||pg_get_function_identity_arguments(p.oid)||')',\n"
    "  md5(p.prosrc||coalesce(pg_get_function_sqlbody(p.oid),''))||' '||pg_get_userbyid(p.proowner)||' '||coalesce(p.proacl::text,'')\n"
    "  ||' '||coalesce(p.proconfig::text,'')\n"
    "  FROM pg_proc p JOIN ns n ON n.oid=p.pronamespace\n"
    "UNION ALL SELECT 'default-acl '||pg_get_userbyid(d.defaclrole)||' '||coalesce(d.defaclnamespace::regnamespace::text,'-')||' '||d.defaclobjtype::text,\n"
    "  d.defaclacl::text FROM pg_default_acl d\n"
    "UNION ALL SELECT 'membership '||m.roleid::regrole::text||' '||m.member::regrole::text,m.admin_option::text FROM pg_auth_members m\n"
    "UNION ALL SELECT 'database-acl',coalesce(datacl::text,'') FROM pg_database WHERE datname=current_database()\n"
    "UNION ALL SELECT 'database-setting '||CASE WHEN s.setrole=0 THEN '*' ELSE pg_get_userbyid(s.setrole) END||' '||split_part(v,'=',1),\n"
    "  substr(v,strpos(v,'=')+1)\n"
    "  FROM pg_db_role_setting s,LATERAL unnest(s.setconfig) v WHERE s.setdatabase=(SELECT oid FROM pg_database WHERE datname=current_database())\n"
    ") declared ORDER BY key,value")
/* Rows the declaration seeds into the application schema: tenants and platform roles. */
SQL_QUERY("migration.declared_seed_snapshot", "",
    "SELECT 'tenant '||tenant_id,kind FROM app.tenants UNION ALL SELECT 'platform-role '||user_id::text,role FROM app.platform_roles ORDER BY 1,2")
SQL_QUERY("migration.database_exists", "text",
    "SELECT EXISTS (SELECT FROM pg_database WHERE datname=$1)")
SQL_QUERY("migration.declaration_present", "text",
    "SELECT to_regclass($1) IS NOT NULL")

/* Bootstrap metadata and explicitly confirmed database lifecycle commands. */
SQL_QUERY("migration.database_options", "text",
    "SELECT format('OWNER %I TEMPLATE template0 ENCODING %L LOCALE_PROVIDER %s LC_COLLATE %L LC_CTYPE %L TABLESPACE %I CONNECTION LIMIT %s',\n    pg_get_userbyid(d.datdba), pg_encoding_to_char(d.encoding),\n    CASE d.datlocprovider WHEN 'i' THEN 'icu' WHEN 'b' THEN 'builtin' ELSE 'libc' END,\n    d.datcollate, d.datctype, t.spcname, d.datconnlimit)\n    || CASE WHEN d.datlocprovider='i' THEN format(' ICU_LOCALE %L',d.datlocale)\n            WHEN d.datlocprovider='b' THEN format(' BUILTIN_LOCALE %L',d.datlocale) ELSE '' END\n    || CASE WHEN d.daticurules IS NOT NULL THEN format(' ICU_RULES %L',d.daticurules) ELSE '' END\n    || CASE WHEN d.datcollversion IS NOT NULL THEN format(' COLLATION_VERSION %L',d.datcollversion) ELSE '' END\nFROM pg_database d JOIN pg_tablespace t ON t.oid=d.dattablespace\nWHERE d.datname=$1 AND NOT d.datistemplate AND d.datallowconn AND d.datconnlimit>=-1")
SQL_QUERY("migration.database_settings", "text",
    "SELECT CASE WHEN s.setrole=0 THEN 'ALTER DATABASE ' ELSE format('ALTER ROLE %I IN DATABASE ',pg_get_userbyid(s.setrole)) END,\n       format(' SET %I TO %L',split_part(v,'=',1),substr(v,strpos(v,'=')+1))\nFROM pg_db_role_setting s JOIN pg_database d ON d.oid=s.setdatabase,\n     LATERAL unnest(s.setconfig) v\nWHERE d.datname=$1 ORDER BY s.setrole,v")
SQL_QUERY("migration.database_access", "text",
    "SELECT 'GRANT '||a.privilege_type||' ON DATABASE ',\n       ' TO '||CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE quote_ident(pg_get_userbyid(a.grantee)) END\n       ||CASE WHEN a.is_grantable THEN ' WITH GRANT OPTION' ELSE '' END\nFROM pg_database d, LATERAL aclexplode(COALESCE(d.datacl,acldefault('d',d.datdba))) a\nWHERE d.datname=$1")
SQL_QUERY("migration.object_targets", "",
    "WITH objects AS (\n    SELECT 'SCHEMA '||quote_ident(nspname) AS target,nspacl AS acl,nspowner AS owner\n    FROM pg_namespace WHERE nspname !~ '^pg_' AND nspname<>'information_schema'\n    UNION ALL\n    SELECT CASE WHEN c.relkind='S' THEN 'SEQUENCE ' ELSE 'TABLE ' END||format('%I.%I',n.nspname,c.relname),c.relacl,c.relowner\n    FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace\n    WHERE n.nspname !~ '^pg_' AND n.nspname<>'information_schema' AND c.relkind IN ('r','p','v','m','f','S')\n    UNION ALL\n    SELECT CASE WHEN p.prokind='p' THEN 'PROCEDURE ' ELSE 'FUNCTION ' END||format('%I.%I(%s)',n.nspname,p.proname,pg_get_function_identity_arguments(p.oid)),p.proacl,p.proowner\n    FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace\n    WHERE n.nspname !~ '^pg_' AND n.nspname<>'information_schema'\n    UNION ALL\n    SELECT 'TYPE '||format('%I.%I',n.nspname,t.typname),t.typacl,t.typowner\n    FROM pg_type t JOIN pg_namespace n ON n.oid=t.typnamespace\n    WHERE n.nspname !~ '^pg_' AND n.nspname<>'information_schema'\n) SELECT target,'' FROM objects")
SQL_QUERY("migration.object_access", "",
    "WITH objects AS (\n    SELECT 'SCHEMA '||quote_ident(nspname) AS target,nspacl AS acl,nspowner AS owner\n    FROM pg_namespace WHERE nspname !~ '^pg_' AND nspname<>'information_schema'\n    UNION ALL\n    SELECT CASE WHEN c.relkind='S' THEN 'SEQUENCE ' ELSE 'TABLE ' END||format('%I.%I',n.nspname,c.relname),c.relacl,c.relowner\n    FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace\n    WHERE n.nspname !~ '^pg_' AND n.nspname<>'information_schema' AND c.relkind IN ('r','p','v','m','f','S')\n    UNION ALL\n    SELECT CASE WHEN p.prokind='p' THEN 'PROCEDURE ' ELSE 'FUNCTION ' END||format('%I.%I(%s)',n.nspname,p.proname,pg_get_function_identity_arguments(p.oid)),p.proacl,p.proowner\n    FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace\n    WHERE n.nspname !~ '^pg_' AND n.nspname<>'information_schema'\n    UNION ALL\n    SELECT 'TYPE '||format('%I.%I',n.nspname,t.typname),t.typacl,t.typowner\n    FROM pg_type t JOIN pg_namespace n ON n.oid=t.typnamespace\n    WHERE n.nspname !~ '^pg_' AND n.nspname<>'information_schema'\n)\n, defaults AS (\n    SELECT 'ALTER DEFAULT PRIVILEGES FOR ROLE '||quote_ident(pg_get_userbyid(d.defaclrole))\n        ||CASE WHEN n.oid IS NULL THEN '' ELSE ' IN SCHEMA '||quote_ident(n.nspname) END AS prefix,\n        CASE d.defaclobjtype WHEN 'r' THEN 'TABLES' WHEN 'S' THEN 'SEQUENCES' WHEN 'f' THEN 'FUNCTIONS'\n            WHEN 'T' THEN 'TYPES' WHEN 'n' THEN 'SCHEMAS' END AS kind,d.defaclacl AS acl,\n        CASE WHEN n.oid IS NULL THEN '' ELSE 'SCHEMA '||quote_ident(n.nspname) END AS target\n    FROM pg_default_acl d LEFT JOIN pg_namespace n ON n.oid=d.defaclnamespace\n), statements AS (\n    SELECT 0 AS ordinal,'REVOKE ALL ON '||target||' FROM PUBLIC' AS sql,target FROM objects WHERE acl IS NOT NULL\n    UNION ALL\n    SELECT 1,'GRANT '||a.privilege_type||' ON '||o.target||' TO '\n        ||CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE quote_ident(pg_get_userbyid(a.grantee)) END\n        ||CASE WHEN a.is_grantable THEN ' WITH GRANT OPTION' ELSE '' END,o.target\n    FROM objects o,LATERAL aclexplode(o.acl) a\n    UNION ALL\n    SELECT 2,prefix||' REVOKE ALL ON '||kind||' FROM PUBLIC',target FROM defaults\n    UNION ALL\n    SELECT 3,d.prefix||' GRANT '||a.privilege_type||' ON '||d.kind||' TO '\n        ||CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE quote_ident(pg_get_userbyid(a.grantee)) END\n        ||CASE WHEN a.is_grantable THEN ' WITH GRANT OPTION' ELSE '' END,d.target\n    FROM defaults d,LATERAL aclexplode(d.acl) a\n) SELECT sql,target FROM statements ORDER BY ordinal,sql")
SQL_QUERY("migration.schema_owner", "text",
    "SELECT pg_get_userbyid(nspowner) FROM pg_namespace WHERE nspname=$1")
SQL_QUERY("migration.reset_application_schema", "",
    "DROP SCHEMA IF EXISTS app CASCADE")
SQL_QUERY("migration.database_create", "",
    "CREATE DATABASE {database} {options}")
SQL_QUERY("migration.database_revoke_public", "",
    "REVOKE ALL ON DATABASE {database} FROM PUBLIC")
SQL_QUERY("migration.database_block", "",
    "ALTER DATABASE {database} ALLOW_CONNECTIONS false")
SQL_QUERY("migration.database_rename", "",
    "ALTER DATABASE {database} RENAME TO {replacement}")
SQL_QUERY("migration.database_reopen", "",
    "ALTER DATABASE {database} ALLOW_CONNECTIONS true")
SQL_QUERY("migration.database_drop", "",
    "DROP DATABASE {database} WITH (FORCE)")
SQL_QUERY("migration.application_schema_owner", "",
    "CREATE SCHEMA app AUTHORIZATION {owner}")
SQL_QUERY("migration.application_schema", "",
    "CREATE SCHEMA app")
SQL_QUERY("migration.cutover_sessions", "text[]",
    "SELECT pg_terminate_backend(pid,5000) FROM pg_stat_activity WHERE datname=ANY($1) AND pid<>pg_backend_pid()")


SQL_QUERY("generation.path_plane", "bytea[],text,int4,int4,bool,bytea[]",
    "WITH RECURSIVE steps AS MATERIALIZED (\n SELECT ord::int AS depth,ARRAY(SELECT public.laplace_text_id(t) FROM jsonb_array_elements_text(s->'types') t) AS tids,\n ARRAY(SELECT t FROM jsonb_array_elements_text(s->'types') t) AS type_names,\n coalesce((s->>'reverse')::boolean,false) AS reverse,coalesce((s->>'optional')::boolean,false) AS optional\n FROM jsonb_array_elements($2::jsonb) WITH ORDINALITY q(s,ord)\n), walk(root,id,depth,weight,ids,claims) AS (\n SELECT DISTINCT id,id,0,1::float8,ARRAY[id],'[]'::jsonb FROM unnest($1::bytea[]) v(id)\n UNION ALL\n SELECT w.root,e.id,w.depth+1,w.weight*e.weight,w.ids||e.id,\n w.claims||CASE WHEN e.claim IS NULL THEN '[]'::jsonb ELSE jsonb_build_array(e.claim) END\n FROM walk w JOIN steps s ON s.depth=w.depth+1 CROSS JOIN LATERAL (\n SELECT edge.* FROM (\n SELECT w.id AS id,1::float8 AS weight,NULL::jsonb AS claim WHERE s.optional\n UNION ALL\n SELECT decode((CASE WHEN s.reverse THEN (public.laplace_vertex_ids(ST_PointN(c.path,1)))[1] ELSE c.object END)::text,'hex'),\n consensus.walk_edge_weight(c.rating,c.deviation),\n jsonb_build_object('claim_id',decode(c.entity::text,'hex'),'subject_id',decode((public.laplace_vertex_ids(ST_PointN(c.path,1)))[1]::text,'hex'),\n 'type_id',decode(c.predicate::text,'hex'),'object_id',decode(c.object::text,'hex'),'rating',c.rating,'rd',c.deviation)\n FROM (\n WITH selected AS MATERIALIZED (\n SELECT * FROM public.laplace_claims_each(ARRAY[encode(w.id,'hex')::public.blake3],NULL,'{}','{}',(CASE WHEN s.reverse THEN 2 ELSE 1 END)::smallint)\n ), scoped AS MATERIALIZED (\n SELECT * FROM public.laplace_source_standings(ARRAY(SELECT entity FROM selected ORDER BY entity),\n ARRAY(SELECT encode(id,'hex')::public.blake3 FROM unnest($6::bytea[]) u(id))) WHERE $6 IS NOT NULL\n ), preview AS MATERIALIZED (\n SELECT * FROM public.laplace_claim_preview(ARRAY(SELECT entity FROM selected ORDER BY entity))\n ), relation_metadata AS MATERIALIZED (\n SELECT * FROM consensus.relation_metadata(ARRAY(SELECT DISTINCT decode(predicate::text,'hex') FROM preview WHERE predicate IS NOT NULL))\n )\n SELECT c.entity,c.path,\n CASE WHEN $6 IS NULL THEN c.rating ELSE scoped.rating END AS rating,\n CASE WHEN $6 IS NULL THEN c.deviation ELSE scoped.deviation END AS deviation,p.object,p.predicate,p.type_label,\n CASE WHEN NOT m.inverse AND m.qualifier_bit<0 THEN m.canonical END AS canonical_type\n FROM selected c JOIN preview p ON p.entity=c.entity LEFT JOIN scoped ON scoped.claim=c.entity\n LEFT JOIN relation_metadata m ON m.surface_id=decode(p.predicate::text,'hex')\n WHERE $6 IS NULL OR scoped.claim IS NOT NULL\n ) c\n WHERE public.laplace_path_length(c.path)=3 AND (c.predicate=ANY(s.tids) OR c.type_label=ANY(s.type_names) OR c.canonical_type=ANY(s.type_names))\n AND CASE WHEN s.reverse THEN public.laplace_path_ends(c.path,encode(w.id,'hex')::public.blake3)\n ELSE public.laplace_path_starts(c.path,encode(w.id,'hex')::public.blake3) END\n ) edge WHERE edge.weight>0 ORDER BY edge.weight DESC,edge.id LIMIT $3\n ) e\n), aggregated AS (\n SELECT root AS subject_id,id AS object_id,sum(weight) AS w,\n jsonb_agg(jsonb_build_object('ids',ids,'claims',claims,'weight',weight) ORDER BY ids) AS paths\n FROM walk WHERE depth=(SELECT count(*) FROM steps) AND root<>id AND (NOT $5 OR id=ANY($1::bytea[])) GROUP BY root,id\n), ranked AS (\n SELECT *,row_number() OVER(PARTITION BY subject_id ORDER BY w DESC,object_id) AS rn FROM aggregated\n) SELECT subject_id,object_id,w,paths FROM ranked WHERE rn<=$4 ORDER BY subject_id,rn")

SQL_QUERY("generation.export_sequences", "bytea[],int4,int4,bytea[]",
    "SELECT p.entity_id,p.id,public.laplace_trajectory_constituent_ids(p.trajectory) "
    "FROM laplace.physicalities p WHERE p.type=1 AND p.trajectory IS NOT NULL "
    "AND p.n_constituents BETWEEN 2 AND $3 "
    "AND public.laplace_trajectory_constituent_ids(p.trajectory) && $1 "
    "AND public.laplace_trajectory_constituent_ids(p.trajectory) <@ $1 "
    "AND ($4 IS NULL OR EXISTS(SELECT FROM laplace.attestations a "
    "WHERE a.subject_id=p.entity_id AND a.source_id=ANY($4))) "
    "ORDER BY p.entity_id,p.id LIMIT $2")

SQL_QUERY("generation.export_source_attribution", "bytea[],bytea[]",
    "SELECT public.blake3_send(source_id),claims_touched,games,fisher_weight,share_bp FROM public.laplace_source_attribution(ARRAY(SELECT DISTINCT public.blake3_from_bytea(id) FROM unnest($1::bytea[]) u(id)),ARRAY(SELECT DISTINCT public.blake3_from_bytea(id) FROM unnest($2::bytea[]) u(id))) ORDER BY source_id")

SQL_QUERY("generation.export_type_plane", "bytea[],int4,bytea[]",
    "SELECT subject_id,object_id,w,type_id,layer_rank "
    "FROM generation.consensus_type_plane($1,$2,$3) WHERE w<>0 "
    "ORDER BY type_id,subject_id,abs(w) DESC,object_id")

SQL_QUERY("generation.export_adjacency", "bytea[],int4",
    "SELECT subject_id,object_id,w FROM generation.consensus_adjacency($1,$2) "
    "ORDER BY subject_id,abs(w) DESC,object_id")

SQL_QUERY("geometry.separators", "", "SELECT generation.separator_ids()")

SQL_QUERY("readback.constituent_edges", "bytea[],int4",
    "SELECT parent_id,child_id,run_length,flags FROM realize.constituents_closure($1,$2) ORDER BY parent_id,ordinal")

SQL_QUERY("query.declared_paths_step", "int4[],bytea[],bytea[],int4",
    "WITH wanted AS MATERIALIZED (\n SELECT w.slot,public.blake3_from_bytea(w.node) AS node,\n w.relation AS rel_bytea,public.blake3_from_bytea(w.relation) AS relation,w.ordinal\n FROM unnest($1::int4[],$2::bytea[],$3::bytea[]) WITH ORDINALITY AS w(slot,node,relation,ordinal)\n), surfaces AS MATERIALIZED (\n SELECT w.ordinal,public.blake3_from_bytea(s.surface_id) AS surface_b3,\n public.blake3_from_bytea(s.canonical_id) AS canonical_b3,s.inverse\n FROM wanted w CROSS JOIN LATERAL consensus.relation_surfaces(ARRAY[w.rel_bytea]) s\n), candidates AS MATERIALIZED (\n SELECT * FROM public.laplace_claims_each(ARRAY(SELECT node FROM wanted ORDER BY ordinal),NULL::bigint,\n ARRAY[public.laplace_bank_bit('kind','claim')],'{}'::public.blake3[],\n (CASE WHEN EXISTS (SELECT 1 FROM surfaces WHERE inverse) THEN 3 ELSE 1 END)::smallint,\n ARRAY(SELECT DISTINCT surface_b3 FROM surfaces),3::bigint)\n), selected AS MATERIALIZED (\n SELECT DISTINCT ON (w.slot,c.entity) w.slot,w.relation,sf.surface_b3,sf.inverse,\n (public.laplace_parts(c.path))[1] AS subj,(public.laplace_parts(c.path))[3] AS obj,\n c.entity,c.rating,c.deviation,c.matches\n FROM candidates c JOIN wanted w ON w.ordinal=c.i\n JOIN surfaces sf ON sf.ordinal=w.ordinal AND public.laplace_middle_any(c.path,ARRAY[sf.surface_b3])\n WHERE public.laplace_path_length(c.path)=3\n   AND ((NOT sf.inverse AND public.laplace_path_starts(c.path,w.node))\n        OR (sf.inverse AND public.laplace_path_ends(c.path,w.node)))\n ORDER BY w.slot,c.entity,c.rating-2*c.deviation DESC\n), capped AS MATERIALIZED (\n SELECT * FROM selected ORDER BY slot,rating-2*deviation DESC,entity LIMIT $4\n), preview AS MATERIALIZED (\n SELECT * FROM public.laplace_claim_preview(ARRAY(SELECT DISTINCT entity FROM capped ORDER BY entity))\n) SELECT s.slot,public.blake3_send(s.entity),\n public.blake3_send(CASE WHEN s.inverse THEN s.subj ELSE s.obj END),\n v.type_label,v.fact,\n (s.rating-2*s.deviation)::numeric,greatest(s.matches,1)::bigint\n FROM capped s JOIN preview v ON v.entity=s.entity AND v.predicate=s.surface_b3\n ORDER BY s.slot,s.rating-2*s.deviation DESC,s.entity")

SQL_QUERY("native.membership_any", "bytea[],bytea[],int8",
    "WITH keys AS MATERIALIZED (SELECT ARRAY(SELECT DISTINCT public.blake3_from_bytea(id) FROM unnest($1::bytea[]) u(id) WHERE id IS NOT NULL) AS ids), required AS MATERIALIZED (SELECT ARRAY(SELECT DISTINCT public.blake3_from_bytea(id) FROM unnest($2::bytea[]) u(id) WHERE id IS NOT NULL) AS ids)\nSELECT public.blake3_send(p.entity),p.path FROM keys k CROSS JOIN required r\nCROSS JOIN LATERAL public.laplace_holders(k.ids,r.ids) p\nORDER BY p.entity LIMIT CASE WHEN $3=0 THEN NULL ELSE $3+1 END")

SQL_QUERY("native.membership_all", "bytea[],bytea[],int8",
    "WITH keys AS MATERIALIZED (SELECT ARRAY(SELECT DISTINCT public.blake3_from_bytea(id) FROM unnest($1::bytea[]) u(id) WHERE id IS NOT NULL) AS ids), required AS MATERIALIZED (SELECT ARRAY(SELECT DISTINCT public.blake3_from_bytea(id) FROM unnest($2::bytea[]) u(id) WHERE id IS NOT NULL) AS ids)\nSELECT public.blake3_send(p.entity),p.path FROM keys k CROSS JOIN required r\nCROSS JOIN LATERAL public.laplace_containers(k.ids||r.ids,'{}'::smallint[]) p\nORDER BY p.entity LIMIT CASE WHEN $3=0 THEN NULL ELSE $3+1 END")

/* Shared Native GIN/standing acquisition precedes exact endpoint projection.
 * Never plan endpoint joins over the complete partition estate. */
SQL_QUERY("native.consensus_cells", "bytea[],bytea[],bytea[],bool",
    "WITH surfaces AS MATERIALIZED (\n"
    " SELECT s.surface_id,public.blake3_from_bytea(s.surface_id) AS surface_b3,s.canonical_id,s.inverse\n"
    " FROM consensus.relation_surfaces($3::bytea[]) s\n"
    "), raw_keys AS MATERIALIZED (\n"
    " SELECT CASE WHEN $1 IS NULL THEN NULL::public.blake3[] ELSE ARRAY(SELECT DISTINCT public.blake3_from_bytea(id) FROM unnest($1::bytea[]) u(id) WHERE id IS NOT NULL ORDER BY 1) END AS s_ids,\n"
    " CASE WHEN $2 IS NULL THEN NULL::public.blake3[] ELSE ARRAY(SELECT DISTINCT public.blake3_from_bytea(id) FROM unnest($2::bytea[]) u(id) WHERE id IS NOT NULL ORDER BY 1) END AS o_ids,\n"
    " ($3 IS NULL OR EXISTS (SELECT 1 FROM surfaces WHERE inverse)) AS has_inverse\n"
    "), keys AS MATERIALIZED (\n"
    " SELECT CASE WHEN $1 IS NOT NULL AND $2 IS NOT NULL AND NOT $4 AND r.has_inverse AND r.s_ids IS DISTINCT FROM r.o_ids AND cardinality(r.o_ids)<cardinality(r.s_ids) THEN r.o_ids ELSE coalesce(r.s_ids,r.o_ids) END AS ids,\n"
    " CASE WHEN $3 IS NULL THEN NULL::public.blake3[] ELSE ARRAY(SELECT DISTINCT surface_b3 FROM surfaces ORDER BY surface_b3) END AS types,\n"
    " CASE WHEN $1 IS NULL OR $2 IS NULL OR $4 OR (r.has_inverse AND r.s_ids IS DISTINCT FROM r.o_ids) THEN NULL::public.blake3[]\n"
    "      WHEN r.has_inverse AND cardinality(r.o_ids)<cardinality(r.s_ids) THEN r.s_ids\n"
    "      ELSE r.o_ids END AS opp,\n"
    " ($4 AND $1 IS NOT NULL AND $2 IS NOT NULL) OR (r.has_inverse AND ($1 IS NULL OR $2 IS NULL OR $4 OR r.s_ids IS DISTINCT FROM r.o_ids)) AS has_inverse\n"
    " FROM raw_keys r\n"
    "), selected AS MATERIALIZED (\n"
    " SELECT DISTINCT ON(c.entity) c.entity,public.laplace_parts(c.path) AS ids,c.rating,c.deviation,c.volatility,c.matches\n"
    " FROM keys k CROSS JOIN LATERAL public.laplace_claims_each(\n"
    " k.ids,NULL::bigint,ARRAY[public.laplace_bank_bit('kind','claim')],'{}'::public.blake3[],\n"
    " (CASE WHEN k.has_inverse THEN 3 WHEN $1 IS NOT NULL THEN 1 ELSE 2 END)::smallint,k.types,3::bigint,k.opp) c\n"
    " ORDER BY c.entity\n"
    "), claim_meta AS MATERIALIZED (\n"
    " SELECT m.surface_id,m.canonical_id,m.inverse\n"
    " FROM consensus.relation_metadata(ARRAY(SELECT DISTINCT public.blake3_send(s.ids[2]) FROM selected s WHERE cardinality(s.ids)=3)) m\n"
    "), oriented AS MATERIALIZED (\n"
    " SELECT s.entity,\n"
    " CASE WHEN coalesce(m.inverse,false) THEN public.blake3_send(s.ids[3]) ELSE public.blake3_send(s.ids[1]) END AS subj_id,\n"
    " coalesce(m.canonical_id,public.blake3_send(s.ids[2])) AS type_id,\n"
    " CASE WHEN coalesce(m.inverse,false) THEN public.blake3_send(s.ids[1]) ELSE public.blake3_send(s.ids[3]) END AS obj_id,\n"
    " round(s.rating::numeric*1e9)::bigint AS rating,\n"
    " round(s.deviation::numeric*1e9)::bigint AS rd,\n"
    " round(s.volatility::numeric*1e9)::bigint AS volatility,\n"
    " greatest(s.matches,1)::bigint AS witnesses,\n"
    " s.rating-2*s.deviation AS standing\n"
    " FROM selected s LEFT JOIN claim_meta m ON m.surface_id=public.blake3_send(s.ids[2])\n"
    " WHERE cardinality(s.ids)=3\n"
    ") SELECT o.subj_id,o.type_id,o.obj_id,o.rating,o.rd,o.volatility,o.witnesses,public.blake3_send(o.entity)\n"
    " FROM oriented o\n"
    " WHERE (CASE WHEN $4 AND $1 IS NOT NULL AND $2 IS NOT NULL THEN (o.subj_id=ANY($1) OR o.obj_id=ANY($2)) ELSE ($1 IS NULL OR o.subj_id=ANY($1)) AND ($2 IS NULL OR o.obj_id=ANY($2)) END)\n"
    " AND ($3 IS NULL OR o.type_id=ANY($3) OR o.type_id IN (SELECT canonical_id FROM surfaces))\n"
    " ORDER BY o.standing DESC,o.entity")

/* Predicateless Native value claims, qualified by their canonical value bank.
 * Raw source spellings are retained without inferring a classification. */
SQL_QUERY("native.classification_values", "bytea[],text",
    "WITH keys AS MATERIALIZED (\n SELECT ARRAY(SELECT DISTINCT public.blake3_from_bytea(id)\n FROM unnest($1::bytea[]) u(id) WHERE id IS NOT NULL ORDER BY 1) AS ids\n), claims AS MATERIALIZED (\n SELECT c.entity,c.path,c.rating,c.deviation,c.volatility,c.matches\n FROM keys k CROSS JOIN LATERAL public.laplace_claims_each(k.ids,NULL::bigint,\n ARRAY[public.laplace_bank_bit('kind','claim')],'{}'::public.blake3[],1::smallint,NULL::public.blake3[],2::bigint) c\n WHERE c.matches>0\n), parts AS MATERIALIZED (\n SELECT c.*,public.laplace_parts(c.path) AS ids FROM claims c\n)\nSELECT public.blake3_send(p.ids[1]),public.blake3_send(p.ids[2]),\n round(p.rating::numeric*1e9)::bigint,round(p.deviation::numeric*1e9)::bigint,\n round(p.volatility::numeric*1e9)::bigint,p.matches,public.blake3_send(p.entity)\nFROM parts p CROSS JOIN LATERAL public.laplace_bank_of(p.ids[2]) b WHERE b.bank=$2\nORDER BY p.entity")

/* Stored-only identities for observation resolution, unlike the virtual T0 floor. */
SQL_QUERY("native.stored_ids", "bytea[]",
    "SELECT public.blake3_send(p.id) FROM public.laplace_present_ids(ARRAY(SELECT public.blake3_from_bytea(id) FROM unnest($1::bytea[]) u(id))) p")
SQL_QUERY("native.resolve_containers", "bytea[],int4",
    "SELECT h.ordinal,public.blake3_send(h.entity) FROM public.laplace_holders(ARRAY(SELECT public.blake3_from_bytea(id) FROM unnest($1::bytea[]) u(id)), '{}'::public.blake3[],true,-1::smallint,$2::bigint,3::smallint) h WHERE NOT h.hub ORDER BY h.ordinal,h.entity")

SQL_QUERY("query.declared_paths", "bytea[],jsonb,int4",
    "SELECT root_index,program_index,path_index,depth,claim_id,entity_id,relation,label,eff_mu,witnesses FROM ops.declared_paths($1,$2,$3) ORDER BY root_index,program_index,path_index,depth")
SQL_QUERY("recall.declared_definitions", "bytea",
    "WITH paths AS MATERIALIZED (SELECT * FROM ops.declared_paths(ARRAY[$1::bytea],converse.query_program(),4096)), senses AS MATERIALIZED (SELECT path_index,public.blake3_from_bytea(entity_id) AS sense_b3 FROM paths WHERE depth=0), sense_claims AS MATERIALIZED (SELECT c.entity,public.laplace_parts(c.path) AS parts,c.rating,c.deviation,c.matches FROM public.laplace_claims_each(ARRAY(SELECT DISTINCT sense_b3 FROM senses),NULL::bigint,ARRAY[public.laplace_bank_bit('kind','claim')],'{}'::public.blake3[],1::smallint,NULL::public.blake3[],3::bigint) c WHERE c.matches>1 AND (c.rating-2*c.deviation)>0), usage_objs AS MATERIALIZED (SELECT l.entity AS obj_b3,l.content::bigint AS freq FROM public.laplace_labels(ARRAY(SELECT DISTINCT parts[3] FROM sense_claims)) l WHERE l.content ~ '^[0-9]+$' AND length(l.content)<=18), sense_boost AS MATERIALIZED (SELECT s.path_index,max((sc.rating-2*sc.deviation)::numeric+uo.freq::numeric) AS boost_mu,max(GREATEST(sc.matches::bigint,uo.freq::bigint)) AS boost_w FROM senses s JOIN sense_claims sc ON sc.parts[1]=s.sense_b3 JOIN usage_objs uo ON uo.obj_b3=sc.parts[3] GROUP BY s.path_index), path_ends AS MATERIALIZED (SELECT p.entity_id,p.label,p.program_index,p.path_index,GREATEST(p.eff_mu,COALESCE(sb.boost_mu,0::numeric)) AS eff_mu,GREATEST(p.witnesses,COALESCE(sb.boost_w,1::bigint)) AS witnesses,row_number() OVER(PARTITION BY p.path_index ORDER BY p.depth DESC) AS last FROM paths p LEFT JOIN sense_boost sb ON sb.path_index=p.path_index), lex_senses AS MATERIALIZED (SELECT * FROM lexical.senses($1::bytea) WHERE NOT EXISTS (SELECT 1 FROM path_ends WHERE last=1)), lex_subjs AS MATERIALIZED (SELECT ls.eff_mu AS sense_mu,ls.witnesses AS sense_w,k.subj FROM lex_senses ls CROSS JOIN LATERAL (VALUES (ls.sense_id),(CASE WHEN ls.synset_id IS DISTINCT FROM ls.sense_id THEN ls.synset_id END)) AS k(subj) WHERE k.subj IS NOT NULL), lex_edges AS MATERIALIZED (SELECT e.subject_id,e.neighbour_id AS entity_id,consensus.eff_mu_display(e.rating,e.rd) AS edge_mu,e.witness_count AS edge_w FROM consensus.edges_raw_batch(ARRAY(SELECT DISTINCT subj FROM lex_subjs),'out',ARRAY[laplace.relation_type_id('HAS_DEFINITION')],16,false,'eff_mu') e WHERE EXISTS (SELECT 1 FROM lex_subjs) AND e.neighbour_id IS NOT NULL), lex_picked AS MATERIALIZED (SELECT DISTINCT ON (le.entity_id) le.entity_id,GREATEST(ls.sense_mu,le.edge_mu) AS eff_mu,GREATEST(ls.sense_w,le.edge_w,1::bigint) AS witnesses,ls.sense_mu+le.edge_mu AS rank_score FROM lex_subjs ls JOIN lex_edges le ON le.subject_id=ls.subj ORDER BY le.entity_id,ls.sense_mu+le.edge_mu DESC), lex_numbered AS MATERIALIZED (SELECT lp.*,row_number() OVER (ORDER BY lp.rank_score DESC,lp.entity_id) AS rn FROM lex_picked lp), lex_rendered AS MATERIALIZED (SELECT realize.render_text_batch(array_agg(entity_id ORDER BY rn)) AS txt FROM lex_numbered), combined AS (SELECT entity_id,label,program_index,path_index,eff_mu,witnesses FROM path_ends WHERE last=1 UNION ALL SELECT ln.entity_id,lr.txt[ln.rn] AS label,100::int AS program_index,ln.rn AS path_index,ln.eff_mu,ln.witnesses FROM lex_numbered ln CROSS JOIN lex_rendered lr WHERE lr.txt[ln.rn] IS NOT NULL), unique_definitions AS (SELECT *,row_number() OVER(PARTITION BY entity_id ORDER BY eff_mu DESC,program_index,path_index) AS selected FROM combined) SELECT entity_id,label,round(eff_mu*1e9)::bigint,witnesses FROM unique_definitions WHERE selected=1 ORDER BY eff_mu DESC,program_index,path_index,entity_id")

SQL_QUERY("native.constituent_frontier", "bytea[]",
    "SELECT public.blake3_send(p.entity),p.ordinal,public.blake3_send(p.child),p.run_length,p.flags FROM public.laplace_constituents(ARRAY(SELECT public.blake3_from_bytea(id) FROM unnest($1::bytea[]) u(id))) p ORDER BY p.entity,p.ordinal")

SQL_QUERY("geometry.prompt.angular", "float8,float8,float8,float8,bytea,int4,int2",
    "SELECT entity_id,distance FROM structural.angular_nearest(public.ST_MakePoint($1,$2,$3,$4),$6,$7,$5) ORDER BY distance,entity_id")

/* Storage biases unsigned Hilbert keys into signed bigint order. Seek that
 * order directly, then restore raw bits for the Native distance reducer.
 * The directional scan selects a boundary key, not an arbitrary subset of its
 * ties: the equality seek returns its smallest IDs using the existing index. */
SQL_QUERY("geometry.prompt.hilbert", "float8,float8,float8,float8,bytea,int4,int2",
    "WITH anchor AS MATERIALIZED (\n SELECT public.laplace_hilbert4(public.ST_MakePoint($1,$2,$3,$4)) # '-9223372036854775808'::bigint AS key\n), upper_same AS MATERIALIZED (\n SELECT e.id,e.hilbert FROM public.entity e\n WHERE e.tier=$7 AND e.id<>public.blake3_from_bytea($5)\n   AND e.hilbert>=(SELECT key FROM anchor)\n ORDER BY e.hilbert,e.id LIMIT $6\n), lower_raw AS MATERIALIZED (\n SELECT e.id,e.hilbert,row_number() OVER (ORDER BY e.hilbert DESC,e.id DESC) AS rn\n FROM (SELECT e.id,e.hilbert FROM public.entity e\n WHERE e.tier=$7 AND e.id<>public.blake3_from_bytea($5)\n   AND e.hilbert<(SELECT key FROM anchor)\n ORDER BY e.hilbert DESC,e.id DESC LIMIT $6+1) e\n), tie_key AS MATERIALIZED (\n SELECT a.hilbert FROM lower_raw a JOIN lower_raw b ON a.rn=$6 AND b.rn=$6+1 AND a.hilbert=b.hilbert\n), lower_tie AS MATERIALIZED (\n SELECT e.id,e.hilbert FROM public.entity e\n WHERE e.tier=$7 AND e.id<>public.blake3_from_bytea($5)\n   AND e.hilbert=(SELECT hilbert FROM tie_key)\n ORDER BY e.id LIMIT $6\n), selected AS (\n SELECT id,hilbert FROM upper_same\n UNION ALL SELECT id,hilbert FROM lower_raw WHERE rn<=$6 AND hilbert IS DISTINCT FROM (SELECT hilbert FROM tie_key)\n UNION ALL SELECT id,hilbert FROM lower_tie\n)\nSELECT public.blake3_send(s.id),\n pg_catalog.int8send(s.hilbert # '-9223372036854775808'::bigint),\n pg_catalog.int8send(a.key # '-9223372036854775808'::bigint)\nFROM selected s CROSS JOIN anchor a")

SQL_QUERY("geometry.prompt.frechet", "float8[],float8[],float8[],float8[],bytea[],int4",
    "WITH anchor_points AS MATERIALIZED (\n SELECT public.ST_MakePoint(p.x,p.y,p.z,p.m) coord,p.ord FROM unnest($1::float8[],$2::float8[],$3::float8[],$4::float8[]) WITH ORDINALITY AS p(x,y,z,m,ord)\n), anchor AS MATERIALIZED (SELECT public.ST_MakeLine(coord ORDER BY ord) curve FROM anchor_points), candidates AS MATERIALIZED (\n SELECT u.id,structural.entity_curve(u.id) curve FROM unnest($5::bytea[]) u(id)\n), scored AS (SELECT c.id,public.laplace_frechet_4d(c.curve,a.curve) d FROM candidates c CROSS JOIN anchor a WHERE c.curve IS NOT NULL AND a.curve IS NOT NULL)\nSELECT id,d FROM scored WHERE d IS NOT NULL ORDER BY d,id LIMIT $6")

SQL_QUERY("native.claim_witness_counts", "bytea[]",
    "WITH requested AS MATERIALIZED (SELECT ordinal,public.blake3_from_bytea(id) AS claim FROM unnest($1::bytea[]) WITH ORDINALITY u(id,ordinal)), keys AS MATERIALIZED (SELECT DISTINCT claim FROM requested), counts AS MATERIALIZED (SELECT a.claim,count(*) AS witnesses FROM public.laplace_attested(ARRAY(SELECT claim FROM keys ORDER BY claim),false) a WHERE a.witness GROUP BY a.claim) SELECT r.ordinal,coalesce(c.witnesses,0)::bigint FROM requested r LEFT JOIN counts c USING(claim) ORDER BY r.ordinal")
SQL_QUERY("account.preview_invitation", "bytea,uuid",
    "SELECT t.display_name, i.role, i.expires_at, "
    "coalesce(u.display_name, u.email, 'Workspace administrator'), m.role "
    "FROM app.workspace_invitations i "
    "JOIN app.tenants t ON t.tenant_id = i.tenant_id "
    "JOIN app.users u ON u.user_id = i.created_by "
    "JOIN app.tenant_memberships inviter ON inviter.tenant_id = i.tenant_id AND inviter.user_id = i.created_by "
    "LEFT JOIN app.tenant_memberships m ON m.tenant_id = i.tenant_id AND m.user_id = $2 "
    "WHERE i.token_hash = $1 AND i.revoked_at IS NULL AND i.accepted_at IS NULL AND i.expires_at > now() "
    "AND (inviter.role = 'owner' OR (inviter.role = 'admin' AND i.role = 'member'))")

SQL_QUERY("chess.transition_standings", "bytea[]",
    "SELECT public.blake3_send(s.claim), public.laplace_confidence(s.rating, s.deviation, 2), s.deviation, s.matches\nFROM public.laplace_standings(ARRAY(SELECT public.blake3_from_bytea(id) FROM unnest($1::bytea[]) AS u(id))) AS s")
