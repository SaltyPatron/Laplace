{
  "authority": "UD",
  "release": "2.18",
  "provider": "laplace/native-streaming-delimited-recipe/v1",
  "syntax": "CoNLL-U",
  "fields": [
    {
      "syntaxPath": "token/@group:text",
      "propertyName": "text",
      "valueKind": "Text",
      "disposition": "Content",
      "groupOnce": true
    },
    {
      "syntaxPath": "token/@language",
      "propertyName": "language",
      "valueKind": "Text",
      "disposition": "Testimony",
      "relationName": "HAS_LANGUAGE",
      "objectEntityType": "",
      "subjectMode": "Trunk",
      "trunkField": "group:text",
      "groupOnce": true
    },
    {
      "syntaxPath": "token/@id",
      "propertyName": "id",
      "valueKind": "Text",
      "disposition": "Excluded"
    },
    {
      "syntaxPath": "token/@form",
      "propertyName": "form",
      "valueKind": "Text",
      "disposition": "Identity, Content"
    },
    {
      "syntaxPath": "token/@lemma",
      "propertyName": "lemma",
      "valueKind": "Text",
      "disposition": "Testimony",
      "relationName": "IS_LEMMA_OF",
      "objectEntityType": "",
      "absentSentinel": "_",
      "subjectMode": "Value",
      "omitWhenEqualsSubject": true,
      "contextField": "language",
      "aggregate": true
    },
    {
      "syntaxPath": "token/@upos",
      "propertyName": "upos",
