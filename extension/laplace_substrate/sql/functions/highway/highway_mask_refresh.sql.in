-- Authoritative mask population/clearing enters native C, like deposits.
-- PostgreSQL supplies indexed incident (entity,type) sets; C resolves governed
-- bits once per distinct type, folds masks, and shares the native tuple writer.
-- Every requested identity remains in the workset, including those with no
-- remaining relations. Their desired NULL mask clears stale bits. Registry
-- outages retain exact dirty identities without changing existing masks.
DROP FUNCTION IF EXISTS laplace.highway_mask_refresh(bytea[]);
CREATE OR REPLACE FUNCTION consensus.highway_mask_refresh(p_ids bytea[])
    RETURNS bigint
    AS 'MODULE_PATHNAME', 'pg_laplace_highway_mask_refresh'
    LANGUAGE C VOLATILE;
