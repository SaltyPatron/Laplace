-- Drops entities_tier_type_btree. Type lookups use entities_type_btree; a
-- compound (tier, type_id) btree doubles secondary maintenance on every bulk
-- COPY for no additional read.
DO $do$
BEGIN
    BEGIN
        EXECUTE format('ALTER EXTENSION %I DROP INDEX laplace.entities_tier_type_btree',
                       'laplace_substrate');
    EXCEPTION WHEN OTHERS THEN
        NULL;
    END;
    EXECUTE 'DROP INDEX IF EXISTS laplace.entities_tier_type_btree';
END $do$;
