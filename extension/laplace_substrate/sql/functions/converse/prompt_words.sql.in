CREATE OR REPLACE FUNCTION converse.prompt_tree(p_text text, p_include_surfaces boolean)
    RETURNS TABLE(root_id bytea, node_index int, parent_index int, tier smallint,
                  byte_offset int, byte_length int, id bytea, surface text)
    AS 'EXECUTION_LIBRARY', 'pg_laplace_prompt_tree'
    LANGUAGE C STABLE PARALLEL SAFE;

-- Inspection includes surfaces. Execution consumes the same canonical tree
-- without allocating a text copy for every ancestor and descendant.
CREATE OR REPLACE FUNCTION converse.prompt_tree(p_text text)
    RETURNS TABLE(root_id bytea, node_index int, parent_index int, tier smallint,
                  byte_offset int, byte_length int, id bytea, surface text)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT * FROM converse.prompt_tree(p_text, true);
END;

CREATE OR REPLACE FUNCTION converse.prompt_words(p_text text)
    RETURNS TABLE(ord int, word text, id bytea)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT s.i::int, s.segment, public.blake3_send(s.id)
    FROM public.laplace_segments(p_text) s
    ORDER BY s.i;
END;
