-- The witnesses are the source trunks that attest: each one's trust and lineage are those
-- its attestations carry (the declared class and lineage), labelled from its trunk.
CREATE OR REPLACE FUNCTION ops.witness_catalog(p_ids @extschema:laplace@.blake3[] DEFAULT NULL)
RETURNS TABLE(id @extschema:laplace@.blake3,source_label text,trust double precision,lineage @extschema:laplace@.blake3)
LANGUAGE sql STABLE
BEGIN ATOMIC
WITH sources AS MATERIALIZED (
 SELECT DISTINCT ON (a.witness) a.witness AS id,a.trust,a.lineage FROM @extschema:laplace@.attestation a
 WHERE p_ids IS NULL OR a.witness OPERATOR(@extschema:laplace@.=) ANY(p_ids)
 ORDER BY a.witness,a.lineage NULLS FIRST
), names AS MATERIALIZED (
 SELECT r.entity,(@extschema:laplace@.laplace_vertex_ids(@extschema:postgis@.ST_PointN(r.path,1)))[1] AS child
 FROM @extschema:laplace@.laplace_physicalities(ARRAY(SELECT id FROM sources ORDER BY id)) r
 WHERE @extschema:laplace@.laplace_mask_has(r.mask,@extschema:laplace@.laplace_bank_bit('kind','file'))
), labels AS MATERIALIZED (
 SELECT * FROM @extschema:laplace@.laplace_labels(ARRAY(SELECT DISTINCT child FROM names))
)
SELECT s.id,coalesce(nullif(l.content,''),s.id::text),s.trust,s.lineage
FROM sources s LEFT JOIN names n ON n.entity OPERATOR(@extschema:laplace@.=) s.id
LEFT JOIN labels l ON l.entity OPERATOR(@extschema:laplace@.=) n.child;
END;

-- One Native witness-series owner serves both detailed and aggregate reads.
CREATE OR REPLACE FUNCTION ops.claim_witness_series(p_claims @extschema:laplace@.blake3[])
RETURNS TABLE(claim @extschema:laplace@.blake3,trunk @extschema:laplace@.blake3,
 games double precision,tokens double precision,score double precision,trust double precision,
 dependence_root @extschema:laplace@.blake3,"position" integer,source_label text)
LANGUAGE sql STABLE STRICT
BEGIN ATOMIC
WITH series AS MATERIALIZED (
 SELECT a.* FROM @extschema:laplace@.laplace_attested_series(p_claims) a WHERE a.witness
), sources AS MATERIALIZED (
 SELECT * FROM ops.witness_catalog(ARRAY(SELECT DISTINCT trunk FROM series))
)
SELECT a.claim,a.trunk,a.games,a.tokens,a.score,a.trust,a.dependence_root,a.position,s.source_label
FROM series a JOIN sources s ON s.id OPERATOR(@extschema:laplace@.=) a.trunk;
END;

CREATE OR REPLACE FUNCTION ops.evidence_series_receipt(p_id bytea,p_limit integer DEFAULT 25,p_inbound boolean DEFAULT false)
RETURNS TABLE(claim_id bytea,type_id bytea,object_id bytea,type_label text,object_label text,
 eff_mu numeric,source_id bytea,source_label text,games double precision,tokens double precision,
 score double precision,trust double precision,dependence_root bytea,"position" integer)
LANGUAGE sql STABLE
BEGIN ATOMIC
WITH facts AS MATERIALIZED (SELECT * FROM ops.claim_facts(p_id,p_limit,p_inbound)),
series AS MATERIALIZED (SELECT * FROM ops.claim_witness_series(ARRAY(SELECT claim FROM facts)))
SELECT @extschema:laplace@.blake3_send(f.claim),@extschema:laplace@.blake3_send(f.predicate),@extschema:laplace@.blake3_send(f.object),f.type,f.fact,f.eff_mu,
 @extschema:laplace@.blake3_send(a.trunk),a.source_label,a.games,a.tokens,a.score,a.trust,
 @extschema:laplace@.blake3_send(a.dependence_root),a.position
FROM facts f JOIN series a ON a.claim OPERATOR(@extschema:laplace@.=) f.claim
ORDER BY f.eff_mu DESC,f.claim,a.trunk;
END;

CREATE OR REPLACE FUNCTION ops.evidence_receipt(p_id bytea,p_limit integer DEFAULT 25)
RETURNS TABLE(type_id bytea,object_id bytea,type_label text,object_label text,eff_mu numeric,witness_count bigint,source_labels text)
LANGUAGE sql STABLE
BEGIN ATOMIC
WITH facts AS MATERIALIZED (SELECT * FROM ops.claim_facts(p_id,p_limit)), provenance AS MATERIALIZED (
 SELECT DISTINCT s.claim,s.trunk,s.source_label FROM ops.claim_witness_series(ARRAY(SELECT claim FROM facts)) s
)
SELECT @extschema:laplace@.blake3_send(f.predicate),@extschema:laplace@.blake3_send(f.object),f.type,f.fact,f.eff_mu,
 count(p.trunk)::bigint,string_agg(p.source_label,', ' ORDER BY p.trunk)
FROM facts f LEFT JOIN provenance p ON p.claim OPERATOR(@extschema:laplace@.=) f.claim
GROUP BY f.claim,f.predicate,f.type,f.object,f.fact,f.eff_mu ORDER BY f.eff_mu DESC,f.claim;
END;


DROP FUNCTION IF EXISTS ops.native_evidence_receipt(bytea,integer);
