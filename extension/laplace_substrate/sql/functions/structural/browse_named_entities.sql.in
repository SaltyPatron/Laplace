-- Product-level Browse wrapper. Candidate containment is owned by structural
-- containers_of.sql; name-family/Glicko ranking is owned by consensus.edges.sql.
-- This file intentionally contains no raw substrate-table, relation-id, trajectory,
-- or standing math of its own.
DROP FUNCTION IF EXISTS structural.browse_named_entities(bytea[], bytea, int, int, int);
CREATE OR REPLACE FUNCTION structural.browse_named_entities(
    p_members bytea[],
    p_exact bytea DEFAULT NULL,
    p_offset int DEFAULT 0,
    p_limit int DEFAULT 40,
    p_capacity int DEFAULT 2048)
    RETURNS TABLE(
        entity_id bytea,
        tier smallint,
        type_id bytea,
        matched_name_id bytea,
        match_kind text,
        rating numeric,
        rd numeric,
        eff_mu numeric,
        witness_count bigint,
        candidate_name_count bigint,
        candidate_truncated boolean,
        matched_entity_count bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT *
    FROM consensus.browse_named_entities(
        p_members, p_exact, p_offset, p_limit, p_capacity);
END;
