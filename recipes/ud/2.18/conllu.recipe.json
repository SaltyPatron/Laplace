      "contextField": "language",
      "vocabulary": "pos/upos",
      "aggregate": true
    },
    {
      "syntaxPath": "token/@xpos",
      "propertyName": "xpos",
      "valueKind": "Text",
      "disposition": "Excluded"
    },
    {
      "syntaxPath": "token/@feats",
      "propertyName": "feats",
      "valueKind": "EnumeratedSequence",
      "disposition": "Testimony",
      "objectEntityType": "Morphological_Feature",
      "absentSentinel": "_",
      "sequenceSeparator": "|",
      "contextField": "language",
      "relationName": "HAS_FEATURE",
      "aggregate": true,
      "pairMode": "KeyValueComposition",
      "pairValueSeparator": "="
    },
    {
      "syntaxPath": "token/@head",
      "propertyName": "head",
      "valueKind": "Text",
      "disposition": "Excluded"
    },
    {
      "syntaxPath": "token/@deprel",
      "propertyName": "deprel",
      "valueKind": "Text",
      "disposition": "Excluded"
    },
    {
      "syntaxPath": "token/@deps",
      "propertyName": "deps",
      "valueKind": "Text",
      "disposition": "Excluded"
    },
    {
      "syntaxPath": "token/@misc",
      "propertyName": "misc",
      "valueKind": "Text",
      "disposition": "Excluded"
    },
    {
      "syntaxPath": "token/@group:first",
      "propertyName": "groupFirst",
      "valueKind": "Text",
      "disposition": "Excluded"
    },
    {
      "syntaxPath": "token/@treebank",
      "propertyName": "treebank",
      "valueKind": "Text",
      "disposition": "Excluded"
    }
  ],
  "providerRoutes": [
    {
      "recordName": "token",
      "namespaceUri": "",
      "fieldPrefix": "token",
      "subject": {
        "kind": "ContentField",
        "identityField": "form",
        "entityType": ""
      },
      "structurePaths": [],
      "parseStructure": {
        "trunkField": "group:text",
        "idColumn": "id",
        "formColumn": "form",
        "uposColumn": "upos",
        "headColumn": "head",
        "deprelColumn": "deprel",
        "uposVocabulary": "pos/upos",
        "contextField": "treebank"
      }
    }
  ],
  "delimitedSyntax": {
    "recordName": "token",
    "separator": "\t",
    "commentPrefix": "#",
    "trimFields": false,
    "columns": [
      "id",
      "form",
      "lemma",
      "upos",
      "xpos",
      "feats",
      "head",
      "deprel",
      "deps",
      "misc"
    ],
    "groupBlankLines": true,
    "groupAttributeSeparator": "=",
    "skipKeyColumn": "id",
    "skipKeyCharacters": "-."
  },
  "attributeVocabularies": {
    "language": "lang/iso639"
  }
