@startuml
skinparam backgroundColor #FAFCFF
skinparam shadowing false
skinparam defaultFontName SansSerif
title Refactor ISA — identity_codepoint_batch
start
:Entry after whole-program validation;
if (Exact strides, aligned buffers and count fits size_t?) then (yes)
 :Call laplace_identity_codepoint_batch;
 if (Native status not OK?) then (yes)
  :Return EXECUTION_FAILED;
  stop
 endif
else (no)
 while (More input elements?) is (yes)
  :Copy strided input to local codepoint and ID operand;
  :Call laplace_identity_codepoint;
  if (Native status not OK?) then (yes)
   :Return EXECUTION_FAILED;
   stop
  endif
  :Copy result into strided output;
 endwhile (no)
endif
:Set output.count = input.count;
:Return ISA_OK;
stop
legend
Execute-wrapper source trace.
Validation and native semantic callees are separate boundaries.
No runtime acceptance asserted.
endlegend
@enduml
