-- Evidence-derived consensus reconstruction and unfinished-fold recovery.
--
-- Consensus is derived state: for a touched cell, the authoritative repair is
-- the canonical consensus_fold of every surviving attestation, never replaying
-- the additive delta that may already have committed partially.  The relation
-- helper below is one transaction-safe primitive used by both the operator
-- procedure and the automatic ingest-journal recovery path.

DROP FUNCTION IF EXISTS ops.refold_source_relation(bytea, bytea);
CREATE OR REPLACE FUNCTION ops.refold_source_relation(
    p_source_id bytea,
    p_type_id   bytea)
RETURNS bigint
LANGUAGE plpgsql VOLATILE
AS $$
DECLARE
    rebuilt bigint := 0;
BEGIN
    IF p_source_id IS NULL OR octet_length(p_source_id) <> 16 THEN
        RAISE EXCEPTION 'refold_source_relation: source id must be 16 bytes';
    END IF;
    IF p_type_id IS NULL OR octet_length(p_type_id) <> 16 THEN
        RAISE EXCEPTION 'refold_source_relation: relation id must be 16 bytes';
    END IF;

    -- Literalize the LIST partition key while keeping source identity bound.
    -- The touched-cell set comes only from this source; each touched cell is then
    -- reconstructed from ALL surviving testimony for that relation.
    EXECUTE format($q$
        WITH touched AS MATERIALIZED (
            SELECT DISTINCT a.subject_id, a.object_id
            FROM laplace.attestations a
            WHERE a.source_id = $1
              AND a.type_id = %L::bytea
        ),
        folded AS MATERIALIZED (
            SELECT t.subject_id, t.object_id,
                   laplace.consensus_fold(false, NULL, NULL, NULL,
                       a.opponent_rating_fp1e9,
                       a.opponent_rd_fp1e9,
                       GREATEST(a.observation_count, 1),
                       a.sum_score_fp1e9,
                       consensus.glicko2_tau()
                       ORDER BY a.last_observed_at, a.id) AS acc,
                   max(a.last_observed_at) AS last_ts
            FROM touched t
            JOIN laplace.attestations a
              ON a.type_id = %L::bytea
             AND a.subject_id = t.subject_id
             AND a.object_id IS NOT DISTINCT FROM t.object_id
            GROUP BY t.subject_id, t.object_id
        ),
        upserted AS (
            INSERT INTO laplace.consensus
                (id, subject_id, type_id, object_id,
                 rating, rd, volatility, witness_count, last_observed_at)
            SELECT laplace.consensus_id(f.subject_id, %L::bytea, f.object_id),
                   f.subject_id, %L::bytea, f.object_id,
                   (f.acc).rating, (f.acc).rd, (f.acc).volatility,
                   (f.acc).witness_count, f.last_ts
            FROM folded f
            ON CONFLICT (id, type_id, subject_id) DO UPDATE
            SET object_id        = EXCLUDED.object_id,
                rating           = EXCLUDED.rating,
                rd               = EXCLUDED.rd,
                volatility       = EXCLUDED.volatility,
                witness_count    = EXCLUDED.witness_count,
                last_observed_at = EXCLUDED.last_observed_at
            RETURNING 1
        )
        SELECT count(*) FROM upserted
    $q$, p_type_id, p_type_id, p_type_id, p_type_id)
    USING p_source_id
    INTO rebuilt;

    RETURN COALESCE(rebuilt, 0);
END;
$$;

-- Automatic recovery for one source.  It is intentionally a FUNCTION, not the
-- operator procedure below: one statement/transaction holds the exclusive
-- recovery advisory lock from the first evidence-derived refold through exact
-- highway-mask reconstruction and the final journal acknowledgement.  Normal
-- accumulating writers hold the same lock SHARED for their whole run, so this
-- cannot race an evidence/fold continuation from another process.
DROP FUNCTION IF EXISTS ops.recover_unfolded_source(bytea);
CREATE OR REPLACE FUNCTION ops.recover_unfolded_source(p_source_id bytea)
RETURNS bigint
LANGUAGE plpgsql VOLATILE
AS $$
DECLARE
    rels               bytea[];
    rel                bytea;
    broad_scope        boolean := false;
    ids                bytea[];
    acked              bigint := 0;
    rebuilt            bigint := 0;
    masks              bigint := 0;
BEGIN
    IF p_source_id IS NULL OR octet_length(p_source_id) <> 16 THEN
        RAISE EXCEPTION 'recover_unfolded_source: source id must be 16 bytes';
    END IF;

    -- Cheap no-op path does not contend with active ingest runs.
    IF NOT EXISTS (
        SELECT 1
        FROM laplace.ingest_flush_journal j
        WHERE j.source_id = p_source_id
          AND NOT j.folded
          AND j.fold_recoverable
    ) THEN
        RETURN 0;
    END IF;

    PERFORM pg_advisory_xact_lock(hashtextextended('laplace_fold_recovery', 0));

    -- Recheck after the wait: another recovery may have completed first.
    IF NOT EXISTS (
        SELECT 1
        FROM laplace.ingest_flush_journal j
        WHERE j.source_id = p_source_id
          AND NOT j.folded
          AND j.fold_recoverable
    ) THEN
        RETURN 0;
    END IF;

    SELECT bool_or(j.fold_type_ids IS NULL)
      INTO broad_scope
      FROM laplace.ingest_flush_journal j
     WHERE j.source_id = p_source_id
       AND NOT j.folded
       AND j.fold_recoverable;

    IF broad_scope THEN
        -- A crash between evidence commit and scope publication is still
        -- recoverable; it merely widens repair to every relation this source
        -- has durable testimony under.
        SELECT array_agg(DISTINCT a.type_id ORDER BY a.type_id)
          INTO rels
          FROM laplace.attestations a
         WHERE a.source_id = p_source_id;
    ELSE
        SELECT array_agg(DISTINCT u.type_id ORDER BY u.type_id)
          INTO rels
          FROM laplace.ingest_flush_journal j
          CROSS JOIN LATERAL unnest(j.fold_type_ids) AS u(type_id)
         WHERE j.source_id = p_source_id
           AND NOT j.folded
           AND j.fold_recoverable;
    END IF;

    CREATE TEMP TABLE IF NOT EXISTS _fold_recovery_mask_ids (
        id bytea PRIMARY KEY CHECK (octet_length(id) = 16)
    ) ON COMMIT DELETE ROWS;
    TRUNCATE _fold_recovery_mask_ids;

    IF rels IS NOT NULL THEN
        FOREACH rel IN ARRAY rels LOOP
            rebuilt := rebuilt + ops.refold_source_relation(p_source_id, rel);

            -- The original continuation also deposits highway membership.  A
            -- crashed mask lane is therefore part of the same incomplete token.
            -- Queue the exact subject/object set now and refresh it below from
            -- reconstructed consensus; recompute is idempotent and can clear as
            -- well as set bits, unlike OR-only deposit replay.
            INSERT INTO _fold_recovery_mask_ids(id)
            SELECT a.subject_id
              FROM laplace.attestations a
             WHERE a.source_id = p_source_id
               AND a.type_id = rel
            UNION
            SELECT a.object_id
              FROM laplace.attestations a
             WHERE a.source_id = p_source_id
               AND a.type_id = rel
               AND a.object_id IS NOT NULL
            ON CONFLICT DO NOTHING;
        END LOOP;
    END IF;

    -- Keep the repair's array residency bounded.  The recovery transaction is
    -- exceptional and correctness-first, but it still must not manufacture a
    -- multi-million-id CLR/PostgreSQL array merely because a source is large.
    LOOP
        SELECT array_agg(q.id ORDER BY q.id)
          INTO ids
          FROM (
              SELECT id FROM _fold_recovery_mask_ids ORDER BY id LIMIT 32768
          ) q;
        EXIT WHEN ids IS NULL OR cardinality(ids) = 0;

        masks := masks + consensus.highway_mask_refresh(ids);
        DELETE FROM _fold_recovery_mask_ids WHERE id = ANY(ids);
    END LOOP;

    UPDATE laplace.ingest_flush_journal j
       SET folded = true,
           folded_at = clock_timestamp()
     WHERE j.source_id = p_source_id
       AND NOT j.folded
       AND j.fold_recoverable;
    GET DIAGNOSTICS acked = ROW_COUNT;

    RAISE LOG 'recover_unfolded_source: source % rebuilt % consensus row(s), refreshed % mask row(s), acknowledged % token(s)',
        encode(p_source_id, 'hex'), rebuilt, masks, acked;
    RETURN acked;
END;
$$;

-- Startup repair is opportunistic rather than a concurrency gate.  If another
-- current writer holds the shared recovery guard, return -1 immediately and let
-- both runs proceed.  A truly abandoned journal has no live shared holder, so a
-- later startup acquires the exclusive xact lock and repairs every recoverable
-- source left by the crashed process.
DROP FUNCTION IF EXISTS ops.recover_unfolded_all_quiescent();
CREATE OR REPLACE FUNCTION ops.recover_unfolded_all_quiescent()
RETURNS bigint
LANGUAGE plpgsql VOLATILE
AS $$
DECLARE
    src bytea;
    n bigint;
    total bigint := 0;
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM laplace.ingest_flush_journal
        WHERE NOT folded AND fold_recoverable
    ) THEN
        RETURN 0;
    END IF;

    IF NOT pg_try_advisory_xact_lock(hashtextextended('laplace_fold_recovery', 0)) THEN
        RETURN -1;
    END IF;

    FOR src IN
        SELECT DISTINCT source_id
        FROM laplace.ingest_flush_journal
        WHERE NOT folded
          AND fold_recoverable
          AND source_id IS NOT NULL
        ORDER BY source_id
    LOOP
        n := ops.recover_unfolded_source(src);
        total := total + n;
    END LOOP;
    RETURN total;
END;
$$;

-- Operator-facing source refold, retained as a relation-at-a-time procedure with
-- progress/commit behavior.  It now delegates the actual reconstruction law to
-- the same helper automatic crash recovery uses, so the two paths cannot drift.
DROP PROCEDURE IF EXISTS ops.refold_source(text, boolean);
CREATE OR REPLACE PROCEDURE ops.refold_source(
    p_source_name text,
    p_dry_run     boolean DEFAULT false)
LANGUAGE plpgsql
AS $$
DECLARE
    src          bytea;
    rels         bytea[];
    rel          bytea;
    n_cells      bigint;
    n            bigint;
    refold_total bigint := 0;
    t0           timestamptz := clock_timestamp();
BEGIN
    src := laplace.source_id(p_source_name);
    IF src IS NULL THEN
        RAISE EXCEPTION 'refold_source: unknown source %', p_source_name;
    END IF;

    SELECT array_agg(DISTINCT a.type_id ORDER BY a.type_id)
      INTO rels
      FROM laplace.attestations a
     WHERE a.source_id = src;
    IF rels IS NULL THEN
        RAISE LOG 'refold_source: % has no testimony — nothing to refold', p_source_name;
        RETURN;
    END IF;

    FOREACH rel IN ARRAY rels LOOP
        SELECT count(*) INTO n_cells
        FROM (
            SELECT DISTINCT a.subject_id, a.object_id
            FROM laplace.attestations a
            WHERE a.source_id = src AND a.type_id = rel
        ) q;

        IF p_dry_run THEN
            RAISE LOG 'refold_source: WOULD refold % cell(s) of relation %',
                n_cells, encode(rel, 'hex');
            CONTINUE;
        END IF;

        n := ops.refold_source_relation(src, rel);
        refold_total := refold_total + n;
        RAISE LOG 'refold_source: relation % — % cell(s) touched, % consensus row(s) rebuilt',
            encode(rel, 'hex'), n_cells, n;
        COMMIT;
    END LOOP;

    RAISE LOG 'refold_source: % — % row(s) rebuilt across % relation(s) in %s',
        p_source_name, refold_total, array_length(rels, 1),
        round(extract(epoch FROM clock_timestamp() - t0)::numeric, 1);
END;
$$;
