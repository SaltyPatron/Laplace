#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"

# Data-operation workflows intentionally consume the already-published CLI.
# They do not own a product build, and a source-only checkout should not force
# one merely to invoke the deployed ingestion surface.
native_candidates=(
  "${LAPLACE_CLI_BIN:-}"
  "/opt/laplace/bin/laplace"
)
for candidate in "${native_candidates[@]}"; do
  [[ -n "$candidate" && -x "$candidate" ]] || continue
  [[ "$(readlink -f "$candidate")" != "$SELF" ]] || continue
  export LAPLACE_DB="${LAPLACE_DB:-Host=/var/run/postgresql;Username=laplace_admin;Database=${PGDATABASE:-laplace}}"
  exec "$candidate" "$@"
done

candidates=()
if [[ -n "${LAPLACE_BUILD_ROOT:-}" ]]; then
  candidates+=(
    "$LAPLACE_BUILD_ROOT/app/bin/Laplace.Cli/Release/net10.0/Laplace.Cli.dll"
    "$LAPLACE_BUILD_ROOT/app/bin/Laplace.Cli/Debug/net10.0/Laplace.Cli.dll"
  )
fi
candidates+=(
  "$ROOT/app/Laplace.Cli/bin/Release/net10.0/Laplace.Cli.dll"
  "$ROOT/app/Laplace.Cli/bin/Debug/net10.0/Laplace.Cli.dll"
)

DLL=""
for candidate in "${candidates[@]}"; do
  if [[ -f "$candidate" ]]; then
    DLL="$candidate"
    break
  fi
done

[[ -n "$DLL" ]] || {
  echo "laplace: neither deployed nor checkout CLI is available" >&2
  exit 1
}

export LAPLACE_DB="${LAPLACE_DB:-Host=/var/run/postgresql;Username=laplace_admin;Database=${PGDATABASE:-laplace}}"
exec dotnet "$DLL" "$@"
