-- The forward program's shared read primitives (spec 36). Every surface (explore,
-- matchup, facts, chat) composes these instead of re-walking word -> sense -> facts:
--   converse.bindings   a term's bindings to identifiers (dog -> i46360), per language
--   converse.key_facts  a key's own facts, each with its typed standing
--   converse.couple     how two terms' keys respond to each other, by typed channel
--   converse.respond    the joint response of the web to a whole observation (native)
--   converse.translate  a term's words in another language, through its identifiers
-- Rendering is REALIZE (realize.batch(ids, lang)). A fact belongs to the key it was
-- stated about; a word reaches it only through its binding, so nothing flattens senses.
-- Standing stays typed: rating, deviation, volatility, witnesses. Nothing here folds
-- it into one score or a normalized share; a consumer declares its own ordering.
DROP FUNCTION IF EXISTS converse.key_facts(bytea[], int) CASCADE;
DROP FUNCTION IF EXISTS converse.couple(bytea, bytea, bytea, int) CASCADE;

-- K: the bindings of each term. A binding's language is its attestation context
-- (the lexicon's language), so in_lang says whether a source bound this term to this
-- key in the query's language. games is how often the binding was observed (usage).
CREATE OR REPLACE FUNCTION converse.bindings(p_terms bytea[], p_lang bytea DEFAULT NULL)
    RETURNS TABLE(term bytea, key bytea, in_lang boolean, eff_mu numeric,
                  witnesses bigint, games bigint, rank int)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH b AS MATERIALIZED (
        SELECT c.subject_id AS term, c.object_id AS key, c.type_id, c.rating, c.rd,
               c.witness_count
        FROM laplace.v_consensus_unrefuted c
        WHERE c.subject_id = ANY (p_terms)
          AND c.type_id = ANY (consensus.relation_set_ids('KEY_BINDING'))
          AND c.object_id IS NOT NULL
    ), evidence AS (
        SELECT b.term, b.key, b.rating, b.rd, b.witness_count,
               COALESCE(sum(a.observation_count), 0)::bigint AS games,
               COALESCE(bool_or(a.context_id = p_lang), false) AS in_lang
        FROM b
        LEFT JOIN laplace.attestations a
          ON a.subject_id = b.term AND a.type_id = b.type_id AND a.object_id = b.key
        GROUP BY b.term, b.key, b.rating, b.rd, b.witness_count
    )
    SELECT e.term, e.key, e.in_lang, consensus.eff_mu_display(e.rating, e.rd),
           e.witness_count, e.games,
           row_number() OVER (PARTITION BY e.term
                              ORDER BY e.in_lang DESC, e.games DESC,
                                       consensus.eff_mu(e.rating, e.rd) DESC, e.key)::int
    FROM evidence e;
END;

-- V: each key's own facts with their typed standing, strongest conservative standing
-- first. Bindings and non-salient structure are not facts about the key.
CREATE OR REPLACE FUNCTION converse.key_facts(p_keys bytea[], p_per_key int DEFAULT 24)
    RETURNS TABLE(key bytea, type_id bytea, object_id bytea, eff_mu numeric,
                  witnesses bigint, rating bigint, rd bigint, volatility bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH f AS MATERIALIZED (
        SELECT k.key, c.type_id, c.object_id, c.rating, c.rd, c.volatility, c.witness_count
        FROM (SELECT DISTINCT u AS key FROM unnest(p_keys) u WHERE u IS NOT NULL) k
        CROSS JOIN LATERAL (
            SELECT c.type_id, c.object_id, c.rating, c.rd, c.volatility, c.witness_count
            FROM laplace.v_consensus_unrefuted c
            WHERE c.subject_id = k.key AND c.object_id IS NOT NULL
              AND c.type_id <> ALL (consensus.relation_set_ids('KEY_BINDING'))
              AND c.type_id <> ALL (consensus.relation_set_ids('NON_SALIENT_STRUCTURAL'))
              AND c.type_id = ANY (ARRAY(SELECT r.type_id FROM laplace.relation_registry() r))
            ORDER BY consensus.eff_mu(c.rating, c.rd) DESC, c.type_id, c.object_id
            LIMIT GREATEST(p_per_key, 0)) c
    )
    SELECT f.key, f.type_id, f.object_id, consensus.eff_mu_display(f.rating, f.rd),
           f.witness_count, f.rating, f.rd, f.volatility
    FROM f;
END;

-- How two terms couple, and through which of their keys, by typed channel:
--   usage     a structure (sentence, definition, document) containing both terms
--   fact      the same (relation, object) stated of a key of each
--   ancestor  a shared upward ancestor within four hops of a key of each
-- Each row keeps its channel's own measures: sharing (how many cells state that
-- relation/object or reach that ancestor; a claim nearly everything shares says
-- little) and depth (hops to the ancestor). Rows come back most specific first
-- (least shared, then shallowest); a consumer may declare its own ordering.
CREATE OR REPLACE FUNCTION converse.couple(p_x bytea, p_y bytea, p_lang bytea DEFAULT NULL,
                                          p_k int DEFAULT 12)
    RETURNS TABLE(x_key bytea, y_key bytea, channel text, relation bytea, via bytea,
                  sharing bigint, depth int)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH xk AS MATERIALIZED (
        SELECT b.key FROM converse.bindings(ARRAY[p_x], p_lang) b WHERE b.rank <= 16
        UNION SELECT p_x
    ), yk AS MATERIALIZED (
        SELECT b.key FROM converse.bindings(ARRAY[p_y], p_lang) b WHERE b.rank <= 16
        UNION SELECT p_y
    ), usage AS (
        SELECT p_x AS x_key, p_y AS y_key, 'usage'::text AS channel, NULL::bytea AS relation,
               cx.entity_id AS via, 1::bigint AS sharing, 0 AS depth
        FROM structural.containers_of(p_x, 1, 4096) cx
        JOIN structural.containers_of(p_y, 1, 4096) cy USING (entity_id)
    ), xf AS MATERIALIZED (
        SELECT f.key, f.type_id, f.object_id FROM converse.key_facts(ARRAY(SELECT key FROM xk), 64) f
    ), yf AS MATERIALIZED (
        SELECT f.key, f.type_id, f.object_id FROM converse.key_facts(ARRAY(SELECT key FROM yk), 64) f
    ), shared_fact AS (
        SELECT xf.key AS x_key, yf.key AS y_key, 'fact'::text AS channel, xf.type_id AS relation,
               xf.object_id AS via,
               (SELECT count(*) FROM (
                   SELECT 1 FROM laplace.consensus c
                   WHERE c.object_id = xf.object_id AND c.type_id = xf.type_id LIMIT 100000) n) AS sharing,
               0 AS depth
        FROM xf JOIN yf ON yf.type_id = xf.type_id AND yf.object_id = xf.object_id
    ), up AS (
        WITH RECURSIVE walk(root, side, node, depth) AS (
            SELECT key, 'x', key, 0 FROM xk
            UNION ALL SELECT key, 'y', key, 0 FROM yk
            UNION
            SELECT w.root, w.side, c.object_id, w.depth + 1
            FROM walk w
            JOIN laplace.v_consensus_unrefuted c
              ON c.subject_id = w.node
             AND c.type_id = ANY (consensus.relation_set_ids('PATH_UPWARD'))
            WHERE w.depth < 4 AND c.object_id IS NOT NULL
        )
        SELECT root, side, node, min(depth) AS depth FROM walk WHERE depth > 0
        GROUP BY root, side, node
    ), shared_ancestor AS (
        SELECT ux.root AS x_key, uy.root AS y_key, 'ancestor'::text AS channel,
               NULL::bytea AS relation, ux.node AS via,
               (SELECT count(*) FROM (
                   SELECT 1 FROM laplace.consensus c
                   WHERE c.object_id = ux.node
                     AND c.type_id = ANY (consensus.relation_set_ids('PATH_UPWARD'))
                   LIMIT 100000) n) AS sharing,
               (ux.depth + uy.depth)::int AS depth
        FROM up ux JOIN up uy ON uy.node = ux.node AND uy.side = 'y'
        WHERE ux.side = 'x'
    ), all_evidence AS (
        SELECT * FROM usage UNION ALL SELECT * FROM shared_fact UNION ALL SELECT * FROM shared_ancestor
    )
    SELECT e.x_key, e.y_key, e.channel, e.relation, e.via, e.sharing, e.depth
    FROM all_evidence e
    ORDER BY e.sharing, e.depth, e.channel, e.via
    LIMIT GREATEST(p_k, 0);
END;

-- Q's language when the caller did not state one: the language the terms' bindings
-- were attested in most often. NULL when no binding carries a language.
CREATE OR REPLACE FUNCTION converse.terms_language(p_terms bytea[])
    RETURNS bytea
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT a.context_id
    FROM laplace.attestations a
    WHERE a.subject_id = ANY (p_terms)
      AND a.type_id = ANY (consensus.relation_set_ids('KEY_BINDING'))
      AND a.context_id IS NOT NULL
    GROUP BY a.context_id
    ORDER BY sum(a.observation_count) DESC, a.context_id
    LIMIT 1;
END;

-- The joint response of the web to a whole observation (native; spec 36 COUPLE). Every
-- term is tugged at once through its bindings and answered outward as an indexed star,
-- hop by hop; a candidate reached from every term, each by its own typed route, is the
-- interpretation the observation supports, so which sense of each term was meant falls
-- out of the meeting instead of being elected first. hops, fanout (per frontier node;
-- deeper hops use an eighth) and frontier (per hop) are the compute envelope. One row
-- per (candidate, term) route: the key it left from, its hop count, the relation of its
-- last step and the node it came through, the last step's typed standing, and the
-- weakest salience and weakest conservative standing along the path. Candidates are
-- ordered by terms answered, least salient route, fewest hops, then weakest standing.
-- p_min_salience is ROUTE's traversal envelope: relations below it (lexical glue such as
-- HAS_POS, scalar values, standards metadata) classify rather than connect, and are not
-- walked through.
CREATE OR REPLACE FUNCTION converse.respond(p_terms bytea[], p_hops int DEFAULT 2,
        p_fanout int DEFAULT 256, p_frontier int DEFAULT 4096, p_limit int DEFAULT 24,
        p_min_salience double precision DEFAULT 0.3)
    RETURNS TABLE(candidate bytea, covered int, term_ordinal int, term bytea, key bytea,
                  hops int, relation bytea, via bytea, outbound boolean,
                  rating bigint, rd bigint, volatility bigint, witnesses bigint,
                  salience double precision, weakest_standing bigint)
    AS 'EXECUTION_LIBRARY', 'pg_laplace_forward_respond'
    LANGUAGE C STABLE PARALLEL RESTRICTED
    ROWS 64;

-- A term's words in another language, through the identifiers it binds: bubble up from
-- the term to each identifier its bindings name in the source language, switch the
-- language, and come down every binding of that identifier in the target language
-- (dog -> i46360 -> Hund). Both legs keep their typed standing; a binding's language is
-- its attestation context (the witnessing lexicon's language).
CREATE OR REPLACE FUNCTION converse.translate(p_term bytea, p_to bytea, p_from bytea DEFAULT NULL)
    RETURNS TABLE(key bytea, target bytea,
                  up_rating bigint, up_rd bigint, up_witnesses bigint,
                  down_rating bigint, down_rd bigint, down_witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH kb AS (
        SELECT consensus.relation_set_ids('KEY_BINDING') AS ids
    ), up AS MATERIALIZED (
        SELECT DISTINCT a.object_id AS key, a.type_id
        FROM laplace.attestations a, kb
        WHERE a.subject_id = p_term
          AND a.type_id = ANY (kb.ids)
          AND a.object_id IS NOT NULL
          AND (p_from IS NULL OR a.context_id = p_from)
    ), down AS MATERIALIZED (
        SELECT DISTINCT up.key, a.subject_id AS target, a.type_id
        FROM up
        JOIN laplace.attestations a
          ON a.object_id = up.key AND a.type_id = up.type_id AND a.context_id = p_to
        WHERE a.subject_id <> p_term
    )
    SELECT d.key, d.target, cu.rating, cu.rd, cu.witness_count,
           cd.rating, cd.rd, cd.witness_count
    FROM down d
    JOIN laplace.consensus cd
      ON cd.subject_id = d.target AND cd.type_id = d.type_id AND cd.object_id = d.key
    JOIN laplace.consensus cu
      ON cu.subject_id = p_term AND cu.type_id = d.type_id AND cu.object_id = d.key
    ORDER BY (cd.rating - 2 * cd.rd) DESC, d.key, d.target;
END;

-- converse.firmware(name): a governed personality firmware image (spec 39) with its
-- content id. SQL orchestration reads policy from here, never from literals.
CREATE OR REPLACE FUNCTION converse.firmware(p_name text DEFAULT NULL,
    OUT firmware_id bytea, OUT name text, OUT salience_floor float8,
    OUT semantic_hops int, OUT fanout int, OUT meeting_hops int, OUT meeting_fanout int,
    OUT meeting_frontier int, OUT sharing_window int, OUT sharing_cap int,
    OUT spread float8, OUT top_k int, OUT steps int, OUT max_stride int, OUT version int)
    AS 'EXECUTION_LIBRARY', 'pg_laplace_firmware'
    LANGUAGE C IMMUTABLE PARALLEL SAFE;

-- converse.content_terms(words): the words of an observation that bind to a key and
-- whose strongest witnessed universal part of speech is a content tag.
CREATE OR REPLACE FUNCTION converse.content_terms(p_words bytea[])
    RETURNS bytea[]
    AS 'EXECUTION_LIBRARY', 'pg_laplace_content_terms'
    LANGUAGE C STABLE STRICT PARALLEL SAFE;

-- converse.answer(prompt, lang): an open turn's answer is the joint meeting of its
-- content terms (converse.respond), realized in the asked language. One term asks
-- what the term is; several ask what answers all of them.
CREATE OR REPLACE FUNCTION converse.answer(p_prompt text, p_lang bytea DEFAULT NULL)
    RETURNS text
    LANGUAGE sql VOLATILE
BEGIN ATOMIC
    WITH terms AS MATERIALIZED (
        SELECT converse.content_terms(array_agg(w.id ORDER BY w.ord)) AS ids
        FROM converse.prompt_words(p_prompt) w
    ), met AS MATERIALIZED (
        SELECT r.candidate
        FROM terms t, converse.firmware() f,
             converse.respond(t.ids, f.meeting_hops, f.meeting_fanout, f.meeting_frontier, 1,
                              f.salience_floor) r
        WHERE cardinality(t.ids) > 0
        LIMIT 1
    )
    SELECT (realize.forward_text_batch(
                ARRAY[m.candidate],
                COALESCE(p_lang, converse.prompt_language_top(p_prompt))))[1]
    FROM met m;
END;
