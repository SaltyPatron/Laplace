-- BEGIN ATOMIC: GH #764.
-- Census lives in ops (purpose), not the product/extension dump schema.

CREATE OR REPLACE FUNCTION ops.substrate_counts()
    RETURNS TABLE(metric text, value bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    -- Planner estimates (pg_class.reltuples), NOT count(*). Full scans on 100M+ unvacuumed
    -- tables hung every ingest tail; these numbers are directionally correct post-ingest.
    -- Run ANALYZE for exact counts, or ops.evidence_count()/source_id() for source precision.
    -- Metric keys are relation roles (entities/…); oids name current storage homes until
    -- the table cut. No install-time schema placeholder, no SET, no Brand.table metric labels.
    SELECT 'entities(ESTIMATE)',      GREATEST(0, (SELECT reltuples FROM pg_class WHERE oid = 'laplace.entities'::regclass))::bigint
    UNION ALL
    SELECT 'physicalities(ESTIMATE)', GREATEST(0, (SELECT reltuples FROM pg_class WHERE oid = 'laplace.physicalities'::regclass))::bigint
    UNION ALL
    SELECT 'attestations(ESTIMATE)',  GREATEST(0, (SELECT reltuples FROM pg_class WHERE oid = 'laplace.attestations'::regclass))::bigint
    UNION ALL
    SELECT 'consensus(ESTIMATE)',     GREATEST(0, (SELECT reltuples FROM pg_class WHERE oid = 'laplace.consensus'::regclass))::bigint;
END;
