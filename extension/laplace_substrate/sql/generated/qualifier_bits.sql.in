-- GENERATED by scripts/codegen-attestation-law.py - do not edit.
-- Claim qualifiers (engine/manifest/qualifiers.toml): family/value -> bit of an
-- attestation's qualifier_mask (32 bytes, bit b = get_bit(mask, b)).
CREATE OR REPLACE FUNCTION laplace.qualifier_bit(p_family text, p_value text)
    RETURNS integer
    LANGUAGE plpgsql IMMUTABLE STRICT PARALLEL SAFE AS $q$
DECLARE
    v_bit integer := CASE p_family || '/' || p_value
        WHEN 'identifier/iso639-1' THEN 0
        WHEN 'identifier/iso639-2b' THEN 1
        WHEN 'identifier/iso639-2t' THEN 2
        WHEN 'identifier/iso639-3' THEN 3
        WHEN 'identifier/bcp47' THEN 4
        WHEN 'identifier/ili' THEN 5
        WHEN 'identifier/pwn30-offset' THEN 6
        WHEN 'identifier/pwn31-offset' THEN 7
        WHEN 'identifier/wordnet-sense-key' THEN 8
        WHEN 'identifier/wordnet-synset-key' THEN 9
        WHEN 'identifier/pwn15-offset' THEN 10
        WHEN 'identifier/pwn16-offset' THEN 11
        WHEN 'identifier/pwn17-offset' THEN 12
        WHEN 'identifier/pwn171-offset' THEN 13
        WHEN 'identifier/pwn20-offset' THEN 14
        WHEN 'identifier/pwn21-offset' THEN 15
        WHEN 'identifier/odwn13-synset' THEN 16
        WHEN 'name/primary' THEN 32
        WHEN 'name/alias' THEN 33
        WHEN 'name/reference' THEN 34
        WHEN 'name/print' THEN 35
        WHEN 'name/inverted' THEN 36
        WHEN 'name/abbreviation' THEN 37
        WHEN 'name/correction' THEN 38
        WHEN 'name/control' THEN 39
        WHEN 'name/alternate' THEN 40
        WHEN 'name/figment' THEN 41
        WHEN 'name/unicode-1' THEN 42
        WHEN 'mapping/lower' THEN 64
        WHEN 'mapping/upper' THEN 65
        WHEN 'mapping/title' THEN 66
        WHEN 'mapping/fold' THEN 67
        WHEN 'mapping/simple' THEN 68
        WHEN 'mapping/full' THEN 69
        WHEN 'mapping/nfkc' THEN 70
        WHEN 'mapping/nfc' THEN 71
        WHEN 'mapping/nfd' THEN 72
        WHEN 'mapping/nfkd' THEN 73
        WHEN 'mapping/ToUnicode' THEN 74
        WHEN 'mapping/ToASCII' THEN 75
        WHEN 'mapping/Transitional_Processing' THEN 76
        WHEN 'decomposition/Canonical' THEN 96
        WHEN 'decomposition/Compat' THEN 97
        WHEN 'decomposition/Circle' THEN 98
        WHEN 'decomposition/Final' THEN 99
        WHEN 'decomposition/Font' THEN 100
        WHEN 'decomposition/Fraction' THEN 101
        WHEN 'decomposition/Initial' THEN 102
        WHEN 'decomposition/Isolated' THEN 103
        WHEN 'decomposition/Medial' THEN 104
        WHEN 'decomposition/Narrow' THEN 105
        WHEN 'decomposition/Nobreak' THEN 106
        WHEN 'decomposition/Small' THEN 107
        WHEN 'decomposition/Square' THEN 108
        WHEN 'decomposition/Sub' THEN 109
        WHEN 'decomposition/Super' THEN 110
        WHEN 'decomposition/Vertical' THEN 111
        WHEN 'decomposition/Wide' THEN 112
        WHEN 'decomposition/sort' THEN 113
        WHEN 'decomposition/circlekata' THEN 114
        WHEN 'decomposition/smallnarrow' THEN 115
        WHEN 'retirement/change' THEN 128
        WHEN 'retirement/duplicate' THEN 129
        WHEN 'retirement/non-existent' THEN 130
        WHEN 'retirement/split' THEN 131
        WHEN 'retirement/merge' THEN 132
        WHEN 'membership/active' THEN 160
        WHEN 'membership/retired' THEN 161
        WHEN 'derivation/calculation' THEN 192
        WHEN 'meronymy/part' THEN 0
        WHEN 'meronymy/member' THEN 1
        WHEN 'meronymy/substance' THEN 2
        WHEN 'etymology/borrowed' THEN 0
        WHEN 'etymology/inherited' THEN 1
        WHEN 'etymology/affix' THEN 2
        WHEN 'etymology/prefix' THEN 3
        WHEN 'etymology/suffix' THEN 4
        WHEN 'etymology/compound' THEN 5
        WHEN 'etymology/blend' THEN 6
        WHEN 'etymology/back-formation' THEN 7
        WHEN 'subevent/first' THEN 0
        WHEN 'subevent/last' THEN 1
        WHEN 'character_property/default' THEN 0
        WHEN 'domain/topic' THEN 0
        WHEN 'domain/region' THEN 1
        WHEN 'domain/usage' THEN 2
        WHEN 'participant/agent' THEN 0
        WHEN 'participant/others' THEN 1
        WHEN 'variant/semantic' THEN 0
        WHEN 'variant/compatibility' THEN 1
        WHEN 'variant/simplified' THEN 2
        WHEN 'variant/traditional' THEN 3
        WHEN 'variant/specialized-semantic' THEN 4
        WHEN 'variant/spoofing' THEN 5
        WHEN 'variant/z' THEN 6
        WHEN 'side/white' THEN 0
        WHEN 'side/black' THEN 1
    END;
BEGIN
    IF v_bit IS NULL THEN
        RAISE EXCEPTION 'undeclared claim qualifier %/%', p_family, p_value
            USING HINT = 'engine/manifest/qualifiers.toml';
    END IF;
    RETURN v_bit;
END
$q$;

-- Whether a claim states that qualifier; a NULL mask states none.
CREATE OR REPLACE FUNCTION laplace.has_qualifier(p_mask bytea, p_family text, p_value text)
    RETURNS boolean
    LANGUAGE sql IMMUTABLE PARALLEL SAFE AS $q$
    SELECT p_mask IS NOT NULL
       AND get_bit(p_mask, laplace.qualifier_bit(p_family, p_value)) = 1
$q$;
