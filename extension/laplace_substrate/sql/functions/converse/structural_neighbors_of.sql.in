-- Entity-id keyed structural KNN with S³ coords (explore glome overlay).
-- Unlike structural.neighbors(text), does not re-resolve via prompt_state.
--
-- Shape axis: Frechet over REALIZED curves (public.laplace_curves), never packed
-- laplace.physicalities.trajectory (Rule #3 / Issue 51).
-- GH #862 / #860: structural.neighbors_of, no SET, real schema names.
CREATE OR REPLACE FUNCTION structural.neighbors_of(
    p_id bytea,
    p_k  integer DEFAULT 10)
    RETURNS TABLE(
        neighbor_id bytea,
        neighbor    text,
        x           double precision,
        y           double precision,
        z           double precision,
        m           double precision,
        radius      double precision,
        geodesic    double precision,
        frechet     double precision)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH anchor AS MATERIALIZED (
        SELECT e.coord,c.curve
        FROM public.laplace_entities(ARRAY[public.blake3_from_bytea(p_id)]) e
        LEFT JOIN LATERAL (SELECT k.entity AS id,public.ST_GeomFromEWKB(k.curve_ewkb) AS curve FROM public.laplace_curves(ARRAY[e.id]) k) c ON true
    ), nearest AS MATERIALIZED (
        SELECT n.* FROM anchor a CROSS JOIN LATERAL
            structural.angular_nearest(a.coord,p_k,NULL,p_id) n
    ), labels AS MATERIALIZED (
        SELECT * FROM public.laplace_labels(ARRAY(SELECT public.blake3_from_bytea(entity_id) FROM nearest ORDER BY entity_id))
    ), curves AS MATERIALIZED (
        SELECT c.entity AS id,public.ST_GeomFromEWKB(c.curve_ewkb) AS curve FROM public.laplace_curves(ARRAY(SELECT public.blake3_from_bytea(entity_id) FROM nearest ORDER BY entity_id)) c
    )
    SELECT n.entity_id,coalesce(l.content,'Unrealized entity'),
           public.ST_X(n.coord),public.ST_Y(n.coord),public.ST_Z(n.coord),public.ST_M(n.coord),
           public.laplace_radius_origin(n.coord),n.distance,
           public.laplace_frechet_4d(cv.curve,a.curve)
    FROM nearest n CROSS JOIN anchor a LEFT JOIN labels l ON l.entity=public.blake3_from_bytea(n.entity_id)
    LEFT JOIN curves cv ON cv.id=public.blake3_from_bytea(n.entity_id)
    ORDER BY n.distance,n.entity_id;
END;
