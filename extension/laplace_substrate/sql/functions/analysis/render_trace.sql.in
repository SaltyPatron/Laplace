-- ops.render_trace: why realize.render_text(id) returned NULL. REALIZE
-- assembles a composition from its constituents and abstains (NULL, up to the
-- root) if any child fails to resolve: rendering the rest would manufacture
-- content under a valid hash. This walks the constituent closure of one entity
-- and gives each child a verdict: orphan (no entities row), composed (renders
-- by recursion), codepoint, or unrenderable.
--
-- realize.codepoint_for_id is the costly call, so it runs only on rows the
-- entity join left undecided; labels realize through one
-- converse.label_or_hex_batch. Codepoints print via to_hex alone: no case
-- folding on the read path. Internal aliases avoid the RETURNS TABLE names,
-- which are OUT parameters in scope over an atomic body.
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.render_trace(bytea, integer, boolean)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(parent_id bytea, ordinal integer, child_id bytea, tier smallint, label text, verdict text)'
             OR proargnames IS DISTINCT FROM ARRAY['p_entity','p_max_depth','p_failures_only','parent_id','ordinal','child_id','tier','label','verdict']::text[])) THEN
        DROP FUNCTION ops.render_trace(bytea, integer, boolean);
    END IF;
END $upgrade_shape$;
CREATE OR REPLACE FUNCTION ops.render_trace(
    p_entity        bytea,
    p_max_depth     integer DEFAULT 32,
    p_failures_only boolean DEFAULT true
)
RETURNS TABLE(
    parent_id  bytea,
    ordinal    integer,
    child_id   bytea,
    tier       smallint,
    label      text,
    verdict    text
)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH clo AS (
        SELECT c.parent_id AS pid, c.ordinal AS ord, c.child_id AS cid
        FROM realize.constituents_closure(ARRAY[p_entity], p_max_depth) c
    ),
    -- Cheap pass first: an id with no entities row is an orphan and needs no
    -- further probing. An id that carries a trajectory renders by recursion.
    cheap AS (
        SELECT clo.pid, clo.ord, clo.cid, e.tier AS etier,
               (e.id IS NOT NULL) AS has_entity,
               EXISTS (SELECT 1 FROM laplace.v_word_points w
                       WHERE w.id = clo.cid AND w.trajectory IS NOT NULL) AS has_traj
        FROM clo
        LEFT JOIN laplace.entities e ON e.id = clo.cid
    ),
    -- codepoint_for_id only for rows still undecided: real entity, no trajectory.
    resolved AS (
        SELECT cheap.pid, cheap.ord, cheap.cid, cheap.etier,
               cheap.has_entity, cheap.has_traj,
               CASE WHEN cheap.has_entity AND NOT cheap.has_traj
                    THEN realize.codepoint_for_id(cheap.cid)
               END AS cp
        FROM cheap
    ),
    verdicted AS (
        SELECT r.pid, r.ord, r.cid, r.etier,
               CASE
                 WHEN NOT r.has_entity
                   THEN 'ORPHAN: physicality exists, no laplace.entities row'::text
                 WHEN r.has_traj
                   THEN 'ok: composed, renders by recursion'::text
                 WHEN r.cp IS NOT NULL
                   THEN ('ok: codepoint U+' || lpad(to_hex(r.cp), 4, '0'))::text
                 ELSE 'UNRENDERABLE: entity exists, no trajectory, no codepoint'::text
               END AS vd
        FROM resolved r
    ),
    kept AS (
        SELECT verdicted.pid, verdicted.ord, verdicted.cid,
               verdicted.etier, verdicted.vd
        FROM verdicted
        WHERE NOT p_failures_only OR verdicted.vd NOT LIKE 'ok:%'
    ),
    -- One batched label call over the surviving ids, joined back positionally.
    bag AS (
        SELECT array_agg(DISTINCT kept.cid) AS arr FROM kept
    ),
    labs AS (
        SELECT u.id AS lid, (l.res)[u.n] AS lbl
        FROM bag
        CROSS JOIN LATERAL (SELECT converse.label_or_hex_batch(bag.arr) AS res) l
        CROSS JOIN LATERAL unnest(bag.arr) WITH ORDINALITY AS u(id, n)
        WHERE bag.arr IS NOT NULL
    )
    SELECT kept.pid, kept.ord, kept.cid, kept.etier, labs.lbl, kept.vd
    FROM kept LEFT JOIN labs ON labs.lid = kept.cid
    ORDER BY kept.pid, kept.ord;
END;

-- The comment text avoids spelling the scalar realizer name with an open
-- paren: RenderBeforeSelectGateTests scans string literals as code.
COMMENT ON FUNCTION ops.render_trace(bytea, integer, boolean) IS
    'Why a render of this entity came back NULL: the constituent closure with a '
    'per-child verdict. Non-empty with p_failures_only means assembly aborted on '
    'those rows and discarded everything already accumulated.';
