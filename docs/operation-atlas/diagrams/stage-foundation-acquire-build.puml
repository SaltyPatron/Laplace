@startuml
!pragma layout smetana
skinparam backgroundColor #FAFCFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #385978
skinparam componentBackgroundColor #E6EFF7
skinparam classBackgroundColor #E6EFF7
title foundation.acquire-build — declared input/output contract
component "foundation.acquire-build" as operation
rectangle "upstream source" as in0
in0 --> operation
rectangle "release archives" as in1
in1 --> operation
rectangle "standards data" as in2
in2 --> operation
rectangle "models and corpora" as in3
in3 --> operation
rectangle "licenses" as in4
in4 --> operation
rectangle "declared build toolchains" as in5
in5 --> operation
rectangle "verified source generations" as out0
operation --> out0
rectangle "staged dependency packages" as out1
operation --> out1
rectangle "source data and model manifests" as out2
operation --> out2
rectangle "build receipts" as out3
operation --> out3
@enduml
