-- THE walk responder. recall_walk_response's walk_reply branch used to carry a
-- byte-for-byte second copy of this body (GH #906 item 1) -- same walk_strongest
-- call, same arrow realize.render, same min(consensus.eff_mu) -- differing only in depth and in how
-- the arrow character was spelled (E'→' against a literal). Two maintained
-- copies of one realize.render; the depth is now the parameter that separated them.
--
-- The realize.render itself goes through realize.path(GH #906 item 2) instead of a third
-- hand-rolled arrow join. walk_strongest walks forward, so every direction is 1.
DROP FUNCTION IF EXISTS laplace.recall_fallback_walk(bytea, int);
CREATE OR REPLACE FUNCTION converse.recall_fallback_walk(p_topic bytea, p_depth int DEFAULT 6)
    RETURNS TABLE(reply text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT realize.path(
               p_topic || array_agg(g.entity_id ORDER BY g.step),
               array_agg(g.type_id ORDER BY g.step),
               array_fill(1, ARRAY[count(*)::int]),
               converse.word_language(p_topic)),
           min(g.eff_mu),
           NULL::bigint
    FROM consensus.walk_strongest(p_topic, NULL::bytea, p_depth) g
    HAVING count(*) > 0;
END;
