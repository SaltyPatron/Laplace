-- structural.locale — GH #862 / #860. No SET, real schema names.
DROP FUNCTION IF EXISTS laplace.structural_locale(text, double precision);
CREATE OR REPLACE FUNCTION structural.locale(p_word text, p_near double precision DEFAULT 0.05)
    RETURNS TABLE(nearest double precision, within_near bigint,
                  within_2x bigint, within_5x bigint, isolated boolean)
    LANGUAGE plpgsql STABLE AS $sl$
DECLARE
    v_id    bytea;
    v_coord geometry;
BEGIN
    SELECT w.id, w.coord INTO v_id, v_coord
    FROM laplace.v_word_points w
    JOIN converse.prompt_state(p_word) s ON w.id = s.id
    WHERE w.coord IS NOT NULL
    ORDER BY s.ord, w.physicality_id
    LIMIT 1;
    IF v_id IS NULL THEN RETURN; END IF;

    RETURN QUERY
    WITH cand AS (
        SELECT w.id AS entity_id, w.coord
        FROM laplace.v_word_points w
        WHERE w.coord IS NOT NULL
        ORDER BY w.coord <<->> v_coord
        LIMIT 3000),
    g AS (
        SELECT DISTINCT ON (c.entity_id) c.entity_id,
               public.laplace_angular_distance_4d(c.coord, v_coord) AS d
        FROM cand c
        WHERE c.entity_id <> v_id
        ORDER BY c.entity_id, public.laplace_angular_distance_4d(c.coord, v_coord))
    SELECT min(d),
           count(*) FILTER (WHERE d <= p_near),
           count(*) FILTER (WHERE d <= 2 * p_near),
           count(*) FILTER (WHERE d <= 5 * p_near),
           COALESCE(min(d) > p_near, true)
    FROM g;
END;
$sl$;
