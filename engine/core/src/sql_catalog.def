SQL_QUERY("owner.provision", "uuid,text,text,text,text,uuid,text,text,text,timestamptz",
    "WITH person AS (INSERT INTO app.users(user_id,display_name,email) VALUES($1,$2,$3) RETURNING user_id), "
    "workspace AS (INSERT INTO app.tenants(tenant_id,display_name,kind) VALUES($4,$5,'personal') RETURNING tenant_id), "
    "binding AS (INSERT INTO app.external_identities(identity_id,user_id,provider,issuer,subject,email,last_login_at) "
    "SELECT $6,user_id,$7,$8,$9,$3,$10 FROM person RETURNING user_id) "
