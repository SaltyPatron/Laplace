-- consensus.gaps — GH #862 / #860. No SET (it invalidates plan caching and blocks
-- inlining), real schema names, no build-time placeholder.
--
-- The arenas a word and its senses hold no unrefuted claim in. The claims are read
-- through the shared edge reader (Native claims, the legacy cells only where none
-- exist), whose type_id is the canonical relation a claim's surface form declares.
--
-- A SYMMETRIC ARENA IS NOT A GAP WHEN THE EVIDENCE SITS ON THE OTHER END.
-- IS_ANTONYM_OF, IS_SIMILAR_TO and DERIVATIONALLY_RELATED are symmetric: a claim
-- held at the other endpoint is the same evidence, so an inbound edge counts for
-- them. Asymmetric arenas keep the forward-only semantics -- IS_A up is not IS_A
-- down. Spec 05: absence of a row is UNKNOWN, and this function's whole output is
-- a claim about absence, so a false negative here is the one failure it cannot afford.
CREATE OR REPLACE FUNCTION consensus.gaps(p_word bytea)
    RETURNS TABLE(missing_arena text)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH subj(id) AS (
        SELECT p_word WHERE p_word IS NOT NULL
        UNION
        SELECT sn.synset_id FROM lexical.senses(p_word) sn WHERE p_word IS NOT NULL
    ), expected(name) AS (SELECT unnest(ARRAY[
        'IS_A','HAS_PART','CAUSES','USED_FOR','IS_ANTONYM_OF',
        'IS_SIMILAR_TO','HAS_ATTRIBUTE','DERIVATIONALLY_RELATED']))
    , held AS MATERIALIZED (
        SELECT DISTINCT e.direction, e.type_id
        FROM consensus.edges_raw_batch(
                 ARRAY(SELECT id FROM subj), 'both',
                 ARRAY(SELECT laplace.relation_type_id(x.name) FROM expected x),
                 NULL, false, 'eff_mu') e
    )
    SELECT e.name FROM expected e
    WHERE p_word IS NOT NULL
      AND NOT EXISTS (
        SELECT 1 FROM held h
        WHERE h.type_id = laplace.relation_type_id(e.name)
          AND (h.direction = 'out'
               OR COALESCE(consensus.relation_is_symmetric(
                               laplace.relation_type_id(e.name)), false)));
END;
