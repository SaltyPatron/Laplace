-- lexical.lexical_peers[_batch] — GH #862 / #860.  The batch function owns the
-- semantic body; the scalar is a one-element adapter.  One row per input keeps
-- duplicate inputs and their order while still letting callers unnest each peer
-- set after one database call.
DROP FUNCTION IF EXISTS laplace.lexical_peers(bytea);
CREATE OR REPLACE FUNCTION lexical.lexical_peers_batch(p_words bytea[])
    RETURNS TABLE(input_ordinal bigint, word_id bytea, peers bytea[])
    AS 'MODULE_PATHNAME', 'pg_laplace_lexical_peers_batch'
    LANGUAGE C STABLE STRICT PARALLEL SAFE;

CREATE OR REPLACE FUNCTION lexical.lexical_peers(p_word bytea)
    RETURNS bytea[]
    LANGUAGE sql STABLE STRICT PARALLEL SAFE
BEGIN ATOMIC
    SELECT b.peers
    FROM lexical.lexical_peers_batch(ARRAY[p_word]) b
    WHERE b.input_ordinal = 1;
END;
