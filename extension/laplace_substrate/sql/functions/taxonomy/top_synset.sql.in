CREATE OR REPLACE FUNCTION top_synset(p_word bytea)
    RETURNS bytea
    LANGUAGE sql STABLE STRICT PARALLEL SAFE
    SET search_path = @extschema@, public AS $$
    -- p_k = 1 IS the cap, and bubble_up ranks before it cuts. The LIMIT 1 that used
    -- to sit here added nothing and read as a safeguard over an unordered pick,
    -- which is the opposite of what this call does.
    SELECT b.synset_id
    FROM bubble_up(p_word, NULL::bytea[], 1) b
$$;
