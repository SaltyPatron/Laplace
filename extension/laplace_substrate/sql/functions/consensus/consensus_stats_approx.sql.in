DROP FUNCTION IF EXISTS laplace.consensus_stats_approx();
CREATE OR REPLACE FUNCTION consensus.stats_approx()
    RETURNS TABLE(evidence_rows bigint, consensus_rows bigint, dedup_ratio numeric,
                  avg_witnesses numeric, max_witnesses bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    WITH est AS (
        SELECT c.relname,
               GREATEST(c.reltuples, 0)::bigint AS est_rows
        FROM pg_class c
        JOIN pg_namespace n ON n.oid = c.relnamespace
        -- SCHEMA-QUALIFIED, never current_schema(). Under the deployed search_path
        -- ("$user", public) current_schema() is public, so this looked for
        -- attestations/consensus there, found neither, and returned a row of ALL
        -- NULLS in 1.8ms -- fast enough to pass a timing sweep while answering
        -- nothing. The only current_schema() call in the function surface.
        WHERE n.nspname = '@extschema@'
          AND c.relname IN ('attestations', 'consensus')
    )
    SELECT (SELECT est_rows FROM est WHERE relname = 'attestations'),
           (SELECT est_rows FROM est WHERE relname = 'consensus'),
           round((SELECT est_rows FROM est WHERE relname = 'attestations')::numeric
                 / NULLIF((SELECT est_rows FROM est WHERE relname = 'consensus'), 0), 3),
           NULL::numeric,
           NULL::bigint;
END;
