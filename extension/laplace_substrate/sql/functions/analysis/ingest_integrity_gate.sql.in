-- Referential integrity of the physical face: every physicality must reference
-- a retained entity. Entity and physicality counts neither prove nor quantify
-- a missing reference, so the offending rows themselves are returned. p_since
-- filters the physicality's observed_at, not an ingest run.
CREATE OR REPLACE FUNCTION ops.ingest_integrity_gate(p_since timestamptz DEFAULT NULL)
RETURNS TABLE(physicality_id bytea,
              entity_id     bytea,
              observed_at   timestamptz)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT p.id, p.entity_id, p.observed_at
    FROM laplace.physicalities p
    WHERE NOT EXISTS (SELECT 1 FROM laplace.entities e WHERE e.id = p.entity_id)
      AND (p_since IS NULL OR p.observed_at >= p_since);
END;

COMMENT ON FUNCTION ops.ingest_integrity_gate(timestamptz) IS
    'Actual physicalities whose entity_id is absent from entities. Returns '
    'physicality_id, entity_id and observed_at; since filters observation time, '
    'not an ingest run. Entity/physicality count differences are not orphans.';


-- Count the same exact missing-reference set; keep one integrity predicate.
CREATE OR REPLACE FUNCTION ops.orphan_physicality_count()
RETURNS bigint
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT count(*) FROM ops.ingest_integrity_gate();
END;

COMMENT ON FUNCTION ops.orphan_physicality_count() IS
    'Count of actual physicalities whose entity_id has no entities row. Must be 0.';
