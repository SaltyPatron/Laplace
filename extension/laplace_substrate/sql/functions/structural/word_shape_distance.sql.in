CREATE OR REPLACE FUNCTION structural.word_shape_distance(p_a text, p_b text) RETURNS double precision
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT public.laplace_frechet_4d(structural.word_curve(public.blake3_send(public.laplace_text_id(p_a))), structural.word_curve(public.blake3_send(public.laplace_text_id(p_b))));
END;
