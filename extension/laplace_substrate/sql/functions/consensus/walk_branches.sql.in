-- p_ordinal_continuity and p_use_geometry both default false for one reason:
-- laplace.physicalities is HASH(id) over 64 partitions, and both features join
-- it by entity_id, which cannot prune. Every probe fans out across all 64.
-- MEASURED live, 200-node frontier / 21,413 candidate edges: the batch edge
-- query costs 30,305ms with the coordinate joins and 408ms without.
-- See generate_walk.c above WALK_BATCH_QUERY.
DROP FUNCTION IF EXISTS laplace.walk_branches(bytea, bytea, int, int, bytea, bytea[], bool);
DROP FUNCTION IF EXISTS consensus.walk_branches(bytea, bytea, int, int, bytea, bytea[], bool);
CREATE OR REPLACE FUNCTION consensus.walk_branches(
    p_prompt              bytea,
    p_type                bytea    DEFAULT NULL,
    p_depth               int      DEFAULT 4,
    p_breadth             int      DEFAULT 5,
    p_intent_mask         bytea    DEFAULT NULL,
    p_topic_bias          bytea[]  DEFAULT NULL,
    p_ordinal_continuity  bool     DEFAULT false,
    p_use_geometry        bool     DEFAULT false)
    RETURNS TABLE(depth int, path bytea[], types bytea[], entity_id bytea,
                  eff_mu numeric, path_mu numeric, witnesses bigint)
    AS 'MODULE_PATHNAME', 'pg_laplace_walk_branches'
    LANGUAGE C STABLE;
