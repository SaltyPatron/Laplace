DROP FUNCTION IF EXISTS laplace.chess_moves(bytea, integer);
CREATE OR REPLACE FUNCTION chess.moves(p_position bytea, p_limit integer DEFAULT 12)
    RETURNS TABLE(next_position bytea, eff_mu double precision, rd double precision,
                  witness_count bigint)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    -- Opening explorer over the rated MOVE web: every continuation the fold has
    -- ever witnessed out of one position, ranked by the conservative estimate.
    --
    -- MEASURED 2026-08-21: the deployed pre-repair corpus was EMPTY because the typed-
    -- trajectory refactor stopped materializing this bounded cell. Current PGN/live/self-
    -- play record paths restore one position→position observation per witnessed ply;
    -- older corpora remain empty until replayed. The cell is bounded by deterministic
    -- legal transitions, while evidence contexts retain the contributing playings.
    --
    -- Do NOT make this synthesise rows from trajectory geometry to look populated.
    -- I tried exactly that and it was wrong twice over: ChessEngineService.ExploreAsync
    -- ALREADY reads structural.geometry_successors_typed itself, so the join ran that
    -- surface a second time and one /chess/explore call took 147.9s; and a synthetic
    -- row makes hasRating true with eff_mu 0, so Explore reported effMu -1500 on every
    -- move (0 - NeutralMu/1e9). Returning nothing until the cells exist is the honest
    -- answer, and Explore already degrades to the successor counts on its own.
    -- Position ids are COMPOSED (ChessCompose merkle path), never
    -- realize.canonical_id(surface) — callers hold them from composing a board state or
    -- from a prior chess_moves step. Rides
    -- consensus_subject_type_eff_mu_btree (subject_id, type_id, rating-2*rd DESC
    -- WHERE object_id IS NOT NULL); consensus.eff_mu() inlines to that exact expression.
    -- LIMIT is the only cut — no floors, no thresholds.
    -- consensus.eff_mu/rd are returned in DISPLAY units (consensus.eff_mu_display's /1e9 round), never
    -- raw fp1e9; the ORDER BY stays on raw consensus.eff_mu() so the index expression matches.
    SELECT c.object_id,
           consensus.eff_mu_display(c.rating, c.rd)::double precision,
           round((c.rd / 1e9)::numeric, 3)::double precision,
           c.witness_count
    FROM laplace.consensus c
    WHERE c.subject_id = p_position
      AND c.type_id = laplace.relation_type_id('MOVE')
      AND c.object_id IS NOT NULL
    ORDER BY consensus.eff_mu(c.rating, c.rd) DESC
    LIMIT p_limit
$$;
