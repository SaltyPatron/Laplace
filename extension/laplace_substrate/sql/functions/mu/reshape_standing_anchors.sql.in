-- The standing anchors moved from the fixed-point bigint scale to Laplace-Native's
-- float8 rating points (glicko2_neutral_mu, glicko2_initial_rd,
-- glicko2_initial_volatility). A return type cannot be replaced in place, and the
-- SQL functions bound to the old anchors (belief_logit, the walk and epistemic
-- readers, chess.players_by_initial, ...) block a plain DROP. Every one of those
-- is recreated further down this script, so an anchor of the old shape goes with
-- its dependent functions. Anything other than a function depending on one stops
-- the upgrade instead of being dropped. A database already on the float8 anchors
-- (or a fresh install) does nothing here.
DO $upgrade_shape$
DECLARE
    signature text;
    anchor regprocedure;
    blocking text;
BEGIN
    FOREACH signature IN ARRAY ARRAY['consensus.glicko2_neutral_mu()',
                                     'consensus.glicko2_initial_rd()',
                                     'consensus.glicko2_initial_volatility()'] LOOP
        anchor := to_regprocedure(signature);
        CONTINUE WHEN anchor IS NULL OR pg_get_function_result(anchor) = 'double precision';
        WITH RECURSIVE dependent(classid, objid) AS (
            SELECT classid, objid FROM pg_depend
             WHERE refclassid = 'pg_proc'::regclass AND refobjid = anchor AND deptype = 'n'
            UNION
            SELECT d.classid, d.objid FROM pg_depend d
              JOIN dependent ON d.refclassid = dependent.classid AND d.refobjid = dependent.objid
             WHERE d.deptype = 'n')
        SELECT string_agg(pg_describe_object(classid, objid, 0), ', ')
          INTO blocking
          FROM dependent WHERE classid <> 'pg_proc'::regclass;
        IF blocking IS NOT NULL THEN
            RAISE EXCEPTION '% changes return type but non-function objects depend on it: %', signature, blocking;
        END IF;
        EXECUTE format('DROP FUNCTION %s CASCADE', anchor);
    END LOOP;
END $upgrade_shape$;
