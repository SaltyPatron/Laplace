SQL_QUERY("ingest.physicality_coverage_types", "bytea,bytea[]",
    "WITH touched AS MATERIALIZED ( SELECT a.subject_id AS entity_id FROM laplace.attestations a WHERE a.source_id = $1 UNION SELECT a.object_id FROM laplace.attestations a       WHERE a.source_id = $1 AND a.object_id IS NOT NULL UNION SELECT a.context_id FROM laplace.attestations a       WHERE a.source_id = $1 AND a.context_id IS NOT NULL), governed AS MATERIALIZED ( SELECT DISTINCT e.id AS entity_id FROM laplace.entities e LEFT JOIN touched t ON t.entity_id = e.id WHERE e.type_id = ANY($2)   AND t.entity_id IS NOT NULL) SELECT count(*)::bigint,        count(*) FILTER (WHERE EXISTS (          SELECT 1 FROM laplace.physicalities p WHERE p.entity_id = g.entity_id        ))::bigint FROM governed g")

