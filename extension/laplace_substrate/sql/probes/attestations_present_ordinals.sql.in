-- RETIRED: the keyed attestation bitmap probe is routed natively in
-- descent_probe.c. That implementation groups by relation type and executes the
-- cached native route; its former ordinals_sql argument is explicitly superseded
-- and ignored. Keeping a second temp-table + CREATE INDEX + ANALYZE + plpgsql loop
-- installed gives the same operation two implementations and lets callers drift
-- back onto the database-orchestrated path.
DROP FUNCTION IF EXISTS laplace.attestations_present_ordinals(bytea[]);
DROP FUNCTION IF EXISTS laplace.attestations_present_ordinals(bytea[], bytea[], bytea[]);
