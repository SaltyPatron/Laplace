


DROP FUNCTION IF EXISTS laplace.translate_to(bytea, text, int);
CREATE OR REPLACE FUNCTION converse.translate_to(p_word bytea, p_lang text DEFAULT NULL,
                                        p_limit int DEFAULT 24)
    RETURNS TABLE(translation text, language text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
 AS $$
    -- Dedup and rank by (member, lang) id pair, never by rendered surface.
    -- The text language reference is resolved at the input boundary: each
    -- distinct candidate language is matched once by label or definition
    -- surface. render_text runs above the sort, only until p_limit rows survive.
    -- object_id IS NOT NULL is load-bearing: src_langs feeds a NOT IN, and one
    -- NULL (a unary HAS_LANGUAGE cell) would make NOT IN drop every row.
    WITH src_langs AS (
        SELECT c.object_id AS id FROM laplace.consensus c
        WHERE c.subject_id = p_word AND c.type_id = laplace.relation_type_id('HAS_LANGUAGE')
          AND c.object_id IS NOT NULL
    ),
    want AS (SELECT NULLIF(btrim(lower(COALESCE(p_lang, ''))), '') AS name),
    agg AS (
        SELECT sm.member, sm.lang, max(sm.mu) AS mu, max(sm.witnesses) AS witnesses,
               max(sm.sense_mu) AS sense_mu
        FROM lexical.synset_members(p_word) sm
        WHERE sm.lang IS NOT NULL
          AND sm.lang NOT IN (SELECT id FROM src_langs)
        GROUP BY sm.member, sm.lang
    ),
    -- Definition surfaces of the candidate languages, realized once in a
    -- fenced CTE, never per probed edge inside a predicate. eff_mu > 0 keeps a
    -- refuted HAS_DEFINITION cell from admitting its language.
    lang_def_names AS MATERIALIZED (
        SELECT d.subject_id AS lang, lower(realize.render_text(d.object_id)) AS dname
        FROM laplace.consensus d, want w0
        WHERE w0.name IS NOT NULL
          AND d.subject_id IN (SELECT DISTINCT lang FROM agg)
          AND d.type_id = laplace.relation_type_id('HAS_DEFINITION')
          AND consensus.eff_mu(d.rating, d.rd) > 0
    ),
    lang_match AS (
        -- No language filter: every candidate language passes with no
        -- realization (PostgreSQL does not guarantee OR short-circuit).
        SELECT l.lang
        FROM (SELECT DISTINCT lang FROM agg) l, want w
        WHERE w.name IS NULL
        UNION ALL
        -- Named filter: label realized once per candidate language as a
        -- projection; definition surfaces are consulted when the label misses.
        SELECT s.lang
        FROM (
            SELECT l.lang, lower(realize.label(l.lang)) AS lbl
            FROM (SELECT DISTINCT lang FROM agg) l, want w0
            WHERE w0.name IS NOT NULL
        ) s, want w
        WHERE s.lbl = w.name
           OR s.lang IN (SELECT ld.lang FROM lang_def_names ld WHERE ld.dname = w.name)
    )
    -- a.mu is fp1e9 (synset_members) — convert through the one display definition
    SELECT r.txt AS translation, realize.label(a.lang) AS language, consensus.eff_mu_display(a.mu), a.witnesses
    FROM (
        SELECT member, lang, mu, witnesses FROM agg
        WHERE lang IN (SELECT lang FROM lang_match)
        ORDER BY sense_mu DESC NULLS LAST, mu DESC, witnesses DESC, lang, member
    ) a
    CROSS JOIN LATERAL (SELECT realize.render_text(a.member) AS txt) r
    WHERE NULLIF(btrim(r.txt), '') IS NOT NULL
    LIMIT p_limit
$$;
