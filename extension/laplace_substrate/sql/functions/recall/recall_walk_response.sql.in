-- doc 15 Phase 3C / doc 22 Phase E: 'complete' mode (has a type filter,
-- COMPLETES_TO) routes through public.laplace_pull -- the enriched native beam
-- engine (Glicko-complete edge weight, highway-mask gating capability,
-- S3/hilbert/trajectory-ordinal geometry terms). Plain 'walk' mode (NO
-- type filter) stays on public.laplace_pull, unchanged from before this pass.
--
-- Why the split: consensus is LIST-partitioned by relation type (hot
-- relations further HASH x8). public.laplace_pull' per-level batch query has no
-- type predicate to prune on when p_type is NULL, so an unrestricted call
-- forces an Append scan across every relation-type partition (~200+ leaves)
-- -- measured live via EXPLAIN ANALYZE, and caught in regress turning a
-- sub-second converse.sql assertion into 24s. 'complete' mode's COMPLETES_TO
-- filter keeps public.laplace_pull on the fast, partition-pruned path; plain
-- 'walk' has no filter to give it, so it stays on public.laplace_pull(proven
-- fast for the genuinely-unrestricted case via the original baseline) until
-- a bounded default relation set or a type-agnostic index makes the
-- unfiltered case safe for the beam engine too.
--
-- 'complete' mode's winner selection is path_mu/depth (average per-hop
-- confidence), NOT raw depth or raw cumulative path_mu -- also caught live:
-- ORDER BY depth DESC alone picks whichever branch happened to reach
-- deepest, which beam search can do via a structurally-well-attested but
-- narratively-irrelevant detour (e.g. cross-reference/sense-link chains
-- with real witness weight but no gloss), producing a technically
-- high-scoring but unreadable raw-hex-id reply. Averaging normalizes for
-- path length, so a short high-confidence chain beats a long chain diluted
-- by merely-adequate hops.
CREATE OR REPLACE FUNCTION converse.recall_walk_response(p_topic bytea, p_mode text)
    RETURNS TABLE(reply text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH complete_branches AS (
        SELECT * FROM (SELECT w.hops AS depth,
                ARRAY(SELECT public.blake3_send(u.x) FROM unnest(w.chain) WITH ORDINALITY u(x,n) ORDER BY u.n) AS path,
                ARRAY(SELECT public.blake3_send((public.laplace_parts(pp.path))[2])
                      FROM unnest(w.claims) WITH ORDINALITY u(c,n)
                      JOIN public.laplace_paths(w.claims) pp ON pp.entity=u.c ORDER BY u.n) AS types,
                public.blake3_send(w.id) AS entity_id,
                (w.rating-2*w.deviation)::numeric AS eff_mu,
                exp(-w.cost)::numeric AS path_mu,
                0::bigint AS witnesses
         FROM public.laplace_pull(ARRAY[public.blake3_from_bytea(p_topic)],NULL,8,5::bigint,4096::bigint,NULL::public.blake3[]) w
         WHERE w.hops>=1) wb
        WHERE p_mode = 'complete'
    ),
    complete_winner AS (
        SELECT * FROM complete_branches
        ORDER BY (path_mu / GREATEST(depth, 1)::numeric) DESC, depth DESC
        LIMIT 1
    ),
    complete_steps AS (
        SELECT i, w.path[i + 1] AS entity_id, w.types[i] AS type_id
        FROM complete_winner w, generate_series(1, w.depth) AS i
    ),
    complete_ids AS MATERIALIZED (
        SELECT ARRAY[p_topic] || COALESCE(array_agg(entity_id ORDER BY i),'{}'::bytea[]) AS entities,
               COALESCE(array_agg(type_id ORDER BY i),'{}'::bytea[]) AS types
        FROM complete_steps
    ), complete_labels AS MATERIALIZED (
        SELECT realize.batch(entities, converse.word_language(p_topic)) AS realized,
               realize.label_batch(entities) AS fallback,
               lexical.type_label_batch(types) AS types
        FROM complete_ids
    ),
    complete_reply AS (
        SELECT COALESCE(l.realized[1],l.fallback[1])
               || string_agg(' —' || COALESCE(l.types[s.i], '?') || E'→ '
                             || COALESCE(l.realized[s.i+1],l.fallback[s.i+1]), '' ORDER BY s.i) AS reply,
               min(b.eff_mu) AS eff_mu,
               (SELECT w.witnesses FROM complete_winner w) AS witnesses
        FROM complete_steps s CROSS JOIN complete_labels l
        JOIN complete_branches b ON b.entity_id = s.entity_id AND b.depth = s.i
        GROUP BY l.realized, l.fallback, l.types
        HAVING count(*) > 0
    ),
    -- ONE responder, called at this branch's depth. This block used to be a
    -- byte-for-byte copy of recall_fallback_walk differing only in depth and in
    -- how '→' was spelled (GH #906 item 1). The gate stays a short-circuit: the
    -- LATERAL is not evaluated at all when the mode is 'complete'.
    walk_reply AS (
        SELECT r.reply, r.eff_mu, r.witnesses
        FROM (SELECT 1 WHERE p_mode <> 'complete') gate
        CROSS JOIN LATERAL converse.recall_fallback_walk(p_topic, 8) r
    )
    SELECT * FROM complete_reply
    UNION ALL
    SELECT * FROM walk_reply;
END;
