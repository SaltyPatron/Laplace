DROP FUNCTION IF EXISTS laplace.index_usage_report(bigint);
DROP FUNCTION IF EXISTS laplace.index_usage_detail(text, integer);

CREATE OR REPLACE FUNCTION ops.index_usage_report(p_min_bytes bigint DEFAULT 0)
    RETURNS TABLE(
        bucket      text,
        indexes     bigint,
        total_bytes bigint,
        total_size  text)
    LANGUAGE sql STABLE

BEGIN ATOMIC

    -- What the index set costs versus what has read it, bucketed by lifetime
    -- scans. Every index is maintained on every insert, so an unread index is
    -- pure write amplification. idx_scan is cumulative since the last stats
    -- reset, not since the index was built: zero means "not needed since the
    -- reset", not "never needed". Statistics only, no scans; per-index rows are
    -- ops.index_usage_detail().
    WITH ix AS (
        SELECT s.indexrelname,
               s.idx_scan,
               pg_relation_size(s.indexrelid) AS bytes
        FROM pg_stat_user_indexes s
        WHERE s.schemaname = 'laplace'
          AND pg_relation_size(s.indexrelid) >= p_min_bytes
    )
    SELECT CASE
               WHEN ix.idx_scan = 0   THEN 'never scanned'
               WHEN ix.idx_scan < 100 THEN 'scanned <100x'
               ELSE                        'in use'
           END                          AS bucket,
           count(*)                     AS indexes,
           sum(ix.bytes)                AS total_bytes,
           pg_size_pretty(sum(ix.bytes)) AS total_size
    FROM ix
    GROUP BY 1
    ORDER BY sum(ix.bytes) DESC
;
END;

CREATE OR REPLACE FUNCTION ops.index_usage_detail(p_table text DEFAULT NULL, p_limit integer DEFAULT 40)
    RETURNS TABLE(
        tbl         text,
        index_name  text,
        idx_scan    bigint,
        total_bytes bigint,
        total_size  text)
    LANGUAGE sql STABLE

BEGIN ATOMIC

    -- The per-index rows behind index_usage_report()'s buckets, largest first.
    -- idx_scan is cumulative since the last stats reset, not since build.
    SELECT s.relname::text,
           s.indexrelname::text,
           s.idx_scan,
           pg_relation_size(s.indexrelid),
           pg_size_pretty(pg_relation_size(s.indexrelid))
    FROM pg_stat_user_indexes s
    WHERE s.schemaname = 'laplace'
      AND (p_table IS NULL OR s.relname = p_table)
    ORDER BY pg_relation_size(s.indexrelid) DESC
    LIMIT GREATEST(p_limit, 0)
;
END;
