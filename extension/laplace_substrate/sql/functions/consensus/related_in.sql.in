CREATE OR REPLACE FUNCTION consensus.related_in(p_word bytea, p_type bytea, p_lang bytea DEFAULT NULL,
                                      p_limit int DEFAULT 10)
    RETURNS TABLE(fact text, eff_mu numeric, witnesses bigint)
-- No SET search_path: the clause blocks inlining and the consensus index path.
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH subj(id) AS MATERIALIZED (
        SELECT p_word UNION SELECT sn.synset_id FROM lexical.senses(p_word) sn
    ), top AS MATERIALIZED (
        SELECT e.neighbour_id AS subject_id, e.rating, e.rd, e.witness_count
        FROM consensus.edges_raw_batch(
            ARRAY(SELECT id FROM subj),
            'in', CASE WHEN p_type IS NULL THEN NULL ELSE ARRAY[p_type] END,
            GREATEST(p_limit * 4, 64), true, 'eff_mu') e
        WHERE e.neighbour_id IS NOT NULL
          AND (e.type_id = p_type
               OR laplace.relation_type_id(consensus.relation_canonical(e.type_id)) = p_type)
    ), ranked AS MATERIALIZED (
        -- rank + LIMIT on ids BEFORE labeling (was: scalar realize per row over
        -- the num_senses x p_limit pool, labeling more rows than returned).
        SELECT t.subject_id, t.rating, t.rd, t.witness_count,
               row_number() OVER (ORDER BY consensus.eff_mu(t.rating, t.rd) DESC) AS ord
        FROM top t
        ORDER BY consensus.eff_mu(t.rating, t.rd) DESC
        LIMIT p_limit
    ), labels AS MATERIALIZED (
        -- ONE realize_batch over exactly the returned rows, position-aligned.
        SELECT ARRAY(SELECT lp_l.content FROM unnest((array_agg(r.subject_id ORDER BY r.ord))::bytea[]) WITH ORDINALITY lp_u(x,n) LEFT JOIN (SELECT DISTINCT ON (lp_d.entity) lp_d.entity,lp_d.content FROM public.laplace_labels(array_remove((array_agg(r.subject_id ORDER BY r.ord))::bytea[],NULL)::public.blake3[]) lp_d) lp_l ON lp_l.entity=lp_u.x::public.blake3 ORDER BY lp_u.n) AS l
        FROM ranked r
    )
    SELECT labels.l[r.ord], consensus.eff_mu_display(r.rating, r.rd), r.witness_count
    FROM ranked r, labels
    ORDER BY r.ord;
END;
