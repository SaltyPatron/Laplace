-- 2026-07-09: `edges` must be MATERIALIZED. Inlined, the planner pushes the
-- rank filter into the consensus scan and evaluates relation_rank_resolved
-- (~27µs/call) on all 124M rows — 255-368s measured, in either function
-- language. Fenced, the vocab probe takes the indexed nestloop.
-- 2026-07-17: rank per DISTINCT type_id (≤189 governed types) instead of per
-- edge row (~369k calls ≈ 10s measured), same rk CTE as
-- consensus_layer_plane/consensus_type_plane. edges is referenced twice below
-- (rk's DISTINCT scan and summed's join) — the fence stays load-bearing.
DROP FUNCTION IF EXISTS laplace.consensus_adjacency(bytea[], int);
CREATE OR REPLACE FUNCTION generation.consensus_adjacency(
        p_vocab bytea[], p_degree_cap int DEFAULT 64)
    RETURNS TABLE(subject_id bytea, object_id bytea, w double precision)
    LANGUAGE plpgsql STABLE PARALLEL RESTRICTED AS $$
BEGIN
    RETURN QUERY
    WITH v(id) AS (SELECT DISTINCT u FROM unnest(p_vocab) AS u),
         kappa(k) AS (SELECT laplace.foundry_rd_kappa()),
         edges AS MATERIALIZED (
             SELECT c.subject_id, c.object_id, c.rating, c.rd, c.witness_count,
                    c.type_id
             FROM v
             JOIN laplace.consensus c ON c.subject_id = v.id
             JOIN v vo        ON vo.id = c.object_id
             WHERE c.object_id IS NOT NULL
         ),
         rk AS (
             SELECT d.type_id, r.rank
             FROM (SELECT DISTINCT type_id FROM edges) d
             CROSS JOIN LATERAL laplace.relation_rank_resolved(d.type_id) AS r(rank)
             WHERE r.rank IS NOT NULL
         ),
         -- P5 Glicko-complete weight (doc 14 M5): signed, rd-discounted,
         -- witness-saturated. Positivity is NOT clamped here — the basis union
         -- clamps client-side (FoundryExport.PositivePart); the unary operator
         -- plane keeps refutation as negative weight.
         --
         -- 2026-07-27: this used to be the formula, hand-typed:
         --     (rating - laplace.glicko2_neutral_mu())/1e9
         --       * exp(-laplace.foundry_rd_kappa() * rd/1e9)
         --       * laplace.foundry_witness_sat(witness_count)
         -- which is a SECOND expression of laplace_walk_edge_weight (glicko2.c),
         -- the one generate_walk.c's beam and astar_path.c's edge_cost already
         -- call. Same algebra, two bodies, the witness half-max (4.0) written
         -- into both, and no test binding them — so the weight the ENGINE walks
         -- and the weight the FOUNDRY exports could drift on a one-line edit.
         -- Now both read the one C implementation. kappa is resolved ONCE here
         -- rather than per row (it was a function call inside the sum before);
         -- the native walkers resolve it the same way via spi_fetch_rd_kappa().
         summed AS (
             SELECT e.subject_id, e.object_id,
                    sum(rk.rank
                        * consensus.walk_edge_weight(e.rating, e.rd, e.witness_count,
                                           (SELECT k FROM kappa))) AS w
             FROM edges e
             JOIN rk ON rk.type_id = e.type_id
             GROUP BY e.subject_id, e.object_id
         ),
         capped AS (
             SELECT s.subject_id, s.object_id, s.w,
                    row_number() OVER (PARTITION BY s.subject_id ORDER BY abs(s.w) DESC, s.object_id) AS rn
             FROM summed s
             WHERE s.w <> 0
         )
    SELECT c.subject_id, c.object_id, c.w FROM capped c WHERE c.rn <= p_degree_cap;
END;
$$;
