{
  "stream": "laplace",
  "endpoints": {
    "chat_completions": {
      "status": "live",
      "backend": "laplace turn: the forward program, the turn witnessed by the Engine",
      "billing": "preflight_quote_required"
    },
    "completions": {
      "status": "live",
      "backend": "laplace turn: the forward program, each step streamed, the turn witnessed by the Engine",
      "billing": "preflight_quote_required"
    },
    "embeddings": {
      "status": "live",
      "backend": "public.laplace_entities (form) + ops.consensus_out_readable (meaning)",
      "billing": "embeddings"
    },
    "audit_reports": {
      "status": "live",
      "backend": "ops.substrate_counts + consensus.stats + consensus.top_relations",
      "billing": "audit.deep_report"
    },
    "visualizations": {
      "status": "live",
      "backend": "consensus.top_relations + public.laplace_entities",
      "billing": "visualization.deep_export"
    },
    "explainability_reports": {
      "status": "live",
      "backend": "public.laplace_pull + ops.attestations_out",
      "billing": "explain.trace"
    },
    "billing": {
      "status": "live",
      "provider": "stripe_or_manual"
    },
    "models": {
      "status": "live"
    },
    "feedback": {
      "status": "live",
      "backend": "laplace witness: the caller's statement at UserPromptContent, its standing folded by the Engine"
    },
    "recipe_compile": {
      "status": "live",
      "backend": "laplace.recipe validation + RecipeDescriptor",
      "billing": "recipe.compile"
    },
    "synthesis_export": {
      "status": "live",
      "backend": "foundry CLI export (writes GGUF; never loaded on chat path)",
      "billing": "synthesis"
    },
    "op": {
      "status": "live",
      "backend": "ops.api catalog allow-list; named function call; no SQL text"
    }
  }
}
