-- ops.activity: every backend on this database, longest-running first, so a
-- caller can see whether work is moving or waiting and find the pid that
-- ops.cancel_backend takes. Durations are seconds, NULL when the clock never
-- started. PostgreSQL hides other users' state and query from roles without
-- pg_read_all_stats; `restricted` names that mask so it never reads as idle.
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.activity(double precision, boolean, boolean)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(pid integer, is_self boolean, restricted boolean, usename text, application_name text, client_addr text, backend_type text, state text, wait_event_type text, wait_event text, query_seconds double precision, xact_seconds double precision, backend_seconds double precision, query text)'
             OR proargnames IS DISTINCT FROM ARRAY['p_min_seconds','p_include_idle','p_include_background','pid','is_self','restricted','usename','application_name','client_addr','backend_type','state','wait_event_type','wait_event','query_seconds','xact_seconds','backend_seconds','query']::text[])) THEN
        DROP FUNCTION ops.activity(double precision, boolean, boolean);
    END IF;
END $upgrade_shape$;
CREATE OR REPLACE FUNCTION ops.activity(
    p_min_seconds        double precision DEFAULT 0,
    p_include_idle       boolean          DEFAULT true,
    p_include_background boolean          DEFAULT false)
    RETURNS TABLE(pid int, is_self boolean, restricted boolean, usename text,
                  application_name text, client_addr text, backend_type text,
                  state text, wait_event_type text, wait_event text,
                  query_seconds double precision, xact_seconds double precision,
                  backend_seconds double precision, query text)
    -- VOLATILE: pg_stat_activity and clock_timestamp() change between calls
    -- in one statement.
    LANGUAGE sql VOLATILE
BEGIN ATOMIC
    SELECT a.pid,
           a.pid = pg_backend_pid(),
           -- No state AND no query on a live backend is the privilege mask, not
           -- an idle session: an idle session still reports state='idle'.
           a.state IS NULL AND a.query IS NULL,
           a.usename::text,
           a.application_name,
           host(a.client_addr),
           a.backend_type,
           a.state,
           a.wait_event_type,
           a.wait_event,
           extract(epoch FROM clock_timestamp() - a.query_start)::double precision,
           extract(epoch FROM clock_timestamp() - a.xact_start)::double precision,
           extract(epoch FROM clock_timestamp() - a.backend_start)::double precision,
           a.query
    FROM pg_stat_activity a
    WHERE (a.datname = current_database()
           OR (p_include_background AND a.datname IS NULL))
      AND (p_include_idle OR a.state IS DISTINCT FROM 'idle')
      AND COALESCE(
              extract(epoch FROM clock_timestamp() - a.query_start),
              extract(epoch FROM clock_timestamp() - a.backend_start),
              0) >= GREATEST(p_min_seconds, 0)
    ORDER BY COALESCE(a.query_start, a.backend_start), a.pid;
END;

COMMENT ON FUNCTION ops.activity(double precision, boolean, boolean) IS
    'Live backends on this database, longest-running first. restricted=true means '
    'the caller lacks pg_read_all_stats and Postgres masked state/query for that '
    'backend — a different fact from an idle session, which reports state=idle. '
    'Pass the pid to ops.cancel_backend / ops.terminate_backend.';
