DROP FUNCTION IF EXISTS laplace.walk_continuations(bytea[], int, int, float8, int, bigint);
-- Output projection is separate from routing/steering. NULL/empty output
-- relations admit physical continuations only. Graph identities remain active
-- evidence; they become output candidates only through this declared projection.
CREATE OR REPLACE FUNCTION generation.forward_walk_continuations(
        p_ctx bytea[], p_steps int, p_max_stride int,
        p_spread float8, p_top_k int, p_seed bigint, p_frontier bytea[],
        p_relation_types bytea[], p_fanout int, p_observation_ids bytea[],
        p_containing_ids bytea[], p_output_relation_types bytea[])
    RETURNS TABLE(step int, entity bytea, stride_used int, sep_entity bytea)
    AS 'EXECUTION_LIBRARY', 'pg_laplace_walk_continuations'
    LANGUAGE C VOLATILE;

-- Canonical native whole-prompt execution. The trace columns are receipts from
-- the SAME invocation that performs admission, query-relative routing, exact
-- candidate adjudication, obligation closure, selection and working-state
-- extension. A caller that only needs selected identities projects EMIT rows
-- through generation.forward_prompt below; completion is still calculated by
-- this invocation and never reconstructed by a second graph walk.
CREATE OR REPLACE FUNCTION generation.forward_trace(
        p_prompt text, p_steps int DEFAULT 24, p_max_stride int DEFAULT 5,
        p_spread float8 DEFAULT 0.7, p_top_k int DEFAULT 10,
        p_seed bigint DEFAULT NULL, p_hops int DEFAULT 2, p_fanout int DEFAULT 8,
        p_prior_frontier bytea[] DEFAULT NULL,
        p_output_relation_types bytea[] DEFAULT NULL)
    RETURNS TABLE(step int, entity bytea, stride_used int, sep_entity bytea,
        root_id bytea, candidate_count int, ordered_context_count int,
        proposal_channel_count int, exact_channel_count int,
        sequence_occurrences bigint, covered_occurrences int,
        relation_families int, opposed_occurrences int,
        support_anchor bytea, support_relation bytea, support_outbound boolean,
        support_rating bigint, support_rd bigint, support_witnesses bigint,
        support_sources int, support_contexts int, declared_result boolean,
        event text, routing_round int,
        program_id bytea, required_obligations int, satisfied_obligations int,
        remaining_required int, completion boolean, disposition text,
        output_fingerprint bytea, semantic_act_id bytea, output_count int)
    AS 'EXECUTION_LIBRARY', 'pg_laplace_forward_trace'
    LANGUAGE C VOLATILE;

-- Normal generation is a projection of the traceable canonical native pass,
-- not another implementation. Route/terminal rows are execution receipts only.
CREATE OR REPLACE FUNCTION generation.forward_prompt(
        p_prompt text, p_steps int, p_max_stride int,
        p_spread float8, p_top_k int, p_seed bigint,
        p_hops int, p_fanout int, p_prior_frontier bytea[],
        p_output_relation_types bytea[])
    RETURNS TABLE(step int, entity bytea, stride_used int, sep_entity bytea)
    LANGUAGE sql VOLATILE
BEGIN ATOMIC
    SELECT t.step, t.entity, t.stride_used, t.sep_entity
    FROM generation.forward_trace(
        p_prompt, p_steps, p_max_stride, p_spread, p_top_k, p_seed,
        p_hops, p_fanout, p_prior_frontier, p_output_relation_types) AS t
    WHERE t.event = 'emit';
END;

-- Physical co-occurrence is an independent observation route. The complete
-- declared member set narrows the indexed read once; ordinal matching retains
-- order and multiplicity. Semantic testimony is not required per constituent.
CREATE OR REPLACE FUNCTION generation.forward_walk_continuations(
        p_ctx bytea[], p_steps int, p_max_stride int,
        p_spread float8, p_top_k int, p_seed bigint, p_frontier bytea[],
        p_relation_types bytea[], p_fanout int, p_observation_ids bytea[],
        p_containing_ids bytea[])
    RETURNS TABLE(step int, entity bytea, stride_used int, sep_entity bytea)
    LANGUAGE sql VOLATILE
BEGIN ATOMIC
    SELECT * FROM generation.forward_walk_continuations(
        p_ctx, p_steps, p_max_stride, p_spread, p_top_k, p_seed,
        p_frontier, p_relation_types, p_fanout, p_observation_ids, p_containing_ids,
        COALESCE(p_relation_types, consensus.relation_set_ids('CONTINUATION_OUTPUT')));
END;

CREATE OR REPLACE FUNCTION generation.forward_walk_continuations(
        p_ctx bytea[], p_steps int, p_max_stride int,
        p_spread float8, p_top_k int, p_seed bigint, p_frontier bytea[],
        p_relation_types bytea[], p_fanout int, p_observation_ids bytea[])
    RETURNS TABLE(step int, entity bytea, stride_used int, sep_entity bytea)
    LANGUAGE sql VOLATILE
BEGIN ATOMIC
    SELECT * FROM generation.forward_walk_continuations(
        p_ctx, p_steps, p_max_stride, p_spread, p_top_k, p_seed,
        p_frontier, p_relation_types, p_fanout, p_observation_ids, NULL::bytea[]);
END;

CREATE OR REPLACE FUNCTION generation.forward_walk_continuations(
        p_ctx bytea[], p_steps int, p_max_stride int,
        p_spread float8, p_top_k int, p_seed bigint, p_frontier bytea[],
        p_relation_types bytea[], p_fanout int)
    RETURNS TABLE(step int, entity bytea, stride_used int, sep_entity bytea)
    LANGUAGE sql VOLATILE
BEGIN ATOMIC
    SELECT * FROM generation.forward_walk_continuations(
        p_ctx, p_steps, p_max_stride, p_spread, p_top_k, p_seed,
        p_frontier, p_relation_types, p_fanout, NULL::bytea[]);
END;

CREATE OR REPLACE FUNCTION generation.forward_walk_continuations(
        p_ctx bytea[], p_steps int, p_max_stride int,
        p_spread float8, p_top_k int, p_seed bigint, p_frontier bytea[],
        p_relation_types bytea[])
    RETURNS TABLE(step int, entity bytea, stride_used int, sep_entity bytea)
    LANGUAGE sql VOLATILE
BEGIN ATOMIC
    SELECT * FROM generation.forward_walk_continuations(
        p_ctx, p_steps, p_max_stride, p_spread, p_top_k, p_seed,
        p_frontier, p_relation_types, 8);
END;

CREATE OR REPLACE FUNCTION generation.forward_walk_continuations(
        p_ctx bytea[], p_steps int DEFAULT 24, p_max_stride int DEFAULT 5,
        p_spread float8 DEFAULT 0.7, p_top_k int DEFAULT 10,
        p_seed bigint DEFAULT NULL, p_frontier bytea[] DEFAULT NULL)
    RETURNS TABLE(step int, entity bytea, stride_used int, sep_entity bytea)
    LANGUAGE sql VOLATILE
BEGIN ATOMIC
    SELECT * FROM generation.forward_walk_continuations(
        p_ctx, p_steps, p_max_stride, p_spread, p_top_k, p_seed, p_frontier, NULL);
END;

-- Compatibility surface: preserve the installed parameter name `p_breadth` so
-- CREATE OR REPLACE remains upgrade-safe for callers that bind by name. The
-- canonical routed operator names the same operand `p_top_k`; this wrapper only
-- translates the legacy API spelling and does not own a second implementation.
CREATE OR REPLACE FUNCTION generation.walk_continuations(
        p_ctx bytea[], p_steps int DEFAULT 24, p_max_stride int DEFAULT 5,
        p_spread float8 DEFAULT 0.7, p_breadth int DEFAULT 10,
        p_seed bigint DEFAULT NULL)
    RETURNS TABLE(step int, entity bytea, stride_used int, sep_entity bytea)
    LANGUAGE sql VOLATILE
BEGIN ATOMIC
    SELECT * FROM generation.forward_walk_continuations(
        p_ctx, p_steps, p_max_stride, p_spread, p_breadth, p_seed, NULL);
END;
