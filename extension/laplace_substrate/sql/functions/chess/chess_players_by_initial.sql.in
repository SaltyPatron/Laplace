DROP FUNCTION IF EXISTS laplace.chess_players_by_initial(text, integer, integer);
DROP FUNCTION IF EXISTS chess.players_by_initial(text, integer, integer, text, text);
DROP FUNCTION IF EXISTS chess.players_by_initial(text, integer, integer);
DROP FUNCTION IF EXISTS chess.players_by_initial(text[], integer, integer, text, text);

CREATE FUNCTION chess.players_by_initial(
        p_initials text[], p_limit integer, p_offset integer, p_sort text, p_direction text)
    RETURNS TABLE(player_id bytea, name text, games bigint,
                  rating double precision, rd double precision, eff_mu double precision)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH target AS MATERIALIZED (
        SELECT array_agg(DISTINCT laplace.word_id(left(v, 1))) AS cps
        FROM unnest(p_initials) q(v)
        WHERE length(v) > 0
    ),
    name_ids AS MATERIALIZED (
        -- This expression is exactly the physicalities_traj_first_id_btree key.
        SELECT w.id AS name_id
        FROM laplace.v_word_points w, target t
        WHERE w.trajectory IS NOT NULL
          AND (public.laplace_trajectory_constituent_ids(w.trajectory))[1] = ANY (t.cps)
    ),
    players AS MATERIALIZED (
        -- Primary names and aliases are both names. Restricting this to
        -- HAS_NAME_ALIAS hid players whose PGN supplied a primary name (including
        -- Karpov and Fischer) even though the normal label resolver showed them.
        SELECT DISTINCT c.subject_id AS player
        FROM laplace.consensus c
        JOIN name_ids n ON n.name_id = c.object_id
        WHERE c.type_id = ANY (
            consensus.relation_family_ids('HAS_NAME')
            || consensus.relation_family_ids('HAS_NAME_ALIAS'))
    ),
    rated AS MATERIALIZED (
        SELECT p.player,
               COALESCE(o.witness_count, 0) AS games,
               COALESCE(o.rating, consensus.glicko2_neutral_mu()) AS rating,
               COALESCE(o.rd, consensus.glicko2_initial_rd()) AS rd,
               CASE COALESCE(p_sort, 'strength')
                   WHEN 'games'  THEN COALESCE(o.witness_count, 0)::double precision
                   WHEN 'rating' THEN COALESCE(o.rating, consensus.glicko2_neutral_mu())::double precision
                   WHEN 'rd'     THEN COALESCE(o.rd, consensus.glicko2_initial_rd())::double precision
                   ELSE consensus.eff_mu(
                       COALESCE(o.rating, consensus.glicko2_neutral_mu()),
                       COALESCE(o.rd, consensus.glicko2_initial_rd()))::double precision
               END AS sort_value
        FROM players p
        LEFT JOIN laplace.consensus o
          ON o.subject_id = p.player
         AND o.type_id = laplace.relation_type_id('OUTCOME')
         AND o.object_id = laplace.entity_type_id('Chess_Result')
    ),
    page AS MATERIALIZED (
        SELECT r.*
        FROM rated r
        ORDER BY
            CASE WHEN COALESCE(p_direction, 'desc') = 'asc'
                 THEN r.sort_value END ASC,
            CASE WHEN COALESCE(p_direction, 'desc') <> 'asc'
                 THEN r.sort_value END DESC,
            r.player
        LIMIT p_limit
        OFFSET p_offset
    ),
    batch AS MATERIALIZED (
        SELECT COALESCE(array_agg(page.player ORDER BY page.player), '{}'::bytea[]) AS ids
        FROM page
    ),
    surfaced AS (
        SELECT q.id, q.txt
        FROM batch b,
             LATERAL ROWS FROM (
                 unnest(b.ids), unnest(realize.batch(b.ids))
             ) AS q(id, txt)
    )
    SELECT page.player,
           COALESCE(NULLIF(s.txt, ''), 'Unrealized player'),
           page.games,
           round((page.rating / 1e9)::numeric, 3)::double precision,
           round((page.rd / 1e9)::numeric, 3)::double precision,
           consensus.eff_mu_display(page.rating, page.rd)::double precision
    FROM page
    LEFT JOIN surfaced s ON s.id = page.player
    ORDER BY
        CASE WHEN COALESCE(p_direction, 'desc') = 'asc'
             THEN page.sort_value END ASC,
        CASE WHEN COALESCE(p_direction, 'desc') <> 'asc'
             THEN page.sort_value END DESC,
        page.player;
END;
