-- One set projection serves single-entity inspection and batch/UI geometry.
-- Native owns exact stored reads; the retained typed forms share this adapter.
CREATE OR REPLACE FUNCTION ops.entity_physicalities(p_ids bytea[])
    RETURNS TABLE(ordinal bigint, type smallint, x double precision, y double precision,
                  z double precision, m double precision,
                  radius double precision, n_constituents integer,
                  hilbert_index bytea)
    LANGUAGE sql STABLE STRICT
BEGIN ATOMIC
    WITH inputs AS MATERIALIZED (
        SELECT u.id,u.ordinal,row_number() OVER (ORDER BY u.ordinal) AS native_ordinal
        FROM unnest(p_ids) WITH ORDINALITY u(id,ordinal) WHERE u.id IS NOT NULL
    ), requested AS MATERIALIZED (
        SELECT ARRAY(SELECT public.blake3_from_bytea(u.id)
                     FROM inputs u ORDER BY u.native_ordinal) AS ids
    ), native AS MATERIALIZED (
        SELECT u.ordinal, 1::smallint AS type, ST_X(e.coord) AS x, ST_Y(e.coord) AS y,
               ST_Z(e.coord) AS z, ST_M(e.coord) AS m,
               public.laplace_radius_origin(e.coord) AS radius,
               public.laplace_path_length(p.path)::integer AS n_constituents,
               int8send(e.hilbert # '-9223372036854775808'::bigint) AS hilbert_index
        FROM public.laplace_entities((SELECT ids FROM requested)) e
        JOIN public.laplace_physicalities((SELECT ids FROM requested)) p USING(ordinal)
        JOIN inputs u ON u.native_ordinal=e.ordinal
    )
    SELECT * FROM native
    UNION ALL
    SELECT u.ordinal,p.type, ST_X(p.coord), ST_Y(p.coord), ST_Z(p.coord), ST_M(p.coord),
           p.radius_origin, p.n_constituents, p.hilbert_index
    FROM inputs u
    JOIN laplace.physicalities p ON p.entity_id=u.id
    WHERE p.type<>1 OR NOT EXISTS(SELECT FROM native n WHERE n.ordinal=u.ordinal);
END;
CREATE OR REPLACE FUNCTION ops.entity_physicalities(p_id bytea)
    RETURNS TABLE(type smallint, x double precision, y double precision,
                  z double precision, m double precision,
                  radius double precision, n_constituents integer,
                  hilbert_index bytea)
    LANGUAGE sql STABLE STRICT
BEGIN ATOMIC
    SELECT p.type,p.x,p.y,p.z,p.m,p.radius,p.n_constituents,p.hilbert_index
    FROM ops.entity_physicalities(ARRAY[p_id]) p ORDER BY p.type;
END;
