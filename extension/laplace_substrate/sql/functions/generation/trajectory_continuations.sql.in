-- generation.trajectory_continuations(ctx, topk) -> what followed this exact context, counted.
-- NULL topk returns the complete successor set; zero returns no rows.  Callers that
-- need a bounded presentation choose that bound explicitly after any downstream
-- steering, rather than losing candidates to a guessed pre-steering cutoff.
--
-- The native matcher reads packed ordered trajectories. Corpus-scoped calls
-- use a constituent GIN operand; observation-scoped calls read witnessed roots
-- through the entity index. The forward pass retains those packed trajectories
-- within its snapshot, including misses, and loads only newly observed roots.
-- This request cache does not replace the persistent mmap perfcache contract.
--
-- Every constituent participates in exact ordinal matching, including spaces,
-- punctuation and single-child collapsed identities. The native matcher expands
-- stored runs without dropping occurrences or reclassifying content by tier.
-- sep_id remains nullable for SQL compatibility; the next constituent is emitted
-- in object_id with its original identity.
--
-- Exact queries and suffix-backoff generation share one native matcher.
DROP FUNCTION IF EXISTS laplace.trajectory_continuations(bytea[], int);
CREATE OR REPLACE FUNCTION generation.trajectory_continuations(
        p_ctx bytea[], p_topk int DEFAULT NULL)
    RETURNS TABLE(object_id bytea, sep_id bytea, weight bigint)
    AS 'EXECUTION_LIBRARY', 'pg_laplace_trajectory_continuations'
    LANGUAGE C STABLE;

-- Observation-bound form for query, forward execution and export. NULL is
-- explicit corpus scope; an empty array is empty support. Witnessed object
-- and context identities propose physicality roots, not co-occurrence truth.
CREATE OR REPLACE FUNCTION generation.trajectory_continuations(
        p_ctx bytea[], p_topk int, p_observation_ids bytea[])
    RETURNS TABLE(object_id bytea, sep_id bytea, weight bigint)
    AS 'EXECUTION_LIBRARY', 'pg_laplace_trajectory_continuations'
    LANGUAGE C STABLE;
