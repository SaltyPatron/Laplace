-- Word adjacency DERIVED from sentence/document trajectories. Witnessed order lives in
-- the trajectory (Pillar 3a: text emits no PRECEDES laplace.attestations); this is the calculated
-- view over it.
--
-- Count ordered occurrences in recorded compositions, including repeated pairs
-- inside one composition. A repeated source observation does not duplicate the
-- content-addressed trajectory. Source testimony belongs to attestations and
-- standings; this count does not multiply by observation_count. Counting distinct
-- containing compositions instead requires count(DISTINCT witness_id).
DROP FUNCTION IF EXISTS laplace.word_order(bytea[], int, int);
CREATE OR REPLACE FUNCTION generation.word_order(p_vocab bytea[], p_trajs int DEFAULT 100000, p_gap int DEFAULT 1)
    RETURNS TABLE(subject_id bytea, object_id bytea, w double precision)
    LANGUAGE sql STABLE PARALLEL RESTRICTED
BEGIN ATOMIC
    -- COUNT is one valuation of generation.word_adjacency, which owns the extraction.
    -- The continuation lane values the same rows by the adjudicated standing of the
    -- witnessing composition instead; keeping one extraction body is what stops the
    -- counter and the belief reader from drifting (§15).
    -- sep_id is dropped HERE, at the count, not at the extraction: what sits
    -- between two entities is real content and word_adjacency carries it. A caller
    -- that needs it reads word_adjacency directly.
    SELECT a.subject_id, a.object_id, count(*)::float8
    FROM generation.word_adjacency(p_vocab, p_trajs, p_gap) a
    GROUP BY a.subject_id, a.object_id;
END;
