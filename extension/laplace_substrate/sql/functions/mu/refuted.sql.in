-- A standing is refuted when even its optimistic bound, two deviations above
-- its rating, loses to the anchor: the Native confidence read at k = -2 is below
-- one half.
DROP FUNCTION IF EXISTS laplace.refuted(bigint, bigint);
CREATE OR REPLACE FUNCTION consensus.refuted(p_rating double precision, p_deviation double precision)
    RETURNS boolean LANGUAGE sql LAPLACE_IMMUTABLE
BEGIN ATOMIC
    SELECT public.laplace_confidence(p_rating, p_deviation, -2) < 0.5;
END;

-- Legacy laplace.consensus (bigint rating and rd, fixed point x 1e9) until its writer moves to public.consensus:
-- the Native reading of its points.
CREATE OR REPLACE FUNCTION consensus.refuted(p_rating bigint, p_rd bigint)
    RETURNS boolean LANGUAGE sql LAPLACE_IMMUTABLE
BEGIN ATOMIC
    SELECT consensus.refuted(p_rating / 1e9::double precision, p_rd / 1e9::double precision);
END;