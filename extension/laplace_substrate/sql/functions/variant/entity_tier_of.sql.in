-- BEGIN ATOMIC: canonical entity tier is the retained lowest structural floor.
CREATE OR REPLACE FUNCTION generation.entity_tier_of(p_entity bytea)
    RETURNS int
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT COALESCE(
        (SELECT e.tier::int FROM laplace.entities e WHERE e.id = p_entity),
        CASE WHEN public.laplace_codepoint(public.blake3_from_bytea(p_entity)) IS NOT NULL THEN 0 END
    );
END;
