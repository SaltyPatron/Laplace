@startuml
!pragma layout smetana
skinparam backgroundColor #FAFCFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #385978
skinparam componentBackgroundColor #E6EFF7
skinparam classBackgroundColor #E6EFF7
title substrate.highway — declared input/output contract
component "substrate.highway" as operation
rectangle "Unicode and canonical number recipes" as in0
in0 --> operation
rectangle "typed registry authority" as in1
in1 --> operation
rectangle "grammar recipe relation reference language script modality model trust operation and effect declarations" as in2
in2 --> operation
rectangle "stable scoped numerical coordinates" as out0
operation --> out0
rectangle "cross-language and cross-modality routes" as out1
operation --> out1
rectangle "generated native PostgreSQL SQL and C# mirrors" as out2
operation --> out2
rectangle "coherent highway epoch" as out3
operation --> out3
@enduml
