DROP FUNCTION IF EXISTS laplace.chess_time_pressure_outcome();
CREATE OR REPLACE FUNCTION chess.time_pressure_outcome()
    RETURNS TABLE(
        think_class     text,
        positions       bigint,
        plays           bigint,
        avg_eff_mu      numeric)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    -- "Do rushed moves lead to worse outcomes?" answered as a READ over the
    -- FOLDED consensus layer — never a query-time aggregation of raw evidence.
    --
    -- Both inputs are already folded at ingest. HAS_THINK_CLASS retains the set of distinct
    -- positions observed under each class; OUTCOME is deposited directly on the reusable
    -- class content id, one observation per classified ply. Exact transitions remain in line
    -- trajectories and are not recreated here as a statistical lookup table.
    -- The earlier evidence-layer form (joining 133M laplace.attestations by game
    -- context_id) timed out at 90s; this is the substrate's own answer: the
    -- adjudication already happened, the read is a lookup (GH #606).
    --
    -- Global (all positions). The per-PLAYER cut ("how does Magnus do when
    -- rushed") is deliberately NOT a query-time recompute either: it wants the
    -- analyzer to fold (player, time-class -> outcome) as its own consensus
    -- cell at ingest, then that read is a single indexed lookup — the same
    -- record-vs-calculate discipline. Tracked as the ingest-fold extension.
    WITH tc AS MATERIALIZED (
        SELECT c.object_id AS class_id, count(DISTINCT c.subject_id)::bigint AS positions
        FROM laplace.consensus c
        WHERE c.type_id = laplace.relation_type_id('HAS_THINK_CLASS')
        GROUP BY c.object_id
    ), outcome AS MATERIALIZED (
        SELECT c.subject_id AS class_id,
               consensus.eff_mu(c.rating, c.rd) AS mu,
               c.witness_count AS plays
        FROM laplace.consensus c
        WHERE c.type_id = ANY (consensus.relation_family_ids('OUTCOME'))
          AND c.object_id = public.laplace_hash128_blake3('Chess_Result')
    ), cls(id, label, ord) AS (
        VALUES
            (laplace.word_id('rushed'), 'rushed', 1),
            (laplace.word_id('normal'), 'normal', 2),
            (laplace.word_id('deep'),   'deep',   3),
            -- Think-time lenses: phase × clock × spent refinements the analyzer
            -- deposits beside the base classes, thresholds from the game's own
            -- clock distribution (ChessCanonical.ThinkLens). Content values on
            -- the same HAS_THINK_CLASS cell shape — no relation change. The
            -- fourth lens (late + fast + low clock) IS the base 'rushed' cell.
            (laplace.word_id('planned_quick'), 'planned_quick', 4),
            (laplace.word_id('pressed_think'), 'pressed_think', 5),
            (laplace.word_id('flagging'),      'flagging',      6)
    )
    SELECT cls.label,
           tc.positions,
           outcome.plays,
           round(consensus.eff_mu_display(outcome.mu, 0)::numeric, 3) AS avg_eff_mu
    FROM tc
    JOIN outcome ON outcome.class_id = tc.class_id
    JOIN cls ON cls.id = tc.class_id
    GROUP BY cls.label, cls.ord, tc.positions, outcome.plays, outcome.mu
    ORDER BY cls.ord
$$;
