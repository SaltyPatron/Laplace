-- taxonomy.ancestry: TRAVERSE upward from an entity over the relation types in
-- p_band_mask, following only positive-standing binary cells, cycle-free, to
-- p_max_depth. Each ancestor is returned once at its shallowest depth with the
-- strongest standing seen on any path to it.
CREATE OR REPLACE FUNCTION taxonomy.ancestry(
    p_entity_id bytea,
    p_band_mask  bytea,
    p_max_depth  integer DEFAULT 10)
RETURNS TABLE(ancestor_id bytea, depth integer, best_eff_mu numeric)
AS 'EXECUTION_LIBRARY', 'pg_laplace_taxonomy_ancestry'
LANGUAGE C STABLE PARALLEL SAFE;
