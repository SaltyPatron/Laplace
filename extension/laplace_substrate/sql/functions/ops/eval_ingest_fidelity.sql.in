-- Ingest-fidelity eval scores, installed (GH #909 item 4).
--
-- Both bodies lived as CTE strings in C# (NpgsqlSubstrateReads), scanning consensus
-- directly and re-deriving a symmetric edge score with two correlated subselects per
-- row. They composed installed pieces, but the table reads, the per-row subselects
-- and the sampling rule were all defined client-side, where no gate sees them and
-- the definition of "how a plane scores a pair" can drift from the read path's.
--
-- SYMMETRIC BY CONSTRUCTION. A plane relation may be attested in either direction
-- for a given pair, so the score is the stronger of the two orientations; that is a
-- property of the eval, stated here once instead of copy-pasted into each caller.
-- Unattested reads 0 rather than absent: these feed a positives/negatives score
-- distribution where every sampled pair must contribute a number, the same
-- deliberate tri-state collapse consensus_pair_scores documents.
DROP FUNCTION IF EXISTS laplace.eval_pair_plane_score(bytea, bytea, bytea);
DROP FUNCTION IF EXISTS laplace.eval_ingest_fidelity_positives(text, text, int);
DROP FUNCTION IF EXISTS laplace.eval_ingest_fidelity_negatives(text, int);

CREATE OR REPLACE FUNCTION ops.eval_pair_plane_score(
    p_w1 bytea, p_w2 bytea, p_type bytea)
    RETURNS float8
    LANGUAGE sql STABLE PARALLEL SAFE
    AS $$
    SELECT GREATEST(
        -- type_id and subject_id are the partition keys and both are in hand. Filtering
        -- on c.id alone prunes nothing across the 216 leaves; with them it is one leaf
        -- and the primary key (id, type_id, subject_id). Measured on consensus.cell,
        -- the same shape: 97.1ms -> 21.0ms. This runs once per evaluated pair.
        COALESCE((SELECT consensus.eff_mu_display(c.rating, c.rd)
                  FROM laplace.consensus c
                  WHERE c.id = laplace.consensus_id(p_w1, p_type, p_w2)
                    AND c.type_id = p_type AND c.subject_id = p_w1), 0),
        COALESCE((SELECT consensus.eff_mu_display(c.rating, c.rd)
                  FROM laplace.consensus c
                  WHERE c.id = laplace.consensus_id(p_w2, p_type, p_w1)
                    AND c.type_id = p_type AND c.subject_id = p_w2), 0))::float8
$$;

-- POSITIVES: pairs the ground-truth relation grounds together (two surfaces sharing
-- a sense), scored on the plane relation. p_relation names the plane; p_ground_truth
-- names the relation whose shared object makes two surfaces a true pair.
CREATE OR REPLACE FUNCTION ops.eval_ingest_fidelity_positives(
    p_relation text, p_ground_truth text, p_limit int DEFAULT 200)
    RETURNS TABLE(score float8)
    -- Sampling is intentionally fresh per call. random() changes on every call,
    -- so this wrapper must make the same promise rather than presenting planner-
    -- unsound transaction-constant behavior over a changing sample.
    LANGUAGE sql VOLATILE
    AS $$
    WITH vocab AS (
        SELECT subject_id AS id FROM consensus.subjects_of_type(p_relation)
    ),
    syn AS (
        SELECT c.subject_id AS w, c.object_id AS sense
        FROM laplace.consensus c
        WHERE c.type_id = laplace.relation_type_id(p_ground_truth)
          AND c.subject_id IN (SELECT id FROM vocab)
          AND c.object_id IS NOT NULL
    ),
    pairs AS (
        -- a.w < b.w gives each unordered pair once; the score is symmetric anyway,
        -- so the ordering here is deduplication and not a direction claim.
        SELECT DISTINCT a.w AS w1, b.w AS w2
        FROM syn a JOIN syn b ON a.sense = b.sense AND a.w < b.w
    )
    SELECT ops.eval_pair_plane_score(
               p.w1, p.w2, laplace.relation_type_id(p_relation))
    FROM (SELECT w1, w2 FROM pairs ORDER BY random() LIMIT p_limit) p
$$;

-- NEGATIVES: pairs drawn with no grounding relation between them, from the same
-- vocabulary, on the same plane -- the null distribution the positives are measured
-- against. The half-vocabulary offset pairs each sampled row with the one half a
-- shuffled vocabulary away, which draws unrelated pairs without ever asserting that
-- a pair is NOT related: an unattested edge is unattested, and scoring it 0 here is
-- the eval's convention, not a claim of refutation.
CREATE OR REPLACE FUNCTION ops.eval_ingest_fidelity_negatives(
    p_relation text, p_limit int DEFAULT 200)
    RETURNS TABLE(score float8)
    -- Both the shuffled vocabulary and final bounded sample use random(); preserve
    -- that deliberate per-call behavior with an explicit changing declaration.
    LANGUAGE sql VOLATILE
    AS $$
    WITH vocab AS (
        SELECT subject_id AS id FROM consensus.subjects_of_type(p_relation)
    ),
    samp AS (SELECT id, row_number() OVER (ORDER BY random()) AS rn FROM vocab),
    cnt  AS (SELECT count(*) AS c FROM samp),
    neg  AS (
        SELECT a.id AS w1, b.id AS w2
        FROM samp a JOIN samp b ON b.rn = a.rn + (SELECT c/2 FROM cnt)
    )
    SELECT ops.eval_pair_plane_score(
               p.w1, p.w2, laplace.relation_type_id(p_relation))
    FROM (SELECT w1, w2 FROM neg ORDER BY random() LIMIT p_limit) p
$$;
