-- The bounded receipt for ROUTE/SCAN. It exposes the exact typed consensus
-- edges admitted by the same crawl used to build the forward frontier. Resolved
-- prompt ids are the operand: text decomposition/coherence belongs to the caller
-- that owns the forward pass, not to a nested routing helper.
CREATE OR REPLACE FUNCTION generation.forward_route_trace_ids(
        p_seeds bytea[],
        p_hops int DEFAULT 2,
        p_fanout int DEFAULT 8,
        p_max_nodes int DEFAULT NULL)
    RETURNS TABLE(source_id bytea, type_id bytea, object_id bytea,
                  hop smallint, rating bigint, rd bigint,
                  witness_count bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
SELECT w.source_id, w.type_id, w.object_id, w.hop,
       w.rating, w.rd, w.witness_count
FROM consensus.explore_web(
    COALESCE(p_seeds, '{}'::bytea[]),
    p_hops, p_fanout, p_max_nodes) w
ORDER BY w.hop, w.source_id, w.type_id, w.object_id;
END;

-- ID-facing semantic frontier. The prompt's resolved constituents/senses are
-- already an operand here, so ROUTE/SCAN is one consensus.explore_web traversal.
-- The seeds themselves stay at hop zero; every routed endpoint carries the hop
-- reported by the same trace receipt above. A NULL node budget delegates exact
-- capacity to consensus.explore_web rather than inventing a second cap.
CREATE OR REPLACE FUNCTION generation.forward_frontier_ids(
        p_seeds bytea[],
        p_hops int DEFAULT 2,
        p_fanout int DEFAULT 8,
        p_max_nodes int DEFAULT NULL)
    RETURNS TABLE(entity bytea, hop smallint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
WITH seeds AS MATERIALIZED (
    SELECT DISTINCT u.entity
    FROM unnest(COALESCE(p_seeds, '{}'::bytea[])) u(entity)
    WHERE u.entity IS NOT NULL
), routed AS MATERIALIZED (
    SELECT w.*
    FROM generation.forward_route_trace_ids(
        COALESCE(p_seeds, '{}'::bytea[]), p_hops, p_fanout, p_max_nodes) w
), nodes AS (
    SELECT s.entity, 0::smallint AS hop FROM seeds s
    UNION ALL
    SELECT r.source_id, r.hop FROM routed r
    UNION ALL
    SELECT r.object_id, r.hop FROM routed r
)
SELECT n.entity, min(n.hop)::smallint AS hop
FROM nodes n
GROUP BY n.entity
ORDER BY min(n.hop), n.entity;
END;
