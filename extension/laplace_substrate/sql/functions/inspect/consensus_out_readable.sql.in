-- Declared unqualified, so it installed as laplace.consensus_out_readable while every caller
-- asks for ops.consensus_out_readable -- 42883 at runtime. See ops.evidence_receipt.
DROP FUNCTION IF EXISTS laplace.consensus_out_readable(bytea, integer);
CREATE OR REPLACE FUNCTION ops.consensus_out_readable(p_id bytea, p_limit integer DEFAULT 40)
    RETURNS TABLE(type text, object text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    -- Rank + LIMIT on bare ids in the inner query, render only the survivors (the define/examples
    -- pattern). realize.render() is a heavy non-inlinable call; at the same level as ORDER BY..LIMIT it was
    -- projected over EVERY out-edge of the subject before the cut — thousands of renders to return 40.
    WITH ranked AS MATERIALIZED (
        SELECT c.type_id, c.object_id, c.eff_mu, c.witness_count,
               consensus.edge_rank(c.type_id, c.eff_mu_raw) AS er
        FROM laplace.v_consensus_resolved c
        WHERE c.subject_id = p_id
        ORDER BY er DESC
        LIMIT p_limit
    ), numbered AS MATERIALIZED (
      SELECT s.*, row_number() OVER (ORDER BY s.er DESC,s.type_id,s.object_id) AS rn FROM ranked s
    ), batch AS MATERIALIZED (
      SELECT realize.render_batch(array_agg(type_id ORDER BY rn)) AS types,
             realize.render_batch(array_agg(object_id ORDER BY rn)) AS objects FROM numbered
    )
    SELECT b.types[s.rn], b.objects[s.rn], s.eff_mu, s.witness_count
    FROM numbered s CROSS JOIN batch b ORDER BY s.rn;
END;
