-- converse.compose(prompt, steps, lang, seed): S7 -- the walk frontier steers emission.
--
-- THE STAGE THIS ADDS. converse_walk already does "sequence proposes, meaning
-- steers", but its steer is a CONSTANT: every token of the topic's own gloss gets
-- weight 50, every token of a containing sentence gets 40, forever. That is a
-- provenance weight (which source did this token come from), not a semantic one --
-- it says nothing about whether a token is on-topic for THIS turn. The walker is
-- therefore unsteered in the only sense that matters, and the result is retrieval:
-- measured 2026-07-25, converse.walk('dog') returned the same byte-identical
-- sequence for seeds 7 and 991, i.e. it replays one attested sentence rather than
-- recombining. That constant IS the missing forward pass, and it is one array.
--
-- Here the weight vector is derived from the SEMANTIC FRONTIER instead: walk the
-- topic's consensus neighbourhood, and weight each stream token by how strongly the
-- concept it belongs to sits in that frontier. Sequence still proposes (the native
-- trigram->bigram backoff is untouched); meaning now actually steers, per emitted
-- step, against evidence computed for this turn.
--
-- WHY A SEPARATE FUNCTION. converse_walk stays exactly as it is. This is additive so
-- it can be measured against the incumbent on the same prompts and seeds before
-- anything is rewired. Editing the live path first is what shipped a regression
-- earlier in this session; the lesson is cheap to apply.
--
-- CONCEPT vs SURFACE (spec 36 §3.1). The frontier is concept-level and language-free.
-- Realization picks surfaces at the very end, honouring p_lang -- an ILI is an
-- equivalence class spanning every language that witnesses it, so nothing but the
-- final realize.render decides which member is emitted.
--
-- SCALING. consensus.eff_mu arrives in the fold's internal units (~1e12) and steered_walk_raw
-- wants an int8 weight multiplied by a 0..100000 hash. The /1e10 below is a UNITS
-- CONVERSION chosen so frontier salience lands in the same order of magnitude as the
-- existing provenance weights (40-50), not a tuning knob and not a floor -- it
-- rescales every candidate identically and changes no ordering. Non-frontier tokens
-- keep their provenance weight and stay eligible: weight 0 would exclude them
-- outright, since the native score is multiplicative.
--
-- NOT YET MEASURED. Written against the same stream/weights contract converse_walk
-- uses, but its output has NOT been compared to the incumbent. The gate is: does it
-- produce DIFFERENT text for different seeds (recombination rather than replay), and
-- does that text stay on topic. Do not wire this into converse.chat() until that run exists.
-- Signature change (p_ctx added): the 4-arg form must not survive as a second
-- overload or every 4-arg call site becomes "function is not unique".
CREATE OR REPLACE FUNCTION generation.compose_batch(p_prompt text,
                                                     p_steps int,
                                                     p_lang bytea,
                                                     p_seeds bigint[],
                                                     p_ctx bytea[] DEFAULT NULL)
    RETURNS TABLE(seed bigint, reply text)
    LANGUAGE sql VOLATILE
BEGIN ATOMIC
    WITH params AS MATERIALIZED (
        SELECT laplace.relation_band_types(1) AS t_def,
               laplace.relation_band_types(ARRAY[1,2,4,7]) AS t_band,
               generation.separator_ids() AS t_sep,
               (SELECT array_agg(DISTINCT p.id ORDER BY p.id)
                  FROM converse.prompt_words(p_prompt) p
                 WHERE p.id IS NOT NULL) AS prompt_ids
    ),
    elected AS MATERIALIZED (
        SELECT y.tok AS topic_word, y.syn
        FROM (
            SELECT DISTINCT ON (x.tok)
                   x.tok, x.syn, x.denote_mu, x.tok_breadth
            FROM (
                SELECT s.term AS tok, s.synset_id AS syn, s.eff_mu AS denote_mu,
                       max(consensus.highway_popcount(e.highway_mask))
                           OVER (PARTITION BY s.term) AS tok_breadth
                FROM lexical.senses_batch(ARRAY(
                    SELECT p.id FROM converse.prompt_state(p_prompt) p
                    WHERE p.id IS NOT NULL)) s
                LEFT JOIN laplace.entities e ON e.id = s.synset_id
                WHERE s.synset_id IS NOT NULL
            ) x
            ORDER BY x.tok, x.denote_mu DESC NULLS LAST, x.syn
        ) y
        ORDER BY y.tok_breadth DESC NULLS LAST, y.denote_mu DESC NULLS LAST, y.syn
        LIMIT 1
    ),
    frontier AS MATERIALIZED (
        SELECT f.cid, f.mu
        FROM elected el
        CROSS JOIN params pr
        CROSS JOIN LATERAL (
            SELECT c.object_id AS cid, consensus.eff_mu(c.rating, c.rd) AS mu
            FROM laplace.consensus c
            WHERE c.subject_id = el.syn AND c.type_id = ANY (pr.t_band)
            UNION ALL
            SELECT c.subject_id, consensus.eff_mu(c.rating, c.rd)
            FROM laplace.consensus c
            WHERE c.object_id = el.syn AND c.type_id = ANY (pr.t_band)
            UNION ALL
            SELECT el.syn, (SELECT max(consensus.eff_mu(c2.rating, c2.rd)) FROM laplace.consensus c2
                         WHERE c2.subject_id = el.syn)
            UNION ALL
            SELECT c.object_id, consensus.eff_mu(c.rating, c.rd) / (2 ^ x.dist)
            FROM unnest(COALESCE(p_ctx, ARRAY[]::bytea[])) WITH ORDINALITY x(cid, dist)
            JOIN laplace.consensus c ON c.subject_id = x.cid
                            AND c.type_id = ANY (pr.t_band)
            WHERE x.cid <> el.syn
            UNION ALL
            SELECT c.subject_id, consensus.eff_mu(c.rating, c.rd) / (2 ^ x.dist)
            FROM unnest(COALESCE(p_ctx, ARRAY[]::bytea[])) WITH ORDINALITY x(cid, dist)
            JOIN laplace.consensus c ON c.object_id = x.cid
                            AND c.type_id = ANY (pr.t_band)
            WHERE x.cid <> el.syn
            UNION ALL
            SELECT x.cid, (SELECT max(consensus.eff_mu(c2.rating, c2.rd)) FROM laplace.consensus c2
                           WHERE c2.subject_id = x.cid) / (2 ^ x.dist)
            FROM unnest(COALESCE(p_ctx, ARRAY[]::bytea[])) WITH ORDINALITY x(cid, dist)
            WHERE x.cid <> el.syn
        ) f
        WHERE el.syn IS NOT NULL
    ),
    frontier_agg AS MATERIALIZED (
        SELECT f.cid, max(f.mu) AS mu FROM frontier f GROUP BY f.cid
    ),
    context_gids AS MATERIALIZED (
        SELECT co.entity_id AS gid
        FROM elected el
        CROSS JOIN params pr
        CROSS JOIN LATERAL structural.containers_containing_all(pr.prompt_ids) co
        WHERE el.syn IS NOT NULL
    ),
    gids AS MATERIALIZED (
        SELECT DISTINCT g.gid, g.wt, g.is_core
        FROM elected el
        CROSS JOIN params pr
        CROSS JOIN LATERAL (
            SELECT c.object_id AS gid,
                   CASE WHEN EXISTS (SELECT 1 FROM context_gids)
                        THEN 40 ELSE 50 END::bigint AS wt,
                   NOT EXISTS (SELECT 1 FROM context_gids) AS is_core
            FROM laplace.consensus c
            WHERE c.subject_id = el.syn AND c.type_id = ANY (pr.t_def)
            UNION ALL
            SELECT cg.gid, 50, true
            FROM context_gids cg
        ) g
        WHERE el.syn IS NOT NULL
    ),
    toks AS (
        SELECT g.gid, g.wt, g.is_core, u.entity_id, u.ord
        FROM gids g
        CROSS JOIN LATERAL generation.trajectory_unpacked_points(g.gid)
             WITH ORDINALITY AS u(entity_id, run_length, ctier, ord)
        WHERE u.ctier = 2
    ),
    ws AS MATERIALIZED (
        SELECT DISTINCT t.entity_id AS id,
               t.entity_id = ANY (pr.t_sep) AS is_ws
        FROM toks t
        CROSS JOIN params pr
    ),
    kept AS MATERIALIZED (
        SELECT q.* FROM (
            SELECT t.gid, t.wt, t.is_core, t.entity_id,
                   row_number() OVER (PARTITION BY t.gid ORDER BY t.ord) AS rn,
                   count(*)    OVER (PARTITION BY t.gid) AS cnt
            FROM toks t JOIN ws ON ws.id = t.entity_id
            WHERE NOT ws.is_ws
        ) q WHERE q.cnt >= 2
    ),
    kept_ids AS MATERIALIZED (
        SELECT DISTINCT k.entity_id AS id FROM kept k
    ),
    sense_pick AS MATERIALIZED (
        SELECT DISTINCT ON (b.term) b.term, b.synset_id
        FROM taxonomy.bubble_up_batch(ARRAY(SELECT id FROM kept_ids)) b
        ORDER BY b.term, b.witnesses DESC, b.base_eff_mu DESC NULLS LAST, b.synset_id
    ),
    concept_map AS MATERIALIZED (
        SELECT k.id AS wid, COALESCE(sp.synset_id, k.id) AS cid
        FROM kept_ids k
        LEFT JOIN sense_pick sp ON sp.term = k.id
    ),
    seq AS MATERIALIZED (
        SELECT k.gid, k.is_core,
               k.wt + COALESCE((fa.mu / 1e10)::bigint, 0) AS wt,
               cm.cid AS id, k.rn
        FROM kept k
        JOIN concept_map cm ON cm.wid = k.entity_id
        LEFT JOIN frontier_agg fa ON fa.cid = cm.cid
        UNION ALL
        SELECT DISTINCT k.gid, k.is_core, 0::bigint, '\x00'::bytea, 2147483647::bigint
        FROM kept k
    ),
    corpus_arrays AS MATERIALIZED (
        SELECT (SELECT array_agg(s.id ORDER BY s.is_core DESC, s.gid, s.rn) FROM seq s) AS stream,
               (SELECT array_agg(s.wt ORDER BY s.is_core DESC, s.gid, s.rn) FROM seq s) AS w,
               (SELECT array_agg(k1.cid ORDER BY k1.is_core DESC, k1.gid)
                FROM (SELECT cm.cid, k0.is_core, k0.gid
                      FROM kept k0 JOIN concept_map cm ON cm.wid = k0.entity_id
                      WHERE k0.rn = 1
                      ORDER BY k0.is_core DESC, k0.gid) k1) AS starts,
               (SELECT array_agg(cm.cid ORDER BY k.rn)
                  FROM kept k JOIN concept_map cm ON cm.wid = k.entity_id
                 WHERE k.is_core AND k.gid = (
                     SELECT k2.gid FROM kept k2 WHERE k2.is_core
                     GROUP BY k2.gid ORDER BY max(k2.cnt) DESC, k2.gid LIMIT 1)) AS core_seq
    ),
    emitted AS MATERIALIZED (
        SELECT s.ord, s.seed,
               CASE
                   WHEN COALESCE(array_length(ca.stream, 1), 0) < 3 OR ca.starts IS NULL THEN NULL::bytea[]
                   ELSE converse.steered_walk_raw(
                       ca.stream, ca.w, COALESCE(ca.core_seq, ARRAY[]::bytea[]), ca.starts,
                       p_steps, 5,
                       abs(COALESCE(s.seed,
                           ('x'||substr(md5(p_prompt),1,8))::bit(32)::bigint)) % 2147483647
                   )
               END AS ids
        FROM unnest(p_seeds) WITH ORDINALITY AS s(seed, ord)
        CROSS JOIN corpus_arrays ca
    ),
    ids AS MATERIALIZED (
        SELECT array_agg(DISTINCT u.id) AS a
        FROM emitted e
        CROSS JOIN LATERAL unnest(e.ids) AS u(id)
    ),
    realized AS MATERIALIZED (
        SELECT i.a,
               realize.resolve_name_batch(i.a, p_lang) AS lbl,
               realize.render_text_batch(i.a) AS txt
        FROM ids i
    ),
    labels AS MATERIALIZED (
        SELECT (r.a)[k] AS id, (r.lbl)[k] AS lbl, (r.txt)[k] AS txt
        FROM realized r
        CROSS JOIN LATERAL generate_subscripts(r.a, 1) AS k
    )
    SELECT e.seed,
           CASE count(u.id)
               WHEN 0 THEN NULL::text
               WHEN 1 THEN max(l.txt)
               ELSE btrim(regexp_replace(
                        regexp_replace(
                            string_agg(COALESCE(l.lbl, l.txt, ''), ' ' ORDER BY u.ord),
                            '\s*[();:]\s*', ' ', 'g'),
                        '\s+', ' ', 'g'))
           END AS reply
    FROM emitted e
    LEFT JOIN LATERAL unnest(e.ids) WITH ORDINALITY AS u(id, ord) ON true
    LEFT JOIN labels l ON l.id = u.id
    GROUP BY e.ord, e.seed
    ORDER BY e.ord;
END;

DROP FUNCTION IF EXISTS laplace.converse_compose(text, int, bytea, bigint, bytea[]);
CREATE OR REPLACE FUNCTION converse.compose(p_prompt text,
                                            p_steps int DEFAULT 40,
                                            p_lang bytea DEFAULT NULL,
                                            p_seed bigint DEFAULT NULL,
                                            p_ctx bytea[] DEFAULT NULL)
    RETURNS text
    LANGUAGE sql VOLATILE
BEGIN ATOMIC
    SELECT b.reply
    FROM generation.compose_batch(
        p_prompt, p_steps, p_lang, ARRAY[p_seed]::bigint[], p_ctx) b
    LIMIT 1;
END;
