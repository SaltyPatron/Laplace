-- Write epoch for the bulk persist stage of ingest. Every write transaction
-- (apply control, parallel COPY, attestation merge, consensus fold segment,
-- highway-mask deposit) calls nextval BEFORE writing, so an apply that records
-- last_value after its commit and reads it again at its next apply knows how
-- many writes landed in between, less its own. Writers log that foreign delta
-- with each apply.
--
--   * Advances survive rollback and crash: an aborted write still moves the
--     epoch, so the delta over-counts foreign writes and never hides one.
--   * CACHE 1: per-session caching would let a bump be observed out of order
--     with its writes; delta = calls made holds only for uncached increments.
--
-- Writers check to_regclass once and log no delta when the sequence is absent.
-- No grants beyond the extension schema's: the write path connects as the
-- installing role.
CREATE SEQUENCE IF NOT EXISTS apply_write_epoch CACHE 1;

COMMENT ON SEQUENCE apply_write_epoch IS
    'Laplace: monotonic write-lane epoch. Every write-lane transaction calls '
    'nextval before writing; an unchanged last_value across a window proves no '
    'writer intervened. Advances survive rollback (conservative: aborted writes '
    'still force the next apply to re-probe).';
