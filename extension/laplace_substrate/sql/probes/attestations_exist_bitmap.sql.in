-- Presence bitmap for the persist stage of ingest. An attestation id alone
-- cannot prune HASH(subject_id), so the caller passes the subject (and type)
-- it already holds; parallel arrays, length-checked natively.
DROP FUNCTION IF EXISTS laplace.attestations_exist_bitmap(bytea[]);
CREATE OR REPLACE FUNCTION laplace.attestations_exist_bitmap(
    ids bytea[], type_ids bytea[], subject_ids bytea[])
    RETURNS bytea
    AS 'EXECUTION_LIBRARY', 'pg_laplace_attestations_exist_bitmap'
    LANGUAGE C STABLE;

-- Id-only overload: probes every leaf per id, so it is exact but unpruned.
-- Presence bits LSB-first within each byte, the native bitmap's layout.
CREATE OR REPLACE FUNCTION laplace.attestations_exist_bitmap_native(ids bytea[])
    RETURNS bytea
    AS 'EXECUTION_LIBRARY', 'pg_laplace_attestations_exist_bitmap_unkeyed'
    LANGUAGE C STABLE;

CREATE OR REPLACE FUNCTION laplace.attestations_exist_bitmap(ids bytea[])
    RETURNS bytea
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT laplace.attestations_exist_bitmap_native(
        array_replace(ids, NULL::bytea, ''::bytea));
END;
