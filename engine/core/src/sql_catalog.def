    "tenant=EXCLUDED.tenant,service_id=EXCLUDED.service_id,units=EXCLUDED.units,amount_cents=EXCLUDED.amount_cents,"
    "currency=EXCLUDED.currency,status=EXCLUDED.status,consumed=EXCLUDED.consumed,"
    "stripe_session_id=EXCLUDED.stripe_session_id,stripe_checkout_url=EXCLUDED.stripe_checkout_url,"
    "created_at=EXCLUDED.created_at,expires_at=EXCLUDED.expires_at")
