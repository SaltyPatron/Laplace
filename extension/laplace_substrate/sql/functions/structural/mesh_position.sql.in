-- A node's position in the semantic mesh. IDs are selected and ranked first;
-- every display label is resolved in one position-aligned batch at the edge.
DROP FUNCTION IF EXISTS laplace.mesh_position(p_id bytea);
CREATE OR REPLACE FUNCTION structural.mesh_position(p_id bytea)
    RETURNS TABLE(dir text, id bytea, label text, relation text,
                  hub_type text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE AS $$
    WITH self_hub AS MATERIALIZED (
        SELECT (SELECT t.object_id
                FROM laplace.consensus t
                WHERE t.subject_id=p_id AND t.type_id=laplace.relation_type_id('IS_TYPED_AS')
                ORDER BY consensus.eff_mu(t.rating,t.rd) DESC, t.object_id LIMIT 1) AS object_id
    ), sense_rows AS MATERIALIZED (
        SELECT s.synset_id AS id, s.eff_mu, s.witnesses,
               row_number() OVER (ORDER BY s.eff_mu DESC NULLS LAST, s.synset_id) AS ord
        FROM lexical.senses(p_id) s
        WHERE NOT EXISTS (
          SELECT 1 FROM laplace.consensus t
          WHERE t.subject_id=p_id AND t.type_id=laplace.relation_type_id('IS_TYPED_AS')
            AND consensus.eff_mu(t.rating,t.rd)>0)
    ), up_rows AS MATERIALIZED (
        SELECT c.object_id AS id, c.type_id,
               (SELECT t.object_id FROM laplace.consensus t
                WHERE t.subject_id=c.object_id
                  AND t.type_id=laplace.relation_type_id('IS_TYPED_AS')
                ORDER BY consensus.eff_mu(t.rating,t.rd) DESC, t.object_id LIMIT 1) AS hub_id,
               consensus.eff_mu_display(c.rating,c.rd) AS eff_mu, c.witness_count,
               row_number() OVER (ORDER BY consensus.eff_mu_display(c.rating,c.rd) DESC NULLS LAST,
                                           c.object_id) AS ord
        FROM laplace.consensus c
        WHERE c.subject_id=p_id
          AND c.type_id IN (laplace.relation_type_id('IS_SENSE_OF'),
                            laplace.relation_type_id('HAS_SENSE'),
                            laplace.relation_type_id('EVOKES_FRAME'),
                            laplace.relation_type_id('MEMBER_OF_VERBNET_CLASS'),
                            laplace.relation_type_id('IS_INSTANCE_OF'),
                            laplace.relation_type_id('IS_A'),
                            laplace.relation_type_id('CORRESPONDS_TO'),
                            laplace.relation_type_id('HAS_SEMANTIC_ROLE'))
        ORDER BY eff_mu DESC NULLS LAST, c.object_id LIMIT 40
    ), down_rows AS MATERIALIZED (
        SELECT m.member AS id, m.kind, m.mu, m.witnesses,
               row_number() OVER (ORDER BY m.mu DESC NULLS LAST, m.member) AS ord
        FROM lexical.concept_members(p_id) m
        ORDER BY m.mu DESC NULLS LAST, m.member LIMIT 60
    ), raw AS MATERIALIZED (
        SELECT 0 AS branch, 0::bigint AS ord, 'self'::text AS dir, p_id AS id,
               NULL::text AS relation, h.object_id AS hub_id, NULL::text AS hub_literal,
               NULL::numeric AS eff_mu, NULL::bigint AS witnesses FROM self_hub h
        UNION ALL
        SELECT 1, s.ord, 'up', s.id, 'has sense', NULL, 'WordNet_Synset', s.eff_mu, s.witnesses
        FROM sense_rows s
        UNION ALL
        SELECT 2, u.ord, 'up', u.id, consensus.relation_canonical(u.type_id),
               u.hub_id, NULL, u.eff_mu, u.witness_count FROM up_rows u
        UNION ALL
        SELECT 3, d.ord, 'down', d.id, d.kind, NULL, NULL, d.mu, d.witnesses FROM down_rows d
    ), ids AS MATERIALIZED (
        SELECT array_agg(DISTINCT id ORDER BY id) AS a
        FROM (SELECT id FROM raw UNION SELECT hub_id FROM raw WHERE hub_id IS NOT NULL) x
    ), labels AS MATERIALIZED (
        SELECT i.id, l.txt FROM ids,
          LATERAL unnest(ids.a) WITH ORDINALITY i(id, ord),
          LATERAL unnest(realize.label_batch(ids.a)) WITH ORDINALITY l(txt, ord)
        WHERE i.ord=l.ord
    )
    SELECT r.dir, r.id, n.txt, r.relation,
           COALESCE(r.hub_literal, h.txt), r.eff_mu, r.witnesses
    FROM raw r JOIN labels n ON n.id=r.id LEFT JOIN labels h ON h.id=r.hub_id
    ORDER BY r.branch, r.ord
$$;
