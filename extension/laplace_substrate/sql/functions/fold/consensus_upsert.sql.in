-- Inline consensus admission is owned by src/fold_route.c.
--
-- The canonical layout is HASH(subject_id), shared by testimony and standing.
-- merge_evidence routes a complete mixed-relation working set through PostgreSQL's
-- partition hash once. Prior reads, retained-evidence reads and matched writes
-- address the owning physical leaves; relation vocabulary never multiplies those
-- statements. Parent ACL/RLS semantics retain a normal parent-read fallback.
-- Novel standing uses native COPY, matched standing uses one keyed UPDATE per leaf.
--
-- Existing cells are row-locked. Disjoint subjects sharing a relation stay
-- concurrent. A simultaneous novel insert is arbitrated by the declared PK;
-- 23505 rolls back the evidence transaction and the admission owner retries it
-- through the same policy as entity/attestation COPY races. The journal receipt,
-- testimony, fold and completion therefore still commit together.
--
-- Explicit period APIs and retained-testimony refold share the existing native
-- glicko2 kernels. Cell identity is the same core BLAKE3 preimage the SQL
-- consensus_id wrapper uses. Duplicate requested cells are a cardinality error.
-- No function-local planner settings override the caller's plan policy.
--
-- NO mask queue here: the caller deposits highway bits INLINE for this same
-- delta (consensus.highway_mask_deposit); highway_mask_dirty is populated only by the
-- repair verbs, which need to CLEAR bits (per-source evict) — something an
-- OR-accumulate deposit cannot express.
--
-- Explicit-delta contract (used for non-durable folds and transient evidence):
--   * arrays are parallel and CLIENT-DEDUPED per call — one row per
--     (subject, type, object) cell;
--   * each cell carries exact grouped (opponent rating, phi, games, score sum)
--     rating-period inputs through the flat group arrays and offsets;
--   * rows arrive sorted by (type, id, subject); the
--     router only needs same-type rows ADJACENT and remains correct (merely
--     one extra plan execution) if they are not.
DROP FUNCTION IF EXISTS laplace.consensus_upsert(bytea[], bytea[], bytea[], bigint[], bigint[], bigint[], timestamptz[]);
-- The 7-arg forms are DROPPED, not left alongside: adding a DEFAULTed parameter
-- via CREATE OR REPLACE would leave the old arity resident as a separate
-- overload, and a 7-argument call would then be ambiguous.
DROP FUNCTION IF EXISTS consensus.upsert(bytea[], bytea[], bytea[], bigint[], bigint[], bigint[], timestamptz[]);
DROP FUNCTION IF EXISTS consensus.upsert(bytea[], bytea[], bytea[], bigint[], bigint[], bigint[], timestamptz[], bigint[]);
DROP FUNCTION IF EXISTS consensus.upsert_type(bytea, bytea[], bytea[], bigint[], bigint[], bigint[], timestamptz[]);
DROP FUNCTION IF EXISTS consensus.upsert_type(bytea, bytea[], bytea[], bigint[], bigint[], bigint[], timestamptz[], bigint[]);
CREATE OR REPLACE FUNCTION consensus.upsert(
    p_subjects bytea[],
    p_types    bytea[],
    p_objects  bytea[],
    p_phis     bigint[],
    p_games    bigint[],
    p_sums     bigint[],
    p_ts       timestamptz[],
    -- The opponent each witness presents (GH #1321). DEFAULT NULL so every
    -- existing caller keeps folding against neutral, unchanged, until it starts
    -- passing attestations.opponent_rating_fp1e9.
    p_opp_ratings bigint[] DEFAULT NULL,
    -- Exact rating-period groups are flat arrays. offsets has one entry per
    -- cell plus a terminal entry; each cell owns [offsets[i], offsets[i+1]).
    -- Omitting all five preserves the historical one-opponent-per-cell API.
    p_period_offsets bigint[] DEFAULT NULL,
    p_period_opp_ratings bigint[] DEFAULT NULL,
    p_period_phis bigint[] DEFAULT NULL,
    p_period_games bigint[] DEFAULT NULL,
    p_period_sums bigint[] DEFAULT NULL)
    RETURNS bigint
    AS 'EXECUTION_LIBRARY', 'pg_laplace_consensus_upsert'
    LANGUAGE C VOLATILE;

-- Direct routed form for first-party type lanes. The type is part of every cell
-- identity but is transmitted once per set operation, not once per row.
CREATE OR REPLACE FUNCTION consensus.upsert_type(
    p_type     bytea,
    p_subjects bytea[],
    p_objects  bytea[],
    p_phis     bigint[],
    p_games    bigint[],
    p_sums     bigint[],
    p_ts       timestamptz[],
    p_opp_ratings bigint[] DEFAULT NULL,
    p_period_offsets bigint[] DEFAULT NULL,
    p_period_opp_ratings bigint[] DEFAULT NULL,
    p_period_phis bigint[] DEFAULT NULL,
    p_period_games bigint[] DEFAULT NULL,
    p_period_sums bigint[] DEFAULT NULL)
    RETURNS bigint
    AS 'EXECUTION_LIBRARY', 'pg_laplace_consensus_upsert_type'
    LANGUAGE C VOLATILE;


-- Primary evidence admission boundary. The complete mixed-type working-set
-- chunk crosses the client/database boundary once. Native routing retains
-- literal type partition pruning while locking, reducing, and merging each
-- physical type run inside that single operation.
CREATE OR REPLACE FUNCTION consensus.merge_evidence(
    p_subjects bytea[], p_types bytea[], p_objects bytea[],
    p_phis bigint[], p_games bigint[], p_sums bigint[], p_ts timestamptz[],
    p_opp_ratings bigint[] DEFAULT NULL,
    p_period_offsets bigint[] DEFAULT NULL,
    p_period_opp_ratings bigint[] DEFAULT NULL,
    p_period_phis bigint[] DEFAULT NULL,
    p_period_games bigint[] DEFAULT NULL,
    p_period_sums bigint[] DEFAULT NULL)
    RETURNS bigint
    AS 'EXECUTION_LIBRARY', 'pg_laplace_consensus_merge_evidence'
    LANGUAGE C VOLATILE;


-- Atomic evidence-backed route. Every requested cell must already have durable
-- accepted testimony in the caller's transaction. The native owner locks the
-- complete canonical target set, then reads a fresh READ COMMITTED snapshot.
-- Fully replayable cells use the same neutral consensus_fold as source refold,
-- with total witness count and maximum observation time from retained A.
-- Any retained non-replayable receipt preserves the exact incoming-score delta
-- against the stored prior. Such continuous testimony is not score-replayable.
-- No neutral placeholder survives a successful call. REPEATABLE READ and
-- SERIALIZABLE callers must retry the whole evidence transaction at READ COMMITTED.
CREATE OR REPLACE FUNCTION consensus.upsert_evidence_type(
    p_type bytea, p_subjects bytea[], p_objects bytea[],
    p_phis bigint[], p_games bigint[], p_sums bigint[], p_ts timestamptz[],
    p_opp_ratings bigint[] DEFAULT NULL,
    p_period_offsets bigint[] DEFAULT NULL,
    p_period_opp_ratings bigint[] DEFAULT NULL,
    p_period_phis bigint[] DEFAULT NULL,
    p_period_games bigint[] DEFAULT NULL,
    p_period_sums bigint[] DEFAULT NULL)
    RETURNS bigint
    AS 'EXECUTION_LIBRARY', 'pg_laplace_consensus_upsert_evidence_type'
    LANGUAGE C VOLATILE;


-- Repair has no incoming score delta. It shares the same canonical target
-- locks, fresh snapshot, native aggregate and result persistence as admission,
-- and refuses any complete cell containing non-replayable testimony.
CREATE OR REPLACE FUNCTION consensus.refold_evidence_type(
    p_type bytea, p_subjects bytea[], p_objects bytea[])
    RETURNS bigint
    AS 'EXECUTION_LIBRARY', 'pg_laplace_consensus_refold_evidence_type'
    LANGUAGE C VOLATILE;

-- Retraction uses the same row locks and fresh retained-evidence snapshot as
-- admission/refold. Return [survivor cells refolded, empty cells deleted]; no
-- neutral placeholder or old aggregate may survive a successful call.
CREATE OR REPLACE FUNCTION consensus.refold_after_retraction_type(
    p_type bytea, p_subjects bytea[], p_objects bytea[])
    RETURNS bigint[]
    AS 'EXECUTION_LIBRARY', 'pg_laplace_consensus_refold_after_retraction_type'
    LANGUAGE C VOLATILE;

-- The physical owner of one consensus key, resolved by the same PostgreSQL
-- partition support function as the native ingest writer.  This is the single
-- routing authority for the rare non-ingest mutations (decay, source eviction):
-- callers mutate ONLY the returned leaf and never plan against the parent.
CREATE OR REPLACE FUNCTION consensus.partition_leaf(
    p_type bytea,
    p_subject bytea)
    RETURNS regclass
    AS 'EXECUTION_LIBRARY', 'pg_laplace_consensus_partition_leaf'
    LANGUAGE C STABLE STRICT PARALLEL RESTRICTED;
