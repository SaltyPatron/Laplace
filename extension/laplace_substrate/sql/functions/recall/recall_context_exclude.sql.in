DROP FUNCTION IF EXISTS laplace.recall_context_exclude(text, bytea);
CREATE OR REPLACE FUNCTION converse.recall_context_exclude(p_prompt text, p_topic bytea)
    RETURNS bytea[]
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT COALESCE(array_agg(ps.id), ARRAY[]::bytea[])
    FROM converse.prompt_state(p_prompt) ps
    WHERE ps.id <> p_topic;
END;
