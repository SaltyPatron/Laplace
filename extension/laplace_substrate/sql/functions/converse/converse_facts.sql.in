-- converse_facts(syn, lang): the walk-driven fact set behind converse_about() --
-- one row per attested fact family, each carrying its provenance (eff_mu,
-- witnesses) and, for walk-built rows, the literal path/types so a caller can
-- drill to the exact consensus edges that produced the sentence.
--
-- Fact families, by salience band (the governed language-agnostic ladder):
--   definition  band 1 top edge                      "X is <gloss>."
--   taxonomy    MULTI-HOP native beam walk up the    "X is a kind of A, which is
--               topic's strongest taxonomic relation  a kind of B."
--   parts       band 4 ranked listing                "X has parts such as a, b."
--   kin         band 7 ranked listing                "X is related to a and b."
--   web         strongest unfiltered chain           "X -IS_A-> A -HAS_PART-> b"
--
-- The taxonomy row is the beam engine (walk_branches: Glicko-complete signed
-- weight, partition-pruned by a CONCRETE relation type) -- the topic's own
-- strongest band-2 edge picks that type, so no relation name is hardcoded and
-- the partition-pruning law from recall_walk_response.sql.in holds. The web row
-- uses walk_strongest, the correct engine for the type-unfiltered case. The
-- listing rows are 1-hop by nature (a parts inventory IS its ranked edges);
-- LIMIT here is a query limit, not a truncation of what the source asserts.
-- eff_mu for a chain = the weakest edge on it (a chain is only as certain as
-- its loosest strand).
CREATE OR REPLACE FUNCTION converse_facts(p_syn bytea, p_lang bytea DEFAULT NULL)
    RETURNS TABLE(fact_kind text, sentence text, eff_mu numeric, witnesses bigint,
                  path bytea[], types bytea[])
    LANGUAGE plpgsql STABLE
    SET search_path = @extschema@, public AS $$
DECLARE
    b_def  int := 1;   -- definitional band (gloss)
    b_tax  int := 2;   -- taxonomic band (is-a / hypernym)
    b_part int := 4;   -- partitive band (parts)
    b_assoc int := 7;  -- associative band (related)
    v_lbl    text;
    tax_type bytea;
BEGIN
    IF p_syn IS NULL THEN
        RETURN;
    END IF;

    v_lbl := COALESCE(realize(p_syn, p_lang), label(p_syn));

    -- definition: highest eff_mu edge in the definitional band.
    RETURN QUERY
    SELECT 'definition'::text,
           initcap(v_lbl) || ' is ' || render_text(c.object_id, 96) || '.',
           eff_mu_display(c.rating, c.rd),
           c.witness_count::bigint,
           ARRAY[c.subject_id, c.object_id],
           ARRAY[c.type_id]
    FROM consensus c
    WHERE c.subject_id = p_syn AND relation_highway_band(c.type_id) = b_def
    ORDER BY eff_mu(c.rating, c.rd) DESC
    LIMIT 1;

    -- taxonomy: multi-hop beam walk up the topic's strongest HYPERNYMY relation.
    -- FAMILY, not band. The taxonomic BAND ranks importance and contains more than
    -- hypernymy -- MEMBER_OF_VERBNET_CLASS is its own family_root at taxonomic rank,
    -- so a band-2 pick rendered class membership through the "is a kind of" frame:
    -- "Hound is a kind of Cotheme", "a kind of bully-59.5" (observed after the
    -- wiktionary seed). Bands say how much a relation matters; families say what it
    -- MEANS, and only the IS_A family means hypernymy.
    SELECT c.type_id INTO tax_type
    FROM consensus c
    WHERE c.subject_id = p_syn
      AND c.type_id IN (SELECT id FROM relation_family_members('IS_A'))
    ORDER BY eff_mu(c.rating, c.rd) DESC
    LIMIT 1;
    -- NO band fallback. An earlier revision fell back to the taxonomic BAND when the
    -- topic had no IS_A-family edge, "so it still says something rather than going
    -- silent" -- which reintroduced the exact defect: the fallback picked
    -- MEMBER_OF_VERBNET_CLASS and rendered "Bait is a kind of butter-9.9".
    -- Abstention is a real answer here. A concept with no witnessed hypernymy has no
    -- hypernym to report, and emitting a class id inside the "is a kind of" frame is
    -- a false statement, not a graceful degradation. tax_type stays NULL and the
    -- taxonomy row is simply omitted.
    IF tax_type IS NOT NULL THEN
        RETURN QUERY
        WITH branches AS (
            SELECT * FROM walk_branches(p_syn, tax_type, 4, 3)
        ),
        winner AS (
            -- Deepest chain first: the beam never walks a refuted or
            -- non-positive edge, so every placed node sits on a confirmed
            -- chain and depth IS ancestry. Average per-hop confidence only
            -- breaks ties between equally deep chains (an avg-first order
            -- degenerates to depth 1 whenever edge strength declines with
            -- distance, which taxonomies always do).
            SELECT * FROM branches w
            ORDER BY w.depth DESC, (w.path_mu / GREATEST(w.depth, 1)::numeric) DESC
            LIMIT 1
        ),
        steps AS (
            SELECT i, w.path[i + 1] AS entity_id
            FROM winner w, generate_series(1, w.depth) AS i
        )
        SELECT 'taxonomy'::text,
               initcap(v_lbl)
                 || string_agg(CASE WHEN s.i = 1 THEN ' is a kind of '
                                    ELSE ', which is a kind of ' END
                               || COALESCE(realize(s.entity_id, p_lang), label(s.entity_id)),
                               '' ORDER BY s.i)
                 || '.',
               min(b.eff_mu),
               (SELECT w.witnesses FROM winner w),
               (SELECT w.path  FROM winner w),
               (SELECT w.types FROM winner w)
        FROM steps s
        JOIN branches b ON b.entity_id = s.entity_id AND b.depth = s.i
        HAVING count(*) > 0;
    END IF;

    -- parts: partitive-band ranked listing (1-hop by nature).
    RETURN QUERY
    SELECT 'parts'::text,
           initcap(v_lbl) || ' has parts such as '
             || string_agg(x.lbl, ', ' ORDER BY x.mu DESC) || '.',
           min(x.mu_disp),
           sum(x.wc)::bigint,
           NULL::bytea[], NULL::bytea[]
    FROM (
        SELECT realize(c.object_id, p_lang) AS lbl,
               eff_mu(c.rating, c.rd) AS mu,
               eff_mu_display(c.rating, c.rd) AS mu_disp,
               c.witness_count AS wc
        FROM consensus c
        WHERE c.subject_id = p_syn AND relation_highway_band(c.type_id) = b_part
        ORDER BY eff_mu(c.rating, c.rd) DESC
        LIMIT 6
    ) x
    WHERE x.lbl IS NOT NULL
    HAVING count(*) > 0;

    -- kin: associative-band ranked listing, MINUS the associative families that are
    -- not semantic relatedness. The band is a salience rank, and after the wiktionary
    -- seed it carries HAS_ETYMOLOGY (+ its ETYMOLOGICALLY_* children), HAS_EXAMPLE,
    -- HAS_USAGE_REGISTER and HAS_LEX_CATEGORY alongside real kin -- which rendered
    -- "Hound is related to trace and hounden and *hund and *hundaz and archaic":
    -- proto-form reconstructions and register labels presented as things a dog is
    -- related to. Etymology is descent, not relatedness; an example is usage, not kin.
    --
    -- Excluded in ID SPACE, before anything is rendered. The old `label_is_content`
    -- filter ran on the RENDERED string to drop bare ILI ids and lexfile names --
    -- a stoplist in disguise, and a render call in the middle of a hash-space
    -- operation. Selecting families up front removes the reason it existed; it is
    -- retained only as a last-resort guard at the point of rendering.
    RETURN QUERY
    SELECT 'kin'::text,
           initcap(v_lbl) || ' is related to '
             || string_agg(x.lbl, ' and ' ORDER BY x.mu DESC) || '.',
           min(x.mu_disp),
           sum(x.wc)::bigint,
           NULL::bytea[], NULL::bytea[]
    FROM (
        SELECT realize(c.object_id, p_lang) AS lbl,
               eff_mu(c.rating, c.rd) AS mu,
               eff_mu_display(c.rating, c.rd) AS mu_disp,
               c.witness_count AS wc
        FROM consensus c
        WHERE c.subject_id = p_syn
          AND relation_highway_band(c.type_id) = b_assoc
          AND c.type_id NOT IN (SELECT id FROM non_kin_assoc_types())
        ORDER BY eff_mu(c.rating, c.rd) DESC
        LIMIT 8
    ) x
    WHERE label_is_content(x.lbl)
    HAVING count(*) > 0;

    -- web: the strongest chain across ALL relations -- the explicit
    -- pull-one-strand answer, rendered with its relation arrows.
    RETURN QUERY
    -- Third hand-rolled arrow render, now the installed one (GH #906 item 2).
    -- walk_strongest walks forward, so every direction is 1. This also unifies the
    -- glyphs: this copy drew ASCII ' -type-> ' where realize_path and both walk
    -- responders draw ' —type→ ', so one substrate spoke two arrow dialects
    -- depending on which surface answered.
    SELECT 'web'::text,
           realize_path(
               p_syn || array_agg(g.entity_id ORDER BY g.step),
               array_agg(g.type_id ORDER BY g.step),
               array_fill(1, ARRAY[count(*)::int]),
               p_lang),
           min(g.eff_mu),
           NULL::bigint,
           NULL::bytea[], NULL::bytea[]
    FROM walk_strongest(p_syn, NULL, 5) g
    HAVING count(*) > 0;
END;
$$;
