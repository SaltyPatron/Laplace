-- consensus: the folded standing of every typed triple, HASH-partitioned on
-- subject_id like entities are on id. A subject's whole star (every relation,
-- every object) lives in one leaf, so the sparse indexed star that expansion
-- reads from a subject prunes to exactly one partition. Relation types are
-- content ids and unbounded; the layout never depends on which relations exist.
-- Leaf count is declared once here; native routing reads it from the partition
-- descriptor.
--
-- PK includes the partition key (PG rule for unique constraints on partitioned
-- tables); id stays unique by construction (id = hash(subject, type, object)).
--
-- No FKs: referential integrity is structural (content-addressed ids).
CREATE TABLE IF NOT EXISTS consensus (
    id                bytea       NOT NULL CHECK (octet_length(id) = 16),
    subject_id        bytea       NOT NULL,
    type_id           bytea       NOT NULL,
    object_id         bytea,
    rating            bigint      NOT NULL,
    rd                bigint      NOT NULL CHECK (rd > 0),
    volatility        bigint      NOT NULL CHECK (volatility > 0),
    witness_count     bigint      NOT NULL DEFAULT 1 CHECK (witness_count >= 0),
    last_observed_at  timestamptz NOT NULL,
    PRIMARY KEY (id, type_id, subject_id)
) PARTITION BY HASH (subject_id);

DO $$
DECLARE
    b int;
    suffix text;
    strategy "char";
    opts constant text := ' SET (autovacuum_analyze_scale_factor = 0.02, autovacuum_analyze_threshold = 100000)';
BEGIN
    SELECT p.partstrat INTO strategy
    FROM pg_partitioned_table p
    WHERE p.partrelid = (current_schema() || '.consensus')::regclass;
    IF strategy IS DISTINCT FROM 'h' THEN
        RAISE EXCEPTION
            'consensus uses an obsolete partition layout; this version requires HASH(subject_id). Create a new canonical database.';
    END IF;
    IF to_regclass(current_schema() || '.consensus_h00') IS NOT NULL THEN
        RETURN;
    END IF;
    FOR b IN 0..63 LOOP
        suffix := lpad(to_hex(b), 2, '0');
        EXECUTE format('CREATE TABLE consensus_h%s PARTITION OF consensus FOR VALUES WITH (MODULUS 64, REMAINDER %s)',
                       suffix, b);
        EXECUTE format('ALTER TABLE consensus_h%s', suffix) || opts;
    END LOOP;
END $$;


-- The PK leads on id only because a unique constraint on a partitioned table
-- must contain the partition key; no read seeks consensus by row id. Every star
-- read filters on subject_id, so its access paths are the subject-leading
-- indexes in indexes/consensus_subject_*.
SELECT pg_extension_config_dump('consensus', '');
