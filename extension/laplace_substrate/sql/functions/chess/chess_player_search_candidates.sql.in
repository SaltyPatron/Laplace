DROP FUNCTION IF EXISTS chess.player_search_candidates(text, integer);
DROP FUNCTION IF EXISTS chess.player_search_candidates(text[], integer);
CREATE OR REPLACE FUNCTION chess.player_search_candidates(
    p_queries text[], p_limit integer DEFAULT 600, p_offset integer DEFAULT 0,
    p_sort text DEFAULT 'strength', p_direction text DEFAULT 'desc',
    p_exact_only boolean DEFAULT false)
    RETURNS TABLE(player_id bytea, name text, games bigint,
                  rating double precision, rd double precision, eff_mu double precision)
    AS 'MODULE_PATHNAME', 'pg_laplace_chess_search_candidates'
    LANGUAGE C STABLE PARALLEL RESTRICTED;
