/* Query key, positional PostgreSQL parameter types, statement text.
 * This is the sole statement owner for migrated native and app query paths. */
SQL_QUERY("browse.containing", "bytea[]",
    "SELECT entity_id FROM structural.containers_containing_all($1)")
SQL_QUERY("browse.names", "bytea[]",
    "SELECT subject_id, object_id, rating, rd, witness_count FROM laplace.consensus "
    "WHERE object_id = ANY($1) AND type_id = ANY("
    "consensus.relation_family_ids('HAS_NAME') || consensus.relation_family_ids('HAS_NAME_ALIAS'))")
SQL_QUERY("entity.facets", "bytea[]",
    "SELECT id, tier, type_id FROM laplace.entities WHERE id = ANY($1)")
SQL_QUERY("browse.page", "bytea[],bytea,int4,int4,int4",
    "SELECT entity_id, tier, type_id, matched_name_id, match_kind, "
    "rating, rd, eff_mu, witness_count, candidate_name_count, candidate_truncated, matched_entity_count "
    "FROM consensus.browse_named_entities($1,$2,$3,$4,$5)")
SQL_QUERY("display.labels", "bytea[]",
    "SELECT encode(d.id, 'hex'), d.label, d.tier FROM realize.display_label_batch($1) d")
SQL_QUERY("containers.page", "bytea,int4,int4",
    "SELECT entity_id, tier, type_id, hops FROM structural.containers_of($1,$2,$3)")
SQL_QUERY("containers.parents", "bytea[]",
    "SELECT entity_id FROM laplace.physicalities WHERE type=1 AND trajectory IS NOT NULL "
    "AND public.laplace_trajectory_constituent_ids(trajectory) && $1")
SQL_QUERY("types.labels", "bytea[]",
    "SELECT lexical.type_label_batch($1)")
SQL_QUERY("generation.separators", "", "SELECT generation.separator_ids()")
SQL_QUERY("generation.adjacency_manifests", "bytea[],int4",
    "SELECT entity_id,public.ST_AsBinary(trajectory) FROM laplace.physicalities "
    "WHERE type=1 AND trajectory IS NOT NULL "
    "AND public.laplace_trajectory_constituent_ids(trajectory) && $1 LIMIT $2")
SQL_QUERY("display.facets", "bytea[]",
    "SELECT e.id,e.tier,e.type_id,e.first_observed_by,c.name FROM laplace.entities e "
    "LEFT JOIN laplace.canonical_names c ON c.id=e.id WHERE e.id=ANY($1)")
SQL_QUERY("display.names", "bytea[]", "SELECT realize.resolve_name_batch($1)")
SQL_QUERY("display.text", "bytea[]", "SELECT realize.render_text_batch($1)")
SQL_QUERY("display.metadata_labels", "bytea[]", "SELECT realize.label_batch($1)")
SQL_QUERY("display.file_metadata", "bytea[]",
    "SELECT subject_id,object_id,last_observed_at,id FROM laplace.attestations "
    "WHERE subject_id=ANY($1) AND object_id IS NOT NULL AND type_id=realize.canonical_id("
    "concat_ws('/','substrate','type','HasFileMetadata','v1'))")
SQL_QUERY("display.definition_types", "", "SELECT id FROM consensus.relation_family_members('HAS_DEFINITION')")
SQL_QUERY("display.definitions", "bytea[],bytea[]",
    "SELECT subject_id,object_id,last_observed_at,id FROM laplace.attestations "
    "WHERE subject_id=ANY($1) AND type_id=ANY($2) AND object_id IS NOT NULL")
SQL_QUERY("display.definition_owners", "bytea[],bytea[]",
    "SELECT object_id,object_id,last_observed_at,id FROM laplace.attestations "
    "WHERE object_id=ANY($1) AND type_id=ANY($2)")
SQL_QUERY("display.heads", "bytea[]",
    "SELECT entity_id,id,public.ST_AsBinary(public.ST_PointN(trajectory,1)) "
    "FROM laplace.physicalities WHERE entity_id=ANY($1) AND type=1 AND trajectory IS NOT NULL")
SQL_QUERY("chess.repair_normalize", "bytea[],bytea[]",
    "UPDATE laplace.attestations SET opponent_rating_fp1e9 = consensus.glicko2_neutral_mu() "
        "WHERE subject_id = ANY($1) AND type_id = ANY($2) "
        "AND opponent_rating_fp1e9 <> consensus.glicko2_neutral_mu()")
SQL_QUERY("consensus.repair_evidence", "bytea[],bytea[]",
    "SELECT subject_id,type_id,object_id,id,observation_count,sum_score_fp1e9,"
        "opponent_rd_fp1e9,last_observed_at,fold_replayable,opponent_rating_fp1e9 FROM laplace.attestations "
        "WHERE subject_id = ANY($1) AND type_id = ANY($2)")
SQL_QUERY("consensus.repair_write", "bytea[],bytea[],bytea[],int8[],int8[],int8[],int8[],timestamptz[]",
    "INSERT INTO laplace.consensus AS c (id,subject_id,type_id,object_id,rating,rd,volatility,witness_count,last_observed_at) "
        "SELECT laplace.consensus_id(b.subject,b.type,b.object),b.* FROM "
        "unnest($1,$2,$3,$4,$5,$6,$7,$8) b(subject,type,object,rating,rd,volatility,witness_count,last_observed_at) "
        "ON CONFLICT(id,type_id,subject_id) DO UPDATE SET rating=EXCLUDED.rating,rd=EXCLUDED.rd,"
        "volatility=EXCLUDED.volatility,witness_count=EXCLUDED.witness_count,last_observed_at=EXCLUDED.last_observed_at "
        "WHERE ROW(c.rating,c.rd,c.volatility,c.witness_count,c.last_observed_at) IS DISTINCT FROM "
        "ROW(EXCLUDED.rating,EXCLUDED.rd,EXCLUDED.volatility,EXCLUDED.witness_count,EXCLUDED.last_observed_at)")

SQL_QUERY("chess.roster_types", "", "SELECT laplace.entity_type_id('Chess_Player'),laplace.relation_type_id('OUTCOME'),laplace.entity_type_id('Chess_Result'),consensus.glicko2_neutral_mu(),consensus.glicko2_initial_rd()")
SQL_QUERY("chess.roster_unrated", "bytea,bytea,bytea,int8",
    "SELECT e.id FROM laplace.entities e LEFT JOIN laplace.consensus c "
    "ON c.subject_id=e.id AND c.type_id=$2 AND c.object_id=$3 "
    "WHERE e.type_id=$1 AND c.id IS NULL ORDER BY e.id LIMIT $4")
SQL_QUERY("chess.roster_strength_asc", "bytea,bytea,bytea,int8",
    "SELECT c.subject_id,c.witness_count,c.rating,c.rd FROM laplace.consensus c "
    "JOIN laplace.entities e ON e.id=c.subject_id AND e.type_id=$1 "
    "WHERE c.type_id=$2 AND c.object_id=$3 "
    "ORDER BY (c.rating - 2*c.rd) ASC,c.subject_id LIMIT $4")
SQL_QUERY("chess.roster_strength_desc", "bytea,bytea,bytea,int8",
    "SELECT c.subject_id,c.witness_count,c.rating,c.rd FROM laplace.consensus c "
    "JOIN laplace.entities e ON e.id=c.subject_id AND e.type_id=$1 "
    "WHERE c.type_id=$2 AND c.object_id=$3 "
    "ORDER BY (c.rating - 2*c.rd) DESC,c.subject_id LIMIT $4")
SQL_QUERY("chess.roster_games_asc", "bytea,bytea,bytea,int8",
    "SELECT c.subject_id,c.witness_count,c.rating,c.rd FROM laplace.consensus c "
    "JOIN laplace.entities e ON e.id=c.subject_id AND e.type_id=$1 "
    "WHERE c.type_id=$2 AND c.object_id=$3 "
    "ORDER BY c.witness_count ASC,c.subject_id LIMIT $4")
SQL_QUERY("chess.roster_games_desc", "bytea,bytea,bytea,int8",
    "SELECT c.subject_id,c.witness_count,c.rating,c.rd FROM laplace.consensus c "
    "JOIN laplace.entities e ON e.id=c.subject_id AND e.type_id=$1 "
    "WHERE c.type_id=$2 AND c.object_id=$3 "
    "ORDER BY c.witness_count DESC,c.subject_id LIMIT $4")
SQL_QUERY("chess.roster_rating_asc", "bytea,bytea,bytea,int8",
    "SELECT c.subject_id,c.witness_count,c.rating,c.rd FROM laplace.consensus c "
    "JOIN laplace.entities e ON e.id=c.subject_id AND e.type_id=$1 "
    "WHERE c.type_id=$2 AND c.object_id=$3 "
    "ORDER BY c.rating ASC,c.subject_id LIMIT $4")
SQL_QUERY("chess.roster_rating_desc", "bytea,bytea,bytea,int8",
    "SELECT c.subject_id,c.witness_count,c.rating,c.rd FROM laplace.consensus c "
    "JOIN laplace.entities e ON e.id=c.subject_id AND e.type_id=$1 "
    "WHERE c.type_id=$2 AND c.object_id=$3 "
    "ORDER BY c.rating DESC,c.subject_id LIMIT $4")
SQL_QUERY("chess.roster_rd_asc", "bytea,bytea,bytea,int8",
    "SELECT c.subject_id,c.witness_count,c.rating,c.rd FROM laplace.consensus c "
    "JOIN laplace.entities e ON e.id=c.subject_id AND e.type_id=$1 "
    "WHERE c.type_id=$2 AND c.object_id=$3 "
    "ORDER BY c.rd ASC,c.subject_id LIMIT $4")
SQL_QUERY("chess.roster_rd_desc", "bytea,bytea,bytea,int8",
    "SELECT c.subject_id,c.witness_count,c.rating,c.rd FROM laplace.consensus c "
    "JOIN laplace.entities e ON e.id=c.subject_id AND e.type_id=$1 "
    "WHERE c.type_id=$2 AND c.object_id=$3 "
    "ORDER BY c.rd DESC,c.subject_id LIMIT $4")

SQL_QUERY("leaders.page", "int4[],int4",
    "SELECT band,encode(subject_id,'hex'),subject,relation,encode(object_id,'hex'),object,eff_mu,witnesses "
    "FROM ops.band_leaders($1,$2)")
SQL_QUERY("consensus.band_edges", "bytea[],int8,int8",
    "SELECT subject_id,type_id,object_id,rating,rd,witness_count,(rating - 2*rd) AS eff_mu "
    "FROM laplace.consensus WHERE type_id=ANY($1) AND object_id IS NOT NULL "
    "AND NOT consensus.refuted(rating,rd) AND (rating - 2*rd)>=$2 "
    "ORDER BY (rating - 2*rd) DESC,subject_id,type_id,object_id LIMIT $3")

SQL_QUERY("leaders.arena", "int4,int8",
    "SELECT subject_id,type_id,object_id,rating,rd,witness_count FROM consensus.band_edges($1,NULL,$2)")

SQL_QUERY("conversation.forward_turn", "text,bytea,int4,int4,float8,int4",
    "SELECT step,entity,stride_used FROM converse.forward_turn($1,$2,$3,$4,$5,$6) ORDER BY step")
SQL_QUERY("conversation.append_turns", "bytea,bytea[],timestamptz",
    "SELECT converse.session_append_turns($1,$2,$3)")
SQL_QUERY("conversation.manifest", "bytea",
    "SELECT public.ST_AsBinary(p.trajectory) FROM laplace.physicalities p "
    "WHERE p.id=$1 AND p.type=1 AND p.trajectory IS NOT NULL")
SQL_QUERY("conversation.lock", "bytea",
    "SELECT id FROM laplace.entities WHERE id=$1 FOR UPDATE")
SQL_QUERY("conversation.coordinates", "bytea[]",
    "SELECT DISTINCT ON (t.ordinal) t.ordinal,e.tier,public.ST_X(p.coord),"
    "public.ST_Y(p.coord),public.ST_Z(p.coord),public.ST_M(p.coord) "
    "FROM unnest($1::bytea[]) WITH ORDINALITY t(id,ordinal) "
    "JOIN laplace.entities e ON e.id=t.id "
    "JOIN laplace.physicalities p ON p.entity_id=t.id AND p.type=1 ORDER BY t.ordinal,p.id")
SQL_QUERY("conversation.write_manifest", "bytea,bytea,bytea,float8,float8,float8,float8,bytea,int4,timestamptz",
    "INSERT INTO laplace.physicalities "
    "(id,entity_id,type,trajectory,coord,hilbert_index,n_constituents,observed_at) "
    "VALUES ($1,$2,1,public.ST_GeomFromWKB($3),public.ST_MakePoint($4,$5,$6,$7),$8,$9,$10) "
    "ON CONFLICT(id) DO UPDATE SET trajectory=EXCLUDED.trajectory,coord=EXCLUDED.coord,"
    "hilbert_index=EXCLUDED.hilbert_index,n_constituents=EXCLUDED.n_constituents,"
    "observed_at=EXCLUDED.observed_at")
SQL_QUERY("generation.semantic_presence", "bytea[],bytea[],bytea[]",
    "SELECT DISTINCT e.id FROM laplace.entities e "
    "JOIN laplace.physicalities p ON p.entity_id=e.id AND p.type=1 AND p.trajectory IS NOT NULL "
    "WHERE e.id=ANY($1) AND e.type_id=ANY($2) AND NOT e.id=ANY($3) ORDER BY e.id")
SQL_QUERY("generation.observation_bindings", "bytea[]",
    "SELECT object_id,context_id FROM laplace.attestations WHERE subject_id=ANY($1)")
SQL_QUERY("generation.observation_trajectories", "bytea[]",
    "SELECT public.ST_AsBinary(trajectory) FROM laplace.physicalities "
    "WHERE entity_id=ANY($1) AND type=1 AND trajectory IS NOT NULL")
