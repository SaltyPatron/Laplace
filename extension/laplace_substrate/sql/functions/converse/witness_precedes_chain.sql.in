-- converse.witness_precedes_chain(text, source): deposit a text's consecutive-token PRECEDES
-- bigrams as laplace.attestations under a source -- the OODA ACT/OBSERVE deposit. This is how a
-- prompt becomes witnessed content and a response becomes a first-class witness: the
-- generated text's own edges fold into the SAME consensus the next walk reads
-- (evaluation IS ingestion). Self-signals are outranked by design (Response/UserPrompt
-- trust classes), so self-witnessing cannot outshout curated sources.
--
-- ONE batched fold through the ingest spine (consensus_upsert) instead of the old
-- per-bigram laplace_witness loop (2 statements per pair, per chat turn). Repeated
-- bigrams in one chain aggregate into ONE (games, sum) cell -- the rating period IS
-- the chain, exactly how the writer spine folds duplicates (its client-dedup
-- contract); arrays arrive sorted (type, subject, id) per that contract. Same cells,
-- same outcomes (score 1e9 per game -- a win, as the loop scored), same witness
-- counts. One deliberate spine alignment: laplace_witness seeded a NOVEL cell at
-- neutral WITHOUT folding its first game (the first outcome was dropped);
-- consensus_upsert's novel arm folds every game -- no signal is discarded.
DROP FUNCTION IF EXISTS laplace.witness_precedes_chain(text, bytea);
CREATE OR REPLACE FUNCTION converse.witness_precedes_chain(p_text text, p_source bytea)
    RETURNS int
    LANGUAGE sql VOLATILE
BEGIN ATOMIC
    WITH toks AS MATERIALIZED (
        SELECT array_agg(id ORDER BY ord) AS ids,
               count(*)::int AS n
        FROM converse.prompt_state(p_text)
        WHERE id IS NOT NULL
    ),
    bigrams AS MATERIALIZED (
        SELECT array_agg(d.s               ORDER BY d.s, d.cid) AS subs,
               array_agg(d.o               ORDER BY d.s, d.cid) AS objs,
               array_agg(d.g               ORDER BY d.s, d.cid) AS games,
               array_agg(d.g * 1000000000  ORDER BY d.s, d.cid) AS sums
        FROM toks t
        CROSS JOIN LATERAL (
            SELECT p.s, p.o, count(*)::bigint AS g,
                   laplace.consensus_id(p.s, laplace.relation_type_id('PRECEDES'), p.o) AS cid
            FROM (SELECT t.ids[i] AS s, t.ids[i + 1] AS o
                  FROM generate_series(1, t.n - 1) i) p
            GROUP BY p.s, p.o
        ) d
        WHERE t.n >= 2
    ),
    folded AS MATERIALIZED (
        SELECT CASE
                   WHEN t.n < 2 OR b.subs IS NULL THEN 0::bigint
                   ELSE consensus.upsert_type(
                       laplace.relation_type_id('PRECEDES'),
                       b.subs,
                       b.objs,
                       array_fill(consensus.glicko2_initial_rd(), ARRAY[cardinality(b.subs)]),
                       b.games,
                       b.sums,
                       array_fill(now(), ARRAY[cardinality(b.subs)]))
               END AS affected
        FROM toks t
        CROSS JOIN bigrams b
    )
    SELECT GREATEST(t.n - 1, 0)
    FROM toks t
    CROSS JOIN folded f;
END;
