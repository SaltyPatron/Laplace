-- COMPLETES_TO successors as a sampling floor for the dry generator. Thin
-- wrapper over consensus.edges_raw() — the one consensus scan — with this lane's axes
-- pinned: outbound, one relation type, unrefuted, consensus.eff_mu order. The weight
-- projection is this caller's own need and stays here.
--
-- The hand-rolled scan this replaced was edges_raw's 'out' arm verbatim
-- (subject equality, type equality, object_id IS NOT NULL, NOT consensus.refuted,
-- consensus.eff_mu DESC, LIMIT) — one axis set out of the six the core already takes as
-- arguments. Ordering is unchanged except that edges_raw breaks consensus.eff_mu ties on
-- neighbour_id, so the cap is now deterministic instead of plan-dependent.
--
-- No SET search_path: it blocks inlining, which is what makes the wrapper free
-- (#617, #860). Every reference is schema-qualified instead.
-- BEGIN ATOMIC: GH #764.
CREATE OR REPLACE FUNCTION generation.walk_completes_floor(p_subject bytea, p_limit int)
    RETURNS TABLE(object_id bytea, weight bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT e.neighbour_id,
           GREATEST(consensus.eff_mu(e.rating, e.rd) / 1000000000, 1)::int8 AS weight
    FROM consensus.edges_raw(p_subject, 'out',
                               ARRAY[laplace.relation_type_id('COMPLETES_TO')],
                               p_limit, false, 'eff_mu') e;
END;
