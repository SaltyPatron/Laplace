-- chess.opening_preference(player, tc_class, limit): which openings a player
-- actually reaches for, per time-control class -- witnessed record only.
--
-- Promoted 2026-08-02 from a hand-run that took FOUR attempts to find the
-- layer map, which is the argument for its existence: the layering (GH #736)
-- is that the PLAYER is the OBJECT of HAS_PLAYER {side}, whose subject is
-- the shared LINE and whose context pins the PLAYING; HAS_ECO and
-- HAS_TC_CLASS ride the same (line, context) pair. PLAYED_BY lives on a
-- different layer and does NOT reach the headers -- three empty joins proved
-- it. Nobody should have to rediscover that; this surface is the map.
--
-- p_tc_class filters in ID SPACE via the identity law (laplace.word_id of the class
-- surface, e.g. 'bullet', 'blitz'), never by rendering and comparing text.
-- Group by ids, realize ONCE over the page -- the read law's shape.
DROP FUNCTION IF EXISTS laplace.chess_opening_preference(bytea, text, int);
CREATE OR REPLACE FUNCTION chess.opening_preference(p_player bytea,
                                                    p_tc_class text DEFAULT NULL,
                                                    p_limit int DEFAULT 12)
    RETURNS TABLE(tc_class text, eco text, games bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
WITH rel AS MATERIALIZED (
    SELECT laplace.relation_type_id('HAS_PLAYER')       AS has_player,
           laplace.relation_type_id('White')            AS white_tag,
           laplace.relation_type_id('Black')            AS black_tag,
           laplace.relation_type_id('HAS_TC_CLASS')     AS has_tcc,
           laplace.relation_type_id('TimeControl')      AS tc_tag,
           laplace.relation_type_id('HAS_ECO')          AS has_eco,
           laplace.relation_type_id('ECO')              AS eco_tag
),
grouped AS (
    SELECT tcc.object_id AS tc_id, e.object_id AS eco_id, count(DISTINCT a.context_id) AS games
    FROM laplace.attestations a
    JOIN rel r ON true
    JOIN laplace.attestations tcc ON tcc.subject_id = a.subject_id
                         AND tcc.context_id = a.context_id
                         AND tcc.type_id IN (r.has_tcc, r.tc_tag)
    JOIN laplace.attestations e ON e.subject_id = a.subject_id
                       AND (e.context_id = a.context_id OR e.context_id IS NULL)
                       AND e.type_id IN (r.eco_tag, r.has_eco)
    WHERE a.object_id = p_player
      AND a.context_id IS NOT NULL
      AND a.type_id IN (r.has_player, r.white_tag, r.black_tag)
      AND (p_tc_class IS NULL OR tcc.object_id = laplace.word_id(lower(p_tc_class)))
    GROUP BY tcc.object_id, e.object_id
    ORDER BY count(DISTINCT a.context_id) DESC, tcc.object_id, e.object_id
    LIMIT p_limit
),
ord AS (
    SELECT g.*, row_number() OVER (ORDER BY g.games DESC, g.tc_id, g.eco_id) AS ix
    FROM grouped g
),
lbl AS (
    SELECT realize.batch(array_agg(v.id ORDER BY v.ord), NULL) AS l
    FROM (SELECT o.tc_id AS id, o.ix * 2 - 1 AS ord FROM ord o
          UNION ALL
          SELECT o.eco_id, o.ix * 2 FROM ord o) v
)
SELECT lbl.l[o.ix * 2 - 1], lbl.l[o.ix * 2], o.games
FROM ord o CROSS JOIN lbl
ORDER BY o.ix;
END;
