@startuml
!pragma layout smetana
skinparam backgroundColor #FAFCFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #385978
skinparam componentBackgroundColor #E6EFF7
skinparam classBackgroundColor #E6EFF7
title cognition.realize-effect — declared input/output contract
component "cognition.realize-effect" as operation
rectangle "completed cognition state" as in0
in0 --> operation
rectangle "candidate semantic acts" as in1
in1 --> operation
rectangle "authority envelope" as in2
in2 --> operation
rectangle "realization recipe" as in3
in3 --> operation
rectangle "typed semantic act" as out0
operation --> out0
rectangle "exact modality content or effect" as out1
operation --> out1
rectangle "observed consequence" as out2
operation --> out2
@enduml
