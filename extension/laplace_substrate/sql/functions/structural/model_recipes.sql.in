DROP FUNCTION IF EXISTS laplace.model_recipes();
CREATE OR REPLACE FUNCTION structural.model_recipes()
    RETURNS TABLE(recipe_id bytea, recipe_json text, first_observed_by bytea)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    WITH recipes AS MATERIALIZED (
        SELECT e.id,
               (array_agg(i.first_observed_by ORDER BY i.first_observed_by)
                  FILTER (WHERE i.first_observed_by IS NOT NULL))[1] AS first_observed_by
        FROM laplace.entities e
        JOIN laplace.entity_interpretations i ON i.entity_id = e.id
        WHERE i.type_id = realize.canonical_id('Model_Recipe')
        GROUP BY e.id
    ), encoded AS MATERIALIZED (
        SELECT r.id,
               r.first_observed_by,
               (array_agg(c.object_id ORDER BY c.object_id)
                  FILTER (WHERE c.object_id IS NOT NULL))[1] AS content_id
        FROM recipes r
        JOIN laplace.consensus c
          ON c.subject_id = r.id
         AND c.type_id = laplace.relation_type_id('ENCODES')
        GROUP BY r.id, r.first_observed_by
    )
    SELECT id,
           realize.render_text_fast(content_id, 16),
           first_observed_by
    FROM encoded
    WHERE content_id IS NOT NULL;
END;