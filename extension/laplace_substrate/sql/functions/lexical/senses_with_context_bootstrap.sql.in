-- FORWARD DECLARATION ONLY (GH #532). Not an implementation.
--
-- What used to sit here was the SUPERSEDED sense-election body: the single
-- direct-edge lane that senses_with_context.sql.in's header documents as INERT ON
-- REAL DATA -- opposite contexts ({animal,pet,bark} vs {sausage,roll,beef}) scored
-- byte-identically for `dog` because words reach synsets through HAS_SENSE ->
-- IS_SENSE_OF and almost never carry a direct edge to one. The four-lane
-- implementation replaced it, and this copy survived, winning or losing purely on
-- manifest ordering. A reorder or a truncated upgrade would have silently restored
-- context-blind sense election with no error anywhere.
--
-- The signature must match the final definition EXACTLY or the real CREATE OR
-- REPLACE fails instead of replacing this.
CREATE OR REPLACE FUNCTION lexical.senses(p_word bytea, p_context bytea[])
    RETURNS TABLE(sense_id bytea, synset_id bytea, eff_mu numeric, witnesses bigint,
                  score numeric)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    SELECT NULL::bytea, NULL::bytea, NULL::numeric, NULL::bigint, NULL::numeric
    WHERE false
$$;
