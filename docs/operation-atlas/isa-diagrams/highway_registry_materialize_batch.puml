@startuml
skinparam backgroundColor #FAFCFF
skinparam shadowing false
skinparam defaultFontName SansSerif
title Refactor ISA — highway_registry_materialize_batch
start
:Entry after whole-program validation;

while (More input elements by count?) is (yes)
 :laplace_highway_registry_materialize(program.context);
 if (Native status not OK?) then (yes)
  :Return EXECUTION_FAILED;
  stop
 endif
 :Copy receipt to output element;
endwhile (no)
:Set output.count = input.count;
:Return ISA_OK;
stop
legend
Execute-wrapper source trace.
Validation and native semantic callees are separate boundaries.
No runtime acceptance asserted.
endlegend
@enduml
