-- consensus_subject: the subject star in standing order. Every star read
-- filters on subject_id; bounded reads take the top of it by the conservative
-- estimate (rating - 2*rd), and INCLUDE makes both full and top-k star reads
-- index-only. It subsumes consensus_subject_eff_mu_btree, which shares its
-- ordered prefix.
--
-- A populated database whose consensus_subject lacks the expression key keeps
-- both indexes: a partitioned index cannot be rebuilt CONCURRENTLY inside the
-- extension transaction, and a live read path is never dropped during deploy.
-- An empty consensus is rebuilt in place.
CREATE INDEX IF NOT EXISTS consensus_subject
    ON consensus (subject_id, ((rating - 2*rd)) DESC)
    INCLUDE (object_id, rating, rd);

DO $do$
DECLARE
    v_combined boolean;
    v_empty boolean;
BEGIN
    SELECT i.indexprs IS NOT NULL
      INTO v_combined
      FROM pg_index i
      WHERE i.indexrelid = to_regclass('laplace.consensus_subject');
    SELECT NOT EXISTS (SELECT 1 FROM laplace.consensus LIMIT 1) INTO v_empty;

    IF NOT COALESCE(v_combined, false) AND v_empty THEN
        DROP INDEX IF EXISTS laplace.consensus_subject;
        CREATE INDEX consensus_subject
            ON laplace.consensus (subject_id, ((rating - 2*rd)) DESC)
            INCLUDE (object_id, rating, rd);
        v_combined := true;
    END IF;

    IF COALESCE(v_combined, false) THEN
        DROP INDEX IF EXISTS laplace.consensus_subject_eff_mu_btree;
    ELSE
        RAISE NOTICE 'consensus subject indexes retained online; combined shape applies at reseed';
    END IF;
END $do$;
