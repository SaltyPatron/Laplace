-- No SET search_path so it inlines into callers (#617) — walk_strongest
-- executes this once per walk step (generate_walk.c edge_plan); non-inlined,
-- each step paid a full function execution. walk_branches batches natively
-- and does not use this function.
DROP FUNCTION IF EXISTS laplace.consensus_walk_edges(bytea, bytea, int, bytea[]);
CREATE OR REPLACE FUNCTION consensus.walk_edges(
    p_subject  bytea,
    p_type     bytea DEFAULT NULL,
    p_limit    int   DEFAULT 40,
    p_exclude  bytea[] DEFAULT '{}')
    RETURNS TABLE(object_id bytea, type_id bytea, rating bigint, rd bigint, witness_count bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH combined AS (
        SELECT c.object_id, c.type_id, c.rating, c.rd, c.witness_count
        FROM laplace.v_consensus_unrefuted c
        WHERE c.subject_id = p_subject
          AND c.object_id IS NOT NULL
          AND (p_type IS NULL OR c.type_id = p_type)
          AND NOT (c.object_id = ANY (COALESCE(p_exclude, '{}'::bytea[])))
          AND c.object_id NOT IN (SELECT r.type_id FROM laplace.relation_registry() r)
        UNION ALL
        SELECT e.neighbour_id AS object_id,
               COALESCE(laplace.relation_type_id(consensus.relation_canonical(e.type_id)), e.type_id) AS type_id,
               e.rating, e.rd, e.witness_count
        FROM consensus.edges_raw(p_subject, 'out', CASE WHEN p_type IS NULL THEN NULL ELSE ARRAY[p_type] END, GREATEST(p_limit * 2, 64), true, 'eff_mu') e
        WHERE e.neighbour_id IS NOT NULL
          AND e.type_id IS NOT NULL
          AND (p_type IS NULL
               OR e.type_id = p_type
               OR laplace.relation_type_id(consensus.relation_canonical(e.type_id)) = p_type)
          AND NOT (e.neighbour_id = ANY (COALESCE(p_exclude, '{}'::bytea[])))
    ), dedup AS (
        SELECT DISTINCT ON (c.object_id, c.type_id)
               c.object_id, c.type_id, c.rating, c.rd, c.witness_count
        FROM combined c
        ORDER BY c.object_id, c.type_id, consensus.eff_mu(c.rating, c.rd) DESC
    )
    SELECT d.object_id, d.type_id, d.rating, d.rd, d.witness_count
    FROM dedup d
    ORDER BY consensus.edge_rank(d.type_id, consensus.eff_mu(d.rating, d.rd)) DESC
    LIMIT p_limit;
END;
