


DROP FUNCTION IF EXISTS laplace.synonyms(bytea, int);
CREATE OR REPLACE FUNCTION converse.synonyms(p_word bytea, p_limit int DEFAULT 10)
    RETURNS TABLE(synonym text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql LAPLACE_STABLE_STRICT
 AS $$
    -- Dedup and rank by member id, never by rendered surface: members that
    -- render alike are distinct content and stay distinct rows. render_text
    -- runs above the sort, only until p_limit rows survive the empty filter.
    WITH src_lang AS (SELECT converse.word_language(p_word) AS id),
    agg AS (
        SELECT sm.member, max(sm.mu) AS mu, max(sm.witnesses) AS witnesses,
               max(sm.sense_mu) AS sense_mu
        FROM lexical.synset_members(p_word) sm
        WHERE sm.lang = (SELECT id FROM src_lang)
        GROUP BY sm.member
    )
    -- a.mu is raw fp1e9; ordering runs on it, output goes through the one
    -- display definition.
    SELECT r.txt AS synonym, consensus.eff_mu_display(a.mu, 0) AS eff_mu, a.witnesses
    FROM (
        SELECT member, mu, witnesses FROM agg
        ORDER BY sense_mu DESC NULLS LAST, mu DESC, witnesses DESC, member
    ) a
    CROSS JOIN LATERAL (SELECT realize.render_text(a.member) AS txt) r
    WHERE NULLIF(btrim(r.txt), '') IS NOT NULL
    LIMIT p_limit
$$;
