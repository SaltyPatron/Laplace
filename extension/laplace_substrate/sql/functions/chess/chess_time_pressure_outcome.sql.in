CREATE OR REPLACE FUNCTION chess_time_pressure_outcome()
    RETURNS TABLE(
        think_class     text,
        positions       bigint,
        plays           bigint,
        avg_eff_mu      numeric)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    -- "Do rushed moves lead to worse outcomes?" answered as a READ over the
    -- FOLDED consensus layer — never a query-time aggregation of raw evidence.
    --
    -- Both inputs are already folded at ingest and indexed on subject_id
    -- (the position): HAS_THINK_CLASS(position -> rushed/normal/deep) from the
    -- ChessAnalysis pass, and MOVE(position -> next_position) whose Glicko
    -- rating IS the folded outcome of playing from that position (win=2 /
    -- draw=1 / loss=0 folded via consensus). So this joins two consensus sets
    -- on position and reads eff_mu — the conservative folded outcome estimate.
    -- The earlier evidence-layer form (joining 133M attestations by game
    -- context_id) timed out at 90s; this is the substrate's own answer: the
    -- adjudication already happened, the read is a lookup (GH #606).
    --
    -- Global (all positions). The per-PLAYER cut ("how does Magnus do when
    -- rushed") is deliberately NOT a query-time recompute either: it wants the
    -- analyzer to fold (player, time-class -> outcome) as its own consensus
    -- cell at ingest, then that read is a single indexed lookup — the same
    -- record-vs-calculate discipline. Tracked as the ingest-fold extension.
    WITH tc AS (
        SELECT c.subject_id AS position, c.object_id AS class_id
        FROM @extschema@.consensus c
        WHERE c.type_id = @extschema@.relation_type_id('HAS_THINK_CLASS')
    ), mv AS (
        SELECT c.subject_id AS position,
               @extschema@.eff_mu(c.rating, c.rd) AS mu,
               c.witness_count
        FROM @extschema@.consensus c
        WHERE c.type_id = @extschema@.relation_type_id('MOVE')
    ), cls(id, label, ord) AS (
        VALUES
            (@extschema@.word_id('rushed'), 'rushed', 1),
            (@extschema@.word_id('normal'), 'normal', 2),
            (@extschema@.word_id('deep'),   'deep',   3),
            -- Think-time lenses: phase × clock × spent refinements the analyzer
            -- deposits beside the base classes, thresholds from the game's own
            -- clock distribution (ChessCanonical.ThinkLens). Content values on
            -- the same HAS_THINK_CLASS cell shape — no relation change. The
            -- fourth lens (late + fast + low clock) IS the base 'rushed' cell.
            (@extschema@.word_id('planned_quick'), 'planned_quick', 4),
            (@extschema@.word_id('pressed_think'), 'pressed_think', 5),
            (@extschema@.word_id('flagging'),      'flagging',      6)
    )
    SELECT cls.label,
           count(DISTINCT tc.position)::bigint                       AS positions,
           sum(mv.witness_count)::bigint                             AS plays,
           round(@extschema@.eff_mu_display(
                   avg(mv.mu)::bigint, 0)::numeric, 3)               AS avg_eff_mu
    FROM tc
    JOIN mv  ON mv.position = tc.position
    JOIN cls ON cls.id = tc.class_id
    GROUP BY cls.label, cls.ord
    ORDER BY cls.ord
$$;
