-- BEGIN ATOMIC: GH #764.

CREATE OR REPLACE FUNCTION ops.consensus_tier_distribution()
    RETURNS TABLE(subject_tier smallint, relations bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT e.tier, count(*)
    FROM laplace.consensus c JOIN laplace.entities e ON e.id = c.subject_id
    WHERE c.object_id IS NOT NULL
      AND e.type_id = ANY(laplace.compositional_type_ids())
    GROUP BY e.tier ORDER BY e.tier;
END;
