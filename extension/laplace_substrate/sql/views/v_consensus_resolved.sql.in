CREATE OR REPLACE VIEW laplace.v_consensus_resolved AS
SELECT c.id, c.subject_id, c.type_id, c.object_id,
       c.rating, c.rd, c.volatility, c.witness_count,
       c.last_observed_at,
       consensus.eff_mu(c.rating, c.rd)         AS eff_mu_raw,
       consensus.eff_mu_display(c.rating, c.rd) AS eff_mu
FROM laplace.consensus c;
