@startuml
!pragma layout smetana
skinparam backgroundColor #FAFCFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #385978
skinparam componentBackgroundColor #E6EFF7
skinparam classBackgroundColor #E6EFF7
title bootstrap.dependencies — declared input/output contract
component "bootstrap.dependencies" as operation
rectangle "verified source generations" as in0
in0 --> operation
rectangle "staged dependency packages" as in1
in1 --> operation
rectangle "generated runtime configuration" as in2
in2 --> operation
rectangle "activation authority" as in3
in3 --> operation
rectangle "activated package inputs" as out0
operation --> out0
rectangle "runtime dependency epoch" as out1
operation --> out1
rectangle "loaded object closure" as out2
operation --> out2
@enduml
