DROP FUNCTION IF EXISTS laplace.chess_player_record(bytea);
CREATE OR REPLACE FUNCTION chess.player_record(p_player bytea)
    RETURNS TABLE(as_white boolean, games bigint, wins bigint, draws bigint,
                  losses bigint, unscored bigint, score double precision)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    -- One player's record, straight off the witnessed game headers. Rides
    -- attestations_rdefault_object_id_idx to find the games he appears in (as
    -- HAS_WHITE or HAS_BLACK), then the (subject_id, type_id, object_id) index
    -- to pick up each game's HAS_RESULT -- both index lookups, so this stays
    -- interactive for a 9k-game career.
    --
    -- GROUPING SETS emits three rows: as_white = true, false, and NULL for the
    -- career total, so every number on a player page comes from one pass over
    -- the same evidence and the splits can never disagree with the total.
    --
    -- score is the chess convention -- (wins + draws/2) / scored games -- over
    -- games the source actually scored; `unscored` reports the abstentions
    -- separately rather than silently folding them in as losses.
    -- GH #736: a colour header subjects on the shared LINE with context = the
    -- PLAYING, so the result join threads both -- the line finds the rows, the
    -- context pins each to its own playing (a shared line must not cross one
    -- playing's result onto another's appearance).
    WITH sides AS (
        SELECT a.subject_id AS line,
               a.context_id AS event,
               (a.type_id = laplace.relation_type_id('HAS_WHITE')) AS white
        FROM laplace.attestations a
        WHERE a.object_id = p_player
          AND a.context_id IS NOT NULL
          AND a.type_id IN (laplace.relation_type_id('HAS_WHITE'),
                            laplace.relation_type_id('HAS_BLACK'))
    ),
    scored AS (
        SELECT s.white,
               chess.outcome(s.white, r.object_id) AS outcome
        FROM sides s
        LEFT JOIN laplace.attestations r
               ON r.subject_id = s.line
              AND r.context_id = s.event
              AND r.type_id = laplace.relation_type_id('HAS_RESULT')
    )
    SELECT sc.white,
           count(*)::bigint,
           count(*) FILTER (WHERE sc.outcome = 2)::bigint,
           count(*) FILTER (WHERE sc.outcome = 1)::bigint,
           count(*) FILTER (WHERE sc.outcome = 0)::bigint,
           count(*) FILTER (WHERE sc.outcome IS NULL)::bigint,
           (count(*) FILTER (WHERE sc.outcome = 2)
            + count(*) FILTER (WHERE sc.outcome = 1) / 2.0)
           / NULLIF(count(*) FILTER (WHERE sc.outcome IS NOT NULL), 0)
    FROM scored sc
    GROUP BY GROUPING SETS ((sc.white), ())
    ORDER BY sc.white NULLS FIRST;
END;
