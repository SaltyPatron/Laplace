-- converse.resolve_last_word — GH #862 / #860. No SET, real schema names.
DROP FUNCTION IF EXISTS laplace.resolve_last_word(text);

CREATE OR REPLACE FUNCTION converse.resolve_last_word(p_phrase text)
    RETURNS bytea
    LANGUAGE sql LAPLACE_STABLE_STRICT AS $$
    SELECT pw.id FROM converse.prompt_words(p_phrase) pw
    WHERE pw.id IS NOT NULL
    ORDER BY pw.ord DESC
    LIMIT 1
$$;
