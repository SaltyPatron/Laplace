-- Row estimates from the storage selected by the installed Native schema.
DROP FUNCTION IF EXISTS laplace.substrate_counts();

-- One source asserting one claim is one attestation. Publication retains the
-- cardinality beside its witness; polling does not walk testimony or refold it.
CREATE OR REPLACE FUNCTION ops.attestation_count()
RETURNS bigint LANGUAGE plpgsql STABLE AS $$
DECLARE measured bigint;
BEGIN
    IF NOT EXISTS(SELECT FROM pg_attribute WHERE attrelid=to_regclass('public.witness')
                  AND attname='attestations' AND NOT attisdropped) THEN
        RETURN NULL;
    END IF;
    EXECUTE 'SELECT CASE WHEN count(*) FILTER (WHERE attestations IS NULL)>0 THEN NULL
             ELSE coalesce(sum(attestations),0)::bigint END FROM public.witness' INTO measured;
    RETURN measured;
END $$;

CREATE OR REPLACE FUNCTION ops.substrate_counts()
    RETURNS TABLE(metric text, value bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    WITH storage AS (
        SELECT to_regclass('public.entity') IS NOT NULL AS native
    ), targets(metric, relid, ordinal) AS (
        SELECT 'entities(ESTIMATE)'::text,
               CASE WHEN native THEN to_regclass('public.entity') ELSE to_regclass('laplace.entities') END, 1 FROM storage
        UNION ALL
        SELECT 'physicalities(ESTIMATE)',
               CASE WHEN native THEN to_regclass('public.physicality') ELSE to_regclass('laplace.physicalities') END, 2 FROM storage
        UNION ALL
        SELECT 'attestations(ESTIMATE)', to_regclass('laplace.attestations'), 3 FROM storage WHERE NOT native
        UNION ALL
        SELECT 'consensus(ESTIMATE)',
               CASE WHEN native THEN to_regclass('public.consensus') ELSE to_regclass('laplace.consensus') END, 4 FROM storage
    ), estimates AS (
    -- pg_stat_all_tables live
    -- tuple estimates include committed COPY windows between ANALYZE runs;
    -- pg_class.reltuples is the planner fallback. Statistics reset/restart can
    -- leave a present statistics row with all counters zero while the durable
    -- planner estimate is populated. A measured zero after deletes or table
    -- maintenance must still remain zero. Neither is an exact count(*).
    SELECT t.metric, COALESCE(sum(CASE
        WHEN s.n_live_tup > 0 OR s.n_tup_ins > 0 OR s.n_tup_upd > 0 OR s.n_tup_del > 0
          OR GREATEST(s.last_analyze, s.last_autoanalyze, s.last_vacuum, s.last_autovacuum) IS NOT NULL
        THEN s.n_live_tup
        ELSE GREATEST(c.reltuples, 0)::bigint
    END), 0)::bigint AS value,t.ordinal
    FROM targets t
    -- pg_partition_tree returns no rows for ordinary, unpartitioned tables.
    LEFT JOIN LATERAL pg_partition_tree(t.relid) p ON true
    JOIN pg_class c ON c.oid = COALESCE(p.relid, t.relid)
    LEFT JOIN pg_stat_all_tables s ON s.relid = c.oid
    WHERE p.isleaf OR p.relid IS NULL
    GROUP BY t.metric, t.ordinal
    ), totals AS (
        SELECT * FROM estimates
        UNION ALL SELECT 'attestations(MEASURED)',ops.attestation_count(),3 FROM storage WHERE native
    )
    SELECT metric,value FROM totals ORDER BY ordinal;
END;
