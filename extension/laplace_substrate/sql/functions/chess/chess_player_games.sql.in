-- GH #736 re-key: the key OUT column was renamed (game_id -> event_id), which
-- CREATE OR REPLACE cannot do on the upgrade path.
DROP FUNCTION IF EXISTS chess_player_games(bytea, integer, integer);
CREATE OR REPLACE FUNCTION chess_player_games(
        p_player bytea, p_limit integer DEFAULT 25, p_offset integer DEFAULT 0)
    RETURNS TABLE(event_id bytea, played_on text, event text, eco text,
                  as_white boolean, opponent_id bytea, opponent text,
                  result text, outcome smallint)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    -- A player's game log: the detail list behind chess_player_record, most
    -- recent first. Every field is a header the PGN decomposer transcribed
    -- verbatim (ON_DATE / HAS_EVENT / HAS_ECO / HAS_RESULT) plus the opposite
    -- colour edge for the opponent -- witnessed record only, nothing derived.
    --
    -- GH #736: a game-log row identifies a PLAYING, so the key column is the
    -- EVENT id. Colour headers subject on the shared LINE with context = the
    -- playing, which means every join below threads BOTH the line and the
    -- event: the line finds the header rows, the context pins them to this
    -- playing (a line shared by two playings must not leak one playing's
    -- headers into the other's row).
    --
    -- Ordering is by the playing's own asserted date, which means the career's
    -- dates must be resolved before the page can be cut. That stays cheap
    -- because dates are shared content: every game played on 1960.03.15 carries
    -- the SAME date entity, so a 9k-game career resolves a few thousand distinct
    -- ids in one realize_batch, not 9k renders. Games the source never dated
    -- sort last rather than being dropped.
    --
    -- Everything else renders once, for the page only: opponent, event, eco and
    -- result ids go into a single array and come back through one realize_batch.
    -- Per-row label() here is what made a 1300-game career take 18s.
    WITH mine AS MATERIALIZED (
        SELECT a.subject_id AS line,
               a.context_id AS event,
               (a.type_id = laplace.relation_type_id('HAS_WHITE')) AS white
        FROM laplace.attestations a
        WHERE a.object_id = p_player
          AND a.context_id IS NOT NULL
          AND a.type_id IN (laplace.relation_type_id('HAS_WHITE'),
                            laplace.relation_type_id('HAS_BLACK'))
    ),
    dated AS MATERIALIZED (
        SELECT m.line, m.event, m.white, d.object_id AS date_id
        FROM mine m
        LEFT JOIN laplace.attestations d
               ON d.subject_id = m.line
              AND d.context_id = m.event
              AND d.type_id = laplace.relation_type_id('ON_DATE')
    ),
    date_batch AS MATERIALIZED (
        SELECT COALESCE(array_agg(DISTINCT date_id), '{}'::bytea[]) AS ids
        FROM dated WHERE date_id IS NOT NULL
    ),
    date_text AS MATERIALIZED (
        SELECT p.id, t.txt
        FROM date_batch b,
             LATERAL unnest(b.ids) WITH ORDINALITY AS p(id, i),
             LATERAL unnest(laplace.realize_batch(b.ids)) WITH ORDINALITY AS t(txt, j)
        WHERE p.i = t.j
    ),
    page AS MATERIALIZED (
        SELECT d.line, d.event, d.white, dt.txt AS played_on
        FROM dated d
        LEFT JOIN date_text dt ON dt.id = d.date_id
        ORDER BY dt.txt DESC NULLS LAST, d.event
        LIMIT p_limit OFFSET p_offset
    ),
    facts AS MATERIALIZED (
        SELECT pg.event, pg.white, pg.played_on,
               max(h.object_id) FILTER (
                   WHERE h.type_id = laplace.relation_type_id('HAS_EVENT')) AS event_name_id,
               max(h.object_id) FILTER (
                   WHERE h.type_id = laplace.relation_type_id('HAS_ECO')) AS eco_id,
               max(h.object_id) FILTER (
                   WHERE h.type_id = laplace.relation_type_id('HAS_RESULT')) AS result_id,
               max(h.object_id) FILTER (
                   WHERE h.type_id = CASE WHEN pg.white
                       THEN laplace.relation_type_id('HAS_BLACK')
                       ELSE laplace.relation_type_id('HAS_WHITE') END) AS opponent_id
        FROM page pg
        LEFT JOIN laplace.attestations h
               ON h.subject_id = pg.line
              AND h.context_id = pg.event
              AND h.type_id IN (laplace.relation_type_id('HAS_EVENT'),
                                laplace.relation_type_id('HAS_ECO'),
                                laplace.relation_type_id('HAS_RESULT'),
                                laplace.relation_type_id('HAS_WHITE'),
                                laplace.relation_type_id('HAS_BLACK'))
        GROUP BY pg.event, pg.white, pg.played_on
    ),
    surface_batch AS MATERIALIZED (
        SELECT COALESCE(array_agg(DISTINCT s), '{}'::bytea[]) AS ids
        FROM facts f,
             LATERAL (VALUES (f.event_name_id), (f.eco_id), (f.result_id), (f.opponent_id)) v(s)
        WHERE s IS NOT NULL
    ),
    surface_text AS MATERIALIZED (
        SELECT p.id, t.txt
        FROM surface_batch b,
             LATERAL unnest(b.ids) WITH ORDINALITY AS p(id, i),
             LATERAL unnest(laplace.realize_batch(b.ids)) WITH ORDINALITY AS t(txt, j)
        WHERE p.i = t.j
    )
    SELECT f.event,
           f.played_on,
           ev.txt,
           ec.txt,
           f.white,
           f.opponent_id,
           COALESCE(NULLIF(op.txt, ''), encode(f.opponent_id, 'hex')),
           rs.txt,
           laplace.chess_outcome(f.white, f.result_id)
    FROM facts f
    LEFT JOIN surface_text ev ON ev.id = f.event_name_id
    LEFT JOIN surface_text ec ON ec.id = f.eco_id
    LEFT JOIN surface_text rs ON rs.id = f.result_id
    LEFT JOIN surface_text op ON op.id = f.opponent_id
    ORDER BY f.played_on DESC NULLS LAST, f.event
$$;
