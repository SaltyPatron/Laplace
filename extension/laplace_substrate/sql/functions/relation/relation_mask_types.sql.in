-- Resolve a highway mask to the relation types whose governed highway bit is
-- present in that mask.  Highway membership is a property of the relation
-- vocabulary/perfcache, not of an entity's accumulated incident-edge mask.
--
-- The registry roster (at most 256 rows) is examined once and returns ids that
-- large consensus reads can use with = ANY(...).
CREATE OR REPLACE FUNCTION consensus.relation_mask_types(p_mask bytea)
    RETURNS bytea[]
    LANGUAGE sql STABLE STRICT PARALLEL SAFE
BEGIN ATOMIC
    WITH wanted(bits) AS (
        SELECT consensus.highway_mask_bits(p_mask)
    )
    SELECT COALESCE(array_agg(r.type_id ORDER BY r.highway_bit), '{}'::bytea[])
    FROM laplace.relation_registry() r
    CROSS JOIN wanted w
    WHERE r.highway_bit = ANY (w.bits);
END;
