DROP FUNCTION IF EXISTS laplace.laplace_decay(bytea, bytea, bytea, float8);
CREATE OR REPLACE FUNCTION generation.decay(
    p_subject  bytea, p_type  bytea, p_object  bytea,
    p_decay_factor float8 DEFAULT 0.95)
RETURNS void
LANGUAGE plpgsql VOLATILE AS $$
DECLARE
    v_id bytea := laplace.consensus_id(p_subject, p_type, p_object);
    v_leaf regclass;
BEGIN
    v_leaf := consensus.partition_leaf(p_type, p_subject);
    EXECUTE format($q$
        UPDATE ONLY %s
        SET rd = LEAST((rd / $1)::bigint, consensus.glicko2_initial_rd())
        WHERE id = $2 AND type_id = $3 AND subject_id = $4
    $q$, v_leaf)
    USING p_decay_factor, v_id, p_type, p_subject;
END;
$$;
