-- Per-band leaderboards: the strongest consensus edges in each salience band,
-- fully labeled — canonical band selection followed by one native display batch.
DROP FUNCTION IF EXISTS laplace.band_leaders(int[], int);
CREATE OR REPLACE FUNCTION ops.band_leaders(p_bands int[] DEFAULT ARRAY[1,2,4,5], p_per int DEFAULT 5)
    RETURNS TABLE(band int, subject_id bytea, subject text, relation text,
                  object_id bytea, object text, eff_mu numeric, witnesses bigint)
    AS 'MODULE_PATHNAME', 'pg_laplace_band_leaders'
    LANGUAGE C STABLE PARALLEL RESTRICTED;
