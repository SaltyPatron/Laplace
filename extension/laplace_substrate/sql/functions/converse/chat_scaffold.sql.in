-- converse.chat_scaffold — compatibility presentation for explicit read operations.
--
-- The former implementation carried an English sentence table, a Bulgarian sentence
-- table, and a third fallback.  That made language a hardcoded formatting branch in a
-- substrate whose identity/realization law is language-agnostic (INVENTIONS #58,
-- GH #901/#1404).  It also guaranteed that every unlisted language was second-class.
--
-- The dynamic no-shape conversation path is generation.forward_text; this helper is
-- only the residual presentation boundary for explicit query/read shapes and an empty
-- forward receipt.  Until connective/operation language is itself realized from
-- witnessed entities, return a language-neutral structural form.  p_lang remains in
-- the installed signature as the requested realization coordinate; this compatibility
-- helper does not reinterpret it or invent a translation.
DROP FUNCTION IF EXISTS laplace.chat_scaffold(bytea, text, text, text, text);
CREATE OR REPLACE FUNCTION converse.chat_scaffold(
        p_lang   bytea,
        p_key    text,
        p_topic  text DEFAULT NULL,
        p_labels text DEFAULT NULL,
        p_extra  text DEFAULT NULL)
    RETURNS text
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    SELECT CASE
        WHEN p_key IS NULL THEN NULL
        WHEN p_key IN ('parts', 'kinds', 'related') THEN
            CASE
                WHEN NULLIF(p_topic, '') IS NOT NULL AND NULLIF(p_labels, '') IS NOT NULL
                    THEN p_topic || ' → ' || p_labels
                WHEN NULLIF(p_labels, '') IS NOT NULL THEN p_labels
                ELSE NULLIF(p_topic, '')
            END
        WHEN p_key = 'band' THEN
            -- p_extra is the technical band name.  Do not inject it into prose as if
            -- it were localized; the caller already owns the selected band coordinate.
            NULLIF(p_labels, '')
        WHEN p_key = 'core' THEN NULLIF(p_topic, '')
        WHEN p_key IN ('no_edges', 'no_type', 'no_forward') THEN
            CASE WHEN NULLIF(p_topic, '') IS NULL THEN '∅'
                 ELSE p_topic || ': ∅' END
        ELSE NULL
    END
$$;
