-- ops.source_status(): is this source ingested, and how do you know?
--
-- WHY THIS EXISTS. There was no standardized answer to the most basic operational
-- question in the system, so every caller assembled one, and every assembly was wrong in
-- a different way. The source inventory therefore comes from the substrate itself, while
-- the journal remains authority for the most recent operation and its measured health.
--
-- Throughput is the same rule: UI/API/MCP/CLI and CI must not independently parse logs
-- and invent different answers. The latest clean run carrying a throughput verdict is
-- projected alongside the latest run status. A later marker skip may be the latest run
-- while the previous real run remains the relevant throughput observation; an
-- `unmeasured` clean run is itself a verdict and must remain visible rather than exposing
-- an older green comparison.
DROP FUNCTION IF EXISTS ops.source_status(text);
DROP FUNCTION IF EXISTS laplace.source_status(text);

CREATE OR REPLACE FUNCTION ops.source_status(p_source text DEFAULT NULL)
    RETURNS TABLE(source                         text,
                  source_id                      bytea,
                  ingested                       boolean,
                  known                          boolean,
                  evidence_approx                bigint,
                  has_entities                   boolean,
                  last_run_status                text,
                  last_run_at                    timestamptz,
                  throughput_status              text,
                  throughput_compared            boolean,
                  throughput_rows_per_s          double precision,
                  throughput_baseline_rows_per_s double precision,
                  throughput_slowdown_ratio      double precision)
    LANGUAGE sql STABLE
    AS $$
WITH by_evidence AS (
    SELECT s.source_id, s.evidence_approx
    FROM ops.source_counts_approx() s
),
-- Journal is ops metadata: authoritative about the LAST RUN, never about substrate
-- existence. Keep this separate from by_throughput because a marker skip must not erase
-- the last real throughput verdict.
by_journal AS (
    SELECT DISTINCT ON (j.source_name)
           j.source_name, j.source_id, j.status, j.started_at
    FROM @extschema@.ingest_run_journal j
    ORDER BY j.source_name, j.started_at DESC
),
by_throughput AS (
    SELECT DISTINCT ON (j.source_name)
           j.source_name, j.source_id,
           j.throughput_status,
           j.throughput_compared,
           j.throughput_rows_per_s,
           j.throughput_baseline_rows_per_s,
           j.throughput_slowdown_ratio
    FROM @extschema@.ingest_run_journal j
    WHERE j.status = 'ok'
      AND j.throughput_status <> 'not-measured'
    ORDER BY j.source_name, j.started_at DESC
),
ids AS (
    SELECT source_id FROM by_evidence
    UNION SELECT source_id FROM by_journal WHERE source_id IS NOT NULL
),
rolled AS (
    SELECT i.source_id,
           -- EXACT FOR THE TAIL, ESTIMATE FOR THE HEAD. ops.source_counts_approx()
           -- derives evidence from planner MCV statistics. The estimator can miss a
           -- small source, so count only that tail exactly instead of scanning the head.
           COALESCE(ev.evidence_approx,
                    (SELECT count(*) FROM @extschema@.attestations a
                      WHERE a.source_id = i.source_id))             AS evidence_approx,
           EXISTS (SELECT 1 FROM @extschema@.entities e
                   WHERE e.first_observed_by = i.source_id)        AS has_entities,
           jr.source_name                                          AS journal_name,
           jr.status                                               AS last_run_status,
           jr.started_at                                           AS last_run_at,
           tp.throughput_status,
           COALESCE(tp.throughput_compared, false)                 AS throughput_compared,
           tp.throughput_rows_per_s,
           tp.throughput_baseline_rows_per_s,
           tp.throughput_slowdown_ratio
    FROM ids i
    LEFT JOIN by_evidence   ev ON ev.source_id = i.source_id
    LEFT JOIN by_journal    jr ON jr.source_id = i.source_id
    LEFT JOIN by_throughput tp ON tp.source_id = i.source_id
), rolled_numbered AS MATERIALIZED (
    SELECT r.*, row_number() OVER (ORDER BY r.source_id) AS rn FROM rolled r
), rendered AS MATERIALIZED (
    SELECT realize.render_batch(array_agg(source_id ORDER BY rn)) AS labels
    FROM rolled_numbered
),
matched AS (
    SELECT COALESCE(r.journal_name, x.labels[r.rn])                 AS source,
           r.source_id,
           (r.evidence_approx > 0 OR r.has_entities)                AS ingested,
           true                                                     AS known,
           r.evidence_approx,
           r.has_entities,
           r.last_run_status,
           r.last_run_at,
           r.throughput_status,
           r.throughput_compared,
           r.throughput_rows_per_s,
           r.throughput_baseline_rows_per_s,
           r.throughput_slowdown_ratio
    -- The journal's recorded name beats realize.render(): render returns a source's
    -- canonical path, which is correct and useless as an operator-facing lane label.
    FROM rolled_numbered r CROSS JOIN rendered x
    WHERE p_source IS NULL
       OR r.journal_name = p_source
       OR r.source_id = @extschema@.source_id(p_source)
)
SELECT * FROM matched
UNION ALL
-- A named query always returns one row: absence must not be overloaded with a typo.
SELECT p_source,
       @extschema@.source_id(p_source),
       false,
       EXISTS (SELECT 1 FROM @extschema@.entities e
               WHERE e.id = @extschema@.source_id(p_source)),
       0::bigint,
       false,
       NULL::text,
       NULL::timestamptz,
       NULL::text,
       false,
       NULL::double precision,
       NULL::double precision,
       NULL::double precision
WHERE p_source IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM matched)
ORDER BY evidence_approx DESC, source_id
$$;
