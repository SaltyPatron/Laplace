-- NO `SET search_path` (GH #860, #617 item 6). realize.realize() is the per-row labeling
-- scalar of the entire read path -- every arrow realize.render, every relation listing,
-- every reply. The clause made SQL inlining impossible, so each row paid a full
-- function execution for what is a COALESCE over four cheap resolvers.
--
-- GH #862: realize.realize, with its five resolvers as same-schema siblings.
DROP FUNCTION IF EXISTS laplace.realize(bytea, bytea);
CREATE OR REPLACE FUNCTION realize.realize(p_id bytea, p_lang bytea DEFAULT NULL)
    RETURNS text
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    -- realize.resolve_name() is the single, referentially-correct name primitive: it
    -- folds the former realize._has_name(HAS_NAME primary + HAS_NAME_ALIAS) and
    -- _realize_synset_lemma into one family-aware, abstaining resolver. It replaces
    -- the two separate arms this function used to run (synset-lemma first, HAS_NAME
    -- buried after translation); now the authoritative NAME wins ahead of a
    -- rendered self or a translation guess. The remaining arms stay as realize's
    -- own display fallbacks (raw realize.render, translation, canonical id, gloss).
    -- CONTENT BEFORE NAME. render_text is the VALUE an entity carries; resolve_name is
    -- the LABEL for it. An entity that has content must emit the content -- the name
    -- is metadata about it, not a substitute for it.
    --
    -- resolve_name used to come first, so any entity carrying a HAS_NAME edge emitted
    -- its name instead of itself. Unicode codepoints all carry one: measured over the
    -- 224 distinct constituents of 40 tier-3 containers, ALL 224 render and only 16
    -- carry a name -- and every one of those 16 is the label losing to the content:
    --   COLON / ':'   COMMA / ','   AMPERSAND / '&'   APOSTROPHE / '   DIGIT ONE / '1'
    --   HYPHEN-MINUS / '-'   LATIN CAPITAL LETTER X / 'X'
    -- Not one case where the name was the better emission. Downstream this is what put
    -- "year action MIDDLE DOT year active verb counterfactual in COLON" into a reply.
    --
    -- Reordering cannot lose a name, because every entity whose name IS the right
    -- answer has nothing to render and falls through the NULLIF: measured, a Language
    -- entity renders NULL and names 'English', a RelationType renders and names NULL,
    -- while the wolf synset renders 'wolf' and names NULL.
    SELECT COALESCE(
        NULLIF(realize.render_text(p_id), ''),
        realize.resolve_name(p_id, p_lang),
        realize._translation(p_id, p_lang),
        realize._canonical(p_id),
        realize._defines(p_id))
$$;
