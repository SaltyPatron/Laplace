#!/usr/bin/env bash
# Laplace substrate MCP server (stdio). Registered in .mcp.json; stdout is
# protocol frames only, so all launcher diagnostics go to stderr.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# RAW-SQL ESCAPE HATCH: OFF UNLESS EXPLICITLY ASKED FOR.
#
# The C# gate is correct and always was — OperatorLane requires
# LAPLACE_MCP_OPERATOR == "1" and defaults false. This line used to read
#
#     export LAPLACE_MCP_OPERATOR="${LAPLACE_MCP_OPERATOR:-1}"
#
# under a comment stating "the gate defaults CLOSED in code". Both halves were
# individually true and the combination was a backdoor: the C# default never
# applied, because the launcher every client actually starts through (.mcp.json
# registers this script) set the variable to 1 first. Arbitrary SELECT against the
# production substrate, on by default, described in the file as off by default.
#
# Read-only is not harmless. It is an exfiltration surface, and a denial-of-service
# one — an unbounded query on a 214 GB substrate holds backends and starves the
# ingest path, which is not hypothetical: it happened repeatedly while this session
# was probing with hand-written SQL.
#
# Opt in deliberately when you need it, per invocation:
#
#     LAPLACE_MCP_OPERATOR=1 scripts/laplace-mcp
#
# Everything else gets the typed tool surface, which is the point: a question the
# typed tools cannot answer is a missing tool, not a reason to reach past them.
export LAPLACE_MCP_OPERATOR="${LAPLACE_MCP_OPERATOR:-0}"

# Prefer repo-local builds (dev freshest), then the published apphost.
# app/Directory.Build.props redirects BaseOutputPath to $LAPLACE_BUILD_ROOT/app/bin
# (defaulting to D:\Data\Laplace on Windows), so the in-tree probe misses there.
BUILD_ROOT="${LAPLACE_BUILD_ROOT:-}"
if [[ -z "$BUILD_ROOT" && "${OS:-}" == "Windows_NT" ]]; then
  BUILD_ROOT="D:/Data/Laplace"
fi

CANDIDATES=(
  "$ROOT/app/Laplace.Endpoints.Mcp/bin/Release/net10.0/Laplace.Endpoints.Mcp.dll"
  "$ROOT/app/Laplace.Endpoints.Mcp/bin/Debug/net10.0/Laplace.Endpoints.Mcp.dll"
)
if [[ -n "$BUILD_ROOT" ]]; then
  CANDIDATES+=(
    "$BUILD_ROOT/app/bin/Laplace.Endpoints.Mcp/Release/net10.0/Laplace.Endpoints.Mcp.dll"
    "$BUILD_ROOT/app/bin/Laplace.Endpoints.Mcp/Debug/net10.0/Laplace.Endpoints.Mcp.dll"
  )
fi

for DLL in "${CANDIDATES[@]}"; do
  [[ -f "$DLL" ]] && exec dotnet "$DLL" "$@"
done

# Published apphost (deploy/linux/deploy.sh overlays it into the app dir).
APPHOST="${LAPLACE_APP_DIR:-/opt/laplace/app}/laplace-mcp"
[[ -x "$APPHOST" ]] && exec "$APPHOST" "$@"

echo "laplace-mcp: not built — run: dotnet build $ROOT/app/Laplace.Endpoints.Mcp" >&2
exit 1
