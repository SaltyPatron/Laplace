SQL_QUERY("write.journal_receipt", "bytea,bytea,text,bytea[]",
    "WITH receipt AS ( INSERT INTO laplace.ingest_flush_journal (working_set_id, source_id, receipt_kind) VALUES ($1, $2, $3) RETURNING working_set_id) INSERT INTO laplace.ingest_flush_journal_sources (working_set_id, source_id) SELECT receipt.working_set_id, source_id FROM receipt CROSS JOIN unnest($4::bytea[]) AS source_id")
