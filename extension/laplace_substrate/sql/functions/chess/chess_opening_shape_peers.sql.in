-- chess.opening_shape_peers(line_id): Hilbert/centroid locality prefilter, then
-- Frechet on REALIZED entity_curve — Cat/Act applied to chess opening lines.
--
-- NEVER Frechet on packed laplace.physicalities.trajectory (Rule #3). Catalog peers are
-- Chess_Game laplace.entities first-observed by ChessOpenings that carry a trajectory
-- (opening LINEs after the catalog-dual deposit) — not OPENING_NAME attestation
-- scans (that would re-introduce laplace.relation_type_id vocabulary literals; ISA G3).
--
-- IDS OUT: peer_line_id only. Name/ECO are separate laplace.attestations; realize.render via
-- realize_batch on a page of peer ids if needed — never per-row realize here.
DROP FUNCTION IF EXISTS laplace.chess_opening_shape_peers(bytea, integer, float8);
CREATE OR REPLACE FUNCTION chess.opening_shape_peers(
    p_line bytea,
    p_k integer DEFAULT 12,
    p_frechet_max float8 DEFAULT 0.05)
    RETURNS TABLE(
        peer_line_id bytea,
        geodesic double precision,
        frechet double precision)
    LANGUAGE plpgsql STABLE
 AS $peers$
DECLARE
    v_coord geometry;
    v_curve geometry;
    v_openings_src bytea := laplace.source_id('ChessOpenings');
    v_game_type bytea := laplace.entity_type_id('Chess_Game');
BEGIN
    SELECT p.coord, structural.entity_curve(p_line, 3::smallint)
      INTO v_coord, v_curve
    FROM laplace.physicalities p
    WHERE p.entity_id = p_line AND p.type = 3;
    IF v_coord IS NULL OR v_curve IS NULL THEN RETURN; END IF;

    RETURN QUERY
    WITH catalog AS MATERIALIZED (
        SELECT e.id AS line_id
        FROM laplace.entities e
        JOIN laplace.physicalities w ON w.entity_id = e.id AND w.type = 3
        WHERE e.type_id = v_game_type
          AND e.first_observed_by = v_openings_src
          AND e.id <> p_line
          AND w.coord IS NOT NULL
          AND w.trajectory IS NOT NULL
    ),
    knn AS (
        SELECT w.entity_id, w.coord
        FROM catalog c
        JOIN laplace.physicalities w ON w.entity_id = c.line_id AND w.type = 3
        ORDER BY w.coord <<->> v_coord
        LIMIT p_k
    ),
    scored AS (
        SELECT k.entity_id,
               public.laplace_angular_distance_4d(k.coord, v_coord) AS geo,
               public.laplace_frechet_4d(
                   structural.entity_curve(k.entity_id, 3::smallint), v_curve) AS fr
        FROM knn k
    )
    SELECT s.entity_id, s.geo, s.fr
    FROM scored s
    WHERE s.fr IS NOT NULL AND s.fr <= p_frechet_max
    ORDER BY s.fr ASC, s.geo ASC, s.entity_id
    LIMIT p_k;
END;
$peers$;
