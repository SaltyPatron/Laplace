-- realize._has_name — GH #862 / #860. No SET (this is on the per-row label path),
-- real schema names.
DROP FUNCTION IF EXISTS laplace._realize_has_name(bytea, bytea);
CREATE OR REPLACE FUNCTION realize._has_name(p_id bytea, p_lang bytea DEFAULT NULL)
    RETURNS text
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    -- RANK FIRST, THEN RENDER ONCE FOR ALL CANDIDATES.
    -- The `s <> ''` filter means an unrenderable candidate must fall through to the
    -- next, so the surface cannot be dropped from the decision -- but it does not have
    -- to be produced one candidate at a time. realize.render_text_batch runs ONE
    -- constituents closure over every id (generate_walk.c fetch_constituents_closure
    -- with n_roots); the scalar form ran one closure per candidate. Measured on 40 ids,
    -- identical md5: 487 ms per-row, 106 ms batched.
    -- Ranked in full, not capped: the render filter can reject any prefix, and a LIMIT
    -- here would turn "unrenderable" into "no name".
    WITH ranked AS MATERIALIZED (
        SELECT nm.object_id AS id,
               row_number() OVER (ORDER BY (lang.object_id IS NOT NULL) DESC,
                        (nm.type_id = laplace.relation_type_id('HAS_NAME')) DESC,
                        consensus.eff_mu(nm.rating, nm.rd) DESC, nm.object_id) AS rn
        FROM laplace.v_consensus_unrefuted nm
        LEFT JOIN laplace.consensus lang ON lang.subject_id = nm.object_id
          AND lang.type_id = laplace.relation_type_id('HAS_LANGUAGE')
          AND lang.object_id = p_lang
        WHERE nm.subject_id = p_id
          AND nm.type_id IN (laplace.relation_type_id('HAS_NAME'),
                             laplace.relation_type_id('HAS_NAME_ALIAS'))
    ),
    lbl AS MATERIALIZED (
        SELECT realize.render_text_batch(array_agg(r.id ORDER BY r.rn)) AS s
        FROM ranked r
    )
    SELECT l.s[r.rn]
    FROM ranked r CROSS JOIN lbl l
    WHERE l.s[r.rn] IS NOT NULL AND l.s[r.rn] <> ''
    ORDER BY r.rn
    LIMIT 1
$$;
