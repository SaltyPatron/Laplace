-- Views whose standing columns moved from the fixed-point bigint to float8 (143dee486).
-- CREATE OR REPLACE VIEW cannot change a column's type, so a view of the old shape is
-- dropped here with its dependent views and SQL functions; every one of them is created
-- again further down this script. Anything other than a view or a function depending on
-- one stops the upgrade instead of being dropped. A database already on the float8 shape,
-- or a fresh install, does nothing here.
DO $upgrade_shape$
DECLARE
    target record;
    blocking text;
BEGIN
    FOR target IN
        SELECT v.view, v.col FROM (VALUES
            ('laplace.v_consensus_resolved', 'eff_mu_raw'),
            ('laplace.v_consensus_edges', 'eff_mu_raw'),
            ('laplace.v_word_senses', 'eff_mu')) AS v(view, col)
        JOIN pg_attribute a ON a.attrelid = to_regclass(v.view) AND a.attname = v.col AND NOT a.attisdropped
        WHERE a.atttypid <> 'double precision'::regtype
    LOOP
        CONTINUE WHEN to_regclass(target.view) IS NULL;  -- already dropped with an earlier view
        WITH RECURSIVE dependent(classid, objid) AS (
            SELECT d.classid, COALESCE(r.ev_class, d.objid)
              FROM pg_depend d LEFT JOIN pg_rewrite r ON d.classid = 'pg_rewrite'::regclass AND r.oid = d.objid
             WHERE d.refclassid = 'pg_class'::regclass AND d.refobjid = to_regclass(target.view) AND d.deptype = 'n'
            UNION
            SELECT d.classid, COALESCE(r.ev_class, d.objid)
              FROM pg_depend d LEFT JOIN pg_rewrite r ON d.classid = 'pg_rewrite'::regclass AND r.oid = d.objid
              JOIN dependent ON d.refobjid = dependent.objid
             WHERE d.deptype = 'n')
        SELECT string_agg(pg_describe_object(classid, objid, 0), ', ')
          INTO blocking
          FROM dependent
         WHERE classid NOT IN ('pg_rewrite'::regclass, 'pg_proc'::regclass)
           AND NOT (classid = 'pg_class'::regclass AND (SELECT relkind FROM pg_class WHERE oid = objid) = 'v');
        IF blocking IS NOT NULL THEN
            RAISE EXCEPTION '% changes %.% to double precision but other objects depend on it: %',
                target.view, target.view, target.col, blocking;
        END IF;
        EXECUTE format('DROP VIEW %s CASCADE', target.view);
    END LOOP;
END $upgrade_shape$;
