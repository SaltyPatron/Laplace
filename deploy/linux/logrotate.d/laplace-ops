# Each role appends to a stable filename. copytruncate keeps the inode, so the open
# sink handle and the ops.* file_fdw tables keep the same path after rotation.
# laplace-*.csv already covers every role; naming a file twice makes logrotate
# reject the stanza as a duplicate log entry.
/opt/laplace/app/logs/laplace-*.csv {
    weekly
    rotate 8
    missingok
    notifempty
    copytruncate
    compress
    delaycompress
    su laplace-runner laplace-runner
}
