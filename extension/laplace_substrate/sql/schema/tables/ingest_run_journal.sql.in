-- Per-run ingest ledger: one row per run, inserted 'running' at start and driven
-- to a terminal status on every exit path. A 'running' row with no live ingest
-- process is a cut-off run; its counts and files_done say how far it got.
-- Operational state, not substrate content: rows are never folded, never
-- walked, and not preserved across dump/restore.
--
-- Status vocabulary. Terminal states are ok / failed / cancelled, plus capped
-- (an input-unit cap was set), skipped-complete (a run
-- short-circuited by a completion marker), and empty-noop (declared input,
-- applied none, could not account for it — the runner throws on this one).
--
-- The last three come from IIngestNoOpExplainer: a decomposer accounting for
-- a run that legitimately applied nothing.
--   already-present   novelty gate proved every record already in the substrate
--   already-complete  marker-gated backfill with nothing left to do
--   dependency-unset  optional dependency absent
--
-- The CHECK is a write gate: a status the writer emits and this list omits
-- raises 23514, the writer logs INGEST_RUN_JOURNAL_WRITE_FAILED without aborting
-- ingest, and the row stays 'running' like a killed run. A status added to
-- DeriveRunStatus or an explainer is added here too.
CREATE TABLE IF NOT EXISTS ingest_run_journal (
    run_id             uuid         PRIMARY KEY,
    source_name        text         NOT NULL,
    source_id          bytea        CHECK (source_id IS NULL OR octet_length(source_id) = 16),
    layer              int          NOT NULL,
    status             text         NOT NULL DEFAULT 'running'
        CHECK (status IN ('running','ok','failed','empty-noop','capped',
                          'cancelled','skipped-complete',
                          'already-present','already-complete','dependency-unset')),
    phase              text         NOT NULL DEFAULT 'extracting',
    started_at         timestamptz  NOT NULL DEFAULT now(),
    ended_at           timestamptz,
    units_attempted    bigint       NOT NULL DEFAULT 0,
    units_applied      bigint       NOT NULL DEFAULT 0,
    units_failed       bigint       NOT NULL DEFAULT 0,
    entities           bigint       NOT NULL DEFAULT 0,
    physicalities      bigint       NOT NULL DEFAULT 0,
    attestations       bigint       NOT NULL DEFAULT 0,
    files_done         bigint       NOT NULL DEFAULT 0,
    files_total        bigint       NOT NULL DEFAULT 0,
    input_units_done   bigint       NOT NULL DEFAULT 0,
    input_units_total  bigint       NOT NULL DEFAULT 0,
    fold_drain_ms      bigint       NOT NULL DEFAULT 0,
    writer_maintenance_ms bigint     NOT NULL DEFAULT 0,
    fold_span_ms       bigint       NOT NULL DEFAULT 0,
    consensus_backend_ms bigint     NOT NULL DEFAULT 0,
    highway_mask_backend_ms bigint  NOT NULL DEFAULT 0,
    consensus_calls    bigint       NOT NULL DEFAULT 0,
    highway_mask_calls bigint       NOT NULL DEFAULT 0,
    highway_mask_pairs bigint       NOT NULL DEFAULT 0,
    throughput_rows    bigint,
    throughput_elapsed_ms bigint,
    throughput_rows_per_s double precision,
    throughput_baseline_rows_per_s double precision,
    throughput_slowdown_ratio double precision,
    throughput_compared boolean      NOT NULL DEFAULT false,
    throughput_status  text          NOT NULL DEFAULT 'not-measured',
    evidence_persisted boolean      NOT NULL DEFAULT true,
    error              text
);

ALTER TABLE ingest_run_journal
    ADD COLUMN IF NOT EXISTS phase text NOT NULL DEFAULT 'extracting';
ALTER TABLE ingest_run_journal
    ADD COLUMN IF NOT EXISTS fold_drain_ms bigint NOT NULL DEFAULT 0;
ALTER TABLE ingest_run_journal
    ADD COLUMN IF NOT EXISTS writer_maintenance_ms bigint NOT NULL DEFAULT 0;
ALTER TABLE ingest_run_journal
    ADD COLUMN IF NOT EXISTS fold_span_ms bigint NOT NULL DEFAULT 0;
ALTER TABLE ingest_run_journal
    ADD COLUMN IF NOT EXISTS consensus_backend_ms bigint NOT NULL DEFAULT 0;
ALTER TABLE ingest_run_journal
    ADD COLUMN IF NOT EXISTS highway_mask_backend_ms bigint NOT NULL DEFAULT 0;
ALTER TABLE ingest_run_journal
    ADD COLUMN IF NOT EXISTS consensus_calls bigint NOT NULL DEFAULT 0;
ALTER TABLE ingest_run_journal
    ADD COLUMN IF NOT EXISTS highway_mask_calls bigint NOT NULL DEFAULT 0;
ALTER TABLE ingest_run_journal
    ADD COLUMN IF NOT EXISTS highway_mask_pairs bigint NOT NULL DEFAULT 0;
ALTER TABLE ingest_run_journal
    ADD COLUMN IF NOT EXISTS throughput_rows bigint;
ALTER TABLE ingest_run_journal
    ADD COLUMN IF NOT EXISTS throughput_elapsed_ms bigint;
ALTER TABLE ingest_run_journal
    ADD COLUMN IF NOT EXISTS throughput_rows_per_s double precision;
ALTER TABLE ingest_run_journal
    ADD COLUMN IF NOT EXISTS throughput_baseline_rows_per_s double precision;
ALTER TABLE ingest_run_journal
    ADD COLUMN IF NOT EXISTS throughput_slowdown_ratio double precision;
ALTER TABLE ingest_run_journal
    ADD COLUMN IF NOT EXISTS throughput_compared boolean NOT NULL DEFAULT false;
ALTER TABLE ingest_run_journal
    ADD COLUMN IF NOT EXISTS throughput_status text NOT NULL DEFAULT 'not-measured';

CREATE INDEX IF NOT EXISTS ingest_run_journal_source_started
    ON ingest_run_journal (source_name, started_at DESC);

-- Accepted baseline per source. An observed run rate is a measurement, not an
-- accepted standard; only ops.ingest_throughput_accept() establishes or moves a
-- baseline, and a source without one reads 'unbaselined'.
CREATE TABLE IF NOT EXISTS ingest_throughput_baseline (
    source_name          text PRIMARY KEY,
    baseline_rows_per_s  double precision NOT NULL CHECK (baseline_rows_per_s > 0),
    baseline_rows        bigint NOT NULL CHECK (baseline_rows > 0),
    baseline_elapsed_ms  bigint NOT NULL CHECK (baseline_elapsed_ms > 0),
    accepted_run_id      uuid,
    established_at       timestamptz NOT NULL DEFAULT now(),
    last_rows_per_s      double precision,
    last_run_id          uuid,
    last_slowdown_ratio  double precision,
    last_status          text,
    last_observed_at     timestamptz
);

-- Seed baselines for known decomposers, measured on the runner wall clock that
-- journal samples also use. ON CONFLICT DO NOTHING keeps any baseline already
-- accepted in this database.
INSERT INTO ingest_throughput_baseline
    (source_name, baseline_rows_per_s, baseline_rows, baseline_elapsed_ms, established_at)
VALUES
    ('CILIDecomposer',         50900.5, 5802654, 114000, now()),
    ('FrameNetDecomposer',      2558.6, 1399559, 547000, now()),
    ('ISO639Decomposer',       18405.5,   73622,   4000, now()),
    ('MapNetDecomposer',        3750.0,   15000,   4000, now()),
    ('PropBankDecomposer',     29019.1,  290191,  10000, now()),
    ('SemLinkDecomposer',       9030.2,   90302,  10000, now()),
