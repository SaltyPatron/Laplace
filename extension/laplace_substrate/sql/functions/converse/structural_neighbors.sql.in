-- Shape axis: Frechet over REALIZED curves (entity_curve), never packed
-- laplace.physicalities.trajectory (Rule #3 / Issue 51).
-- structural.neighbors — GH #862 / #860. No SET, real schema names.
DROP FUNCTION IF EXISTS laplace.structural_neighbors(text, integer);
CREATE OR REPLACE FUNCTION structural.neighbors(p_word text, p_k integer DEFAULT 10)
    RETURNS TABLE(neighbor text, geodesic double precision, frechet double precision)
    LANGUAGE plpgsql STABLE AS $sn$
DECLARE
    v_id    bytea;
    v_coord geometry;
    v_curve geometry;
BEGIN
    SELECT w.id, w.coord, structural.entity_curve(w.id)
      INTO v_id, v_coord, v_curve
    FROM laplace.v_word_points w
    JOIN converse.prompt_state(p_word) s ON w.id = s.id
    WHERE w.coord IS NOT NULL
    ORDER BY s.ord, w.physicality_id
    LIMIT 1;
    IF v_id IS NULL THEN RETURN; END IF;

    RETURN QUERY
    WITH knn AS (
        SELECT w.id AS entity_id, w.coord
        FROM laplace.v_word_points w
        WHERE w.coord IS NOT NULL
        ORDER BY w.coord <<->> v_coord
        LIMIT GREATEST(p_k * 20, 200)),
    dedup AS (
        SELECT DISTINCT ON (k.entity_id) k.entity_id,
               public.laplace_angular_distance_4d(k.coord, v_coord) AS geo
        FROM knn k
        ORDER BY k.entity_id, public.laplace_angular_distance_4d(k.coord, v_coord)),
    nearest AS (
        SELECT entity_id, geo
        FROM dedup
        WHERE entity_id <> v_id
        ORDER BY geo
        LIMIT p_k),
    -- Resolve via the full mesh in ONE realize_batch over the <= p_k survivors
    -- (was: scalar realize per neighbour). Hubs surface as their real word;
    -- only truly unlabelable nodes drop (abstention, no hex here by design).
    ordered AS (
        SELECT t.*, row_number() OVER (ORDER BY t.geo) AS ord
        FROM nearest t
    ),
    curves AS (
        SELECT o.entity_id, o.geo, o.ord, structural.entity_curve(o.entity_id) AS curve
        FROM ordered o
    ),
    labels AS (
        SELECT realize.batch(array_agg(c.entity_id ORDER BY c.ord)) AS l
        FROM curves c
    )
    SELECT r.lbl, r.geo, r.frechet FROM (
        SELECT labels.l[c.ord] AS lbl, c.geo, c.ord,
               CASE WHEN c.curve IS NOT NULL AND v_curve IS NOT NULL
                    THEN public.laplace_frechet_4d(c.curve, v_curve) END AS frechet
        FROM curves c, labels
    ) r
    WHERE r.lbl IS NOT NULL AND r.lbl <> ''
    ORDER BY r.ord;
END;
$sn$;
