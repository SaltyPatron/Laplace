-- explore_anchor_neighbors: neighbour search from a COMPUTED anchor geometry,
-- not a stored one. When a word (or any content) is typed but never witnessed,
-- its content hash resolves to an id with no laplace.entities/laplace.physicalities row
-- (exists = false) -- yet its geometry is fully determined: HashComposer pins
-- every codepoint on S3 from the t0 perfcache and composes the parent coord and
-- trajectory in-process. The endpoint hands that computed anchor here as bound
-- parameters (centroid coord + optional trajectory WKT), so the KNN runs on a
-- real index-ordered scan (bound param, GiST-eligible -- unlike a correlated
-- subquery anchor) instead of returning nothing for want of a stored row.
--
-- Two axes, deliberately different notions of "near" (both returned so the UI
-- can navigate either way):
--   geodesic -- nearest witnessed content of ANY tier by the anchor centroid on
--     the glome. Positional/content proximity; centroids commute, so it mixes
--     tiers/modalities. Fast: index-ordered coord <<->> prefilter.
--   shape    -- nearest witnessed WORDS by REALIZED curve shape (Frechet over
--     entity_curve = ST_MakeLine(child.coord ORDER BY ordinal)). p_traj_wkt from
--     ExploreDecomposeService is already a realized LINESTRING ZM of child
--     coords; candidates must use entity_curve, never packed
--     laplace.physicalities.trajectory (Rule #3 / Issue 51).
DROP FUNCTION IF EXISTS laplace.explore_anchor_neighbors(float8, float8, float8, float8, text, integer, integer, float8);
CREATE OR REPLACE FUNCTION structural.explore_anchor_neighbors(
    p_cx float8, p_cy float8, p_cz float8, p_cm float8,
    p_traj_wkt   text    DEFAULT NULL,
    p_geodesic_k integer DEFAULT 12,
    p_frechet_k  integer DEFAULT 12,
    p_frechet_max float8  DEFAULT 0.08)
RETURNS TABLE(
    axis        text,
    entity_id   bytea,
    label       text,
    tier        smallint,
    geodesic    float8,
    frechet     float8)
LANGUAGE plpgsql STABLE PARALLEL SAFE
 AS $$
DECLARE
    v_anchor geometry := public.ST_SetSRID(
        public.ST_MakePoint(p_cx, p_cy, p_cz, p_cm), 0);
    v_traj   geometry := CASE
        WHEN p_traj_wkt IS NULL OR p_traj_wkt = '' THEN NULL
        ELSE public.ST_SetSRID(public.ST_GeomFromText(p_traj_wkt), 0)
    END;
BEGIN
    -- Geodesic: exact angular KNN on unit directions, then label the caller-sized
    -- result once. Chord order on S3 is angular order; no candidate multiplier.
    RETURN QUERY
    WITH g AS (
        SELECT w.id AS entity_id,
               public.laplace_angular_distance_4d(w.coord, v_anchor) AS geo
        FROM laplace.v_word_points w
        WHERE public.laplace_direction_4d(w.coord) IS NOT NULL
          AND public.laplace_direction_4d(v_anchor) IS NOT NULL
        ORDER BY public.laplace_direction_4d(w.coord)
                 <<->> public.laplace_direction_4d(v_anchor)
        LIMIT p_geodesic_k
    ), numbered AS MATERIALIZED (
        SELECT g.*, row_number() OVER (ORDER BY g.geo, g.entity_id) AS rn FROM g
    ), ids AS MATERIALIZED (
        SELECT array_agg(numbered.entity_id ORDER BY numbered.rn) AS a FROM numbered
    ), display AS MATERIALIZED (
        SELECT realize.render_text_batch(a) AS rendered,
               realize.label_batch(a) AS labels
        FROM ids
    )
    SELECT 'geodesic'::text,
           n.entity_id,
           COALESCE(NULLIF(d.rendered[n.rn], ''), d.labels[n.rn]),
           (SELECT min(e.tier) FROM laplace.entities e WHERE e.id = n.entity_id),
           n.geo,
           NULL::float8
    FROM numbered n CROSS JOIN display d
    ORDER BY n.geo;

    -- Shape: p_frechet_k is the exact coordinate-nearest candidate/output
    -- budget. Frechet filters that declared population; there is no hidden
    -- 500-row workload behind a request for fewer rows.
    IF v_traj IS NOT NULL THEN
        RETURN QUERY
        WITH pre AS (
            SELECT w.id AS entity_id
            FROM laplace.v_word_points w
            WHERE w.tier = 2 AND w.trajectory IS NOT NULL
            ORDER BY w.coord <<->> v_anchor
            LIMIT p_frechet_k
        ),
        f AS (
            SELECT c.entity_id,
                   public.laplace_frechet_4d(c.curve, v_traj) AS fr
            FROM (
                SELECT pre.entity_id, structural.entity_curve(pre.entity_id) AS curve
                FROM pre
            ) c
            WHERE c.curve IS NOT NULL
        ), survivors AS MATERIALIZED (
            SELECT f.entity_id, f.fr
            FROM f
            WHERE f.fr IS NOT NULL AND f.fr <= p_frechet_max
            ORDER BY f.fr, f.entity_id
        ), numbered AS MATERIALIZED (
            SELECT s.*, row_number() OVER (ORDER BY s.fr, s.entity_id) AS rn FROM survivors s
        ), ids AS MATERIALIZED (
            SELECT array_agg(numbered.entity_id ORDER BY numbered.rn) AS a FROM numbered
        ), display AS MATERIALIZED (
            SELECT realize.render_text_batch(a) AS rendered,
                   realize.label_batch(a) AS labels
            FROM ids
        )
        SELECT 'shape'::text,
               f.entity_id,
               COALESCE(NULLIF(d.rendered[f.rn], ''), d.labels[f.rn]),
               2::smallint,
               NULL::float8,
               f.fr
        FROM numbered f CROSS JOIN display d
        ORDER BY f.fr
        ;
    END IF;
END;
$$;
