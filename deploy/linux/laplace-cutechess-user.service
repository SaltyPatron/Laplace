[Unit]
Description=Laplace persistent CuteChess
Documentation=https://github.com/SaltyPatron/Laplace

[Service]
Type=simple
UMask=0077
RuntimeDirectory=laplace-cutechess
RuntimeDirectoryMode=0700
StandardOutput=append:%h/.config/laplace/cutechess-session.log
StandardError=inherit
ExecStart=/usr/bin/python3 %h/.local/lib/laplace-cutechess/laplace-cutechess-user-session
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
NoNewPrivileges=yes

[Install]
WantedBy=default.target
