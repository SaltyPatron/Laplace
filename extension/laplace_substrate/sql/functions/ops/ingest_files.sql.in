-- Physical artifact inventory and admitted-file lifecycle for one ingest run.
-- Actionable admitted states sort first; explicit non-selected dispositions remain
-- readable after completed files instead of disappearing during source selection.
DROP FUNCTION IF EXISTS laplace.ingest_files(uuid, int);

CREATE OR REPLACE FUNCTION ops.ingest_files(p_run_id uuid, p_limit int DEFAULT 200)
    RETURNS SETOF laplace.ingest_file_journal
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT *
    FROM laplace.ingest_file_journal
    WHERE run_id = p_run_id
    ORDER BY
        CASE status
            WHEN 'running' THEN 0
            WHEN 'composed' THEN 1
            WHEN 'inventoried' THEN 2
            WHEN 'failed' THEN 3
            WHEN 'cancelled' THEN 4
            WHEN 'not-selected' THEN 6
            ELSE 5
        END,
        COALESCE(ended_at, started_at) DESC,
        file_label
    LIMIT greatest(p_limit, 0);
END;
