CREATE OR REPLACE FUNCTION converse.synonyms(p_word bytea, p_limit int DEFAULT 10)
    RETURNS TABLE(synonym text, eff_mu numeric, witnesses bigint)
    LANGUAGE plpgsql LAPLACE_STABLE_STRICT
AS $$
BEGIN
    IF p_word IS NULL OR p_limit <= 0 THEN
        RETURN;
    END IF;

    RETURN QUERY
    WITH raw_members AS MATERIALIZED (
        SELECT * FROM lexical.synset_members(p_word)
    ),
    src_lang AS MATERIALIZED (
        SELECT COALESCE(
            (SELECT rm.lang FROM raw_members rm WHERE rm.lang IS NOT NULL GROUP BY rm.lang ORDER BY count(*) DESC, rm.lang LIMIT 1),
            CASE WHEN EXISTS (SELECT 1 FROM raw_members WHERE lang IS NOT NULL) THEN NULL ELSE converse.word_language(p_word) END
        ) AS id
    ),
    agg AS (
        SELECT sm.member, max(sm.mu) AS mu, max(sm.witnesses) AS witnesses,
               max(sm.sense_mu) AS sense_mu
        FROM raw_members sm
        WHERE sm.lang = (SELECT id FROM src_lang)
        GROUP BY sm.member
    ),
    ranked AS MATERIALIZED (
        SELECT agg.member, agg.mu, agg.witnesses,
               row_number() OVER (ORDER BY agg.sense_mu DESC NULLS LAST, agg.mu DESC, agg.witnesses DESC, agg.member) AS rn
        FROM agg
        ORDER BY agg.sense_mu DESC NULLS LAST, agg.mu DESC, agg.witnesses DESC, agg.member
        LIMIT p_limit
    ),
    rendered AS MATERIALIZED (
        SELECT ARRAY(SELECT NULLIF(lp_l.content,lp_l.entity::text) FROM unnest((array_agg(ranked.member ORDER BY ranked.rn))::bytea[]) WITH ORDINALITY lp_u(x,n) LEFT JOIN (SELECT DISTINCT ON (lp_d.entity) lp_d.entity,lp_d.content FROM public.laplace_labels(array_remove((array_agg(ranked.member ORDER BY ranked.rn))::bytea[],NULL)::public.blake3[]) lp_d) lp_l ON lp_l.entity=lp_u.x::public.blake3 ORDER BY lp_u.n) AS txt
        FROM ranked
    )
    SELECT NULLIF(btrim(r.txt[a.rn]), '') AS synonym,
           consensus.eff_mu_display(a.mu, 0) AS eff_mu,
           a.witnesses
    FROM ranked a
    CROSS JOIN rendered r
    WHERE NULLIF(btrim(r.txt[a.rn]), '') IS NOT NULL
    ORDER BY a.rn;
END;
$$;
