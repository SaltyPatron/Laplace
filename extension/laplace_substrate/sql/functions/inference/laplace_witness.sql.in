DROP FUNCTION IF EXISTS laplace.laplace_witness(bytea, bytea, bytea, bytea, bigint);
CREATE OR REPLACE FUNCTION generation.witness(
    p_subject  bytea, p_type  bytea, p_object  bytea,
    p_source   bytea,
    p_score_fp1e9 bigint DEFAULT 1000000000)
RETURNS void
LANGUAGE sql VOLATILE
BEGIN ATOMIC
    SELECT consensus.upsert_type(
        p_type,
        ARRAY[p_subject]::bytea[],
        ARRAY[p_object]::bytea[],
        ARRAY[consensus.glicko2_initial_rd()]::bigint[],
        ARRAY[1::bigint],
        ARRAY[p_score_fp1e9]::bigint[],
        ARRAY[now()]::timestamptz[]);
END;
