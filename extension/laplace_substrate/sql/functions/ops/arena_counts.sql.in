CREATE OR REPLACE FUNCTION ops.arena_counts()
    RETURNS TABLE(type text, type_id bytea, relations bigint, witnesses bigint,
                  top_eff_mu numeric)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    WITH raw AS MATERIALIZED (
      SELECT c.type_id, count(*) AS relations, sum(c.witness_count) AS witnesses,
             max(consensus.eff_mu_display(c.rating, c.rd)) AS top_eff_mu
    FROM @extschema@.consensus c
    GROUP BY c.type_id
    ), numbered AS MATERIALIZED (
      SELECT r.*, row_number() OVER (ORDER BY relations DESC, type_id) AS rn FROM raw r
    ), batch AS MATERIALIZED (
      SELECT ARRAY(SELECT lp_l.content FROM unnest((array_agg(type_id ORDER BY rn))::bytea[]) WITH ORDINALITY lp_u(x,n) LEFT JOIN (SELECT DISTINCT ON (lp_d.entity) lp_d.entity,lp_d.content FROM public.laplace_labels(array_remove((array_agg(type_id ORDER BY rn))::bytea[],NULL)::public.blake3[]) lp_d) lp_l ON lp_l.entity=lp_u.x::public.blake3 ORDER BY lp_u.n) AS labels FROM numbered
    )
    SELECT b.labels[n.rn], n.type_id, n.relations, n.witnesses, n.top_eff_mu
    FROM numbered n CROSS JOIN batch b ORDER BY n.rn;
END;
