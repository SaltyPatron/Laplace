-- realize.label — GH #862 / #860. A label is a rendering decision, so it lives with
-- the realize family. No SET (it invalidates plan caching and this is per-row on the
-- realize.render path); real schema names.
DROP FUNCTION IF EXISTS laplace.label(bytea);
CREATE OR REPLACE FUNCTION realize.label(p_id bytea)
    RETURNS text
    LANGUAGE sql LAPLACE_STABLE_STRICT
BEGIN ATOMIC

    -- A label is a surface, never a definition. An unresolved label abstains; a
    -- content hash is an internal identity handle, not a surface.
    -- The entity's own realization comes first: realize.render lexicalizes an identifier
    -- through its bindings and renders content as its own surface. A name labels only
    -- what has no surface. Name-first rendered the word "not" as "Nomatsiguenga" (its
    -- ISO 639-3 code's language name).
    SELECT COALESCE(
        NULLIF(
            regexp_replace(
            regexp_replace(
                regexp_replace(
                    regexp_replace(
                        regexp_replace(
                            regexp_replace(
                                regexp_replace(
                                    regexp_replace(realize.render(p_id),
                                        '^substrate/(?:type|relation|trust_class|source|entity)/(.*)/v1$', '\1'),
                                    '^substrate/pos/(?:probationary/[^/]+/)?(.+)/v1$', '\1'),
                                '^source/file/(.+)/v1$', '\1'),
                            '^repo:(.+)/v1$', '\1'),
                        '^language:([a-z]{3})$', '\1'),
                    '^ud/feature/(.+)$', '\1'),
                '^tiny-codes/concept/(.+)/v1$', '\1'),
            '^(i[0-9]+|[0-9]{6,}-[nvarspNVARSP])$', ''),
            ''),
        realize.resolve_name(p_id))
;
END;

-- realize.display_label_batch — the FINAL bounded-display projection used by Explore.
--
-- This is intentionally NOT the semantic contract of realize.label(). `label` must abstain
-- when an entity has no name/surface. A product display still needs something intelligible
-- to paint after its candidate set has been elected. The display projection therefore adds
-- bounded, containment-owned previews and descriptive metadata while keeping the complete
-- identity in a separate id column. If friendly realization is exhausted, the display label
-- itself retains a short canonical id so a known entity is never replaced by a generic status.
--
-- GH #804: form is caller/containment-owned, not inferred from entity.type_id. Exact
-- self-rendering stops at sentence grain. Higher-tier text is previewed only when a
-- witnessed role or the entity's own Content physicality proves containment.
-- Provenance operands obey the same preview boundary; opaque content falls through to a name, relation,
-- type/source description plus short canonical identity rather than being silently
-- projected through a text lens or replaced by a generic unresolved placeholder.
CREATE OR REPLACE FUNCTION realize.display_label_batch(p_ids bytea[])
    RETURNS TABLE(id bytea, label text, tier smallint)
    AS 'EXECUTION_LIBRARY', 'pg_laplace_display_label_batch'
    LANGUAGE C STABLE STRICT
    SUPPORT @extschema@.array_length_rows_support
    ROWS 100;
