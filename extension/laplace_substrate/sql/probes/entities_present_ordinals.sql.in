-- Ordinals and bitmaps share the native HASH(id) set scan. The input's order,
-- duplicates and zero-based ordinals survive routing; NULL/malformed ids miss.
CREATE OR REPLACE FUNCTION laplace.entities_present_ordinals(p_ids bytea[])
    RETURNS TABLE(idx int)
    AS 'EXECUTION_LIBRARY', 'pg_laplace_entities_present_ordinals'
    LANGUAGE C STABLE PARALLEL RESTRICTED;

-- The old (ids,tiers) plpgsql overload materialized a temp table, built an index,
-- looped tiers, and dynamically relied on per-iteration planning. It has no caller:
-- the hot tier-keyed route is laplace.entities_stored_bitmap/tier_batch_existence_probe,
-- whose native implementation owns the routing directly. Keep one operation, not a
-- second SQL implementation that can drift back onto the hot path.
DROP FUNCTION IF EXISTS laplace.entities_present_ordinals(bytea[], smallint[]);
