-- Typed leaderboard pages in complete deterministic order: one indexed page per
-- requested relation, pruned to its partition. The refutation test sits in the
-- partial predicate so refuted cells never consume the page.
CREATE INDEX IF NOT EXISTS consensus_type_rank_btree
    ON consensus (type_id, ((rating - 2*rd)) DESC, subject_id, object_id)
    WHERE object_id IS NOT NULL AND NOT consensus.refuted(rating, rd);
