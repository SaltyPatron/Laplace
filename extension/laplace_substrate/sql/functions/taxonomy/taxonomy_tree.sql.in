-- The IS_A tree around a topic: dir='self' the root (a bare surface hops to
-- its top synset — taxonomy lives on concepts, not spellings), dir='up' the
-- parent chain to the root, dir='child' the strongest sub-kinds.
DROP FUNCTION IF EXISTS laplace.taxonomy_tree(bytea);
DROP FUNCTION IF EXISTS taxonomy.tree(bytea);
CREATE OR REPLACE FUNCTION taxonomy.tree(
    p_id bytea,
    p_depth integer DEFAULT NULL,
    p_child_limit integer DEFAULT NULL)
    RETURNS TABLE(dir text, ord int, id bytea, label text, eff_mu numeric)
    LANGUAGE sql STABLE
    AS $$
    WITH root AS MATERIALIZED (
        SELECT COALESCE(taxonomy.top_synset(p_id), p_id) AS id
    ), raw AS MATERIALIZED (
      SELECT 'self'::text AS dir, 0 AS ord, root.id, NULL::numeric AS eff_mu FROM root
      UNION ALL
      SELECT 'up', w.step, w.entity_id, w.eff_mu
      FROM root, consensus.walk_strongest(
          root.id, laplace.relation_type_id('IS_A'), p_depth) w
      UNION ALL
      (SELECT 'child',
            row_number() OVER (ORDER BY consensus.eff_mu_display(c.rating, c.rd) DESC)::int,
            c.subject_id,
            consensus.eff_mu_display(c.rating, c.rd)
       FROM root JOIN laplace.consensus c
         ON c.object_id = root.id AND c.type_id = laplace.relation_type_id('IS_A')
       ORDER BY consensus.eff_mu_display(c.rating, c.rd) DESC
       LIMIT GREATEST(p_child_limit, 0))
    ), ids AS MATERIALIZED (
      SELECT array_agg(DISTINCT id ORDER BY id) AS a FROM raw
    ), labels AS MATERIALIZED (
      SELECT i.id, l.txt FROM ids,
        LATERAL unnest(ids.a) WITH ORDINALITY i(id, ord),
        LATERAL unnest(realize.label_batch(ids.a)) WITH ORDINALITY l(txt, ord)
      WHERE i.ord=l.ord
    )
    SELECT r.dir, r.ord, r.id, l.txt, r.eff_mu
    FROM raw r JOIN labels l ON l.id=r.id
    ORDER BY CASE r.dir WHEN 'self' THEN 0 WHEN 'up' THEN 1 ELSE 2 END, r.ord
$$;
