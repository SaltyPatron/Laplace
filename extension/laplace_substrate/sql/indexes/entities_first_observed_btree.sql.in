-- Provenance of an interpretation belongs to entity_interpretations. The
-- canonical entity row carries only a deterministic compatibility summary, so
-- source/tier diagnostics and gates must not index or predicate on that summary.
DO $do$
BEGIN
    BEGIN
        EXECUTE format('ALTER EXTENSION %I DROP INDEX laplace.entities_first_observed_btree',
                       'laplace_substrate');
    EXCEPTION WHEN OTHERS THEN
        NULL;
    END;
    EXECUTE 'DROP INDEX IF EXISTS laplace.entities_first_observed_btree';
END $do$;

CREATE INDEX IF NOT EXISTS entity_interpretations_source_tier_btree
    ON entity_interpretations USING btree (first_observed_by, tier, entity_id, type_id)
    WHERE first_observed_by IS NOT NULL;
