-- Tier-0 census: codepoint entities against the admitted atom window.
-- atom_window comes from the perfcache format constant; over_window > 0 means
-- non-atoms were stored as atoms. unresolvable_ids is always 0: no
-- codepoint_for_id sweep over the window runs here.
CREATE OR REPLACE FUNCTION laplace.atom_census()
    RETURNS TABLE(
        tier0_count bigint,
        atom_window bigint,
        over_window bigint,
        unresolvable_ids bigint)
    LANGUAGE sql
    STABLE
BEGIN ATOMIC
    WITH w AS (SELECT laplace.atom_window() AS n),
         t AS (SELECT ops.entity_count(laplace.entity_type_id('Codepoint')) AS n)
    SELECT t.n,
           w.n,
           greatest(0, t.n - w.n),
           0::bigint
    FROM w, t;
END;
