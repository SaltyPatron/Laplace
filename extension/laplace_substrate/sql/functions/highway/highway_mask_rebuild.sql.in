-- Full population of entities.highway_mask via highway_mask_refresh, batched with a
-- COMMIT per batch. This is the historical RECONCILE tool for a database that
-- predates inline exact-pair deposit. Normal ingest never calls this: current writes
-- populate masks directly from the (entity,type) pairs already held by the fold.
--
-- Current Highway bits are an explicit append-only registry. This procedure therefore
-- does not clear masks before reconciling: existing bits remain valid, while any missing
-- governed relation bits are added by recomputation. Per-source eviction still uses the
-- dirty/drain path because it is the operation that must clear bits.
--
-- SCAN SET: drive batches from the candidate set, not every entity. An entity that
-- appears in no consensus row cannot gain a mask from this repair. Entities that are
-- already masked remain candidates so stale bits can still be corrected by refresh.
--
-- No SET clause on the procedure: a PL/pgSQL procedure carrying a SET clause is barred
-- from transaction control (COMMIT), so references are schema-qualified.
DROP PROCEDURE IF EXISTS laplace.highway_mask_rebuild(int);

CREATE OR REPLACE PROCEDURE laplace.highway_mask_rebuild(p_batch int DEFAULT 500000)
    LANGUAGE plpgsql AS $$
DECLARE
    last_id bytea := decode(repeat('00', 16), 'hex');
    ids bytea[];
    n bigint;
    total bigint := 0;
    scanned bigint := 0;
    candidates bigint;
    t0 timestamptz := clock_timestamp();
BEGIN
    IF p_batch IS NULL OR p_batch < 1 THEN
        RAISE EXCEPTION 'highway_mask_rebuild: p_batch must be >= 1';
    END IF;
    IF NOT consensus.highway_ready() THEN
        RAISE LOG 'highway_mask_rebuild: Highway registry unavailable; historical population remains pending';
        RETURN;
    END IF;

    -- Exact pairs retained during any registry outage are cheaper and more precise than
    -- rediscovery, so replay them before the historical consensus reconciliation.
    CALL laplace.highway_mask_pending_drain(p_batch);

    -- Plain TEMP table (ON COMMIT PRESERVE ROWS): the per-batch COMMIT below would
    -- drop an ON COMMIT DROP table out from under the loop.
    DROP TABLE IF EXISTS _hmr_candidates;
    CREATE TEMP TABLE _hmr_candidates (id bytea PRIMARY KEY);

    INSERT INTO _hmr_candidates (id)
    SELECT c.subject_id FROM laplace.consensus c
    UNION
    SELECT c.object_id  FROM laplace.consensus c WHERE c.object_id IS NOT NULL
    UNION
    SELECT e.id FROM laplace.entities e WHERE e.highway_mask IS NOT NULL;
    GET DIAGNOSTICS candidates = ROW_COUNT;

    RAISE LOG 'highway_mask_rebuild: start — % mask candidates', candidates;
    COMMIT;

    LOOP
        SELECT array_agg(s.id ORDER BY s.id) INTO ids FROM (
            SELECT id FROM _hmr_candidates WHERE id > last_id ORDER BY id LIMIT p_batch) s;
        EXIT WHEN ids IS NULL;
        n := consensus.highway_mask_refresh(ids);
        total := total + n;
        scanned := scanned + cardinality(ids);
        last_id := ids[cardinality(ids)];
        RAISE LOG 'highway_mask_rebuild: % masks written / % of % candidates (% percent) — %s elapsed',
            total, scanned, candidates,
            round(100.0 * scanned / NULLIF(candidates, 0), 1),
            round(extract(epoch FROM clock_timestamp() - t0)::numeric, 1);
        COMMIT;
    END LOOP;

    UPDATE laplace.highway_mask_population_state
       SET complete = true,
           completed_at = clock_timestamp()
     WHERE singleton;
    COMMIT;

    RAISE LOG 'highway_mask_rebuild: done — % masks written / % candidates in %s',
        total, scanned, round(extract(epoch FROM clock_timestamp() - t0)::numeric, 1);
    DROP TABLE IF EXISTS _hmr_candidates;
END $$;
