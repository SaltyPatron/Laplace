-- senses: HAS_SENSE-family read (R2). Prefer bubble_up for top-k + domain;
-- this keeps the classic (sense, synset, laplace.eff_mu, witnesses) shape for lexical.define().
-- No SET search_path and no STRICT so it inlines into callers (both block
-- inlining; #617). NULL-safety is preserved without STRICT: taxonomy.bubble_up(NULL)
-- yields zero rows (lexical_peers is STRICT -> NULL array -> empty unnest).
-- lexical.senses — GH #862. Every call site moves in this same commit; a rename
-- with a live caller is a tree that does not install.
DROP FUNCTION IF EXISTS laplace.senses(bytea);
CREATE OR REPLACE FUNCTION lexical.senses(p_word bytea)
    RETURNS TABLE(sense_id bytea, synset_id bytea, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    SELECT b.sense_id, b.synset_id, b.base_eff_mu, b.witnesses
    FROM taxonomy.bubble_up(p_word, NULL::bytea[], 64) b
    -- EVIDENCE BEFORE ADJUDICATED STRENGTH — see the matching note in
    -- bubble_up.sql.in. This ORDER BY is the one that decides what callers see:
    -- bubble_up's own ordering only selects which 64 candidates survive its
    -- LIMIT, and this re-sorts them.
    --
    -- Measured on the foundation ladder before the change,
    -- lexical.senses(laplace.word_id('water')):
    --     urine   1 witness   1169.73   <- elected
    --     water   1 witness   1169.73
    --     water   1 witness   1169.73
    --     water   2 witnesses 1168.45
    --     water   2 witnesses 1165.57
    -- Three senses tie exactly at the top on one witness each, so the id memcmp
    -- decided, and it chose urine over water for the word "water". Senses with
    -- twice the evidence sat below, losing by 1.28 on a quantity whose
    -- uncertainty term exceeds its signal — W16 3.2 measured mean
    -- |rating - neutral| 192.85 against mean rd 262.24 across 447,145 consensus
    -- rows, so 2*rd runs ~2.7x the signal and laplace.eff_mu sorts substantially by how
    -- little rd has shrunk.
    ORDER BY b.witnesses DESC, b.score DESC
$$;
