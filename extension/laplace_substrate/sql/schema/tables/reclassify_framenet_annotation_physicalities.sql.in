-- FrameNet fulltext annotations are ordered structural records, not content DAG nodes.
--
-- The historical producer wrote [annotation-schema, sentence-content, source offsets,
-- target-content] as PhysicalityType.Content (1). That admitted opaque schema/offset
-- reference ids into the content trajectory indexes and made recursive content closure
-- demand Content physicalities for source coordinates. The text branches themselves
-- were always admitted through ContentEmitter and remain unchanged.
--
-- Physicality identity is BLAKE3(entity_id || int16_le(type)). Reclassifying type
-- therefore requires moving the row to the corresponding type=8 id as one UPDATE;
-- physicalities is HASH(id)-partitioned and PostgreSQL performs the partition move.
-- Idempotent: once repaired, no type=1 FrameNet_Annotation rows remain.
DO $repair_framenet_annotation_physicalities$
DECLARE
    annotation_type bytea := public.laplace_hash128_blake3('FrameNet_Annotation'::bytea);
    repaired bigint := 0;
BEGIN
    IF to_regclass('laplace.physicalities') IS NULL
       OR to_regclass('laplace.entities') IS NULL THEN
        RETURN;
    END IF;

    IF EXISTS (
        WITH candidates AS (
            SELECT p.id AS old_id,
                   public.laplace_hash128_blake3(p.entity_id || decode('0800','hex')) AS new_id
            FROM laplace.physicalities p
            JOIN laplace.entities e ON e.id = p.entity_id
            WHERE p.type = 1
              AND e.type_id = annotation_type
        )
        SELECT 1
        FROM candidates c
        JOIN laplace.physicalities existing ON existing.id = c.new_id
        WHERE existing.id <> c.old_id
    ) THEN
        RAISE EXCEPTION
            'FrameNet annotation physicality repair found a conflicting type=8 physicality id';
    END IF;

    WITH candidates AS MATERIALIZED (
        SELECT p.id AS old_id,
               public.laplace_hash128_blake3(p.entity_id || decode('0800','hex')) AS new_id
        FROM laplace.physicalities p
        JOIN laplace.entities e ON e.id = p.entity_id
        WHERE p.type = 1
          AND e.type_id = annotation_type
    )
    UPDATE laplace.physicalities p
       SET id = c.new_id,
           type = 8
      FROM candidates c
     WHERE p.id = c.old_id;

    GET DIAGNOSTICS repaired = ROW_COUNT;
    RAISE NOTICE 'FrameNet annotation physicality repair: reclassified % row(s) Content -> ParseStructure', repaired;
END
$repair_framenet_annotation_physicalities$;
