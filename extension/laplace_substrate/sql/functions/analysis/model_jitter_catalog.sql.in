-- Model-witnessed cells that are asserted but corroborated by nobody: a
-- confirming attestation (outcome 2) on a cell with exactly one witness and RD
-- still at or above p_rd_floor (fp1e9). Structure that replicates across
-- independently trained checkpoints or lexical witnesses lands on the same
-- content-addressed cell and gains witnesses; per-run noise does not. Defaults
-- to the model relation family. Set-returning; the caller applies LIMIT.
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('generation.model_jitter_catalog(text, bigint)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(subject_id bytea, type_id bytea, object_id bytea, source_id bytea, outcome smallint, observations bigint, rating bigint, rd bigint, eff_mu bigint, witness_count bigint)'
             OR proargnames IS DISTINCT FROM ARRAY['p_relation','p_rd_floor','subject_id','type_id','object_id','source_id','outcome','observations','rating','rd','eff_mu','witness_count']::text[])) THEN
        DROP FUNCTION generation.model_jitter_catalog(text, bigint);
    END IF;
END $upgrade_shape$;
DROP FUNCTION IF EXISTS laplace.model_jitter_catalog(text, bigint);
CREATE OR REPLACE FUNCTION generation.model_jitter_catalog(
        p_relation text DEFAULT NULL,
        p_rd_floor bigint DEFAULT 150000000000)
    RETURNS TABLE(
        subject_id bytea, type_id bytea, object_id bytea,
        source_id bytea, outcome smallint, observations bigint,
        rating bigint, rd bigint, eff_mu bigint, witness_count bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH model_rels(tid) AS (
        SELECT laplace.relation_type_id(r)
        FROM unnest(CASE WHEN p_relation IS NULL
                         THEN ARRAY['ATTENDS','OV_RELATES','COMPLETES_TO',
                                    'CONTINUES_TO','SIMILAR_TO']
                         ELSE ARRAY[p_relation] END) AS r
    )
    SELECT a.subject_id, a.type_id, a.object_id,
           a.source_id, a.outcome, a.observation_count,
           c.rating, c.rd, consensus.eff_mu(c.rating, c.rd), c.witness_count
    FROM laplace.consensus c
    JOIN model_rels r ON r.tid = c.type_id
    JOIN laplace.attestations a
      ON a.subject_id = c.subject_id
     AND a.type_id    = c.type_id
     AND a.object_id  = c.object_id
    WHERE c.witness_count = 1
      AND c.rd >= p_rd_floor
      AND a.outcome = 2;
END;
