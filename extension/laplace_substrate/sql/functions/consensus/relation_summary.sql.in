-- A direct claim names these entities as endpoints. Predicate membership and
-- shared packaging are not a direct relation. Both orientations share the
-- Native endpoint/mask/standing reader; value claims keep their absent predicate.
DROP FUNCTION IF EXISTS laplace.relation_summary(bytea, bytea);
CREATE OR REPLACE FUNCTION consensus.relation_summary(p_x bytea, p_y bytea)
    RETURNS TABLE(relation text, plane text, mu numeric, usage bigint,
                  geodesic double precision, verdict text)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH ids AS MATERIALIZED (
        SELECT encode(p_x,'hex')::public.blake3 AS x, encode(p_y,'hex')::public.blake3 AS y
    ), direct AS MATERIALIZED (
        SELECT c.entity,c.path,c.rating,c.deviation,c.matches
        FROM ids k CROSS JOIN LATERAL public.laplace_claims_each(
            ARRAY[k.x,k.y],NULL::bigint,ARRAY[public.laplace_bank_bit('kind','claim')],
            '{}'::public.blake3[],1::smallint,NULL::public.blake3[],0::bigint,ARRAY[k.x,k.y]) c
        WHERE public.laplace_path_length(c.path) IN (2,3)
          AND ((public.laplace_path_starts(c.path,k.x) AND public.laplace_path_ends(c.path,k.y))
            OR (public.laplace_path_starts(c.path,k.y) AND public.laplace_path_ends(c.path,k.x)))
        ORDER BY c.rating-2*c.deviation DESC,c.entity LIMIT 1
    ), coords AS MATERIALIZED (
        SELECT p.ordinal,p.coord FROM ids k
        CROSS JOIN LATERAL public.laplace_entities(ARRAY[k.x,k.y]) p
    ), shape AS (
        SELECT public.laplace_distance4d(x.coord,y.coord) AS geodesic
        FROM coords x JOIN coords y ON y.ordinal=2 WHERE x.ordinal=1
    ), relation_id AS (
        SELECT CASE WHEN public.laplace_path_length(path)=3
                    THEN (public.laplace_parts(path))[2] END AS id FROM direct
    ), metadata AS MATERIALIZED (
        SELECT * FROM consensus.relation_metadata(
            ARRAY(SELECT public.blake3_send(id) FROM relation_id WHERE id IS NOT NULL))
    ), labels AS MATERIALIZED (
        SELECT * FROM public.laplace_labels(ARRAY(SELECT id FROM relation_id WHERE id IS NOT NULL))
    )
    SELECT (SELECT coalesce(CASE WHEN NOT m.inverse AND m.qualifier_bit<0 THEN m.canonical END,l.content)
            FROM relation_id r LEFT JOIN metadata m ON m.surface_id=public.blake3_send(r.id)
            LEFT JOIN labels l ON l.entity=r.id),
           'direct witnessed claims'::text,(SELECT (rating-2*deviation)::numeric FROM direct),
           (SELECT matches FROM direct),(SELECT geodesic FROM shape),
           CASE WHEN EXISTS(SELECT FROM direct)
                THEN 'A direct witnessed claim connects these entities.'
                ELSE 'No direct witnessed claim connects these entities.' END;
END;
