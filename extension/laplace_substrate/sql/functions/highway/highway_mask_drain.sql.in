-- Drain bit-clearing repair work, never the ordinary ingest path. Each claim
-- and refresh commits together. Concurrent producers can enqueue the same id
-- after the claim rather than losing a new signal behind DELETE-after-refresh.
CREATE OR REPLACE PROCEDURE laplace.highway_mask_drain(p_batch int DEFAULT 250000)
    LANGUAGE plpgsql AS $$
DECLARE
    ids bytea[];
    n bigint;
    total bigint := 0;
BEGIN
    IF p_batch IS NULL OR p_batch < 1 THEN
        RAISE EXCEPTION 'highway_mask_drain: p_batch must be >= 1';
    END IF;
    LOOP
        IF NOT consensus.highway_ready() THEN
            RAISE LOG 'highway_mask_drain: registry unavailable; dirty entities retained';
            RETURN;
        END IF;
        WITH claimed AS MATERIALIZED (
            SELECT id FROM laplace.highway_mask_dirty
            ORDER BY id LIMIT p_batch FOR UPDATE SKIP LOCKED
        ), taken AS (
            DELETE FROM laplace.highway_mask_dirty d USING claimed q
            WHERE d.id=q.id RETURNING d.id
        )
        SELECT array_agg(id ORDER BY id) INTO ids FROM taken;
        EXIT WHEN ids IS NULL;

        n := consensus.highway_mask_refresh(ids);
        COMMIT;
        IF NOT consensus.highway_ready() THEN
            RAISE LOG 'highway_mask_drain: registry unavailable; refresh batch retained';
            RETURN;
        END IF;
        total := total + n;
        RAISE LOG 'highway_mask_drain: % masks refreshed', total;
    END LOOP;
END $$;
