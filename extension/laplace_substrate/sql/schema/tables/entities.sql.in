-- Canonical entity identity is the content id. Tier and type are observed
-- structural/typing projections and must never participate in uniqueness.
-- Sources witness entities through attestations only; no column here records
-- which source first observed an entity.
--
-- HASH(id) is the physical layout because ids are content hashes and therefore
-- distribute independently of modality-relative tier.
CREATE TABLE IF NOT EXISTS entities (
    id                 bytea            NOT NULL CHECK (octet_length(id) = 16),
    tier               smallint         NOT NULL CHECK (tier >= 0 AND tier < 256),
    type_id            bytea            NOT NULL CHECK (octet_length(type_id) = 16),
    created_at         timestamptz      NOT NULL DEFAULT now(),
    highway_mask       bytea            CHECK (highway_mask IS NULL OR octet_length(highway_mask) = 32),
    PRIMARY KEY (id)
) PARTITION BY HASH (id);

DO $$
DECLARE
    b int;
    suffix text;
    strategy "char";
    opts constant text := ' SET (autovacuum_analyze_scale_factor = 0.02, autovacuum_analyze_threshold = 100000)';
BEGIN
    IF (SELECT c.relkind FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
        WHERE n.nspname = current_schema() AND c.relname = 'entities') <> 'p' THEN
        RAISE EXCEPTION
            'entities uses a legacy non-partitioned layout; canonical entity identity is id-only and this version requires HASH(id). Create a new canonical database and retain the existing database for transfer or rollback.';
    END IF;

    SELECT p.partstrat INTO strategy
    FROM pg_partitioned_table p
    WHERE p.partrelid = (current_schema() || '.entities')::regclass;
    IF strategy <> 'h' THEN
        RAISE EXCEPTION
            'entities uses obsolete partition strategy %; canonical entity identity is id-only and this version requires HASH(id). Create a new canonical database and retain the existing database for transfer or rollback.',
            strategy;
    END IF;

    IF to_regclass(current_schema() || '.entities_h00') IS NOT NULL THEN
        RETURN;
    END IF;

    FOR b IN 0..63 LOOP
        suffix := lpad(to_hex(b), 2, '0');
        EXECUTE format('CREATE TABLE entities_h%s PARTITION OF entities FOR VALUES WITH (MODULUS 64, REMAINDER %s)',
                       suffix, b);
        EXECUTE format('ALTER TABLE entities_h%s', suffix) || opts;
    END LOOP;
END $$;

SELECT pg_extension_config_dump('entities', '');
