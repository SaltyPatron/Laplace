        "mapping/ToASCII",
        "mapping/Transitional_Processing"
      ],
      "omitWhenEqualsSubject": true,
      "unlessField": "toAsciiTStatus"
    },
    {
      "syntaxPath": "record/@toAsciiTStatus",
      "propertyName": "toAsciiTStatus",
      "valueKind": "Text",
      "disposition": "Testimony",
