-- Incremental corpus enumeration: identical semantics to the historical
-- corpus_sentence_constituents body, plus a p_since watermark that restricts the
-- DOCUMENT/ORPHAN roots to physicalities observed at-or-after the watermark.
-- p_since = '-infinity' reproduces the full corpus exactly.
--
-- The observed_at >= p_since predicates are served by physicalities_traj_probe
-- (partial btree on observed_at WHERE type = 1 AND trajectory IS NOT NULL), so an
-- incremental refresh after N new deposits touches O(new rows), never the corpus.
-- Constituent SENTENCES of a new document are pulled regardless of their own
-- observed_at (a new doc may reference old sentences); dedup against sequences the
-- corpus already streams is the C side's job (parent-id hash set in
-- trajectory_corpus.c corpus_refresh).
--
-- p_max_orphans: < 0 = UNCAPPED (every tier-3 sentence participates), 0 = book-only,
-- > 0 = the N most recently observed orphans. Uncapped is the default because a
-- ONE-SENTENCE source can never mint a tier-4 root: TierTree.cs CollapseIndex ("tier
-- is a FLOOR: a single-child, span-identical wrapper IS its child") collapses the
-- wrapper into the sentence, so Tatoeba/WordNet-gloss/HAS_EXAMPLE sentences are all
-- tier-3 orphans by construction. A book-only corpus therefore excluded the entire
-- single-sentence corpus -- and with it walk_continuations, cooccurrence_scan,
-- trajectory_pairs and the foundry's conditional floor, which all read this one
-- enumeration. Capping which sentences may be witnessed is also the operator-invented
-- floor the substrate law forbids; the cap survives only as an explicit opt-in.
CREATE OR REPLACE FUNCTION corpus_sentence_constituents_since(
        p_document_source text DEFAULT '',
        p_max_orphans int DEFAULT -1,
        p_since timestamptz DEFAULT '-infinity')
    RETURNS TABLE(parent_id bytea, child_id bytea, run_length int)
    LANGUAGE sql STABLE PARALLEL RESTRICTED
    SET search_path = @extschema@, public AS $$
    WITH doc AS (
        SELECT e.id
        FROM entities e
        JOIN physicalities p
          ON p.entity_id = e.id AND p.type = 1 AND p.trajectory IS NOT NULL
         AND p.observed_at >= p_since
        WHERE e.tier = 4
          AND (p_document_source = '' OR EXISTS (
              SELECT 1 FROM attestations a
              WHERE a.context_id = e.id
                AND a.source_id = source_id(p_document_source)))
    ), book_sent AS (
        SELECT DISTINCT tc.entity_id AS id
        FROM doc d
        JOIN physicalities pd
          ON pd.entity_id = d.id AND pd.type = 1 AND pd.trajectory IS NOT NULL
        CROSS JOIN LATERAL laplace_trajectory_constituents(pd.trajectory) tc
    ), orphan_capped AS (
        -- Explicit cap (p_max_orphans > 0): the N most recently observed. The
        -- constant-false guard prunes this arm entirely when uncapped, so the
        -- observed_at sort is never planned on the whole-corpus path.
        SELECT e.id
        FROM entities e
        JOIN physicalities ps
          ON ps.entity_id = e.id AND ps.type = 1 AND ps.trajectory IS NOT NULL
         AND ps.observed_at >= p_since
        WHERE p_max_orphans > 0
          AND e.tier = 3
          AND NOT EXISTS (SELECT 1 FROM book_sent bs WHERE bs.id = e.id)
        ORDER BY ps.observed_at DESC
        LIMIT GREATEST(p_max_orphans, 0)
    ), orphan_all AS (
        -- Uncapped: no ORDER BY, no LIMIT -- every tier-3 sentence is a witness.
        SELECT e.id
        FROM entities e
        JOIN physicalities ps
          ON ps.entity_id = e.id AND ps.type = 1 AND ps.trajectory IS NOT NULL
         AND ps.observed_at >= p_since
        WHERE p_max_orphans < 0
          AND e.tier = 3
          AND NOT EXISTS (SELECT 1 FROM book_sent bs WHERE bs.id = e.id)
    ), s AS (
        SELECT id FROM book_sent
        UNION ALL
        SELECT id FROM orphan_capped
        UNION ALL
        SELECT id FROM orphan_all
    )
    SELECT pp.entity_id AS parent_id,
           u.entity_id AS child_id,
           GREATEST(u.run_length, 1)::int AS run_length
    FROM (
        SELECT DISTINCT ON (pp.entity_id) pp.entity_id, pp.trajectory
        FROM physicalities pp
        JOIN s ON s.id = pp.entity_id
        WHERE pp.type = 1 AND pp.trajectory IS NOT NULL
        ORDER BY pp.entity_id
    ) pp
    CROSS JOIN LATERAL laplace_trajectory_constituents(pp.trajectory) u
    WHERE laplace_vertex_tier(u.flags) <= 2
    ORDER BY pp.entity_id, u.ordinal
$$;
