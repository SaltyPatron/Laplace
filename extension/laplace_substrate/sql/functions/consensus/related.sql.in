DROP FUNCTION IF EXISTS laplace.related(bytea, bytea, bytea, int);
CREATE OR REPLACE FUNCTION consensus.related(p_word bytea, p_type bytea, p_lang bytea DEFAULT NULL,
                                   p_limit int DEFAULT 10)
    RETURNS TABLE(fact text, eff_mu numeric, witnesses bigint)
-- No SET search_path — blocks inlining, costs the consensus index path. GH #860.
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    WITH subj(id) AS (
        SELECT p_word UNION SELECT sn.synset_id FROM lexical.senses(p_word) sn
    ), top AS (
        SELECT cc.object_id, cc.rating, cc.rd, cc.witness_count
        FROM subj s CROSS JOIN LATERAL (
            SELECT c.object_id, c.rating, c.rd, c.witness_count
            FROM @extschema@.v_consensus_unrefuted c
            WHERE c.subject_id = s.id AND c.type_id = p_type
              AND c.object_id IS NOT NULL
            ORDER BY @extschema@.eff_mu(c.rating, c.rd) DESC LIMIT p_limit
        ) cc
    ), ranked AS (
        -- rank + LIMIT on ids BEFORE labeling (was: scalar realize per row over
        -- the num_senses x p_limit pool, labeling more rows than returned).
        SELECT t.object_id, t.rating, t.rd, t.witness_count,
               row_number() OVER (ORDER BY @extschema@.eff_mu(t.rating, t.rd) DESC) AS ord
        FROM top t
        ORDER BY @extschema@.eff_mu(t.rating, t.rd) DESC
        LIMIT p_limit
    ), labels AS (
        -- ONE realize_batch over exactly the returned rows, position-aligned.
        SELECT realize.batch(array_agg(r.object_id ORDER BY r.ord),
                             COALESCE(p_lang, converse.word_language(p_word))) AS l
        FROM ranked r
    )
    SELECT labels.l[r.ord], @extschema@.eff_mu_display(r.rating, r.rd), r.witness_count
    FROM ranked r, labels
    ORDER BY r.ord
$$;
