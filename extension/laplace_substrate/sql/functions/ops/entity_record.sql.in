-- An entity's verdict record: its edges grouped by the canonical epistemic_status
-- verdict rule — confirmed / contested / refuted / thin. The rule lives in
-- converse.epistemic_status_core; this only counts, and no client re-derives it
-- from raw mu. Counts read the CORE, not the rendering wrapper: the wrapper also
-- renders + realizes up to 500 object texts a counter throws away — MEASURED
-- 2026-08-21 on a hot entity: 1,984 ms wrapped, 308 ms core, identical counts.
DROP FUNCTION IF EXISTS laplace.entity_record(bytea);

CREATE OR REPLACE FUNCTION ops.entity_record(p_id bytea)
    RETURNS TABLE(confirmed bigint, contested bigint, refuted bigint, thin bigint)
    LANGUAGE sql STABLE

BEGIN ATOMIC
    -- Exact entity record. The old implementation called
    -- epistemic_status_core(p_id, 500), which intentionally expands a lexical word
    -- through lexical.senses() and then truncates the result. The Explore header
    -- therefore reported a sense-expanded TOP-500 sample as if it were this
    -- entity's complete verdict record (for sell: 16 confirmed + 484 thin = 500).
    --
    -- Keep the same verdict law and the same non-verdict structural exclusions,
    -- but count every direct consensus cell owned by p_id and nothing owned by a
    -- sense/synset reached from it.
    WITH direct AS (
        SELECT c.rating, c.rd, c.volatility
        FROM laplace.consensus c
        WHERE c.subject_id = p_id
          AND c.object_id IS NOT NULL
          AND c.type_id NOT IN (
              laplace.relation_type_id('HAS_SENSE'),
              laplace.relation_type_id('IS_SENSE_OF'),
              laplace.relation_type_id('HAS_LANGUAGE'))
    ), verdicts AS (
        SELECT CASE
            WHEN consensus.refuted(d.rating, d.rd) THEN 'refuted'
            WHEN consensus.eff_mu(d.rating, d.rd) > consensus.glicko2_neutral_mu()
                THEN 'confirmed'
            WHEN d.volatility::numeric > consensus.glicko2_initial_volatility() * 1.5
                THEN 'contested'
            ELSE 'thin'
        END AS status
        FROM direct d
    )
    SELECT count(*) FILTER (WHERE v.status = 'confirmed'),
           count(*) FILTER (WHERE v.status = 'contested'),
           count(*) FILTER (WHERE v.status = 'refuted'),
           count(*) FILTER (WHERE v.status = 'thin')
    FROM verdicts v
;
END;
