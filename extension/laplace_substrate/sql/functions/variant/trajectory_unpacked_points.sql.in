DROP FUNCTION IF EXISTS laplace.trajectory_unpacked_points(bytea);

-- Entity and lane arrays describe one selected set. The native reader computes
-- canonical physicality identities and performs partition-routed PK batches.
-- Logical ordinals and RLE expansion use the canonical trajectory kernel.
CREATE OR REPLACE FUNCTION generation.typed_trajectory_points(
    p_entities bytea[], p_types smallint[])
RETURNS TABLE(parent_id bytea, physicality_type smallint, entity_id bytea,
              ordinal bigint, ctier integer)
AS 'EXECUTION_LIBRARY', 'pg_laplace_typed_trajectory_points'
LANGUAGE C STABLE PARALLEL RESTRICTED;

CREATE OR REPLACE FUNCTION generation.trajectory_unpacked_points(p_entity bytea, p_type smallint)
    RETURNS TABLE(entity_id bytea, run_length int, ctier int)
    LANGUAGE sql STABLE PARALLEL RESTRICTED ROWS 6
BEGIN ATOMIC
    SELECT t.entity_id, 1::int AS run_length, t.ctier
    FROM generation.typed_trajectory_points(ARRAY[p_entity], ARRAY[p_type]) t
    ORDER BY t.ordinal;
END;

-- Content-lane default. BEGIN ATOMIC, not a string body: the delegation is parsed at
-- CREATE time and recorded in pg_depend, so the two-argument core cannot be dropped or
-- have its signature changed out from under this wrapper (GH #764). Columns are
-- qualified through the alias because RETURNS TABLE names are parameters in scope here.
CREATE OR REPLACE FUNCTION generation.trajectory_unpacked_points(p_entity bytea)
    RETURNS TABLE(entity_id bytea, run_length int, ctier int)
    LANGUAGE sql STABLE PARALLEL RESTRICTED ROWS 6
BEGIN ATOMIC
    SELECT t.entity_id, t.run_length, t.ctier
    FROM generation.trajectory_unpacked_points(p_entity, 1::smallint) AS t;
END;
