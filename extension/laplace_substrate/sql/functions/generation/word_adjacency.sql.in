-- Membership elects witnesses through the physicality GIN index. Native ordered
-- manifest traversal preserves repeated identities and RLE runs. SPACE and other
-- attested separators remain constituents and are carried as sep_id.
-- p_gap is an ordinal offset within the witnessed path, not geometric distance.
CREATE OR REPLACE FUNCTION generation.word_adjacency(p_vocab bytea[], p_trajs int DEFAULT 100000,
                                                    p_gap int DEFAULT 1)
    RETURNS TABLE(subject_id bytea, sep_id bytea, object_id bytea, witness_id bytea)
    AS 'MODULE_PATHNAME', 'pg_laplace_word_adjacency'
    LANGUAGE C STABLE PARALLEL SAFE;
