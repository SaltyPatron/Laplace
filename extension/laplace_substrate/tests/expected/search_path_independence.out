-- Every function that dropped `SET search_path` must resolve WITHOUT the
-- extension schema on the caller's path.
--
-- Dropping the clause is what makes a body inlinable —
-- inline_set_returning_function refuses when proconfig IS NOT NULL
-- (clauses.c:5168) — but the removal is only CORRECT if every substrate name in
-- the body is @extschema@-qualified. A miss is caught by nothing else:
--
--   * the build never parses SQL function bodies; they are strings.
--   * CREATE FUNCTION parse-checks under check_function_bodies, but during
--     extension install the extension schema IS on the search_path, so an
--     unqualified name resolves cleanly right there.
--   * it fails only at RUNTIME, for a caller whose search_path excludes laplace.
--
-- GROUNDED: 22c3d98b removed SET from salient_facts and qualified only its first
-- CTE, leaving eleven bare references. It built clean, installed clean, and
-- merged. G11 now catches that statically; this catches it dynamically, which is
-- the half a grep cannot do — a name can be @extschema@-qualified and still
-- resolve to nothing.
--
-- DELIBERATELY NO SEED. Every call below is wrapped so that a zero-row result
-- PASSES and an unresolved name FAILS. The regress database is fresh and
-- unseeded (tests/CMakeLists.txt does dropdb && createdb), and that is exactly
-- right here: the assertion is NAME RESOLUTION, not data. Compare
-- realize_ladder_parity.sql, which mints every id through word_id() for the same
-- reason.
--
-- NOTE the search_path below: `public` only. laplace is deliberately absent.
BEGIN;
SET search_path = public;
-- Helper: run a query text and report only whether it RESOLVED. Any error
-- mentioning a missing function/relation/column is a qualification defect and is
-- re-raised with the function's name; anything else (no rows, empty tables) is a
-- pass, because this file asserts resolution and not results.
CREATE OR REPLACE FUNCTION pg_temp.resolves(p_label text, p_sql text)
RETURNS text LANGUAGE plpgsql AS $fn$
BEGIN
    EXECUTE p_sql;
    RETURN p_label || ': ok';
EXCEPTION
    WHEN undefined_function OR undefined_table OR undefined_column
      OR invalid_schema_name THEN
        RETURN p_label || ': UNQUALIFIED -> ' || SQLERRM;
END;
$fn$;
-- The consensus read path (22c3d98b, ea8e9066, 9f72cc86).
SELECT pg_temp.resolves('consensus_out',
    'SELECT * FROM consensus.consensus_out(laplace.word_id(''dog''), 1)');
     resolves      
-------------------
 consensus_out: ok
(1 row)

SELECT pg_temp.resolves('consensus_in',
    'SELECT * FROM consensus.consensus_in(laplace.word_id(''dog''), 1)');
     resolves     
------------------
 consensus_in: ok
(1 row)

