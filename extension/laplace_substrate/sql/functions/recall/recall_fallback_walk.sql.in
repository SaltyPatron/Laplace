CREATE OR REPLACE FUNCTION recall_fallback_walk(p_topic bytea)
    RETURNS TABLE(reply text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
    AS $$
    SELECT COALESCE(@extschema@.realize(p_topic, @extschema@.word_language(p_topic)), @extschema@.label(p_topic))
           || string_agg(' —' || COALESCE(@extschema@.type_label(g.type_id), '?') || E'\u2192 '
                         || COALESCE(@extschema@.realize(g.entity_id, @extschema@.word_language(p_topic)),
                                     @extschema@.label(g.entity_id)), '' ORDER BY g.step),
           min(g.eff_mu), NULL::bigint
    FROM @extschema@.walk_strongest(p_topic, NULL::bytea, 6) g
    HAVING count(*) > 0
$$;
