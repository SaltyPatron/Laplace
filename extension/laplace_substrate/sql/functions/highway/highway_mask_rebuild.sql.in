-- SQL orchestrates recovery transactions; native C owns exact-pair mask work.
-- No SET clause: both procedures commit completed batches and remain resumable.
CREATE OR REPLACE PROCEDURE laplace.highway_mask_pending_drain(p_batch int DEFAULT 250000)
    LANGUAGE plpgsql AS $$
DECLARE
    entity_ids bytea[];
    type_ids bytea[];
    drained bigint := 0;
BEGIN
    IF p_batch IS NULL OR p_batch < 1 THEN
        RAISE EXCEPTION 'highway_mask_pending_drain: p_batch must be >= 1';
    END IF;
    LOOP
        IF NOT consensus.highway_ready() THEN
            RAISE LOG 'highway_mask_pending_drain: registry unavailable; exact pairs retained';
            RETURN;
        END IF;

        -- Claim/remove within the SAME transaction as the native replay. Any
        -- error rolls the claim back. Removing first also permits native replay
        -- to requeue the exact pairs if availability changes, without a later
        -- DELETE erasing the newly retained work.
        WITH claimed AS MATERIALIZED (
            SELECT entity_id, type_id FROM laplace.highway_mask_pending
            ORDER BY entity_id, type_id LIMIT p_batch
            FOR UPDATE SKIP LOCKED
        ), taken AS (
            DELETE FROM laplace.highway_mask_pending p USING claimed q
            WHERE p.entity_id=q.entity_id AND p.type_id=q.type_id
            RETURNING p.entity_id, p.type_id
        )
        SELECT array_agg(entity_id ORDER BY entity_id,type_id),
               array_agg(type_id ORDER BY entity_id,type_id)
        INTO entity_ids, type_ids FROM taken;
        EXIT WHEN entity_ids IS NULL;

        PERFORM consensus.highway_mask_deposit(entity_ids, type_ids);
        COMMIT;
        IF NOT consensus.highway_ready() THEN
            RAISE LOG 'highway_mask_pending_drain: registry unavailable; replay batch retained';
            RETURN;
        END IF;
        drained := drained + cardinality(entity_ids);
        RAISE LOG 'highway_mask_pending_drain: % exact pairs replayed', drained;
    END LOOP;
END $$;

-- Full historical population. New ingest never invokes this scan: it already
-- owns every exact pair. Include existing masks so removed relations can clear
-- stale bits; include zero-valued identities rather than skipping the first key.
CREATE OR REPLACE PROCEDURE laplace.highway_mask_rebuild(p_batch int DEFAULT 500000)
    LANGUAGE plpgsql AS $$
DECLARE
    last_id bytea := NULL;
    ids bytea[];
    n bigint;
    total bigint := 0;
    scanned bigint := 0;
    candidates bigint;
    t0 timestamptz := clock_timestamp();
BEGIN
    IF p_batch IS NULL OR p_batch < 1 THEN
        RAISE EXCEPTION 'highway_mask_rebuild: p_batch must be >= 1';
    END IF;
    IF NOT consensus.highway_ready() THEN
        RAISE LOG 'highway_mask_rebuild: registry unavailable; population remains pending';
        RETURN;
    END IF;

    CALL laplace.highway_mask_pending_drain(p_batch);
    UPDATE laplace.highway_mask_population_state
       SET complete=false, completed_at=NULL WHERE singleton;

    DROP TABLE IF EXISTS pg_temp._hmr_candidates;
    CREATE TEMP TABLE _hmr_candidates (id bytea PRIMARY KEY);
    INSERT INTO pg_temp._hmr_candidates(id)
    SELECT c.subject_id FROM laplace.consensus c
    UNION
    SELECT c.object_id FROM laplace.consensus c WHERE c.object_id IS NOT NULL
    UNION
    SELECT e.id FROM laplace.entities e WHERE e.highway_mask IS NOT NULL;
    GET DIAGNOSTICS candidates = ROW_COUNT;
    RAISE LOG 'highway_mask_rebuild: start — % mask candidates', candidates;
    COMMIT;

    LOOP
        IF NOT consensus.highway_ready() THEN
            RAISE LOG 'highway_mask_rebuild: registry unavailable; population remains pending';
            DROP TABLE IF EXISTS pg_temp._hmr_candidates;
            RETURN;
        END IF;
        SELECT array_agg(s.id ORDER BY s.id) INTO ids FROM (
            SELECT id FROM pg_temp._hmr_candidates
            WHERE last_id IS NULL OR id > last_id ORDER BY id LIMIT p_batch
        ) s;
        EXIT WHEN ids IS NULL;
        n := consensus.highway_mask_refresh(ids);
        total := total + n;
        scanned := scanned + cardinality(ids);
        last_id := ids[cardinality(ids)];
        RAISE LOG 'highway_mask_rebuild: % masks written / % of % candidates — %s elapsed',
            total, scanned, candidates,
            round(extract(epoch FROM clock_timestamp() - t0)::numeric, 1);
        COMMIT;
    END LOOP;

    UPDATE laplace.highway_mask_population_state
       SET complete=true, completed_at=clock_timestamp() WHERE singleton;
    COMMIT;
    RAISE LOG 'highway_mask_rebuild: done — % masks written / % candidates in %s',
        total, scanned, round(extract(epoch FROM clock_timestamp() - t0)::numeric, 1);
    DROP TABLE IF EXISTS pg_temp._hmr_candidates;
END $$;
