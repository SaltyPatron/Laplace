-- lexical.senses(word, context[]): the senses of a word, ranked BY CONTEXT.
--
-- PRIOR VERSION WAS INERT ON REAL DATA. Its only lane boosted a synset by summing
-- consensus.eff_mu over consensus rows where `subject_id = ANY(p_context)` (or object_id),
-- i.e. it required a DIRECT edge from a context entity to the synset. p_context
-- carries WORD laplace.entities and words reach synsets through HAS_SENSE -> IS_SENSE_OF,
-- so on a real corpus that join almost never matches and every boost was 0.
-- Verified 2026-07-25: opposite contexts ({animal,pet,bark} vs
-- {sausage,roll,beef}) returned byte-identical rankings AND byte-identical scores
-- for `dog`. One lane, and it was the wrong shape for the topology.
--
-- The first fix replaced that lane with three synset-to-synset lanes and DELETED
-- it. That was over-correction and it regressed the converse regress test, whose
-- fixture wires a direct w_h --CAUSES--> synset1 edge and asserts context flips the
-- resolved sense. "Usually absent" is not "never evidence": where a direct edge is
-- attested it is the strongest available statement that a context term bears on a
-- sense. It is restored below as a fourth lane. Adding lanes is the fix; removing
-- the one that existed was not.
--
-- Five lanes now, all in ID SPACE (no realize/realize.render/label anywhere -- rendering is
-- the caller's final step, never a mid-operation string compare):
--
--   USAGE   the candidate synset OWNS a gloss or example whose word realize.constituents
--           include a context token. Sense-resolution here is by OWNERSHIP, not
--           per-token tagging: a gloss/example hangs off exactly one synset, so a
--           word occurring inside it is already sense-resolved on the owning side.
--           This is the lane that actually discriminates.
--   FRAME   a context sense EVOKES_FRAME F and the candidate corresponds to F.
--           Frames unify across languages, so this lane is language-agnostic.
--   DOMAIN  candidate HAS_DOMAIN_TOPIC D and a context token is (or senses to) D
--           (GH #785 discourse prior — e.g. pawn+chess).
--   DIRECT  a context ENTITY has an attested edge straight to a candidate synset.
--           Usually absent on real data, but where present it is the strongest
--           statement that a context term bears on a sense.
--   TAXON   candidate and a context SENSE meet within one hop over the content
--           bands -- the synset-to-synset comparison the old version was reaching
--           for and getting wrong.
--
-- Every lane is weighted by the consensus.eff_mu of the edges carrying it: trust enters
-- through the rating math, never through an operator-chosen constant. No floors,
-- no caps, no top-k -- ORDER BY only, LIMIT is the caller's.
--
-- Returns the same columns as before so existing callers are unaffected. With an
-- empty/NULL context every lane contributes nothing and the ordering degenerates to
-- the sense prior, which is the documented no-context behaviour.
-- NO `SET search_path` (GH #860). The clause blocks SQL inlining -- the planner
-- keeps the function as an opaque `Function Scan` rather than pulling the body into
-- the caller and pushing predicates through to the index. The 1-arg `lexical.senses()` this
-- overload sits beside dropped the clause under #617 and inlines to an index scan;
-- this overload is on the same read path and was still paying it. Every reference is
-- `@extschema@.`-qualified instead, which is what the clause was doing and costs
-- nothing at plan time.
DROP FUNCTION IF EXISTS laplace.senses(bytea, bytea[]);
CREATE OR REPLACE FUNCTION lexical.senses(p_word bytea, p_context bytea[])
    RETURNS TABLE(sense_id bytea, synset_id bytea, eff_mu numeric, witnesses bigint,
                  score numeric)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    WITH ctx AS MATERIALIZED (
        SELECT DISTINCT t AS id
        FROM unnest(COALESCE(p_context, ARRAY[]::bytea[])) AS t
        WHERE t IS NOT NULL AND t <> p_word
    ),
    -- Context words resolved to their own senses: the comparison is synset<->synset.
    --
    -- ONE batch election, not a LATERAL per context id. lexical.senses is a SQL wrapper
    -- over taxonomy.bubble_up, so a LATERAL inlined bubble_up's whole CTE cascade --
    -- and every consensus reference in it -- once PER context id. Each unprunable
    -- reference to consensus contributes 216 scan nodes to the plan, which is why this
    -- function measured 699.8 ms PLANNING against 288.1 ms executing.
    -- taxonomy.bubble_up_batch elects for the whole context set in one instance.
    --
    -- Same rows: bubble_up_batch is byte-identical to per-term bubble_up untruncated
    -- (1,012 rows, EXCEPT ALL empty both directions), and only synset_id is taken here.
    ctx_syn AS MATERIALIZED (
        SELECT DISTINCT b.synset_id AS sid
        FROM taxonomy.bubble_up_batch(ARRAY(SELECT id FROM ctx)) b
        WHERE b.synset_id IS NOT NULL
    ),
    cand AS MATERIALIZED (
        SELECT s.sense_id, COALESCE(ss.object_id, s.sense_id) AS synset_id,
               s.rating, s.rd, s.witness_count AS w1,
               COALESCE(ss.witness_count, 0) AS w2
        FROM @extschema@.v_word_senses s
        LEFT JOIN @extschema@.consensus ss ON ss.subject_id = s.sense_id
                         AND ss.type_id = @extschema@.relation_type_id('IS_SENSE_OF')
        WHERE s.word_id = ANY(lexical.lexical_peers(p_word))
    ),
    candidate_nodes AS (
        SELECT c.synset_id AS sid, c.synset_id AS node_id FROM cand c
        UNION
        SELECT c.synset_id, c.sense_id FROM cand c
    ),
    -- USAGE: candidate owns a sentence (gloss band 1 / example band 7) whose
    -- word-tier realize.constituents include a context token.
    own_sent AS (
        SELECT DISTINCT n.sid, c.object_id AS gid,
               consensus.eff_mu(c.rating, c.rd) AS w
        FROM candidate_nodes n
        JOIN @extschema@.consensus c ON c.subject_id = n.node_id
        WHERE consensus.relation_highway_band(c.type_id) IN (1, 7)
    ),
    lane_usage AS (
        SELECT os.sid, sum(os.w) AS boost
        FROM own_sent os
        CROSS JOIN LATERAL generation.trajectory_unpacked_points(os.gid)
             WITH ORDINALITY AS u(entity_id, run_length, ctier, ord)
        WHERE u.ctier = 2 AND u.entity_id IN (SELECT id FROM ctx)
        GROUP BY os.sid
    ),
    -- FRAME: shared frame between a context sense and the candidate.
    ctx_frame AS (
        SELECT DISTINCT c.object_id AS fid, consensus.eff_mu(c.rating, c.rd) AS w
        FROM ctx_syn s
        JOIN @extschema@.consensus c ON c.subject_id = s.sid
        WHERE c.type_id = ANY (consensus.relation_family_ids('EVOKES_FRAME'))
    ),
    lane_frame AS (
        SELECT c.subject_id AS sid, sum(cf.w) AS boost
        FROM @extschema@.consensus c
        JOIN ctx_frame cf ON cf.fid = c.object_id
        WHERE c.subject_id IN (SELECT synset_id FROM cand)
          AND c.type_id = ANY (consensus.relation_family_ids('EVOKES_FRAME'))
        GROUP BY c.subject_id
    ),
    -- TAXON: candidate meets a context sense within one hop, either direction.
    lane_taxon AS (
        SELECT x.sid, sum(x.w) AS boost FROM (
            SELECT c.subject_id AS sid, consensus.eff_mu(c.rating, c.rd) AS w
            FROM @extschema@.consensus c
            WHERE c.subject_id IN (SELECT synset_id FROM cand)
              AND c.object_id IN (SELECT sid FROM ctx_syn)
              AND consensus.relation_highway_band(c.type_id) IN (2, 4, 7)
            UNION ALL
            SELECT c.object_id, consensus.eff_mu(c.rating, c.rd)
            FROM @extschema@.consensus c
            WHERE c.object_id IN (SELECT synset_id FROM cand)
              AND c.subject_id IN (SELECT sid FROM ctx_syn)
              AND consensus.relation_highway_band(c.type_id) IN (2, 4, 7)
        ) x
        GROUP BY x.sid
    ),
    -- DOMAIN (GH #785): a candidate synset HAS_DOMAIN_TOPIC D and a context
    -- token is (or senses to) D. "pawn" + "chess" elects the chess-piece sense
    -- because WordNet attached HAS_DOMAIN_TOPIC→chess; the USAGE lane also
    -- catches "(chess) the least powerful piece" in the gloss, but domain is
    -- the explicit discourse prior and works when the gloss spelling differs
    -- from the prompt token. Weighted by the domain edge's consensus.eff_mu.
    lane_domain AS (
        SELECT c.subject_id AS sid, sum(consensus.eff_mu(c.rating, c.rd)) AS boost
        FROM @extschema@.consensus c
        WHERE c.subject_id IN (SELECT synset_id FROM cand)
          AND c.type_id = consensus.relation_type_resolve('HAS_DOMAIN_TOPIC')
          AND (c.object_id IN (SELECT id FROM ctx)
               OR c.object_id IN (SELECT sid FROM ctx_syn))
        GROUP BY c.subject_id
    ),
    -- DIRECT: a context ENTITY has an attested edge to a candidate synset, either
    -- direction, any relation. This is the lane the previous implementation had, and
    -- dropping it was a regression -- the converse regress fixture wires
    -- w_h --CAUSES--> synset1 and asserts that context flips the resolved sense to
    -- synset1, which stopped happening.
    --
    -- Removing it was over-correction. The earlier finding stands: this lane alone is
    -- INERT ON REAL DATA, because words reach synsets through HAS_SENSE ->
    -- IS_SENSE_OF and almost never carry a direct edge to one -- which is why opposite
    -- contexts ({animal,pet,bark} vs {sausage,roll,beef}) scored byte-identically for
    -- `dog`. But "usually absent" is not "never evidence". Where a direct edge IS
    -- attested it is the strongest possible statement that a context term bears on a
    -- sense, and discarding it to make room for the other three lanes threw away
    -- signal rather than adding to it.
    --
    -- Deliberately unbanded: the other lanes gate on content bands because they
    -- traverse to reach the candidate, and untyped traversal drifts. A direct edge
    -- does not traverse -- the context term names the sense outright -- so gating it
    -- by band would discard exactly the causal/oppositional evidence the fixture
    -- carries.
    lane_direct AS (
        SELECT x.sid, sum(x.w) AS boost FROM (
            SELECT c.object_id AS sid, consensus.eff_mu(c.rating, c.rd) AS w
            FROM @extschema@.consensus c
            WHERE c.subject_id IN (SELECT id FROM ctx)
              AND c.object_id IN (SELECT synset_id FROM cand)
            UNION ALL
            SELECT c.subject_id, consensus.eff_mu(c.rating, c.rd)
            FROM @extschema@.consensus c
            WHERE c.object_id IN (SELECT id FROM ctx)
              AND c.subject_id IN (SELECT synset_id FROM cand)
        ) x
        GROUP BY x.sid
    )
    SELECT cand.sense_id,
           cand.synset_id,
           consensus.eff_mu_display(cand.rating, cand.rd),
           (cand.w1 + cand.w2)::bigint,
           round(((consensus.eff_mu(cand.rating, cand.rd)
                   + COALESCE(lu.boost, 0)
                   + COALESCE(lf.boost, 0)
                   + COALESCE(lt.boost, 0)
                   + COALESCE(ldo.boost, 0)
                   + COALESCE(ld.boost, 0)) / 1e9)::numeric, 3)
    FROM cand
    LEFT JOIN lane_usage  lu  ON lu.sid  = cand.synset_id
    LEFT JOIN lane_frame  lf  ON lf.sid  = cand.synset_id
    LEFT JOIN lane_taxon  lt  ON lt.sid  = cand.synset_id
    LEFT JOIN lane_domain ldo ON ldo.sid = cand.synset_id
    LEFT JOIN lane_direct ld  ON ld.sid  = cand.synset_id
    ORDER BY 5 DESC
$$;
