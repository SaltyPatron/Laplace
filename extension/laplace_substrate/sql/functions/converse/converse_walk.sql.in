-- converse.walk(prompt, steps, seed): the FUSED free-form walk.
--
-- Sequence PROPOSES, meaning STEERS -- now with real semantic steering:
--   ORIENT  -> the prompt's richest concept synset (as converse.converse()).
--   GATHER  -> ordered token trajectories of the concept's own attested sentence
--              (weight 50, the seed) plus the tier-3 sentences that contain the
--              topic word (weight 40). Drawn from physicality trajectories =
--              precedes/follows/co-occurrence. Each token carries its source's
--              topic weight, so the corpus knows what is central vs peripheral.
--              Set-based: realize.render_text runs once per DISTINCT token id to drop
--              whitespace realize.constituents(the old loop rendered every occurrence
--              of every token of every sentence).
--   WALK    -> converse.steered_walk_raw(steered_walk.c): trigram->bigram backoff over
--              the restricted stream, SEEDED from the core concept's own
--              sentence and STEERED by topic weight (RNG breaks ties), with the
--              anti-repeat guard forcing novel recombination at shared n-gram
--              pivots. Ends at a sentence boundary once it has said enough.
--              Grounded only in attested token order; deterministic per seed.
--   REALIZE -> realize.render_text of the emitted token ids.
CREATE OR REPLACE FUNCTION generation.walk_batch(p_prompt text,
                                                  p_steps int,
                                                  p_seeds bigint[],
                                                  p_corpus_limit int)
    RETURNS TABLE(seed bigint, reply text)
    LANGUAGE sql VOLATILE
BEGIN ATOMIC
    WITH elected AS MATERIALIZED (
        SELECT e.tok AS topic_word, e.synset_id AS syn
        FROM converse.elect(p_prompt) e
    ),
    gids AS MATERIALIZED (
        SELECT g.gid, MAX(g.wt) AS wt, bool_or(g.is_core) AS is_core
        FROM elected el
        CROSS JOIN LATERAL (
            SELECT c.object_id AS gid,
                   GREATEST(consensus.eff_mu(c.rating, c.rd), 0) AS wt,
                   true AS is_core
            FROM laplace.consensus c
            WHERE c.subject_id = el.syn
              AND c.type_id = ANY (laplace.relation_band_types(1))
            UNION ALL
            SELECT co.entity_id,
                   GREATEST(COALESCE(MAX(consensus.eff_mu(k.rating, k.rd)),
                                     consensus.glicko2_neutral_mu()), 0),
                   false
            FROM structural.containers_of(el.topic_word, 1, p_corpus_limit) co
            LEFT JOIN laplace.consensus k ON k.object_id = co.entity_id
            WHERE co.tier = 3
            GROUP BY co.entity_id
        ) g
        WHERE el.syn IS NOT NULL
        GROUP BY g.gid
    ),
    toks AS (
        SELECT g.gid, g.wt, g.is_core, u.entity_id, u.ord
        FROM gids g
        CROSS JOIN LATERAL generation.trajectory_unpacked_points(g.gid)
             WITH ORDINALITY AS u(entity_id, run_length, ctier, ord)
    ),
    kept AS MATERIALIZED (
        SELECT q.* FROM (
            SELECT t.gid, t.wt, t.is_core, t.entity_id,
                   row_number() OVER (PARTITION BY t.gid ORDER BY t.ord) AS rn,
                   count(*)    OVER (PARTITION BY t.gid) AS cnt
            FROM toks t
        ) q
        WHERE q.cnt >= 2
    ),
    tokset AS MATERIALIZED (
        SELECT DISTINCT k.entity_id AS id FROM kept k
    ),
    qk AS MATERIALIZED (
        SELECT e.id, MAX(e.mu) AS mu
        FROM elected el
        CROSS JOIN LATERAL (
            SELECT c.object_id AS id, consensus.eff_mu(c.rating, c.rd) AS mu
            FROM laplace.consensus c
            WHERE c.subject_id = el.syn
              AND c.object_id = ANY (ARRAY(SELECT t.id FROM tokset t))
            UNION ALL
            SELECT c.subject_id, consensus.eff_mu(c.rating, c.rd)
            FROM laplace.consensus c
            WHERE c.object_id = el.syn
              AND c.subject_id = ANY (ARRAY(SELECT t.id FROM tokset t))
        ) e
        WHERE el.syn IS NOT NULL
        GROUP BY e.id
    ),
    seq AS MATERIALIZED (
        SELECT k.gid, k.is_core, GREATEST(COALESCE(q.mu, 0), 0) AS wt, k.entity_id AS id, k.rn
        FROM kept k LEFT JOIN qk q ON q.id = k.entity_id
        UNION ALL
        SELECT DISTINCT k.gid, k.is_core, 0::bigint, '\x00'::bytea, 2147483647::bigint
        FROM kept k
    ),
    corpus_arrays AS MATERIALIZED (
        SELECT (SELECT array_agg(s.id ORDER BY s.is_core DESC, s.gid, s.rn) FROM seq s) AS stream,
               (SELECT array_agg(s.wt ORDER BY s.is_core DESC, s.gid, s.rn) FROM seq s) AS w,
               COALESCE(
                   (SELECT array_agg(k.entity_id ORDER BY k.gid) FROM kept k
                     WHERE k.is_core AND k.rn = 1),
                   (SELECT array_agg(k.entity_id ORDER BY k.gid) FROM kept k
                     WHERE k.rn = 1)) AS starts,
               (SELECT array_agg(k.entity_id ORDER BY k.rn) FROM kept k
                 WHERE k.is_core AND k.gid = (
                     SELECT k2.gid FROM kept k2 WHERE k2.is_core
                     GROUP BY k2.gid ORDER BY max(k2.cnt) DESC, k2.gid LIMIT 1)) AS core_seq
    ),
    emitted AS MATERIALIZED (
        SELECT s.ord, s.seed,
               CASE
                   WHEN COALESCE(array_length(ca.stream, 1), 0) < 3 OR ca.starts IS NULL THEN NULL::bytea[]
                   ELSE converse.steered_walk_raw(
                       ca.stream, ca.w, COALESCE(ca.core_seq, ARRAY[]::bytea[]), ca.starts,
                       p_steps, 5,
                       abs(COALESCE(s.seed,
                           ('x'||substr(md5(p_prompt),1,8))::bit(32)::bigint)) % 2147483647
                   )
               END AS ids
        FROM unnest(p_seeds) WITH ORDINALITY AS s(seed, ord)
        CROSS JOIN corpus_arrays ca
    ),
    ids AS MATERIALIZED (
        SELECT array_agg(DISTINCT u.id) AS a
        FROM emitted e
        CROSS JOIN LATERAL unnest(e.ids) AS u(id)
    ),
    realized AS MATERIALIZED (
        SELECT i.a, realize.render_text_batch(i.a) AS txt
        FROM ids i
    ),
    labels AS MATERIALIZED (
        SELECT (r.a)[k] AS id, (r.txt)[k] AS txt
        FROM realized r
        CROSS JOIN LATERAL generate_subscripts(r.a, 1) AS k
    )
    SELECT e.seed,
           CASE WHEN count(u.id) = 0 THEN NULL::text
                ELSE btrim(string_agg(COALESCE(l.txt, ''), '' ORDER BY u.ord))
           END AS reply
    FROM emitted e
    LEFT JOIN LATERAL unnest(e.ids) WITH ORDINALITY AS u(id, ord) ON true
    LEFT JOIN labels l ON l.id = u.id
    GROUP BY e.ord, e.seed
    ORDER BY e.ord;
END;

-- Existing three-argument surface: an ordinal-preserving adapter to the one
-- implementation. Omission requests the complete corpus rather than choosing
-- a hidden server-side subset.
CREATE OR REPLACE FUNCTION generation.walk_batch(p_prompt text,
                                                  p_steps int,
                                                  p_seeds bigint[])
    RETURNS TABLE(seed bigint, reply text)
    LANGUAGE sql VOLATILE
BEGIN ATOMIC
    SELECT b.seed, b.reply
    FROM generation.walk_batch(p_prompt, p_steps, p_seeds, NULL) b;
END;

DROP FUNCTION IF EXISTS laplace.converse_walk(text, int, bigint);
CREATE OR REPLACE FUNCTION converse.walk(p_prompt text,
                                         p_steps int,
                                         p_seed bigint,
                                         p_corpus_limit int)
    RETURNS text
    LANGUAGE sql VOLATILE
BEGIN ATOMIC
    SELECT b.reply
    FROM generation.walk_batch(
        p_prompt, p_steps, ARRAY[p_seed]::bigint[], p_corpus_limit) b
    LIMIT 1;
END;

-- Scalar compatibility surface. All semantics live in the capacity-aware
-- overload; omitted capacity means exact/unbounded.
CREATE OR REPLACE FUNCTION converse.walk(p_prompt text, p_steps int DEFAULT 40,
                                         p_seed bigint DEFAULT NULL)
    RETURNS text
    LANGUAGE sql VOLATILE
BEGIN ATOMIC
    SELECT converse.walk(p_prompt, p_steps, p_seed, NULL);
END;
