-- The unrated volatility on Laplace-Native's standing scale (LP_GLICKO_VOLATILITY).
DROP FUNCTION IF EXISTS laplace.glicko2_initial_volatility();
CREATE OR REPLACE FUNCTION consensus.glicko2_initial_volatility() RETURNS double precision
    AS 'MODULE_PATHNAME', 'pg_laplace_standing_volatility'
    LANGUAGE C LAPLACE_IMMUTABLE;
