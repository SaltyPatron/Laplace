-- consensus.walk_edge_weight(rating, rd) -> float8
--
-- The signed Glicko-2 expected score around neutral: 2*E-1. Rating and RD are
-- the sufficient state produced by folding the complete observation history.
-- Applying witness_count/(witness_count+4) and exp(-rd/initial_rd) here used to
-- adjudicate the same evidence a second time with two non-Glicko transforms.
--
CREATE OR REPLACE FUNCTION consensus.walk_edge_weight(
        p_rating bigint, p_rd bigint)
    RETURNS double precision
    AS 'MODULE_PATHNAME', 'pg_laplace_walk_edge_weight'
    LANGUAGE C LAPLACE_IMMUTABLE_STRICT;
