-- realize.realize() for N ids in one call: 6 batched SPI round-trips regardless of N
-- (5 candidate arms + ONE shared realize.render_text_batch at depth 24), positionally
-- aligned text[] out. Reproduces the scalar COALESCE ladder exactly
-- (resolve_name's lang-only branch -> realize.render -> translation -> canonical ->
-- gloss) and ABSTAINS with NULL — never hex. See src/realize_batch.c for the
-- parity notes. This is the shared labeling primitive the serving surface
-- calls AFTER its rank/LIMIT step (the librarian hands the survivor id-array
-- to the machine room).
DROP FUNCTION IF EXISTS laplace.realize_batch(bytea[], bytea);
CREATE OR REPLACE FUNCTION realize._batch_c(p_ids bytea[], p_lang bytea DEFAULT NULL)
    RETURNS text[]
    AS 'MODULE_PATHNAME', 'pg_laplace_realize_batch'
    LANGUAGE C STABLE;

CREATE OR REPLACE FUNCTION realize.batch(p_ids bytea[], p_lang bytea DEFAULT NULL)
    RETURNS text[]
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH c_out AS MATERIALIZED (
        SELECT realize._batch_c(p_ids, p_lang) AS arr
    )
    SELECT COALESCE(array_agg(
        CASE
            WHEN NULLIF(u.lbl, '') IS NULL OR u.lbl ~ '^i[0-9]+$' OR u.lbl ~ '^[0-9]{8}-[nvars]$'
            THEN COALESCE(realize._synset_lemma(u.id, p_lang), NULLIF(u.lbl, ''))
            ELSE u.lbl
        END
        ORDER BY u.ord
    ), ARRAY[]::text[])
    FROM c_out,
         ROWS FROM (unnest(p_ids), unnest(c_out.arr)) WITH ORDINALITY AS u(id, lbl, ord);
END;
