-- Containment over a Content trajectory's constituent ids: which compositions
-- contain this child, as constituent_ids(trajectory) @> ARRAY[child]. Contains,
-- precedes, follows, part-of, and co-occurrence are that one probe read at
-- different ordinals; generation.trajectory_continuations() reads it for
-- PROPOSE. GIN writes one entry per array element, so this is the costliest
-- index on the table to maintain; no row predicate narrows it further because
-- entity type lives on entities.
--
-- fastupdate batches inserts in a pending list that is merged in bulk, where
-- entries for one key combine into one posting-list update. Searches scan the
-- pending list linearly, so the raised limit depends on
-- NpgsqlIngestOps.CleanGinPendingListsAsync draining every leaf's list at
-- writer completion; readers then never scan a populated list.
CREATE INDEX IF NOT EXISTS physicalities_constituents_gin
    ON physicalities USING gin (public.laplace_trajectory_constituent_ids(trajectory))
    WITH (fastupdate = on, gin_pending_list_limit = 32768)
    WHERE type = 1 AND trajectory IS NOT NULL;

-- Projection trajectories (type 3), the calculated and evictable ones, get the
-- same containment probe without widening Content probes to them.
CREATE INDEX IF NOT EXISTS physicalities_projection_constituents_gin
    ON physicalities USING gin (public.laplace_trajectory_constituent_ids(trajectory))
    WITH (fastupdate = on, gin_pending_list_limit = 32768)
    WHERE type = 3 AND trajectory IS NOT NULL;

-- Ordered source annotations (type 8) couple structurally through their own
-- physicality domain and never enter Content continuation posting lists.
CREATE INDEX IF NOT EXISTS physicalities_parse_constituents_gin
    ON physicalities USING gin (public.laplace_trajectory_constituent_ids(trajectory))
    WHERE type = 8 AND trajectory IS NOT NULL;

-- Descriptor manifests (type 9) reference entities without being a Content
-- curve; their containment lookup stays separate from continuation.
CREATE INDEX IF NOT EXISTS physicalities_descriptor_constituents_gin
    ON physicalities USING gin (public.laplace_trajectory_constituent_ids(trajectory))
    WHERE type = 9 AND trajectory IS NOT NULL;
