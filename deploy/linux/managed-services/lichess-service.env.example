# Optional server-side settings. Copy to /opt/laplace/secrets/lichess-service.env.
# Do not put LICHESS_API here: CI owns that secret in lichess.env.
# The engine every move comes from: laplace, stockfish or lc0 (through laplace-uci), or a UCI executable's path.
LAPLACE_LICHESS_ENGINE=laplace
# Extra UCI options for it, Name=Value;Name=Value (canonical names map per engine: threads, hash, overhead, ...).
LAPLACE_LICHESS_ENGINE_OPTIONS=
# Taken off our clock before the engine sees it, for the network (milliseconds).
LAPLACE_LICHESS_MOVE_OVERHEAD_MS=300
LAPLACE_LICHESS_MAX_CONCURRENT=2
# Omit/empty accepts all standard-game speeds; otherwise comma-separated names.
LAPLACE_LICHESS_SPEEDS=
