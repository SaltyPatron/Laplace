-- NO `SET search_path` (GH #860). The clause makes a SQL function non-inlinable:
-- the planner keeps it as an opaque `Function Scan` instead of pulling the body
-- into the caller and pushing predicates through to the index. Measured on the
-- foundation seed 2026-08-04, the SET-carrying siblings planned as one opaque line
-- where `lexical.senses()` -- which dropped the clause under #617 -- inlined to an
-- `Index Scan using entities_t2_h0_type_id_idx`. `define` sits on the read path,
-- so it pays that on every call.
--
-- Every reference is `@extschema@.`-qualified instead. That is what the clause was
-- actually doing here, and qualification does it at parse time for free. This is the
-- same trade `drop_retired_eff_mu` records and CLAUDE.md states as law.
DROP FUNCTION IF EXISTS laplace.define(bytea, int);
CREATE OR REPLACE FUNCTION lexical.define(p_word bytea, p_limit int DEFAULT 5)
    RETURNS TABLE(definition text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE STRICT PARALLEL SAFE AS $$
    WITH picked AS MATERIALIZED (
        SELECT u.object_id, u.eff_mu, u.witnesses, u.sense_rank
        FROM (
            SELECT g.object_id AS object_id,
                   consensus.eff_mu_display(g.rating, g.rd) AS eff_mu,
                   g.witness_count AS witnesses,
                   sn.eff_mu AS sense_rank
            FROM lexical.senses(p_word) sn
            JOIN @extschema@.consensus g ON g.subject_id = sn.synset_id
                            AND g.type_id = @extschema@.relation_type_id('HAS_DEFINITION')
            UNION ALL
            SELECT g.object_id,
                   consensus.eff_mu_display(g.rating, g.rd),
                   g.witness_count,
                   NULL::numeric
            FROM unnest(lexical.lexical_peers(p_word)) AS peer(id)
            JOIN @extschema@.consensus g ON g.subject_id = peer.id
                            AND g.type_id = @extschema@.relation_type_id('HAS_DEFINITION')
        ) u
        ORDER BY COALESCE(u.sense_rank, 0) + u.eff_mu DESC
        LIMIT p_limit
    ), numbered AS MATERIALIZED (
      SELECT d.*, row_number() OVER (ORDER BY COALESCE(d.sense_rank,0)+d.eff_mu DESC, d.object_id) AS rn FROM picked d
    ), batch AS MATERIALIZED (
      SELECT realize.render_text_batch(array_agg(object_id ORDER BY rn), 24) AS txt FROM numbered
    )
    SELECT b.txt[d.rn], d.eff_mu, d.witnesses FROM numbered d CROSS JOIN batch b ORDER BY d.rn
$$;
