-- Neighbours in BOTH directions of one type set, unrefuted, laplace.eff_mu order. Thin
-- wrapper over consensus.edges_raw(); the UNION ALL it used to hand-roll is that function.
DROP FUNCTION IF EXISTS laplace.consensus_neighbors_undirected(bytea, bytea[], int);
CREATE OR REPLACE FUNCTION consensus.neighbors_undirected(
    p_subject bytea, p_types bytea[], p_limit int)
    RETURNS TABLE(nbr bytea, rating bigint, rd bigint, witness_count bigint)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    SELECT e.neighbour_id, e.rating, e.rd, e.witness_count
    FROM consensus.edges_raw(p_subject, 'both', p_types, p_limit, false, 'eff_mu') e
$$;
