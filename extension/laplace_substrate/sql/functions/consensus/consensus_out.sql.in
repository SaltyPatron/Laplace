-- Outbound edges of an entity. Thin wrapper over consensus.edges_raw(), which is the one
-- consensus scan; this pins the axes this signature has always had — outbound,
-- laplace.edge_rank ordering, and REFUTED EDGES INCLUDED. That last one is now visible
-- rather than implicit: pass through consensus.edges_raw(p_refuted => false) if you want
-- only claims the fold has not rated below neutral.
DROP FUNCTION IF EXISTS laplace.consensus_out(bytea, integer);
CREATE OR REPLACE FUNCTION consensus.consensus_out(p_id bytea, p_limit integer DEFAULT 40)
    RETURNS TABLE(type_id bytea, object_id bytea, rating bigint, rd bigint,
                  volatility bigint, witness_count bigint)
    LANGUAGE sql STABLE AS $$
    SELECT e.type_id, e.neighbour_id, e.rating, e.rd, e.volatility, e.witness_count
    FROM consensus.edges_raw(p_id, 'out', NULL, p_limit, true, 'edge_rank') e
$$;
