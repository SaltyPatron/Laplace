-- View still binds the flat name until its CREATE OR REPLACE later in the
-- install chain; drop it so the dual-name ban (#532) DROP can proceed.
DROP VIEW IF EXISTS laplace.v_attestation_readable;
DROP FUNCTION IF EXISTS laplace.label_or_hex(bytea);
CREATE OR REPLACE FUNCTION converse.label_or_hex(p_id bytea)
    RETURNS text
    LANGUAGE sql STABLE STRICT PARALLEL SAFE AS $$
    -- Legacy name retained for installed-call compatibility.  A total display is
    -- the same universal realization contract as the batch path.  When content or
    -- a witnessed name is unavailable, expose an explicit id:<prefix> identity
    -- handle; do not manufacture prose and do not reinterpret technical strings as
    -- a language-specific label.
    SELECT d.label
    FROM realize.display_batch(ARRAY[p_id], NULL::bytea) d
    WHERE d.ord = 1
$$;
