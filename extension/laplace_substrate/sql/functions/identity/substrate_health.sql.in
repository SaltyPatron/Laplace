-- substrate_health(): the cheap health check seed, CI, and the MCP health tool
-- call. Every whole-corpus scan (identity_law_violations, the exact entity
-- count) runs only with p_deep; otherwise those columns are NULL,
-- not 0, because "not checked" and "checked, none found" are different claims.
-- deep_checked says which one was returned.

CREATE OR REPLACE FUNCTION laplace.substrate_health(p_deep boolean DEFAULT false)
RETURNS TABLE(
    ok boolean,
    identity_violations bigint,
    entities bigint,
    surface_present boolean,
    registry_relations bigint,
    deep_checked boolean
)
LANGUAGE sql
STABLE
BEGIN ATOMIC
    -- Each scan runs once and `ok` is derived from its columns; the planner
    -- does not merge repeated scalar subqueries in one targetlist. The default
    -- path reads leaf-partition estimates and point lookups only.
    WITH scans AS (
        SELECT
            CASE WHEN p_deep
                 THEN (SELECT count(*) FROM laplace.identity_law_violations())
            END AS identity_violations,
            CASE WHEN p_deep
                 THEN (SELECT count(*) FROM laplace.entities)
                 ELSE (SELECT COALESCE(sum(GREATEST(c.reltuples, 0)::bigint), 0)::bigint
                       FROM pg_partition_tree('laplace.entities'::regclass) t
                       JOIN pg_class c ON c.oid = t.relid
                       WHERE t.isleaf)
            END AS entities,
            -- The Tier-0 surface is the codepoint ROM: an atom resolves through it,
            -- never through a stored row. Without it nothing composes.
            (public.laplace_text_id('A') IS NOT NULL) AS surface_present,
            (SELECT count(*) FROM laplace.relation_registry()) AS registry_relations
    )
    SELECT
        -- An unchecked (NULL) count never reads as clean: it contributes nothing
        -- to ok, and deep_checked marks the verdict partial.
        (s.surface_present
         AND s.registry_relations > 0
         AND (NOT p_deep OR s.identity_violations = 0)) AS ok,
        s.identity_violations,
        s.entities,
        s.surface_present,
        s.registry_relations,
        p_deep AS deep_checked
    FROM scans s;
END;
