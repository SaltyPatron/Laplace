-- consensus.relation_summary — GH #862 / #860. No SET, real schema names.
DROP FUNCTION IF EXISTS laplace.relation_summary(bytea, bytea);
CREATE OR REPLACE FUNCTION consensus.relation_summary(p_x bytea, p_y bytea)
    RETURNS TABLE(relation text, plane text, mu numeric, usage bigint,
                  geodesic double precision, verdict text)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    SELECT r.chain, r.plane, r.path_mu, COALESCE(u.n, 0), g.geo,
           concat_ws('',
             CASE WHEN r.chain IS NOT NULL THEN 'related via ' || r.plane
                  ELSE 'no witnessed conceptual path' END,
             CASE WHEN COALESCE(u.n, 0) >= 10 THEN '; strong shared usage (' || u.n || ')'
                  WHEN COALESCE(u.n, 0) > 0 THEN '; some shared usage (' || u.n || ')'
                  ELSE '' END,
             CASE WHEN g.geo IS NOT NULL AND g.geo < 0.4 THEN '; structurally near'
                  ELSE '' END)
    FROM (SELECT 1) one
    -- No LIMIT: relate_path already picks its single winner on (len, mu) before it
    -- renders anything, so it returns at most one row. The LIMIT that used to sit
    -- here read as a guard over an unordered pick and would have silently masked a
    -- real regression if that internal ranking were ever dropped.
    LEFT JOIN LATERAL (SELECT * FROM consensus.relate_path(p_x, p_y)) r ON true
    LEFT JOIN LATERAL (SELECT consensus.usage_overlap(p_x, p_y) AS n) u ON true
    LEFT JOIN LATERAL (
        SELECT public.laplace_angular_distance_4d(
            (SELECT coord FROM laplace.v_word_points WHERE id = p_x AND coord IS NOT NULL LIMIT 1),
            (SELECT coord FROM laplace.v_word_points WHERE id = p_y AND coord IS NOT NULL LIMIT 1)) AS geo) g ON true
$$;
