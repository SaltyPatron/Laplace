     [Fact]
+    public void ResolveConsensusFold_LeavesHeadroomInTheSharedIngestPool()
+    {
+        // The ingest pool is 1 + 2·applyPartitions (control + COPY fan + fold
+        // fan, PostgresResourcePlan.Resolve), and the fold of batch N runs while
+        // batch N+1 probes/COPYs. The fold's gate must therefore sit BELOW its
+        // pool share: run 32417964629 (syzygy seed) died with the planned owners
+        // summing to exactly Max Pool Size and every unplanned renter starving
+        // at the 15s rent timeout. Pin the ledger: control + COPY fan + fold
+        // gate + free headroom fills the pool exactly.
+        foreach (int p in new[] { 12, 8, 4 })
+        {
+            int pool = PostgresResourcePlan.Resolve(64L << 30, p, 2 * p, 2)
+                .IngestConnectionOwners;
+            var plan = IngestSizing.ResolveConsensusFold(p, 2L << 30, 256L << 20);
+            Assert.Equal(pool,
+                1 + p + plan.Connections + IngestSizing.ConsensusFoldPoolHeadroom);
+        }
+
+        // A machine too small to cede the full headroom still folds on one
+        // connection; forward progress outranks slack there.
+        Assert.Equal(1,
+            IngestSizing.ResolveConsensusFold(1, 2L << 30, 256L << 20).Connections);
+        Assert.Equal(1,
+            IngestSizing.ResolveConsensusFold(2, 2L << 30, 256L << 20).Connections);
+    }
+
