-- BEGIN ATOMIC: GH #764/#1008.
DROP FUNCTION IF EXISTS laplace.entity_count(bytea);
DROP FUNCTION IF EXISTS laplace.entity_counts_by_types(bytea[]);

CREATE OR REPLACE FUNCTION ops.entity_count(p_type bytea)
    RETURNS bigint
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT count(*)::bigint
    FROM laplace.entities e
    WHERE e.type_id = p_type;
END;

CREATE OR REPLACE FUNCTION ops.entity_counts_by_types(p_types bytea[])
    RETURNS TABLE(type_id bytea, entities bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    WITH requested AS (
        SELECT DISTINCT t.type_id
        FROM unnest(COALESCE(p_types, '{}'::bytea[])) AS t(type_id)
    ), counted AS (
        SELECT e.type_id, count(*)::bigint AS entities
        FROM laplace.entities e
        WHERE e.type_id = ANY(COALESCE(p_types, '{}'::bytea[]))
        GROUP BY e.type_id
    )
    SELECT r.type_id, COALESCE(c.entities, 0)::bigint
    FROM requested r
    LEFT JOIN counted c USING (type_id);
END;
