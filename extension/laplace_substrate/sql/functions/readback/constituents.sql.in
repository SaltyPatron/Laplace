DROP FUNCTION IF EXISTS laplace.constituents(bytea);
CREATE OR REPLACE FUNCTION realize.constituents(p_id bytea)
    RETURNS TABLE(ordinal integer, child_id bytea, run_length integer, flags bigint)
    LANGUAGE sql STABLE
    AS $$
    SELECT u.ordinal, u.entity_id, u.run_length, u.flags
    FROM (
        SELECT w.trajectory AS traj
        FROM laplace.v_word_points w
        WHERE w.id = p_id AND w.trajectory IS NOT NULL
        ORDER BY w.physicality_id
        LIMIT 1
    ) t
    CROSS JOIN LATERAL public.laplace_trajectory_constituents(t.traj) AS u
    ORDER BY 1
$$;
