DROP FUNCTION IF EXISTS laplace.laplace_astar_path(bytea, bytea, bytea[], integer, bool);
CREATE OR REPLACE FUNCTION generation.astar_path(
    p_source bytea, p_target bytea,
    p_type_ids bytea[] DEFAULT NULL,
    p_max_depth integer DEFAULT 20,
    p_use_geometry bool DEFAULT false)
RETURNS TABLE(step integer, entity_id bytea, g float8)
LANGUAGE sql STABLE AS $$
    SELECT step, entity_id, g
    FROM converse.astar_path_raw(
        p_source,
        ARRAY[p_target],
        p_type_ids,
        p_max_depth,
        false,
        p_use_geometry)
$$;
