-- Forward program shared read primitives (spec 36): bindings, key_facts, couple, respond, translate.

CREATE OR REPLACE FUNCTION converse._binding_evidence_impl(
    p_terms bytea[], p_lang bytea, p_support boolean)
RETURNS TABLE(term bytea, key bytea, binding bytea, claim bytea, language bytea,
              in_lang boolean, eff_mu numeric, witnesses bigint, games bigint)
LANGUAGE plpgsql STABLE PARALLEL SAFE
AS $$
DECLARE
    v_has_tuple boolean := false;
BEGIN
    IF COALESCE(cardinality(p_terms), 0) = 0 THEN
        RETURN;
    END IF;

    RETURN QUERY
    WITH roots AS MATERIALIZED (
        SELECT ARRAY(SELECT DISTINCT public.blake3_from_bytea(id) FROM unnest(p_terms) u(id) WHERE id IS NOT NULL) AS ids
    ), carriers AS MATERIALIZED (
        SELECT h.parts[1] AS word, h.entity, h.parts
        FROM roots r
        CROSS JOIN LATERAL (
            SELECT h.entity, public.laplace_parts(h.path) AS parts
            FROM public.laplace_holders(r.ids, '{}'::public.blake3[], false, -1::smallint, -1::bigint, 2::smallint,
                 ARRAY[public.laplace_bank_bit('kind', 'tuple')], 1::smallint) h
            WHERE public.laplace_mask_has_value(h.mask, 'kind', 'tuple')
              AND public.laplace_path_length(h.path) = 3
        ) h
        WHERE h.parts[1] = ANY(r.ids)
    ), languages AS MATERIALIZED (
        SELECT * FROM laplace.language_codes(ARRAY(SELECT DISTINCT public.blake3_send(parts[2]) FROM carriers))
    ), lexical AS MATERIALIZED (
        SELECT c.* FROM carriers c JOIN languages l ON l.id = public.blake3_send(c.parts[2])
    ), cells AS MATERIALIZED (
        SELECT c.entity, public.laplace_parts(c.path) AS parts, c.rating, c.deviation, c.matches
        FROM public.laplace_claims_each(ARRAY(SELECT DISTINCT entity FROM lexical), NULL::bigint,
             ARRAY[public.laplace_bank_bit('kind','claim')], '{}'::public.blake3[]) c
        WHERE public.laplace_path_length(c.path) IN (2, 3)
    ), binding_cells AS MATERIALIZED (
        SELECT DISTINCT c.*
        FROM lexical t
        JOIN cells c
          ON (cardinality(c.parts) = 3
              AND ((c.parts[3] = t.entity AND c.parts[1] IN (t.word, t.parts[3]))
                OR (c.parts[1] = t.entity AND c.parts[3] IN (t.word, t.parts[3]))))
          OR (cardinality(c.parts) = 2
              AND ((c.parts[2] = t.entity AND c.parts[1] IN (t.word, t.parts[3]))
                OR (c.parts[1] = t.entity AND c.parts[2] IN (t.word, t.parts[3]))))
    ), admitted AS MATERIALIZED (
        SELECT a.claim, count(*) AS witnesses
        FROM public.laplace_attested(ARRAY(SELECT entity FROM binding_cells WHERE p_support), false) a
        WHERE a.witness GROUP BY a.claim
        UNION ALL
        -- The lexical read consumes the standing admitted during ingestion.
        SELECT entity, NULL::bigint FROM binding_cells WHERE NOT p_support AND matches > 0
    ), usage_objs AS MATERIALIZED (
        SELECT l.entity AS obj_b3,
               CASE WHEN l.content ~ '^[0-9]+$' AND length(l.content) <= 18
                    THEN l.content::bigint
                    ELSE 0::bigint END AS freq
        FROM public.laplace_labels(ARRAY(
            SELECT DISTINCT c.parts[3]
            FROM lexical t
            JOIN cells c ON c.parts[1] = t.entity
            WHERE cardinality(c.parts) = 3
              AND c.matches > 1
              AND c.parts[3] NOT IN (t.word, t.parts[3])
              AND (c.rating - 2 * c.deviation) > 0
        )) l
    ), sense_usage AS MATERIALIZED (
        SELECT t.entity AS sense_b3,
               max((c.rating - 2 * c.deviation)::numeric + COALESCE(uo.freq, 0)::numeric) AS max_eff_mu,
               max(GREATEST(c.matches::bigint, COALESCE(uo.freq, 0)::bigint))::bigint AS max_matches
        FROM lexical t
        JOIN cells c ON c.parts[1] = t.entity
        LEFT JOIN usage_objs uo ON uo.obj_b3 = c.parts[3]
        WHERE cardinality(c.parts) = 3
          AND c.matches > 1
          AND c.parts[3] NOT IN (t.word, t.parts[3])
          AND (c.rating - 2 * c.deviation) > 0
        GROUP BY t.entity
    ), native_tuple AS MATERIALIZED (
        SELECT DISTINCT ON (t.word, t.parts[3], t.entity)
            public.blake3_send(t.word) AS term,
            public.blake3_send(t.parts[3]) AS key,
            public.blake3_send(t.entity) AS binding,
            public.blake3_send(c.entity) AS claim,
            public.blake3_send(t.parts[2]) AS language,
            COALESCE(public.blake3_send(t.parts[2]) = p_lang, false) AS in_lang,
            GREATEST((c.rating - 2 * c.deviation)::numeric, COALESCE(su.max_eff_mu, 0::numeric)) AS eff_mu,
            a.witnesses,
            GREATEST(c.matches::bigint, COALESCE(su.max_matches, 0::bigint)) AS games
        FROM lexical t
        JOIN binding_cells c
          ON (cardinality(c.parts) = 3
              AND ((c.parts[3] = t.entity AND c.parts[1] IN (t.word, t.parts[3]))
                OR (c.parts[1] = t.entity AND c.parts[3] IN (t.word, t.parts[3]))))
          OR (cardinality(c.parts) = 2
              AND ((c.parts[2] = t.entity AND c.parts[1] IN (t.word, t.parts[3]))
                OR (c.parts[1] = t.entity AND c.parts[2] IN (t.word, t.parts[3]))))
        JOIN admitted a ON a.claim = c.entity
        LEFT JOIN sense_usage su ON su.sense_b3 = t.entity
        ORDER BY t.word, t.parts[3], t.entity,
                 GREATEST((c.rating - 2 * c.deviation)::numeric, COALESCE(su.max_eff_mu, 0::numeric)) DESC,
                 GREATEST(c.matches::bigint, COALESCE(su.max_matches, 0::bigint)) DESC,
                 c.entity
    )
    SELECT * FROM native_tuple;

    IF FOUND THEN
        RETURN;
    END IF;

    RETURN QUERY
    WITH roots AS MATERIALIZED (
        SELECT ARRAY(SELECT DISTINCT public.blake3_from_bytea(id) FROM unnest(p_terms) u(id) WHERE id IS NOT NULL) AS ids
    ), kb_surfaces AS MATERIALIZED (
        SELECT public.blake3_from_bytea(s.surface_id) AS surface_b3, s.inverse
        FROM consensus.relation_surfaces(consensus.relation_set_ids('KEY_BINDING')) s
    ), direct_claims AS MATERIALIZED (
        SELECT c.entity, public.laplace_parts(c.path) AS parts, c.rating, c.deviation, c.matches, ks.inverse
        FROM roots r
        CROSS JOIN LATERAL public.laplace_claims_each(
            r.ids, NULL::bigint, ARRAY[public.laplace_bank_bit('kind','claim')], '{}'::public.blake3[],
            3::smallint, ARRAY(SELECT DISTINCT surface_b3 FROM kb_surfaces), 3::bigint) c
        JOIN kb_surfaces ks ON public.laplace_middle_any(c.path, ARRAY[ks.surface_b3])
        WHERE public.laplace_path_length(c.path) = 3
          AND c.matches > 0
          AND (c.rating - 2 * c.deviation) > 0
    ), direct_unmatched AS MATERIALIZED (
        SELECT CASE WHEN d.inverse THEN d.parts[3] ELSE d.parts[1] END AS term_b3,
               CASE WHEN d.inverse THEN d.parts[1] ELSE d.parts[3] END AS key_b3,
               d.entity, d.rating, d.deviation, d.matches
        FROM direct_claims d
        CROSS JOIN roots r
        WHERE (CASE WHEN d.inverse THEN d.parts[3] ELSE d.parts[1] END) = ANY(r.ids)
    ), tuple_keys AS MATERIALIZED (
        SELECT DISTINCT h.entity
        FROM public.laplace_physicalities(ARRAY(SELECT DISTINCT key_b3 FROM direct_unmatched)) h
        WHERE EXISTS (SELECT 1 FROM direct_unmatched)
          AND public.laplace_mask_has_value(h.mask, 'kind', 'tuple')
    ), direct_oriented AS MATERIALIZED (
        SELECT public.blake3_send(d.term_b3) AS term,
               public.blake3_send(d.key_b3) AS key,
               public.blake3_send(d.entity) AS claim,
               (d.rating - 2 * d.deviation)::numeric AS eff_mu,
               CASE WHEN p_support THEN GREATEST(d.matches, 1)::bigint ELSE NULL::bigint END AS witnesses,
               d.matches::bigint AS games
        FROM direct_unmatched d
        WHERE NOT EXISTS (SELECT 1 FROM tuple_keys tk WHERE tk.entity = d.key_b3)
    ), direct_langs AS MATERIALIZED (
        SELECT e.subject_id AS word, e.neighbour_id AS lang,
               row_number() OVER (
                   PARTITION BY e.subject_id
                   ORDER BY (e.neighbour_id = p_lang) DESC, consensus.eff_mu(e.rating, e.rd) DESC, e.neighbour_id
               ) AS rn
        FROM consensus.edges_raw_batch(
            ARRAY(SELECT DISTINCT du.term FROM direct_oriented du),
            'out', consensus.relation_family_ids('HAS_LANGUAGE'), 8, true, 'edge_rank') e
        WHERE EXISTS (SELECT 1 FROM direct_oriented)
          AND e.neighbour_id IS NOT NULL
    )
    SELECT d.term, d.key, d.key AS binding, d.claim,
           dl.lang AS language,
           COALESCE(dl.lang = p_lang, false) AS in_lang,
           d.eff_mu, d.witnesses, d.games
    FROM direct_oriented d
    LEFT JOIN direct_langs dl ON dl.word = d.term AND dl.rn = 1;

    IF FOUND OR NOT EXISTS (SELECT 1 FROM laplace.consensus) THEN
        RETURN;
    END IF;

    RETURN QUERY
    WITH legacy_cells AS MATERIALIZED (
        SELECT c.id, c.subject_id AS term, c.object_id AS key, c.type_id, c.rating, c.rd, c.witness_count
        FROM laplace.v_consensus_unrefuted c
        WHERE c.subject_id = ANY(p_terms)
          AND c.type_id = ANY(consensus.relation_set_ids('KEY_BINDING'))
          AND c.object_id IS NOT NULL
    )
    SELECT b.term, b.key, b.key AS binding, b.id AS claim,
           CASE
               WHEN COALESCE(bool_or(a.context_id = p_lang), false) THEN p_lang
               WHEN p_lang IS NULL THEN max(a.context_id)
           END AS language,
           COALESCE(bool_or(a.context_id = p_lang), false) AS in_lang,
           consensus.eff_mu_display(b.rating, b.rd) AS eff_mu,
           b.witness_count AS witnesses,
           COALESCE(sum(a.observation_count), 0)::bigint AS games
    FROM legacy_cells b
    LEFT JOIN laplace.attestations a
      ON a.subject_id = b.term
     AND a.subject_id = ANY(p_terms)
     AND a.type_id = b.type_id
     AND a.object_id = b.key
    GROUP BY b.term, b.key, b.id, b.rating, b.rd, b.witness_count;
END;
$$;

CREATE OR REPLACE FUNCTION converse.binding_evidence(p_terms bytea[],p_lang bytea,p_support boolean)
RETURNS TABLE(term bytea,key bytea,binding bytea,claim bytea,language bytea,
              in_lang boolean,eff_mu numeric,witnesses bigint,games bigint)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
 SELECT * FROM converse._binding_evidence_impl(p_terms,p_lang,p_support);
END;

CREATE OR REPLACE FUNCTION converse.binding_evidence(p_terms bytea[],p_lang bytea DEFAULT NULL)
RETURNS TABLE(term bytea,key bytea,binding bytea,claim bytea,language bytea,
              in_lang boolean,eff_mu numeric,witnesses bigint,games bigint)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
 SELECT * FROM converse.binding_evidence(p_terms,p_lang,true);
END;

-- Inverse (key -> word) binding evidence across Native tuples, direct KEY_BINDING
-- claims, and legacy consensus.
CREATE OR REPLACE FUNCTION converse._key_binding_evidence_impl(
    p_keys bytea[], p_lang bytea, p_support boolean)
RETURNS TABLE(key bytea, term bytea, binding bytea, claim bytea, language bytea,
              in_lang boolean, eff_mu numeric, witnesses bigint, games bigint,
              rating bigint, rd bigint)
LANGUAGE plpgsql STABLE PARALLEL SAFE
AS $$
DECLARE
    v_legacy_terms bytea[];
BEGIN
    IF COALESCE(cardinality(p_keys), 0) = 0 THEN
        RETURN;
    END IF;

    RETURN QUERY
    WITH roots AS MATERIALIZED (
        SELECT ARRAY(SELECT DISTINCT public.blake3_from_bytea(id) FROM unnest(p_keys) u(id) WHERE id IS NOT NULL) AS ids
    ), carriers AS MATERIALIZED (
        SELECT h.parts[3] AS key_b3, h.entity, h.parts
        FROM roots r
        CROSS JOIN LATERAL (
            SELECT h.entity, public.laplace_parts(h.path) AS parts
            FROM public.laplace_holders(r.ids, '{}'::public.blake3[], false, -1::smallint, -1::bigint, 2::smallint,
                 ARRAY[public.laplace_bank_bit('kind', 'tuple')], 2::smallint) h
            WHERE public.laplace_mask_has_value(h.mask, 'kind', 'tuple')
              AND public.laplace_path_length(h.path) = 3
        ) h
        WHERE h.parts[3] = ANY(r.ids)
    ), languages AS MATERIALIZED (
        SELECT * FROM laplace.language_codes(ARRAY(SELECT DISTINCT public.blake3_send(parts[2]) FROM carriers))
    ), lexical AS MATERIALIZED (
        SELECT c.*
        FROM carriers c
        JOIN languages l ON l.id = public.blake3_send(c.parts[2])
        WHERE p_lang IS NULL OR l.id = p_lang
    ), cells AS MATERIALIZED (
        SELECT c.entity, public.laplace_parts(c.path) AS parts, c.rating, c.deviation, c.matches
        FROM public.laplace_claims_each(ARRAY(SELECT DISTINCT entity FROM lexical), NULL::bigint,
             ARRAY[public.laplace_bank_bit('kind','claim')], '{}'::public.blake3[]) c
        WHERE public.laplace_path_length(c.path) IN (2, 3)
          AND c.matches > 0
    ), usage_objs AS MATERIALIZED (
        SELECT l.entity AS obj_b3,
               CASE WHEN l.content ~ '^[0-9]+$' AND length(l.content) <= 18
                    THEN l.content::bigint
                    ELSE 0::bigint END AS freq
        FROM public.laplace_labels(ARRAY(
            SELECT DISTINCT c.parts[3]
            FROM lexical t
            JOIN cells c ON c.parts[1] = t.entity
            WHERE cardinality(c.parts) = 3
              AND c.matches > 1
              AND c.parts[3] NOT IN (t.parts[1], t.parts[3])
              AND (c.rating - 2 * c.deviation) > 0
        )) l
    ), sense_usage AS MATERIALIZED (
        SELECT t.entity AS sense_b3,
               max((c.rating - 2 * c.deviation)::numeric + COALESCE(uo.freq, 0)::numeric) AS max_eff_mu,
               max(GREATEST(c.matches::bigint, COALESCE(uo.freq, 0)::bigint))::bigint AS max_matches
        FROM lexical t
        JOIN cells c ON c.parts[1] = t.entity
        LEFT JOIN usage_objs uo ON uo.obj_b3 = c.parts[3]
        WHERE cardinality(c.parts) = 3
          AND c.matches > 1
          AND c.parts[3] NOT IN (t.parts[1], t.parts[3])
          AND (c.rating - 2 * c.deviation) > 0
        GROUP BY t.entity
    ), native_tuple AS MATERIALIZED (
        SELECT DISTINCT ON (t.key_b3, t.parts[1], t.entity)
            public.blake3_send(t.key_b3) AS key,
            public.blake3_send(t.parts[1]) AS term,
            public.blake3_send(t.entity) AS binding,
            public.blake3_send(c.entity) AS claim,
            public.blake3_send(t.parts[2]) AS language,
            COALESCE(public.blake3_send(t.parts[2]) = p_lang, true) AS in_lang,
            GREATEST((c.rating - 2 * c.deviation)::numeric, COALESCE(su.max_eff_mu, 0::numeric)) AS eff_mu,
            GREATEST(c.matches::bigint, COALESCE(su.max_matches, 1::bigint)) AS witnesses,
            GREATEST(c.matches::bigint, COALESCE(su.max_matches, 0::bigint)) AS games,
            round(GREATEST((c.rating - 2 * c.deviation)::numeric, COALESCE(su.max_eff_mu, 0::numeric)) * 1e9)::bigint AS rating,
            0::bigint AS rd
        FROM lexical t
        JOIN cells c
          ON ((cardinality(c.parts) = 3
               AND ((c.parts[3] = t.entity AND c.parts[1] IN (t.parts[1], t.parts[3]))
                    OR (c.parts[1] = t.entity AND c.parts[3] IN (t.parts[1], t.parts[3]))))
              OR (cardinality(c.parts) = 2
                  AND ((c.parts[2] = t.entity AND c.parts[1] IN (t.parts[1], t.parts[3]))
                       OR (c.parts[1] = t.entity AND c.parts[2] IN (t.parts[1], t.parts[3])))))
        LEFT JOIN sense_usage su ON su.sense_b3 = t.entity
        WHERE (c.rating - 2 * c.deviation) > 0
        ORDER BY t.key_b3, t.parts[1], t.entity,
                 GREATEST((c.rating - 2 * c.deviation)::numeric, COALESCE(su.max_eff_mu, 0::numeric)) DESC,
                 GREATEST(c.matches::bigint, COALESCE(su.max_matches, 0::bigint)) DESC,
                 c.entity
    )
    SELECT * FROM native_tuple;

    IF FOUND THEN
        RETURN;
    END IF;

    IF p_lang IS NOT NULL AND EXISTS (
        SELECT 1
        FROM public.laplace_holders(
            ARRAY(SELECT DISTINCT public.blake3_from_bytea(id) FROM unnest(p_keys) u(id) WHERE id IS NOT NULL),
            '{}'::public.blake3[], false, -1::smallint, -1::bigint, 2::smallint,
            ARRAY[public.laplace_bank_bit('kind', 'tuple')], 2::smallint) h
        WHERE public.laplace_mask_has_value(h.mask, 'kind', 'tuple')
          AND public.laplace_path_length(h.path) = 3
    ) THEN
        RETURN;
    END IF;

    RETURN QUERY
    WITH roots AS MATERIALIZED (
        SELECT ARRAY(SELECT DISTINCT public.blake3_from_bytea(id) FROM unnest(p_keys) u(id) WHERE id IS NOT NULL) AS ids
    ), kb_surfaces AS MATERIALIZED (
        SELECT public.blake3_from_bytea(s.surface_id) AS surface_b3, s.inverse
        FROM consensus.relation_surfaces(consensus.relation_set_ids('KEY_BINDING')) s
    ), direct_claims AS MATERIALIZED (
        SELECT c.entity, public.laplace_parts(c.path) AS parts, c.rating, c.deviation, c.matches, ks.inverse
        FROM roots r
        CROSS JOIN LATERAL public.laplace_claims_each(
            r.ids, NULL::bigint, ARRAY[public.laplace_bank_bit('kind','claim')], '{}'::public.blake3[],
            3::smallint, ARRAY(SELECT DISTINCT surface_b3 FROM kb_surfaces), 3::bigint) c
        JOIN kb_surfaces ks ON public.laplace_middle_any(c.path, ARRAY[ks.surface_b3])
        WHERE public.laplace_path_length(c.path) = 3
          AND c.matches > 0
          AND (c.rating - 2 * c.deviation) > 0
    ), direct_unmatched AS MATERIALIZED (
        SELECT CASE WHEN d.inverse THEN d.parts[1] ELSE d.parts[3] END AS key_b3,
               CASE WHEN d.inverse THEN d.parts[3] ELSE d.parts[1] END AS term_b3,
               d.entity, d.rating, d.deviation, d.matches
        FROM direct_claims d
        CROSS JOIN roots r
        WHERE (CASE WHEN d.inverse THEN d.parts[1] ELSE d.parts[3] END) = ANY(r.ids)
    ), tuple_terms AS MATERIALIZED (
        SELECT DISTINCT h.entity
        FROM public.laplace_physicalities(ARRAY(SELECT DISTINCT term_b3 FROM direct_unmatched)) h
        WHERE EXISTS (SELECT 1 FROM direct_unmatched)
          AND public.laplace_mask_has_value(h.mask, 'kind', 'tuple')
    ), direct_oriented AS MATERIALIZED (
        SELECT public.blake3_send(d.key_b3) AS key,
               public.blake3_send(d.term_b3) AS term,
               public.blake3_send(d.entity) AS claim,
               (d.rating - 2 * d.deviation)::numeric AS eff_mu,
               GREATEST(d.matches, 1)::bigint AS witnesses,
               d.matches::bigint AS games,
               round(d.rating::numeric * 1e9)::bigint AS rating,
               round(d.deviation::numeric * 1e9)::bigint AS rd
        FROM direct_unmatched d
        WHERE NOT EXISTS (SELECT 1 FROM tuple_terms tt WHERE tt.entity = d.term_b3)
    ), direct_langs AS MATERIALIZED (
        SELECT e.subject_id AS word, e.neighbour_id AS lang,
               row_number() OVER (
                   PARTITION BY e.subject_id
                   ORDER BY (e.neighbour_id = p_lang) DESC, consensus.eff_mu(e.rating, e.rd) DESC, e.neighbour_id
               ) AS rn
        FROM consensus.edges_raw_batch(
            ARRAY(SELECT DISTINCT du.term FROM direct_oriented du),
            'out', consensus.relation_family_ids('HAS_LANGUAGE'), 8, true, 'edge_rank') e
        WHERE EXISTS (SELECT 1 FROM direct_oriented)
          AND e.neighbour_id IS NOT NULL
    )
    SELECT d.key, d.term, d.key AS binding, d.claim,
           dl.lang AS language,
           COALESCE(dl.lang = p_lang, p_lang IS NULL) AS in_lang,
           d.eff_mu, d.witnesses, d.games, d.rating, d.rd
    FROM direct_oriented d
    LEFT JOIN direct_langs dl ON dl.word = d.term AND dl.rn = 1
    WHERE p_lang IS NULL OR dl.lang = p_lang;

    IF FOUND OR NOT EXISTS (SELECT 1 FROM laplace.consensus) THEN
        RETURN;
    END IF;

    SELECT array_agg(DISTINCT c.subject_id)
    INTO v_legacy_terms
    FROM laplace.v_consensus_unrefuted c
    WHERE c.object_id = ANY(p_keys)
      AND c.type_id = ANY(consensus.relation_set_ids('KEY_BINDING'))
      AND c.subject_id IS NOT NULL;

    IF COALESCE(cardinality(v_legacy_terms), 0) = 0 THEN
        RETURN;
    END IF;

    RETURN QUERY
    WITH legacy_cells AS MATERIALIZED (
        SELECT c.id, c.object_id AS key, c.subject_id AS term, c.type_id, c.rating, c.rd, c.witness_count
        FROM laplace.v_consensus_unrefuted c
        WHERE c.subject_id = ANY(v_legacy_terms)
          AND c.object_id = ANY(p_keys)
          AND c.type_id = ANY(consensus.relation_set_ids('KEY_BINDING'))
    )
    SELECT b.key, b.term, b.key AS binding, b.id AS claim,
           CASE
               WHEN COALESCE(bool_or(a.context_id = p_lang), false) THEN p_lang
               WHEN p_lang IS NULL THEN max(a.context_id)
           END AS language,
           COALESCE(bool_or(p_lang IS NULL OR a.context_id = p_lang), false) AS in_lang,
           consensus.eff_mu_display(b.rating, b.rd) AS eff_mu,
           b.witness_count AS witnesses,
           COALESCE(sum(a.observation_count), 0)::bigint AS games,
           b.rating, b.rd
    FROM legacy_cells b
    LEFT JOIN laplace.attestations a
      ON a.subject_id = b.term
     AND a.subject_id = ANY(v_legacy_terms)
     AND a.type_id = b.type_id
     AND a.object_id = b.key
    GROUP BY b.key, b.term, b.id, b.rating, b.rd, b.witness_count
    HAVING p_lang IS NULL OR COALESCE(bool_or(a.context_id = p_lang), false);
END;
$$;

CREATE OR REPLACE FUNCTION converse.key_binding_evidence(
    p_keys bytea[], p_lang bytea DEFAULT NULL, p_support boolean DEFAULT false)
RETURNS TABLE(key bytea, term bytea, binding bytea, claim bytea, language bytea,
              in_lang boolean, eff_mu numeric, witnesses bigint, games bigint,
              rating bigint, rd bigint)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
 SELECT * FROM converse._key_binding_evidence_impl(p_keys, p_lang, p_support);
END;

-- K: one election over the same evidence used by lexical and comparison reads.
CREATE OR REPLACE FUNCTION converse.bindings(p_terms bytea[], p_lang bytea DEFAULT NULL)
    RETURNS TABLE(term bytea, key bytea, in_lang boolean, eff_mu numeric,
                  witnesses bigint, games bigint, rank int)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
 SELECT e.term,e.key,e.in_lang,e.eff_mu,e.witnesses,e.games,
  row_number() OVER(PARTITION BY e.term ORDER BY e.in_lang DESC,e.games DESC,e.eff_mu DESC,e.key)::int
 FROM converse.binding_evidence(p_terms,p_lang) e;
END;

-- V: each key's own facts with their typed standing, strongest conservative standing
-- first. Bindings and non-salient structure are not facts about the key.
CREATE OR REPLACE FUNCTION converse.key_facts(p_keys bytea[], p_per_key int DEFAULT 24)
    RETURNS TABLE(key bytea, type_id bytea, object_id bytea, eff_mu numeric,
                  witnesses bigint, rating bigint, rd bigint, volatility bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH root_keys AS MATERIALIZED (
        SELECT DISTINCT u AS key FROM unnest(p_keys) u WHERE u IS NOT NULL
    ), sense_edges AS MATERIALIZED (
        SELECT e.subject_id AS key, e.neighbour_id AS object_id
        FROM consensus.edges_raw_batch(
            ARRAY(SELECT key FROM root_keys),
            'out', ARRAY[laplace.relation_type_id('IS_SENSE_OF')], 8, false, 'eff_mu') e
        WHERE e.neighbour_id IS NOT NULL
    ), expanded AS MATERIALIZED (
        SELECT k.key AS root_key, k.key AS subj_id FROM root_keys k
        UNION
        SELECT s.key AS root_key, s.object_id AS subj_id FROM sense_edges s
    ), non_salient AS MATERIALIZED (
        SELECT consensus.relation_canonical(id) AS cname
        FROM unnest(consensus.relation_set_ids('KEY_BINDING') || consensus.relation_set_ids('NON_SALIENT_STRUCTURAL')) AS u(id)
    ), batch_edges AS MATERIALIZED (
        SELECT *
        FROM consensus.edges_raw_batch(
            ARRAY(SELECT DISTINCT subj_id FROM expanded),
            'out', NULL, GREATEST(p_per_key * 2, 48), true, 'eff_mu')
    ), raw_edges AS (
        SELECT e.root_key AS key, c.type_id, c.neighbour_id AS object_id,
               c.rating, c.rd, 60000000::bigint AS volatility, c.witness_count
        FROM expanded e
        JOIN batch_edges c ON c.subject_id = e.subj_id
        WHERE c.neighbour_id IS NOT NULL
          AND consensus.relation_canonical(c.type_id) IS NOT NULL
          AND consensus.relation_canonical(c.type_id) NOT IN (SELECT cname FROM non_salient WHERE cname IS NOT NULL)
    ), deduped AS (
        SELECT DISTINCT ON (r.key, r.type_id, r.object_id)
               r.key, r.type_id, r.object_id,
               r.rating, r.rd, r.volatility, r.witness_count
        FROM raw_edges r
        ORDER BY r.key, r.type_id, r.object_id,
                 consensus.eff_mu(r.rating, r.rd) DESC
    ), f AS MATERIALIZED (
        SELECT d.key, d.type_id, d.object_id, d.rating, d.rd, d.volatility, d.witness_count,
               row_number() OVER (
                   PARTITION BY d.key
                   ORDER BY consensus.eff_mu(d.rating, d.rd) DESC, d.type_id, d.object_id
               ) AS rn
        FROM deduped d
    )
    SELECT f.key, f.type_id, f.object_id, consensus.eff_mu_display(f.rating, f.rd),
           f.witness_count, f.rating, f.rd, f.volatility
    FROM f
    WHERE f.rn <= GREATEST(p_per_key, 0);
END;

-- How two terms couple through their keys by typed channel (usage, fact, ancestor).
CREATE OR REPLACE FUNCTION converse.couple(p_x bytea, p_y bytea, p_lang bytea DEFAULT NULL,
                                          p_k int DEFAULT 12)
    RETURNS TABLE(x_key bytea, y_key bytea, channel text, relation bytea, via bytea,
                  sharing bigint, depth int)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH rel AS MATERIALIZED (
        SELECT laplace.relation_type_id('IS_SENSE_OF') AS is_sense_of,
               consensus.relation_set_ids('PATH_UPWARD') AS path_upward
    ), xk AS MATERIALIZED (
        SELECT b.key FROM converse.bindings(ARRAY[p_x], p_lang) b WHERE b.rank <= 16
        UNION SELECT p_x
    ), yk AS MATERIALIZED (
        SELECT b.key FROM converse.bindings(ARRAY[p_y], p_lang) b WHERE b.rank <= 16
        UNION SELECT p_y
    ), usage AS (
        SELECT p_x AS x_key, p_y AS y_key, 'usage'::text AS channel, NULL::bytea AS relation,
               cx.entity_id AS via, 1::bigint AS sharing, 0 AS depth
        FROM structural.containers_of(p_x, 1, 4096) cx
        JOIN structural.containers_of(p_y, 1, 4096) cy USING (entity_id)
    ), xf AS MATERIALIZED (
        SELECT f.key, f.type_id, f.object_id FROM converse.key_facts(ARRAY(SELECT key FROM xk), 64) f
    ), yf AS MATERIALIZED (
        SELECT f.key, f.type_id, f.object_id FROM converse.key_facts(ARRAY(SELECT key FROM yk), 64) f
    ), shared_fact AS (
        SELECT xf.key AS x_key, yf.key AS y_key, 'fact'::text AS channel, xf.type_id AS relation,
               xf.object_id AS via,
               (SELECT count(*) FROM consensus.edges_raw(xf.object_id, 'in', ARRAY[xf.type_id], 256, true, 'eff_mu')) AS sharing,
               0 AS depth
        FROM xf JOIN yf ON yf.type_id = xf.type_id AND yf.object_id = xf.object_id
    ), sense_init AS MATERIALIZED (
        SELECT e.subject_id, e.neighbour_id
        FROM rel r
        CROSS JOIN LATERAL consensus.edges_raw_batch(
            ARRAY(SELECT key FROM xk UNION SELECT key FROM yk),
            'out', ARRAY[r.is_sense_of], 4, false, 'eff_mu') e
    ), up AS (
        WITH RECURSIVE walk(root, side, node, depth) AS (
            SELECT xk.key, 'x', COALESCE(ss.neighbour_id, xk.key), 0
            FROM xk
            LEFT JOIN sense_init ss ON ss.subject_id = xk.key
            UNION ALL
            SELECT yk.key, 'y', COALESCE(ss.neighbour_id, yk.key), 0
            FROM yk
            LEFT JOIN sense_init ss ON ss.subject_id = yk.key
            UNION
            SELECT w.root, w.side, c.neighbour_id, w.depth + 1
            FROM walk w
            CROSS JOIN rel r
            CROSS JOIN LATERAL consensus.edges_raw(w.node, 'out', r.path_upward, 16, false, 'eff_mu') c
            WHERE w.depth < 4 AND c.neighbour_id IS NOT NULL
        )
        SELECT root, side, node, min(depth) AS depth FROM walk WHERE depth > 0
        GROUP BY root, side, node
    ), shared_ancestor AS (
        SELECT ux.root AS x_key, uy.root AS y_key, 'ancestor'::text AS channel,
               NULL::bytea AS relation, ux.node AS via,
               (SELECT count(*) FROM consensus.edges_raw(ux.node, 'in', (SELECT path_upward FROM rel), 256, true, 'eff_mu')) AS sharing,
               (ux.depth + uy.depth)::int AS depth
        FROM up ux JOIN up uy ON uy.node = ux.node AND uy.side = 'y'
        WHERE ux.side = 'x'
    ), all_evidence AS (
        SELECT * FROM usage UNION ALL SELECT * FROM shared_fact UNION ALL SELECT * FROM shared_ancestor
    )
    SELECT e.x_key, e.y_key, e.channel, e.relation, e.via, e.sharing, e.depth
    FROM all_evidence e
    ORDER BY e.sharing, e.depth, e.channel, e.via
    LIMIT GREATEST(p_k, 0);
END;

-- Q's language when the caller did not state one: the language the terms' bindings
-- were attested in most often. NULL when no binding carries a language.
CREATE OR REPLACE FUNCTION converse.terms_language(p_terms bytea[])
    RETURNS bytea
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT b.language AS lang
    FROM converse.binding_evidence(p_terms, NULL, false) b
    WHERE b.language IS NOT NULL
    GROUP BY b.language
    ORDER BY sum(GREATEST(b.games, 1))::numeric DESC, b.language
    LIMIT 1;
END;

-- The joint response of the web to a whole observation (native; spec 36 COUPLE). Every
-- term is tugged at once through its bindings and answered outward as an indexed star,
-- hop by hop; a candidate reached from every term, each by its own typed route, is the
-- interpretation the observation supports, so which sense of each term was meant falls
-- out of the meeting instead of being elected first. hops, fanout (per frontier node;
-- deeper hops use an eighth) and frontier (per hop) are the compute envelope. One row
-- per (candidate, term) route: the key it left from, its hop count, the relation of its
-- last step and the node it came through, the last step's typed standing, and the
-- weakest salience and weakest conservative standing along the path. Candidates are
-- ordered by terms answered, least salient route, fewest hops, then weakest standing.
-- p_min_salience is ROUTE's traversal envelope: relations below it (lexical glue such as
-- HAS_POS, scalar values, standards metadata) classify rather than connect, and are not
-- walked through.
CREATE OR REPLACE FUNCTION converse.respond(p_terms bytea[], p_hops int DEFAULT 2,
        p_fanout int DEFAULT 256, p_frontier int DEFAULT 4096, p_limit int DEFAULT 24,
        p_min_salience double precision DEFAULT 0.3)
    RETURNS TABLE(candidate bytea, covered int, term_ordinal int, term bytea, key bytea,
                  hops int, relation bytea, via bytea, outbound boolean,
                  rating bigint, rd bigint, volatility bigint, witnesses bigint,
                  salience double precision, weakest_standing bigint)
    AS 'EXECUTION_LIBRARY', 'pg_laplace_forward_respond'
    LANGUAGE C STABLE PARALLEL RESTRICTED
    ROWS 64;

-- A term's words in another language, through the identifiers it binds: bubble up from
-- the term to each identifier its bindings name in the source language, switch the
-- language, and come down every binding of that identifier in the target language.
CREATE OR REPLACE FUNCTION converse.translate(p_term bytea, p_to bytea, p_from bytea DEFAULT NULL)
    RETURNS TABLE(key bytea, target bytea,
                  up_rating bigint, up_rd bigint, up_witnesses bigint,
                  down_rating bigint, down_rd bigint, down_witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH up AS MATERIALIZED (
        SELECT b.key,
               round(b.eff_mu * 1e9)::bigint AS up_rating,
               0::bigint AS up_rd,
               COALESCE(b.witnesses, b.games, 1)::bigint AS up_witnesses
        FROM converse.binding_evidence(ARRAY[p_term], p_from, false) b
        WHERE p_from IS NULL OR b.in_lang
    ), down AS (
        SELECT d.key, d.term AS target,
               u.up_rating, u.up_rd, u.up_witnesses,
               d.rating AS down_rating, d.rd AS down_rd, d.witnesses AS down_witnesses
        FROM up u
        JOIN converse.key_binding_evidence(ARRAY(SELECT DISTINCT key FROM up), p_to, false) d
          ON d.key = u.key
        WHERE d.term <> p_term
    )
    SELECT DISTINCT ON (d.key, d.target)
           d.key, d.target, d.up_rating, d.up_rd, d.up_witnesses,
           d.down_rating, d.down_rd, d.down_witnesses
    FROM down d
    ORDER BY d.key, d.target, consensus.eff_mu(d.down_rating, d.down_rd) DESC;
END;

-- converse.firmware(name): a governed personality firmware image (spec 39) with its
-- content id. SQL orchestration reads policy from here, never from literals.
CREATE OR REPLACE FUNCTION converse.firmware(p_name text DEFAULT NULL,
    OUT firmware_id bytea, OUT name text, OUT salience_floor float8,
    OUT semantic_hops int, OUT fanout int, OUT meeting_hops int, OUT meeting_fanout int,
    OUT meeting_frontier int, OUT sharing_window int, OUT sharing_cap int,
    OUT spread float8, OUT top_k int, OUT steps int, OUT max_stride int, OUT version int)
    AS 'EXECUTION_LIBRARY', 'pg_laplace_firmware'
    LANGUAGE C IMMUTABLE PARALLEL SAFE;

-- converse.content_terms(words): the words of an observation that bind to a key and
-- whose strongest witnessed universal part of speech is a content tag.
CREATE OR REPLACE FUNCTION converse.content_terms(p_words bytea[])
    RETURNS bytea[]
    AS 'EXECUTION_LIBRARY', 'pg_laplace_content_terms'
    LANGUAGE C STABLE STRICT PARALLEL SAFE;
