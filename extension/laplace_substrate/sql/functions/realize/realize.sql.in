-- NO `SET search_path` (GH #860, #617 item 6). realize.realize() is the per-row labeling
-- scalar of the entire read path -- every arrow realize.render, every relation listing,
-- every reply. The clause made SQL inlining impossible, so each row paid a full
-- function execution for what is a COALESCE over four cheap resolvers.
--
-- GH #862: realize.realize, with its five resolvers as same-schema siblings.
CREATE OR REPLACE FUNCTION realize.realize(p_id bytea, p_lang bytea DEFAULT NULL)
    RETURNS text
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    -- realize.resolve_name() is the single, referentially-correct name primitive: it
    -- folds the former realize._has_name(HAS_NAME primary + HAS_NAME_ALIAS) and
    -- _realize_synset_lemma into one family-aware, abstaining resolver. It replaces
    -- the two separate arms this function used to run (synset-lemma first, HAS_NAME
    -- buried after translation); now the authoritative NAME wins ahead of a
    -- rendered self or a translation guess. The remaining arms stay as realize's
    -- own display fallbacks (raw realize.render, translation, canonical id, gloss).
    SELECT COALESCE(
        realize.resolve_name(p_id, p_lang),
        NULLIF(realize.render_text(p_id, 24), ''),
        realize._translation(p_id, p_lang),
        realize._canonical(p_id),
        realize._defines(p_id))
$$;
