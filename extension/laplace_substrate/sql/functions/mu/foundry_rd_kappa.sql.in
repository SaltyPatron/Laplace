-- rd-uncertainty discount rate for walk and foundry plane weights, applied as
-- exp(-kappa * rd_in_rating_units); rd arrives fp1e9 so callers pass
-- rd::float8 / 1e9.
--
-- DERIVED, never tuned: kappa = 1 / initial_rd, so the decay is
-- exp(-rd / rd_initial) -- dimensionless in the substrate's own
-- maximum-uncertainty scale. A claim still at initial rd (nothing has narrowed
-- it) decays to e^-1; a converged claim (rd -> 0) does not decay. Moving
-- consensus.glicko2_initial_rd() moves this by construction, so the two cannot
-- drift.
DROP FUNCTION IF EXISTS laplace.foundry_rd_kappa();
CREATE OR REPLACE FUNCTION consensus.foundry_rd_kappa()
    RETURNS double precision LANGUAGE sql LAPLACE_IMMUTABLE AS $$
    SELECT 1e9::double precision / consensus.glicko2_initial_rd()::double precision
$$;
