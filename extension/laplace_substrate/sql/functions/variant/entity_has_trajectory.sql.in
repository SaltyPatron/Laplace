DROP FUNCTION IF EXISTS laplace.entity_has_trajectory(bytea);
CREATE OR REPLACE FUNCTION generation.entity_has_trajectory(p_entity bytea)
    RETURNS boolean
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT CASE WHEN p_entity IS NULL THEN NULL::boolean
                ELSE EXISTS (
                    SELECT 1 FROM laplace.physicalities p
                    WHERE p.entity_id = p_entity AND p.type = 1 AND p.trajectory IS NOT NULL
                )
           END;
END;
