-- consensus.salient_facts(word, lang, k): what is witnessed about a word, read through
-- the forward-pass primitives. A fact belongs to the key it was stated about, so the
-- word's facts are its own plus those of its dominant binding (usage, then standing,
-- in the query's language) -- never every sense's facts poured into one list.
-- Objects are realized in the query's language (the terms' binding language when the
-- caller states none).
CREATE OR REPLACE FUNCTION consensus.salient_facts(p_word bytea, p_lang bytea DEFAULT NULL,
                                    p_limit int DEFAULT 24)
    RETURNS TABLE(type text, fact text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH lang AS MATERIALIZED (
        SELECT COALESCE(p_lang, converse.terms_language(ARRAY[p_word])) AS l
    ), keys AS (
        SELECT p_word AS key
        UNION
        SELECT b.key FROM lang, converse.bindings(ARRAY[p_word], lang.l) b WHERE b.rank = 1
    ), f AS MATERIALIZED (
        SELECT kf.*, row_number() OVER (ORDER BY kf.eff_mu DESC, kf.type_id, kf.object_id) AS ord
        FROM converse.key_facts(ARRAY(SELECT key FROM keys), GREATEST(p_limit, 0)) kf
        ORDER BY kf.eff_mu DESC, kf.type_id, kf.object_id
        LIMIT GREATEST(p_limit, 0)
    ), labels AS (
        SELECT ARRAY(SELECT lp_l.content FROM unnest((array_agg(f.object_id ORDER BY f.ord))::bytea[]) WITH ORDINALITY lp_u(x,n) LEFT JOIN (SELECT DISTINCT ON (lp_d.entity) lp_d.entity,lp_d.content FROM public.laplace_labels(array_remove((array_agg(f.object_id ORDER BY f.ord))::bytea[],NULL)::public.blake3[]) lp_d) lp_l ON lp_l.entity=lp_u.x::public.blake3 ORDER BY lp_u.n) AS l,
               ARRAY(SELECT lp_l.content FROM unnest((array_agg(f.type_id ORDER BY f.ord))::bytea[]) WITH ORDINALITY lp_u(x,n) LEFT JOIN (SELECT DISTINCT ON (lp_d.entity) lp_d.entity,lp_d.content FROM public.laplace_labels(array_remove((array_agg(f.type_id ORDER BY f.ord))::bytea[],NULL)::public.blake3[]) lp_d) lp_l ON lp_l.entity=lp_u.x::public.blake3 ORDER BY lp_u.n) AS types
        FROM f
    )
    SELECT COALESCE(NULLIF(labels.types[f.ord], ''), 'Unrealized relation'),
           COALESCE(NULLIF(labels.l[f.ord], ''), 'Entity · ' || left(encode(f.object_id, 'hex'), 12)),
           f.eff_mu, f.witnesses
    FROM f, labels
    ORDER BY f.ord;
END;
