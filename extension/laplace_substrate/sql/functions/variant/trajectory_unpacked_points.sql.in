DROP FUNCTION IF EXISTS laplace.trajectory_unpacked_points(bytea);
CREATE OR REPLACE FUNCTION generation.trajectory_unpacked_points(p_entity bytea)
    RETURNS TABLE(entity_id bytea, run_length int, ctier int)
    LANGUAGE sql STABLE PARALLEL SAFE
    -- MEASURED, not guessed. One call returns the points of ONE trajectory:
    -- mean 5.93, max 15 over 500 sampled type=1 trajectories, and 3.47 actual
    -- per loop in situ under auto_explain in compose_batch. Undeclared, Postgres
    -- assumes 1000 -- ~170x high -- and that estimate is what pushed this body's
    -- plan over parallel_setup_cost and gave every call its own Gather Merge.
    -- Only 6 set-returning functions in this surface declare a real ROWS; the
    -- rest ship the 1000 default and mis-plan their callers the same way.
    ROWS 6
 AS $$
    -- THE PHYSICALITIES LOOKUP IS FENCED IN A CTE, NOT JOINED INTO THE UNPACK.
    --
    -- physicalities is HASH (id) and this lookup is by entity_id -- an independent
    -- content hash, not derivable from entity_id -- so its 64-way Append cannot prune.
    -- Joined directly into the unpack, that Append multiplies against ST_DumpPoints'
    -- declared 1000 rows (procost 5000): the body planned at cost 983,329, over
    -- parallel_setup_cost, so EVERY call paid Gather Merge worker startup to return a
    -- measured 3.47 rows.
    --
    -- MATERIALIZED here is an optimisation fence, not a value carrier: the Append runs
    -- once and the 1000-row estimate multiplies against its result instead of against
    -- 64 partitions. (Reading a bound ARRAY back from a CTE column is the opposite
    -- case and is forbidden -- it makes a constant into a per-row variable and kills
    -- pruning. See realize.resolve_name.)
    --   joined            cost 983,329, Gather Merge, 37.7 ms/call
    --   fenced            cost   8,012, no Gather,     6.2 ms/call
    --
    -- ORDER BY u.ordinal is the contract: every caller applies WITH ORDINALITY and
    -- takes the position as the sequence. It is not decoration.
    WITH traj AS MATERIALIZED (
        SELECT p.trajectory
        FROM laplace.physicalities p
        WHERE p.entity_id = p_entity AND p.type = 1 AND p.trajectory IS NOT NULL
    )
    SELECT u.entity_id,
           GREATEST(u.run_length, 1)::int AS run_length,
           COALESCE(
               -- tier is a FLOOR, not identity: one id may hold rows at several
               -- tiers (UD mints single-word sentences), so a bare scalar lookup
               -- multi-rows (21000). The floor IS min(tier).
               (SELECT min(e.tier) FROM laplace.entities e WHERE e.id = u.entity_id),
               CASE WHEN realize.codepoint_for_id(u.entity_id) IS NOT NULL THEN 0 END
           ) AS ctier
    FROM traj,
    LATERAL public.ST_DumpPoints(traj.trajectory) dp,
    LATERAL public.laplace_mantissa_unpack(dp.geom) u
    ORDER BY u.ordinal
$$;
