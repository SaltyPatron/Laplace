<Project>
  <Import Project="../scripts/win/machine-env.props" Condition="'$(OS)' == 'Windows_NT'" />
  <!--
    Build outputs follow the installed machine declaration (see scripts/win/machine-env.props).
    LAPLACE_BUILD_ROOT defaults on Windows so bare `dotnet build`/IDE builds land in the
    same tree as env.cmd-driven script builds.
  -->
  <!-- Shared compiler settings for every project under app/. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <LAPLACE_ENGINE_BUILD Condition="'$(LAPLACE_ENGINE_BUILD)' == '' AND '$(OS)' == 'Windows_NT'">$(LAPLACE_BUILD_ROOT)\build-win</LAPLACE_ENGINE_BUILD>
    <LAPLACE_ENGINE_BUILD Condition="'$(LAPLACE_ENGINE_BUILD)' == ''">$(MSBuildThisFileDirectory)../build/engine</LAPLACE_ENGINE_BUILD>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LAPLACE_BUILD_ROOT)' != ''">
    <BaseOutputPath>$(LAPLACE_BUILD_ROOT)\app\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(LAPLACE_BUILD_ROOT)\app\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Never compile leftovers from a previous in-repo output layout. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <!--
    Tier=db is included by default. DB-tier tests create their fixture state and
    may depend on PostgreSQL, but not on a particular seeded product corpus.

    Tier=live is intentionally different: it exercises the standing shared substrate
    and may require foundation/content seeds or deposit durable product episodes.
    Those are explicit product acceptance probes, not unit/database-health tests, so a
    bare `dotnet test` does not run them accidentally during recreate/reseed work.

    Tier=perf also stays explicit because a throughput threshold on a busy self-hosted
    runner measures ambient machine load as much as code.

    Category=RequiresQualification covers full corpus estates and installed model
    checkpoints. It also stays explicit: mounting local data must not turn a normal
    development test run into a full-corpus qualification.

    Explicit filters still override the default:

      dotnet test /p:VSTestTestCaseFilter="Tier=db"    run DB-backed tests
      dotnet test /p:VSTestTestCaseFilter="Tier=live"  run seeded/shared product smokes
      dotnet test /p:VSTestTestCaseFilter="Tier=perf"  run performance tests intentionally
      dotnet test /p:VSTestTestCaseFilter="Category=RequiresQualification"  run corpus/model qualification
      dotnet test /p:VSTestTestCaseFilter=""           run absolutely everything
  -->
  <!-- IsTestProject is set by the test SDK, which imports AFTER this file, so it
       is empty here; key off the project name, which is known immediately. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) AND '$(VSTestTestCaseFilter)' == ''">
    <VSTestTestCaseFilter>Tier!=perf&amp;Tier!=live&amp;Category!=RequiresQualification</VSTestTestCaseFilter>
  </PropertyGroup>
  <ItemGroup>
    <!-- Outputs live outside the repo, so tests can no longer find the repo
         root by walking up from their own binary — stamp it instead. -->
    <AssemblyMetadata Include="LaplaceRepoRoot"
                      Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))" />
  </ItemGroup>
  <!--
    Copy candidate native libraries beside the managed test binary so it loads
    the selected build instead of the installed /opt/laplace/lib copy:
    .NET probes NATIVE_DLL_SEARCH_DIRECTORIES, which includes the app base
    directory, BEFORE handing off to the OS loader — so an app-local copy wins
    over /opt/laplace/lib without touching a shared path.

    Persistent outputs must follow native content even when a rebuilt library has
    an older timestamp. The shared synchronizer compares bytes and preserves the
    versioned symlink chain. SDK copy items dereference those aliases into full
    copies and rewrite unchanged libraries on every managed build.

    Ship the same closure with executable publishes as well. If integration fails
    after the shared engine is installed, restore-api must not start an old managed
    layout against a new native ABI. App-local native libraries keep the previous
    published payload coherent until the next complete publish.
  -->
  <!--
    A managed-only plan (LAPLACE_REUSE_INSTALLED_NATIVE=1) builds no native tree: its
    native closure is the installed, qualified one it will be published beside, the same
    source scripts/sync-managed-native-artifacts.sh uses. The build itself needs it too:
    OpenAPI generation starts the endpoint host, whose static vocabularies load the core.
  -->
  <PropertyGroup>
    <LAPLACE_INSTALL_PREFIX Condition="'$(LAPLACE_INSTALL_PREFIX)' == ''">/opt/laplace</LAPLACE_INSTALL_PREFIX>
  </PropertyGroup>
  <ItemGroup Condition="'$(OS)' != 'Windows_NT' AND '$(LAPLACE_REUSE_INSTALLED_NATIVE)' == '1'">
    <LaplaceNativeArtifact Include="$(LAPLACE_INSTALL_PREFIX)/lib/liblaplace_core.so*" />
    <LaplaceNativeArtifact Include="$(LAPLACE_INSTALL_PREFIX)/lib/liblaplace_syzygy.so*" />
    <LaplaceNativeArtifact Include="$(LAPLACE_INSTALL_PREFIX)/lib/liblaplace_dynamics.so*" />
    <LaplaceNativeArtifact Include="$(LAPLACE_INSTALL_PREFIX)/lib/liblaplace_synthesis.so*" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <LaplaceNativeArtifact Condition="'$(LAPLACE_REUSE_INSTALLED_NATIVE)' != '1'" Include="$(LAPLACE_ENGINE_BUILD)/core/*.so*" />
    <LaplaceNativeArtifact Condition="'$(LAPLACE_REUSE_INSTALLED_NATIVE)' != '1'" Include="$(LAPLACE_ENGINE_BUILD)/dynamics/*.so*" />
    <LaplaceNativeArtifact Condition="'$(LAPLACE_REUSE_INSTALLED_NATIVE)' != '1'" Include="$(LAPLACE_ENGINE_BUILD)/synthesis/*.so*" />
  </ItemGroup>
</Project>
