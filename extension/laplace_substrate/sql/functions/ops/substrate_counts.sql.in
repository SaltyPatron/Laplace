-- Row-count census of the four substrate relations.
DROP FUNCTION IF EXISTS laplace.substrate_counts();

CREATE OR REPLACE FUNCTION ops.substrate_counts()
    RETURNS TABLE(metric text, value bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    -- Planner estimates (pg_class.reltuples summed over leaves), never count(*):
    -- a partitioned parent can keep reltuples = -1 while its leaves hold rows.
    -- ANALYZE bounds the error; ops.evidence_count() gives exact per-source counts.
    WITH targets(metric, relid, ordinal) AS (
        VALUES
            ('entities(ESTIMATE)'::text,      'laplace.entities'::regclass,      1),
            ('physicalities(ESTIMATE)'::text, 'laplace.physicalities'::regclass, 2),
            ('attestations(ESTIMATE)'::text,  'laplace.attestations'::regclass,  3),
            ('consensus(ESTIMATE)'::text,     'laplace.consensus'::regclass,     4)
    )
    SELECT t.metric, COALESCE(sum(GREATEST(c.reltuples, 0)::bigint), 0)::bigint
    FROM targets t
    CROSS JOIN LATERAL pg_partition_tree(t.relid) p
    JOIN pg_class c ON c.oid = p.relid
    WHERE p.isleaf
    GROUP BY t.metric, t.ordinal
    ORDER BY t.ordinal;
END;
