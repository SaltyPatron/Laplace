-- chess.syzygy_line(line): the exact endgame oracle along one line.
--
-- Current packages are material graphs of exact position -> typed move -> position
-- trajectories.  chess.syzygy_transition performs the indexed graph lookup.  The
-- legacy attestation branch keeps already-seeded v2 data readable while a clean seed
-- writes the compact graph.
--
-- WDL is five-valued and SIDE-TO-MOVE POV, not white POV: 'win' means the player to
-- move in that position wins with perfect play. It is never mixed with the OUTCOME
-- fold's white-POV consensus.eff_mu, which is why this returns the token rather than a number.
--
-- Typed accessors below own the single laplace.relation_type_id('…') literals for this
-- vocabulary (ISA G3). New chess SQL must call these — never re-type the strings.
DROP FUNCTION IF EXISTS laplace.chess_has_wdl_type();
CREATE OR REPLACE FUNCTION chess.has_wdl_type() RETURNS bytea
    LANGUAGE sql STABLE PARALLEL SAFE
 AS $$
    SELECT laplace.relation_type_id('HAS_WDL')
$$;

DROP FUNCTION IF EXISTS laplace.chess_has_dtz_type();
CREATE OR REPLACE FUNCTION chess.has_dtz_type() RETURNS bytea
    LANGUAGE sql STABLE PARALLEL SAFE
 AS $$
    SELECT laplace.relation_type_id('HAS_DTZ')
$$;

DROP FUNCTION IF EXISTS laplace.chess_syzygy_line(bytea, int);
CREATE OR REPLACE FUNCTION chess.syzygy_line(p_line bytea, p_limit int DEFAULT 64)
    RETURNS TABLE(position_id bytea, wdl text, dtz text)
    LANGUAGE sql STABLE
 AS $$
WITH rel AS MATERIALIZED (
    SELECT chess.has_wdl_type() AS wdl, chess.has_dtz_type() AS dtz
),
line AS MATERIALIZED (
    SELECT u.ord AS ordinal, u.entity_id AS pos
    FROM LATERAL generation.trajectory_unpacked_points(p_line, 3::smallint)
         WITH ORDINALITY AS u(entity_id, run_length, ctier, ord)
),
compact AS MATERIALIZED (
    SELECT l.pos,
           t.wdl,
           t.dtz,
           min(l.ordinal) AS ord
    FROM line l
    CROSS JOIN LATERAL chess.syzygy_transition(l.pos) t
    GROUP BY l.pos, t.wdl, t.dtz
),
legacy AS MATERIALIZED (
    SELECT l.pos,
           max(a.object_id) FILTER (WHERE a.type_id = r.wdl) AS wdl_id,
           max(a.object_id) FILTER (WHERE a.type_id = r.dtz) AS dtz_id,
           min(l.ordinal) AS ord
    FROM line l
    JOIN rel r ON true
    JOIN laplace.attestations a ON a.subject_id = l.pos
                       AND a.type_id IN (r.wdl, r.dtz)
    GROUP BY l.pos
    HAVING max(a.object_id) FILTER (WHERE a.type_id = r.wdl) IS NOT NULL
),
chosen AS MATERIALIZED (
    SELECT c.pos,
           c.wdl,
           c.dtz::text AS dtz,
           NULL::bytea AS wdl_id,
           NULL::bytea AS dtz_id,
           c.ord
    FROM compact c
    UNION ALL
    SELECT l.pos,
           NULL::integer,
           NULL::text,
           l.wdl_id,
           l.dtz_id,
           l.ord
    FROM legacy l
    WHERE NOT EXISTS (SELECT 1 FROM compact c WHERE c.pos = l.pos)
    ORDER BY ord
    LIMIT p_limit
),
surfaces AS MATERIALIZED (
    SELECT COALESCE(array_agg(DISTINCT s), '{}'::bytea[]) AS ids
    FROM chosen o, LATERAL (VALUES (o.wdl_id), (o.dtz_id)) v(s)
    WHERE s IS NOT NULL
),
label AS MATERIALIZED (
    SELECT p.id, p.txt
    FROM surfaces b,
         LATERAL ROWS FROM (
             unnest(b.ids), unnest(realize.batch(b.ids, NULL))
         ) AS p(id, txt)
)
SELECT o.pos,
       COALESCE(
           CASE o.wdl
               WHEN 0 THEN 'loss'
               WHEN 1 THEN 'blessed-loss'
               WHEN 2 THEN 'draw'
               WHEN 3 THEN 'cursed-win'
               WHEN 4 THEN 'win'
           END,
           w.txt),
       COALESCE(o.dtz, d.txt)
FROM chosen o
LEFT JOIN label w ON w.id = o.wdl_id
LEFT JOIN label d ON d.id = o.dtz_id
ORDER BY o.ord
$$;
