DROP FUNCTION IF EXISTS laplace.laplace_glicko2_accumulate_games(
    bigint, bigint, bigint, bigint, bigint, bigint, bigint, bigint);

CREATE OR REPLACE FUNCTION laplace.laplace_glicko2_accumulate_period(
    prior_rating     bigint,
    prior_rd         bigint,
    prior_volatility bigint,
    opponent_ratings bigint[],
    opponent_rds     bigint[],
    games            bigint[],
    sum_scores       bigint[],
    tau              bigint
) RETURNS laplace_glicko2_result
    AS 'MODULE_PATHNAME', 'pg_laplace_glicko2_accumulate_period'
    LANGUAGE C IMMUTABLE;
