-- evict_source: retract one source's testimony and refold what it touched.
-- The source is the evictable unit: attestations carry no version, and
-- completion state gates each lane to one derivation, so eviction is the
-- version transition; re-running the lane re-derives what the cleared
-- completions gated.
--
-- Order of work, each step committed before the next can lose it:
--   replay tokens owned by the source are deleted, then its unit/layer
--   completion rows, then its operational (admission-receipt) rows; then per
--   relation, per batch, in one transaction:
--   (a) DELETE a batch of the source's evidence under the relation (a literal
--       type in EXECUTE so the plan is not generic), queue every touched
--       endpoint into highway_mask_dirty, and collect the touched cells.
--   (b) REFOLD each touched cell in place from its SURVIVING evidence through
--       the consensus_fold aggregate, the SQL face of the native fold ingest
--       runs, from the neutral prior: all surviving rows form one rating period
--       from their persisted opponent ratings/RDs, observation counts, and
--       score sums. (last_observed_at, id) is a deterministic traversal, not a
--       reconstruction of original period boundaries; the contract is the
--       grouped fold of surviving evidence, not bit parity with history.
--   (c) DELETE cells with zero surviving evidence, never zero them: absence is
--       not refutation.
--   (d) With p_drain, highway_mask_drain recomputes queued masks from scratch,
--       which can clear bits that inline deposit only ever sets.
-- Entities and physicalities are never deleted: content is source-independent
-- and geometry is a deterministic function of constituents, not testimony.
--
-- p_relations NULL discovers the source's relations per attestations leaf.
-- A source with no rows is a no-op. Resumable: each batch commits evidence
-- deletion and its refold together, so re-running an interrupted eviction
-- ends in the state one run would. No SET clause: a procedure carrying one
-- cannot COMMIT; references are schema-qualified.
-- Invoke with: CALL ops.evict_source(laplace.source_id('ChessAnalysis'));
DROP PROCEDURE IF EXISTS laplace.evict_source(bytea, bytea[], bytea[], int, boolean);

CREATE OR REPLACE PROCEDURE ops.evict_source(
    p_source       bytea,
    p_relations    bytea[] DEFAULT NULL,
    p_marker_types bytea[] DEFAULT NULL,
    p_batch        int     DEFAULT 100000,
    p_drain        boolean DEFAULT true)
    LANGUAGE plpgsql AS $$
DECLARE
    rels           bytea[];
    operational_types bytea[];
    operational_total bigint := 0;
    rel            bytea;
    leaf           oid;
    leaf_types     bytea[];
    t              bytea;
    n_del          bigint;
    n_cells        bigint;
    n              bigint;
    evidence_total bigint := 0;
    refold_total   bigint := 0;
    culled_total   bigint := 0;
    layer_completion_total bigint := 0;
    unit_completion_total  bigint := 0;
    replay_total   bigint := 0;
    t0             timestamptz := clock_timestamp();
BEGIN
    -- Plain TEMP table (per-batch COMMIT would drop ON COMMIT DROP), truncated
    -- per batch and dropped at the end.
    CREATE TEMP TABLE IF NOT EXISTS _evict_cells (
        subject_id bytea NOT NULL,
        object_id  bytea,
        consensus_leaf oid NOT NULL,
        UNIQUE NULLS NOT DISTINCT (subject_id, object_id));
    TRUNCATE _evict_cells;
    -- A session's existing temp table may lack consensus_leaf; add it once.
    IF NOT EXISTS (
        SELECT 1
        FROM pg_attribute a
        WHERE a.attrelid = 'pg_temp._evict_cells'::regclass
          AND a.attname = 'consensus_leaf'
          AND NOT a.attisdropped
    ) THEN
        ALTER TABLE _evict_cells ADD COLUMN consensus_leaf oid;
    END IF;
    ALTER TABLE _evict_cells
        ALTER COLUMN consensus_leaf SET NOT NULL;
    CREATE INDEX IF NOT EXISTS _evict_cells_leaf_idx
        ON _evict_cells (consensus_leaf);

    IF p_relations IS NOT NULL THEN
        rels := p_relations;
    ELSE
        -- Discover the source's relations per attestations leaf: DISTINCT
        -- type_id in a leaf with a DEFAULT-bound ancestor, otherwise a single
        -- indexed LIMIT-1 probe. The ancestor check matters because a leaf's
        -- own bound is its HASH bound, not an ancestor's DEFAULT.
        rels := ARRAY[]::bytea[];
        FOR leaf IN
            SELECT pt.relid
            FROM pg_extension e
            JOIN pg_namespace ns ON ns.oid = e.extnamespace
            CROSS JOIN LATERAL pg_partition_tree(
                (quote_ident(ns.nspname) || '.attestations')::regclass) pt
            WHERE e.extname = 'laplace_substrate' AND pt.isleaf
        LOOP
            IF EXISTS (
                SELECT 1
                FROM pg_partition_ancestors(leaf::regclass) pa
                JOIN pg_class c ON c.oid = pa.relid
                WHERE pg_get_expr(c.relpartbound, c.oid) = 'DEFAULT'
            ) THEN
                EXECUTE format(
                    'SELECT COALESCE(array_agg(DISTINCT a.type_id), ARRAY[]::bytea[]) '
                    'FROM %s a WHERE a.source_id = $1', leaf::regclass)
                INTO leaf_types USING p_source;
            ELSE
                EXECUTE format(
                    'SELECT ARRAY(SELECT a.type_id FROM %s a WHERE a.source_id = $1 LIMIT 1)',
                    leaf::regclass)
                INTO leaf_types USING p_source;
            END IF;
            FOREACH t IN ARRAY leaf_types LOOP
                IF NOT (t = ANY(rels)) THEN
                    rels := rels || t;
                END IF;
            END LOOP;
        END LOOP;
    END IF;

    -- Operational relation types (the writer's admission receipts) carry no
    -- rating observations and are retracted separately below.
    operational_types := ARRAY[realize.canonical_id('substrate/type/HasFileMetadata/v1')];

    SELECT COALESCE(array_agg(candidate ORDER BY ordinal), ARRAY[]::bytea[]) INTO rels
    FROM unnest(rels) WITH ORDINALITY AS selected(candidate, ordinal)
    WHERE NOT (candidate = ANY(operational_types));

    RAISE LOG 'evict_source: start — source %, % relation(s)',
        encode(p_source, 'hex'), COALESCE(cardinality(rels), 0);

    -- A cell carrying a transient-calibration receipt cannot be refolded: its
    -- continuous score was never persisted. Refuse before the first DELETE.
    IF EXISTS (
        SELECT 1
        FROM laplace.attestations source_evidence
        JOIN laplace.attestations transient_evidence
          ON transient_evidence.type_id = source_evidence.type_id
         AND transient_evidence.subject_id = source_evidence.subject_id
         AND transient_evidence.object_id IS NOT DISTINCT FROM source_evidence.object_id
        WHERE source_evidence.source_id = p_source
          AND transient_evidence.fold_replayable = false
    ) THEN
        RAISE EXCEPTION 'evict_source: source % touches transient-calibration evidence; no score replay exists',
            encode(p_source, 'hex');
    END IF;

    -- Replay tokens are applied source state; left in place they would make a
    -- re-derive a no-op. Deleted first, so an interrupted eviction can re-admit
    -- every row removed so far. Tokens with no owning source are not touched.
    DELETE FROM laplace.ingest_flush_journal receipt
    WHERE receipt.source_id = p_source
       OR EXISTS (
           SELECT 1
           FROM laplace.ingest_flush_journal_sources owner
           WHERE owner.working_set_id = receipt.working_set_id
             AND owner.source_id = p_source);
    GET DIAGNOSTICS replay_total = ROW_COUNT;
    IF replay_total > 0 THEN COMMIT; END IF;

    -- Completion belongs to the witness; any retraction invalidates it, even a
    -- partial one. Committed before the first evidence deletion, so no
    -- completion row can hide partially retracted output.
    DELETE FROM laplace.ingest_unit_completion WHERE witness_id = p_source;
    GET DIAGNOSTICS unit_completion_total = ROW_COUNT;
    DELETE FROM laplace.ingest_layer_completion WHERE witness_id = p_source;
    GET DIAGNOSTICS layer_completion_total = ROW_COUNT;
    IF unit_completion_total > 0 OR layer_completion_total > 0 THEN COMMIT; END IF;

    -- Operational rows owned by the source are retracted whatever p_relations
    -- selects; they have no fold.
    LOOP
        WITH pick AS (
            SELECT a.id, a.type_id, a.subject_id
            FROM laplace.attestations a
            WHERE a.source_id = p_source AND a.type_id = ANY(operational_types)
            LIMIT p_batch),
        del AS (
            DELETE FROM laplace.attestations a
            USING pick
            WHERE a.id = pick.id AND a.type_id = pick.type_id
              AND a.subject_id = pick.subject_id
            RETURNING 1)
        SELECT count(*) INTO n FROM del;
        EXIT WHEN n = 0;
        operational_total := operational_total + n;
        COMMIT;
    END LOOP;
    IF operational_total > 0 THEN
        RAISE LOG 'evict_source: % owned operational row(s) removed', operational_total;
    END IF;

    FOREACH rel IN ARRAY COALESCE(rels, ARRAY[]::bytea[]) LOOP
        LOOP
            TRUNCATE _evict_cells;

            -- (a) delete one batch of the source's evidence under this relation;
            --     queue every touched entity for mask repair; accumulate the
            --     touched cells for the refold below.
            EXECUTE format($q$
                WITH pick AS (
                    SELECT a.id, a.subject_id
                    FROM laplace.attestations a
                    WHERE a.type_id = %L::bytea AND a.source_id = $1
                    LIMIT %s),
                del AS (
                    DELETE FROM laplace.attestations a
                    USING pick
                    WHERE a.type_id = %L::bytea
                      AND a.id = pick.id AND a.subject_id = pick.subject_id
                    RETURNING a.subject_id, a.object_id),
                dirty AS (
                    INSERT INTO laplace.highway_mask_dirty (id)
                    SELECT DISTINCT u.id
                    FROM (SELECT d.subject_id AS id FROM del d
                          UNION
                          SELECT d.object_id FROM del d WHERE d.object_id IS NOT NULL) u
                    ON CONFLICT (id) DO NOTHING),
                cells AS (
                    INSERT INTO _evict_cells (subject_id, object_id, consensus_leaf)
                    SELECT DISTINCT d.subject_id, d.object_id,
                           consensus.partition_leaf(%L::bytea, d.subject_id)::oid
                    FROM del d
                    ON CONFLICT DO NOTHING
                    RETURNING 1)
                SELECT (SELECT count(*) FROM del), (SELECT count(*) FROM cells)
            $q$, rel, p_batch, rel, rel)
            INTO n_del, n_cells
            USING p_source;

            EXIT WHEN n_del = 0;
            evidence_total := evidence_total + n_del;

            -- (b) refold each touched cell in place from surviving evidence:
            --     one grouped period, neutral-prior seed.
            EXECUTE format($q$
                INSERT INTO laplace.consensus AS c
                    (id, subject_id, type_id, object_id,
                     rating, rd, volatility, witness_count, last_observed_at)
                SELECT laplace.consensus_id(f.subject_id, %L::bytea, f.object_id),
                       f.subject_id, %L::bytea, f.object_id,
                       (f.acc).rating, (f.acc).rd, (f.acc).volatility,
                       (f.acc).witness_count, f.last_ts
                FROM (
                    SELECT t.subject_id, t.object_id,
                           laplace.consensus_fold(false, NULL, NULL, NULL,
                               a.opponent_rating_fp1e9,
                               a.opponent_rd_fp1e9,
                               GREATEST(a.observation_count, 1),
                               a.sum_score_fp1e9,
                               consensus.glicko2_tau()
                               ORDER BY a.last_observed_at, a.id) AS acc,
                           max(a.last_observed_at) AS last_ts
                    FROM _evict_cells t
                    JOIN laplace.attestations a
                      ON a.type_id = %L::bytea
                     AND a.subject_id = t.subject_id
                     AND a.object_id IS NOT DISTINCT FROM t.object_id
                    GROUP BY t.subject_id, t.object_id
                ) f
                ON CONFLICT (id, type_id, subject_id) DO UPDATE
                SET object_id        = EXCLUDED.object_id,
                    rating           = EXCLUDED.rating,
                    rd               = EXCLUDED.rd,
                    volatility       = EXCLUDED.volatility,
                    witness_count    = EXCLUDED.witness_count,
                    last_observed_at = EXCLUDED.last_observed_at
            $q$, rel, rel, rel);
            GET DIAGNOSTICS n = ROW_COUNT;
            refold_total := refold_total + n;

            -- (c) zero-survivor cells are DELETED, not zeroed.
            FOR leaf IN
                SELECT DISTINCT consensus_leaf FROM _evict_cells
            LOOP
                EXECUTE format($q$
                    DELETE FROM ONLY %s c
                    USING _evict_cells t
                    WHERE t.consensus_leaf = %s::oid
                      AND c.type_id = %L::bytea
                      AND c.subject_id = t.subject_id
                      AND c.id = laplace.consensus_id(t.subject_id, %L::bytea, t.object_id)
                      AND NOT EXISTS (
                          SELECT 1 FROM laplace.attestations a
                          WHERE a.type_id = %L::bytea
                            AND a.subject_id = t.subject_id
                            AND a.object_id IS NOT DISTINCT FROM t.object_id)
                $q$, leaf::regclass, leaf, rel, rel, rel);
                GET DIAGNOSTICS n = ROW_COUNT;
                culled_total := culled_total + n;
            END LOOP;

            RAISE LOG 'evict_source: relation % — batch of % evidence row(s) over % cell(s) (running: % deleted, % refolded, % culled) — %s elapsed',
                encode(rel, 'hex'), n_del, n_cells,
                evidence_total, refold_total, culled_total,
                round(extract(epoch FROM clock_timestamp() - t0)::numeric, 1);
            COMMIT;
        END LOOP;
    END LOOP;



    -- (d) drain the mask-repair queue: refresh recomputes from scratch and can
    -- clear bits.
    IF p_drain THEN
        CALL laplace.highway_mask_drain(p_batch);
    END IF;

    RAISE LOG 'evict_source: done — source %: % evidence row(s) deleted, % cell(s) refolded, % cell(s) culled, % layer completion(s) removed, % unit completion(s) removed, % replay claim(s) removed in %s',
        encode(p_source, 'hex'), evidence_total, refold_total, culled_total,
        layer_completion_total, unit_completion_total, replay_total,
        round(extract(epoch FROM clock_timestamp() - t0)::numeric, 1);

    DROP TABLE _evict_cells;
END $$;
