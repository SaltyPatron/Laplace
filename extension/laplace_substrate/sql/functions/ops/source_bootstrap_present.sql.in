-- Positive control for the roster's bootstrap filter (#760): does this source
-- carry its relation-law bootstrap rows? The writer emits name-alias rows
-- whose subjects are relation-type ids. The law relation arrives as an id
-- parameter — vocabulary is the caller's declaration (G3: no relation-name
-- literals in SQL bodies) — so the probe prunes to that type's partition and
-- walks only the source's rows there; EXISTS short-circuits on the first
-- bootstrap row; no renders, no per-row scan of content partitions.
DROP FUNCTION IF EXISTS source_bootstrap_present(bytea);
CREATE OR REPLACE FUNCTION source_bootstrap_present(p_source bytea, p_law_type bytea)
    RETURNS boolean
    LANGUAGE sql STABLE
    SET search_path = @extschema@, public AS $$
    SELECT EXISTS (
        SELECT 1
        FROM attestations
        WHERE type_id = p_law_type
          AND source_id = p_source
          AND relation_canonical(subject_id) IS NOT NULL)
$$;
