-- Live totals plus the ingest heartbeat, cheap enough to poll every few
-- seconds: estimate counts, a PK scan of the flush journal, and one
-- pg_stat_activity pass. Every surface's pulse reads this.
DROP FUNCTION IF EXISTS laplace.substrate_pulse();

CREATE OR REPLACE FUNCTION ops.substrate_pulse()
    RETURNS TABLE(entities bigint, attestations bigint, consensus bigint,
                  physicalities bigint, last_flush_at timestamptz,
                  flushes_last_min bigint, folding boolean)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT
      (SELECT value FROM ops.substrate_counts() WHERE metric = 'entities(ESTIMATE)'),
      (SELECT value FROM ops.substrate_counts() WHERE metric = 'attestations(ESTIMATE)'),
      (SELECT value FROM ops.substrate_counts() WHERE metric = 'consensus(ESTIMATE)'),
      (SELECT value FROM ops.substrate_counts() WHERE metric = 'physicalities(ESTIMATE)'),
      (SELECT max(applied_at) FROM laplace.ingest_flush_journal),
      (SELECT count(*) FROM laplace.ingest_flush_journal
        WHERE applied_at > now() - interval '60 seconds'),
      -- Folding = rows landed recently OR a fold/apply backend is active:
      -- committed work is the flush journal, in-flight work is observed in
      -- pg_stat_activity. pg_backend_pid() is excluded because this query's own
      -- text contains the patterns it matches.
      (SELECT (SELECT max(applied_at) FROM laplace.ingest_flush_journal) > now() - interval '20 seconds')
        OR EXISTS (
          SELECT 1 FROM pg_stat_activity a
          WHERE a.datname = current_database()
            AND a.state = 'active'
            AND a.pid <> pg_backend_pid()
            AND a.query ILIKE ANY (ARRAY[
              '%attestation_merge%',
              '%consensus_upsert%',
              '%consensus.upsert_type%',
              '%highway_mask_deposit%',
              '%COPY %laplace.%'
            ]));
END;
