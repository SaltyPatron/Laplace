CREATE OR REPLACE FUNCTION realize.constituents(p_id bytea)
    RETURNS TABLE(ordinal integer, child_id bytea, run_length integer, flags bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH native AS MATERIALIZED (
        SELECT c.ordinal, public.blake3_send(c.child) AS child_id, c.run_length, c.flags
        FROM public.laplace_constituents(ARRAY[public.blake3_from_bytea(p_id)]) c
    )
    SELECT * FROM native
    UNION ALL
    SELECT u.ordinal, u.entity_id, u.run_length, u.flags
    FROM (
        SELECT p.trajectory AS traj
        FROM laplace.physicalities p
        WHERE p.entity_id = p_id AND p.type = 1 AND p.trajectory IS NOT NULL
          AND NOT EXISTS (SELECT 1 FROM native)
        ORDER BY p.id
        LIMIT 1
    ) t
    CROSS JOIN LATERAL public.laplace_trajectory_constituents(t.traj) AS u
    ORDER BY 1;
END;
