-- converse.resolve_audit(prompt): what the machine actually saw, and what it MISSED.
--
-- Per prompt token this reports:
--   resolved      did it reach an entity at all
--   tier          WHICH tier answered (the floor is tier 0 and cannot miss;
--                 anything above it can, and does)
--   senses        how many candidate senses it carries
--   top_language  its strongest attested HAS_LANGUAGE
--   verdict       token resolution status
--
-- The caller supplies a relation id so the diagnostic can audit different
-- relations without resolving the relation name for each row.
--
-- READ LAW: ids until the end; one realize_batch over the collected ids joined
-- back by ordinal. No per-row realize, no string comparison, no lower().
DROP FUNCTION IF EXISTS laplace.resolve_audit(text, bytea);
CREATE OR REPLACE FUNCTION converse.resolve_audit(p_prompt text, p_lang_rel bytea)
    RETURNS TABLE(ord int, token text, resolved boolean, tier smallint,
                  senses bigint, top_language text, verdict text)
    LANGUAGE sql STABLE
BEGIN ATOMIC
WITH tok AS MATERIALIZED (
    -- prompt_words is the UAX-29 segmentation with its entity lookup. It
    -- returns one row per (ord, id) and an id living at two tiers appears
    -- TWICE (GH #752), so DISTINCT ON keeps one row per position -- otherwise
    -- a tier-collided token is double-counted in its own audit.
    SELECT DISTINCT ON (w.ord) w.ord, w.word, w.id
    FROM converse.prompt_words(p_prompt) w
    ORDER BY w.ord, w.id
),
sense_counts AS MATERIALIZED (
    SELECT s.term, count(*) AS n
    FROM lexical.senses_batch(ARRAY(SELECT t.id FROM tok t)) s
    GROUP BY s.term
),
languages AS MATERIALIZED (
    SELECT DISTINCT ON (c.subject_id) c.subject_id, c.object_id
    FROM laplace.consensus c
    WHERE c.type_id = p_lang_rel
      AND c.subject_id = ANY(ARRAY(SELECT t.id FROM tok t))
    ORDER BY c.subject_id, consensus.eff_mu(c.rating, c.rd) DESC, c.object_id
),
enriched AS NOT MATERIALIZED (
    SELECT t.ord, t.word, t.id, e.tier, COALESCE(s.n, 0) AS n_senses,
           l.object_id AS lang_id
    FROM tok t
    LEFT JOIN laplace.entities e ON e.id = t.id
    LEFT JOIN sense_counts s ON s.term = t.id
    LEFT JOIN languages l ON l.subject_id = t.id
),
ord AS (
    SELECT e.*, row_number() OVER (ORDER BY e.ord) AS ix FROM enriched e
),
lbl AS (
    SELECT realize.batch(array_agg(o.lang_id ORDER BY o.ix), NULL) AS l
    FROM ord o
)
SELECT o.ord,
       o.word,
       o.id IS NOT NULL,
       o.tier,
       COALESCE(o.n_senses, 0),
       lbl.l[o.ix],
       CASE
         WHEN o.id IS NULL             THEN 'unresolved — outside the frame'
         WHEN o.tier = 0               THEN 'floor only — codepoint, no word sense'
         WHEN COALESCE(o.n_senses,0)=0 THEN 'resolved, no senses'
         WHEN o.lang_id IS NULL        THEN 'resolved, no language attested'
         ELSE 'resolved'
       END
FROM ord o CROSS JOIN lbl
ORDER BY o.ord;
END;
