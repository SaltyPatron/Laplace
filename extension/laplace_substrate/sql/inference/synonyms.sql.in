


DROP FUNCTION IF EXISTS laplace.synonyms(bytea, int);
CREATE OR REPLACE FUNCTION converse.synonyms(p_word bytea, p_limit int DEFAULT 10)
    RETURNS TABLE(synonym text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql LAPLACE_STABLE_STRICT
BEGIN ATOMIC
    WITH src_lang AS (SELECT converse.word_language(p_word) AS id),
    agg AS (
        SELECT sm.member, max(sm.mu) AS mu, max(sm.witnesses) AS witnesses,
               max(sm.sense_mu) AS sense_mu
        FROM lexical.synset_members(p_word) sm
        WHERE sm.lang = (SELECT id FROM src_lang)
        GROUP BY sm.member
    ),
    ranked AS MATERIALIZED (
        SELECT member, mu, witnesses,
               row_number() OVER (ORDER BY sense_mu DESC NULLS LAST, mu DESC, witnesses DESC, member) AS rn
        FROM agg
        ORDER BY sense_mu DESC NULLS LAST, mu DESC, witnesses DESC, member
        LIMIT p_limit
    ),
    rendered AS MATERIALIZED (
        SELECT realize.render_text_batch(array_agg(member ORDER BY rn)) AS txt
        FROM ranked
    )
    SELECT NULLIF(btrim(r.txt[a.rn]), '') AS synonym,
           consensus.eff_mu_display(a.mu, 0) AS eff_mu,
           a.witnesses
    FROM ranked a
    CROSS JOIN rendered r
    WHERE NULLIF(btrim(r.txt[a.rn]), '') IS NOT NULL
    ORDER BY a.rn;
END;
