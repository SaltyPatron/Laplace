-- Exact source provenance for an already canonical typed physicality. The
-- trajectory remains in laplace.physicalities; provenance never serializes it
-- into a parallel ordinary-content descriptor tree.
DO $
DECLARE
    observation_table regclass;
    legacy_table regclass;
BEGIN
    -- A fresh/older database may not have this table at all. PostgreSQL does not
    -- guarantee short-circuit evaluation of SQL boolean expressions, so casting
    -- the missing name to regclass in the same IF that probes to_regclass() can
    -- raise before CREATE TABLE below gets a chance to run.
    observation_table := to_regclass(current_schema() || '.physicality_observations');
    IF observation_table IS NULL THEN
        RETURN;
    END IF;

    IF EXISTS (
           SELECT 1 FROM pg_attribute
           WHERE attrelid = observation_table
             AND attname = 'descriptor_id' AND NOT attisdropped)
       AND NOT EXISTS (
           SELECT 1 FROM pg_attribute
           WHERE attrelid = observation_table
             AND attname = 'physicality_id' AND NOT attisdropped) THEN
        legacy_table := to_regclass(
            current_schema() || '.physicality_descriptor_observations_legacy');
        IF legacy_table IS NOT NULL THEN
            RAISE EXCEPTION 'legacy physicality observation archive already exists; reconcile it before extension upgrade';
        END IF;
        ALTER TABLE physicality_observations RENAME TO physicality_descriptor_observations_legacy;
        legacy_table := to_regclass(
            current_schema() || '.physicality_descriptor_observations_legacy');
        IF EXISTS (
            SELECT 1 FROM pg_constraint
            WHERE conrelid = legacy_table
              AND conname = 'physicality_observations_pkey') THEN
            ALTER TABLE physicality_descriptor_observations_legacy
                RENAME CONSTRAINT physicality_observations_pkey
                TO physicality_descriptor_observations_legacy_pkey;
        END IF;
    END IF;
END $;

CREATE TABLE IF NOT EXISTS physicality_observations (
    entity_id bytea NOT NULL CHECK (octet_length(entity_id)=16),
    physicality_id bytea NOT NULL CHECK (octet_length(physicality_id)=16),
    source_id bytea NOT NULL CHECK (octet_length(source_id)=16),
    source_unit_id bytea NOT NULL CHECK (octet_length(source_unit_id)=16),
    observed_at_unix_us bigint NOT NULL,
    PRIMARY KEY (entity_id,physicality_id,source_id,source_unit_id)
);
