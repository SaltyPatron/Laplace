-- Inbound edges of an entity. Thin wrapper over edges_raw(); pins inbound,
-- edge_rank ordering, refuted edges INCLUDED — the axes this signature has
-- always carried, now stated instead of inferred from the body.
CREATE OR REPLACE FUNCTION consensus_in(p_id bytea, p_limit integer DEFAULT 40)
    RETURNS TABLE(subject_id bytea, type_id bytea, rating bigint, rd bigint,
                  volatility bigint, witness_count bigint)
    LANGUAGE sql STABLE AS $$
    SELECT e.neighbour_id, e.type_id, e.rating, e.rd, e.volatility, e.witness_count
    FROM @extschema@.edges_raw(p_id, 'in', NULL, p_limit, true, 'edge_rank') e
$$;
