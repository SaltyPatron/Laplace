-- The live scoreboard read: running totals plus the ingest heartbeat, cheap
-- enough to poll every few seconds (estimate counts + the tiny flush journal +
-- one pg_stat_activity pass).  Unfolded tokens are first-class state: evidence
-- durable is not the same fact as consensus/mask continuation complete.
DROP FUNCTION IF EXISTS laplace.substrate_pulse();
DROP FUNCTION IF EXISTS ops.substrate_pulse();

CREATE OR REPLACE FUNCTION ops.substrate_pulse()
    RETURNS TABLE(entities bigint, attestations bigint, consensus bigint,
                  physicalities bigint, last_flush_at timestamptz,
                  flushes_last_min bigint, unfolded_flushes bigint,
                  folding boolean)
    LANGUAGE sql STABLE
    AS $$
    SELECT
      (SELECT value FROM ops.substrate_counts() WHERE metric = 'entities(ESTIMATE)'),
      (SELECT value FROM ops.substrate_counts() WHERE metric = 'attestations(ESTIMATE)'),
      (SELECT value FROM ops.substrate_counts() WHERE metric = 'consensus(ESTIMATE)'),
      (SELECT value FROM ops.substrate_counts() WHERE metric = 'physicalities(ESTIMATE)'),
      (SELECT max(applied_at) FROM laplace.ingest_flush_journal),
      (SELECT count(*) FROM laplace.ingest_flush_journal
        WHERE applied_at > now() - interval '60 seconds'),
      (SELECT count(*) FROM laplace.ingest_flush_journal WHERE NOT folded),
      -- Folding = an explicit unfinished continuation, rows landed recently, or
      -- a fold/apply backend is active. pg_backend_pid() is excluded because this
      -- query's own text contains the pattern strings.
      EXISTS (SELECT 1 FROM laplace.ingest_flush_journal WHERE NOT folded)
        OR (SELECT (SELECT max(applied_at) FROM laplace.ingest_flush_journal)
                   > now() - interval '20 seconds')
        OR EXISTS (
          SELECT 1 FROM pg_stat_activity a
          WHERE a.datname = current_database()
            AND a.state = 'active'
            AND a.pid <> pg_backend_pid()
            AND a.query ILIKE ANY (ARRAY['%attestation_merge%', '%consensus_upsert%', '%COPY %laplace.%']))
$$;
