<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Laplace.Decomposers</RootNamespace>
    <AssemblyName>Laplace.Decomposers</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Laplace.Decomposers.Tests" />
    <InternalsVisibleTo Include="Laplace.Substrate.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="ZstdSharp.Port" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Laplace.Core\Laplace.Core.csproj" />
    <ProjectReference Include="..\Laplace.Substrate\Laplace.Substrate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy the selected authority artifacts themselves. No generated lexical or ISA summaries. -->
    <Content Include="../../docs/INVENTION.md;../../docs/INVENTIONS.md"
             Link="seeds/operational/docs/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/specs/05_Substrate_Invariants.txt;../../docs/specs/06_Engineering_Ruleset.txt;../../docs/specs/08_Record_vs_Calculate_Spec.txt;../../docs/specs/09_Substrate_LM_Synthesis.txt;../../docs/specs/11_Chess_Provenance_Consensus_Spec.txt;../../docs/specs/33_Perfcache_Blob_Law.md;../../docs/specs/34_Conversational_Provenance.md;../../docs/specs/36_Laplace_Forward_Pass.md;../../docs/specs/37_Substrate_Operation_ISA.md"
             Link="seeds/operational/docs/specs/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../seeds/operational/exemplars/en_define.conllu"
             Link="seeds/operational/seeds/operational/exemplars/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../seeds/operational/tasks/en_define.json"
             Link="seeds/operational/seeds/operational/tasks/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
