-- Integrity is referential: each physicality must reference a retained entity.
-- A run may create new forms around existing entities, so journal entity and
-- physicality totals neither prove nor quantify missing references.
--
-- Return the actual offending physicality and referenced identity. p_since
-- filters the physicality's observed_at; this surface does not attribute rows
-- to ingest runs because the journal does not retain that provenance.
-- BEGIN ATOMIC records the real table dependencies at CREATE time.
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.ingest_integrity_gate(timestamptz)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(physicality_id bytea, entity_id bytea, observed_at timestamp with time zone)'
             OR proargnames IS DISTINCT FROM ARRAY['p_since','physicality_id','entity_id','observed_at']::text[])) THEN
        DROP FUNCTION ops.ingest_integrity_gate(timestamptz);
    END IF;
END $upgrade_shape$;
CREATE OR REPLACE FUNCTION ops.ingest_integrity_gate(p_since timestamptz DEFAULT NULL)
RETURNS TABLE(physicality_id bytea,
              entity_id     bytea,
              observed_at   timestamptz)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT p.id, p.entity_id, p.observed_at
    FROM laplace.physicalities p
    WHERE NOT EXISTS (SELECT 1 FROM laplace.entities e WHERE e.id = p.entity_id)
      AND (p_since IS NULL OR p.observed_at >= p_since);
END;

COMMENT ON FUNCTION ops.ingest_integrity_gate(timestamptz) IS
    'Actual physicalities whose entity_id is absent from entities. Returns '
    'physicality_id, entity_id and observed_at; since filters observation time, '
    'not an ingest run. Entity/physicality count differences are not orphans.';


-- Count the same exact missing-reference set; keep one integrity predicate.
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.orphan_physicality_count()')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'bigint'
             OR proargnames IS DISTINCT FROM NULL::text[])) THEN
        DROP FUNCTION ops.orphan_physicality_count();
    END IF;
END $upgrade_shape$;
CREATE OR REPLACE FUNCTION ops.orphan_physicality_count()
RETURNS bigint
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT count(*) FROM ops.ingest_integrity_gate();
END;

COMMENT ON FUNCTION ops.orphan_physicality_count() IS
    'Count of actual physicalities whose entity_id has no entities row. Must be 0.';
