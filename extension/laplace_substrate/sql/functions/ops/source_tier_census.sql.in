-- Entities witnessed by this source, tallied by tier. Sources witness through
-- attestations; the entity rows themselves are source-independent.
DROP FUNCTION IF EXISTS laplace.source_tier_census(bytea);

CREATE OR REPLACE FUNCTION ops.source_tier_census(p_source bytea)
    RETURNS TABLE(tier smallint, entities bigint)
    LANGUAGE sql
    STABLE
    PARALLEL SAFE
BEGIN ATOMIC
    SELECT e.tier, count(*)::bigint
    FROM laplace.entities e
    WHERE EXISTS (
        SELECT 1 FROM laplace.attestations a
        WHERE a.source_id = p_source AND a.subject_id = e.id)
    GROUP BY e.tier
    ORDER BY e.tier;
END;
