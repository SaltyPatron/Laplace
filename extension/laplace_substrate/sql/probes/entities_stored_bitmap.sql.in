CREATE OR REPLACE FUNCTION laplace.entities_stored_bitmap(ids bytea[])
    RETURNS bytea
    AS 'EXECUTION_LIBRARY', 'pg_laplace_entities_stored_bitmap'
    LANGUAGE C STABLE;

-- Two-array call shape. Entity storage is HASH(id) and tier is altitude, not
-- identity, so tiers are ignored and presence is the id-only probe.
CREATE OR REPLACE FUNCTION laplace.entities_stored_bitmap(ids bytea[], tiers smallint[])
    RETURNS bytea
    LANGUAGE sql STABLE PARALLEL RESTRICTED
BEGIN ATOMIC
    SELECT laplace.entities_stored_bitmap(ids);
END;
