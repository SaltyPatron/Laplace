-- chat(prompt, session, lang, shape, bands, topic, topic2, type_name, elaborate)
-- A conversational turn: a THIN orchestrator over the existing intent machinery.
--
--   ORIENT  the topic is the prompt token whose synset carries the most
--           content-band consensus mass -- a measurement over the graph, not a
--           parse. An explicit p_topic from the caller wins outright.
--   SHAPE   the caller names the read (laplace.query_shapes()); nothing is
--           inferred from how the prompt is phrased.
--   LENS    p_bands selects salience bands. One band-parameterized read now
--           covers what used to be three hardcoded English branches
--           (parts / kinds / causes) and covers the other ten bands with it.
--   CARRY   session is metadata: a turn with no resolvable topic carries the
--           session's last resolved topic. p_elaborate advances through
--           non-empty fact layers.
--   CLOSE   happens at the FRONTEND, not here: every caller (MCP chat tool, HTTP
--           TurnWitness, CLI chat) deposits the prompt (UserPrompt) and response
--           (Response) through the writer spine -- full content mint + evidence +
--           inline fold, proper trust classes. SQL chat() stays read-side; its only
--           write is session_topics app-state.
--
-- The English pattern ladder this function used to run on (parse_ask, plus five
-- inline regexes over the prompt) is gone. It answered only English, in a
-- substrate whose identity law is language-agnostic by construction.
DROP FUNCTION IF EXISTS chat(text, bytea, bytea);

CREATE OR REPLACE FUNCTION chat(p_prompt text,
                                p_session bytea DEFAULT NULL,
                                p_lang bytea DEFAULT NULL,
                                p_shape text DEFAULT NULL,
                                p_bands int[] DEFAULT NULL,
                                p_topic bytea DEFAULT NULL,
                                p_topic2 bytea DEFAULT NULL,
                                p_type_name text DEFAULT NULL,
                                p_elaborate boolean DEFAULT false)
    RETURNS text
    LANGUAGE plpgsql VOLATILE
    SET search_path = @extschema@, public AS $$
DECLARE
    ctx   bytea; topic bytea; topic2 bytea;
    cands bytea[];   -- topic orientation, ranked, computed ONCE per turn
    xl    text;
    depth int;
    layers text[]; s text;
    resolved bytea;
    shape text := NULLIF(btrim(COALESCE(p_shape, '')), '');
    lang  bytea := p_lang;   -- realization language; inferred below when absent
    out   text := '';
BEGIN
    IF p_session IS NOT NULL THEN ctx := session_last_resolved(p_session); END IF;

    -- ANSWER IN THE LANGUAGE THAT WAS ASKED. A concept's surfaces are a FAMILY
    -- spanning every language that witnesses it, and realize(id, NULL) is free to
    -- pick any member -- so with no language pinned, an English prompt can be
    -- answered from a Bulgarian surface. Observed 2026-07-25: converse_walk('dog')
    -- returned a fluent Bulgarian description of a dog. The mesh working exactly as
    -- designed, surfacing at the wrong moment.
    --
    -- Language is NOT a property of the knowledge -- the knowledge sits at concept
    -- addresses and has no language. It is a property of the REQUEST, so it is
    -- resolved from the prompt and threaded to every realize() call, and the caller's
    -- explicit p_lang always wins (that is a reader asking for a translation).
    --
    -- Inference is a WEIGHTED TALLY over every HAS_LANGUAGE attestation carried by
    -- the prompt's entities, at every tier that has one -- the language with the
    -- most evidence behind it wins. Deliberately NOT word_language() per token:
    -- that is LIMIT 1, one language per word, which discards the distribution and
    -- makes a token shared across languages ("chat" in English and French, "die" in
    -- English and German) look monolingual. Summing eff_mu over all of them lets a
    -- prompt's genuinely ambiguous tokens contribute to both tallies and be settled
    -- by the tokens that are decisive, which is how a reader disambiguates too.
    --
    -- Tier-agnostic by construction: it tallies whatever the prompt resolved to, so
    -- a sentence-root HAS_LANGUAGE (the tier a corpus actually asserts language at,
    -- per the attestation law) counts alongside word-tier evidence rather than being
    -- invisible to a word-only scan. Nothing here assumes which tier answered.
    --
    -- No floors and no minimum margin: the fold already carries confidence, ties
    -- break on the id for determinism, and a prompt with no language evidence at all
    -- leaves lang NULL -- today's behaviour, and the honest answer when the prompt
    -- genuinely does not say.
    IF lang IS NULL THEN
        SELECT c.object_id INTO lang
        FROM prompt_state(p_prompt) p
        JOIN consensus c ON c.subject_id = p.id
                        AND c.type_id = relation_type_id('HAS_LANGUAGE')
        WHERE p.id IS NOT NULL AND c.object_id IS NOT NULL
        GROUP BY c.object_id
        ORDER BY sum(eff_mu(c.rating, c.rd)) DESC, c.object_id
        LIMIT 1;
    END IF;

    -- TOPIC = the prompt token whose SYNSET carries the most content-band mass.
    -- Content-band mass ranks the real topic above incidental tokens by counting
    -- witnessed edges -- a graph measurement, so it holds in any language. The
    -- whole ranked candidate list is kept (cands): the segmentation and the
    -- per-candidate band-mass aggregate run ONCE per turn, and topic2 reuses them.
    IF p_topic IS NOT NULL THEN
        topic := p_topic;
    ELSE
        -- HASH SPACE ONLY. The previous ranking's primary sort key was
        -- `lower(realize(x.syn)) = x.surface` -- it RENDERED each candidate synset
        -- to text mid-query and compared strings, so orientation was decided by a
        -- surface-form match. That is three defects in one expression: it renders
        -- before the operation is finished (render/label belong at the END, once a
        -- result is in hand); it calls an expensive STABLE function per row, which
        -- defeats the indexes; and a string equality test is English-shaped in a
        -- substrate whose identity law is language-agnostic -- a synset whose
        -- canonical label differs from the prompt's surface (car -> "auto") scored
        -- FALSE and lost to an incidental token. Measured: "What are the parts of a
        -- car?" oriented onto `parts` ("the local environment"), not `car`.
        --
        -- Replaced by the fold's own signal, entirely in ids: how strongly this
        -- token DENOTES this synset (the sense edge's eff_mu, from senses()) times
        -- how much content-band mass the synset carries. Both are consensus reads;
        -- no rendering, no string compare, no language assumption.
        -- The secondary signal is the HIGHWAY MASK, not a consensus scan. The old
        -- band_mass was a correlated `count(*)` over consensus PER CANDIDATE --
        -- measured 29.6s for one candidate on the seeded corpus. entities.highway_mask
        -- is a plain column populated at fold-write time, and laplace_highway_popcount
        -- is native: the same orientation signal off one column read, ~3s including
        -- topic resolution, and it scales with candidates instead of with edges.
        --
        -- popcount is BREADTH (how many distinct relation types this concept
        -- participates in), not edge count -- deliberately. For "which prompt token is
        -- the topic", a concept wired into many kinds of relation is the better
        -- answer than one with many edges of a single type, and the primary key
        -- (denote_mu) already carries strength. Not a cheaper approximation of the
        -- old number: a better-shaped one that happens to be cheap.
        --
        -- No bytea &/| in Postgres and no popcount-of-intersection is published, so
        -- this counts the whole mask rather than masking to the content bands first.
        -- If that intersection is wanted, it belongs in C next to
        -- laplace_highway_popcount, not rebuilt as a consensus scan here.
        -- NULL mask (entity folded but not yet drained) sorts last via NULLS LAST
        -- rather than being treated as zero-breadth.
        -- BREADTH FIRST, denote_mu only as the tiebreak. Measured on
        -- "What are the parts of a car?" (2026-07-25, seeded corpus):
        --
        --   token  denote_mu  breadth  band_mass
        --   a         1747.8        8         11
        --   are       1631.1        8         17
        --   car       1456.1       25         74
        --   of        1311.4       10          9
        --
        -- denote_mu is how strongly a surface DENOTES a sense, and function words
        -- denote their senses very strongly -- "a" is an unambiguous article. Ranking
        -- on it puts articles and copulas first: with denote_mu primary this function
        -- answered "What is a dog?" with "A is the 1st letter of the Roman alphabet."
        -- Breadth (distinct relation types the concept participates in) separates
        -- content from function words cleanly and without a stoplist -- content words
        -- are wired into many KINDS of relation, function words into few, in any
        -- language. denote_mu still decides WHICH sense of the winning concept.
        -- TWO LEVELS, TWO DIFFERENT QUESTIONS. Flattening every (token, sense) pair
        -- into one breadth-ordered list conflated them and shipped a live regression:
        -- "What is a dog?" answered about SIRE ("a male animal that has fathered a
        -- particular offspring... a kind of horse") and "What are the parts of a car?"
        -- answered about WHIP (the lash; `whip` is attested slang for car). Breadth
        -- ranks how many KINDS of relation a concept participates in, and an obscure
        -- or slang sense can be wired into more of them than the ordinary one, so used
        -- as the outer sort it selects exactly the wrong sense.
        --
        --   WHICH TOKEN is the topic  -> breadth. Content words are wired into many
        --       relation types, function words into few, in any language and with no
        --       stoplist. Measured: car 24, are 24, a 20, of 19, parts 8.
        --   WHICH SENSE of that token -> denote_mu, how strongly the surface denotes
        --       the sense. Never breadth: that is what picked sire and whip.
        --
        -- So collapse to the best sense PER TOKEN first (DISTINCT ON the token,
        -- ordered by denote_mu), carry that token's breadth as a window aggregate, and
        -- only then rank tokens. denote_mu breaks breadth ties, which is what separates
        -- car (24, denote 1458.9) from are (24, denote 1169.7).
        -- SUPERSEDED 2026-07-26: breadth-then-denote_mu, both computed per token
        -- in isolation. It ties (a 13, pawn 13) and denote_mu breaks the tie
        -- toward the article, so "What is a pawn in chess?" answered "A is the
        -- 1st letter of the Roman alphabet." and "is" resolved to the sense ICE.
        -- Every commentary block above about breadth-vs-denote_mu describes that
        -- superseded ranking and is kept only as the record of why neither scalar
        -- works: the discriminating information is not in any single token.
        --
        -- prompt_coherence() ranks a candidate by rated consensus mass between it
        -- and the OTHER tokens' candidates, which resolves the sense and elects
        -- the topic in one read. peers (how many distinct prompt tokens a
        -- candidate is actually wired to) leads, so a concept the whole prompt
        -- agrees on beats one with a single heavy edge; coherence mass and then
        -- denote_mu break ties. Still no stoplist and no surface compare.
        -- rel_mass is the third key: for "what are the X of Y" prompts, X names
        -- a RELATION and concept-to-concept coherence is silent (a car HAS_PART
        -- door, never HAS_PART "part"), so peers/coherence are 0 across the board
        -- and the election used to fall through to denote_mu -- which picks TZAR
        -- for "car". Ranking by the relation the prompt named puts the vehicle
        -- sense (29 HAS_PART edges) first and the article second. Measured
        -- 2026-07-27 on "What is a part of a car?".
        SELECT array_agg(y.synset_id ORDER BY y.peers DESC,
                                              y.coherence DESC,
                                              y.rel_mass DESC,
                                              y.denote_mu DESC NULLS LAST,
                                              y.synset_id)
          INTO cands
        FROM prompt_coherence(p_prompt) y;
        topic := cands[1];
        -- Nothing in this turn resolved: carry the session's standing topic.
        IF topic IS NULL THEN topic := ctx; END IF;
    END IF;

    IF topic IS NULL THEN
        out := converse(p_prompt);
    ELSE
        resolved := topic;  xl := realize(topic, lang);
        topic2 := p_topic2;

        -- Second topic for the two-topic shapes: the caller's, else the next
        -- ranked candidate that is not the first. Reuses the ranking already
        -- computed above rather than re-segmenting the same input.
        IF topic2 IS NULL AND shape IN ('reason', 'is_a') AND cands IS NOT NULL THEN
            SELECT u.syn INTO topic2
            FROM unnest(cands) WITH ORDINALITY u(syn, ord)
            WHERE u.syn <> topic
            ORDER BY u.ord
            LIMIT 1;
        END IF;

        IF p_elaborate AND p_session IS NOT NULL THEN
            -- ELABORATE: advance through NON-EMPTY fact layers by prior mentions.
            layers := ARRAY[]::text[];
            SELECT initcap(xl)||' has parts such as '||string_agg(l,', ' ORDER BY m DESC)||'.'
              INTO s FROM (SELECT realize(c.object_id,lang) l,(c.rating-2*c.rd) m
                FROM consensus c WHERE c.subject_id=topic AND relation_highway_band(c.type_id)=4
                ORDER BY (c.rating-2*c.rd) DESC LIMIT 6) z WHERE l IS NOT NULL;
            IF s IS NOT NULL THEN layers := layers||s; END IF;
            SELECT 'Kinds of '||xl||' include '||string_agg(l,', ' ORDER BY m DESC)||'.'
              INTO s FROM (SELECT realize(c.subject_id,lang) l,(c.rating-2*c.rd) m
                FROM consensus c WHERE c.object_id=topic AND relation_highway_band(c.type_id)=2
                ORDER BY (c.rating-2*c.rd) DESC LIMIT 8) z WHERE l IS NOT NULL;
            IF s IS NOT NULL THEN layers := layers||s; END IF;
            SELECT initcap(xl)||' is related to '||string_agg(l,' and ' ORDER BY m DESC)||'.'
              INTO s FROM (SELECT realize(c.object_id,lang) l,(c.rating-2*c.rd) m
                FROM consensus c WHERE c.subject_id=topic AND relation_highway_band(c.type_id)=7
                ORDER BY (c.rating-2*c.rd) DESC LIMIT 8) z
               WHERE label_is_content(l) LIMIT 3;
            IF s IS NOT NULL THEN layers := layers||s; END IF;
            SELECT count(*) INTO depth FROM session_topics t
              WHERE t.session_id=p_session AND t.resolved_id=topic;
            out := CASE WHEN depth BETWEEN 1 AND COALESCE(array_length(layers,1),0)
                        THEN layers[depth]
                        ELSE 'That is the core of what I hold about '||xl||'.' END;

        ELSIF p_bands IS NOT NULL AND array_length(p_bands, 1) > 0 THEN
            -- BAND LENS: every edge of the topic inside the selected bands, both
            -- directions, ranked by eff_mu. This one read replaces the former
            -- parts / kinds / causes English branches and generalizes to all 13.
            SELECT string_agg(line, ' ') INTO out FROM (
                SELECT b.name || ': ' || string_agg(z.l, ', ' ORDER BY z.m DESC) || '.' AS line,
                       max(z.m) AS top_m
                FROM (
                    SELECT relation_highway_band(c.type_id) AS band,
                           realize(c.object_id, lang) AS l,
                           (c.rating - 2*c.rd) AS m
                    FROM consensus c
                    WHERE c.subject_id = topic
                      AND relation_highway_band(c.type_id) = ANY(p_bands)
                    UNION ALL
                    SELECT relation_highway_band(c.type_id),
                           realize(c.subject_id, lang),
                           (c.rating - 2*c.rd)
                    FROM consensus c
                    WHERE c.object_id = topic
                      AND relation_highway_band(c.type_id) = ANY(p_bands)
                ) z
                JOIN relation_band_catalog() b ON b.band = z.band
                WHERE z.l IS NOT NULL
                GROUP BY b.band, b.name
                ORDER BY b.band
            ) q;
            IF out IS NULL OR out = '' THEN
                out := 'I hold no witnessed edges for '||xl||' in the selected bands yet.';
            END IF;

        ELSIF shape = 'reason' AND topic2 IS NOT NULL THEN
            SELECT string_agg(reply, ' ') INTO out
              FROM recall_relation_summary_response(topic, topic2);

        ELSIF shape IN ('related','related_in') AND p_type_name IS NOT NULL THEN
            SELECT string_agg(reply, ' ') INTO out
              FROM recall_intent(shape, topic, NULL, p_type_name);
            IF out IS NULL OR out = '' THEN
                out := 'I hold no witnessed '||lower(p_type_name)||' for '||xl||' yet.';
            END IF;

        ELSIF shape IS NOT NULL AND shape NOT IN ('describe','fallback','walk','what_is') THEN
            -- Any other published shape answers through the shared responder family.
            SELECT string_agg(reply, ' ') INTO out
              FROM recall_intent(shape, topic, topic2, p_type_name);

        ELSE
            -- describe / what_is / walk / fallback and the no-shape default.
            --
            -- SENTENCE-TIER COMPOSITION FIRST. converse_about's template prose
            -- is the S9 FALLBACK (spec 36) and must never be the success path;
            -- it also mangles clause-shaped glosses, since "X is " || gloss
            -- yields "Pawn is it can be promoted to a more powerful piece if it
            -- reaches the 8th rank." (observed live 2026-07-26).
            --
            -- The gate converse_compose is held to is now met for
            -- converse_tiered -- run on the deployed extension, same date:
            --   "it can be promoted to a more powerful piece if it reaches the
            --    8th rank. change a pawn for a better piece by advancing it to
            --    the eighth row... (chess) the least powerful piece."
            -- Four separately-witnessed clauses, stepped by concept adjacency,
            -- on topic, each traceable to its witnesses.
            IF xl IS NOT NULL THEN
                out := converse_tiered(topic, lang);
                -- Degrade EXPLICITLY, never silently: no attested sentence for
                -- this topic means the sequence layer is starved here, and the
                -- template is the declared fallback.
                IF out IS NULL OR out = '' THEN out := converse_about(topic, lang); END IF;
            ELSE
                out := converse(p_prompt);
            END IF;
        END IF;

        IF out IS NULL OR out = '' THEN
            out := CASE WHEN xl IS NOT NULL THEN converse_about(topic, lang)
                        ELSE converse(p_prompt) END;
        END IF;
    END IF;

    -- RECORD session carry; the OODA close (turn witnessing) is the caller's duty.
    IF p_session IS NOT NULL THEN
        PERFORM session_record_prompt(p_session, p_prompt, resolved);
    END IF;

    RETURN btrim(out);
END;
$$;
