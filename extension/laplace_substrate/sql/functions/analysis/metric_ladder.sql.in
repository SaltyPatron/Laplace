-- ops.metric_ladder: every comparison rung for two entities, ordered by how
-- much of the trajectory each rung forgets. Geometry proposes candidates;
-- typed evidence governs selection, so a coordinate is a bucket, not identity.
--
--   rung             operates on              order      cat/tac/act
--   ---------------- ----------------------- ---------- ----------------
--   coord_distance   collapsed point          forgotten  collide
--   hilbert          quantised point          forgotten  collide
--   hausdorff        realized curve as a SET  forgotten  collide
--   frechet          realized curve as a PATH preserved  separate
--   merkle_id        ordered childIds         preserved  separate exactly
--
-- Curves are REALIZED: structural.entity_curve reads each child's coordinate
-- in ordinal order. The trajectory column's packed values (child id, ordinal,
-- flags) are not positions and are never fed to a metric; if they were,
-- Hausdorff between anagrams would read ~1e-16 instead of exactly 0.
--
-- Each metric is evaluated once in the CTE and reused for value and collides.
-- The BEGIN ATOMIC body schema-qualifies the 4D metric functions and casts
-- every UNION literal, because an atomic body binds names and types at CREATE.
-- metric_ladder_words pins this function's oid, so its shape check runs first:
-- the base cannot be dropped while the wrapper stands.
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.metric_ladder_words(text, text)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(rung text, value double precision, collides boolean, order_bearing boolean)'
             OR proargnames IS DISTINCT FROM ARRAY['p_a','p_b','rung','value','collides','order_bearing']::text[])) THEN
        DROP FUNCTION ops.metric_ladder_words(text, text);
    END IF;
END $upgrade_shape$;
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.metric_ladder(bytea, bytea)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(rung text, value double precision, collides boolean, order_bearing boolean)'
             OR proargnames IS DISTINCT FROM ARRAY['p_a','p_b','rung','value','collides','order_bearing']::text[])) THEN
        DROP FUNCTION ops.metric_ladder(bytea, bytea);
    END IF;
END $upgrade_shape$;
CREATE OR REPLACE FUNCTION ops.metric_ladder(p_a bytea, p_b bytea)
RETURNS TABLE(rung          text,
              value         double precision,
              collides      boolean,
              order_bearing boolean)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH pt AS (
        -- One scan of both entities, pivoted.
        SELECT (array_agg(s.coord         ORDER BY s.ord))[1] AS ca,
               (array_agg(s.coord         ORDER BY s.ord))[2] AS cb,
               (array_agg(s.hilbert_index ORDER BY s.ord))[1] AS ha,
               (array_agg(s.hilbert_index ORDER BY s.ord))[2] AS hb
        FROM (SELECT p.coord, p.hilbert_index,
                     CASE WHEN p.entity_id = p_a THEN 1 ELSE 2 END AS ord
              FROM laplace.physicalities p
              WHERE p.entity_id IN (p_a, p_b)) s
    ),
    m AS (
        SELECT public.laplace_distance_4d(pt.ca, pt.cb)        AS d_coord,
               pt.ha                                           AS ha,
               pt.hb                                           AS hb,
               public.laplace_hausdorff_4d(qa.curve, qb.curve)  AS d_haus,
               public.laplace_frechet_4d(qa.curve, qb.curve)    AS d_fre
        FROM pt
        CROSS JOIN LATERAL (SELECT structural.entity_curve(p_a) AS curve) qa
        CROSS JOIN LATERAL (SELECT structural.entity_curve(p_b) AS curve) qb
    )
    SELECT 'coord_distance'::text, m.d_coord, (m.d_coord = 0.0), false FROM m
    UNION ALL
    SELECT 'hilbert'::text, NULL::double precision, (m.ha = m.hb), false FROM m
    UNION ALL
    SELECT 'hausdorff'::text, m.d_haus, (m.d_haus = 0.0), false FROM m
    UNION ALL
    SELECT 'frechet'::text, m.d_fre, (m.d_fre = 0.0), true FROM m
    UNION ALL
    SELECT 'merkle_id'::text, NULL::double precision, (p_a = p_b), true;
END;

COMMENT ON FUNCTION ops.metric_ladder(bytea, bytea) IS
    'All comparison rungs for two entities over REALIZED curves. Coord/Hilbert/'
    'Hausdorff collide on anagrams by design; Frechet and Merkle id separate them.';


-- ops.metric_ladder_words: the same ladder addressed by surface.
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.metric_ladder_words(text, text)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(rung text, value double precision, collides boolean, order_bearing boolean)'
             OR proargnames IS DISTINCT FROM ARRAY['p_a','p_b','rung','value','collides','order_bearing']::text[])) THEN
        DROP FUNCTION ops.metric_ladder_words(text, text);
    END IF;
END $upgrade_shape$;
CREATE OR REPLACE FUNCTION ops.metric_ladder_words(p_a text, p_b text)
RETURNS TABLE(rung          text,
              value         double precision,
              collides      boolean,
              order_bearing boolean)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT l.rung, l.value, l.collides, l.order_bearing
    FROM ops.metric_ladder(laplace.word_id(p_a), laplace.word_id(p_b)) l;
END;

COMMENT ON FUNCTION ops.metric_ladder_words(text, text) IS
    'ops.metric_ladder addressed by surface rather than id.';
