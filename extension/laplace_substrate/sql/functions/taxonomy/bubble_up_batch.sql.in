-- taxonomy.bubble_up_batch(terms[], domain_context[], k): bubble_up for a SET of terms
-- in one pass. Same election, same ordering, same output columns, plus the term.
--
-- WHY THIS EXISTS. taxonomy.bubble_up takes ONE term, so every caller that needs senses
-- for a token stream calls it per token and re-runs the entire CTE cascade each
-- time. Measured under auto_explain on generation.compose_batch('what is a wolf', 12):
-- CTE Scan `scoped` 51,351 ms over 798 loops, `cand_lang` 32,438 ms over 728 loops,
-- `family_out` 15,358 ms over 2,394 loops -- 51.4 s of a 52.2 s statement, to elect
-- senses for ~266 distinct tokens. The work per token is small; the repetition is
-- the cost.
--
-- WHAT ACTUALLY COLLAPSES. cand_lang is the clearest case: the scalar form issues one
-- attestations probe per term, and attestations cannot prune on subject_id, so each
-- probe pays the full partition set. Batched, every candidate synset of every term
-- is resolved by ONE probe. term_lang and peers stay per-term (they are per-term
-- facts) but run as one set-based pass instead of N statements.
--
-- ORDERING IS PER TERM. row_number() OVER (PARTITION BY term ORDER BY the complete
-- evidence order) applies an explicit p_k independently to each term. This file owns
-- that order; the scalar is only a one-element adapter and cannot drift from it.
CREATE OR REPLACE FUNCTION taxonomy._bubble_domain_scores(
    p_synsets bytea[],
    p_domain_context bytea[]
)
RETURNS TABLE(synset_id bytea, domain_hits bigint)
LANGUAGE plpgsql STABLE PARALLEL SAFE
AS $$
BEGIN
    IF COALESCE(cardinality(p_synsets), 0) = 0
       OR COALESCE(cardinality(p_domain_context), 0) = 0 THEN
        RETURN;
    END IF;

    RETURN QUERY
    WITH synsets AS (
        SELECT DISTINCT s AS synset_id
        FROM unnest(p_synsets) AS s
        WHERE s IS NOT NULL
    ),
    domain AS (
        SELECT DISTINCT d AS id
        FROM unnest(p_domain_context) AS d
        WHERE d IS NOT NULL
    ),
    members AS (
        SELECT s.synset_id, m.object_id AS member_id
        FROM synsets s
        JOIN laplace.consensus m ON m.subject_id = s.synset_id
        WHERE m.type_id = ANY (consensus.relation_family_ids('HAS_SENSE'))
        UNION
        SELECT s.synset_id, m.subject_id AS member_id
        FROM synsets s
        JOIN laplace.consensus m ON m.object_id = s.synset_id
        WHERE m.type_id = ANY (consensus.relation_family_ids('HAS_SENSE'))
    )
    SELECT m.synset_id, count(*)::bigint AS domain_hits
    FROM members m
    JOIN domain d ON true
    JOIN LATERAL structural.geometry_neighbours(m.member_id, 200, 8) gn
      ON gn.neighbour_id = d.id
    GROUP BY m.synset_id;
END;
$$;

CREATE OR REPLACE FUNCTION taxonomy._bubble_up_batch_impl(
    p_terms bytea[],
    p_domain_context bytea[],
    p_k integer
)
RETURNS TABLE(
    term bytea,
    sense_id bytea,
    synset_id bytea,
    via_relation text,
    score numeric,
    base_eff_mu numeric,
    domain_hits bigint,
    witnesses bigint
)
LANGUAGE plpgsql STABLE PARALLEL SAFE
AS $$
BEGIN
    IF COALESCE(cardinality(p_terms), 0) = 0 THEN
        RETURN;
    END IF;

    RETURN QUERY
    WITH terms AS MATERIALIZED (
        SELECT DISTINCT t AS term
        FROM unnest(p_terms) AS t
        WHERE t IS NOT NULL
    ),
    peers AS MATERIALIZED (
        SELECT lp.word_id AS term, u.id
        FROM lexical.lexical_peers_batch(
            ARRAY(SELECT t.term FROM terms t ORDER BY t.term)) lp
        CROSS JOIN LATERAL unnest(lp.peers) AS u(id)
        WHERE u.id IS NOT NULL
    ),
    resolved AS MATERIALIZED (
        SELECT p.term,
               be.binding AS sense_id,
               be.key AS synset_id,
               'HAS_SENSE'::text AS via_relation,
               be.eff_mu AS base_eff_mu,
               COALESCE(be.witnesses, be.games, 1)::bigint AS witnesses,
               round(be.eff_mu * 1e9)::bigint AS rating,
               0::bigint AS rd,
               be.language
        FROM peers p
        JOIN converse.binding_evidence(ARRAY(SELECT DISTINCT id FROM peers), NULL, false) be
          ON be.term = p.id
    ),
    language_filter AS MATERIALIZED (
        SELECT p_domain_context IS NULL OR cardinality(p_domain_context) > 0 AS requested
    ),
    term_lang AS MATERIALIZED (
        SELECT DISTINCT ON (w.term) w.term, w.lang AS id
        FROM (
            SELECT r.term, r.language AS lang,
                   sum(r.witnesses * 1000000000::numeric)::numeric AS total_score,
                   sum(r.witnesses)::bigint AS total_obs
            FROM resolved r
            CROSS JOIN language_filter lf
            WHERE lf.requested AND r.language IS NOT NULL
            GROUP BY r.term, r.language
        ) w
        ORDER BY w.term, w.total_score DESC, w.total_obs DESC, w.lang
    ),
    cand_langs AS MATERIALIZED (
        SELECT DISTINCT r.synset_id AS id, r.language AS lang
        FROM resolved r
        CROSS JOIN language_filter lf
        WHERE lf.requested AND r.language IS NOT NULL
    ),
    scoped AS (
        SELECT r.* FROM resolved r
        LEFT JOIN term_lang tl ON tl.term = r.term
        CROSS JOIN language_filter lf
        WHERE NOT lf.requested
           OR tl.id IS NULL
           OR NOT EXISTS (SELECT 1 FROM cand_langs ca WHERE ca.id = r.synset_id)
           OR EXISTS (SELECT 1 FROM cand_langs ch
                      WHERE ch.id = r.synset_id AND ch.lang = tl.id)
    ),
    domain_scores AS (
        SELECT ds.synset_id, ds.domain_hits
        FROM taxonomy._bubble_domain_scores(
            ARRAY(SELECT DISTINCT r.synset_id FROM scoped r WHERE r.synset_id IS NOT NULL),
            p_domain_context
        ) ds
        WHERE COALESCE(cardinality(p_domain_context), 0) > 0
    ),
    ranked AS (
        SELECT DISTINCT ON (r.term, r.synset_id)
               r.term,
               r.sense_id,
               r.synset_id,
               r.via_relation,
               r.base_eff_mu,
               COALESCE(ds.domain_hits, 0)::bigint AS domain_hits,
               r.witnesses,
               (r.base_eff_mu * (1::numeric + ln(1::numeric + COALESCE(ds.domain_hits, 0)))) AS score,
               consensus.eff_mu(r.rating, r.rd) AS rank_key
        FROM scoped r
        LEFT JOIN domain_scores ds ON ds.synset_id = r.synset_id
        ORDER BY r.term, r.synset_id, r.witnesses DESC, consensus.eff_mu(r.rating, r.rd) DESC
    ),
    ordered AS (
        SELECT rk.*,
               row_number() OVER (PARTITION BY rk.term
                                  ORDER BY rk.witnesses DESC, rk.score DESC,
                                           rk.rank_key DESC, rk.synset_id) AS rn
        FROM ranked rk
    )
    SELECT o.term, o.sense_id, o.synset_id, o.via_relation, o.score, o.base_eff_mu,
           o.domain_hits, o.witnesses
    FROM ordered o
    WHERE p_k IS NULL OR o.rn <= p_k
    ORDER BY o.term, o.rn;

    IF FOUND THEN
        RETURN;
    END IF;

    RETURN QUERY
    WITH terms AS MATERIALIZED (
        SELECT DISTINCT t AS term
        FROM unnest(p_terms) AS t
        WHERE t IS NOT NULL
    ),
    peers AS MATERIALIZED (
        SELECT lp.word_id AS term, u.id
        FROM lexical.lexical_peers_batch(
            ARRAY(SELECT t.term FROM terms t ORDER BY t.term)) lp
        CROSS JOIN LATERAL unnest(lp.peers) AS u(id)
        WHERE u.id IS NOT NULL
    ),
    family_out AS MATERIALIZED (
        SELECT p.term,
               c.object_id AS target_id,
               consensus.relation_canonical(c.type_id) AS via_relation,
               (consensus.relation_canonical(c.type_id) = 'HAS_SENSE') AS is_has_sense,
               consensus.eff_mu_display(c.rating, c.rd) AS base_eff_mu,
               c.witness_count AS witnesses,
               c.rating,
               c.rd
        FROM peers p
        JOIN laplace.consensus c ON c.subject_id = p.id
        WHERE c.subject_id = ANY (ARRAY(SELECT DISTINCT id FROM peers))
          AND c.type_id = ANY (consensus.relation_family_ids('HAS_SENSE'))
    ),
    sense_targets AS MATERIALIZED (
        SELECT ss.subject_id, ss.object_id, ss.rating, ss.rd, ss.witness_count
        FROM laplace.consensus ss
        WHERE EXISTS (SELECT 1 FROM family_out fo WHERE fo.is_has_sense)
          AND ss.subject_id = ANY (ARRAY(SELECT DISTINCT fo.target_id FROM family_out fo WHERE fo.is_has_sense))
          AND ss.type_id = ANY (consensus.relation_family_ids('HAS_SENSE'))
          AND consensus.relation_canonical(ss.type_id) = 'IS_SENSE_OF'
    ),
    resolved AS MATERIALIZED (
        SELECT fo.term,
               fo.target_id AS sense_id,
               COALESCE(ss.object_id, fo.target_id) AS synset_id,
               fo.via_relation,
               CASE WHEN ss.object_id IS NOT NULL
                    THEN LEAST(fo.base_eff_mu, consensus.eff_mu_display(ss.rating, ss.rd))
                    ELSE fo.base_eff_mu END AS base_eff_mu,
               fo.witnesses + COALESCE(ss.witness_count, 0) AS witnesses,
               fo.rating,
               fo.rd,
               NULL::bytea AS language
        FROM family_out fo
        LEFT JOIN sense_targets ss
          ON ss.subject_id = fo.target_id
        WHERE fo.is_has_sense

        UNION ALL

        SELECT fo.term, fo.target_id, fo.target_id, fo.via_relation,
               fo.base_eff_mu, fo.witnesses, fo.rating, fo.rd,
               NULL::bytea AS language
        FROM family_out fo
        WHERE fo.via_relation = 'IS_SYNONYM_OF'

        UNION ALL

        SELECT fo.term, fo.term, fo.target_id, fo.via_relation,
               fo.base_eff_mu, fo.witnesses, fo.rating, fo.rd,
               NULL::bytea AS language
        FROM family_out fo
        WHERE fo.via_relation = 'IS_SENSE_OF'
    ),
    language_filter AS MATERIALIZED (
        SELECT p_domain_context IS NULL OR cardinality(p_domain_context) > 0 AS requested
    ),
    term_lang_weights AS MATERIALIZED (
        SELECT a.subject_id AS term, a.context_id AS lang,
               sum(a.sum_score_fp1e9)::numeric AS score,
               sum(a.observation_count)::bigint AS obs
        FROM laplace.attestations a
        CROSS JOIN language_filter lf
        WHERE lf.requested
          AND a.subject_id = ANY (p_terms)
          AND laplace.is_language(a.context_id)
        GROUP BY a.subject_id, a.context_id
    ),
    term_lang AS MATERIALIZED (
        SELECT DISTINCT ON (w.term) w.term, w.lang AS id
        FROM (
            SELECT tlw.term, tlw.lang,
                   sum(tlw.score) AS total_score,
                   sum(tlw.obs) AS total_obs
            FROM term_lang_weights tlw
            GROUP BY tlw.term, tlw.lang
        ) w
        ORDER BY w.term, w.total_score DESC, w.total_obs DESC, w.lang
    ),
    cand_langs AS MATERIALIZED (
        SELECT DISTINCT a.subject_id AS id, a.context_id AS lang
        FROM laplace.attestations a
        CROSS JOIN language_filter lf
        WHERE a.subject_id = ANY (ARRAY(SELECT DISTINCT r.synset_id FROM resolved r))
          AND lf.requested
          AND laplace.is_language(a.context_id)
    ),
    scoped AS (
        SELECT r.* FROM resolved r
        LEFT JOIN term_lang tl ON tl.term = r.term
        CROSS JOIN language_filter lf
        WHERE NOT lf.requested
           OR tl.id IS NULL
           OR NOT EXISTS (SELECT 1 FROM cand_langs ca WHERE ca.id = r.synset_id)
           OR EXISTS (SELECT 1 FROM cand_langs ch
                      WHERE ch.id = r.synset_id AND ch.lang = tl.id)
    ),
    domain_scores AS (
        SELECT ds.synset_id, ds.domain_hits
        FROM taxonomy._bubble_domain_scores(
            ARRAY(SELECT DISTINCT r.synset_id FROM scoped r WHERE r.synset_id IS NOT NULL),
            p_domain_context
        ) ds
        WHERE COALESCE(cardinality(p_domain_context), 0) > 0
    ),
    ranked AS (
        SELECT DISTINCT ON (r.term, r.synset_id)
               r.term,
               r.sense_id,
               r.synset_id,
               r.via_relation,
               r.base_eff_mu,
               COALESCE(ds.domain_hits, 0)::bigint AS domain_hits,
               r.witnesses,
               (r.base_eff_mu * (1::numeric + ln(1::numeric + COALESCE(ds.domain_hits, 0)))) AS score,
               consensus.eff_mu(r.rating, r.rd) AS rank_key
        FROM scoped r
        LEFT JOIN domain_scores ds ON ds.synset_id = r.synset_id
        ORDER BY r.term, r.synset_id, consensus.eff_mu(r.rating, r.rd) DESC
    ),
    ordered AS (
        SELECT rk.*,
               row_number() OVER (PARTITION BY rk.term
                                  ORDER BY rk.witnesses DESC, rk.score DESC,
                                           rk.rank_key DESC, rk.synset_id) AS rn
        FROM ranked rk
    )
    SELECT o.term, o.sense_id, o.synset_id, o.via_relation, o.score, o.base_eff_mu,
           o.domain_hits, o.witnesses
    FROM ordered o
    WHERE p_k IS NULL OR o.rn <= p_k
    ORDER BY o.term, o.rn;
END;
$$;

CREATE OR REPLACE FUNCTION taxonomy.bubble_up_batch(
    p_terms bytea[],
    p_domain_context bytea[] DEFAULT NULL,
    -- NULL = no truncation. See the note above `ordered`: a default number here
    -- would cut the candidate field before the election.
    p_k integer DEFAULT NULL
)
RETURNS TABLE(
    term bytea,
    sense_id bytea,
    synset_id bytea,
    via_relation text,
    score numeric,
    base_eff_mu numeric,
    domain_hits bigint,
    witnesses bigint
)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT *
    FROM taxonomy._bubble_up_batch_impl(p_terms, p_domain_context, p_k);
END;
