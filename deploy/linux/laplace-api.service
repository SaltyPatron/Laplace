[Unit]
Description=Laplace API (OpenAI-compatible endpoints + self-hosted SPA) over laplace-mono
Documentation=https://github.com/SaltyPatron/Laplace
# The cluster is Laplace-Operations' (pgdata.service, socket /tmp); site-host.sh installs this unit.
After=network.target pgdata.service
Wants=pgdata.service
# Nothing to run until deploy/linux/site.sh has published the API once.
ConditionPathExists=/opt/laplace/app/Laplace.Endpoints.OpenAICompat.dll

[Service]
Type=simple
User=laplace-runner
Group=laplace-runner
UMask=0002
Environment=TMPDIR=/opt/laplace/tmp
Environment=TMP=/opt/laplace/tmp
Environment=TEMP=/opt/laplace/tmp
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
WorkingDirectory=/opt/laplace/app
# Non-secret runtime config (database, perf-cache, URLs), written by site.sh publish.
EnvironmentFile=/opt/laplace/app/laplace-api.env
# Operator-published secrets. Optional (-).
EnvironmentFile=-/opt/laplace/secrets/operator.env
EnvironmentFile=-/opt/laplace/secrets/lichess.env
EnvironmentFile=-/opt/laplace/secrets/stripe.env
EnvironmentFile=-/opt/laplace/secrets/identity.env
ExecStart=/usr/bin/dotnet /opt/laplace/app/Laplace.Endpoints.OpenAICompat.dll
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
SyslogIdentifier=laplace-api

[Install]
WantedBy=multi-user.target
