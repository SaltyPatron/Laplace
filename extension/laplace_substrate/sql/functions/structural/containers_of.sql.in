-- The reverse of realize.constituents(): given an entity, walk UP the composition
-- hierarchy and return every higher-tier entity whose trajectory contains it
-- (directly at hop=1, or transitively through intermediate tiers at hop>1),
-- e.g. structural.containers_of(laplace.word_id('chess'), 2) returns the sentences containing
-- "chess" (hop 1) and the documents containing those sentences (hop 2).
--
-- Native (see containers_of.c for the full rationale): a single SQL query
-- checking trajectory containment against a large frontier array defeats
-- physicalities_constituents_gin's cost estimation and falls back to a full
-- scan (measured 850ms for a query that should be sub-millisecond). This
-- drives the walk as a sequence of cached, single-key SPI probes instead,
-- each of which the GIN index serves in ~2ms regardless of table size.
DROP FUNCTION IF EXISTS laplace.containers_of(bytea, int, int);
CREATE OR REPLACE FUNCTION structural.containers_of(
    p_entity   bytea,
    p_max_hops int   DEFAULT 1,
    p_limit    int   DEFAULT 1000)
    RETURNS TABLE(entity_id bytea, tier smallint, type_id bytea, hops int)
    AS 'MODULE_PATHNAME', 'pg_laplace_containers_of'
    LANGUAGE C STABLE;

-- Set containment is a different operation from frontier expansion.  Given
-- multiple identities, return compositions whose one witnessed trajectory
-- contains every identity.  This preserves the composition hop: `Captain` and
-- `Ahab` remain constituents of the returned sentence; this function does not
-- fabricate a direct semantic edge between them.
--
-- The predicate is the exact expression served by
-- physicalities_constituents_gin.  It is intentionally one bound @> probe, not
-- N calls to containers_of followed by an intersection.  On the live Moby Dick
-- data the two-id Captain/Ahab probe returns 112 containers in ~3 ms; separately
-- expanding both words and intersecting their result sets ran for minutes.
--
-- No row cap belongs in this primitive.  The caller owns policy and may rank or
-- stop after it has a typed candidate set.  An empty member set returns no rows
-- rather than allowing array containment's empty-set truth to scan every
-- physicality.
DROP FUNCTION IF EXISTS laplace.containers_containing_all(bytea[]);
CREATE OR REPLACE FUNCTION structural.containers_containing_all(p_members bytea[])
    RETURNS TABLE(entity_id bytea)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT DISTINCT ON (p.entity_id) p.entity_id
    FROM laplace.physicalities p
    WHERE cardinality(p_members) > 0
      AND p.type = 1
      AND p.trajectory IS NOT NULL
      AND public.laplace_trajectory_constituent_ids(p.trajectory) @> p_members
    ORDER BY p.entity_id, p.id;
END;

-- Browser/name discovery needs the same indexed containment law, but only over
-- word-like composition points.  Keep the raw trajectory predicate in this one
-- sanctioned structural boundary; callers receive an explicit capacity receipt
-- instead of reimplementing the GIN probe or pretending a bounded frontier is
-- the complete universe.
DROP FUNCTION IF EXISTS structural.word_containers_containing_all(bytea[], int);
CREATE OR REPLACE FUNCTION structural.word_containers_containing_all(
    p_members bytea[],
    p_capacity int DEFAULT 2048)
    RETURNS TABLE(entity_id bytea, candidate_count bigint, truncated boolean)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH bounded AS MATERIALIZED (
        SELECT w.id
        FROM laplace.v_word_points w
        WHERE cardinality(p_members) > 0
          AND w.trajectory IS NOT NULL
          AND public.laplace_trajectory_constituent_ids(w.trajectory) @> p_members
        ORDER BY w.id
        LIMIT GREATEST(COALESCE(p_capacity, 0), 0) + 1
    ), stats AS MATERIALIZED (
        SELECT LEAST(count(*), GREATEST(COALESCE(p_capacity, 0), 0))::bigint AS n,
               count(*) > GREATEST(COALESCE(p_capacity, 0), 0) AS clipped
        FROM bounded
    )
    SELECT b.id, s.n, s.clipped
    FROM bounded b CROSS JOIN stats s
    ORDER BY b.id
    LIMIT GREATEST(COALESCE(p_capacity, 0), 0);
END;
