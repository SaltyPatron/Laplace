-- Ranked surface sample for a source×tier (GH #813). Census answers "how many";
-- this answers "what do they look like?" — observation_count from that source's
-- attestations (fold input), not LIMIT-without-ORDER over entities.
--
-- Filter at the requested source×tier grain BEFORE ranking. The former plan took
-- an invented max(limit×200, 4000) attestation head, then discarded subjects that
-- did not belong to the source/tier. Besides doing unrelated work, it could still
-- underfill whenever valid rows fell outside that guess. The source index drives the
-- evidence side and entity identity decides admission before the exact aggregate.
-- Labels still run once over the final caller-sized set.
-- BEGIN ATOMIC: GH #764 beachhead.
DROP FUNCTION IF EXISTS laplace.surface_sample(bytea, smallint, int);

CREATE OR REPLACE FUNCTION ops.surface_sample(
        p_source bytea,
        p_tier smallint,
        p_limit int DEFAULT 20)
    RETURNS TABLE(
        entity_id bytea,
        surface text,
        type_name text,
        observations bigint)
    LANGUAGE sql
    STABLE
BEGIN ATOMIC
    WITH kept AS (
        SELECT a.subject_id AS id,
               e.type_id,
               sum(a.observation_count)::bigint AS observations
        FROM laplace.attestations a
        JOIN laplace.entities e
          ON e.id = a.subject_id
         AND e.tier = p_tier
         AND e.first_observed_by = p_source
        WHERE a.source_id = p_source
          AND consensus.relation_canonical(a.subject_id) IS NULL
        GROUP BY a.subject_id, e.type_id
        ORDER BY sum(a.observation_count) DESC, a.subject_id
        LIMIT p_limit
    ), numbered AS (
        SELECT k.*, row_number() OVER (ORDER BY k.observations DESC, k.id) AS ix
        FROM kept k
    ),
    ids AS (
        SELECT array_agg(v.id ORDER BY v.ord) AS a
        FROM (
            SELECT k.id, k.ix * 2 - 1 AS ord FROM numbered k
            UNION ALL
            SELECT k.type_id, k.ix * 2 FROM numbered k
        ) v
    ),
    lbl AS (
        SELECT realize.batch(i.a, NULL) AS l FROM ids i
    )
    SELECT k.id,
           COALESCE(NULLIF(lbl.l[k.ix * 2 - 1], ''), 'Unrealized entity'),
           COALESCE(NULLIF(lbl.l[k.ix * 2], ''), 'Unrealized type'),
           k.observations
    FROM numbered k CROSS JOIN lbl
    ORDER BY k.observations DESC, k.id;
END;
