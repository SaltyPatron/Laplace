-- chess_syzygy_line(line): the exact endgame oracle along one line.
--
-- Syzygy deposits are POSITION-GRAIN (ctx null): a tablebase verdict is a pure
-- function of the board. Packaging was unpacked into substrate records; a later
-- game that composes the same surface hits the same position id and finds
-- HAS_WDL / HAS_DTZ already there. Reading "the endgame of this line" is therefore
-- the line's trajectory positions joined to those subject-keyed facts — not a
-- context-pinned scan of line-scoped probes (that was the vault-sidecar mistake).
--
-- WDL is five-valued and SIDE-TO-MOVE POV, not white POV: 'win' means the player to
-- move in that position wins with perfect play. It is never mixed with the OUTCOME
-- fold's white-POV eff_mu, which is why this returns the token rather than a number.
--
-- Typed accessors below own the single relation_type_id('…') literals for this
-- vocabulary (ISA G3). New chess SQL must call these — never re-type the strings.
DROP FUNCTION IF EXISTS chess_has_wdl_type();
DROP FUNCTION IF EXISTS chess_has_dtz_type();
DROP FUNCTION IF EXISTS chess_syzygy_line(bytea, integer);

CREATE OR REPLACE FUNCTION chess_has_wdl_type() RETURNS bytea
    LANGUAGE sql STABLE PARALLEL SAFE
 AS $$
    SELECT laplace.relation_type_id('HAS_WDL')
$$;

CREATE OR REPLACE FUNCTION chess_has_dtz_type() RETURNS bytea
    LANGUAGE sql STABLE PARALLEL SAFE
 AS $$
    SELECT laplace.relation_type_id('HAS_DTZ')
$$;

CREATE OR REPLACE FUNCTION chess_syzygy_line(p_line bytea, p_limit int DEFAULT 64)
    RETURNS TABLE(position_id bytea, wdl text, dtz text)
    LANGUAGE sql STABLE
 AS $$
WITH rel AS MATERIALIZED (
    SELECT laplace.chess_has_wdl_type() AS wdl, laplace.chess_has_dtz_type() AS dtz
),
line AS MATERIALIZED (
    SELECT u.ord AS ordinal, u.entity_id AS pos
    FROM LATERAL laplace.trajectory_unpacked_points(p_line)
         WITH ORDINALITY AS u(entity_id, run_length, ctier, ord)
),
probed AS MATERIALIZED (
    SELECT l.pos,
           max(a.object_id) FILTER (WHERE a.type_id = r.wdl) AS wdl_id,
           max(a.object_id) FILTER (WHERE a.type_id = r.dtz) AS dtz_id,
           min(l.ordinal) AS ord
    FROM line l
    JOIN rel r ON true
    JOIN laplace.attestations a ON a.subject_id = l.pos
                       AND a.type_id IN (r.wdl, r.dtz)
    GROUP BY l.pos
    HAVING max(a.object_id) FILTER (WHERE a.type_id = r.wdl) IS NOT NULL
    ORDER BY min(l.ordinal)
    LIMIT p_limit
),
ord AS MATERIALIZED (
    SELECT p.*, row_number() OVER (ORDER BY p.ord) AS ix FROM probed p
),
surfaces AS MATERIALIZED (
    SELECT COALESCE(array_agg(DISTINCT s), '{}'::bytea[]) AS ids
    FROM ord o, LATERAL (VALUES (o.wdl_id), (o.dtz_id)) v(s)
    WHERE s IS NOT NULL
),
label AS MATERIALIZED (
    SELECT p.id, t.txt
    FROM surfaces b,
         LATERAL unnest(b.ids) WITH ORDINALITY AS p(id, i),
         LATERAL unnest(laplace.realize_batch(b.ids, NULL)) WITH ORDINALITY AS t(txt, j)
    WHERE p.i = t.j
)
SELECT o.pos, w.txt, d.txt
FROM ord o
LEFT JOIN label w ON w.id = o.wdl_id
LEFT JOIN label d ON d.id = o.dtz_id
ORDER BY o.ix
$$;
