-- explore_anchor_neighbors: neighbour search from a COMPUTED anchor geometry,
-- not a stored one. When a word (or any content) is typed but never witnessed,
-- its content hash resolves to an id with no laplace.entities/laplace.physicalities row
-- (exists = false) -- yet its geometry is fully determined: HashComposer pins
-- every codepoint on S3 from the t0 perfcache and composes the parent coord and
-- trajectory in-process. The endpoint hands that computed anchor here as bound
-- parameters (centroid coord + optional trajectory WKT), so the KNN runs on a
-- real index-ordered scan (bound param, GiST-eligible -- unlike a correlated
-- subquery anchor) instead of returning nothing for want of a stored row.
--
-- Two axes, deliberately different notions of "near" (both returned so the UI
-- can navigate either way):
--   geodesic -- nearest witnessed content of ANY tier by the anchor centroid on
--     the glome. Positional/content proximity; centroids commute, so it mixes
--     tiers/modalities. Fast: index-ordered coord <<->> prefilter.
--   shape    -- nearest witnessed WORDS by REALIZED curve shape (Frechet over
--     laplace_curve = the line(child.coord ORDER BY ordinal)). p_traj_wkt from
--     ExploreDecomposeService is already a realized LINESTRING ZM of child
--     coords; candidates must use laplace_curve, never packed
--     laplace.physicalities.trajectory (Rule #3 / Issue 51).
CREATE OR REPLACE FUNCTION structural.explore_anchor_neighbors(
    p_cx float8, p_cy float8, p_cz float8, p_cm float8,
    p_traj_wkt   text    DEFAULT NULL,
    p_geodesic_k integer DEFAULT 12,
    p_frechet_k  integer DEFAULT 12,
    p_frechet_max float8  DEFAULT 0.08)
RETURNS TABLE(
    axis        text,
    entity_id   bytea,
    label       text,
    tier        smallint,
    geodesic    float8,
    frechet     float8)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH params AS MATERIALIZED (
        SELECT public.ST_MakePoint(p_cx,p_cy,p_cz,p_cm) AS anchor,
          CASE WHEN p_traj_wkt IS NULL OR p_traj_wkt='' THEN NULL::geometry
               ELSE public.ST_GeomFromText(p_traj_wkt) END AS curve
    ), geo AS MATERIALIZED (
        SELECT n.* FROM params p CROSS JOIN LATERAL structural.angular_nearest(p.anchor,p_geodesic_k) n
    ), shape_candidates AS MATERIALIZED (
        SELECT n.* FROM params p CROSS JOIN LATERAL structural.angular_nearest(p.anchor,p_frechet_k) n
        WHERE p.curve IS NOT NULL
    ), curves AS MATERIALIZED (
        SELECT c.id,c.curve FROM public.laplace_curve(ARRAY(SELECT DISTINCT public.blake3_from_bytea(entity_id) FROM shape_candidates ORDER BY 1)) c
    ), shapes AS MATERIALIZED (
        SELECT n.*,public.laplace_frechet_4d(cv.curve,p.curve) AS shape
        FROM shape_candidates n CROSS JOIN params p
        LEFT JOIN curves cv ON cv.id=public.blake3_from_bytea(n.entity_id)
    ), admitted AS MATERIALIZED (
        SELECT 'geodesic'::text AS axis,entity_id,tier,distance AS geodesic,NULL::float8 AS frechet FROM geo
        UNION ALL SELECT 'shape',entity_id,tier,NULL::float8,shape FROM shapes WHERE shape<=p_frechet_max
    ), labels AS MATERIALIZED (
        SELECT * FROM public.laplace_labels(ARRAY(SELECT DISTINCT public.blake3_from_bytea(entity_id) FROM admitted ORDER BY 1))
    )
    SELECT a.axis,a.entity_id,coalesce(l.content,'Unrealized entity'),a.tier,a.geodesic,a.frechet
    FROM admitted a LEFT JOIN labels l ON l.entity=public.blake3_from_bytea(a.entity_id)
    ORDER BY a.axis,a.geodesic,a.frechet,a.entity_id;
END;
