-- The walk/export weight is one native law: signed Glicko expectation around
-- neutral. Consensus rating/RD already fold the observation history; no second
-- witness saturation or RD-decay knob may enter the result.
BEGIN;
SELECT consensus.glicko2_neutral_mu() = 1500000000000 AS neutral_matches_engine,
       to_regprocedure('consensus.foundry_witness_sat(bigint)') IS NULL AS witness_knob_retired,
       to_regprocedure('consensus.foundry_rd_kappa()') IS NULL AS rd_knob_retired;
 neutral_matches_engine | witness_knob_retired | rd_knob_retired 
------------------------+----------------------+-----------------
 t                      | t                    | t
(1 row)

-- The signed weight and [0,1] strength are the same Glicko expectation with
-- different ranges.
SELECT bool_and(
         consensus.walk_edge_weight(r, d)
         = 2.0 * consensus.edge_strength(r, d) - 1.0
       ) AS signed_weight_matches_strength
FROM (VALUES
    (1600000000000::bigint,  30000000000::bigint),
    (1600000000000::bigint, 350000000000::bigint),
    (1400000000000::bigint,  30000000000::bigint),
    (1500000000000::bigint,  80000000000::bigint),
    (2010500000000::bigint,  12000000000::bigint)
) v(r, d);
 signed_weight_matches_strength 
--------------------------------
 t
(1 row)

SELECT consensus.walk_edge_weight(1600000000000, 350000000000) > 0 AS wide_rd_win_stays_walkable,
       consensus.walk_edge_weight(1400000000000,  30000000000) < 0 AS refutation_is_negative,
       consensus.walk_edge_weight(1500000000000,  80000000000) = 0 AS neutral_is_zero,
       consensus.walk_edge_weight(1600000000000,  30000000000)
         > consensus.walk_edge_weight(1600000000000, 350000000000) AS rd_attenuates,
       to_regprocedure('consensus.walk_edge_weight(bigint,bigint,bigint)') IS NULL
         AND to_regprocedure('consensus.walk_edge_weight(bigint,bigint,bigint,double precision)') IS NULL
         AS legacy_weight_overloads_retired;
 wide_rd_win_stays_walkable | refutation_is_negative | neutral_is_zero | rd_attenuates | legacy_weight_overloads_retired 
----------------------------+------------------------+-----------------+---------------+---------------------------------
 t                          | t                      | t               | t             | t
(1 row)

SELECT consensus.walk_edge_weight(1600000000000, 350000000000)::numeric
       <> consensus.eff_mu(1600000000000, 350000000000)::numeric AS weight_is_not_eff_mu,
       consensus.eff_mu(1600000000000, 350000000000) = 900000000000 AS eff_mu_unchanged;
 weight_is_not_eff_mu | eff_mu_unchanged 
----------------------+------------------
 t                    | t
(1 row)

ROLLBACK;
