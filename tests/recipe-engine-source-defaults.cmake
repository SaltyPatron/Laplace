cmake_minimum_required(VERSION 3.24)
if(NOT SOURCE OR NOT WORK)
    message(FATAL_ERROR "SOURCE and WORK are required")
endif()
if(NOT SELECTOR)
    set(SELECTOR "${SOURCE}/cmake/LaplaceRecipeEngine.cmake")
endif()
if(NOT NATIVE_SELECTOR)
    set(NATIVE_SELECTOR "${SOURCE}/cmake/LaplaceNativeSource.cmake")
endif()
foreach(pair IN ITEMS a b)
    file(MAKE_DIRECTORY "${WORK}/${pair} tree/Laplace-Native" "${WORK}/${pair} tree/Laplace-Engine")
endforeach()
file(WRITE "${WORK}/a tree/Laplace-Engine/value.c" "int main(void) { return 17; }\n")
file(WRITE "${WORK}/b tree/Laplace-Engine/value.c" "int main(void) { return 23; }\n")
file(MAKE_DIRECTORY "${WORK}/fallback/laplace-native" "${WORK}/fallback/Laplace-Engine")
file(WRITE "${WORK}/fallback/Laplace-Engine/value.c" "int main(void) { return 99; }\n")
file(MAKE_DIRECTORY "${WORK}/consumer")
file(WRITE "${WORK}/consumer/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(RecipeSourceSelection C)
if(DEFINED PARENT_NATIVE)
    set(LAPLACE_NATIVE "${PARENT_NATIVE}")
endif()
include("${NATIVE_SELECTOR}")
if(DEFINED PARENT_ENGINE)
    set(LAPLACE_RECIPE_ENGINE_SOURCE "${PARENT_ENGINE}")
endif()
include("${SELECTOR}")
add_executable(consumer "${LAPLACE_RECIPE_ENGINE_SOURCE}/value.c")
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/executable.txt" CONTENT "$<TARGET_FILE:consumer>")
]=])
set(native_a "${WORK}/a tree/Laplace-Native")
set(native_b "${WORK}/b tree/Laplace-Native")
set(engine_a "${WORK}/a tree/Laplace-Engine")
set(engine_b "${WORK}/b tree/Laplace-Engine")
function(configure name native environment)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "LAPLACE_RECIPE_ENGINE_SOURCE=${environment}" "LAPLACE_NATIVE=${native}"
        "${CMAKE_COMMAND}" -S "${WORK}/consumer" -B "${WORK}/${name}" -G Ninja
        "-DSELECTOR=${SELECTOR}" "-DNATIVE_SELECTOR=${NATIVE_SELECTOR}" "-DLAPLACE_EXTERNAL=${WORK}/fallback" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Configure failed: ${output}\n${error}")
    endif()
endfunction()
function(check name expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}/${name}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Build failed: ${output}\n${error}")
    endif()
    file(READ "${WORK}/${name}/executable.txt" executable)
    execute_process(COMMAND "${executable}" RESULT_VARIABLE actual)
    if(NOT actual EQUAL expected)
        message(FATAL_ERROR "Selected recipe Engine returned ${actual}, expected ${expected}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()
configure(default "${native_a}" "")
check(default 17)
file(READ "${WORK}/default/CMakeCache.txt" cache)
if(cache MATCHES "\nLAPLACE_RECIPE_ENGINE_SOURCE:" OR cache MATCHES "\nLAPLACE_NATIVE:")
    message(FATAL_ERROR "An implicit Native/Engine source was persisted in the cache")
endif()
file(READ "${WORK}/default/executable.txt" executable)
file(TIMESTAMP "${executable}" before "%s" UTC)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
configure(default "${native_a}" "")
check(default 17)
file(TIMESTAMP "${executable}" after "%s" UTC)
if(NOT before STREQUAL after OR NOT last_output MATCHES "no work to do")
    message(FATAL_ERROR "Unchanged Engine selection rebuilt the consumer: ${last_output}")
endif()
configure(default "${native_b}" "")
check(default 23)
configure(default "${native_b}" "${engine_a}")
check(default 17)
configure(explicit "${native_a}" "${engine_b}" "-DLAPLACE_RECIPE_ENGINE_SOURCE:PATH=${engine_a}")
check(explicit 17)
configure(explicit "${native_b}" "${engine_b}")
check(explicit 17)
configure(explicit "${native_b}" "${engine_b}" -ULAPLACE_RECIPE_ENGINE_SOURCE)
check(explicit 23)
configure(parent "${native_a}" "${engine_a}" "-DPARENT_ENGINE=${engine_b}"
    "-DLAPLACE_RECIPE_ENGINE_SOURCE:PATH=${engine_a}")
check(parent 23)
configure(native_explicit "${native_b}" "" "-DLAPLACE_NATIVE:PATH=${native_a}")
check(native_explicit 17)
configure(native_explicit "${native_b}" "")
check(native_explicit 17)
configure(native_explicit "${native_b}" "" -ULAPLACE_NATIVE)
check(native_explicit 23)
configure(native_parent "${native_b}" "" "-DPARENT_NATIVE=${native_a}" "-DLAPLACE_NATIVE:PATH=${native_b}")
check(native_parent 17)
configure(fallback "" "")
check(fallback 99)
message(STATUS "Native/Engine selection: changed environment/sibling defaults, explicit cache, cache removal, parent precedence, fallback and unchanged no-work build passed")
