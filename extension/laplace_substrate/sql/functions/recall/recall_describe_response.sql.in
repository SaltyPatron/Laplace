DROP FUNCTION IF EXISTS laplace.recall_describe_response(bytea);
CREATE OR REPLACE FUNCTION converse.recall_describe_response(p_topic bytea)
    RETURNS TABLE(reply text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    -- Description and inspection consume the same source-defined claims and
    -- containment provenance. A missing legacy relation-registry entry must
    -- not turn recorded canonical evidence into "no relation consensus".
    SELECT concat_ws(': ',NULLIF(d.type_label,''),d.object_label), d.eff_mu, d.witness_count
    FROM ops.evidence_receipt(p_topic,24) d;
END;
