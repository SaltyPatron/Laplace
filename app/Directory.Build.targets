<Project>
  <PropertyGroup>
    <LaplaceRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</LaplaceRepoRoot>
    <LaplaceBuildWin Condition="'$(LAPLACE_ENGINE_BUILD)' != ''">$(LAPLACE_ENGINE_BUILD)</LaplaceBuildWin>
    <LaplaceBuildWin Condition="'$(LaplaceBuildWin)' == ''">$(LaplaceRepoRoot)\build-win</LaplaceBuildWin>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)NativeTestBootstrap.cs" />
  </ItemGroup>

  



  <!-- Copy each native DLL AND its PDB into the project output so it loads and a crash
       symbolizes. SkipUnchangedFiles is OFF on purpose: MSBuild's "unchanged" test is
       timestamp+size, so a rebuild that produced byte-different native code with an
       unchanged timestamp would be silently SKIPPED, leaving stale native code loaded
       against fresh managed code. The source is authoritative — always overwrite. This
       still does NOT cover a no-build `dotnet run` (which skips the Build target and
       therefore this copy entirely); the durable fix for that is loading the native lib
       from a single canonical path instead of fan-copying, tracked separately. -->
  <Target Name="LaplaceCopyNativeLibs" AfterTargets="Build" BeforeTargets="GenerateOpenApiDocuments"
          Condition="Exists('$(LaplaceBuildWin)\core\laplace_core.dll')">
    <Copy SourceFiles="$(LaplaceBuildWin)\core\laplace_core.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(LaplaceBuildWin)\core\laplace_core.pdb"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="false"
          Condition="Exists('$(LaplaceBuildWin)\core\laplace_core.pdb')" />
    <Copy SourceFiles="$(LaplaceBuildWin)\dynamics\laplace_dynamics.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="false"
          Condition="Exists('$(LaplaceBuildWin)\dynamics\laplace_dynamics.dll')" />
    <Copy SourceFiles="$(LaplaceBuildWin)\dynamics\laplace_dynamics.pdb"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="false"
          Condition="Exists('$(LaplaceBuildWin)\dynamics\laplace_dynamics.pdb')" />
    <Copy SourceFiles="$(LaplaceBuildWin)\synthesis\laplace_synthesis.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="false"
          Condition="Exists('$(LaplaceBuildWin)\synthesis\laplace_synthesis.dll')" />
    <Copy SourceFiles="$(LaplaceBuildWin)\synthesis\laplace_synthesis.pdb"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="false"
          Condition="Exists('$(LaplaceBuildWin)\synthesis\laplace_synthesis.pdb')" />
    <!-- The Syzygy probe kernel: its own library precisely because it must NOT ride
         laplace_core into the PostgreSQL backend, which means it needs its own copy
         line here — omitting it is a DllNotFoundException at the first probe. -->
    <Copy SourceFiles="$(LaplaceBuildWin)\core\laplace_syzygy.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="false"
          Condition="Exists('$(LaplaceBuildWin)\core\laplace_syzygy.dll')" />
    <Copy SourceFiles="$(LaplaceBuildWin)\core\laplace_syzygy.pdb"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="false"
          Condition="Exists('$(LaplaceBuildWin)\core\laplace_syzygy.pdb')" />
  </Target>
  <!-- Publish output is a separate directory from OutDir. Native libraries copied
       by the Build target do not automatically become published SDK items. -->
  <Target Name="LaplacePublishWindowsRuntime" AfterTargets="Publish"
          Condition="'$(OS)' == 'Windows_NT' AND '$(OutputType)' == 'Exe' AND '$(IsTestProject)' != 'true'">
    <ItemGroup>
      <LaplacePublishedNative Include="$(LaplaceBuildWin)\core\laplace_core.dll" />
      <LaplacePublishedNative Include="$(LaplaceBuildWin)\core\laplace_syzygy.dll" />
      <LaplacePublishedNative Include="$(LaplaceBuildWin)\dynamics\laplace_dynamics.dll" />
      <LaplacePublishedNative Include="$(LaplaceBuildWin)\synthesis\laplace_synthesis.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(LaplacePublishedNative.Identity)')"
           Text="Missing native publish input: %(LaplacePublishedNative.Identity). Build the selected native runtime before publishing." />
    <Copy SourceFiles="@(LaplacePublishedNative)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
    <Exec Command="&quot;$(LaplaceRepoRoot)\scripts\win\engine-runtime.cmd&quot; &quot;$(PublishDir)&quot;" />
    <Exec Command="pwsh -NoProfile -File &quot;$(LaplaceRepoRoot)\scripts\win\publish-zstd.ps1&quot; -Destination &quot;$(PublishDir).&quot;" />
    <ItemGroup>
      <LaplacePublishedPerfcache Include="$(LaplaceBuildWin)\core\perfcache\tier0.bin" />
      <LaplacePublishedPerfcache Include="$(LaplaceBuildWin)\core\perfcache\highway.bin" />
      <LaplacePublishedPerfcache Include="$(LaplaceBuildWin)\core\perfcache\laplace_chess_position_perfcache.bin" />
      <LaplacePublishedPerfcache Include="$(LaplaceBuildWin)\core\perfcache\laplace_chess_transition_perfcache.bin" />
    </ItemGroup>
    <Error Condition="!Exists('%(LaplacePublishedPerfcache.Identity)')"
           Text="Missing required runtime perfcache: %(LaplacePublishedPerfcache.Identity). Build the selected native runtime before publishing." />
    <Copy SourceFiles="@(LaplacePublishedPerfcache)"
          DestinationFolder="$(PublishDir)\share\laplace" SkipUnchangedFiles="false" />
  </Target>
</Project>
