@startuml
!pragma layout smetana
skinparam backgroundColor #FAFCFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #385978
skinparam componentBackgroundColor #E6EFF7
skinparam classBackgroundColor #E6EFF7
title Observe Calculate Realize — specified cycle
start
repeat
:resolve grammar and recipe;
:decompose exact digital content;
:lower typed AST and calculate Merkle DAG;
:deposit canonical and witnessed state;
:publish derived epochs;
:compile goal;
:calculate and search;
:select semantic act;
:recompose modality or execute effect;
:observe consequence;
repeat while (Further authorized work / evidence?) is (yes) not (no)
stop
@enduml
