SQL_QUERY("operation.argument", "", "{name} => @{slot}::{type}")
SQL_QUERY("operation.function", "", "SELECT * FROM {operation}({arguments}) LIMIT {rows}")
SQL_QUERY("operation.procedure", "", "CALL {operation}({arguments})")

