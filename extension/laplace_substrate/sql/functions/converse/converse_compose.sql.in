-- converse_compose(prompt, steps, lang, seed): S7 -- the walk frontier steers emission.
--
-- THE STAGE THIS ADDS. converse_walk already does "sequence proposes, meaning
-- steers", but its steer is a CONSTANT: every token of the topic's own gloss gets
-- weight 50, every token of a containing sentence gets 40, forever. That is a
-- provenance weight (which source did this token come from), not a semantic one --
-- it says nothing about whether a token is on-topic for THIS turn. The walker is
-- therefore unsteered in the only sense that matters, and the result is retrieval:
-- measured 2026-07-25, converse_walk('dog') returned the same byte-identical
-- sequence for seeds 7 and 991, i.e. it replays one attested sentence rather than
-- recombining. That constant IS the missing forward pass, and it is one array.
--
-- Here the weight vector is derived from the SEMANTIC FRONTIER instead: walk the
-- topic's consensus neighbourhood, and weight each stream token by how strongly the
-- concept it belongs to sits in that frontier. Sequence still proposes (the native
-- trigram->bigram backoff is untouched); meaning now actually steers, per emitted
-- step, against evidence computed for this turn.
--
-- WHY A SEPARATE FUNCTION. converse_walk stays exactly as it is. This is additive so
-- it can be measured against the incumbent on the same prompts and seeds before
-- anything is rewired. Editing the live path first is what shipped a regression
-- earlier in this session; the lesson is cheap to apply.
--
-- CONCEPT vs SURFACE (spec 36 §3.1). The frontier is concept-level and language-free.
-- Realization picks surfaces at the very end, honouring p_lang -- an ILI is an
-- equivalence class spanning every language that witnesses it, so nothing but the
-- final render decides which member is emitted.
--
-- SCALING. eff_mu arrives in the fold's internal units (~1e12) and steered_walk_raw
-- wants an int8 weight multiplied by a 0..100000 hash. The /1e10 below is a UNITS
-- CONVERSION chosen so frontier salience lands in the same order of magnitude as the
-- existing provenance weights (40-50), not a tuning knob and not a floor -- it
-- rescales every candidate identically and changes no ordering. Non-frontier tokens
-- keep their provenance weight and stay eligible: weight 0 would exclude them
-- outright, since the native score is multiplicative.
--
-- NOT YET MEASURED. Written against the same stream/weights contract converse_walk
-- uses, but its output has NOT been compared to the incumbent. The gate is: does it
-- produce DIFFERENT text for different seeds (recombination rather than replay), and
-- does that text stay on topic. Do not wire this into chat() until that run exists.
-- Signature change (p_ctx added): the 4-arg form must not survive as a second
-- overload or every 4-arg call site becomes "function is not unique".
DROP FUNCTION IF EXISTS converse_compose(text, int, bytea, bigint);

CREATE OR REPLACE FUNCTION converse_compose(p_prompt text,
                                            p_steps int DEFAULT 40,
                                            p_lang bytea DEFAULT NULL,
                                            p_seed bigint DEFAULT NULL,
                                            p_ctx bytea[] DEFAULT NULL)
    RETURNS text
    LANGUAGE plpgsql VOLATILE
    SET search_path = @extschema@, public AS $$
DECLARE
    b_def  int := 1;
    -- The compose frontier's content bands — definitional, taxonomic,
    -- partitive, associative — named once; G8 forbids band literals at
    -- relation_highway_band call sites.
    content_bands int[] := ARRAY[1, 2, 4, 7];
    SENT   bytea := '\x00';
    MINLEN int := 5;
    syn    bytea;
    topic_word bytea;
    stream bytea[];
    w      bigint[];
    starts bytea[];
    core_seq bytea[];
    n      int;
    rng    bigint;
    out_ids bytea[];
BEGIN
    -- ORIENT. Same hash-space signal chat() uses: how strongly the token denotes the
    -- sense, then highway-mask breadth. No realize(), no surface comparison.
    -- Two levels: breadth picks WHICH TOKEN, denote_mu picks WHICH SENSE of it.
    -- Ranking every (token, sense) pair by breadth selects obscure/slang senses that
    -- happen to be wired into more relation types -- it resolved `dog` to SIRE, which
    -- made this function seed from the wrong gloss entirely and rendered the whole
    -- steer comparison meaningless. Mirrors chat()'s orientation exactly.
    SELECT y.tok, y.syn INTO topic_word, syn
    FROM (
        SELECT DISTINCT ON (x.tok)
               x.tok, x.syn, x.denote_mu, x.tok_breadth
        FROM (
            SELECT p.id AS tok, s.synset_id AS syn, s.eff_mu AS denote_mu,
                   max(laplace_highway_popcount(e.highway_mask))
                       OVER (PARTITION BY p.id) AS tok_breadth
            FROM prompt_state(p_prompt) p
            CROSS JOIN LATERAL senses(p.id) s
            LEFT JOIN entities e ON e.id = s.synset_id
            WHERE p.id IS NOT NULL AND s.synset_id IS NOT NULL
        ) x
        ORDER BY x.tok, x.denote_mu DESC NULLS LAST, x.syn
    ) y
    ORDER BY y.tok_breadth DESC NULLS LAST, y.denote_mu DESC NULLS LAST, y.syn
    LIMIT 1;
    IF syn IS NULL THEN RETURN NULL; END IF;

    WITH
    -- FRONTIER: the topic's consensus neighbourhood, both directions, over the
    -- content bands. This is the turn's semantic plan -- concept-level, language-free.
    frontier AS MATERIALIZED (
        SELECT c.object_id AS cid, eff_mu(c.rating, c.rd) AS mu
        FROM consensus c
        WHERE c.subject_id = syn AND relation_highway_band(c.type_id) = ANY (content_bands)
        UNION ALL
        SELECT c.subject_id, eff_mu(c.rating, c.rd)
        FROM consensus c
        WHERE c.object_id = syn AND relation_highway_band(c.type_id) = ANY (content_bands)
        UNION ALL
        SELECT syn, (SELECT max(eff_mu(c2.rating, c2.rd)) FROM consensus c2
                     WHERE c2.subject_id = syn)
        -- BIOGRAPHY ARMS (R7 slice 2, GH #759): the session's recent topics
        -- join the turn's frontier with RECENCY-DECAYED weight — attention
        -- over context in the Q slot, not just in orientation. p_ctx arrives
        -- most-recent-first (chat() passes session_trajectory order), and
        -- ordinality IS the recency distance: /2 per step back, so the last
        -- turn's topic steers at half the live topic's scale and a topic
        -- four turns back is a whisper. Same bands, same fold-produced mu,
        -- same frontier_agg merge (max keeps the strongest claim on a
        -- concept two topics share). NULL/empty ctx contributes zero rows —
        -- a fresh session composes exactly as before this change. The live
        -- topic is excluded HERE, where syn is known — chat() filters its
        -- own carried topic, but this function re-elects syn independently,
        -- and a caller whose ctx happens to contain the elected topic would
        -- double-count it at full-plus-decayed weight (Copilot, PR #896).
        UNION ALL
        SELECT c.object_id, eff_mu(c.rating, c.rd) / (2 ^ x.dist)
        FROM unnest(COALESCE(p_ctx, ARRAY[]::bytea[])) WITH ORDINALITY x(cid, dist)
        JOIN consensus c ON c.subject_id = x.cid
                        AND relation_highway_band(c.type_id) = ANY (content_bands)
        WHERE x.cid <> syn
        UNION ALL
        SELECT c.subject_id, eff_mu(c.rating, c.rd) / (2 ^ x.dist)
        FROM unnest(COALESCE(p_ctx, ARRAY[]::bytea[])) WITH ORDINALITY x(cid, dist)
        JOIN consensus c ON c.object_id = x.cid
                        AND relation_highway_band(c.type_id) = ANY (content_bands)
        WHERE x.cid <> syn
        UNION ALL
        SELECT x.cid, (SELECT max(eff_mu(c2.rating, c2.rd)) FROM consensus c2
                       WHERE c2.subject_id = x.cid) / (2 ^ x.dist)
        FROM unnest(COALESCE(p_ctx, ARRAY[]::bytea[])) WITH ORDINALITY x(cid, dist)
        WHERE x.cid <> syn
    ),
    -- The frontier is concepts and — since the concept-stream change — so is
    -- the stream: steering matches DIRECTLY in concept space (GH #751, slot
    -- map: the stream is language-free). The old frontier_words projection
    -- down to surface members is gone with the word-level stream it served.
    frontier_agg AS MATERIALIZED (
        SELECT f.cid, max(f.mu) AS mu FROM frontier f GROUP BY f.cid
    ),
    gids AS (
        SELECT DISTINCT g.gid, g.wt, g.is_core FROM (
            SELECT c.object_id AS gid, 50::bigint AS wt, true AS is_core
            FROM consensus c
            WHERE c.subject_id = syn AND relation_highway_band(c.type_id) = b_def
            UNION ALL
            SELECT co.entity_id, 40, false
            FROM containers_of(topic_word, 1, 400) co
            WHERE co.tier = 3
            ORDER BY is_core DESC, gid
            LIMIT 160
        ) g
    ),
    toks AS (
        SELECT g.gid, g.wt, g.is_core, u.entity_id, u.ord
        FROM gids g
        CROSS JOIN LATERAL trajectory_unpacked_points(g.gid)
             WITH ORDINALITY AS u(entity_id, run_length, ctier, ord)
        WHERE u.ctier = 2
    ),
    -- Whitespace-ness through the ONE installed definition, on the fast renderer.
    -- The inline `~ '^\s*$'` was a second definition of "is whitespace" living in
    -- a read path, and it rendered to depth 64 to answer a question about the
    -- first character.
    --
    -- NOT converted to the id-space HAS_GENERAL_CATEGORY classification that
    -- corpus_whitespace_vocab_indices uses: that reads Unicode general category,
    -- which is attested on CODEPOINTS, and toks is filtered to ctier = 2 (words).
    -- Every probe would miss, return NULL, and fall through to this same render
    -- with an extra join paid first. Classification on ids is right where the ids
    -- carry the class; here they do not, and pretending otherwise buys a slower
    -- query with identical output.
    ws AS MATERIALIZED (
        SELECT d.entity_id AS id,
               is_all_whitespace(COALESCE(render_text_fast(d.entity_id, 8), ' ')) AS is_ws
        FROM (SELECT DISTINCT t.entity_id FROM toks t) d
    ),
    kept AS MATERIALIZED (
        SELECT q.* FROM (
            SELECT t.gid, t.wt, t.is_core, t.entity_id,
                   row_number() OVER (PARTITION BY t.gid ORDER BY t.ord) AS rn,
                   count(*)    OVER (PARTITION BY t.gid) AS cnt
            FROM toks t JOIN ws ON ws.id = t.entity_id
            WHERE NOT ws.is_ws
        ) q WHERE q.cnt >= 2
    ),
    -- CONCEPT STREAM (GH #751; slot map: Embed is per-tier, the stream is
    -- language-free). Each distinct kept word maps to its best sense; words
    -- with no sense (numbers, names, glue) keep their surface id, so
    -- realization still has something to print. Election context is the
    -- token alone — EVIDENCE BEFORE ADJUDICATED STRENGTH, mirroring
    -- senses()'s own ORDER BY (witnesses, then eff_mu; the urine-over-water
    -- election in senses.sql.in is why strength alone mis-elects on
    -- one-witness exact ties). Contextual salience is Phase 3 (R3).
    -- senses() per DISTINCT token rides the same documented tolerance as
    -- the orientation above, until the C port (#757). The payoff is the
    -- LM-Head slot: realize(concept, p_lang) finally gets to choose the
    -- language member instead of parroting the witness's surface — p_lang
    -- bites.
    concept_map AS MATERIALIZED (
        SELECT d.id AS wid,
               COALESCE(
                   (SELECT s.synset_id FROM senses(d.id) s
                     ORDER BY s.witnesses DESC, s.eff_mu DESC NULLS LAST,
                              s.synset_id LIMIT 1),
                   d.id) AS cid
        FROM (SELECT DISTINCT k.entity_id AS id FROM kept k) d
    ),
    seq AS MATERIALIZED (
        -- THE STEER. Provenance weight (which source) PLUS frontier salience
        -- (how on-topic this turn) — matched in concept space, no surface
        -- projection. An off-frontier token stays eligible; a token whose
        -- concept the frontier actually holds pulls harder.
        SELECT k.gid, k.is_core,
               k.wt + COALESCE((fa.mu / 1e10)::bigint, 0) AS wt,
               cm.cid AS id, k.rn
        FROM kept k
        JOIN concept_map cm ON cm.wid = k.entity_id
        LEFT JOIN frontier_agg fa ON fa.cid = cm.cid
        UNION ALL
        SELECT DISTINCT k.gid, k.is_core, 0::bigint, SENT, 2147483647::bigint
        FROM kept k
    )
    SELECT (SELECT array_agg(s.id ORDER BY s.is_core DESC, s.gid, s.rn) FROM seq s),
           (SELECT array_agg(s.wt ORDER BY s.is_core DESC, s.gid, s.rn) FROM seq s),
           -- STARTS: first token of EVERY kept gid, core first, capped. The
           -- core-only version made single-gloss topics deterministic replays:
           -- starts_n == 1, so the seed's start pick had nothing to choose and
           -- the walk replayed the one gloss chain byte-identically for every
           -- seed (GH #751 — 'dog'/'water'/'king' measured variance 1/3, while
           -- multi-anchor prompts recombined fine). Usage-sentence starts were
           -- already sanctioned as this column's own no-core fallback; widening
           -- makes them unconditional, which is what "recombination rather
           -- than replay" requires. Acceptance: the W5 lane detector printed by
           -- every deploy flips variance 1/3 -> 3/3 on the probe topics.
           (SELECT array_agg(k1.cid ORDER BY k1.is_core DESC, k1.gid)
            FROM (SELECT cm.cid, k0.is_core, k0.gid
                  FROM kept k0 JOIN concept_map cm ON cm.wid = k0.entity_id
                  WHERE k0.rn = 1
                  ORDER BY k0.is_core DESC, k0.gid
                  LIMIT 32) k1),
           (SELECT array_agg(cm.cid ORDER BY k.rn)
              FROM kept k JOIN concept_map cm ON cm.wid = k.entity_id
             WHERE k.is_core AND k.gid = (
                 SELECT k2.gid FROM kept k2 WHERE k2.is_core
                 GROUP BY k2.gid ORDER BY max(k2.cnt) DESC, k2.gid LIMIT 1))
    INTO stream, w, starts, core_seq;

    n := COALESCE(array_length(stream,1), 0);
    IF n < 3 OR starts IS NULL THEN RETURN NULL; END IF;

    rng := abs(COALESCE(p_seed, ('x'||substr(md5(p_prompt),1,8))::bit(32)::bigint)) % 2147483647;

    out_ids := steered_walk_raw(stream, w, COALESCE(core_seq, ARRAY[]::bytea[]),
                                starts, p_steps, MINLEN, rng);
    IF out_ids IS NULL OR array_length(out_ids,1) IS NULL THEN RETURN NULL; END IF;
    IF array_length(out_ids,1) = 1 THEN RETURN render_text(out_ids[1], 64); END IF;

    -- REALIZE last, and only here. p_lang selects which member of each concept's
    -- surface family is emitted; everything above ran in ids.
    RETURN btrim(regexp_replace(
        regexp_replace(
            (SELECT string_agg(COALESCE(realize(t, p_lang), render_text(t,64), ''), ' ')
             FROM unnest(out_ids) WITH ORDINALITY gg(t,o)),
            '\s*[();:]\s*', ' ', 'g'),
        '\s+', ' ', 'g'));
END;
$$;
