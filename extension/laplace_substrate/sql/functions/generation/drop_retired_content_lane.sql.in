DO $do$
DECLARE
    obj text;
BEGIN
    FOREACH obj IN ARRAY ARRAY[
        'TABLE laplace.content_pairs',
        'PROCEDURE laplace.rebuild_content_index(int)',
        'PROCEDURE laplace.rebuild_content_index_deep()',
        'PROCEDURE laplace.rebuild_content_pairs(int)']
    LOOP
        BEGIN
            EXECUTE format('ALTER EXTENSION %I DROP %s', 'laplace_substrate', obj);
        EXCEPTION WHEN OTHERS THEN
            NULL;  
        END;
    END LOOP;
    EXECUTE 'DROP TABLE IF EXISTS laplace.content_pairs';
    EXECUTE 'DROP TABLE IF EXISTS laplace.content_index';
    EXECUTE 'DROP TABLE IF EXISTS laplace.constituency_edge';
    EXECUTE 'DROP PROCEDURE IF EXISTS laplace.rebuild_content_index(int)';
    EXECUTE 'DROP PROCEDURE IF EXISTS laplace.rebuild_content_index_deep()';
    EXECUTE 'DROP PROCEDURE IF EXISTS laplace.rebuild_content_pairs(int)';
    
    
    EXECUTE 'DROP FUNCTION IF EXISTS laplace.entity_trajectory_plane(bytea[], int, int)';
    EXECUTE 'DROP FUNCTION IF EXISTS laplace.cooccurrence_scan(int, bytea[])';
END $do$;

-- 2026-07-29: the generation corpus cache and its pair tables are RETIRED.
-- gen_corpus rebuilt the trajectories into a per-backend RAM suffix array from a
-- 97M-row scan (46 min before generation.generate() emitted a token); trajectory_pairs
-- persisted the same statistics to disk behind a corpus fingerprint. Both were
-- second bodies for what laplace.physicalities.trajectory holds exactly-invertibly.
-- Replaced by generation.trajectory_continuations() (S6, path-bounded), generation.steer_candidates()
-- (S7), and relation_plane's inline export-time aggregation.
DO $do$
DECLARE
    obj text;
BEGIN
    FOREACH obj IN ARRAY ARRAY[
        'TABLE laplace.trajectory_pairs',
        'TABLE laplace.trajectory_pairs_meta',
        'FUNCTION laplace.cooccurrence_scan(int)',
        'FUNCTION laplace.cooccurrence_scan(int, bytea[])',
        'FUNCTION laplace.trajectory_cooccurrence(int)',
        'FUNCTION laplace.trajectory_cooccurrence_by_stride(int)',
        'FUNCTION laplace.trajectory_pairs_ensure(int)',
        'FUNCTION laplace.trajectory_pairs_plane(bytea[], int)',
        'FUNCTION laplace.stream_reset()',
        'FUNCTION laplace.stream_stats()',
        'FUNCTION laplace.corpus_sentence_constituents(text, int)',
        'FUNCTION laplace.corpus_sentence_constituents_since(text, int, timestamptz)']
    LOOP
        BEGIN
            EXECUTE format('ALTER EXTENSION %I DROP %s', 'laplace_substrate', obj);
        EXCEPTION WHEN OTHERS THEN
            NULL;
        END;
    END LOOP;
    EXECUTE 'DROP TABLE IF EXISTS laplace.trajectory_pairs';
    EXECUTE 'DROP TABLE IF EXISTS laplace.trajectory_pairs_meta';
    EXECUTE 'DROP FUNCTION IF EXISTS laplace.cooccurrence_scan(int)';
    EXECUTE 'DROP FUNCTION IF EXISTS laplace.cooccurrence_scan(int, bytea[])';
    EXECUTE 'DROP FUNCTION IF EXISTS laplace.trajectory_cooccurrence(int)';
    EXECUTE 'DROP FUNCTION IF EXISTS laplace.trajectory_cooccurrence_by_stride(int)';
    EXECUTE 'DROP FUNCTION IF EXISTS laplace.trajectory_pairs_ensure(int)';
    EXECUTE 'DROP FUNCTION IF EXISTS laplace.trajectory_pairs_plane(bytea[], int)';
    EXECUTE 'DROP FUNCTION IF EXISTS laplace.stream_reset()';
    EXECUTE 'DROP FUNCTION IF EXISTS laplace.stream_stats()';
    EXECUTE 'DROP FUNCTION IF EXISTS laplace.corpus_sentence_constituents(text, int)';
    EXECUTE 'DROP FUNCTION IF EXISTS laplace.corpus_sentence_constituents_since(text, int, timestamptz)';
END $do$;
