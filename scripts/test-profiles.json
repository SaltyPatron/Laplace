      "runner": "script",
      "command": [
        "bash", "-lc",
        "bash scripts/check-substrate-floor.sh \"${LAPLACE_DBNAME:-${PGDATABASE:-laplace}}\""
      ],
      "environment": "installed-seeded-runtime",
      "mutability": "shared-read",
      "shared_substrate": "required",
