-- edges(subject, ...) — THE edge read. One operation, both directions, labeled.
--
-- Before this there were ten ways to ask "what is this connected to", and they
-- disagreed on four independent axes, so every caller picked one at random or
-- hand-wrote a consensus scan:
--
--   consensus_subject_edges        raw table, outbound only, unlabeled
--   consensus_neighbors_directed   unrefuted view, outbound, types[] required
--   consensus_neighbors_undirected unrefuted view, both, types[] required
--   consensus_walk_edges           unrefuted, outbound, exclude[], RelationType antijoin
--   consensus_step_edge            unrefuted, both, but ONE edge between two ids
--   explore_web_neighbors          RAW consensus (refuted included), both
--   foundry_crawl_neighbors        RAW consensus (refuted included), outbound
--   related / related_in           unrefuted, one direction each, senses-expanded
--   related_objects                unrefuted, outbound, relation BY NAME
--
-- The axes: which table (consensus vs v_consensus_unrefuted vs
-- v_consensus_resolved), which direction, which ranking (raw eff_mu vs edge_rank
-- vs none), and whether refuted edges are included. consensus_subject_edges and
-- the two crawl feeders return refuted edges; their siblings do not. That is a
-- semantic difference, not a stylistic one, and it was never a caller's choice —
-- it was an accident of which function got reached for.
--
-- Here every axis is an explicit argument with a stated default:
--   p_direction  'out' | 'in' | 'both'      (default 'both')
--   p_types      NULL = every relation type (default NULL)
--   p_refuted    false = exclude refuted    (default false)
--   p_limit      a QUERY limit over an eff_mu ranking, never a floor
--
-- Ranking is edge_rank (relation salience x eff_mu), the readout law the serving
-- surface already uses. Labels resolve in ONE realize_batch after the limit, per
-- the rank-then-label rule — never a scalar realize per row.
CREATE OR REPLACE FUNCTION edges(
        p_subject   bytea,
        p_direction text    DEFAULT 'both',
        p_types     bytea[] DEFAULT NULL,
        p_limit     int     DEFAULT 40,
        p_refuted   boolean DEFAULT false,
        p_lang      bytea   DEFAULT NULL)
    RETURNS TABLE(direction text, relation text, neighbour_id bytea,
                  neighbour text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
    SET search_path = @extschema@, public AS $$
    WITH raw AS MATERIALIZED (
        SELECT 'out'::text AS dir, c.type_id, c.object_id AS nid,
               c.rating, c.rd, c.witness_count
        FROM consensus c
        WHERE p_direction IN ('out', 'both')
          AND c.subject_id = p_subject
          AND c.object_id IS NOT NULL
          AND (p_types IS NULL OR c.type_id = ANY (p_types))
          AND (p_refuted OR NOT refuted(c.rating, c.rd))
        UNION ALL
        SELECT 'in'::text, c.type_id, c.subject_id,
               c.rating, c.rd, c.witness_count
        FROM consensus c
        WHERE p_direction IN ('in', 'both')
          AND c.object_id = p_subject
          AND (p_types IS NULL OR c.type_id = ANY (p_types))
          AND (p_refuted OR NOT refuted(c.rating, c.rd))
    ),
    ranked AS MATERIALIZED (
        SELECT r.dir, r.type_id, r.nid, r.rating, r.rd, r.witness_count,
               row_number() OVER (ORDER BY edge_rank(r.type_id, eff_mu(r.rating, r.rd)) DESC,
                                           r.nid) AS ord
        FROM raw r
        ORDER BY edge_rank(r.type_id, eff_mu(r.rating, r.rd)) DESC, r.nid
        LIMIT p_limit
    ),
    rel AS MATERIALIZED (
        -- Relation names come from the manifest, once per DISTINCT type — a
        -- governed vocabulary of ~189, so a subject spans a handful.
        SELECT t.type_id,
               COALESCE(NULLIF(relation_canonical(t.type_id), ''), label(t.type_id)) AS relation
        FROM (SELECT DISTINCT k.type_id FROM ranked k) t
    ),
    lbl AS MATERIALIZED (
        SELECT realize_batch(array_agg(k.nid ORDER BY k.ord), p_lang) AS l
        FROM ranked k
    )
    SELECT k.dir, rel.relation, k.nid,
           COALESCE(lbl.l[k.ord], label(k.nid)),
           eff_mu_display(k.rating, k.rd),
           k.witness_count
    FROM ranked k
    JOIN rel ON rel.type_id = k.type_id
    CROSS JOIN lbl
    ORDER BY k.ord
$$;

-- Text front door. Every hand-written probe this replaced started by resolving a
-- word, and getting that wrong (word_id vs resolve vs resolve_ref) is its own
-- class of silent miss.
CREATE OR REPLACE FUNCTION edges(
        p_word      text,
        p_direction text    DEFAULT 'both',
        p_limit     int     DEFAULT 40,
        p_refuted   boolean DEFAULT false)
    RETURNS TABLE(direction text, relation text, neighbour_id bytea,
                  neighbour text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
    SET search_path = @extschema@, public AS $$
    SELECT e.direction, e.relation, e.neighbour_id, e.neighbour, e.eff_mu, e.witnesses
    FROM edges(word_id(p_word), p_direction, NULL::bytea[], p_limit, p_refuted,
               word_language(word_id(p_word))) e
$$;
