-- Incremental corpus enumeration: identical semantics to the historical
-- corpus_sentence_constituents body, plus a p_since watermark that restricts the
-- DOCUMENT/ORPHAN roots to physicalities observed at-or-after the watermark.
-- p_since = '-infinity' reproduces the full corpus exactly.
--
-- The observed_at >= p_since predicates are served by physicalities_traj_probe
-- (partial btree on observed_at WHERE type = 1 AND trajectory IS NOT NULL), so an
-- incremental refresh after N new deposits touches O(new rows), never the corpus.
-- Constituent SENTENCES of a new document are pulled regardless of their own
-- observed_at (a new doc may reference old sentences); dedup against sequences the
-- corpus already streams is the C side's job (parent-id hash set in
-- trajectory_corpus.c corpus_refresh).
--
-- p_max_orphans: an optional bound on the corpus for scoped work; <= 0 = uncapped,
-- which is the default. The name is historical -- there is no "orphan" category to
-- cap, because there is no document/sentence distinction to draw. See the body.
CREATE OR REPLACE FUNCTION corpus_sentence_constituents_since(
        p_document_source text DEFAULT '',
        p_max_orphans int DEFAULT -1,
        p_since timestamptz DEFAULT '-infinity')
    RETURNS TABLE(parent_id bytea, child_id bytea, run_length int)
    LANGUAGE sql STABLE PARALLEL RESTRICTED
    SET search_path = @extschema@, public AS $$
    -- ONE SET. There is no document/orphan distinction to make: TIER IS A FLOOR,
    -- NOT IDENTITY. A single-sentence document collapses onto its sentence --
    -- span-identical single-child wrapper IS its child, same id
    -- (TierTree.CollapseIndex / collapse_idx) -- so that tier-3 entity IS the
    -- document root. It is not a sentence that "failed to become" a document.
    --
    -- And a multi-sentence document's sentences are themselves entities with
    -- their own trajectories, by content addressing. So descending tier-4 roots
    -- to reach them (the old `doc` -> `book_sent` arms) re-derives rows this
    -- scan already has. Every corpus sequence is a trajectory-bearing entity at
    -- tier >= 3, whether or not anything contains it.
    --
    -- The previous shape encoded "document = tier 4" as identity, which is the
    -- frame the tier law exists to reject. It then needed an `orphan` category
    -- for the sentences that fell through -- i.e. for the ENTIRE single-sentence
    -- corpus (Tatoeba rows, WordNet glosses, HAS_EXAMPLE usages) -- and a knob
    -- to admit them, defaulted to excluding them all.
    WITH s AS (
        SELECT e.id
        FROM entities e
        JOIN physicalities p
          ON p.entity_id = e.id AND p.type = 1 AND p.trajectory IS NOT NULL
         AND p.observed_at >= p_since
        -- tier >= 3, not tier = 3: measured on this corpus, only 182 of 2304
        -- constituents of a tier-4 sample are tier-3, so some documents carry
        -- their word order directly with no sentence node in between. Taking
        -- tier 3 alone would silently drop those orders. Both are sequences;
        -- the C side dedups by parent id, so a document contributing its own
        -- word order alongside its sentences' is not double counting -- they
        -- are different attested orders.
        WHERE e.tier >= 3
          AND (p_document_source = '' OR EXISTS (
              SELECT 1 FROM attestations a
              WHERE a.context_id = e.id
                AND a.source_id = source_id(p_document_source)))
        -- p_max_orphans survives only as an optional bound for a scoped corpus;
        -- <= 0 means uncapped, which is the law's default (no operator floors).
        LIMIT CASE WHEN p_max_orphans > 0 THEN p_max_orphans END
    )
    SELECT pp.entity_id AS parent_id,
           u.entity_id AS child_id,
           GREATEST(u.run_length, 1)::int AS run_length
    FROM (
        SELECT DISTINCT ON (pp.entity_id) pp.entity_id, pp.trajectory
        FROM physicalities pp
        JOIN s ON s.id = pp.entity_id
        WHERE pp.type = 1 AND pp.trajectory IS NOT NULL
        ORDER BY pp.entity_id
    ) pp
    CROSS JOIN LATERAL laplace_trajectory_constituents(pp.trajectory) u
    WHERE laplace_vertex_tier(u.flags) <= 2
    ORDER BY pp.entity_id, u.ordinal
$$;
