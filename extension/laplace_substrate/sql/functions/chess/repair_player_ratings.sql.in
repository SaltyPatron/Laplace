-- Exceptional chess standing reconstruction for migrations/forensics after a
-- correctness defect. This is deliberately NOT a steady-state maintenance loop:
-- durable game/evidence observations are authority and normal reads/folds must
-- derive standing from the declared event-time recipe. Deployment does not queue
-- this procedure and no scheduled worker calls it.
--
-- The procedure is bounded to an explicit caller-supplied set of canonical player
-- subjects. Replaying the same subjects is idempotent because every selected cell
-- is reconstructed from all durable evidence and UPSERTed to canonical consensus.
CREATE OR REPLACE PROCEDURE chess.repair_player_ratings_batch(
    p_outcome bytea,
    p_played bytea,
    p_rating bytea,
    p_subjects bytea[])
AS 'MODULE_PATHNAME', 'pg_laplace_repair_player_ratings_batch'
LANGUAGE C;

DROP PROCEDURE IF EXISTS chess.repair_player_ratings(bytea, bytea, bytea);

-- Explicit retained-provenance reconstruction; preserves source calibration.
-- Recorded order is subject/type/object/observed timestamp/attestation id, with
-- one retained record per native period. No historical period grouping is invented.
CREATE OR REPLACE PROCEDURE consensus.repair_cells_batch(p_subjects bytea[], p_relations bytea[])
    AS 'MODULE_PATHNAME', 'pg_laplace_repair_consensus_cells_batch'
    LANGUAGE C;
