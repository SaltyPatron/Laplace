SQL_QUERY("owner.grant_administrator", "uuid,text",
    "WITH granted AS (INSERT INTO app.platform_roles(user_id,role) VALUES($1,'administrator') "
    "ON CONFLICT(user_id) DO UPDATE SET role=excluded.role,updated_at=now() RETURNING user_id) "
    "INSERT INTO app.platform_role_events(user_id,actor,previous_role,role) "
    "SELECT user_id,'installation-owner',$2,'administrator' FROM granted")
SQL_QUERY("identity.put_session", "text,uuid,text,bytea,timestamptz,timestamptz,timestamptz",
    "INSERT INTO app.web_sessions(session_id,user_id,tenant_id,ticket,created_at,last_seen_at,expires_at,revoked_at) "
    "VALUES($1,$2,$3,$4,$5,$6,$7,NULL) ON CONFLICT(session_id) DO UPDATE SET ticket=EXCLUDED.ticket, "
    "last_seen_at=EXCLUDED.last_seen_at,expires_at=EXCLUDED.expires_at "
    "WHERE app.web_sessions.user_id=EXCLUDED.user_id AND app.web_sessions.tenant_id=EXCLUDED.tenant_id "
