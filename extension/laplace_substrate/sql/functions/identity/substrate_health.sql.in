-- substrate_health() is called on the SEED and CI paths (db-reset, qa-isolated,
-- decomposer-gate-check.py, substrate-audit.sql, the MCP health tool). It must stay
-- cheap, and for one commit it was not: #721/#722 gave identity_law_violations() its
-- real body -- a GROUP BY over every entity, a NOT EXISTS over every entity, and
-- count(DISTINCT ST_AsBinary(trajectory)) over every physicality, which serialises
-- every trajectory to binary and hash-aggregates on it. substrate_health() counted
-- that. A leaf function changed cost class and its callers were never read.
--
-- The audit itself is correct and stays exactly as it is. What was wrong is running a
-- full-corpus audit inside a health check on a table that grows all through an ingest.
--
-- So the deep pass is OPT-IN. Default is the cheap check; identity_violations comes
-- back NULL, not 0, because "not checked" and "checked, none found" are different
-- claims and collapsing them is how the detector became a green light in the first
-- place. deep_checked says which one you got.
DROP FUNCTION IF EXISTS laplace.substrate_health();
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('laplace.substrate_health(boolean)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(ok boolean, fake_tier_bands bigint, identity_violations bigint, entities bigint, surface_present boolean, registry_relations bigint, deep_checked boolean)'
             OR proargnames IS DISTINCT FROM ARRAY['p_deep','ok','fake_tier_bands','identity_violations','entities','surface_present','registry_relations','deep_checked']::text[])) THEN
        DROP FUNCTION laplace.substrate_health(boolean);
    END IF;
END $upgrade_shape$;

CREATE OR REPLACE FUNCTION laplace.substrate_health(p_deep boolean DEFAULT false)
RETURNS TABLE(
    ok boolean,
    fake_tier_bands bigint,
    identity_violations bigint,
    entities bigint,
    surface_present boolean,
    registry_relations bigint,
    deep_checked boolean
)
LANGUAGE sql
STABLE
BEGIN ATOMIC
    -- Each verification scan runs exactly once: the planner does not
    -- common-subexpression-eliminate independent scalar subqueries in one
    -- targetlist, so deriving `ok` from the scanned columns (not re-invoking
    -- the scans inside the boolean) halves the entities passes per call.
    -- Every whole-corpus scan is deep-only: the default path reads leaf-partition
    -- estimates and point lookups, so health stays cheap while an ingest grows the
    -- tables. Unmeasured metrics are NULL, never 0.
    WITH scans AS (
        SELECT
            CASE WHEN p_deep THEN laplace.fake_tier_band_count() END AS fake_tier_bands,
            CASE WHEN p_deep
                 THEN (SELECT count(*) FROM laplace.identity_law_violations())
            END AS identity_violations,
            CASE WHEN p_deep
                 THEN (SELECT count(*) FROM laplace.entities)
                 ELSE (SELECT COALESCE(sum(GREATEST(c.reltuples, 0)::bigint), 0)::bigint
                       FROM pg_partition_tree('laplace.entities'::regclass) t
                       JOIN pg_class c ON c.oid = t.relid
                       WHERE t.isleaf)
            END AS entities,
            -- The Tier-0 surface is admitted content: a codepoint entity has a
            -- physicality. Without it nothing composes and no read can answer.
            EXISTS (
                SELECT 1 FROM laplace.physicalities
                WHERE entity_id = public.laplace_hash128_blake3('A'::bytea)
            ) AS surface_present,
            (SELECT count(*) FROM laplace.relation_registry()) AS registry_relations
    )
    SELECT
        -- A NULL identity_violations must never read as "clean": IS NOT DISTINCT FROM 0
        -- would do exactly that. Unchecked contributes nothing to ok, and deep_checked
        -- tells the caller the verdict is partial.
        (s.surface_present
         AND s.registry_relations > 0
         AND (NOT p_deep OR (s.fake_tier_bands = 0 AND s.identity_violations = 0))) AS ok,
        s.fake_tier_bands,
        s.identity_violations,
        s.entities,
        s.surface_present,
        s.registry_relations,
        p_deep AS deep_checked
    FROM scans s;
END;
