DROP FUNCTION IF EXISTS laplace.model_recipes();
CREATE OR REPLACE FUNCTION structural.model_recipes()
    RETURNS TABLE(recipe_id bytea, recipe_json text)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    WITH constants AS MATERIALIZED (
        SELECT public.laplace_hash128_blake3(convert_to('Model_Recipe', 'UTF8')) AS model_recipe_type,
               laplace.relation_type_id('ENCODES') AS encodes_type
    ), recipes AS MATERIALIZED (
        SELECT e.id
        FROM constants k
        JOIN laplace.entities e ON e.type_id = k.model_recipe_type
    ), encoded AS MATERIALIZED (
        SELECT r.id,
               (array_agg(c.object_id ORDER BY c.object_id)
                  FILTER (WHERE c.object_id IS NOT NULL))[1] AS content_id
        FROM constants k
        JOIN recipes r ON true
        JOIN laplace.consensus c
          ON c.subject_id = r.id
         AND c.type_id = k.encodes_type
        GROUP BY r.id
    ), selected AS MATERIALIZED (
        SELECT array_agg(id ORDER BY id) AS recipe_ids,
               array_agg(content_id ORDER BY id) AS content_ids
        FROM encoded
        WHERE content_id IS NOT NULL
    ), rendered AS MATERIALIZED (
        -- Callers consume complete recipe JSON, so render the elected content
        -- without a preview depth ceiling. The arrays stay position-aligned.
        SELECT recipe_ids,
               realize.render_text_batch(content_ids) AS recipe_jsons
        FROM selected
        WHERE content_ids IS NOT NULL
    )
    SELECT u.recipe_id, u.recipe_json
    FROM rendered r
    CROSS JOIN LATERAL unnest(r.recipe_ids, r.recipe_jsons)
        AS u(recipe_id, recipe_json);
END;
