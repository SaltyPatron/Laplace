-- An entity joined to its Content physicality (type 1): coordinate, Hilbert
-- key, and trajectory beside the entity row. Geometry reads (KNN, anchors,
-- peer walks) start here. No trajectory filter is applied; callers that need
-- one add it. Bounded use only: a point lookup by id or a KNN with LIMIT plans
-- as a nested loop into entities; without a selective predicate or LIMIT it
-- scans every Content physicality.
-- DROP+CREATE because CREATE OR REPLACE VIEW cannot reorder columns.
DROP VIEW IF EXISTS laplace.v_word_points CASCADE;
CREATE VIEW laplace.v_word_points AS
SELECT e.id,
       e.tier,
       e.type_id,
       e.highway_mask,
       e.created_at,
       p.id              AS physicality_id,
       p.tableoid        AS physicality_tableoid,
       p.coord,
       p.hilbert_index,
       p.trajectory,
       p.radius_origin,
       p.n_constituents,
       p.alignment_residual,
       p.source_dim,
       p.observed_at     AS physicality_observed_at
FROM laplace.entities e
JOIN laplace.physicalities p ON p.entity_id = e.id AND p.type = 1;
