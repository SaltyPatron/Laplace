-- A source's roster: an unordered bounded sample of what this witness
-- asserts, fully labeled, read through the per-leaf source_id indexes. A ranked
-- "top" would need an unbounded sort over the source's rows.
DROP FUNCTION IF EXISTS laplace.source_roster(bytea, int);

CREATE OR REPLACE FUNCTION ops.source_roster(p_source bytea, p_limit int DEFAULT 40)
    RETURNS TABLE(subject_id bytea, subject text, relation text,
                  object_id bytea, object text, observations bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT a.subject_id, a.subject_label,
           consensus.relation_canonical(a.type_id),
           a.object_id, a.object_label,
           a.observation_count
    FROM laplace.v_attestation_readable a
    WHERE a.source_id = p_source
      -- Relation-law rows (relation-type subjects) are shared by every source
      -- and would otherwise fill the sample.
      AND consensus.relation_canonical(a.subject_id) IS NULL
    LIMIT p_limit;
END;
