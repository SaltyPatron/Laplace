-- senses(word, context[]): the senses of a word, ranked BY CONTEXT.
--
-- PRIOR VERSION WAS INERT. It boosted a synset by summing eff_mu over consensus
-- rows where `subject_id = ANY(p_context)` (or object_id), i.e. it required a
-- DIRECT edge from a context entity to the synset. p_context carries WORD entities
-- and words reach synsets through HAS_SENSE -> IS_SENSE_OF, never directly, so the
-- join matched nothing and every boost was 0. Verified 2026-07-25: opposite contexts
-- ({animal,pet,bark} vs {sausage,roll,beef}) returned byte-identical rankings and
-- byte-identical scores for `dog`. It compared words to synsets when the comparison
-- has to be synset to synset.
--
-- Three lanes now, all in ID SPACE (no realize/render/label anywhere -- rendering is
-- the caller's final step, never a mid-operation string compare):
--
--   USAGE   the candidate synset OWNS a gloss or example whose word constituents
--           include a context token. Sense-resolution here is by OWNERSHIP, not
--           per-token tagging: a gloss/example hangs off exactly one synset, so a
--           word occurring inside it is already sense-resolved on the owning side.
--           This is the lane that actually discriminates.
--   FRAME   a context sense EVOKES_FRAME F and the candidate corresponds to F.
--           Frames unify across languages, so this lane is language-agnostic.
--   TAXON   candidate and a context SENSE meet within one hop over the content
--           bands -- the synset-to-synset comparison the old version was reaching
--           for and getting wrong.
--
-- Every lane is weighted by the eff_mu of the edges carrying it: trust enters
-- through the rating math, never through an operator-chosen constant. No floors,
-- no caps, no top-k -- ORDER BY only, LIMIT is the caller's.
--
-- Returns the same columns as before so existing callers are unaffected. With an
-- empty/NULL context every lane contributes nothing and the ordering degenerates to
-- the sense prior, which is the documented no-context behaviour.
CREATE OR REPLACE FUNCTION senses(p_word bytea, p_context bytea[])
    RETURNS TABLE(sense_id bytea, synset_id bytea, eff_mu numeric, witnesses bigint,
                  score numeric)
    LANGUAGE sql STABLE PARALLEL SAFE
    SET search_path = @extschema@, public AS $$
    WITH ctx AS MATERIALIZED (
        SELECT DISTINCT t AS id
        FROM unnest(COALESCE(p_context, ARRAY[]::bytea[])) AS t
        WHERE t IS NOT NULL AND t <> p_word
    ),
    -- context words resolved to their own senses: the comparison is synset<->synset.
    ctx_syn AS MATERIALIZED (
        SELECT DISTINCT s.synset_id AS sid
        FROM ctx CROSS JOIN LATERAL senses(ctx.id) s
        WHERE s.synset_id IS NOT NULL
    ),
    frame_t AS MATERIALIZED (
        SELECT id FROM relation_family_members('EVOKES_FRAME')
    ),
    cand AS MATERIALIZED (
        SELECT s.object_id AS sense_id, ss.object_id AS synset_id,
               s.rating, s.rd, s.witness_count AS w1,
               ss.witness_count AS w2
        FROM consensus s
        JOIN consensus ss ON ss.subject_id = s.object_id
                         AND ss.type_id = relation_type_id('IS_SENSE_OF')
        WHERE s.subject_id = ANY(lexical_peers(p_word))
          AND s.type_id = relation_type_id('HAS_SENSE')
    ),
    -- USAGE: candidate owns a sentence (gloss band 1 / example band 7) whose
    -- word-tier constituents include a context token.
    own_sent AS (
        SELECT DISTINCT c.subject_id AS sid, c.object_id AS gid,
               eff_mu(c.rating, c.rd) AS w
        FROM consensus c
        WHERE c.subject_id IN (SELECT synset_id FROM cand)
          AND relation_highway_band(c.type_id) IN (1, 7)
    ),
    lane_usage AS (
        SELECT os.sid, sum(os.w) AS boost
        FROM own_sent os
        CROSS JOIN LATERAL trajectory_unpacked_points(os.gid)
             WITH ORDINALITY AS u(entity_id, run_length, ctier, ord)
        WHERE u.ctier = 2 AND u.entity_id IN (SELECT id FROM ctx)
        GROUP BY os.sid
    ),
    -- FRAME: shared frame between a context sense and the candidate.
    ctx_frame AS (
        SELECT DISTINCT c.object_id AS fid, eff_mu(c.rating, c.rd) AS w
        FROM ctx_syn s
        JOIN consensus c ON c.subject_id = s.sid
        WHERE c.type_id IN (SELECT id FROM frame_t)
    ),
    lane_frame AS (
        SELECT c.subject_id AS sid, sum(cf.w) AS boost
        FROM consensus c
        JOIN ctx_frame cf ON cf.fid = c.object_id
        WHERE c.subject_id IN (SELECT synset_id FROM cand)
          AND c.type_id IN (SELECT id FROM frame_t)
        GROUP BY c.subject_id
    ),
    -- TAXON: candidate meets a context sense within one hop, either direction.
    lane_taxon AS (
        SELECT x.sid, sum(x.w) AS boost FROM (
            SELECT c.subject_id AS sid, eff_mu(c.rating, c.rd) AS w
            FROM consensus c
            WHERE c.subject_id IN (SELECT synset_id FROM cand)
              AND c.object_id IN (SELECT sid FROM ctx_syn)
              AND relation_highway_band(c.type_id) IN (2, 4, 7)
            UNION ALL
            SELECT c.object_id, eff_mu(c.rating, c.rd)
            FROM consensus c
            WHERE c.object_id IN (SELECT synset_id FROM cand)
              AND c.subject_id IN (SELECT sid FROM ctx_syn)
              AND relation_highway_band(c.type_id) IN (2, 4, 7)
        ) x
        GROUP BY x.sid
    )
    SELECT cand.sense_id,
           cand.synset_id,
           eff_mu_display(cand.rating, cand.rd),
           (cand.w1 + cand.w2)::bigint,
           round(((eff_mu(cand.rating, cand.rd)
                   + COALESCE(lu.boost, 0)
                   + COALESCE(lf.boost, 0)
                   + COALESCE(lt.boost, 0)) / 1e9)::numeric, 3)
    FROM cand
    LEFT JOIN lane_usage lu ON lu.sid = cand.synset_id
    LEFT JOIN lane_frame lf ON lf.sid = cand.synset_id
    LEFT JOIN lane_taxon lt ON lt.sid = cand.synset_id
    ORDER BY 5 DESC
$$;
