-- The strength of a strand's standing in [0, 1]: the Native conservative
-- confidence (consensus.eff_mu). One standing algebra, Laplace-Native's.
CREATE OR REPLACE FUNCTION consensus.edge_strength(p_rating double precision, p_deviation double precision)
    RETURNS double precision LANGUAGE sql LAPLACE_IMMUTABLE
BEGIN ATOMIC
    SELECT consensus.eff_mu(p_rating, p_deviation);
END;
