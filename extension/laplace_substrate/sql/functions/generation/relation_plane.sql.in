-- 2026-07-09 vocab pushdown: the foundry read every consensus row of a type
-- over the wire so the client could keep the ~1% whose endpoints are in the
-- synthesis vocab (12 relation heads = 27.5M rows scanned, 358K kept, 550s of a
-- 608s synthesis). p_vocab probes consensus_type_subject_btree instead; the type
-- id is resolved into a local FIRST (a variable is a bound parameter and
-- therefore an index condition — Rule #4; a function call in the qual is
-- not, lesson L12).
CREATE OR REPLACE FUNCTION generation.relation_plane(p_family text, p_name text, p_arg int DEFAULT NULL,
        p_vocab bytea[] DEFAULT NULL)
    RETURNS TABLE(subject_id bytea, object_id bytea, w double precision)
    LANGUAGE plpgsql VOLATILE AS $$
DECLARE
    g int;
    v_type bytea;
BEGIN
    IF p_family = 'consensus' THEN
        v_type := laplace.relation_type_id(p_name);
        IF p_vocab IS NULL THEN
            RETURN QUERY
            SELECT c.subject_id, c.object_id,
                   consensus.walk_edge_weight(c.rating, c.rd, c.witness_count)
            FROM laplace.consensus c
            WHERE c.type_id = v_type AND c.object_id IS NOT NULL;
        ELSE
            RETURN QUERY
            WITH v(id) AS (SELECT DISTINCT u FROM unnest(p_vocab) AS u)
            SELECT c.subject_id, c.object_id,
                   consensus.walk_edge_weight(c.rating, c.rd, c.witness_count)
            FROM v
            JOIN laplace.consensus c ON c.type_id = v_type AND c.subject_id = v.id
            JOIN v vo ON vo.id = c.object_id
            WHERE c.object_id IS NOT NULL;
        END IF;
        RETURN;
    END IF;

    IF p_family <> 'traj' THEN
        RAISE EXCEPTION 'relation_plane: unknown family % (consensus | traj)', p_family;
    END IF;

    g := CASE p_name
             WHEN 'next'   THEN 1
             WHEN 'gap'    THEN COALESCE(p_arg, 1)
             WHEN 'window' THEN COALESCE(p_arg, 4)
             ELSE NULL
         END;
    IF g IS NULL THEN
        RAISE EXCEPTION 'relation_plane: unknown traj plane % (next | gap | window)', p_name;
    END IF;

    -- Pairs are computed HERE, at export time, from the trajectories themselves.
    -- The pour is corpus-bounded by definition — it renders the whole consensus —
    -- so a full aggregation inside it is honest cost. What was NOT honest was a
    -- maintained trajectory_pairs cache with a corpus fingerprint and rebuild
    -- guards: a second materialization of what laplace.physicalities.trajectory holds
    -- exactly-invertibly (§15 — a second body is a future divergence; §9 — the
    -- trajectory IS the sequence). gen_corpus and trajectory_pairs are deleted;
    -- this inline scan is the one remaining whole-corpus reader, and it lives on
    -- the export path where whole-corpus is the contract.
    --
    -- next/gap = pairs at exactly stride g; window = all strides 1..g. One body,
    -- bounded by (lo, hi). subject_total matches the retired semantics: per
    -- (subject, exact gap) for next/gap, per subject across the window for
    -- window. Separators are excluded through generation.separator_ids() — one body for
    -- that fact too — so pairs count CONTENT adjacency, as the corpus stream did.
    RETURN QUERY
    WITH bounds AS (
        SELECT CASE WHEN p_name = 'window' THEN 1 ELSE g END AS lo, g AS hi
    ),
    sepset AS MATERIALIZED (
        SELECT COALESCE(generation.separator_ids(), ARRAY[]::bytea[]) AS ids
    ),
    seq AS (
        SELECT w.id AS root, c.ordinal, c.entity_id AS tok
        FROM laplace.v_word_points w
        CROSS JOIN LATERAL public.laplace_trajectory_constituents(w.trajectory) c
        WHERE w.type_id IN (realize.canonical_id('Sentence'), realize.canonical_id('Document'))
          AND w.trajectory IS NOT NULL
    ),
    content AS (
        SELECT s.root, s.tok,
               row_number() OVER (PARTITION BY s.root ORDER BY s.ordinal) AS cord
        FROM seq s CROSS JOIN sepset x
        WHERE NOT (s.tok OPERATOR(pg_catalog.=) ANY (x.ids))
    ),
    pairs AS (
        SELECT a.tok AS s, b.tok AS o, count(*) AS cnt
        FROM content a
        JOIN bounds ON true
        JOIN content b ON b.root = a.root
                      AND b.cord BETWEEN a.cord + bounds.lo AND a.cord + bounds.hi
        GROUP BY a.tok, b.tok
    ),
    tot AS (
        SELECT p.s, sum(p.cnt) AS subject_total FROM pairs p GROUP BY p.s
    )
    SELECT p.s, p.o, p.cnt::double precision / t.subject_total
    FROM pairs p JOIN tot t ON t.s = p.s;
END;
$$;
