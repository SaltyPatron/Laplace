-- The strength of a strand's standing as an edge, in [0, 1]: its Glicko-2 expected score against a certain neutral
-- reference, RD pulling an uncertain standing toward 0.5 through g(phi). One body, the C one every native walk calls
-- (laplace_glicko2_expected_score): a thin claim that has not lost is still walked. This is the walk law, not the
-- ranking; consensus.eff_mu is the conservative reading that ranks.
CREATE OR REPLACE FUNCTION consensus.edge_strength(p_rating bigint, p_rd bigint)
    RETURNS double precision
    AS 'MODULE_PATHNAME', 'pg_laplace_edge_strength'
    LANGUAGE C LAPLACE_IMMUTABLE_STRICT;

-- A Native standing (public.consensus, float8 points) through the same body.
CREATE OR REPLACE FUNCTION consensus.edge_strength(p_rating double precision, p_deviation double precision)
    RETURNS double precision LANGUAGE sql LAPLACE_IMMUTABLE
BEGIN ATOMIC
    SELECT consensus.edge_strength(round(p_rating * 1e9)::bigint, round(p_deviation * 1e9)::bigint);
END;