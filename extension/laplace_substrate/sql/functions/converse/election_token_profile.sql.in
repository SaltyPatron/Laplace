-- election_token_profile: the per-token evidence profile an election ranks on.
--
-- W15 enumerates the axes a topic election may use and rules that no single one
-- of them can carry it — six keys have each failed with their own degenerate
-- class (denote_mu -> function words, total_mass -> degree, highway popcount ->
-- the tier-0 floor, ord DESC -> SVO word order, container IDF -> rare words,
-- coherence/total_mass -> zero without a direct edge). Judging a candidate
-- combination therefore means reading several axes for the same token at once.
--
-- That read was being hand-written each time it was needed: a CTE over
-- entity_container_degree, a lateral count over consensus_out, a witness sum,
-- and a hand-tuned witness transform, re-derived per investigation. This is the same
-- reinvented-wheel defect W16 documents in the read path, committed by the
-- person documenting it. One implementation, named, installed, callable through
-- `op` — so the next measurement quotes a function instead of a paragraph of SQL.
--
-- Text in, because the caller has surfaces and laplace.word_id() is the resolution the
-- elector itself performs. Ids that resolve to nothing come back with zeroes
-- rather than vanishing: an unattested surface is a real answer, and dropping
-- the row would be the EXISTS-collapses-NULL defect in another costume.
--
-- No SET search_path (GH #860), every reference schema-qualified (G11).
DROP FUNCTION IF EXISTS laplace.election_token_profile(text[]);
CREATE OR REPLACE FUNCTION converse.election_token_profile(p_surfaces text[])
    RETURNS TABLE(
        surface        text,
        entity_id      bytea,
        tier           integer,
        containers     bigint,
        icf            double precision,
        out_edges      bigint,
        witnesses      bigint,
        witness_sat    double precision,
        icf_x_sat      double precision,
        bands          integer)
    LANGUAGE sql STABLE AS $$
    WITH t AS MATERIALIZED (
        SELECT s.ord, s.surface, laplace.word_id(s.surface) AS id
        FROM unnest(p_surfaces) WITH ORDINALITY AS s(surface, ord)
    ),
    ids AS MATERIALIZED (
        SELECT i.id
        FROM (SELECT DISTINCT t.id FROM t WHERE t.id IS NOT NULL) i
    ),
    -- The array operation is invoked once for the bounded token set, not once
    -- with a one-element array for every token.
    deg AS MATERIALIZED (
        SELECT d.entity_id, d.degree, d.icf
        FROM (SELECT array_agg(ids.id ORDER BY ids.id) AS a FROM ids) b
        CROSS JOIN LATERAL structural.entity_container_degree(b.a) d
    ),
    -- The bounded ids drive subject-key probes directly. consensus_out hid the
    -- same scan behind one SRF invocation per token and imposed a 1,000,000-row
    -- truncation before this aggregate. A profile needs the full count; it does
    -- not need edge ordering or rendering.
    edg AS MATERIALIZED (
        SELECT ids.id AS entity_id,
               count(c.type_id)                                  AS out_edges,
               COALESCE(sum(c.witness_count), 0)::bigint         AS witnesses
        FROM ids
        LEFT JOIN laplace.consensus c ON c.subject_id = ids.id
        GROUP BY ids.id
    ),
    ent AS MATERIALIZED (
        SELECT ids.id AS entity_id, e.highway_mask
        FROM ids
        LEFT JOIN laplace.entities e ON e.id = ids.id
    )
    SELECT t.surface,
           t.id,
           generation.entity_tier_of(t.id),
           COALESCE(deg.degree, 0),
           COALESCE(deg.icf, 1.0),
           COALESCE(edg.out_edges, 0),
           COALESCE(edg.witnesses, 0),
           COALESCE(edg.witnesses, 0)::double precision,
           COALESCE(deg.icf, 1.0)
               * COALESCE(edg.witnesses, 0)::double precision,
           COALESCE(consensus.highway_popcount(ent.highway_mask), 0)
    FROM t
    LEFT JOIN deg ON deg.entity_id = t.id
    LEFT JOIN edg ON edg.entity_id = t.id
    LEFT JOIN ent ON ent.entity_id = t.id
    ORDER BY t.ord
$$;
