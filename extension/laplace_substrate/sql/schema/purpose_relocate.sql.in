            ('word_shape_distance', 'structural', 'word_shape_distance'),
            ('word_shape_peers_fast', 'lexical', 'word_shape_peers_fast')
        ) AS t(src_name, dst_schema, dst_name)
    LOOP
        FOR r IN
            SELECT pg_catalog.pg_get_function_identity_arguments(p.oid) AS args
            FROM pg_catalog.pg_proc p
            JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
            WHERE n.nspname = 'laplace'
              AND p.proname = m.src_name
        LOOP
            -- Already relocated (partial prior run, or a signature the install
            -- script created directly): leave the destination alone.
            IF EXISTS (
                SELECT 1
                FROM pg_catalog.pg_proc p2
                JOIN pg_catalog.pg_namespace n2 ON n2.oid = p2.pronamespace
                WHERE n2.nspname = m.dst_schema
                  AND p2.proname = m.dst_name
                  AND pg_catalog.pg_get_function_identity_arguments(p2.oid) = r.args
            ) THEN
                CONTINUE;
            END IF;

            EXECUTE format('ALTER FUNCTION laplace.%I(%s) SET SCHEMA %I',
                           m.src_name, r.args, m.dst_schema);

            IF m.dst_name <> m.src_name THEN
                EXECUTE format('ALTER FUNCTION %I.%I(%s) RENAME TO %I',
                               m.dst_schema, m.src_name, r.args, m.dst_name);
            END IF;
        END LOOP;
    END LOOP;
END
$relocate$;
