# Shell / CI scripts must stay LF — CRLF breaks `set -o pipefail` under bash.
*.sh text eol=lf
scripts/laplace-mcp text eol=lf
Justfile text eol=lf
.github/workflows/*.yml text eol=lf
.github/actions/**/*.yml text eol=lf

# pg_regress captures psql's aligned table output verbatim. Header padding and
# the final separator newline are test data, not whitespace damage.
extension/*/tests/expected/*.out whitespace=-blank-at-eol,-blank-at-eof

# Generated manifest tables are hashed into perf-caches; their bytes must not depend on the host.
engine/manifest/**/*.tsv text eol=lf

# Written by scripts/codegen-attestation-law.py as LF, rewriting a file whose bytes differ: an LF checkout keeps a
# Windows build (core.autocrlf) from leaving these tracked files modified after every run.
extension/laplace_substrate/sql/generated/*.sql.in text eol=lf
