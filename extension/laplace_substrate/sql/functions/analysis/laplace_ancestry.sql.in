-- taxonomy.ancestry — hierarchy walk (spec 37 TRAVERSE). Filename keeps the
-- historical laplace_ancestry stem; CREATE drops the redundant project prefix
-- now that the schema names the family. Old laplace.laplace_ancestry (and any
-- taxonomy.laplace_ancestry mid-migration name) dropped rather than shimmed (#532).
-- BEGIN ATOMIC: GH #764.
DROP FUNCTION IF EXISTS laplace.laplace_ancestry(bytea, bytea, integer);
DROP FUNCTION IF EXISTS laplace.laplace_ancestry(bytea, bytea, integer);
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('taxonomy.ancestry(bytea, bytea, integer)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(ancestor_id bytea, depth integer, best_eff_mu numeric)'
             OR proargnames IS DISTINCT FROM ARRAY['p_entity_id','p_band_mask','p_max_depth','ancestor_id','depth','best_eff_mu']::text[])) THEN
        DROP FUNCTION taxonomy.ancestry(bytea, bytea, integer);
    END IF;
END $upgrade_shape$;
CREATE OR REPLACE FUNCTION taxonomy.ancestry(
    p_entity_id bytea,
    p_band_mask  bytea,
    p_max_depth  integer DEFAULT 10)
RETURNS TABLE(ancestor_id bytea, depth integer, best_eff_mu numeric)
LANGUAGE sql STABLE
BEGIN ATOMIC
    WITH RECURSIVE
        band_types AS (
            SELECT id FROM unnest(consensus.relation_mask_types(p_band_mask)) AS t(id)
        ),
        ancestry(ancestor_id, depth, eff_mu_raw, visited) AS (
            SELECT c.object_id, 1, consensus.eff_mu(c.rating, c.rd),
                   ARRAY[p_entity_id, c.object_id]
            FROM laplace.consensus c
            JOIN band_types bt ON bt.id = c.type_id
            WHERE c.subject_id = p_entity_id
              AND c.object_id IS NOT NULL
              AND consensus.eff_mu(c.rating, c.rd) > 0
            UNION ALL
            SELECT c.object_id, anc.depth + 1, consensus.eff_mu(c.rating, c.rd),
                   anc.visited || c.object_id
            FROM ancestry anc
            JOIN laplace.consensus c ON c.subject_id = anc.ancestor_id
            JOIN band_types bt ON bt.id = c.type_id
            WHERE c.object_id IS NOT NULL
              AND consensus.eff_mu(c.rating, c.rd) > 0
              AND anc.depth < p_max_depth
              AND NOT (c.object_id = ANY (anc.visited))
        )
    SELECT ancestor_id, min(depth)::integer, consensus.eff_mu_display(max(eff_mu_raw), 0)
    FROM ancestry
    GROUP BY ancestor_id;
END;
