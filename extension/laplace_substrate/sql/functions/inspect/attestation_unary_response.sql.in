DROP FUNCTION IF EXISTS laplace.attestation_unary_response(bytea, bytea, bytea[], bytea);
CREATE OR REPLACE FUNCTION ops.attestation_unary_response(
    p_subject_id bytea, p_relation_type_id bytea,
    p_source_scope bytea[] DEFAULT NULL, p_context_id bytea DEFAULT NULL)
RETURNS TABLE(combined_eff_mu double precision, source_count integer,
    rating_fp1e9 bigint, rd_fp1e9 bigint)
LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT r.combined_eff_mu,r.source_count,r.rating_fp1e9,r.rd_fp1e9
    FROM ops.attestation_response_batch(ARRAY[p_subject_id],p_relation_type_id,
        p_source_scope,p_context_id,NULL,true) r;
END;
