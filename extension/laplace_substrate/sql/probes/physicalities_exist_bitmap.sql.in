-- Native positive-confirmation core: malformed-width ids read absent and input
-- ordinals are preserved. The SQL wrapper maps NULL elements to the same absent
-- sentinel in one array operation, with no per-element loop.
CREATE OR REPLACE FUNCTION laplace.physicalities_exist_bitmap_native(ids bytea[])
    RETURNS bytea
    AS 'EXECUTION_LIBRARY', 'pg_laplace_physicalities_exist_bitmap'
    LANGUAGE C STABLE;

CREATE OR REPLACE FUNCTION laplace.physicalities_exist_bitmap(ids bytea[])
    RETURNS bytea
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT laplace.physicalities_exist_bitmap_native(
        array_replace(ids, NULL::bytea, ''::bytea));
END;

-- Physicalities are HASH(id), so the id routes the probe and a hilbert key
-- names no partition; the (ids, hilberts) form is dropped. A stored row must
-- never read absent: bulk COPY has no ON CONFLICT and would abort.
DROP FUNCTION IF EXISTS laplace.physicalities_exist_bitmap(bytea[], bytea[]);
