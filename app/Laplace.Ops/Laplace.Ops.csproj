<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Laplace.Ops</RootNamespace>
    <AssemblyName>Laplace.Ops</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared ops-logging foundation (GH #602/#635 refactor): Serilog does the hard
         parts — concurrent shared-file append, buffering, flush — that were hand-rolled in
         Laplace.Core. Referenced by the console deployables only, so Core stays dependency-free. -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Laplace.Core\Laplace.Core.csproj" />
  </ItemGroup>

</Project>
