# deploy\secrets\engines.env (gitignored): the engine endpoint, Laplace.Endpoints.Engines (scripts\win\ensure-managed-services.ps1
# declares the LaplaceEngines service once this file exists). Generate the token, never commit it:
#   pwsh -NoProfile -Command "[Convert]::ToHexStringLower([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))"
LAPLACE_ENGINES_TOKEN=<64 hex characters>
# The LAN address and port it listens on (0.0.0.0: every interface; the Windows firewall decides who reaches it).
LAPLACE_ENGINES_BIND=0.0.0.0
LAPLACE_ENGINES_PORT=5190
# The profile /analyse uses when a request names none (deploy/stockfish-profiles.json, deploy/lc0-profiles.json); /bestmove uses play.
LAPLACE_ENGINES_PROFILE=analysis
