SQL_QUERY("billing.set_config", "text,text",
    "INSERT INTO app.billing_config(key,value,updated_at) VALUES($1,$2,now()) "
    "ON CONFLICT(key) DO UPDATE SET value=EXCLUDED.value,updated_at=now()")
SQL_QUERY("apikey.put", "text,text,text,text,timestamptz,timestamptz,timestamptz",
    "INSERT INTO app.api_keys(key_hash,key_prefix,tenant,label,created_at,revoked_at,last_used_at) "
    "VALUES($1,$2,$3,$4,$5,$6,$7) "
    "ON CONFLICT(key_hash) DO NOTHING")
SQL_QUERY("apikey.get", "text",
    "SELECT key_hash,key_prefix,tenant,label,created_at,revoked_at,last_used_at "
    "FROM app.api_keys WHERE key_hash=$1")
SQL_QUERY("apikey.by_tenant", "text",
    "SELECT key_hash,key_prefix,tenant,label,created_at,revoked_at,last_used_at "
    "FROM app.api_keys WHERE tenant=$1 ORDER BY created_at DESC,key_hash")
SQL_QUERY("apikey.by_label", "text",
    "SELECT key_hash,key_prefix,tenant,label,created_at,revoked_at,last_used_at "
    "FROM app.api_keys WHERE label=$1 ORDER BY created_at DESC,key_hash")
SQL_QUERY("apikey.revoke", "text",
    "UPDATE app.api_keys SET revoked_at=now() WHERE key_hash=$1 AND revoked_at IS NULL")
SQL_QUERY("apikey.touch", "text,timestamptz",
    "UPDATE app.api_keys SET last_used_at=$2 WHERE key_hash=$1")
SQL_QUERY("access.stored_role", "uuid",
    "SELECT role FROM app.platform_roles WHERE user_id=$1")
SQL_QUERY("access.people", "text",
    "SELECT u.user_id,u.display_name,u.email,r.role,"
    "ARRAY(SELECT DISTINCT e.provider FROM app.external_identities e WHERE e.user_id=u.user_id ORDER BY e.provider) "
    "FROM app.users u LEFT JOIN app.platform_roles r USING(user_id) "
    "WHERE $1='' OR strpos(lower(coalesce(u.display_name,'')||' '||coalesce(u.email,'')||' '||u.user_id::text),lower($1))>0 "
    "ORDER BY r.role IS NULL,u.display_name NULLS LAST,u.user_id LIMIT 100")
SQL_QUERY("access.events", "",
    "SELECT e.event_id,e.user_id,e.actor,e.previous_role,e.role,e.occurred_at,"
    "coalesce(person.email,person.display_name),coalesce(actor.email,actor.display_name) "
    "FROM app.platform_role_events e "
    "LEFT JOIN app.users person ON person.user_id=e.user_id "
    "LEFT JOIN app.users actor ON actor.user_id::text=e.actor "
    "ORDER BY e.event_id DESC LIMIT 50")
SQL_QUERY("access.lock_roles", "",
    "LOCK TABLE app.platform_roles IN SHARE ROW EXCLUSIVE MODE")
SQL_QUERY("access.user_exists", "uuid",
    "SELECT 1 FROM app.users WHERE user_id=$1")
SQL_QUERY("access.has_role_events", "uuid",
    "SELECT EXISTS(SELECT 1 FROM app.platform_role_events WHERE user_id=$1)")
SQL_QUERY("access.admin_count", "",
    "SELECT count(*) FROM app.platform_roles WHERE role='administrator'")
SQL_QUERY("access.delete_role", "uuid",
    "DELETE FROM app.platform_roles WHERE user_id=$1")
SQL_QUERY("access.upsert_role", "uuid,text",
    "INSERT INTO app.platform_roles(user_id,role,updated_at) VALUES($1,$2,now()) "
    "ON CONFLICT(user_id) DO UPDATE SET role=EXCLUDED.role,updated_at=now()")
SQL_QUERY("access.insert_role_event", "uuid,text,text,text",
    "INSERT INTO app.platform_role_events(user_id,actor,previous_role,role) VALUES($1,$2,$3,$4)")
SQL_QUERY("access.workspaces", "",
    "SELECT t.tenant_id,t.display_name,t.kind,count(m.user_id) AS members "
    "FROM app.tenants t LEFT JOIN app.tenant_memberships m USING(tenant_id) "
    "GROUP BY t.tenant_id ORDER BY t.display_name,t.tenant_id LIMIT 200")
SQL_QUERY("account.set_member_role", "text,text,uuid,uuid",
    "WITH previous AS MATERIALIZED ("
    "SELECT role FROM app.tenant_memberships WHERE tenant_id=$2 AND user_id=$3"
    "), changed AS ("
    "UPDATE app.tenant_memberships target SET role=$1 "
    "WHERE target.tenant_id=$2 AND target.user_id=$3 "
    "AND EXISTS(SELECT 1 FROM app.tenant_memberships actor WHERE actor.tenant_id=$2 AND actor.user_id=$4 AND actor.role='owner') "
    "AND (target.role<>'owner' OR $1='owner' OR "
    "(SELECT count(*) FROM app.tenant_memberships WHERE tenant_id=$2 AND role='owner')>1) "
    "RETURNING target.user_id"
    "), audit AS ("
    "INSERT INTO app.workspace_role_events(tenant_id,user_id,actor_id,previous_role,role) "
    "SELECT $2,changed.user_id,$4,previous.role,$1 FROM changed CROSS JOIN previous WHERE previous.role<>$1"
    ") SELECT count(*) FROM changed")
SQL_QUERY("account.role_events", "text",
    "SELECT e.event_id,coalesce(person.email,person.display_name,e.user_id::text),"
    "coalesce(actor.email,actor.display_name,e.actor_id::text),e.previous_role,e.role,e.occurred_at "
    "FROM app.workspace_role_events e "
    "LEFT JOIN app.users person ON person.user_id=e.user_id "
    "LEFT JOIN app.users actor ON actor.user_id=e.actor_id "
    "WHERE e.tenant_id=$1 ORDER BY e.event_id DESC LIMIT 50")
SQL_QUERY("billing.begin_webhook", "text,text",
    "INSERT INTO app.billing_webhook_events(event_id,status,updated_at) VALUES($1,$2,now()) "
    "ON CONFLICT(event_id) DO UPDATE SET status=EXCLUDED.status,updated_at=now() "
    "WHERE app.billing_webhook_events.status='retryable' OR (app.billing_webhook_events.status LIKE 'processing:%' "
    "AND app.billing_webhook_events.updated_at<now()-interval '5 minutes')")
SQL_QUERY("billing.complete_webhook", "text,text",
    "UPDATE app.billing_webhook_events SET status=$2,updated_at=now() WHERE event_id=$1")
SQL_QUERY("billing.webhook_status", "text",
    "SELECT status FROM app.billing_webhook_events WHERE event_id=$1")

SQL_QUERY("entities.present_ordinals_fallback", "bytea[]",
    "SELECT (u.ord-1)::int FROM unnest($1::bytea[]) WITH ORDINALITY u(id,ord) "
    "JOIN laplace.entities e ON e.id=u.id")

/* %s is a native-quoted physical owner, or the parent when caller RLS/ACLs
 * require normal parent access. All relation types share one routed batch. */
SQL_QUERY("consensus.evidence_rows_batch", "bytea[],bytea[],bytea[],int4[]",
    "WITH requested AS MATERIALIZED ("
    " SELECT * FROM unnest($1::bytea[],$2::bytea[],$3::bytea[],$4::int4[]) AS b(s,t,o,ord)) "
    "SELECT b.ord::bigint,a.id,a.last_observed_at,a.observation_count,a.sum_score_fp1e9,"
    " a.opponent_rating_fp1e9,a.opponent_rd_fp1e9,a.fold_replayable "
    " FROM requested b JOIN %s a "
    " ON a.type_id=b.t AND a.subject_id=b.s AND a.object_id=b.o WHERE b.o IS NOT NULL "
    " UNION ALL "
    "SELECT b.ord::bigint,a.id,a.last_observed_at,a.observation_count,a.sum_score_fp1e9,"
    " a.opponent_rating_fp1e9,a.opponent_rd_fp1e9,a.fold_replayable "
    " FROM requested b JOIN %s a "
    " ON a.type_id=b.t AND a.subject_id=b.s AND a.object_id IS NULL "
    " WHERE b.o IS NULL ORDER BY 1,3,2")
SQL_QUERY("consensus.delete_locked_empty_cells", "bytea[],bytea[],bytea",
    "DELETE FROM laplace.consensus c USING unnest($1::bytea[],$2::bytea[]) b(id,s) "
    "WHERE c.id=b.id AND c.subject_id=b.s AND c.type_id=$3")
/* Every name of an entity is one relation, HAS_NAME; which name a claim states
 * (primary, alias, ...) is its qualifier. Candidates in the requested language first. */
SQL_QUERY("realize.name_candidates", "bytea[],bytea",
    "SELECT nm.subject_id,nm.object_id,(lang.object_id IS NOT NULL) AS lp,"
    "consensus.eff_mu(nm.rating,nm.rd) AS mu "
    "FROM laplace.v_consensus_unrefuted nm "
    "LEFT JOIN laplace.consensus lang ON lang.subject_id=nm.object_id "
    "AND lang.type_id=laplace.relation_type_id('HAS_LANGUAGE') AND lang.object_id=$2 "
    "WHERE nm.subject_id=ANY($1) AND nm.type_id=laplace.relation_type_id('HAS_NAME') "
    "ORDER BY nm.subject_id,lp DESC,mu DESC,nm.object_id")
/* Staged evidence equals installed evidence (legacy bootstrap reconciliation): every
 * staged row is stored with the same witness fields and qualifiers, its cell's
 * consensus folds exactly that evidence, and the staged sources hold no other row
 * for those cells. */
SQL_QUERY("legacy.bootstrap_evidence_parity",
    "bytea[],bytea[],bytea[],bytea[],bool[],bytea[],bytea[],bool[],int2[],int8[],int8[],int8[],int8[],bool[],bytea[],bool[]",
    "WITH expected_rows AS (SELECT * FROM unnest("
    "$1::bytea[],$2::bytea[],$3::bytea[],$4::bytea[],$5::boolean[],"
    "$6::bytea[],$7::bytea[],$8::boolean[],$9::smallint[],$10::bigint[],"
    "$11::bigint[],$12::bigint[],$13::bigint[],$14::boolean[],$15::bytea[],$16::boolean[]) "
    "AS x(id,subject_id,type_id,object_value,object_null,source_id,context_value,context_null,"
    "outcome,games,score_sum,opponent_rd,opponent_rating,fold_replayable,qualifier_mask,mask_null)), "
    "expected AS (SELECT id,subject_id,type_id,"
    "CASE WHEN object_null THEN NULL ELSE object_value END object_id,source_id,"
    "CASE WHEN context_null THEN NULL ELSE context_value END context_id,"
    "outcome,sum(games)::bigint games,sum(score_sum)::bigint score_sum,"
    "opponent_rd,opponent_rating,fold_replayable,"
    "CASE WHEN mask_null THEN NULL ELSE qualifier_mask END qualifier_mask "
    "FROM expected_rows GROUP BY id,subject_id,type_id,object_value,object_null,source_id,"
    "context_value,context_null,outcome,opponent_rd,opponent_rating,fold_replayable,"
    "qualifier_mask,mask_null), "
    "matched AS (SELECT expected.*,stored.observation_count stored_games,"
    "stored.sum_score_fp1e9 stored_sum,"
    "CASE WHEN expected.games>0 AND stored.observation_count%expected.games=0 "
    "THEN stored.observation_count/expected.games ELSE 0 END multiplier "
    "FROM expected JOIN laplace.attestations stored "
    "ON stored.id=expected.id AND stored.subject_id=expected.subject_id "
    "AND stored.type_id=expected.type_id "
    "AND stored.object_id IS NOT DISTINCT FROM expected.object_id "
    "AND stored.source_id=expected.source_id "
    "AND stored.context_id IS NOT DISTINCT FROM expected.context_id "
    "AND stored.outcome=expected.outcome AND stored.opponent_rd_fp1e9=expected.opponent_rd "
    "AND stored.opponent_rating_fp1e9=expected.opponent_rating "
    "AND stored.fold_replayable=expected.fold_replayable "
    "AND stored.qualifier_mask IS NOT DISTINCT FROM expected.qualifier_mask), "
    "cells AS (SELECT DISTINCT subject_id,type_id,object_id FROM expected), "
    "evidence_totals AS (SELECT cells.subject_id,cells.type_id,cells.object_id,"
    "sum(a.observation_count)::bigint games,max(a.last_observed_at) last_at "
    "FROM cells JOIN laplace.attestations a "
    "ON a.subject_id=cells.subject_id AND a.type_id=cells.type_id "
    "AND a.object_id IS NOT DISTINCT FROM cells.object_id "
    "GROUP BY cells.subject_id,cells.type_id,cells.object_id), "
    "consensus_parity AS (SELECT count(*) count,"
    "bool_and(c.witness_count=e.games AND c.last_observed_at=e.last_at) ok "
    "FROM evidence_totals e JOIN laplace.consensus c "
    "ON c.subject_id=e.subject_id AND c.type_id=e.type_id "
    "AND c.object_id IS NOT DISTINCT FROM e.object_id) "
    "SELECT (SELECT count(*) FROM matched)=(SELECT count(*) FROM expected) "
    "AND (SELECT bool_and(outcome=2 AND multiplier>=1 "
    "AND stored_sum::numeric*games=score_sum::numeric*stored_games) FROM matched) "
    "AND (SELECT min(multiplier)=max(multiplier) FROM matched) "
    "AND (SELECT count=(SELECT count(*) FROM cells) AND ok FROM consensus_parity) "
    "AND NOT EXISTS (SELECT 1 FROM laplace.attestations historical "
    "WHERE historical.source_id IN (SELECT DISTINCT source_id FROM expected) "
    "AND NOT EXISTS (SELECT 1 FROM expected WHERE expected.id=historical.id) "
    "AND EXISTS (SELECT 1 FROM expected WHERE expected.subject_id=historical.subject_id "
    "AND expected.type_id=historical.type_id "
    "AND expected.object_id IS NOT DISTINCT FROM historical.object_id))")
/* A grapheme's case mappings: one relation, HAS_CASE_MAPPING; which case a target is
 * is the qualifier bit ($2, one per slot, in slot order) of the testimony behind the
 * cell. The eff_mu winner per (grapheme, slot); slot is 1-based. */
SQL_QUERY("lexical.case_mappings", "bytea[],int4[]",
    "SELECT DISTINCT ON (c.subject_id,q.slot) c.subject_id,q.slot::int4,c.object_id "
    "FROM laplace.v_consensus_unrefuted c "
    "CROSS JOIN unnest($2::int4[]) WITH ORDINALITY AS q(bit,slot) "
    "WHERE c.subject_id=ANY($1) AND c.type_id=laplace.relation_type_id('HAS_CASE_MAPPING') "
    "AND EXISTS (SELECT 1 FROM laplace.attestations a "
    "WHERE a.subject_id=c.subject_id AND a.type_id=c.type_id "
    "AND a.object_id IS NOT DISTINCT FROM c.object_id AND a.qualifier_mask IS NOT NULL "
    "AND get_bit(a.qualifier_mask,q.bit)=1) "
    "ORDER BY c.subject_id,q.slot,consensus.eff_mu(c.rating,c.rd) DESC")
