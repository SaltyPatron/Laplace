-- Language-aware compatibility realization for selected ids. The native owner
-- in realize_batch.c follows lexical bindings, exact self content, names,
-- translations and definitions. Missing output remains NULL. Candidate rendering
-- and first-nonempty election are legacy policy inside this boundary, not proof
-- that semantic selection runs entirely in identity space.
DROP FUNCTION IF EXISTS laplace.realize_batch(bytea[], bytea);
CREATE OR REPLACE FUNCTION realize._batch_c(p_ids bytea[], p_lang bytea DEFAULT NULL)
    RETURNS text[]
    AS 'EXECUTION_LIBRARY', 'pg_laplace_realize_batch'
    LANGUAGE C STABLE PARALLEL SAFE;

CREATE OR REPLACE FUNCTION realize.batch(p_ids bytea[], p_lang bytea DEFAULT NULL)
    RETURNS text[]
    AS 'EXECUTION_LIBRARY', 'pg_laplace_realize_batch'
    LANGUAGE C STABLE PARALLEL SAFE;
