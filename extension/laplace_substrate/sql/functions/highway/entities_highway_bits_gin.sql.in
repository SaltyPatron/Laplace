-- Same bit-overlap access for entity masks (currently sparse; the index stays
-- proportional to populated rows via the partial predicate).
-- Same fastupdate reasoning as physicalities_constituents_gin, and the same flush:
-- inserts batch into the pending list during a write burst and
-- NpgsqlIngestOps.CleanGinPendingListsAsync drains every laplace GIN when the burst
-- ends, so readers never scan a populated list. Smaller limit than the constituents
-- index because this one is partial on a sparse column — the mask is populated for a
-- minority of entities, so its insert volume per ingest is a fraction of a
-- 137-entries-per-row trajectory index and it does not need the same runway.
CREATE INDEX IF NOT EXISTS entities_highway_bits_gin
    ON laplace.entities USING gin (consensus.highway_mask_bits(highway_mask))
    WITH (fastupdate = on, gin_pending_list_limit = 8192)
    WHERE highway_mask IS NOT NULL;
