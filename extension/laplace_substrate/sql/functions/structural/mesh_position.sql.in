-- A node's position in the semantic mesh. IDs are selected and ranked first;
-- every display label is resolved in one position-aligned batch at the edge.
DROP FUNCTION IF EXISTS laplace.mesh_position(bytea);
DROP FUNCTION IF EXISTS structural.mesh_position(bytea);
CREATE OR REPLACE FUNCTION structural.mesh_position(
    p_id bytea,
    p_relation_limit integer DEFAULT NULL,
    p_member_limit integer DEFAULT NULL)
    RETURNS TABLE(dir text, id bytea, label text, relation text,
                  hub_type text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    WITH self_hub AS MATERIALIZED (
        SELECT (SELECT e.type_id FROM laplace.entities e WHERE e.id = p_id) AS object_id
    ), up_subjects AS MATERIALIZED (
        SELECT p_id AS id
        UNION
        SELECT n.subject_id
        FROM laplace.consensus n
        WHERE n.object_id = p_id
          AND n.type_id = ANY (consensus.relation_set_ids('NAME_EDGE'))
    ), sense_rows AS MATERIALIZED (
        SELECT s.synset_id AS id, s.eff_mu, s.witnesses,
               row_number() OVER (ORDER BY s.eff_mu DESC NULLS LAST, s.synset_id) AS ord
        FROM lexical.senses(p_id) s
    ), up_cells AS MATERIALIZED (
        SELECT c.object_id AS id, consensus.relation_canonical(c.type_id) AS relation,
               c.rating, c.rd, c.witness_count
        FROM up_subjects s
        JOIN laplace.consensus c ON c.subject_id=s.id
        WHERE c.type_id IN (laplace.relation_type_id('IS_SENSE_OF'),
                            laplace.relation_type_id('HAS_SENSE'),
                            laplace.relation_type_id('EVOKES_FRAME'),
                            laplace.relation_type_id('IS_INSTANCE_OF'),
                            laplace.relation_type_id('IS_A'),
                            laplace.relation_type_id('CORRESPONDS_TO'),
                            laplace.relation_type_id('HAS_SEMANTIC_ROLE'))
        UNION ALL
        -- What contains the node (a VerbNet class its member, a holonym its part) is
        -- up: the HAS_PART cell read from its object side.
        SELECT c.subject_id, 'IS_PART_OF', c.rating, c.rd, c.witness_count
        FROM up_subjects s
        JOIN laplace.consensus c ON c.object_id=s.id
        WHERE c.type_id = laplace.relation_type_id('HAS_PART')
    ), up_rows AS MATERIALIZED (
        SELECT u.id, u.relation,
               (SELECT e.type_id FROM laplace.entities e WHERE e.id = u.id) AS hub_id,
               consensus.eff_mu_display(u.rating,u.rd) AS eff_mu, u.witness_count,
               row_number() OVER (ORDER BY consensus.eff_mu_display(u.rating,u.rd) DESC NULLS LAST,
                                           u.id) AS ord
        FROM up_cells u
        ORDER BY eff_mu DESC NULLS LAST, u.id
        LIMIT GREATEST(p_relation_limit, 0)
    ), down_rows AS MATERIALIZED (
        SELECT m.member AS id, m.kind, m.mu, m.witnesses,
               row_number() OVER (ORDER BY m.mu DESC NULLS LAST, m.member) AS ord
        FROM lexical.concept_members(p_id) m
        ORDER BY m.mu DESC NULLS LAST, m.member
        LIMIT GREATEST(p_member_limit, 0)
    ), raw AS MATERIALIZED (
        SELECT 0 AS branch, 0::bigint AS ord, 'self'::text AS dir, p_id AS id,
               NULL::text AS relation, h.object_id AS hub_id, NULL::text AS hub_literal,
               NULL::numeric AS eff_mu, NULL::bigint AS witnesses FROM self_hub h
        UNION ALL
        SELECT 1, s.ord, 'up', s.id, 'has sense', NULL, 'WordNet_Synset', s.eff_mu, s.witnesses
        FROM sense_rows s
        UNION ALL
        SELECT 2, u.ord, 'up', u.id, u.relation,
               u.hub_id, NULL, u.eff_mu, u.witness_count FROM up_rows u
        UNION ALL
        SELECT 3, d.ord, 'down', d.id, d.kind, NULL, NULL, d.mu, d.witnesses FROM down_rows d
    ), ids AS MATERIALIZED (
        SELECT array_agg(DISTINCT id ORDER BY id) AS a
        FROM (SELECT id FROM raw UNION SELECT hub_id FROM raw WHERE hub_id IS NOT NULL) x
    ), labels AS MATERIALIZED (
        SELECT i.id, i.txt FROM ids,
          LATERAL ROWS FROM (
            unnest(ids.a), unnest(realize.label_batch(ids.a))
          ) i(id, txt)
    )
    SELECT r.dir, r.id, n.txt, r.relation,
           COALESCE(r.hub_literal, h.txt), r.eff_mu, r.witnesses
    FROM raw r JOIN labels n ON n.id=r.id LEFT JOIN labels h ON h.id=r.hub_id
    ORDER BY r.branch, r.ord;
END;
