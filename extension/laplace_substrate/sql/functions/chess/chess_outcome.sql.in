DROP FUNCTION IF EXISTS laplace.chess_outcome(boolean, bytea);
CREATE OR REPLACE FUNCTION chess.outcome(p_as_white boolean, p_result bytea)
    RETURNS smallint
    LANGUAGE sql IMMUTABLE PARALLEL SAFE AS $$
    -- The one place a game header becomes an outcome for ONE of its two players.
    -- A game's HAS_RESULT object is the verbatim PGN result token the decomposer
    -- recorded as content ("1-0" / "0-1" / "1/2-1/2"); which of Win/Draw/Loss
    -- that is depends entirely on the colour the player held. Every chess read
    -- that counts a record -- chess_player_record, chess_leaderboard,
    -- chess_opponents -- resolves it through here, so W/L/D is defined once.
    --
    -- The returned domain is {0 Loss, 1 Draw, 2 Win}: the attestation outcome
    -- enum, bit-identical to PlyOutcome by design. NULL means the source never
    -- asserted a result (an abandoned or untagged game) -- an abstention, not a
    -- draw, and never counted as one.
    SELECT CASE
        WHEN p_result = laplace.word_id('1/2-1/2') THEN 1::smallint
        WHEN p_result = laplace.word_id('1-0')
            THEN (CASE WHEN p_as_white THEN 2 ELSE 0 END)::smallint
        WHEN p_result = laplace.word_id('0-1')
            THEN (CASE WHEN p_as_white THEN 0 ELSE 2 END)::smallint
        ELSE NULL
    END
$$;
