SQL_QUERY("content.confirmed_user_artifact_occurrence", "bytea,bytea,bytea,bytea,int2",
    "SELECT EXISTS (\n    SELECT 1\n    FROM laplace.attestations a\n    JOIN laplace.entities e\n      ON e.id = a.object_id\n     AND e.type_id = $4\n    WHERE a.subject_id = $1 AND a.source_id = $1\n      AND a.object_id = $2 AND a.type_id = $3\n      AND a.outcome = $5\n)")

SQL_QUERY("content.user_artifact_observation", "text,bytea",
    "SELECT bytes, modified_at\nFROM laplace.ingest_file_journal\nWHERE source_name = $1\n  AND file_id = $2\n  AND status = 'ok'\nORDER BY ended_at DESC NULLS LAST, run_id DESC\nLIMIT 1")

SQL_QUERY("content.confirmed_prompt_contexts", "bytea,bytea,bytea,int2",
    "SELECT DISTINCT encode(COALESCE(context_id, object_id), 'hex')\nFROM laplace.attestations\nWHERE subject_id = $1\n  AND source_id = $2\n  AND type_id = $3\n  AND outcome = $4\nORDER BY 1")

SQL_QUERY("chess.multi_ply_horizon_steps", "bytea,bytea,int2,int4,int4",
    "WITH matched_lines AS MATERIALIZED (\n    SELECT p.trajectory\n    FROM laplace.physicalities p\n    JOIN laplace.entities e ON e.id = p.entity_id\n    WHERE p.type = $3\n      AND e.type_id = $2\n      AND p.trajectory IS NOT NULL\n      AND public.laplace_trajectory_constituent_ids(p.trajectory)\n          @> ARRAY[$1]::bytea[]\n    LIMIT $5\n),\nunpacked AS MATERIALIZED (\n    SELECT public.laplace_trajectory_constituent_ids(m.trajectory) AS ids\n    FROM matched_lines m\n),\nanchored AS MATERIALIZED (\n    SELECT u.ids, min(s.idx) AS root_idx\n    FROM unpacked u\n    CROSS JOIN LATERAL generate_subscripts(u.ids, 1) AS s(idx)\n    WHERE u.ids[s.idx] = $1\n    GROUP BY u.ids\n),\nsteps AS (\n    SELECT a.ids[a.root_idx + k] AS from_pos,\n           a.ids[a.root_idx + k + 1] AS to_pos\n    FROM anchored a\n    CROSS JOIN LATERAL generate_series(0, $4 - 1) AS g(k)\n    WHERE a.root_idx + k + 1 <= cardinality(a.ids)\n)\nSELECT from_pos, to_pos, count(*)::bigint AS cnt\nFROM steps\nWHERE from_pos IS NOT NULL AND to_pos IS NOT NULL\nGROUP BY from_pos, to_pos\nORDER BY cnt DESC, from_pos, to_pos")

SQL_QUERY("chess.has_eval_sums", "bytea,bytea,bytea[]",
    "SELECT subject_id,\n       COALESCE(SUM(sum_score_fp1e9), 0)::bigint,\n       COALESCE(SUM(observation_count), 0)::bigint\nFROM laplace.attestations\nWHERE type_id = $1\n  AND object_id = $2\n  AND subject_id = ANY($3)\nGROUP BY subject_id")

