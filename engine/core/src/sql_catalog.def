SQL_QUERY("chess.commentary_position_history", "bytea,bytea,int2,int4,int4,bool,text,text",
    "WITH raw_lines AS MATERIALIZED (\n    SELECT DISTINCT p.entity_id AS line_id\n    FROM laplace.physicalities p\n    JOIN laplace.entities e ON e.id = p.entity_id\n    WHERE p.type = $3\n      AND e.type_id = $2\n      AND p.trajectory IS NOT NULL\n      AND public.laplace_trajectory_constituent_ids(p.trajectory)\n          @> ARRAY[$1]::bytea[]\n      AND $4 >= 1\n),\nplayings AS MATERIALIZED (\n    SELECT l.line_id, h.event_id, h.played_on,\n           g.white_id, g.white, g.black_id, g.black, g.result, g.eco,\n           CASE WHEN $6 THEN g.white_id ELSE g.black_id END AS mover_id\n    FROM raw_lines l\n    CROSS JOIN LATERAL chess.line(l.line_id) h\n    CROSS JOIN LATERAL chess.game(h.event_id) g\n),\nscored AS MATERIALIZED (\n    SELECT p.line_id, p.event_id, p.played_on,\n           p.white_id, p.white, p.black_id, p.black, p.result,\n           consensus.eff_mu(c.rating, c.rd)::double precision AS mover_eff_mu,\n           elo.rating AS mover_elo,\n           (CASE WHEN COALESCE($7, '') <> '' AND p.eco = $7 THEN 1 ELSE 0 END\n            + CASE WHEN COALESCE($8, '') <> '' AND EXISTS (\n                   SELECT 1\n                   FROM laplace.attestations a\n                   WHERE a.subject_id = p.line_id\n                     AND a.type_id = laplace.relation_type_id('GAME_HAS_MOTIF')\n                     AND realize.realize(a.object_id) = $8\n               ) THEN 1 ELSE 0 END) AS opening_or_motif\n    FROM playings p\n    LEFT JOIN LATERAL (\n        SELECT c.rating, c.rd\n        FROM laplace.consensus c\n        WHERE c.subject_id = p.mover_id\n          AND c.type_id = laplace.relation_type_id('OUTCOME')\n          AND consensus.eff_mu(c.rating, c.rd) > 0\n        ORDER BY consensus.eff_mu(c.rating, c.rd) DESC, c.object_id\n        LIMIT 1\n    ) c ON p.mover_id IS NOT NULL\n    LEFT JOIN LATERAL (\n        SELECT pr.rating\n        FROM chess.player_ratings(p.mover_id) pr\n        LIMIT 1\n    ) elo ON p.mover_id IS NOT NULL\n)\nSELECT s.line_id, s.event_id, s.played_on,\n       s.white_id, s.white, s.black_id, s.black, s.result,\n       s.mover_eff_mu, s.mover_elo, s.opening_or_motif,\n       count(*) OVER () AS witness_count\nFROM scored s\nORDER BY s.mover_eff_mu DESC NULLS LAST,\n         s.mover_elo DESC NULLS LAST,\n         s.opening_or_motif DESC,\n         s.event_id\nLIMIT $5")

SQL_QUERY("chess.commentary_position_continuations", "bytea,bytea,int2,int4",
    "WITH raw_lines AS MATERIALIZED (\n    SELECT DISTINCT p.entity_id AS line_id\n    FROM laplace.physicalities p\n    JOIN laplace.entities e ON e.id = p.entity_id\n    WHERE p.type = $3\n      AND e.type_id = $2\n      AND p.trajectory IS NOT NULL\n      AND public.laplace_trajectory_constituent_ids(p.trajectory)\n          @> ARRAY[$1]::bytea[]\n),\nsteps AS (\n    SELECT step.nxt\n    FROM raw_lines l\n    JOIN laplace.physicalities p\n      ON p.entity_id = l.line_id\n     AND p.type = $3\n    CROSS JOIN LATERAL (\n        SELECT ids[i + 1] AS nxt\n        FROM (\n            SELECT public.laplace_trajectory_constituent_ids(p.trajectory) AS ids\n        ) t\n        CROSS JOIN LATERAL generate_subscripts(t.ids, 1) AS s(i)\n        WHERE t.ids[s.i] = $1\n          AND s.i < cardinality(t.ids)\n        LIMIT 1\n    ) step\n    WHERE step.nxt IS NOT NULL\n)\nSELECT nxt, count(*)::bigint AS n\nFROM steps\nGROUP BY nxt\nORDER BY n DESC, nxt\nLIMIT $4")

SQL_QUERY("measurement.ingest_snapshot", "",
    "SELECT coalesce(string_agg(j.run_id::text || '|' || j.source_name || '|'   || j.input_units_done || '|' || j.input_units_total, E'\\n' ORDER BY j.run_id), '') FROM laplace.ingest_run_journal j WHERE j.status = 'running'")

SQL_QUERY("measurement.active_ingest_backends", "",
    "SELECT count(*) FROM pg_stat_activity WHERE datname = current_database() AND state = 'active'   AND pid <> pg_backend_pid()   AND query ~* 'consensus\\.upsert|COPY laplace\\.|highway_mask_deposit|attestations_exist|physicalities_exist'")

/* Ingest journal commands: parameter types are part of the shared contract. */
SQL_QUERY("journal.throughput_verdict", "uuid",
    "SELECT status, throughput_status, throughput_compared, throughput_rows, throughput_elapsed_ms, throughput_rows_per_s, throughput_baseline_rows_per_s, throughput_slowdown_ratio FROM laplace.ingest_run_journal WHERE run_id = $1")
SQL_QUERY("journal.liveness_lock", "int4,text",
    "SELECT pg_advisory_lock($1,hashtext($2))")
SQL_QUERY("journal.artifact_inventory", "uuid,text,text[],text[],text[],text[],text[],text[],int8[],timestamptz[]",
    "INSERT INTO laplace.ingest_file_journal AS current_file (run_id, file_label, source_name, artifact_id, relative_path, disposition, disposition_reason, status, bytes, modified_at, started_at, ended_at) SELECT $1, u.file_label, $2, u.artifact_id, u.relative_path, u.disposition, u.reason, u.status, u.bytes, u.modified_at, now(), CASE WHEN u.status = 'not-selected' THEN now() ELSE NULL END FROM unnest($3, $4, $5, $6, $7, $8, $9, $10) AS u(file_label, artifact_id, relative_path, disposition, reason, status, bytes, modified_at) ON CONFLICT (run_id, file_label) DO UPDATE SET artifact_id = EXCLUDED.artifact_id, relative_path = EXCLUDED.relative_path, disposition = EXCLUDED.disposition, disposition_reason = EXCLUDED.disposition_reason, status = EXCLUDED.status, bytes = EXCLUDED.bytes, modified_at = EXCLUDED.modified_at, ended_at = EXCLUDED.ended_at")
SQL_QUERY("journal.reconcile_orphans", "",
    "SELECT * FROM ops.ingest_reconcile_orphans(interval '90 seconds')")
SQL_QUERY("journal.run_progress", "uuid,int8,int8,int8,int8,int8,int8,int8,int8,int8,int8,int8,int8,int8",
    "UPDATE laplace.ingest_run_journal SET units_attempted = $2, units_applied = $3, units_failed = $4, entities = $5, physicalities = $6, attestations = $7, files_done = $8, input_units_done = $9, consensus_backend_ms = $10, highway_mask_backend_ms = $11, consensus_calls = $12, highway_mask_calls = $13, highway_mask_pairs = $14 WHERE run_id = $1")
SQL_QUERY("journal.native_inventory", "uuid,int8",
    "UPDATE laplace.ingest_run_journal SET files_total=$2,input_units_total=$2 WHERE run_id=$1")
SQL_QUERY("journal.native_source", "uuid,bytea",
    "UPDATE laplace.ingest_run_journal SET source_id=$2 WHERE run_id=$1")
SQL_QUERY("journal.native_files_finished", "uuid,text",
    "UPDATE laplace.ingest_file_journal SET status=$2,ended_at=clock_timestamp() WHERE run_id=$1 AND status IN ('running','composed')")
SQL_QUERY("journal.run_start_unidentified", "uuid,text,int4,int8,int8,bool",
    "INSERT INTO laplace.ingest_run_journal (run_id,source_name,source_id,layer,status,files_total,input_units_total,evidence_persisted,attestations_measured,file_counters_measured) VALUES ($1,$2,NULL,$3,'running',$4,$5,$6,false,false)")
SQL_QUERY("journal.run_phase", "uuid,text",
    "UPDATE laplace.ingest_run_journal SET phase = $2 WHERE run_id = $1")
SQL_QUERY("journal.run_completion", "uuid,int8,int8,int8,int8,int8,int8,int8,int8",
    "UPDATE laplace.ingest_run_journal SET fold_drain_ms = $2, writer_maintenance_ms = $3, fold_span_ms = $4, consensus_backend_ms = $5, highway_mask_backend_ms = $6, consensus_calls = $7, highway_mask_calls = $8, highway_mask_pairs = $9 WHERE run_id = $1")
SQL_QUERY("journal.run_finished", "uuid,text,int8,int8,int8,int8,int8,int8,text,int8,int8,int8,int8",
    "UPDATE laplace.ingest_run_journal SET status = $2, phase = CASE WHEN $2 = 'failed' THEN 'failed' ELSE 'complete' END, ended_at = now(), throughput_elapsed_ms = $13, units_attempted = $3, units_applied = $4, units_failed = $5, entities = $6, physicalities = $7, attestations = $8, error = COALESCE($9, error), files_done = $10, input_units_done = $11, input_units_total = $12 WHERE run_id = $1")
SQL_QUERY("journal.run_failed", "uuid,text,text",
    "UPDATE laplace.ingest_run_journal SET status = $2, phase = 'failed', ended_at = now(), error = $3 WHERE run_id = $1")
SQL_QUERY("journal.failed_before_start", "uuid,text,text,bool,text",
    "INSERT INTO laplace.ingest_run_journal (run_id, source_name, source_id, layer, status, phase, ended_at, evidence_persisted, error) VALUES ($1, $2, laplace.source_id($2), -1, $3, 'failed', now(), $4, $5)")
SQL_QUERY("journal.run_skip_identified", "uuid,text,bytea,int4,bool",
    "INSERT INTO laplace.ingest_run_journal (run_id, source_name, source_id, layer, status, phase, ended_at, evidence_persisted) VALUES ($1, $2, $3, $4, 'skipped-complete', 'complete', now(), $5)")
SQL_QUERY("journal.run_skip_named", "uuid,text,int4,bool",
    "INSERT INTO laplace.ingest_run_journal (run_id, source_name, source_id, layer, status, phase, ended_at, evidence_persisted) VALUES ($1, $2, laplace.source_id($2), $3, 'skipped-complete', 'complete', now(), $4)")
SQL_QUERY("journal.run_start_identified", "uuid,text,bytea,int4,int8,int8,bool",
    "INSERT INTO laplace.ingest_run_journal (run_id, source_name, source_id, layer, status, files_total, input_units_total, evidence_persisted) VALUES ($1, $2, $3, $4, 'running', $5, $6, $7)")
SQL_QUERY("journal.run_start_named", "uuid,text,int4,int8,int8,bool",
    "INSERT INTO laplace.ingest_run_journal (run_id, source_name, source_id, layer, status, files_total, input_units_total, evidence_persisted) VALUES ($1, $2, laplace.source_id($2), $3, 'running', $4, $5, $6)")
SQL_QUERY("journal.accepted_run", "uuid,text,bytea,timestamptz,timestamptz,int8,int8,int8,int8,bool",
    "INSERT INTO laplace.ingest_run_journal (run_id, source_name, source_id, layer, status, phase, started_at, ended_at, units_attempted, units_applied, entities, physicalities, attestations, files_done, files_total, input_units_done, input_units_total, throughput_elapsed_ms, evidence_persisted) VALUES ($1, $2, $3, 0, 'ok', 'complete', $4, $5, 1, 1, $6, $7, $8, 1, 1, 1, 1, $9, $10)")
SQL_QUERY("journal.accepted_file", "uuid,text,text,bytea,timestamptz,timestamptz,int8,timestamptz,int8,int8,int8",
    "INSERT INTO laplace.ingest_file_journal (run_id, file_label, source_name, file_id, status, started_at, ended_at, bytes, modified_at, records, entities, physicalities, attestations) VALUES ($1, $2, $3, $4, 'ok', $5, $6, $7, $8, 1, $9, $10, $11)")
SQL_QUERY("journal.heartbeat", "uuid",
    "UPDATE laplace.ingest_run_journal SET heartbeat_at = clock_timestamp() WHERE run_id = $1 AND status = 'running'")
SQL_QUERY("journal.files_started", "uuid,text[],text[],int8[],timestamptz[],timestamptz[]",
    "INSERT INTO laplace.ingest_file_journal AS current_file (run_id, file_label, source_name, status, bytes, modified_at, started_at) SELECT $1, u.file_label, u.source_name, 'running', u.bytes, u.modified_at, u.at FROM unnest($2, $3, $4, $5, $6) AS u(file_label, source_name, bytes, modified_at, at) ON CONFLICT (run_id, file_label) DO UPDATE SET status = 'running', started_at = EXCLUDED.started_at, ended_at = NULL, error = NULL, bytes = EXCLUDED.bytes, modified_at = COALESCE(EXCLUDED.modified_at, current_file.modified_at), file_id = NULL, resume_fingerprint = NULL, records = 0, entities = 0, physicalities = 0, attestations = 0")
SQL_QUERY("journal.files_progress", "uuid,text[],int8[],int8[],int8[],int8[]",
    "UPDATE laplace.ingest_file_journal f SET records = u.records, entities = u.entities, physicalities = u.physicalities, attestations = u.attestations FROM unnest($2, $3, $4, $5, $6) AS u(file_label, records, entities, physicalities, attestations) WHERE f.run_id = $1 AND f.file_label = u.file_label AND f.status = 'running'")
SQL_QUERY("journal.files_composed", "uuid,text[],text[],bytea[],bytea[],int8[],int8[],int8[],int8[],timestamptz[]",
    "INSERT INTO laplace.ingest_file_journal AS current_file (run_id, file_label, source_name, file_id, resume_fingerprint, status, records, entities, physicalities, attestations, started_at) SELECT $1, u.file_label, u.source_name, u.file_id, u.resume_fingerprint, 'composed', u.records, u.entities, u.physicalities, u.attestations, u.at FROM unnest($2, $3, $4, $5, $6, $7, $8, $9, $10) AS u(file_label, source_name, file_id, resume_fingerprint, records, entities, physicalities, attestations, at) ON CONFLICT (run_id, file_label) DO UPDATE SET file_id = COALESCE(EXCLUDED.file_id, current_file.file_id), resume_fingerprint = COALESCE(EXCLUDED.resume_fingerprint, current_file.resume_fingerprint), status = 'composed', records = EXCLUDED.records, entities = EXCLUDED.entities, physicalities = EXCLUDED.physicalities, attestations = EXCLUDED.attestations")
SQL_QUERY("journal.files_finished", "uuid,text[],text[],text[],timestamptz[],text[]",
    "INSERT INTO laplace.ingest_file_journal (run_id, file_label, source_name, status, ended_at, error, started_at) SELECT $1, u.file_label, u.source_name, u.status, u.at, u.error, u.at FROM unnest($2, $3, $4, $5, $6) AS u(file_label, source_name, status, at, error) ON CONFLICT (run_id, file_label) DO UPDATE SET status = EXCLUDED.status, ended_at = EXCLUDED.ended_at, error = EXCLUDED.error")

