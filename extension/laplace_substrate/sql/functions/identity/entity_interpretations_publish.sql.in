-- ONE owner for interpretation publication. Callers provide the already
-- content-identified entity ids and their observed structural facets. Canonical
-- entity rows are verified set-wise before mutation. Publication remains optimistic:
-- unrelated ids stay parallel, and exact absent-facet races are handled by the
-- existing whole-apply retry; no conflict-upsert arbitration is needed.
CREATE OR REPLACE FUNCTION @extschema@.entity_interpretations_publish(
    p_entity_ids bytea[],
    p_tiers smallint[],
    p_type_ids bytea[],
    p_source_ids bytea[],
    p_source_is_null boolean[])
RETURNS boolean
LANGUAGE plpgsql VOLATILE PARALLEL UNSAFE
AS $$
DECLARE
    n integer := COALESCE(cardinality(p_entity_ids), 0);
BEGIN
    IF n <> COALESCE(cardinality(p_tiers), 0)
       OR n <> COALESCE(cardinality(p_type_ids), 0)
       OR n <> COALESCE(cardinality(p_source_ids), 0)
       OR n <> COALESCE(cardinality(p_source_is_null), 0) THEN
        RAISE EXCEPTION 'entity interpretation arrays must have identical cardinality'
            USING ERRCODE = '22023';
    END IF;
    IF n = 0 THEN
        RETURN false;
    END IF;

    -- Missing canonical identity is a caller/protocol error. Keep this one
    -- complete set check before mutation; identity is never synthesized here.
    -- Reuse the native HASH(id) routed batch probe. Resolvability from the
    -- codepoint perfcache is deliberately insufficient: these must be stored rows.
    IF bit_count(@extschema@.entities_stored_bitmap(p_entity_ids)) <> n THEN
        RETURN true;
    END IF;

    /*
     * Publication is deliberately optimistic and set-sized. Canonical ingest
     * already verifies identity immediately before pure COPY and retries a rare
     * uniqueness race. Do not turn the normal path back into a per-content row
     * locking convoy here.
     *
     * Materialize the observed facet set once. Existing facets only change when
     * a lower non-null compatibility source arrives; missing facets are inserted
     * without conflict-upsert arbitration. If two concurrent publishers race for the same exact
     * absent facet, the unique key rejects one transaction and the existing
     * whole-apply concurrency retry re-probes it.
     *
     * The compatibility columns on entities are monotone minima. Fold the
     * incoming minima directly into that already-maintained projection instead
     * of rescanning/grouping entity_interpretations for every working set.
     */
    WITH input AS MATERIALIZED (
        SELECT DISTINCT ON (u.entity_id, u.tier, u.type_id)
               u.entity_id, u.tier, u.type_id,
               CASE WHEN u.source_is_null THEN NULL::bytea ELSE u.source_id END
                   AS first_observed_by
        FROM unnest(p_entity_ids, p_tiers, p_type_ids, p_source_ids, p_source_is_null)
             AS u(entity_id, tier, type_id, source_id, source_is_null)
        ORDER BY u.entity_id, u.tier, u.type_id,
                 CASE WHEN u.source_is_null THEN NULL::bytea ELSE u.source_id END NULLS LAST
    ), published_facets AS (
        -- One indexed match supplies both branches. Separate UPDATE and anti-join
        -- INSERT statements probe the same complete facet set twice on every replay.
        MERGE INTO @extschema@.entity_interpretations ei
        USING input i
        ON ei.entity_id = i.entity_id AND ei.tier = i.tier AND ei.type_id = i.type_id
        WHEN MATCHED AND i.first_observed_by IS NOT NULL
          AND (ei.first_observed_by IS NULL OR i.first_observed_by < ei.first_observed_by)
          THEN UPDATE SET first_observed_by = i.first_observed_by
        WHEN NOT MATCHED THEN INSERT (entity_id, tier, type_id, first_observed_by)
          VALUES (i.entity_id, i.tier, i.type_id, i.first_observed_by)
        RETURNING ei.entity_id
    ), incoming_summary AS MATERIALIZED (
        SELECT i.entity_id,
               min(i.tier)::smallint AS tier,
               (array_agg(i.type_id ORDER BY i.type_id))[1] AS type_id,
               (array_agg(i.first_observed_by ORDER BY i.first_observed_by)
                   FILTER (WHERE i.first_observed_by IS NOT NULL))[1]
                   AS first_observed_by
        FROM input i
        GROUP BY i.entity_id
    )
    UPDATE @extschema@.entities e
       SET tier = LEAST(e.tier, s.tier),
           type_id = CASE WHEN e.type_id <= s.type_id THEN e.type_id ELSE s.type_id END,
           first_observed_by = CASE
               WHEN e.first_observed_by IS NULL THEN s.first_observed_by
               WHEN s.first_observed_by IS NULL THEN e.first_observed_by
               WHEN e.first_observed_by <= s.first_observed_by THEN e.first_observed_by
               ELSE s.first_observed_by
           END
      FROM incoming_summary s
     WHERE e.id = s.entity_id
       AND (e.tier, e.type_id, e.first_observed_by)
           IS DISTINCT FROM
           (LEAST(e.tier, s.tier),
            CASE WHEN e.type_id <= s.type_id THEN e.type_id ELSE s.type_id END,
            CASE
                WHEN e.first_observed_by IS NULL THEN s.first_observed_by
                WHEN s.first_observed_by IS NULL THEN e.first_observed_by
                WHEN e.first_observed_by <= s.first_observed_by THEN e.first_observed_by
                ELSE s.first_observed_by
            END);

    RETURN false;
END;
$$;

-- Ordinary ad-hoc INSERT/COPY may create a canonical entity exactly once. Its
-- initial facet is forwarded set-wise to the SAME publisher above. Re-inserting
-- an existing content id is a normal primary-key violation; direct SQL is not a
-- second identity/admission protocol and does not silently merge or rewrite it.
CREATE OR REPLACE FUNCTION @extschema@.entity_identity_capture_statement()
RETURNS trigger
LANGUAGE plpgsql
AS $$
DECLARE
    missing boolean;
BEGIN
    SELECT @extschema@.entity_interpretations_publish(
        array_agg(id ORDER BY id),
        array_agg(tier ORDER BY id),
        array_agg(type_id ORDER BY id),
        array_agg(first_observed_by ORDER BY id),
        array_agg(first_observed_by IS NULL ORDER BY id))
      INTO missing
      FROM inserted_entities;
    IF missing THEN
        RAISE EXCEPTION 'inserted entity disappeared before interpretation publication'
            USING ERRCODE = '23503';
    END IF;
    RETURN NULL;
END;
$$;

DROP TRIGGER IF EXISTS entity_identity_admit ON entities;
DROP TRIGGER IF EXISTS entity_identity_capture ON entities;
DROP FUNCTION IF EXISTS @extschema@.entity_identity_admit();
DROP FUNCTION IF EXISTS @extschema@.entity_write_lock();
CREATE TRIGGER entity_identity_capture
AFTER INSERT ON entities
REFERENCING NEW TABLE AS inserted_entities
FOR EACH STATEMENT EXECUTE FUNCTION @extschema@.entity_identity_capture_statement();
