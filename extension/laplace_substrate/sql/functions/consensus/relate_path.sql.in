-- Native path election. The C implementation expands each taxonomy frontier in
-- one batched SPI call per depth, deduplicates by node at minimum depth, and
-- retains the widest bottleneck on same-depth rediscovery. Every lexical sense
-- seeds both arms with its attested sense mu. The lateral plane is two batched
-- scans over the same installed taxonomy edge surface, one per orientation.
-- Relation membership remains owned by the manifest-generated
-- consensus.relation_set_ids operation; no relation roster is duplicated here
-- or in C.
DROP FUNCTION IF EXISTS laplace.relate_path_raw(bytea, bytea, int);
CREATE OR REPLACE FUNCTION consensus.relate_path_raw(
        p_x bytea,
        p_y bytea,
        p_depth int DEFAULT 7)
    RETURNS TABLE(nodes bytea[], types bytea[], dirs int[],
                  path_mu numeric, plane_type bytea)
    LANGUAGE C STABLE STRICT PARALLEL SAFE
    AS 'MODULE_PATHNAME', 'pg_laplace_relate_path_raw';

-- Rendering is deliberately outside the search and runs once, after native
-- election. There is no session SET clause: the body is fully qualified and
-- remains eligible for SQL inlining.
DROP FUNCTION IF EXISTS laplace.relate_path(bytea, bytea, int);
CREATE OR REPLACE FUNCTION consensus.relate_path(
        p_x bytea,
        p_y bytea,
        p_depth int DEFAULT 7)
    RETURNS TABLE(chain text, path_mu numeric, plane text)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT realize.path(r.nodes, r.types, r.dirs,
                        COALESCE(converse.word_language(p_x),
                                 converse.word_language(p_y))) AS chain,
           r.path_mu,
           CASE WHEN r.plane_type IS NULL THEN 'taxonomy'
                ELSE lexical.type_label(r.plane_type) END AS plane
    FROM consensus.relate_path_raw(p_x, p_y, p_depth) r;
END;
