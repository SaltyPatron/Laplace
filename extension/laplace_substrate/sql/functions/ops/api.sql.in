-- CREATE OR REPLACE cannot change a function's result columns, so a
-- differently shaped installed ops.api is dropped first.
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.api(text)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(name text, args text, returns text, kind text)'
             OR proargnames IS DISTINCT FROM ARRAY['p_like','name','args','returns','kind']::text[])) THEN
        DROP FUNCTION ops.api(text);
    END IF;
END $upgrade_shape$;

-- `kind` says function or procedure: a procedure is invoked with CALL and a
-- function with SELECT, so a caller needs it to issue the right statement.
-- It is the last column, so positional readers are unaffected.
CREATE OR REPLACE FUNCTION ops.api(p_like text DEFAULT NULL)
    RETURNS TABLE(name text, args text, returns text, kind text)
    LANGUAGE sql STABLE
BEGIN ATOMIC

    SELECT CASE WHEN n.nspname = 'laplace' THEN p.proname::text
                ELSE n.nspname || '.' || p.proname END,
           pg_get_function_arguments(p.oid),
           pg_get_function_result(p.oid),
           CASE p.prokind WHEN 'p' THEN 'procedure'
                          WHEN 'a' THEN 'aggregate'
                          WHEN 'w' THEN 'window'
                          ELSE 'function' END
    FROM pg_proc p
    JOIN pg_namespace n ON n.oid = p.pronamespace
    WHERE (
            n.nspname = ANY (ARRAY[
                'laplace','consensus','converse','lexical','taxonomy',
                'generation','structural','chess','realize','ops'
            ])
            -- Public native helpers listed so callers find them in the catalog
            -- instead of reimplementing them.
            OR (n.nspname = 'public' AND p.proname = ANY (ARRAY[
                'laplace_frechet_4d',
                'laplace_hilbert_encode',
                'laplace_radius_origin',
                'laplace_hash128_blake3',
                'laplace_mantissa_unpack',
                'laplace_distance_4d',
                'laplace_angular_distance_4d',
                'laplace_direction_4d'
            ]))
          )
      AND (p_like IS NULL
           OR p.proname ILIKE '%'||p_like||'%'
           OR (n.nspname || '.' || p.proname) ILIKE '%'||p_like||'%')
    ORDER BY n.nspname, p.proname
;
END;
