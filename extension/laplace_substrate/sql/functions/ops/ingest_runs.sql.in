-- Ingest-run liveness and recent history. A persisted status = 'running' is a
-- journal fact, not proof the run is alive. Liveness has two witnesses: the
-- per-run advisory lock the ingest writer holds, and a heartbeat advanced by
-- run/file journal writes. A run is orphaned only when both are absent or
-- stale; every reader and reconciler here uses that one predicate.

ALTER TABLE @extschema@.ingest_run_journal
    ADD COLUMN IF NOT EXISTS heartbeat_at timestamptz NOT NULL DEFAULT now();

-- A run that discovers files as it goes can start with files_total = 0. Once
-- terminal, files_done is a lower bound on the total, so a terminal row never
-- shows files_done > files_total.
UPDATE @extschema@.ingest_run_journal
   SET files_total = files_done
 WHERE status <> 'running'
   AND files_total < files_done;

CREATE OR REPLACE FUNCTION ops.ingest_run_live(
    p_run uuid,
    p_stale_after interval DEFAULT interval '90 seconds')
RETURNS boolean
LANGUAGE sql
STABLE
BEGIN ATOMIC
    SELECT COALESCE((
        SELECT j.status = 'running'
           AND (
               j.heartbeat_at >= now() - greatest(p_stale_after, interval '0 seconds')
               OR EXISTS (
                   SELECT 1
                     FROM pg_catalog.pg_locks l
                    WHERE l.locktype = 'advisory'
                      AND l.database = (
                          SELECT d.oid
                            FROM pg_catalog.pg_database d
                           WHERE d.datname = current_database())
                      AND l.classid = 1280330827::oid -- 0x4C504C4B, "LPLK"
                      AND l.objsubid = 2
                      AND l.objid::bigint =
                          (hashtext(j.run_id::text)::bigint & 4294967295)
               )
           )
          FROM @extschema@.ingest_run_journal j
         WHERE j.run_id = p_run
    ), false);
END;

CREATE OR REPLACE FUNCTION ops.ingest_run_touch()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
    -- A cancel that cites only a missing advisory lock is refused while the
    -- liveness predicate still sees a fresh heartbeat or the lock.
    IF OLD.status = 'running'
       AND NEW.status = 'cancelled'
       AND COALESCE(NEW.error, '') LIKE 'run did not reach completion: liveness lock absent%'
       AND ops.ingest_run_live(OLD.run_id, interval '90 seconds') THEN
        RETURN NULL;
    END IF;

    IF OLD.status = 'running' THEN
        NEW.heartbeat_at := clock_timestamp();
        IF NEW.status <> 'running' AND NEW.files_total < NEW.files_done THEN
            NEW.files_total := NEW.files_done;
        END IF;
    END IF;
    RETURN NEW;
END
$$;

DROP TRIGGER IF EXISTS ingest_run_touch ON @extschema@.ingest_run_journal;
CREATE TRIGGER ingest_run_touch
BEFORE UPDATE ON @extschema@.ingest_run_journal
FOR EACH ROW
EXECUTE FUNCTION ops.ingest_run_touch();

CREATE OR REPLACE FUNCTION ops.ingest_file_touch_run()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
    -- File lifecycle writes are sets: each owning run is touched once per
    -- statement (COPY and conflict updates included), not once per file.
    UPDATE @extschema@.ingest_run_journal j
       SET heartbeat_at = clock_timestamp()
      FROM (SELECT DISTINCT run_id FROM changed_files) f
     WHERE j.run_id = f.run_id
       AND j.status = 'running';
    RETURN NULL;
END
$$;

DROP TRIGGER IF EXISTS ingest_file_touch_run ON @extschema@.ingest_file_journal;
DROP TRIGGER IF EXISTS ingest_file_touch_run_insert ON @extschema@.ingest_file_journal;
DROP TRIGGER IF EXISTS ingest_file_touch_run_update ON @extschema@.ingest_file_journal;
CREATE TRIGGER ingest_file_touch_run_insert
AFTER INSERT ON @extschema@.ingest_file_journal
REFERENCING NEW TABLE AS changed_files
FOR EACH STATEMENT
EXECUTE FUNCTION ops.ingest_file_touch_run();
CREATE TRIGGER ingest_file_touch_run_update
AFTER UPDATE ON @extschema@.ingest_file_journal
REFERENCING NEW TABLE AS changed_files
FOR EACH STATEMENT
EXECUTE FUNCTION ops.ingest_file_touch_run();

CREATE OR REPLACE FUNCTION ops.ingest_reconcile_orphans(
    p_stale_after interval DEFAULT interval '90 seconds')
RETURNS TABLE(
    run_id uuid,
    source_name text,
    input_units_done bigint,
    input_units_total bigint)
LANGUAGE sql
VOLATILE
SECURITY DEFINER
SET search_path = pg_catalog, laplace, ops
BEGIN ATOMIC
    WITH dead AS (
        UPDATE laplace.ingest_run_journal j
           SET status = 'cancelled',
               phase = 'cancelled',
               ended_at = clock_timestamp(),
               error = 'run did not reach completion: heartbeat stale and liveness lock absent; reconciled by canonical ingest liveness'
         WHERE j.status = 'running'
           AND NOT ops.ingest_run_live(j.run_id, p_stale_after)
        RETURNING j.run_id, j.source_name, j.input_units_done, j.input_units_total
    ), closed_files AS (
        UPDATE laplace.ingest_file_journal f
           SET status = 'cancelled',
               ended_at = clock_timestamp(),
               error = 'file did not reach completion: owning ingest run was reconciled as orphaned'
          FROM dead d
         WHERE f.run_id = d.run_id
           AND f.status IN ('inventoried', 'running', 'composed')
        RETURNING f.run_id
    )
    SELECT d.run_id, d.source_name, d.input_units_done, d.input_units_total
      FROM dead d;
END;

-- Ingest run history, newest first. Read-only: valid inside a read-only
-- transaction. A stale 'running' row is projected as cancelled by the same
-- liveness predicate the reconciler uses; reading never writes the journal.
DROP FUNCTION IF EXISTS laplace.ingest_runs(int);
CREATE OR REPLACE FUNCTION ops.ingest_runs(p_limit int DEFAULT 20)
RETURNS SETOF laplace.ingest_run_journal
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = pg_catalog, laplace, ops
BEGIN ATOMIC
    SELECT jsonb_populate_record(
               j,
               CASE
                   WHEN j.status = 'running'
                    AND NOT ops.ingest_run_live(j.run_id, interval '90 seconds')
                   THEN jsonb_build_object(
                       'status', 'cancelled',
                       'phase', 'cancelled',
                       'ended_at', COALESCE(j.ended_at, now()),
                       'error', COALESCE(
                           j.error,
                           'run did not reach completion: heartbeat stale and liveness lock absent'))
                   ELSE '{}'::jsonb
               END)
      FROM laplace.ingest_run_journal j
     ORDER BY j.started_at DESC
     LIMIT greatest(p_limit, 0);
END;
