DROP FUNCTION IF EXISTS laplace.anagrams_of(text);
CREATE OR REPLACE FUNCTION structural.anagrams_of(p_word text)
    RETURNS TABLE(word text, entity_id bytea)
    LANGUAGE sql STABLE
 AS $$
    SELECT laplace.render(d.entity_id), d.entity_id
    FROM (
        SELECT DISTINCT w2.id AS entity_id
        FROM laplace.v_word_points w1
        JOIN laplace.v_word_points w2 ON w2.hilbert_index = w1.hilbert_index
        WHERE w1.id = laplace.word_id(p_word)
          AND w2.type_id = laplace.canonical_id('Word')
          AND w2.id <> w1.id
    ) d
    ORDER BY d.entity_id
$$;
