-- Attestations with their five endpoint ids realized through label_or_hex,
-- the one id-display rule. Each row pays five realizations: read it only under
-- a selective predicate and LIMIT, never as the base of a fold, ingest, or
-- unbounded join.
CREATE OR REPLACE VIEW laplace.v_attestation_readable AS
SELECT a.id,
       a.subject_id,
       a.type_id,
       a.object_id,
       a.source_id,
       a.context_id,
       a.outcome,
       a.observation_count,
       a.sum_score_fp1e9,
       a.opponent_rd_fp1e9,
       a.last_observed_at,
       (SELECT lp_l.content FROM public.laplace_labels(array_remove(ARRAY[(a.subject_id)::bytea],NULL)::public.blake3[]) lp_l) AS subject_label,
       (SELECT lp_l.content FROM public.laplace_labels(array_remove(ARRAY[(a.type_id)::bytea],NULL)::public.blake3[]) lp_l)    AS type_label,
       (SELECT lp_l.content FROM public.laplace_labels(array_remove(ARRAY[(a.object_id)::bytea],NULL)::public.blake3[]) lp_l)  AS object_label,
       (SELECT lp_l.content FROM public.laplace_labels(array_remove(ARRAY[(a.source_id)::bytea],NULL)::public.blake3[]) lp_l)  AS source_label,
       (SELECT lp_l.content FROM public.laplace_labels(array_remove(ARRAY[(a.context_id)::bytea],NULL)::public.blake3[]) lp_l) AS context_label
FROM laplace.attestations a;
