-- NO `SET search_path` (GH #860, #617 item 6). realize() is the per-row labeling
-- scalar of the entire read path -- every arrow render, every relation listing,
-- every reply. The clause made SQL inlining impossible, so each row paid a full
-- function execution for what is a COALESCE over four cheap resolvers.
--
-- Every reference is `@extschema@.`-qualified instead: same resolution, decided at
-- parse time, no per-row tax. (The durable fix for the qualification noise itself is
-- purpose schemas -- schema/purpose_schemas.sql.in, GH #862 -- where a family's own
-- members need no prefix at all and only cross-family calls carry one.)
CREATE OR REPLACE FUNCTION realize(p_id bytea, p_lang bytea DEFAULT NULL)
    RETURNS text
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    -- resolve_name() is the single, referentially-correct name primitive: it
    -- folds the former _realize_has_name (HAS_NAME primary + HAS_NAME_ALIAS) and
    -- _realize_synset_lemma into one family-aware, abstaining resolver. It replaces
    -- the two separate arms this function used to run (synset-lemma first, HAS_NAME
    -- buried after translation); now the authoritative NAME wins ahead of a
    -- rendered self or a translation guess. The remaining arms stay as realize's
    -- own display fallbacks (raw render, translation, canonical id, gloss).
    SELECT COALESCE(
        @extschema@.resolve_name(p_id, p_lang),
        NULLIF(@extschema@.render_text(p_id, 24), ''),
        @extschema@._realize_translation(p_id, p_lang),
        @extschema@._realize_canonical(p_id),
        @extschema@._realize_defines(p_id))
$$;
