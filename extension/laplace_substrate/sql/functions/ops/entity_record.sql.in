-- Subject-exact Native claim verdicts; the existing volatility rule is unchanged.
DROP FUNCTION IF EXISTS laplace.entity_record(bytea);
CREATE OR REPLACE FUNCTION ops.entity_record(p_id bytea)
RETURNS TABLE(confirmed bigint,contested bigint,refuted bigint,thin bigint)
LANGUAGE sql STABLE
BEGIN ATOMIC
WITH subject AS (SELECT pg_catalog.encode(p_id,'hex')::public.blake3 AS id), direct AS MATERIALIZED (
 SELECT c.rating,c.deviation,c.volatility,
 CASE WHEN public.laplace_path_length(c.path)=3 THEN
  (public.laplace_vertex_ids(public.ST_PointN(c.path,CASE WHEN public.laplace_path_length(public.ST_PointN(c.path,1))>=2 THEN 1 ELSE 2 END)))[1] END AS predicate
 FROM subject s CROSS JOIN LATERAL public.laplace_claims_each(ARRAY[s.id],NULL::bigint,
 ARRAY[public.laplace_bank_bit('kind','claim')],'{}'::public.blake3[],1::smallint) c
 WHERE public.laplace_path_starts(c.path,s.id)
), metadata AS MATERIALIZED (
 SELECT * FROM consensus.relation_metadata(ARRAY(SELECT DISTINCT pg_catalog.decode(predicate::text,'hex') FROM direct WHERE predicate IS NOT NULL))
), initial AS (
 SELECT volatility FROM public.laplace_series(ARRAY[]::public.blake3[],ARRAY[]::bigint[],ARRAY[]::double precision[],ARRAY[]::double precision[])
), verdicts AS (
 SELECT CASE WHEN public.laplace_confidence(d.rating,d.deviation,-2)<0.5 THEN 'refuted'
 WHEN public.laplace_confidence(d.rating,d.deviation,2)>0.5 THEN 'confirmed'
 WHEN d.volatility>initial.volatility*1.5 THEN 'contested' ELSE 'thin' END AS status
 FROM direct d CROSS JOIN initial LEFT JOIN metadata m ON m.surface_id=pg_catalog.decode(d.predicate::text,'hex')
 WHERE m.canonical IS NULL OR m.canonical NOT IN ('HAS_SENSE','IS_SENSE_OF','HAS_LANGUAGE')
)
SELECT count(*) FILTER(WHERE status='confirmed'),count(*) FILTER(WHERE status='contested'),
 count(*) FILTER(WHERE status='refuted'),count(*) FILTER(WHERE status='thin') FROM verdicts;
END;
