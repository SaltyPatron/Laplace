DROP FUNCTION IF EXISTS laplace.consensus_layer_plane(bytea[], float8, float8, int);
CREATE OR REPLACE FUNCTION generation.consensus_layer_plane(
        p_vocab bytea[], p_rank_lo float8, p_rank_hi float8, p_degree_cap int DEFAULT 48)
    RETURNS TABLE(subject_id bytea, object_id bytea, w double precision, layer_rank double precision)
    LANGUAGE sql STABLE PARALLEL RESTRICTED  AS $$
    WITH v(id) AS (SELECT DISTINCT u FROM unnest(p_vocab) AS u),
         -- MATERIALIZED is load-bearing here: edges is referenced twice below
         -- (rk's DISTINCT type_id scan and ranked's join), so the fence avoids
         -- re-executing the v->consensus->v join. Do not strip.
         edges AS MATERIALIZED (
             SELECT c.subject_id, c.object_id, c.rating, c.rd, c.witness_count, c.type_id
             FROM v
             JOIN laplace.consensus c ON c.subject_id = v.id
             JOIN v vo        ON vo.id = c.object_id
         ),
         rk AS (
             SELECT d.type_id, r.rank
             FROM (SELECT DISTINCT type_id FROM edges) d
             CROSS JOIN LATERAL laplace.relation_rank_resolved(d.type_id) AS r(rank)
             WHERE r.rank IS NOT NULL AND r.rank BETWEEN p_rank_lo AND p_rank_hi
         ),
         -- P5 Glicko-complete weight (doc 14 M5): signed, rd-discounted,
         -- witness-saturated. laplace.walk_edge_weight IS the law; kappa resolved once
         -- rather than per row.
         kappa(k) AS (SELECT laplace.foundry_rd_kappa()),
         ranked AS (
             SELECT e.subject_id, e.object_id,
                    laplace.walk_edge_weight(e.rating, e.rd, e.witness_count,
                                     (SELECT k FROM kappa)) AS w,
                    rk.rank AS rk
             FROM edges e JOIN rk ON rk.type_id = e.type_id
         ),
         capped AS (
             SELECT r.subject_id, r.object_id, r.w, r.rk,
                    row_number() OVER (PARTITION BY r.subject_id ORDER BY r.rk * abs(r.w) DESC, r.object_id) AS rn
             FROM ranked r
         )
    SELECT c.subject_id, c.object_id, c.w, c.rk FROM capped c WHERE c.rn <= p_degree_cap
$$;
