-- Violations of the identity law: identical content is one id across tiers and
-- sources, and tier is altitude, never an input to the hash
-- (docs/specs/05_Substrate_Invariants.txt).
--
--   multi_tier_entity      one content id stored in more than one entities row.
--   ambiguous_physicality  one (entity_id, type, id) physicality key holding more
--                          than one distinct trajectory: the key does not
--                          determine its content, so any DISTINCT ON over it,
--                          and every REALIZE of it, depends on the plan.
--   dangling_entity_type   a type_id in use that the governed entity-type law
--                          does not declare, so no read can describe it.
--   tier_out_of_range      tier outside 0..255.
--
-- Reports ids so a caller can act on them, and is unbounded: a truncated
-- violation list hides violations.
CREATE OR REPLACE FUNCTION laplace.identity_law_violations()
RETURNS TABLE(id bytea, tier smallint, reason text)
LANGUAGE sql
STABLE
BEGIN ATOMIC
    SELECT e.id, e.tier, 'tier_out_of_range'::text
    FROM laplace.entities e
    WHERE e.tier < 0 OR e.tier >= 256

    UNION ALL

    -- Same content id stored at more than one tier: one entity, N rows.
    SELECT e.id, e.tier, 'multi_tier_entity'::text
    FROM laplace.entities e
    JOIN (SELECT d.id FROM laplace.entities d
          GROUP BY d.id HAVING count(*) > 1) dup ON dup.id = e.id

    UNION ALL

    -- One physicality key holding more than one distinct trajectory, so the key
    -- does not determine its content and reads over it are plan-dependent.
    SELECT p.entity_id, NULL::smallint, 'ambiguous_physicality'::text
    FROM (SELECT ph.entity_id, ph.type, ph.id
          FROM laplace.physicalities ph
          WHERE ph.trajectory IS NOT NULL
          GROUP BY ph.entity_id, ph.type, ph.id
          HAVING count(DISTINCT public.ST_AsBinary(ph.trajectory)) > 1) p

    UNION ALL

    -- A type_id in use that the governed entity-type law does not declare, reported
    -- once per type so the row count stays proportional to the defect.
    SELECT used.type_id, NULL::smallint, 'dangling_entity_type'::text
    FROM (SELECT DISTINCT e.type_id FROM laplace.entities e) used
    WHERE NOT EXISTS (SELECT 1 FROM laplace.entity_type_registry() t WHERE t.type_id = used.type_id);
END;
