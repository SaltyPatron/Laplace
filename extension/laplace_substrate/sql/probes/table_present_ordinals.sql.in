-- Diagnostic table-agnostic presence wrapper. The concrete fixed surfaces own the
-- set operations; this function only dispatches between them. Caller-side batching
-- owns concurrency, so the wrapper is PARALLEL RESTRICTED with its callees.
CREATE OR REPLACE FUNCTION laplace.table_present_ordinals(p_table text, p_ids bytea[])
    RETURNS TABLE(idx int)
    LANGUAGE sql STABLE PARALLEL RESTRICTED
AS $$
    SELECT o.idx FROM laplace.entities_present_ordinals(p_ids) o
    WHERE p_table = 'entities'
    UNION ALL
    SELECT o.idx FROM laplace.physicalities_present_ordinals(p_ids) o
    WHERE p_table = 'physicalities'
    UNION ALL
    SELECT o.idx FROM laplace.attestations_present_ordinals(p_ids) o
    WHERE p_table = 'attestations'
$$;
