DROP FUNCTION IF EXISTS laplace.physicality_count(bytea);
CREATE OR REPLACE FUNCTION converse.physicality_count(p_entity bytea)
    RETURNS bigint
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT CASE WHEN p_entity IS NULL THEN NULL::bigint
                ELSE (SELECT count(*)::bigint FROM laplace.physicalities pp WHERE pp.entity_id = p_entity)
           END;
END;
