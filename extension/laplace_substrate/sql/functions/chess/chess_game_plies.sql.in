-- GH #736 re-key: the input parameter was renamed (p_game -> p_event), which
-- CREATE OR REPLACE cannot do on the upgrade path.
DROP FUNCTION IF EXISTS laplace.chess_game_plies(bytea);
CREATE OR REPLACE FUNCTION chess.game_plies(p_event bytea)
    RETURNS TABLE(ply integer, position_id bytea, san text, clock text,
                  eval_token text, think_class text, move_quality text)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    -- A playing read back as LOOKUPS (GH #736). The parameter is the playing-EVENT
    -- handle; hop 1 follows (event, PLAYS_LINE, line) to the game CONTENT. Every
    -- per-ply fact is already an attestation keyed by context -- the EVENT for
    -- this playing's own testimony (clock/eval-token/think-class/quality the
    -- analyzer derived from ITS annotations) and the LINE for line-grain engine
    -- testimony (stockfish quality, a pure function of the position along the
    -- line) -- and the ordered boards are the LINE's trajectory. So the whole
    -- thing is one hop, one trajectory decode and one indexed pass, joined on
    -- the position each fact hangs from.
    --
    -- It was previously reconstructed by replaying the verbatim movetext through the chess
    -- engine on every request: parsing SAN, applying moves, re-deriving boards the analyzer
    -- had already composed and deposited. That recomputed at query time what ingest had
    -- already written -- the same mistake as aggregating a record that the fold had folded.
    -- Nothing here parses chess.
    --
    -- ORDER comes from the trajectory, which is the authority for the sequence: the line's
    -- physicality packs its position ids into the linestring mantissa, and
    -- trajectory_unpacked_points decodes them back in order, losslessly. Vertex 1 is the
    -- starting position, so ply N is vertex N+1 and the SAN hanging off vertex N is the move
    -- that LEFT it -- which is why san/clock join on the from-position, not the to-position.
    --
    -- A line with no trajectory returns nothing rather than guessing an order. That is the
    -- honest answer for a playing recorded before the trajectory lane ran; the caller
    -- replays the movetext for those.
    WITH played AS MATERIALIZED (
        SELECT pl.object_id AS line
        FROM laplace.attestations pl
        WHERE pl.subject_id = p_event
          AND pl.type_id = laplace.relation_type_id('PLAYS_LINE')
        -- Same pick as chess_game: event -> line is a convention, not a
        -- constraint, and a second source re-ingesting the PGN adds a row.
        -- Ordered so both surfaces resolve the SAME line for the same event.
        ORDER BY pl.object_id
        LIMIT 1
    ),
    line AS MATERIALIZED (
        -- trajectory_unpacked_points returns (entity_id, run_length, ctier) and NO ordinal:
        -- the sequence is the ROW ORDER of the decode, so WITH ORDINALITY is what names it.
        -- Reading a column that does not exist was a runtime resolution failure, invisible to
        -- a build and to a regress case that only exercised the no-trajectory branch.
        SELECT u.ord AS ordinal, u.entity_id AS pos
        FROM played p,
             LATERAL generation.trajectory_unpacked_points(p.line)
             WITH ORDINALITY AS u(entity_id, run_length, ctier, ord)
    ),
    facts AS MATERIALIZED (
        -- One indexed pass over this playing's per-ply evidence, both context grains.
        SELECT a.subject_id AS pos, a.type_id, a.object_id
        FROM laplace.attestations a
        WHERE (a.context_id = p_event
               OR a.context_id = (SELECT p.line FROM played p))
          AND a.type_id IN (laplace.relation_type_id('HAS_SAN'),
                            laplace.relation_type_id('HAS_CLOCK'),
                            laplace.relation_type_id('HAS_EVAL_TOKEN'),
                            laplace.relation_type_id('HAS_THINK_CLASS'),
                            laplace.relation_type_id('MOVE_QUALITY'))
    ),
    per_pos AS MATERIALIZED (
        SELECT f.pos,
               max(f.object_id) FILTER (
                   WHERE f.type_id = laplace.relation_type_id('HAS_SAN')) AS san_id,
               max(f.object_id) FILTER (
                   WHERE f.type_id = laplace.relation_type_id('HAS_CLOCK')) AS clock_id,
               max(f.object_id) FILTER (
                   WHERE f.type_id = laplace.relation_type_id('HAS_EVAL_TOKEN')) AS eval_id,
               max(f.object_id) FILTER (
                   WHERE f.type_id = laplace.relation_type_id('HAS_THINK_CLASS')) AS think_id,
               max(f.object_id) FILTER (
                   WHERE f.type_id = laplace.relation_type_id('MOVE_QUALITY')) AS quality_id
        FROM facts f
        GROUP BY f.pos
    ),
    surface_batch AS MATERIALIZED (
        -- Every surface this game needs, resolved in ONE realize_batch. Per-row realize.label() over
        -- a 200-ply game is what made the old path slow enough to look like it needed an
        -- engine.
        SELECT COALESCE(array_agg(DISTINCT s), '{}'::bytea[]) AS ids
        FROM per_pos p,
             LATERAL (VALUES (p.san_id), (p.clock_id), (p.eval_id),
                             (p.think_id), (p.quality_id)) v(s)
        WHERE s IS NOT NULL
    ),
    surface_text AS MATERIALIZED (
        SELECT q.id, t.txt
        FROM surface_batch b,
             LATERAL unnest(b.ids) WITH ORDINALITY AS q(id, i),
             LATERAL unnest(realize.batch(b.ids)) WITH ORDINALITY AS t(txt, j)
        WHERE q.i = t.j
    )
    SELECT l.ordinal::integer,
           l.pos,
           sn.txt, ck.txt, ev.txt, th.txt, mq.txt
    FROM line l
    LEFT JOIN per_pos p       ON p.pos = l.pos
    LEFT JOIN surface_text sn ON sn.id = p.san_id
    LEFT JOIN surface_text ck ON ck.id = p.clock_id
    LEFT JOIN surface_text ev ON ev.id = p.eval_id
    LEFT JOIN surface_text th ON th.id = p.think_id
    LEFT JOIN surface_text mq ON mq.id = p.quality_id
    ORDER BY l.ordinal
$$;
