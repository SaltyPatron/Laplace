@startuml
!pragma layout smetana
skinparam backgroundColor #FAFCFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #385978
skinparam componentBackgroundColor #E6EFF7
skinparam classBackgroundColor #E6EFF7
title machine.handle-exceptions — declared input/output contract
component "machine.handle-exceptions" as operation
rectangle "validated logical program" as in0
in0 --> operation
rectangle "current instruction and operands" as in1
in1 --> operation
rectangle "execution context" as in2
in2 --> operation
rectangle "physical plan and provider observations" as in3
in3 --> operation
rectangle "authority resource and completion state" as in4
in4 --> operation
rectangle "last durable receipt" as in5
in5 --> operation
rectangle "typed machine condition" as out0
operation --> out0
rectangle "priority and precision decision" as out1
operation --> out1
rectangle "restart retry reroute replay compensation or terminal plan" as out2
operation --> out2
rectangle "invalidated-output boundary" as out3
operation --> out3
rectangle "why-not and recovery receipt" as out4
operation --> out4
@enduml
