-- Physicalities are HASH(id); id is the routing key. The old hilbert-keyed
-- overload describes the retired RANGE(hilbert_index) schema and has no live
-- caller. Keep one fixed set operation and do not spawn a second PostgreSQL
-- parallel fan underneath caller-owned batching.
CREATE OR REPLACE FUNCTION laplace.physicalities_present_ordinals(p_ids bytea[])
    RETURNS TABLE(idx int)
    LANGUAGE sql STABLE PARALLEL RESTRICTED
AS $$
    SELECT (u.ord - 1)::int
    FROM unnest(p_ids) WITH ORDINALITY u(id, ord)
    JOIN laplace.physicalities p ON p.id = u.id
$$;

DROP FUNCTION IF EXISTS laplace.physicalities_present_ordinals(bytea[], bytea[]);
