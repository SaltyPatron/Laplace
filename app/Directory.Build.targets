<Project>
  <PropertyGroup>
    <LaplaceRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</LaplaceRepoRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)NativeTestBootstrap.cs" />
  </ItemGroup>

  <Target Name="LaplacePinNativeInteropProperties"
          AfterTargets="IncludeTransitiveProjectReferences"
          Condition="'$(LaplaceNativeGenerated)' != ''">
    <ItemGroup>
      <ProjectReference Update="@(ProjectReference)" Condition="'%(Filename)' == 'Laplace.Native.Interop'">
        <AdditionalProperties>LaplaceNativeGenerated=$(LaplaceNativeGenerated)</AdditionalProperties>
      </ProjectReference>
    </ItemGroup>
  </Target>

  <Target Name="LaplaceResolveNativeRuntimeItems"
          BeforeTargets="AssignTargetPaths;GenerateOpenApiDocuments"
          Condition="'$(MSBuildProjectName)' == 'Laplace.Core'">
    <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
      <_NativeExplicit Include="$(LAPLACE_NATIVE_PACKAGE)\bin\laplace.dll"
                       Condition="'$(LAPLACE_NATIVE_PACKAGE)' != '' And Exists('$(LAPLACE_NATIVE_PACKAGE)\bin\laplace.dll')" />
      <_NativePinned Include="$(LaplacePackagesRoot)\laplace-native\$(_LaplaceNativePin)-*\bin\laplace.dll"
                     Condition="'$(_LaplaceNativePin)' != ''" />
      <_NativeLatest Include="$(LaplacePackagesRoot)\laplace-native\*\bin\laplace.dll" />
      <_NativeLocal Include="$(LAPLACE_BUILD)\Laplace-Native\icx-release\laplace.dll"
                    Condition="Exists('$(LAPLACE_BUILD)\Laplace-Native\icx-release\laplace.dll')" />
      <_NativeCandidate Include="@(_NativeExplicit)" />
      <_NativeCandidate Include="@(_NativePinned)" Condition="'@(_NativeCandidate)' == ''" />
      <_NativeCandidate Include="@(_NativeLatest)" Condition="'@(_NativeCandidate)' == ''" />
      <_NativeCandidate Include="@(_NativeLocal)" Condition="'@(_NativeCandidate)' == ''" />

      <_EngineExplicit Include="$(LAPLACE_ENGINE_PACKAGE)\bin\laplace_engine_abi.dll"
                       Condition="'$(LAPLACE_ENGINE_PACKAGE)' != '' And Exists('$(LAPLACE_ENGINE_PACKAGE)\bin\laplace_engine_abi.dll')" />
      <_EnginePinned Include="$(LaplacePackagesRoot)\laplace-engine\$(_LaplaceEnginePin)-*\bin\laplace_engine_abi.dll"
                     Condition="'$(_LaplaceEnginePin)' != ''" />
      <_EngineLatest Include="$(LaplacePackagesRoot)\laplace-engine\*\bin\laplace_engine_abi.dll" />
      <_EngineLocal Include="$(LAPLACE_ENGINE_BUILD)\laplace_engine_abi.dll"
                    Condition="Exists('$(LAPLACE_ENGINE_BUILD)\laplace_engine_abi.dll')" />
      <_EngineCandidate Include="@(_EngineExplicit)" />
      <_EngineCandidate Include="@(_EnginePinned)" Condition="'@(_EngineCandidate)' == ''" />
      <_EngineCandidate Include="@(_EngineLatest)" Condition="'@(_EngineCandidate)' == ''" />
      <_EngineCandidate Include="@(_EngineLocal)" Condition="'@(_EngineCandidate)' == ''" />
    </ItemGroup>

    <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
      <_ResolvedNativeDll>@(_NativeCandidate->'%(FullPath)')</_ResolvedNativeDll>
      <_LastNativeIdx>$(_ResolvedNativeDll.LastIndexOf(';'))</_LastNativeIdx>
      <_ResolvedNativeDll Condition="'$(_ResolvedNativeDll)' != '' And $(_LastNativeIdx) &gt;= 0">$(_ResolvedNativeDll.Substring($([MSBuild]::Add($(_LastNativeIdx), 1))))</_ResolvedNativeDll>
      <_ResolvedEngineAbiDll>@(_EngineCandidate->'%(FullPath)')</_ResolvedEngineAbiDll>
      <_LastEngineIdx>$(_ResolvedEngineAbiDll.LastIndexOf(';'))</_LastEngineIdx>
      <_ResolvedEngineAbiDll Condition="'$(_ResolvedEngineAbiDll)' != '' And $(_LastEngineIdx) &gt;= 0">$(_ResolvedEngineAbiDll.Substring($([MSBuild]::Add($(_LastEngineIdx), 1))))</_ResolvedEngineAbiDll>
      <_ResolvedNativeBinDir Condition="'$(_ResolvedNativeDll)' != ''">$([System.IO.Path]::GetDirectoryName('$(_ResolvedNativeDll)'))</_ResolvedNativeBinDir>
      <_ResolvedEngineBinDir Condition="'$(_ResolvedEngineAbiDll)' != ''">$([System.IO.Path]::GetDirectoryName('$(_ResolvedEngineAbiDll)'))</_ResolvedEngineBinDir>
      <_ResolvedEnginePackageDir Condition="'$(_ResolvedEngineBinDir)' != ''">$([System.IO.Path]::GetFullPath('$(_ResolvedEngineBinDir)\..'))</_ResolvedEnginePackageDir>
    </PropertyGroup>

    <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
      <LaplaceWindowsRuntimeFile Include="$(_ResolvedNativeDll)" Condition="'$(_ResolvedNativeDll)' != '' And Exists('$(_ResolvedNativeDll)')" />
      <LaplaceWindowsRuntimeFile Include="$(_ResolvedNativeBinDir)\laplace.pdb" Condition="'$(_ResolvedNativeBinDir)' != '' And Exists('$(_ResolvedNativeBinDir)\laplace.pdb')" />
      <LaplaceWindowsRuntimeFile Include="$(_ResolvedEngineAbiDll)" Condition="'$(_ResolvedEngineAbiDll)' != '' And Exists('$(_ResolvedEngineAbiDll)')" />
      <LaplaceWindowsRuntimeFile Include="$(_ResolvedEngineBinDir)\laplace_engine_abi.pdb" Condition="'$(_ResolvedEngineBinDir)' != '' And Exists('$(_ResolvedEngineBinDir)\laplace_engine_abi.pdb')" />
      <LaplaceWindowsRuntimeFile Include="$(_ResolvedEngineBinDir)\laplace.exe" Condition="'$(_ResolvedEngineBinDir)' != '' And Exists('$(_ResolvedEngineBinDir)\laplace.exe')" />
      <LaplaceWindowsRuntimeFile Include="$(_ResolvedEngineBinDir)\laplace.pdb" Condition="'$(_ResolvedEngineBinDir)' != '' And Exists('$(_ResolvedEngineBinDir)\laplace.pdb')" />
      <LaplaceWindowsRuntimeFile Include="$(LAPLACE_PG_DIR)\bin\libpq.dll" Condition="'$(LAPLACE_PG_DIR)' != '' And Exists('$(LAPLACE_PG_DIR)\bin\libpq.dll')" />
      <LaplaceWindowsRuntimeFile Include="$(LAPLACE_PG_DIR)\bin\libcrypto-*.dll" Condition="'$(LAPLACE_PG_DIR)' != '' And Exists('$(LAPLACE_PG_DIR)\bin\libpq.dll')" />
      <LaplaceWindowsRuntimeFile Include="$(LAPLACE_PG_DIR)\bin\libssl-*.dll" Condition="'$(LAPLACE_PG_DIR)' != '' And Exists('$(LAPLACE_PG_DIR)\bin\libpq.dll')" />
    </ItemGroup>

    <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
      <_LinuxEngineSo Include="$(LAPLACE_ENGINE_PACKAGE)\lib\liblaplace_engine_abi.so*" Condition="'$(LAPLACE_ENGINE_PACKAGE)' != ''" />
      <_LinuxEngineSo Include="$(LaplacePackagesRoot)/laplace-engine/$(_LaplaceEnginePin)-*/lib/liblaplace_engine_abi.so*" Condition="'$(LAPLACE_ENGINE_PACKAGE)' == '' And '$(_LaplaceEnginePin)' != ''" />
      <_LinuxEngineBin Include="$(LAPLACE_ENGINE_PACKAGE)/bin/laplace" Condition="'$(LAPLACE_ENGINE_PACKAGE)' != '' And Exists('$(LAPLACE_ENGINE_PACKAGE)/bin/laplace')" />
      <_LinuxEngineBin Include="$(LaplacePackagesRoot)/laplace-engine/$(_LaplaceEnginePin)-*/bin/laplace" Condition="'@(_LinuxEngineBin)' == '' And '$(_LaplaceEnginePin)' != ''" />
      <_LinuxEngineCandidate Include="@(_LinuxEngineSo->'%(FullPath)')" />
      <_LinuxEngineDirProbe Condition="'@(_LinuxEngineSo)' != ''" Include="@(_LinuxEngineSo->'%(RootDir)%(Directory)')" />
    </ItemGroup>

    <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
      <_ResolvedLinuxEngineLibDir>@(_LinuxEngineDirProbe)</_ResolvedLinuxEngineLibDir>
      <_LastLinuxEngineIdx>$(_ResolvedLinuxEngineLibDir.LastIndexOf(';'))</_LastLinuxEngineIdx>
      <_ResolvedLinuxEngineLibDir Condition="'$(_ResolvedLinuxEngineLibDir)' != '' And $(_LastLinuxEngineIdx) &gt;= 0">$(_ResolvedLinuxEngineLibDir.Substring($([MSBuild]::Add($(_LastLinuxEngineIdx), 1))))</_ResolvedLinuxEngineLibDir>
      <_ResolvedEnginePackageDir Condition="'$(LAPLACE_ENGINE_PACKAGE)' != '' And Exists('$(LAPLACE_ENGINE_PACKAGE)/share/laplace/tier0.bin')">$(LAPLACE_ENGINE_PACKAGE)</_ResolvedEnginePackageDir>
      <_ResolvedEnginePackageDir Condition="'$(_ResolvedEnginePackageDir)' == '' And '$(_ResolvedLinuxEngineLibDir)' != ''">$([System.IO.Path]::GetFullPath('$(_ResolvedLinuxEngineLibDir)..'))</_ResolvedEnginePackageDir>
    </PropertyGroup>

    <PropertyGroup>
      <_PerfcacheCandidate Condition="'$(_ResolvedEnginePackageDir)' != '' And Exists('$(_ResolvedEnginePackageDir)/share/laplace/tier0.bin')">$(_ResolvedEnginePackageDir)/share/laplace</_PerfcacheCandidate>
      <_PerfcacheCandidate Condition="'$(_PerfcacheCandidate)' == '' And '$(LAPLACE_WORK)' != '' And Exists('$(LAPLACE_WORK)/tier0/tier0.bin')">$(LAPLACE_WORK)/tier0</_PerfcacheCandidate>
      <_PerfcacheCandidate Condition="'$(_PerfcacheCandidate)' == '' And '$(LAPLACE_DATA_ROOT)' != '' And Exists('$(LAPLACE_DATA_ROOT)/share/laplace/tier0.bin')">$(LAPLACE_DATA_ROOT)/share/laplace</_PerfcacheCandidate>

      <_FirmwareSourceDir Condition="'$(_ResolvedEnginePackageDir)' != '' And Exists('$(_ResolvedEnginePackageDir)/share/laplace/firmware')">$(_ResolvedEnginePackageDir)/share/laplace/firmware</_FirmwareSourceDir>
      <_FirmwareSourceDir Condition="'$(_FirmwareSourceDir)' == '' And '$(_ResolvedEnginePackageDir)' != '' And Exists('$(_ResolvedEnginePackageDir)/share/firmware')">$(_ResolvedEnginePackageDir)/share/firmware</_FirmwareSourceDir>
      <_FirmwareSourceDir Condition="'$(_FirmwareSourceDir)' == '' And Exists('$(LaplaceRepoRoot)/../Laplace-Engine/firmware')">$([System.IO.Path]::GetFullPath('$(LaplaceRepoRoot)/../Laplace-Engine/firmware'))</_FirmwareSourceDir>

      <_ManifestSourceDir Condition="'$(_ResolvedEnginePackageDir)' != '' And Exists('$(_ResolvedEnginePackageDir)/share/laplace/manifest')">$(_ResolvedEnginePackageDir)/share/laplace/manifest</_ManifestSourceDir>
      <_ManifestSourceDir Condition="'$(_ManifestSourceDir)' == '' And '$(_ResolvedEnginePackageDir)' != '' And Exists('$(_ResolvedEnginePackageDir)/share/manifest')">$(_ResolvedEnginePackageDir)/share/manifest</_ManifestSourceDir>
      <_ManifestSourceDir Condition="'$(_ManifestSourceDir)' == '' And Exists('$(LaplaceRepoRoot)/../Laplace-Native/manifest')">$([System.IO.Path]::GetFullPath('$(LaplaceRepoRoot)/../Laplace-Native/manifest'))</_ManifestSourceDir>

      <_RecipesSourceDir Condition="'$(_ResolvedEnginePackageDir)' != '' And Exists('$(_ResolvedEnginePackageDir)/share/laplace/recipes')">$(_ResolvedEnginePackageDir)/share/laplace/recipes</_RecipesSourceDir>
      <_RecipesSourceDir Condition="'$(_RecipesSourceDir)' == '' And '$(_ResolvedEnginePackageDir)' != '' And Exists('$(_ResolvedEnginePackageDir)/share/recipes')">$(_ResolvedEnginePackageDir)/share/recipes</_RecipesSourceDir>
      <_RecipesSourceDir Condition="'$(_RecipesSourceDir)' == '' And Exists('$(LaplaceRepoRoot)/../Laplace-Engine/recipes')">$([System.IO.Path]::GetFullPath('$(LaplaceRepoRoot)/../Laplace-Engine/recipes'))</_RecipesSourceDir>
    </PropertyGroup>

    <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
      <None Include="@(LaplaceWindowsRuntimeFile)"
            Link="%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
      <None Include="$(_ResolvedEngineBinDir)\grammars\*.dll"
            Condition="'$(_ResolvedEngineBinDir)' != '' And Exists('$(_ResolvedEngineBinDir)\grammars')"
            Link="grammars\%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
      <None Include="@(LaplaceNativeArtifact)"
            Link="%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
      <None Include="@(_LinuxEngineBin)"
            Link="%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
      <None Include="$(_ResolvedEnginePackageDir)/lib/grammars/*.so*"
            Condition="'$(_ResolvedEnginePackageDir)' != '' And Exists('$(_ResolvedEnginePackageDir)/lib/grammars')"
            Link="grammars/%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup Condition="'$(_PerfcacheCandidate)' != '' And Exists('$(_PerfcacheCandidate)/tier0.bin')">
      <_LaplacePerfcacheFile Include="$(_PerfcacheCandidate)/tier0.bin" Condition="Exists('$(_PerfcacheCandidate)/tier0.bin')" />
      <_LaplacePerfcacheFile Include="$(_PerfcacheCandidate)/tier0.flags" Condition="Exists('$(_PerfcacheCandidate)/tier0.flags')" />
      <_LaplacePerfcacheFile Include="$(_PerfcacheCandidate)/tier0.flags.layout" Condition="Exists('$(_PerfcacheCandidate)/tier0.flags.layout')" />
      <_LaplacePerfcacheFile Include="$(_PerfcacheCandidate)/highway.bin" Condition="Exists('$(_PerfcacheCandidate)/highway.bin')" />
    </ItemGroup>

    <ItemGroup Condition="'@(_LaplacePerfcacheFile)' != ''">
      <None Include="@(_LaplacePerfcacheFile)"
            Link="share/laplace/%(Filename)%(Extension)"
            CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup Condition="'$(_FirmwareSourceDir)' != '' And Exists('$(_FirmwareSourceDir)')">
      <None Include="$(_FirmwareSourceDir)/*.firmware"
            Link="share/laplace/firmware/%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup Condition="'$(_ManifestSourceDir)' != '' And Exists('$(_ManifestSourceDir)')">
      <None Include="$(_ManifestSourceDir)/**/*"
            Link="share/laplace/manifest/%(RecursiveDir)%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup Condition="'$(_RecipesSourceDir)' != '' And Exists('$(_RecipesSourceDir)')">
      <None Include="$(_RecipesSourceDir)/**/*"
            Link="share/laplace/recipes/%(RecursiveDir)%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="LaplacePublishWindowsRuntime" AfterTargets="Publish"
          Condition="'$(OS)' == 'Windows_NT' AND '$(OutputType)' == 'Exe' AND '$(IsTestProject)' != 'true'">
    <Exec Command="&quot;$(LaplaceRepoRoot)\scripts\win\engine-runtime.cmd&quot; &quot;$(PublishDir)&quot;" />
    <Exec Command="pwsh -NoProfile -File &quot;$(LaplaceRepoRoot)\scripts\win\publish-zstd.ps1&quot; -Destination &quot;$(PublishDir).&quot;" />
  </Target>
</Project>
