-- Compatibility recovery journal for the retired index-cycle loader. Current
-- ingest never inserts here or drops a production index. Keep the table so an
-- upgraded database can restore indexes an older interrupted run left absent;
-- recovery deletes each row only after the index is valid again.
CREATE TABLE IF NOT EXISTS index_cycle_journal (
    index_name  text         PRIMARY KEY,
    table_name  text         NOT NULL,
    index_def   text         NOT NULL,
    dropped_at  timestamptz  NOT NULL DEFAULT now()
);
