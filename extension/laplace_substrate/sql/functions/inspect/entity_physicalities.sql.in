DROP FUNCTION IF EXISTS laplace.entity_physicalities(bytea);
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.entity_physicalities(bytea)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(type smallint, x double precision, y double precision, z double precision, m double precision, radius double precision, n_constituents integer, hilbert_index bytea)'
             OR proargnames IS DISTINCT FROM ARRAY['p_id','type','x','y','z','m','radius','n_constituents','hilbert_index']::text[])) THEN
        DROP FUNCTION ops.entity_physicalities(bytea);
    END IF;
END $upgrade_shape$;
CREATE OR REPLACE FUNCTION ops.entity_physicalities(p_id bytea)
    RETURNS TABLE(type smallint, x double precision, y double precision,
                  z double precision, m double precision,
                  radius double precision, n_constituents integer,
                  hilbert_index bytea)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT p.type, ST_X(p.coord), ST_Y(p.coord), ST_Z(p.coord), ST_M(p.coord),
           p.radius_origin, p.n_constituents, p.hilbert_index
    FROM laplace.physicalities p
    WHERE p.entity_id = p_id
    ORDER BY p.type, p.id;
END;
