-- GENERATED by scripts/codegen-attestation-law.py - do not edit.
-- Claim qualifiers (engine/manifest/qualifiers.toml): family/value -> bit of an
-- attestation's qualifier_mask (32 bytes, bit b = get_bit(mask, b)).
CREATE OR REPLACE FUNCTION laplace.qualifier_bit(p_family text, p_value text)
    RETURNS integer
    LANGUAGE plpgsql IMMUTABLE STRICT PARALLEL SAFE AS $q$
DECLARE
    v_bit integer := CASE p_family || '/' || p_value
        WHEN 'identifier/iso639-1' THEN 0
        WHEN 'identifier/iso639-2b' THEN 1
        WHEN 'identifier/iso639-2t' THEN 2
        WHEN 'identifier/iso639-3' THEN 3
        WHEN 'identifier/bcp47' THEN 4
        WHEN 'identifier/ili' THEN 5
        WHEN 'identifier/pwn30-offset' THEN 6
        WHEN 'identifier/pwn31-offset' THEN 7
        WHEN 'identifier/wordnet-sense-key' THEN 8
        WHEN 'identifier/wordnet-synset-key' THEN 9
        WHEN 'identifier/pwn15-offset' THEN 10
        WHEN 'identifier/pwn16-offset' THEN 11
        WHEN 'identifier/pwn17-offset' THEN 12
        WHEN 'identifier/pwn171-offset' THEN 13
        WHEN 'identifier/pwn20-offset' THEN 14
        WHEN 'identifier/pwn21-offset' THEN 15
        WHEN 'identifier/odwn13-synset' THEN 16
        WHEN 'name/primary' THEN 32
        WHEN 'name/alias' THEN 33
        WHEN 'name/reference' THEN 34
        WHEN 'name/print' THEN 35
        WHEN 'name/inverted' THEN 36
        WHEN 'name/abbreviation' THEN 37
        WHEN 'name/correction' THEN 38
        WHEN 'name/control' THEN 39
        WHEN 'name/alternate' THEN 40
        WHEN 'name/figment' THEN 41
        WHEN 'name/unicode-1' THEN 42
        WHEN 'mapping/lower' THEN 64
        WHEN 'mapping/upper' THEN 65
        WHEN 'mapping/title' THEN 66
        WHEN 'mapping/fold' THEN 67
        WHEN 'mapping/simple' THEN 68
        WHEN 'mapping/full' THEN 69
        WHEN 'mapping/nfkc' THEN 70
        WHEN 'mapping/nfc' THEN 71
        WHEN 'mapping/nfd' THEN 72
        WHEN 'mapping/nfkd' THEN 73
        WHEN 'decomposition/Canonical' THEN 96
        WHEN 'decomposition/Compat' THEN 97
        WHEN 'decomposition/Circle' THEN 98
        WHEN 'decomposition/Final' THEN 99
        WHEN 'decomposition/Font' THEN 100
        WHEN 'decomposition/Fraction' THEN 101
        WHEN 'decomposition/Initial' THEN 102
        WHEN 'decomposition/Isolated' THEN 103
        WHEN 'decomposition/Medial' THEN 104
        WHEN 'decomposition/Narrow' THEN 105
        WHEN 'decomposition/Nobreak' THEN 106
        WHEN 'decomposition/Small' THEN 107
        WHEN 'decomposition/Square' THEN 108
        WHEN 'decomposition/Sub' THEN 109
        WHEN 'decomposition/Super' THEN 110
        WHEN 'decomposition/Vertical' THEN 111
        WHEN 'decomposition/Wide' THEN 112
        WHEN 'decomposition/sort' THEN 113
        WHEN 'decomposition/circlekata' THEN 114
        WHEN 'decomposition/smallnarrow' THEN 115
        WHEN 'retirement/change' THEN 128
        WHEN 'retirement/duplicate' THEN 129
        WHEN 'retirement/non-existent' THEN 130
        WHEN 'retirement/split' THEN 131
        WHEN 'retirement/merge' THEN 132
        WHEN 'membership/active' THEN 160
        WHEN 'membership/retired' THEN 161
        WHEN 'derivation/calculation' THEN 192
        WHEN 'meronymy/part' THEN 0
        WHEN 'meronymy/member' THEN 1
        WHEN 'meronymy/substance' THEN 2
        WHEN 'etymology/borrowed' THEN 0
        WHEN 'etymology/inherited' THEN 1
        WHEN 'etymology/affix' THEN 2
        WHEN 'etymology/prefix' THEN 3
        WHEN 'etymology/suffix' THEN 4
        WHEN 'etymology/compound' THEN 5
        WHEN 'etymology/blend' THEN 6
        WHEN 'etymology/back-formation' THEN 7
        WHEN 'subevent/first' THEN 0
        WHEN 'subevent/last' THEN 1
        WHEN 'character_property/default' THEN 0
        WHEN 'domain/topic' THEN 0
        WHEN 'domain/region' THEN 1
        WHEN 'domain/usage' THEN 2
        WHEN 'participant/agent' THEN 0
        WHEN 'participant/others' THEN 1
        WHEN 'variant/semantic' THEN 0
        WHEN 'variant/compatibility' THEN 1
        WHEN 'variant/simplified' THEN 2
        WHEN 'variant/traditional' THEN 3
        WHEN 'variant/specialized-semantic' THEN 4
        WHEN 'variant/spoofing' THEN 5
        WHEN 'variant/z' THEN 6
        WHEN 'side/white' THEN 0
        WHEN 'side/black' THEN 1
    END;
BEGIN
    IF v_bit IS NULL THEN
        RAISE EXCEPTION 'undeclared claim qualifier %/%', p_family, p_value
            USING HINT = 'engine/manifest/qualifiers.toml';
    END IF;
    RETURN v_bit;
END
$q$;

-- Whether a claim states that qualifier; a NULL mask states none.
CREATE OR REPLACE FUNCTION laplace.has_qualifier(p_mask bytea, p_family text, p_value text)
    RETURNS boolean
    LANGUAGE sql IMMUTABLE PARALLEL SAFE AS $q$
    SELECT p_mask IS NOT NULL
       AND get_bit(p_mask, laplace.qualifier_bit(p_family, p_value)) = 1
$q$;

-- The type ids whose rows state an element in its own direction: the element and every
-- relation retired into it unflipped. IMMUTABLE over literals, so it folds and prunes.
CREATE OR REPLACE FUNCTION laplace.element_type_ids(p_element text)
    RETURNS bytea[]
    LANGUAGE sql IMMUTABLE PARALLEL SAFE AS $q$
    SELECT CASE p_element
        WHEN 'CAPABLE_OF' THEN ARRAY[laplace.relation_type_id('CAPABLE_OF'), laplace.relation_type_id('NOT_CAPABLE_OF')]
        WHEN 'DECOMPOSES_TO' THEN ARRAY[laplace.relation_type_id('DECOMPOSES_TO'), laplace.relation_type_id('CANONICAL_DECOMPOSES_TO'), laplace.relation_type_id('COMPATIBILITY_DECOMPOSES_TO')]
        WHEN 'DESIRES' THEN ARRAY[laplace.relation_type_id('DESIRES'), laplace.relation_type_id('NOT_DESIRES')]
        WHEN 'ETYMOLOGICALLY_DERIVED_FROM' THEN ARRAY[laplace.relation_type_id('ETYMOLOGICALLY_DERIVED_FROM'), laplace.relation_type_id('BORROWED_FROM'), laplace.relation_type_id('INHERITED_FROM')]
        WHEN 'HAS_ATTRIBUTE' THEN ARRAY[laplace.relation_type_id('HAS_ATTRIBUTE'), laplace.relation_type_id('HAS_CACHE_CREATE_TOKENS'), laplace.relation_type_id('HAS_CACHE_READ_TOKENS'), laplace.relation_type_id('HAS_COST'), laplace.relation_type_id('HAS_HIDDEN_SIZE'), laplace.relation_type_id('HAS_INPUT_TOKENS'), laplace.relation_type_id('HAS_INTERMEDIATE_SIZE'), laplace.relation_type_id('HAS_NUM_HEADS'), laplace.relation_type_id('HAS_NUM_KV_HEADS'), laplace.relation_type_id('HAS_NUM_LAYERS'), laplace.relation_type_id('HAS_OUTPUT_TOKENS'), laplace.relation_type_id('HAS_STOP_REASON'), laplace.relation_type_id('HAS_VOCAB_SIZE')]
        WHEN 'HAS_CASE_MAPPING' THEN ARRAY[laplace.relation_type_id('HAS_CASE_MAPPING'), laplace.relation_type_id('HAS_LOWERCASE_MAPPING'), laplace.relation_type_id('HAS_TITLECASE_MAPPING'), laplace.relation_type_id('HAS_UPPERCASE_MAPPING')]
        WHEN 'HAS_CHARACTER_PROPERTY' THEN ARRAY[laplace.relation_type_id('HAS_CHARACTER_PROPERTY'), laplace.relation_type_id('HAS_AGE'), laplace.relation_type_id('HAS_BIDI_CLASS'), laplace.relation_type_id('HAS_BLOCK'), laplace.relation_type_id('HAS_COMBINING_CLASS'), laplace.relation_type_id('HAS_EAST_ASIAN_WIDTH'), laplace.relation_type_id('HAS_EMOJI_PROPERTY'), laplace.relation_type_id('HAS_GENERAL_CATEGORY'), laplace.relation_type_id('HAS_JOINING_TYPE'), laplace.relation_type_id('HAS_LINE_BREAK'), laplace.relation_type_id('HAS_NUMERIC_TYPE'), laplace.relation_type_id('HAS_NUMERIC_VALUE'), laplace.relation_type_id('USES_SCRIPT_EXTENSION')]
        WHEN 'HAS_DOMAIN' THEN ARRAY[laplace.relation_type_id('HAS_DOMAIN'), laplace.relation_type_id('HAS_DOMAIN_REGION'), laplace.relation_type_id('HAS_DOMAIN_TOPIC'), laplace.relation_type_id('HAS_DOMAIN_USAGE')]
        WHEN 'HAS_EXTERNAL_ID' THEN ARRAY[laplace.relation_type_id('HAS_EXTERNAL_ID'), laplace.relation_type_id('HAS_ISO639_1_CODE'), laplace.relation_type_id('HAS_ISO639_2B_CODE'), laplace.relation_type_id('HAS_ISO639_2T_CODE'), laplace.relation_type_id('HAS_ISO639_2_CODE')]
        WHEN 'HAS_NAME' THEN ARRAY[laplace.relation_type_id('HAS_NAME'), laplace.relation_type_id('HAS_NAME_ALIAS')]
        WHEN 'HAS_PART' THEN ARRAY[laplace.relation_type_id('HAS_PART'), laplace.relation_type_id('HAS_A'), laplace.relation_type_id('HAS_MEMBER'), laplace.relation_type_id('HAS_SUBSTANCE'), laplace.relation_type_id('MADE_UP_OF')]
        WHEN 'HAS_PLAYER' THEN ARRAY[laplace.relation_type_id('HAS_PLAYER'), laplace.relation_type_id('HAS_BLACK'), laplace.relation_type_id('HAS_WHITE')]
        WHEN 'HAS_PROPERTY' THEN ARRAY[laplace.relation_type_id('HAS_PROPERTY'), laplace.relation_type_id('NOT_HAS_PROPERTY')]
        WHEN 'HAS_SCRIPT' THEN ARRAY[laplace.relation_type_id('HAS_SCRIPT'), laplace.relation_type_id('USES_SCRIPT')]
        WHEN 'HAS_SUBEVENT' THEN ARRAY[laplace.relation_type_id('HAS_SUBEVENT'), laplace.relation_type_id('HAS_FIRST_SUBEVENT'), laplace.relation_type_id('HAS_LAST_SUBEVENT')]
        WHEN 'USED_FOR' THEN ARRAY[laplace.relation_type_id('USED_FOR'), laplace.relation_type_id('NOT_USED_FOR')]
        WHEN 'X_EFFECT' THEN ARRAY[laplace.relation_type_id('X_EFFECT'), laplace.relation_type_id('O_EFFECT')]
        WHEN 'X_REACT' THEN ARRAY[laplace.relation_type_id('X_REACT'), laplace.relation_type_id('O_REACT')]
        WHEN 'X_WANT' THEN ARRAY[laplace.relation_type_id('X_WANT'), laplace.relation_type_id('O_WANT')]
        ELSE ARRAY[laplace.relation_type_id(p_element)]
    END
$q$;

-- The type ids of relations retired into an element with retired_flip: their admitted
-- rows state the element with subject and object exchanged.
CREATE OR REPLACE FUNCTION laplace.element_flipped_type_ids(p_element text)
    RETURNS bytea[]
    LANGUAGE sql IMMUTABLE PARALLEL SAFE AS $q$
    SELECT CASE p_element
        WHEN 'HAS_PART' THEN ARRAY[laplace.relation_type_id('MEMBER_OF_MACROLANGUAGE'), laplace.relation_type_id('MEMBER_OF_VERBNET_CLASS')]
        WHEN 'IS_BEFORE' THEN ARRAY[laplace.relation_type_id('IS_AFTER')]
        ELSE ARRAY[]::bytea[]
    END
$q$;

-- Whether a claim states a qualifier: its mask carries the bit, or its type is a relation
-- retired with that qualifier (an admitted HAS_MEMBER row states HAS_PART {meronymy/member}).
CREATE OR REPLACE FUNCTION laplace.claim_has_qualifier(
        p_type bytea, p_mask bytea, p_family text, p_value text)
    RETURNS boolean
    LANGUAGE sql IMMUTABLE PARALLEL SAFE AS $q$
    SELECT laplace.has_qualifier(p_mask, p_family, p_value)
        OR p_type = ANY (CASE p_family || '/' || p_value
        WHEN 'domain/region' THEN ARRAY[laplace.relation_type_id('HAS_DOMAIN_REGION')]
        WHEN 'domain/topic' THEN ARRAY[laplace.relation_type_id('HAS_DOMAIN_TOPIC')]
        WHEN 'domain/usage' THEN ARRAY[laplace.relation_type_id('HAS_DOMAIN_USAGE')]
        WHEN 'etymology/borrowed' THEN ARRAY[laplace.relation_type_id('BORROWED_FROM')]
        WHEN 'etymology/inherited' THEN ARRAY[laplace.relation_type_id('INHERITED_FROM')]
        WHEN 'meronymy/member' THEN ARRAY[laplace.relation_type_id('HAS_MEMBER'), laplace.relation_type_id('MEMBER_OF_MACROLANGUAGE'), laplace.relation_type_id('MEMBER_OF_VERBNET_CLASS')]
        WHEN 'meronymy/part' THEN ARRAY[laplace.relation_type_id('HAS_A')]
        WHEN 'meronymy/substance' THEN ARRAY[laplace.relation_type_id('HAS_SUBSTANCE'), laplace.relation_type_id('MADE_UP_OF')]
        WHEN 'participant/others' THEN ARRAY[laplace.relation_type_id('O_EFFECT'), laplace.relation_type_id('O_REACT'), laplace.relation_type_id('O_WANT')]
        WHEN 'side/black' THEN ARRAY[laplace.relation_type_id('HAS_BLACK')]
        WHEN 'side/white' THEN ARRAY[laplace.relation_type_id('HAS_WHITE')]
        WHEN 'subevent/first' THEN ARRAY[laplace.relation_type_id('HAS_FIRST_SUBEVENT')]
        WHEN 'subevent/last' THEN ARRAY[laplace.relation_type_id('HAS_LAST_SUBEVENT')]
            ELSE ARRAY[]::bytea[]
        END)
$q$;
