CREATE OR REPLACE FUNCTION converse.language_coverage(p_word bytea, p_limit int DEFAULT 40)
    RETURNS TABLE(reply text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH member_langs AS MATERIALIZED (
        SELECT DISTINCT sm.lang
        FROM lexical.synset_members(p_word) sm
        WHERE sm.lang IS NOT NULL
    ),
    lang_ids AS MATERIALIZED (
        SELECT array_agg(DISTINCT u.lang ORDER BY u.lang) AS ids
        FROM (
            SELECT ml.lang FROM member_langs ml
            UNION
            SELECT converse.word_language(p_word) AS lang
            WHERE NOT EXISTS (SELECT 1 FROM member_langs)
        ) u
        WHERE u.lang IS NOT NULL
    ),
    langs AS MATERIALIZED (
        SELECT DISTINCT code
        FROM lang_ids li,
             LATERAL unnest(ARRAY(SELECT lp_l.content FROM unnest((li.ids)::bytea[]) WITH ORDINALITY lp_u(x,n) LEFT JOIN (SELECT DISTINCT ON (lp_d.entity) lp_d.entity,lp_d.content FROM public.laplace_labels(array_remove((li.ids)::bytea[],NULL)::public.blake3[]) lp_d) lp_l ON lp_l.entity=lp_u.x::public.blake3 ORDER BY lp_u.n)) AS code
        WHERE code IS NOT NULL
    ),
    cnt AS MATERIALIZED (
        SELECT count(*)::bigint AS total FROM langs
    ),
    shown AS (
        SELECT code FROM langs ORDER BY code LIMIT p_limit
    )
    SELECT COALESCE((SELECT lp_l.content FROM public.laplace_labels(array_remove(ARRAY[(p_word)::bytea],NULL)::public.blake3[]) lp_l), '?') || ' is witnessed across '
           || c.total::text || ' languages: '
           || (SELECT string_agg(code, ', ' ORDER BY code) FROM shown)
           || CASE WHEN c.total > p_limit THEN ', …' ELSE '' END,
           NULL::numeric,
           c.total
    FROM cnt c
    WHERE c.total > 0;
END;
