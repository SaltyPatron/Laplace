-- Unicode separator/control identities come from the canonical Native floor.
-- The same owner includes the UAX #29 CRLF grapheme; no corpus scan is needed.
DROP FUNCTION IF EXISTS laplace.separator_ids();
CREATE OR REPLACE FUNCTION generation.separator_ids() RETURNS bytea[]
    LANGUAGE sql IMMUTABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT ARRAY(SELECT @extschema:laplace@.blake3_send(id) FROM unnest(@extschema:laplace@.laplace_separator_ids()) id);
END;
