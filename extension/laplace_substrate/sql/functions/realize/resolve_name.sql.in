-- Empty-context names delegate to the native batch owner. The context branch
-- retains the existing domain-boost / first-renderable compatibility policy;
-- it is not an identity-space semantic election.
DROP FUNCTION IF EXISTS laplace.resolve_name(bytea, bytea, bytea[]);
CREATE OR REPLACE FUNCTION realize.resolve_name(
    p_id bytea,
    p_lang bytea DEFAULT NULL,
    p_context bytea[] DEFAULT NULL)
    RETURNS text
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT CASE
        WHEN p_context IS NULL OR cardinality(p_context) = 0 THEN
            (realize.resolve_name_batch(ARRAY[p_id], p_lang))[1]
        ELSE (
            WITH ctx AS (
                SELECT id, sum(boost) AS boost FROM (
                    SELECT c.object_id AS id, sum(consensus.eff_mu(c.rating, c.rd)) AS boost
                    FROM laplace.v_consensus_unrefuted c
                    WHERE c.subject_id = ANY (p_context)
                    GROUP BY c.object_id
                    UNION ALL
                    SELECT c.subject_id AS id, sum(consensus.eff_mu(c.rating, c.rd)) AS boost
                    FROM laplace.v_consensus_unrefuted c
                    WHERE c.object_id = ANY (p_context)
                    GROUP BY c.subject_id
                ) t GROUP BY id
            ),
            cand AS MATERIALIZED (
                SELECT nm.object_id AS name_id,
                       nm.type_id = ANY (consensus.relation_family_ids('HAS_NAME')) AS prim,
                       (lang.object_id IS NOT NULL) AS lp,
                       consensus.eff_mu(nm.rating, nm.rd) AS mu
                FROM laplace.v_consensus_unrefuted nm
                LEFT JOIN laplace.consensus lang ON lang.subject_id = nm.object_id
                     AND lang.type_id = laplace.relation_type_id('HAS_LANGUAGE')
                     AND lang.object_id = p_lang
                WHERE nm.subject_id = p_id
                  AND nm.type_id = ANY (consensus.relation_family_ids('HAS_NAME'))
                UNION ALL
                SELECT hs.subject_id AS name_id,
                       false AS prim,
                       EXISTS (SELECT 1 FROM laplace.attestations a
                               WHERE a.subject_id = hs.subject_id AND a.type_id = hs.type_id
                                 AND a.object_id = hs.object_id AND a.context_id = p_lang) AS lp,
                       consensus.eff_mu(hs.rating, hs.rd) AS mu
                FROM laplace.v_consensus_unrefuted hs
                WHERE hs.object_id = p_id
                  AND hs.type_id = ANY (consensus.relation_set_ids('KEY_BINDING'))
                UNION ALL
                SELECT hs.subject_id AS name_id,
                       false AS prim,
                       EXISTS (SELECT 1 FROM laplace.attestations a
                               WHERE a.subject_id = hs.subject_id AND a.type_id = hs.type_id
                                 AND a.object_id = hs.object_id AND a.context_id = p_lang) AS lp,
                       consensus.eff_mu(hs.rating, hs.rd) AS mu
                FROM laplace.v_consensus_unrefuted ss
                JOIN laplace.v_consensus_unrefuted hs
                  ON hs.object_id = ss.subject_id
                 AND hs.type_id = ANY (consensus.relation_set_ids('KEY_BINDING'))
                WHERE ss.object_id = p_id
                  AND ss.type_id = laplace.relation_type_id('IS_SENSE_OF')
            ),
            ranked AS MATERIALIZED (
                SELECT c.name_id,
                       row_number() OVER (
                           ORDER BY c.lp DESC,
                                    (ctx.boost IS NOT NULL) DESC,
                                    c.prim DESC,
                                    COALESCE(ctx.boost, 0) DESC,
                                    c.mu DESC,
                                    c.name_id) AS rn
                FROM cand c
                LEFT JOIN ctx ON ctx.id = c.name_id
            ),
            lbl AS MATERIALIZED (
                SELECT realize.render_text_batch(array_agg(r.name_id ORDER BY r.rn)) AS s
                FROM ranked r
            )
            SELECT l.s[r.rn]
            FROM ranked r CROSS JOIN lbl l
            WHERE l.s[r.rn] IS NOT NULL AND l.s[r.rn] <> ''
            ORDER BY r.rn
            LIMIT 1
        )
    END;
END;
