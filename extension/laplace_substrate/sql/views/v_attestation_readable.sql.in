-- Attestations with their five endpoint ids realized through label_or_hex,
-- the one id-display rule. Each row pays five realizations: read it only under
-- a selective predicate and LIMIT, never as the base of a fold, ingest, or
-- unbounded join.
CREATE OR REPLACE VIEW laplace.v_attestation_readable AS
SELECT a.id,
       a.subject_id,
       a.type_id,
       a.object_id,
       a.source_id,
       a.context_id,
       a.outcome,
       a.observation_count,
       a.sum_score_fp1e9,
       a.opponent_rd_fp1e9,
       a.last_observed_at,
       converse.label_or_hex(a.subject_id) AS subject_label,
       converse.label_or_hex(a.type_id)    AS type_label,
       converse.label_or_hex(a.object_id)  AS object_label,
       converse.label_or_hex(a.source_id)  AS source_label,
       converse.label_or_hex(a.context_id) AS context_label
FROM laplace.attestations a;
