-- The finite atom count of the admitted Tier-0 window in the loaded perfcache
-- (LAPLACE_PERFCACHE_RECORD_COUNT from its format header). A window, not the
-- capacity of Tier-0, whose address law is open. Never copied as a SQL literal.
-- No DROP: atom_census() depends on it through its BEGIN ATOMIC body.
CREATE OR REPLACE FUNCTION laplace.atom_window()
    RETURNS bigint
    LANGUAGE C
    IMMUTABLE
    PARALLEL SAFE
    AS 'MODULE_PATHNAME', 'pg_laplace_atom_window';
