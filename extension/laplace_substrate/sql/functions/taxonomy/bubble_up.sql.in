-- Scalar adapter over the one set implementation. Selection, language scoping,
-- domain geometry, ranking, ordering, and explicit truncation all belong to
-- bubble_up_batch; duplicating that CTE cascade here made two definitions of one
-- operation and paid the scalar partition fanout again.
DROP FUNCTION IF EXISTS laplace.bubble_up(bytea, bytea[], integer);
CREATE OR REPLACE FUNCTION taxonomy.bubble_up(
    p_term bytea,
    p_domain_context bytea[] DEFAULT NULL,
    p_k integer DEFAULT NULL
)
RETURNS TABLE(
    sense_id bytea,
    synset_id bytea,
    via_relation text,
    score numeric,
    base_eff_mu numeric,
    domain_hits bigint,
    witnesses bigint
)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT b.sense_id, b.synset_id, b.via_relation, b.score, b.base_eff_mu,
           b.domain_hits, b.witnesses
    FROM taxonomy.bubble_up_batch(
        ARRAY[p_term], p_domain_context, p_k)
        WITH ORDINALITY AS b(
            term, sense_id, synset_id, via_relation, score, base_eff_mu,
            domain_hits, witnesses, ord)
    WHERE b.term = p_term
    ORDER BY b.ord;
END;
