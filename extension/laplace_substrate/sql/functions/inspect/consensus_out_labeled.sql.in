CREATE OR REPLACE FUNCTION ops.consensus_out_labeled(p_id bytea, p_limit integer DEFAULT 40)
    RETURNS TABLE(
        type_id bytea,
        object_id bytea,
        type_label text,
        object_label text,
        eff_mu numeric,
        witnesses bigint)
    LANGUAGE plpgsql STABLE PARALLEL SAFE
AS $$
BEGIN
    -- This is an entity inspection primitive, not a lexical expansion. The caller
    -- already has the exact content/governed id; sense/synset navigation is exposed
    -- separately through lexical.senses. Flattening those subjects here erased the
    -- subject identity and manufactured duplicate-looking consensus rows.
    RETURN QUERY
    WITH native AS MATERIALIZED (
        SELECT f.claim, public.blake3_send(f.predicate) AS type_id,
               public.blake3_send(f.object) AS object_id, f.type, f.fact, f.eff_mu
        FROM ops.claim_facts(p_id, p_limit) f
    ), native_provenance AS MATERIALIZED (
        SELECT a.claim, count(*) AS witnesses
        FROM public.laplace_attested(ARRAY(SELECT claim FROM native), false) a
        WHERE a.witness
        GROUP BY a.claim
    )
    SELECT n.type_id, n.object_id, n.type, n.fact, n.eff_mu, coalesce(p.witnesses, 0)::bigint
    FROM native n
    LEFT JOIN native_provenance p USING (claim)
    ORDER BY n.eff_mu DESC, n.type_id, n.object_id;

    IF FOUND THEN
        RETURN;
    END IF;

    RETURN QUERY
    WITH ranked AS MATERIALIZED (
        SELECT c.type_id, c.object_id, c.eff_mu, c.witness_count,
               COALESCE(consensus.edge_rank(c.type_id, c.eff_mu_raw), 0.0) AS rnk
        FROM laplace.v_consensus_resolved c
        WHERE c.subject_id = p_id
          AND c.object_id IS NOT NULL
        ORDER BY COALESCE(consensus.edge_rank(c.type_id, c.eff_mu_raw), 0.0) DESC, c.type_id, c.object_id
        LIMIT GREATEST(p_limit, 0)
    ), ordered AS (
        SELECT r.*, row_number() OVER (ORDER BY r.rnk DESC, r.type_id, r.object_id) AS ord
        FROM ranked r
    ), ids AS (
        SELECT o.type_id AS id FROM ordered o
        UNION
        SELECT o.object_id FROM ordered o
    ), labels AS MATERIALIZED (
        SELECT d.id, d.label
        FROM realize.display_label_batch(ARRAY(SELECT id FROM ids ORDER BY id)) d
    )
    SELECT o.type_id, o.object_id,
           t.label, v.label,
           o.eff_mu,
           o.witness_count
    FROM ordered o
    JOIN labels t ON t.id = o.type_id
    JOIN labels v ON v.id = o.object_id
    ORDER BY o.eff_mu DESC, o.type_id, o.object_id;
END;
$$;
