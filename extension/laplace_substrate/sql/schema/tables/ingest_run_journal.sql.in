    ('WordFrameNetDecomposer', 12195.0,   73170,   6000, now()),
    ('WordNetDecomposer',      26620.8, 3540569, 133000, now())
ON CONFLICT (source_name) DO NOTHING;

-- Fires on the run's terminal transition, the one boundary every ingest entry
-- point crosses, and derives the throughput sample and its verdict against the
-- accepted baseline (slow above 1.5x slowdown).
CREATE OR REPLACE FUNCTION ops.ingest_throughput_apply()
RETURNS trigger
LANGUAGE plpgsql
AS $$
DECLARE
    v_rows bigint;
    v_elapsed_ms bigint;
    v_rate double precision;
    v_baseline double precision;
    v_slowdown double precision;
BEGIN
    -- Only a clean completed run is a sample; every other status keeps
    -- not-measured.
    IF NEW.status <> 'ok' OR NEW.ended_at IS NULL THEN
        RETURN NEW;
    END IF;

    v_rows := NEW.entities + NEW.physicalities + NEW.attestations;
    -- Elapsed is the runner's wall clock when it supplied one, else the
    -- journal's started_at..ended_at window.
    v_elapsed_ms := COALESCE(
        NULLIF(NEW.throughput_elapsed_ms, 0),
        round(extract(epoch FROM (NEW.ended_at - NEW.started_at)) * 1000.0)::bigint);
    NEW.throughput_rows := v_rows;
    NEW.throughput_elapsed_ms := v_elapsed_ms;

    IF v_rows <= 0 OR v_elapsed_ms <= 0 THEN
        NEW.throughput_status := 'unmeasured';
        NEW.throughput_compared := false;
        RETURN NEW;
    END IF;

    v_rate := (v_rows::double precision * 1000.0) / v_elapsed_ms::double precision;
    NEW.throughput_rows_per_s := v_rate;

    SELECT b.baseline_rows_per_s
      INTO v_baseline
      FROM @extschema@.ingest_throughput_baseline b
     WHERE b.source_name = NEW.source_name;

    IF NOT FOUND THEN
        -- No accepted baseline: record the rate, compare nothing. A run never
        -- accepts itself as the standard.
        NEW.throughput_baseline_rows_per_s := NULL;
        NEW.throughput_slowdown_ratio := NULL;
        NEW.throughput_compared := false;
        NEW.throughput_status := 'unbaselined';
        RETURN NEW;
    END IF;

    v_slowdown := v_baseline / v_rate;
    NEW.throughput_baseline_rows_per_s := v_baseline;
    NEW.throughput_slowdown_ratio := v_slowdown;
    NEW.throughput_compared := true;
    NEW.throughput_status := CASE WHEN v_slowdown > 1.5 THEN 'slow' ELSE 'ok' END;

    UPDATE @extschema@.ingest_throughput_baseline
       SET last_rows_per_s = v_rate,
           last_run_id = NEW.run_id,
           last_slowdown_ratio = v_slowdown,
           last_status = NEW.throughput_status,
           last_observed_at = now()
     WHERE source_name = NEW.source_name;

    RETURN NEW;
END
$$;

DROP TRIGGER IF EXISTS ingest_run_throughput_apply ON ingest_run_journal;
CREATE TRIGGER ingest_run_throughput_apply
BEFORE UPDATE OF status, ended_at, entities, physicalities, attestations
ON ingest_run_journal
FOR EACH ROW
WHEN (OLD.status = 'running' AND NEW.status <> 'running')
EXECUTE FUNCTION ops.ingest_throughput_apply();

-- Accepts the source's latest measured clean run as its baseline. Explicit
-- operator action; no run or read path calls it.
DROP FUNCTION IF EXISTS ops.ingest_throughput_accept(text);
CREATE OR REPLACE FUNCTION ops.ingest_throughput_accept(p_source text)
RETURNS TABLE(source_name text, baseline_rows_per_s double precision, accepted_run_id uuid)
LANGUAGE plpgsql VOLATILE
AS $$
DECLARE
    r @extschema@.ingest_run_journal%ROWTYPE;
BEGIN
    SELECT j.* INTO r
      FROM @extschema@.ingest_run_journal j
     WHERE j.source_name = p_source
       AND j.status = 'ok'
       AND j.throughput_rows_per_s > 0
       AND j.throughput_rows > 0
       AND j.throughput_elapsed_ms > 0
     ORDER BY j.started_at DESC
     LIMIT 1;

    IF r.run_id IS NULL THEN
        RAISE EXCEPTION 'ingest_throughput_accept: no measured clean run for source %', p_source;
    END IF;

    INSERT INTO @extschema@.ingest_throughput_baseline AS b
        (source_name, baseline_rows_per_s, baseline_rows, baseline_elapsed_ms,
         accepted_run_id, established_at, last_rows_per_s, last_run_id,
         last_slowdown_ratio, last_status, last_observed_at)
    VALUES
        (p_source, r.throughput_rows_per_s, r.throughput_rows, r.throughput_elapsed_ms,
         r.run_id, now(), r.throughput_rows_per_s, r.run_id, 1.0, 'accepted', now())
    ON CONFLICT ON CONSTRAINT ingest_throughput_baseline_pkey DO UPDATE SET
        baseline_rows_per_s = EXCLUDED.baseline_rows_per_s,
        baseline_rows = EXCLUDED.baseline_rows,
        baseline_elapsed_ms = EXCLUDED.baseline_elapsed_ms,
        accepted_run_id = EXCLUDED.accepted_run_id,
        established_at = EXCLUDED.established_at,
        last_rows_per_s = EXCLUDED.last_rows_per_s,
        last_run_id = EXCLUDED.last_run_id,
        last_slowdown_ratio = 1.0,
        last_status = 'accepted',
        last_observed_at = EXCLUDED.last_observed_at;

    RETURN QUERY
    SELECT b.source_name, b.baseline_rows_per_s, b.accepted_run_id
      FROM @extschema@.ingest_throughput_baseline b
     WHERE b.source_name = p_source;
END
$$;

-- CREATE TABLE is IF NOT EXISTS, so the status CHECK is re-asserted on every
-- install; otherwise an installed table enforces the list it was created with.
DO $$
BEGIN
    ALTER TABLE ingest_run_journal DROP CONSTRAINT IF EXISTS ingest_run_journal_status_check;
    ALTER TABLE ingest_run_journal ADD CONSTRAINT ingest_run_journal_status_check
        CHECK (status IN ('running','ok','failed','empty-noop','capped',
                          'cancelled','skipped-complete',
                          'already-present','already-complete','dependency-unset'));
END $$;
