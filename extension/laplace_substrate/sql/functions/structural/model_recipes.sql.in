DROP FUNCTION IF EXISTS laplace.model_recipes();
CREATE OR REPLACE FUNCTION structural.model_recipes()
    RETURNS TABLE(recipe_id bytea, recipe_json text, first_observed_by bytea)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT e.id, cn.name,
           (array_agg(i.first_observed_by ORDER BY i.first_observed_by)
              FILTER (WHERE i.first_observed_by IS NOT NULL))[1]
    FROM laplace.entities e
    JOIN laplace.canonical_names cn ON cn.id = e.id
    JOIN laplace.entity_interpretations i ON i.entity_id = e.id
    WHERE i.type_id = realize.canonical_id('Model_Recipe')
    GROUP BY e.id, cn.name;
END;
