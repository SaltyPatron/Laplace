CREATE OR REPLACE FUNCTION corpus_word_vocab(p_size int, p_trajs int DEFAULT 400000)
    RETURNS TABLE(surface text, weight bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
    AS $$
    WITH t AS (
        SELECT DISTINCT ON (w.id) w.id AS entity_id, w.trajectory
        FROM @extschema@.v_word_points w
        WHERE w.type_id IN (@extschema@.canonical_id('Sentence'), @extschema@.canonical_id('Document'))
          AND w.trajectory IS NOT NULL
        ORDER BY w.id, w.physicality_id LIMIT p_trajs
    ),
    w AS (
        SELECT tc.entity_id AS id, count(*) AS c
        FROM t CROSS JOIN LATERAL public.laplace_trajectory_constituents(t.trajectory) tc
        JOIN @extschema@.entities e ON e.id = tc.entity_id AND e.type_id = @extschema@.canonical_id('Word')
        GROUP BY tc.entity_id
    ),
    
    
    
    cand AS (SELECT id, c, @extschema@.render_text(id, 80) AS s FROM w ORDER BY c DESC LIMIT p_size * 4)
    SELECT s, c FROM cand
    WHERE s ~ '^[A-Za-z][A-Za-z''.-]*$'
    ORDER BY c DESC LIMIT p_size
$$;
