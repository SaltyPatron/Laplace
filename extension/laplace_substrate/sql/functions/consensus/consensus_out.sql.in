-- Outbound edges of an entity. Thin wrapper over edges_raw(), which is the one
-- consensus scan; this pins the axes this signature has always had — outbound,
-- edge_rank ordering, and REFUTED EDGES INCLUDED. That last one is now visible
-- rather than implicit: pass through edges_raw(p_refuted => false) if you want
-- only claims the fold has not rated below neutral.
CREATE OR REPLACE FUNCTION consensus_out(p_id bytea, p_limit integer DEFAULT 40)
    RETURNS TABLE(type_id bytea, object_id bytea, rating bigint, rd bigint,
                  volatility bigint, witness_count bigint)
    LANGUAGE sql STABLE SET search_path = @extschema@, public AS $$
    SELECT e.type_id, e.neighbour_id, e.rating, e.rd, e.volatility, e.witness_count
    FROM edges_raw(p_id, 'out', NULL, p_limit, true, 'edge_rank') e
$$;
