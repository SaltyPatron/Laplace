-- entities is LIST(tier)-partitioned, so tier is constant inside every leaf
-- (including the tier=2 HASH subpartitions). A BRIN on tier alone cannot exclude
-- any page range (min=max for every range) while still charging write-time
-- maintenance — Copilot #859. Drop on upgrade; new installs never create it.
DO $do$
BEGIN
    BEGIN
        EXECUTE format('ALTER EXTENSION %I DROP INDEX laplace.entities_tier_brin',
                       'laplace_substrate');
    EXCEPTION WHEN OTHERS THEN
        NULL;
    END;
    EXECUTE 'DROP INDEX IF EXISTS laplace.entities_tier_brin';
END $do$;
