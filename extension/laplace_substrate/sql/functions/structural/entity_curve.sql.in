DROP FUNCTION IF EXISTS laplace.entity_curve(bytea);
CREATE OR REPLACE FUNCTION structural.entity_curve(p_entity bytea, p_type smallint) RETURNS geometry
    LANGUAGE sql STABLE

BEGIN ATOMIC

    -- A codepoint's canonical placement can live only in the Native floor.
    -- Resolve it there instead of silently dropping it from the realized curve.
    -- A missing non-floor constituent makes the whole curve unresolved.
    WITH native_root AS MATERIALIZED (
        SELECT * FROM public.laplace_entities(ARRAY[encode(p_entity,'hex')::public.blake3])
        WHERE p_type=1
    ), native_parts AS MATERIALIZED (
        SELECT c.* FROM native_root r CROSS JOIN LATERAL
        public.laplace_constituents(ARRAY[r.id]) c
    ), wanted AS MATERIALIZED (
        SELECT DISTINCT child FROM native_parts ORDER BY child
    ), placed AS MATERIALIZED (
        SELECT * FROM public.laplace_entities(ARRAY(SELECT child FROM wanted))
    ), native_points AS (
        SELECT c.ordinal,g.i,coalesce(e.coord,CASE WHEN public.laplace_codepoint(c.child)>=0 THEN
          public.ST_GeomFromEWKB(public.laplace_cp_coord_ewkb(public.laplace_codepoint(c.child))) END) coord
        FROM native_parts c LEFT JOIN placed e ON e.id=c.child
        CROSS JOIN LATERAL generate_series(1,c.run_length) g(i)
    ), other_points AS (
        SELECT c.ordinal,1::bigint AS i,
               COALESCE(p.coord, public.ST_GeomFromEWKB(
                   public.laplace_cp_coord_ewkb(realize.codepoint_for_id(c.child_id)))) AS coord
        FROM generation.trajectory_unpacked_points(p_entity,p_type)
             WITH ORDINALITY AS c(child_id,run_length,ctier,ordinal)
        LEFT JOIN laplace.physicalities p ON p.entity_id=c.child_id AND p.type=1
        WHERE p_type<>1 AND NOT EXISTS(SELECT FROM native_root)
    ), points AS (SELECT * FROM native_points UNION ALL SELECT * FROM other_points)
    SELECT CASE WHEN bool_and(coord IS NOT NULL)
                THEN public.ST_MakeLine(coord ORDER BY ordinal,i) END
    FROM points;
END;

-- Content-lane default, BEGIN ATOMIC so the delegation records pg_depend (GH #764).
CREATE OR REPLACE FUNCTION structural.entity_curve(p_entity bytea) RETURNS geometry
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT structural.entity_curve(p_entity, 1::smallint);
END;
