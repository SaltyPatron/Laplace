-- Ranked surface sample for a source×tier (GH #813/#1008). Census answers
-- "how many"; this answers "what do they look like?". Source/tier/type are
-- structural interpretations; canonical entity identity is id-only.
DROP FUNCTION IF EXISTS laplace.surface_sample(bytea, smallint, int);

CREATE OR REPLACE FUNCTION ops.surface_sample(
        p_source bytea,
        p_tier smallint,
        p_limit int DEFAULT 20)
    RETURNS TABLE(
        entity_id bytea,
        surface text,
        type_name text,
        observations bigint)
    LANGUAGE sql
    STABLE
BEGIN ATOMIC
    WITH eligible AS MATERIALIZED (
        SELECT DISTINCT i.id, i.type_id
        FROM laplace.entities i
        WHERE i.tier = p_tier
          AND EXISTS (SELECT 1 FROM laplace.attestations a
                      WHERE a.source_id = p_source AND a.subject_id = i.id)
    ), kept AS (
        SELECT a.subject_id AS id,
               e.type_id,
               sum(a.observation_count)::bigint AS observations
        FROM laplace.attestations a
        JOIN eligible e ON e.entity_id = a.subject_id
        WHERE a.source_id = p_source
          AND consensus.relation_canonical(a.subject_id) IS NULL
        GROUP BY a.subject_id, e.type_id
        ORDER BY sum(a.observation_count) DESC, a.subject_id, e.type_id
        LIMIT p_limit
    ), numbered AS (
        SELECT k.*, row_number() OVER (ORDER BY k.observations DESC, k.id, k.type_id) AS ix
        FROM kept k
    ),
    ids AS (
        SELECT array_agg(v.id ORDER BY v.ord) AS a
        FROM (
            SELECT k.id, k.ix * 2 - 1 AS ord FROM numbered k
            UNION ALL
            SELECT k.type_id, k.ix * 2 FROM numbered k
        ) v
    ),
    lbl AS (
        SELECT realize.batch(i.a, NULL) AS l FROM ids i
    )
    SELECT k.id,
           COALESCE(NULLIF(lbl.l[k.ix * 2 - 1], ''), 'Unrealized entity'),
           COALESCE(NULLIF(lbl.l[k.ix * 2], ''), 'Unrealized type'),
           k.observations
    FROM numbered k CROSS JOIN lbl
    ORDER BY k.observations DESC, k.id, k.type_id;
END;
