-- Repair chess opponent ratings lost at the managed/native staging boundary AND
-- heal derived OUTCOME fold debt left by an evidence-first apply whose consensus
-- continuation failed. Evidence is durable authority; consensus is rebuildable.
--
-- The first repair reconstructs a missing opponent rating from PLAYED_BY plus
-- HAS_RATING testimony under the same playing context. The second repair is
-- deliberately independent of that historical defect: a failed fold can leave
-- perfectly rated evidence ahead of consensus, so missing/stale player OUTCOME
-- cells are detected from durable witness cardinality/time and refolded even
-- when no opponent_rating_fp1e9 = 0 rows remain.
--
-- This is called by deployment after ALTER EXTENSION so its indexed temporary
-- work tables are not captured as extension members.
CREATE OR REPLACE PROCEDURE chess.repair_player_ratings(
    p_outcome bytea,
    p_played bytea,
    p_rating bytea)
LANGUAGE plpgsql
AS $$
DECLARE
    v_repaired bigint := 0;
    v_fold_debt bigint := 0;
    v_refolded bigint := 0;
BEGIN
    CREATE TEMP TABLE _chess_rating_values (
        rating_id bytea PRIMARY KEY,
        rating bigint NOT NULL
    ) ON COMMIT DROP;
    CREATE TEMP TABLE _chess_rating_cells (
        subject_id bytea NOT NULL,
        type_id bytea NOT NULL,
        object_id bytea,
        UNIQUE NULLS NOT DISTINCT (subject_id, type_id, object_id)
    ) ON COMMIT DROP;

    -- Historical GH #1321 repair scope: any chess rating-bearing evidence row
    -- that still carries the old zero opponent marker. These cells must be
    -- refolded after the testimony itself is corrected.
    INSERT INTO _chess_rating_cells(subject_id, type_id, object_id)
    SELECT DISTINCT a.subject_id, a.type_id, a.object_id
    FROM laplace.attestations a
    WHERE a.type_id = ANY(ARRAY[p_outcome, p_played])
      AND a.opponent_rating_fp1e9 = 0
    ON CONFLICT DO NOTHING;

    INSERT INTO _chess_rating_values(rating_id, rating)
    WITH ids AS MATERIALIZED (
        SELECT COALESCE(array_agg(DISTINCT r.object_id ORDER BY r.object_id),
                        '{}'::bytea[]) AS values
        FROM laplace.attestations target
        JOIN laplace.attestations pairing
          ON pairing.subject_id = target.subject_id
         AND pairing.context_id = target.context_id
         AND pairing.type_id = p_played
        JOIN laplace.attestations r
          ON r.subject_id = pairing.object_id
         AND r.context_id = target.context_id
         AND r.type_id = p_rating
        WHERE target.type_id = ANY(ARRAY[p_outcome, p_played])
          AND target.opponent_rating_fp1e9 = 0
          AND r.object_id IS NOT NULL
    ), rendered AS MATERIALIZED (
        SELECT paired.id, paired.value
        FROM ids,
             LATERAL ROWS FROM (
                 unnest(ids.values),
                 unnest(realize.batch(ids.values))
             ) paired(id, value)
    )
    SELECT id, value::bigint
    FROM rendered
    WHERE value ~ '^[0-9]{3,5}$';

    WITH resolved AS MATERIALIZED (
        SELECT target.id, target.type_id, target.subject_id,
               COALESCE(max(rv.rating) * 1000000000,
                        consensus.glicko2_neutral_mu()) AS opponent_rating
        FROM laplace.attestations target
        LEFT JOIN laplace.attestations pairing
          ON pairing.subject_id = target.subject_id
         AND pairing.context_id = target.context_id
         AND pairing.type_id = p_played
        LEFT JOIN laplace.attestations r
          ON r.subject_id = pairing.object_id
         AND r.context_id = target.context_id
         AND r.type_id = p_rating
        LEFT JOIN _chess_rating_values rv ON rv.rating_id = r.object_id
        WHERE target.type_id = ANY(ARRAY[p_outcome, p_played])
          AND target.opponent_rating_fp1e9 = 0
        GROUP BY target.id, target.type_id, target.subject_id
    )
    UPDATE laplace.attestations target
    SET opponent_rating_fp1e9 = resolved.opponent_rating
    FROM resolved
    WHERE target.id = resolved.id
      AND target.type_id = resolved.type_id
      AND target.subject_id = resolved.subject_id;
    GET DIAGNOSTICS v_repaired = ROW_COUNT;

    -- Evidence-first apply means the journal/evidence transaction can commit
    -- before the consensus continuation. If the fold then throws (for example
    -- the 2026-09-01 zero-volatility Glicko failure), retry may true-skip the
    -- evidence token and leave derived consensus permanently behind. Detect
    -- that debt from the authoritative player OUTCOME testimony itself.
    --
    -- PLAYED_BY under the same context makes this chess-player-specific rather
    -- than sweeping every unrelated OUTCOME relation in the universal substrate.
    -- A healthy consensus row has exactly the fold's game count and max evidence
    -- timestamp; consensus_fold_step adds `games` to witness_count verbatim.
    INSERT INTO _chess_rating_cells(subject_id, type_id, object_id)
    SELECT evidence.subject_id, evidence.type_id, evidence.object_id
    FROM laplace.attestations evidence
    LEFT JOIN laplace.consensus current
      ON current.id = laplace.consensus_id(
            evidence.subject_id, evidence.type_id, evidence.object_id)
     AND current.type_id = evidence.type_id
     AND current.subject_id = evidence.subject_id
    WHERE evidence.type_id = p_outcome
      AND EXISTS (
          SELECT 1
          FROM laplace.attestations pairing
          WHERE pairing.subject_id = evidence.subject_id
            AND pairing.context_id IS NOT DISTINCT FROM evidence.context_id
            AND pairing.type_id = p_played
      )
    GROUP BY evidence.subject_id, evidence.type_id, evidence.object_id,
             current.id, current.witness_count, current.last_observed_at
    HAVING current.id IS NULL
        OR current.witness_count IS DISTINCT FROM
           SUM(GREATEST(evidence.observation_count, 1))
        OR current.last_observed_at IS DISTINCT FROM
           MAX(evidence.last_observed_at)
    ON CONFLICT DO NOTHING;
    GET DIAGNOSTICS v_fold_debt = ROW_COUNT;

    IF NOT EXISTS (SELECT 1 FROM _chess_rating_cells) THEN
        RAISE LOG 'repair_player_ratings: no opponent-rating repair or player OUTCOME fold debt';
        RETURN;
    END IF;

    -- Total reconstruction from durable evidence. This is idempotent: unlike
    -- replaying an additive delta, re-running the aggregate recomputes the same
    -- cell from the same testimony and can materialize a row whose first fold
    -- never committed.
    INSERT INTO laplace.consensus AS target
        (id, subject_id, type_id, object_id, rating, rd, volatility,
         witness_count, last_observed_at)
    SELECT laplace.consensus_id(f.subject_id, f.type_id, f.object_id),
           f.subject_id, f.type_id, f.object_id,
           (f.acc).rating, (f.acc).rd, (f.acc).volatility,
           (f.acc).witness_count, f.last_ts
    FROM (
        SELECT cells.subject_id, cells.type_id, cells.object_id,
               laplace.consensus_fold(
                   false, NULL::bigint, NULL::bigint, NULL::bigint,
                   evidence.opponent_rating_fp1e9,
                   evidence.opponent_rd_fp1e9,
                   GREATEST(evidence.observation_count, 1),
                   evidence.sum_score_fp1e9,
                   consensus.glicko2_tau()
                   ORDER BY evidence.last_observed_at, evidence.id) AS acc,
               max(evidence.last_observed_at) AS last_ts
        FROM _chess_rating_cells cells
        JOIN laplace.attestations evidence
          ON evidence.type_id = cells.type_id
         AND evidence.subject_id = cells.subject_id
         AND evidence.object_id IS NOT DISTINCT FROM cells.object_id
        GROUP BY cells.subject_id, cells.type_id, cells.object_id
    ) f
    ON CONFLICT (id, type_id, subject_id) DO UPDATE
    SET object_id = EXCLUDED.object_id,
        rating = EXCLUDED.rating,
        rd = EXCLUDED.rd,
        volatility = EXCLUDED.volatility,
        witness_count = EXCLUDED.witness_count,
        last_observed_at = EXCLUDED.last_observed_at;
    GET DIAGNOSTICS v_refolded = ROW_COUNT;

    RAISE LOG 'repair_player_ratings: repaired % evidence rows, detected % additional OUTCOME fold-debt cells, refolded % cells',
        v_repaired, v_fold_debt, v_refolded;
END;
$$;
