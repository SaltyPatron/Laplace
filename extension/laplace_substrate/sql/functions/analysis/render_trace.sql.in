-- ops.render_trace — why did realize.render_text(id) return NULL?
--
-- render_node (generate_walk.c:1104-1126) accumulates children into one buffer
-- and discards ALL of it if any single child fails to resolve:
--
--     if (child_text != NULL)  append child_text
--     else if (!append_codepoint_render(&out, kids[r].child))  ok = false;
--     ...
--     e->text = ok ? out.data : NULL;
--
-- NULL then propagates to the root, so one unresolvable constituent out of
-- thirty makes an entire document unreadable at any p_max_depth. That is the
-- CORRECT behaviour -- rendering the other twenty-nine would manufacture
-- content with a valid hash, which is the one thing a provenance substrate
-- must not do. Abstention is the design (see "softmax can be zero").
--
-- What was missing is the diagnosis. render_text returns NULL and says nothing
-- about which constituent killed it, so the only way to find out was a manual
-- LEFT JOIN against the trajectory, one document at a time. MEASURED
-- 2026-08-12: three tier-4 documents with n_constituents=5 returned NULL at
-- both depth 8 and depth 32; ordinals 1 and 5 had no laplace.entities row.
-- Those are two of the 899,179 orphaned physicalities (ops.ingest_integrity_gate).
--
-- realize.render_gaps() does not answer this: it scans consensus for globally
-- unnameable ids, not the constituent closure of one entity.
--
-- Cost discipline: realize.codepoint_for_id is the expensive call, so it fires
-- only on rows the cheap entity join could not already classify, and labels
-- resolve through ONE converse.label_or_hex_batch rather than N scalar calls
-- (measured 2026-08-12: the scalar form is ~42 ms per call).
--
-- BEGIN ATOMIC, not AS $$ (G12 / GH #764). Codepoints render through to_hex
-- alone -- G14 bans lower()/upper()/initcap() anywhere on the read path, and
-- the conventional uppercase of "U+00E9" is not worth a case fold that is
-- Latin-shaped and silently a no-op for most of the codespace. Internal aliases
-- avoid the RETURNS TABLE column names, which are OUT parameters in scope over
-- an atomic body.
DROP FUNCTION IF EXISTS ops.render_trace(bytea, integer, boolean);
CREATE OR REPLACE FUNCTION ops.render_trace(
    p_entity        bytea,
    p_max_depth     integer DEFAULT 32,
    p_failures_only boolean DEFAULT true
)
RETURNS TABLE(
    parent_id  bytea,
    ordinal    integer,
    child_id   bytea,
    tier       smallint,
    label      text,
    verdict    text
)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH clo AS (
        SELECT c.parent_id AS pid, c.ordinal AS ord, c.child_id AS cid
        FROM realize.constituents_closure(ARRAY[p_entity], p_max_depth) c
    ),
    -- Cheap pass first: an id with no entities row is an orphan and needs no
    -- further probing. An id that carries a trajectory renders by recursion.
    cheap AS (
        SELECT clo.pid, clo.ord, clo.cid, e.tier AS etier,
               (e.id IS NOT NULL) AS has_entity,
               EXISTS (SELECT 1 FROM laplace.v_word_points w
                       WHERE w.id = clo.cid AND w.trajectory IS NOT NULL) AS has_traj
        FROM clo
        LEFT JOIN laplace.entities e ON e.id = clo.cid
    ),
    -- codepoint_for_id only for rows still undecided: real entity, no trajectory.
    resolved AS (
        SELECT cheap.pid, cheap.ord, cheap.cid, cheap.etier,
               cheap.has_entity, cheap.has_traj,
               CASE WHEN cheap.has_entity AND NOT cheap.has_traj
                    THEN realize.codepoint_for_id(cheap.cid)
               END AS cp
        FROM cheap
    ),
    verdicted AS (
        SELECT r.pid, r.ord, r.cid, r.etier,
               CASE
                 WHEN NOT r.has_entity
                   THEN 'ORPHAN: physicality exists, no laplace.entities row'::text
                 WHEN r.has_traj
                   THEN 'ok: composed, renders by recursion'::text
                 WHEN r.cp IS NOT NULL
                   THEN ('ok: codepoint U+' || to_hex(r.cp))::text
                 ELSE 'UNRENDERABLE: entity exists, no trajectory, no codepoint'::text
               END AS vd
        FROM resolved r
    ),
    kept AS (
        SELECT verdicted.pid, verdicted.ord, verdicted.cid,
               verdicted.etier, verdicted.vd
        FROM verdicted
        WHERE NOT p_failures_only OR verdicted.vd NOT LIKE 'ok:%'
    ),
    -- One batched label call over the surviving ids, joined back positionally.
    bag AS (
        SELECT array_agg(DISTINCT kept.cid) AS arr FROM kept
    ),
    labs AS (
        SELECT u.id AS lid, (l.res)[u.n] AS lbl
        FROM bag
        CROSS JOIN LATERAL (SELECT converse.label_or_hex_batch(bag.arr) AS res) l
        CROSS JOIN LATERAL unnest(bag.arr) WITH ORDINALITY AS u(id, n)
        WHERE bag.arr IS NOT NULL
    )
    SELECT kept.pid, kept.ord, kept.cid, kept.etier, labs.lbl, kept.vd
    FROM kept LEFT JOIN labs ON labs.lid = kept.cid
    ORDER BY kept.pid, kept.ord;
END;

COMMENT ON FUNCTION ops.render_trace(bytea, integer, boolean) IS
    'Why realize.render_text(id) returned NULL: the constituent closure with a '
    'per-child verdict. Non-empty with p_failures_only means the render aborted '
    'on those rows and discarded everything already assembled.';
