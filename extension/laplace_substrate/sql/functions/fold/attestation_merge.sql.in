-- Compatibility replay surface. An existing five-tuple is the same witness.
-- Both forms validate their typed input and return zero without database work.
-- The shared writer admits novel identities and folds only that accepted set.
DROP FUNCTION IF EXISTS laplace.attestation_merge(bytea[], bytea[], bytea[], bigint[], bigint[], timestamptz[]);
DROP FUNCTION IF EXISTS consensus.attestation_merge(bytea[], bytea[], bytea[], bigint[], bigint[], timestamptz[]);
DROP FUNCTION IF EXISTS consensus.attestation_merge_type(bytea, bytea[], bytea[], bigint[], bigint[], timestamptz[]);
CREATE OR REPLACE FUNCTION consensus.attestation_merge(
    p_ids      bytea[],
    p_types    bytea[],
    p_subjects bytea[],
    p_games    bigint[],
    p_sums     bigint[],
    p_ts       timestamptz[],
    p_fold_replayable boolean[])
    RETURNS bigint
    AS 'MODULE_PATHNAME', 'pg_laplace_attestation_merge'
    LANGUAGE C VOLATILE;

-- First-party ingest owns type-major runs and uses this direct routed form.
-- Keeping type scalar avoids serializing/deconstructing 16 duplicate bytes per
-- row and lets native pass every value array directly to the cached MERGE plan.
CREATE OR REPLACE FUNCTION consensus.attestation_merge_type(
    p_type     bytea,
    p_ids      bytea[],
    p_subjects bytea[],
    p_games    bigint[],
    p_sums     bigint[],
    p_ts       timestamptz[],
    p_fold_replayable boolean[])
    RETURNS bigint
    AS 'MODULE_PATHNAME', 'pg_laplace_attestation_merge_type'
    LANGUAGE C VOLATILE;
