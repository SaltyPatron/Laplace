  "figures": [
    {
      "id": "centroid-population",
      "title": "Averages approach the population mean",
      "caption": "Independent identically distributed samples give E||mean||² = ||μ||² + (E||X||² − ||μ||²)/k. The 1/√k RMS curve requires zero mean and unit squared norm. Correlated text, hierarchy and fixed-point truncation need their own analysis.",
      "kind": "Analytic illustration, not a measured Laplace corpus result"
    },
    {
      "id": "wall-and-order",
      "title": "Inside the wall; no universal inward step",
      "caption": "The triangle inequality bounds a parent by the average norm of its immediate children, not by each child or the previous prefix. A hierarchy averages immediate children, so regrouping generally changes the effective leaf weights. This example does not use Unicode placement data.",
      "kind": "Analytic illustration, not a measured Laplace corpus result"
    },
    {
      "id": "identity-and-geometry",
      "title": "A location is not the content address",
      "caption": "Prototype dag/ingest.c: one-child collapse; BLAKE3-128 over ordered child IDs, including repeats; integer centroid; run-length path. Different ordered preimages ordinarily produce different IDs, subject to hash collisions. No collision-free proof or lookup-performance claim is made.",
      "kind": "Analytic illustration, not a measured Laplace corpus result"
    }
  ],
  "findings": [
    {
      "topic": "Old image 03 versus revised draft 02",
      "observation": "The renderer samples assigned codepoints and overlays 1/√k. The revised draft requests an unrendered prototype database tier-band figure. They are different claims and neither supplies local measurement inputs."
    },
    {
      "topic": "Exact repeats versus exact unit norm",
      "observation": "Both generators nudge rounded coordinates inward until the integer squared norm is at most 2^106. A repeat preserves its constituent coordinate; that does not establish that the stored coordinate lies exactly at norm one."
    },
    {
      "topic": "Measurement precision",
      "observation": "Prototype verify.py checks the wall using integer squared norms. Its sampled average-depth check uses Decimal square roots at precision 80 with tolerance 1e−40 grid units. Calling every check exact integer arithmetic overstates the latter test."
    },
    {
      "topic": "Verification coverage",
      "observation": "The count equality check does not by itself establish one physicality per entity. ID/tier checks are sampled; recomposition checks select two books; an idempotence test launches ingest in a temporary output directory. None of those tests was executed for this atlas."
    },
    {
      "topic": "Fingerprint boundaries",
      "observation": "Prototype fingerprint.txt reports SHA-256 of its table and order. Current modular Engine prints BLAKE3-256 and uses CORE-MATH trigonometry. A digest from one generator is not verification of the other."
    },
    {
      "topic": "Required empirical inputs",
      "observation": "P_h1.npy, assigned.npy, pinned Unicode script data and the historical prototype database were not supplied in these source repositories. The published distance and 3.9-million-record results remain attributed reports, not reproduced results."
    },
    {
      "topic": "Publication scope",
      "observation": "These figures explain researched storage geometry boundaries. They supplement the whole-system operation atlas; they do not replace its authority, learning, runtime, modality, deployment or recovery flows."
    }
  ],
  "empirical_reproduction": false
}