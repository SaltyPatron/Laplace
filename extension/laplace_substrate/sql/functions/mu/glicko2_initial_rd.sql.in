-- The unrated deviation on Laplace-Native's standing scale (LP_GLICKO_DEVIATION).
DROP FUNCTION IF EXISTS laplace.glicko2_initial_rd();
CREATE OR REPLACE FUNCTION consensus.glicko2_initial_rd() RETURNS double precision
    AS 'MODULE_PATHNAME', 'pg_laplace_standing_deviation'
    LANGUAGE C LAPLACE_IMMUTABLE;

-- The same deviation in legacy laplace.consensus fixed point (points x 1e9), until its writer moves to public.consensus.
CREATE OR REPLACE FUNCTION consensus.glicko2_initial_rd_fp1e9() RETURNS bigint LANGUAGE sql LAPLACE_IMMUTABLE
BEGIN ATOMIC
    SELECT round(consensus.glicko2_initial_rd() * 1e9)::bigint;
END;
