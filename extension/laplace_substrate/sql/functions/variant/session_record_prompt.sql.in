DROP FUNCTION IF EXISTS laplace.session_record_prompt(bytea, text, bytea);
CREATE OR REPLACE FUNCTION generation.session_record_prompt(
        p_session bytea, p_prompt text, p_resolved bytea DEFAULT NULL)
    RETURNS void
    LANGUAGE sql VOLATILE
BEGIN ATOMIC
    SELECT pg_advisory_xact_lock(laplace.hash128_lo(p_session));

    INSERT INTO converse.session_topics (session_id, ord, prompt, resolved_id)
    VALUES (
        p_session,
        COALESCE((SELECT max(t.ord) FROM converse.session_topics t WHERE t.session_id = p_session), 0) + 1,
        p_prompt,
        p_resolved
    );
END;
