-- Exact-pair backlog replay plus historical full population of entities.highway_mask.
-- Normal ingest never calls either procedure: current writes populate masks directly from
-- the (entity,type) pairs already held by the fold. These procedures only recover work
-- retained during a temporary registry outage and reconcile databases created before
-- inline exact-pair deposit existed.
--
-- No SET clause on either procedure: a PL/pgSQL procedure carrying one is barred from
-- transaction control (COMMIT), so references are schema-qualified.

DROP PROCEDURE IF EXISTS laplace.highway_mask_pending_drain(int);
CREATE OR REPLACE PROCEDURE laplace.highway_mask_pending_drain(p_batch int DEFAULT 250000)
    LANGUAGE plpgsql AS $$
DECLARE
    entity_ids bytea[];
    type_ids bytea[];
    drained bigint := 0;
    n bigint;
BEGIN
    IF p_batch IS NULL OR p_batch < 1 THEN
        RAISE EXCEPTION 'highway_mask_pending_drain: p_batch must be >= 1';
    END IF;
    IF NOT consensus.highway_ready() THEN
        RAISE LOG 'highway_mask_pending_drain: Highway registry unavailable; exact pending pairs retained';
        RETURN;
    END IF;

    LOOP
        SELECT array_agg(q.entity_id ORDER BY q.entity_id, q.type_id),
               array_agg(q.type_id ORDER BY q.entity_id, q.type_id)
        INTO entity_ids, type_ids
        FROM (
            SELECT entity_id, type_id
            FROM laplace.highway_mask_pending
            ORDER BY entity_id, type_id
            LIMIT p_batch
            FOR UPDATE SKIP LOCKED
        ) AS q;

        EXIT WHEN entity_ids IS NULL;
        PERFORM consensus.highway_mask_deposit_native(entity_ids, type_ids);

        DELETE FROM laplace.highway_mask_pending p
        USING unnest(entity_ids, type_ids) AS q(entity_id, type_id)
        WHERE p.entity_id = q.entity_id AND p.type_id = q.type_id;
        GET DIAGNOSTICS n = ROW_COUNT;
        drained := drained + n;
        RAISE LOG 'highway_mask_pending_drain: % exact pairs drained', drained;
        COMMIT;
    END LOOP;
END $$;

-- Full population via highway_mask_refresh, batched with a COMMIT per batch. Current
-- Highway bits are an explicit append-only registry. Existing valid bits therefore do
-- not need to be cleared before reconciliation; missing governed bits are added by the
-- exact recomputation. Per-source eviction still uses highway_mask_drain because that is
-- the operation that must turn bits OFF.
--
-- SCAN SET: drive batches from the candidate set, not every entity. An entity that
-- appears in no consensus row cannot gain a mask from this repair. Entities already
-- carrying a mask remain candidates so stale bits can be corrected by refresh.
DROP PROCEDURE IF EXISTS laplace.highway_mask_rebuild(int);

CREATE OR REPLACE PROCEDURE laplace.highway_mask_rebuild(p_batch int DEFAULT 500000)
    LANGUAGE plpgsql AS $$
DECLARE
    last_id bytea := decode(repeat('00', 16), 'hex');
    ids bytea[];
    n bigint;
    total bigint := 0;
    scanned bigint := 0;
    candidates bigint;
    t0 timestamptz := clock_timestamp();
BEGIN
    IF p_batch IS NULL OR p_batch < 1 THEN
        RAISE EXCEPTION 'highway_mask_rebuild: p_batch must be >= 1';
    END IF;
    IF NOT consensus.highway_ready() THEN
        RAISE LOG 'highway_mask_rebuild: Highway registry unavailable; historical population remains pending';
        RETURN;
    END IF;

    -- Exact pairs retained during any registry outage are cheaper and more precise than
    -- rediscovery, so replay them before the historical consensus reconciliation.
    CALL laplace.highway_mask_pending_drain(p_batch);

    -- Plain TEMP table (ON COMMIT PRESERVE ROWS): the per-batch COMMIT below would
    -- drop an ON COMMIT DROP table out from under the loop.
    DROP TABLE IF EXISTS _hmr_candidates;
    CREATE TEMP TABLE _hmr_candidates (id bytea PRIMARY KEY);

    INSERT INTO _hmr_candidates (id)
    SELECT c.subject_id FROM laplace.consensus c
    UNION
    SELECT c.object_id  FROM laplace.consensus c WHERE c.object_id IS NOT NULL
    UNION
    SELECT e.id FROM laplace.entities e WHERE e.highway_mask IS NOT NULL;
    GET DIAGNOSTICS candidates = ROW_COUNT;

    RAISE LOG 'highway_mask_rebuild: start — % mask candidates', candidates;
    COMMIT;

    LOOP
        SELECT array_agg(s.id ORDER BY s.id) INTO ids FROM (
            SELECT id FROM _hmr_candidates WHERE id > last_id ORDER BY id LIMIT p_batch) s;
        EXIT WHEN ids IS NULL;
        n := consensus.highway_mask_refresh(ids);
        total := total + n;
        scanned := scanned + cardinality(ids);
        last_id := ids[cardinality(ids)];
        RAISE LOG 'highway_mask_rebuild: % masks written / % of % candidates (% percent) — %s elapsed',
            total, scanned, candidates,
            round(100.0 * scanned / NULLIF(candidates, 0), 1),
            round(extract(epoch FROM clock_timestamp() - t0)::numeric, 1);
        COMMIT;
    END LOOP;

    UPDATE laplace.highway_mask_population_state
       SET complete = true,
           completed_at = clock_timestamp()
     WHERE singleton;
    COMMIT;

    RAISE LOG 'highway_mask_rebuild: done — % masks written / % candidates in %s',
        total, scanned, round(extract(epoch FROM clock_timestamp() - t0)::numeric, 1);
    DROP TABLE IF EXISTS _hmr_candidates;
END $$;
