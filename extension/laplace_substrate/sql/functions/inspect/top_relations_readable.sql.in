-- Declared unqualified, so it installed as laplace.top_relations_readable while every caller
-- asks for ops.top_relations_readable -- 42883 at runtime. See ops.evidence_receipt.
CREATE OR REPLACE FUNCTION ops.top_relations_readable(p_limit integer DEFAULT 10, p_type bytea DEFAULT NULL)
    RETURNS TABLE(subject text, type text, object text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    WITH raw AS MATERIALIZED (
      SELECT t.subject_id,t.type_id,t.object_id,t.eff_mu,t.witnesses,t.rn
      FROM consensus.top_relations(p_limit,p_type) WITH ORDINALITY
        AS t(subject_id,type_id,object_id,eff_mu,witnesses,rn)
    ), batch AS MATERIALIZED (
      SELECT ARRAY(SELECT lp_l.content FROM unnest((array_agg(subject_id ORDER BY rn))::bytea[]) WITH ORDINALITY lp_u(x,n) LEFT JOIN (SELECT DISTINCT ON (lp_d.entity) lp_d.entity,lp_d.content FROM public.laplace_labels(array_remove((array_agg(subject_id ORDER BY rn))::bytea[],NULL)::public.blake3[]) lp_d) lp_l ON lp_l.entity=lp_u.x::public.blake3 ORDER BY lp_u.n) AS subjects,
             ARRAY(SELECT lp_l.content FROM unnest((array_agg(type_id ORDER BY rn))::bytea[]) WITH ORDINALITY lp_u(x,n) LEFT JOIN (SELECT DISTINCT ON (lp_d.entity) lp_d.entity,lp_d.content FROM public.laplace_labels(array_remove((array_agg(type_id ORDER BY rn))::bytea[],NULL)::public.blake3[]) lp_d) lp_l ON lp_l.entity=lp_u.x::public.blake3 ORDER BY lp_u.n) AS types,
             ARRAY(SELECT lp_l.content FROM unnest((array_agg(object_id ORDER BY rn))::bytea[]) WITH ORDINALITY lp_u(x,n) LEFT JOIN (SELECT DISTINCT ON (lp_d.entity) lp_d.entity,lp_d.content FROM public.laplace_labels(array_remove((array_agg(object_id ORDER BY rn))::bytea[],NULL)::public.blake3[]) lp_d) lp_l ON lp_l.entity=lp_u.x::public.blake3 ORDER BY lp_u.n) AS objects FROM raw
    )
    SELECT b.subjects[t.rn],b.types[t.rn],b.objects[t.rn],t.eff_mu,t.witnesses
    FROM raw t CROSS JOIN batch b ORDER BY t.rn;
END;
