CREATE OR REPLACE FUNCTION epistemic_status(p_word bytea, p_lang bytea DEFAULT NULL,
                                            p_limit int DEFAULT 30)
    RETURNS TABLE(type text, fact text, status text, mu numeric,
                  volatility numeric, witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
    AS $$
    WITH subj(id) AS (SELECT p_word UNION SELECT sn.synset_id FROM @extschema@.senses(p_word) sn),
         rels AS (
            SELECT c.type_id, c.object_id, c.rating, c.rd, c.volatility, c.witness_count
            FROM @extschema@.consensus c JOIN subj s ON c.subject_id = s.id
            WHERE c.object_id IS NOT NULL
              AND c.type_id NOT IN (@extschema@.relation_type_id('HAS_SENSE'), @extschema@.relation_type_id('IS_SENSE_OF'),
                                    @extschema@.relation_type_id('HAS_LANGUAGE'))
            ORDER BY @extschema@.edge_rank(c.type_id, @extschema@.eff_mu(c.rating, c.rd)) DESC
            LIMIT p_limit),
         lang(id) AS (SELECT COALESCE(p_lang, @extschema@.word_language(p_word))),
         objs(a) AS (SELECT array_agg(DISTINCT object_id) FROM rels),
         rendered AS (
            SELECT u.object_id, NULLIF(u.s, '') AS s
            FROM objs CROSS JOIN LATERAL unnest(objs.a, @extschema@.render_text_batch(objs.a, 32)) AS u(object_id, s)
            WHERE objs.a IS NOT NULL
         )
    SELECT @extschema@.type_label(r.type_id),
           COALESCE(rd.s, @extschema@.realize(r.object_id, l.id)),
           CASE WHEN @extschema@.refuted(r.rating, r.rd) THEN 'refuted'
                WHEN @extschema@.eff_mu(r.rating, r.rd) > @extschema@.glicko2_neutral_mu() THEN 'confirmed'
                WHEN r.volatility::numeric > @extschema@.glicko2_initial_volatility() * 1.5 THEN 'contested'
                ELSE 'thin' END,
           @extschema@.eff_mu_display(r.rating, r.rd),
           round(r.volatility / 1e9, 4), r.witness_count
    FROM rels r
    CROSS JOIN lang l
    LEFT JOIN rendered rd ON rd.object_id = r.object_id
    ORDER BY @extschema@.edge_rank(r.type_id, @extschema@.eff_mu(r.rating, r.rd)) DESC
$$;
