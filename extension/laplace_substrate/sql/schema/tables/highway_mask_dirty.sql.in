-- Authoritative Highway-mask recomputation is a durable obligation whenever an
-- existing cached value may differ from current consensus. This includes
-- bit-clearing after source eviction/refolding and incremental accretion that
-- deliberately skips a contended entity row so the accelerator cannot block
-- canonical ingest. A crash must not erase either class of work.
CREATE TABLE IF NOT EXISTS highway_mask_dirty (
    id bytea PRIMARY KEY
);
ALTER TABLE laplace.highway_mask_dirty SET LOGGED;

-- Exact deposit backlog. Persist already-known pairs when the registry is
-- unavailable instead of rediscovering them with a later consensus scan.
CREATE TABLE IF NOT EXISTS highway_mask_pending (
    entity_id bytea NOT NULL CHECK (octet_length(entity_id) = 16),
    type_id   bytea NOT NULL CHECK (octet_length(type_id) = 16),
    PRIMARY KEY (entity_id, type_id)
);

-- Existing data needs one historical population pass. Subsequent writes use
-- native inline deposit when uncontended; deferred dirty identities and pending
-- pairs remain repairable independently of canonical substrate completion.
CREATE TABLE IF NOT EXISTS highway_mask_population_state (
    singleton boolean PRIMARY KEY DEFAULT true CHECK (singleton),
    complete boolean NOT NULL DEFAULT false,
    completed_at timestamptz
);
-- On a greenfield database this table is installed before corpus admission, so
-- the historical estate is already complete: there is no pre-existing consensus
-- to repair, and every subsequent accepted pair is deposited inline. An upgrade
-- that creates this state over an existing populated consensus estate remains
-- incomplete and may be repaired only by an explicit operator action.
INSERT INTO highway_mask_population_state(singleton, complete, completed_at)
SELECT true,
       NOT EXISTS (SELECT 1 FROM laplace.consensus),
       CASE WHEN NOT EXISTS (SELECT 1 FROM laplace.consensus)
            THEN clock_timestamp() ELSE NULL END
ON CONFLICT (singleton) DO NOTHING;
