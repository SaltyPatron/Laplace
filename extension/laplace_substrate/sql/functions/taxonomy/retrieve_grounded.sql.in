-- taxonomy.retrieve_grounded: case/variant fan-out → bubble_up frontier → definitions.
-- Formal R0/R2 tool ISA entry; abstains with 0 rows when ungrounded.
--
-- GH #862 / #860. No SET search_path -- it blocks plan caching and SQL inlining, so
-- the body was re-planned on every call. No @extschema@ either: the control file
-- pins schema = 'laplace' with relocatable = false, so the placeholder has exactly
-- one possible expansion. Real schema names throughout.
CREATE OR REPLACE FUNCTION taxonomy.retrieve_grounded(
    p_term text,
    p_domain_context bytea[] DEFAULT NULL,
    p_k integer DEFAULT 5
)
RETURNS TABLE(
    entity_id bytea,
    surface text,
    synset_id bytea,
    definition text,
    score numeric,
    witnesses bigint
)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
WITH term AS (
    SELECT public.blake3_send(public.laplace_text_id(p_term)) AS id
),
frontier AS (
    SELECT b.sense_id,
           b.synset_id,
           b.score,
           b.witnesses
    FROM term t
    CROSS JOIN LATERAL taxonomy.bubble_up(t.id, p_domain_context, p_k) b
    WHERE t.id IS NOT NULL
),
glossed AS MATERIALIZED (
    SELECT f.sense_id AS entity_id,
           f.synset_id,
           f.score,
           f.witnesses,
           (
               SELECT g.object_id
               FROM laplace.consensus g
               WHERE g.subject_id = f.synset_id
                 AND g.type_id = laplace.relation_type_id('HAS_DEFINITION')
               ORDER BY consensus.eff_mu(g.rating, g.rd) DESC
               LIMIT 1
           ) AS definition_id
    FROM frontier f
), numbered AS MATERIALIZED (
    SELECT g.*, row_number() OVER (ORDER BY score DESC NULLS LAST,entity_id) AS rn FROM glossed g
), batches AS MATERIALIZED (
    SELECT ARRAY(SELECT NULLIF(lp_l.content,lp_l.entity::text) FROM unnest((array_agg(entity_id ORDER BY rn))::bytea[]) WITH ORDINALITY lp_u(x,n) LEFT JOIN (SELECT DISTINCT ON (lp_d.entity) lp_d.entity,lp_d.content FROM public.laplace_labels(array_remove((array_agg(entity_id ORDER BY rn))::bytea[],NULL)::public.blake3[]) lp_d) lp_l ON lp_l.entity=lp_u.x::public.blake3 ORDER BY lp_u.n) AS surfaces,
           ARRAY(SELECT NULLIF(lp_l.content,lp_l.entity::text) FROM unnest((array_agg(definition_id ORDER BY rn))::bytea[]) WITH ORDINALITY lp_u(x,n) LEFT JOIN (SELECT DISTINCT ON (lp_d.entity) lp_d.entity,lp_d.content FROM public.laplace_labels(array_remove((array_agg(definition_id ORDER BY rn))::bytea[],NULL)::public.blake3[]) lp_d) lp_l ON lp_l.entity=lp_u.x::public.blake3 ORDER BY lp_u.n) AS definitions
    FROM numbered
)
SELECT entity_id,
       COALESCE(NULLIF(b.surfaces[g.rn], ''), p_term) AS surface,
       synset_id,
       b.definitions[g.rn],
       score,
       witnesses
FROM numbered g CROSS JOIN batches b
ORDER BY g.rn;
END;
