-- The reverse of realize.constituents(): given an entity, walk UP the composition
-- hierarchy and return every higher-tier entity whose trajectory contains it
-- (directly at hop=1, or transitively through intermediate tiers at hop>1),
-- e.g. structural.containers_of(laplace.word_id('chess'), 2) returns the sentences containing
-- "chess" (hop 1) and the documents containing those sentences (hop 2).
--
-- Native C owns frontier expansion and deduplication. Each hop reads the GIN
-- membership index with the complete frontier, sorts distinct parent identities,
-- then applies the caller's result bound. Labels are a subsequent operation.
DROP FUNCTION IF EXISTS laplace.containers_of(bytea, int, int);
CREATE OR REPLACE FUNCTION structural.containers_of(
    p_entity   bytea,
    p_max_hops int   DEFAULT 1,
    p_limit    int   DEFAULT 1000)
    RETURNS TABLE(entity_id bytea, tier smallint, type_id bytea, hops int)
    AS 'MODULE_PATHNAME', 'pg_laplace_containers_of'
    LANGUAGE C STABLE;

CREATE OR REPLACE FUNCTION structural.text_containers(p_forms text[])
    RETURNS TABLE(entity_id bytea)
    AS 'EXECUTION_LIBRARY', 'pg_laplace_content_text_containers'
    LANGUAGE C STABLE PARALLEL RESTRICTED;

-- Set containment is a different operation from frontier expansion.  Given
-- multiple identities, return compositions whose one witnessed trajectory
-- contains every identity.  This preserves the composition hop: `Captain` and
-- `Ahab` remain constituents of the returned sentence; this function does not
-- fabricate a direct semantic edge between them.
DROP FUNCTION IF EXISTS laplace.containers_containing_all(bytea[]);
CREATE OR REPLACE FUNCTION structural.containers_containing_all(p_members bytea[])
    RETURNS TABLE(entity_id bytea)
    AS 'EXECUTION_LIBRARY', 'pg_laplace_containers_containing_all'
    LANGUAGE C STABLE PARALLEL SAFE;

-- Browser/name discovery reuses the exact same indexed trajectory law over the
-- word-point surface, but accepts the decomposer's word identities as input.
-- It delegates to the same native reader with those identities intact.
-- The compatibility capacity never limits the discoverable set.
DROP FUNCTION IF EXISTS structural.word_containers_containing_all(bytea[], int);
CREATE OR REPLACE FUNCTION structural.word_containers_containing_all(
    p_members bytea[],
    p_capacity int DEFAULT 2048)
    RETURNS TABLE(entity_id bytea, candidate_count bigint, truncated boolean)
    AS 'MODULE_PATHNAME', 'pg_laplace_word_containers_containing_all'
    LANGUAGE C STABLE;
