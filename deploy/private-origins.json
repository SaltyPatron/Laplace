{
  "environments": [
    {
      "name": "staging",
      "browser_origin": "https://staging.hartonomous.com",
      "dns_target": "hart-server.hartonomous.com",
      "host": "hart-server",
      "hosting": "nginx",
      "certificate": "/etc/ssl/hartonomous.com/fullchain.pem",
      "certificate_key": "/etc/ssl/hartonomous.com/privkey.pem",
      "api_upstream": "http://127.0.0.1:5187",
      "mcp_upstream": "http://127.0.0.1:5190",
      "client_max_body_size": "256m",
      "mcp_max_body_size": "1m",
      "proxy_timeout_seconds": 3600,
      "activation_timeout_seconds": 30,
      "allowed_networks": [
        "192.168.1.0/24",
        "100.124.95.17/32",
        "100.103.255.122/32",
        "100.76.181.27/32",
        "127.0.0.1/32"
      ],
      "listen_addresses": [
        "192.168.1.2",
        "100.76.181.27"
      ]
    }
  ]
}
