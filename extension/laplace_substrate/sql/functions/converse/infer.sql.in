-- converse.infer(prompt, limit): one forward pass over the substrate, installed.
--
-- Run by hand as three ad-hoc statements on 2026-08-01 ("the capital of
-- California is" -> sacramento) and promoted to a surface the same night:
-- an end user never runs SQL against the substrate, and an operator never
-- re-derives this composition.
--
--   EMBED    prompt_coherence: surface tokens -> content ids, one call.
--   ATTEND   the election seats the TOPIC -- one election, one key order,
--            converse.chat()'s verbatim; every other candidate becomes a BIAS head.
--   READ     one indexed scan: the topic's consensus objects. This is the
--            A->[...] distribution, and it is NOT collapsed here.
--   REWEIGHT bias_hits counts each candidate's own edges into the bias
--            family (bias synsets plus their one-hop in-edges), id space
--            only -- no realize.render, no string compare.
--   EMIT     realize_batch ONCE over the ranked survivors, position-aligned;
--            the single realize.render, at the end, where rendering belongs.
--
-- KNOWN LIMITS, stated not hidden: forward direction only (the both-direction
-- OR join belongs in C next to prompt_coherence, not rewritten here); one-hop
-- bias family; single-step emission. Relation-name attestation data (#756.1)
-- and new relation families (#756.2) are separate; this file owns #756.3 —
-- election rel_type_id narrows the READ when a prompt token names a relation.
-- On a single-witness seed the base weights are flat and bias_hits carries the
-- whole signal -- measured: the California read returns 39 candidates all at
-- consensus.eff_mu 1315.5, and exactly one (sacramento) carries a capital-family edge.
CREATE OR REPLACE FUNCTION converse.infer(p_prompt text, p_limit int DEFAULT 8)
    RETURNS TABLE(prediction text, weight double precision, bias_hits bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
-- The prompt's language is a CONSTRAINT on which candidates may be seated, never
-- a score. Without it a foreign interjection outranks the content word on the
-- specificity scalar and takes the topic seat, which is the §7 violation seen on
-- every phrase probe. A candidate is dropped only when the prompt's language and
-- the candidate's primary language are both known and differ; concepts (no
-- HAS_LANGUAGE) and undetectable prompts are untouched, so this can only narrow a
-- language-blind field. converse.prompt_language_top and converse.word_language
-- are the existing definitions of both sides — neither was wired to this election.
WITH plang AS MATERIALIZED (
    SELECT converse.prompt_language_top(p_prompt) AS id
),
coherence_rows AS MATERIALIZED (
    SELECT * FROM converse.prompt_coherence(p_prompt)
),
coherence_langs AS MATERIALIZED (
    SELECT l.word AS synset_id, l.lang,
           row_number() OVER (PARTITION BY l.word ORDER BY l.mu DESC, l.lang) AS rn
    FROM converse.word_language_candidates_batch(ARRAY(SELECT DISTINCT synset_id FROM coherence_rows)) l
    WHERE (SELECT id FROM plang) IS NOT NULL
),
ranked AS (
    SELECT y.tok, y.synset_id, y.rel_type_id,
           row_number() OVER (ORDER BY y.specificity DESC NULLS LAST,
                                       y.rel_mass DESC NULLS LAST,
                                       y.peers DESC,
                                       y.ord DESC,
                                       y.denote_mu DESC NULLS LAST,
                                       y.synset_id) AS rk
    FROM coherence_rows y
    LEFT JOIN coherence_langs cl ON cl.synset_id = y.synset_id AND cl.rn = 1
    WHERE (SELECT id FROM plang) IS NULL
       OR cl.lang IS NULL
       OR cl.lang = (SELECT id FROM plang)
),
topic AS (
    SELECT r.synset_id, r.rel_type_id, r.tok FROM ranked r WHERE r.rk = 1
),
-- EVERY sense of every bias token, not the per-token argmax. Shipped first
-- as prompt_coherence's elected sense per bias token and measured broken the
-- same night: "capital"'s elected sense is the washington synset, so the
-- capital-family intersection scored ZERO hits and sacramento ranked flat.
-- The bias head is a DISTRIBUTION over the token's senses; collapsing it to
-- one sense before the intersection is the KVP mistake this function exists
-- to not make. Elect the complete bias-token set in one batch.
bias AS (
    SELECT DISTINCT s.synset_id
    FROM lexical.senses_batch(ARRAY(
        SELECT DISTINCT r.tok FROM ranked r WHERE r.rk > 1)) s
    WHERE s.synset_id IS NOT NULL
),
-- The in-edge arm probes with = ANY(array), never a join. laplace.consensus is
-- LIST(type_id) with hash sub-partitions and this read constrains only
-- object_id, so no partition can be pruned: as a join the planner takes a full
-- index-only scan of EVERY partition and hash-joins, while the array form emits
-- one ScalarArrayOpExpr probe per bias id against
-- consensus_*_object_id_type_id_idx. A LATERAL rewrite is worse than the join.
-- ARRAY(SELECT ...) DELIBERATELY, not a CTE column. It reads like the worse form,
-- but the nesting is exactly what makes it fast: ARRAY(SELECT ...) is evaluated as
-- an InitPlan -- one sub-plan producing a BOUND CONSTANT array before the scan --
-- which lets the planner emit a ScalarArrayOp with runtime partition pruning. A CTE
-- column is a variable from a join, so the planner cannot bind it and falls back to
-- a join across the partition set. MEASURED here, identical 44,415 rows:
--   CROSS JOIN ids CTE, = ANY (ids.col)   14,299 ms
--   = ANY (ARRAY(SELECT ...))              3,342 ms
-- It is site-specific, not a rule: the same swap made taxonomy.bubble_up FASTER
-- (484.7ms -> 349.5ms). Measure before changing the shape either way.
biasfam AS (
    SELECT b.synset_id FROM bias b
    UNION
    SELECT c.subject_id FROM laplace.consensus c
    WHERE c.object_id = ANY (ARRAY(SELECT b2.synset_id FROM bias b2))
    UNION
    SELECT e.neighbour_id
    FROM consensus.edges_raw_batch(ARRAY(SELECT b2.synset_id FROM bias b2), 'in', NULL, 64, true, 'eff_mu') e
    WHERE e.neighbour_id IS NOT NULL
),
raw_cand AS (
    SELECT c.object_id AS id, max(consensus.eff_mu(c.rating, c.rd)) AS m
    FROM topic t
    JOIN laplace.consensus c ON c.subject_id IN (t.synset_id, t.tok)
    WHERE c.object_id IS NOT NULL
      AND (t.rel_type_id IS NULL OR c.type_id = t.rel_type_id)
    GROUP BY c.object_id
    UNION ALL
    SELECT e.neighbour_id AS id, max(consensus.eff_mu(e.rating, e.rd)) AS m
    FROM topic t
    CROSS JOIN LATERAL consensus.edges_raw_batch(
        ARRAY[t.synset_id, t.tok], 'out',
        CASE WHEN t.rel_type_id IS NULL THEN NULL ELSE ARRAY[t.rel_type_id] END,
        64, true, 'eff_mu') e
    WHERE e.neighbour_id IS NOT NULL
    GROUP BY e.neighbour_id
),
cand_ids AS MATERIALIZED (
    SELECT COALESCE(array_agg(rc.id ORDER BY rc.id), '{}'::bytea[]) AS ids
    FROM (SELECT DISTINCT id FROM raw_cand WHERE id IS NOT NULL) rc
),
cand_langs AS MATERIALIZED (
    SELECT DISTINCT l.word AS id
    FROM cand_ids ci
    CROSS JOIN LATERAL converse.word_language_candidates_batch(ci.ids) l
    WHERE l.lang IS NOT NULL
),
cand_members AS MATERIALIZED (
    SELECT DISTINCT kb.key AS id
    FROM cand_ids ci
    CROSS JOIN LATERAL converse.key_binding_evidence(ci.ids, NULL, false) kb
    UNION
    SELECT DISTINCT c.object_id AS id
    FROM cand_ids ci, laplace.v_consensus_unrefuted c
    WHERE c.object_id = ANY (ci.ids)
      AND c.type_id = ANY (consensus.relation_set_ids('PATH_LATERAL'))
      AND consensus.relation_canonical(c.type_id) IN ('IS_SYNONYM_OF', 'EVOKES_FRAME')
),
cand AS MATERIALIZED (
    SELECT rc.id, max(rc.m) AS m
    FROM (SELECT id, max(m) AS m FROM raw_cand GROUP BY id) rc
    WHERE EXISTS (SELECT 1 FROM cand_langs cl WHERE cl.id = rc.id)
       OR EXISTS (SELECT 1 FROM cand_members cm WHERE cm.id = rc.id)
    GROUP BY rc.id
),
cand_edges AS (
    SELECT d.id, c2.object_id
    FROM cand d
    JOIN laplace.consensus c2 ON c2.subject_id = d.id
    WHERE c2.object_id IS NOT NULL
    UNION
    SELECT e.subject_id AS id, e.neighbour_id AS object_id
    FROM consensus.edges_raw_batch(ARRAY(SELECT id FROM cand), 'out', NULL, 64, true, 'eff_mu') e
    WHERE e.neighbour_id IS NOT NULL
),
scored AS (
    SELECT d.id, d.m, count(f.synset_id) AS hits
    FROM cand d
    LEFT JOIN cand_edges ce ON ce.id = d.id
    LEFT JOIN biasfam f ON f.synset_id = ce.object_id
    GROUP BY d.id, d.m
    ORDER BY count(f.synset_id) DESC, d.m DESC, d.id
    LIMIT p_limit
),
ord AS (
    SELECT s.id, s.m, s.hits,
           row_number() OVER (ORDER BY s.hits DESC, s.m DESC, s.id) AS ix
    FROM scored s
),
lbl AS (
    SELECT ARRAY(SELECT lp_l.content FROM unnest((array_agg(o.id ORDER BY o.ix))::bytea[]) WITH ORDINALITY lp_u(x,n) LEFT JOIN (SELECT DISTINCT ON (lp_d.entity) lp_d.entity,lp_d.content FROM public.laplace_labels(array_remove((array_agg(o.id ORDER BY o.ix))::bytea[],NULL)::public.blake3[]) lp_d) lp_l ON lp_l.entity=lp_u.x::public.blake3 ORDER BY lp_u.n) AS l FROM ord o
),
named AS (
    SELECT lbl.l[o.ix] AS prediction, o.m / 1e9 AS weight, o.hits AS bias_hits, o.ix
    FROM ord o CROSS JOIN lbl
),
dedup AS (
    -- Two synset ids can realize to the same surface (hot→cold×2). Keep the
    -- strongest row per label so typed antonym reads don't double-emit.
    SELECT DISTINCT ON (n.prediction) n.prediction, n.weight, n.bias_hits, n.ix
    FROM named n
    WHERE n.prediction IS NOT NULL AND n.prediction <> ''
    ORDER BY n.prediction, n.bias_hits DESC, n.weight DESC, n.ix
)
SELECT d.prediction, d.weight, d.bias_hits
FROM dedup d
ORDER BY d.bias_hits DESC, d.weight DESC, d.ix;
END;
