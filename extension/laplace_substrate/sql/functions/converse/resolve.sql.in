-- converse.resolve — THE one string→id gateway (Issue 46): every read surface
-- resolves text to a content root through THIS function. Single words resolve by
-- the perfcache-backed word law; multi-token text by the native phrase resolver
-- (both in-system — ids are never constructed outside the extension's native hash).
-- Callers that already hold an id keep it; callers that hold TEXT call converse.resolve().
-- One implementation per fact (Rule #6): laplace.word_id/resolve_phrase remain the
-- primitives, this is the one door in front of them.
--
-- GH #862 / #860: no SET, real schema names.
DROP FUNCTION IF EXISTS laplace.resolve(text);
CREATE OR REPLACE FUNCTION converse.resolve(p_text text)
    RETURNS bytea
    LANGUAGE sql STABLE STRICT PARALLEL SAFE AS $$
    SELECT CASE
        WHEN position(' ' IN btrim(p_text)) = 0
            THEN laplace.word_id(btrim(p_text))
        ELSE converse.resolve_phrase(p_text)
    END
$$;
