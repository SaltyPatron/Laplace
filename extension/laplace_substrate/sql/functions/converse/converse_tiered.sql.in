-- converse.tiered(topic, lang, steps): compose a reply by walking the SENTENCE
-- tier, steered by the Glicko tuple. The replacement for word-level n-grams.
--
-- WHAT WAS WRONG WITH THE OLD PATH. converse_walk gathers <=160 sentences, then
-- at converse_walk.sql.in:93 filters `u.ctier = 2` -- every trajectory is
-- flattened to word tokens -- concatenates them into `stream bytea[]` plus a
-- scalar `w bigint[]` (topic weight 50/40/0), and hands both to
-- steered_walk_raw for trigram->bigram backoff. Once you are inside those two
-- flat arrays there is no relation type, no consensus.eff_mu/rd/witness_count, no highway
-- band, no tier, no geometry and no provenance. That is a Markov chain using
-- the substrate as a word list; the tier ladder and the rating math -- the whole
-- invention -- are discarded before the walk begins.
--
-- WHAT THIS DOES INSTEAD. The tier ladder says a word's usage lives in the tier
-- above it. So walk THERE:
--
--   UNITS    tier-3/4 sentences the topic is actually attested in -- its gloss
--            (definitional band), its HAS_EXAMPLE usages. Each unit carries the
--            full signed weight the walker ranks by everywhere else:
--            consensus.relation_rank x consensus.eff_mu x witness saturation. A consensus.refuted
--            edge goes negative and drops out on its own -- no floor.
--   CONCEPTS each unit's tier-2 realize.constituents lifted to their synsets. The tier
--            ladder is USED here (3 -> 2 -> concept), not collapsed to 2.
--   STEER    the next unit is the one whose concepts carry the most rated
--            consensus mass to the concepts already said. The graph does the
--            sequencing, at sentence grain, through the same consensus.eff_mu the rest of
--            the engine reads. This is "sequence proposes, meaning steers" with
--            the steering actually live per step rather than computed once.
--   REALIZE  each chosen unit renders VERBATIM. It is attested content and the
--            trajectory is exactly invertible, so a composed reply is a sequence
--            of things witnesses actually said -- every clause traceable to its
--            witnesses, which is what makes the reply explainable rather than
--            merely fluent.
--
-- Recombination happens at the sentence pivot instead of the trigram pivot. No
-- floors, no top-k beyond query LIMITs, no stoplist, no surface compare, no
-- language assumption: units are chosen by rating and by graph adjacency.
--
-- STATUS: RUN on the deployed extension, 2026-07-26, topic = pawn:
--   "it can be promoted to a more powerful piece if it reaches the 8th rank.
--    change a pawn for a better piece by advancing it to the eighth row, or
--    change a checker piece for a more valuable piece by moving it to the row
--    closest to your opponent. (chess) the least powerful piece."
-- Four separately-witnessed clauses, stepped by concept adjacency, on topic.
-- Wired into converse.chat() on the strength of that run. Two defects it exposed are
-- fixed below: subsumed-unit repetition and missing clause termination.
--
-- LANGUAGE: gated below by a constituent tally, since the sentence root carries
-- no HAS_LANGUAGE but the word tier carries 6.7M. Corrects an earlier note here
-- that claimed no read-side work could fix language mixing -- it can, one tier
-- down. Residual leak (shared scientific Latin) documented at the gate.
--
-- READ-ONLY (#878): no CREATE TEMP / CREATE INDEX. Working set lives in plpgsql
-- arrays so the MCP op lane (SQLSTATE 25006) and any read-only connection can
-- call this. Algorithm identical; only the scratch storage moved.
DROP FUNCTION IF EXISTS laplace.converse_tiered(bytea, bytea, int, int);
CREATE OR REPLACE FUNCTION converse.tiered(p_topic bytea,
                                           p_lang  bytea DEFAULT NULL,
                                           p_steps int DEFAULT 4,
                                           p_pool  int DEFAULT NULL)
    RETURNS text
    LANGUAGE plpgsql STABLE AS $$
-- NO NEUTRAL SUBTRACTION. consensus_adjacency's export weight uses
-- (consensus.eff_mu - neutral) so consensus.refuted edges sign-flip, and copying that here was a bug
-- caught before it shipped: consensus.eff_mu arrives in the fold's INTERNAL units (~1e12,
-- so Glicko 1500 is 1.5e12), and consensus.eff_mu = rating - 2*rd puts every honestly
-- weakly-witnessed edge BELOW neutral. Measured on pawn: the whole gloss family
-- sits at 1.17e12-1.37e12, i.e. Glicko 1170-1370. Subtracting neutral and
-- keeping w > 0 would have dropped every unit and fallen back to template prose
-- forever, silently. Rank by the walker's signed Glicko expectation of the
-- folded rating/RD state instead; no second witness saturation or RD decay is
-- applied after the fold.
DECLARE
    said     bytea[] := ARRAY[]::bytea[];   -- units already emitted, in order
    seen     bytea[] := ARRAY[]::bytea[];   -- concepts already said
    cur      bytea;
    parts    text[]  := ARRAY[]::text[];
    s        text;
    i        int;
    v_syn    bytea;
    u_id     bytea[];
    u_w      float8[];
    c_unit   bytea[];
    c_concept bytea[];
    said_realized text[];
    said_rendered text[];
BEGIN
    IF p_topic IS NULL THEN RETURN NULL; END IF;
    IF p_steps IS NULL THEN
        RAISE EXCEPTION 'converse.tiered: steps must not be NULL';
    END IF;
    IF p_steps < 0 OR p_pool < 0 THEN
        RAISE EXCEPTION 'converse.tiered: steps and pool must be >= 0 or NULL for the complete pool';
    END IF;
    IF p_steps = 0 OR p_pool = 0 THEN RETURN NULL; END IF;

    -- Topic may arrive as a word id (chat/MCP). Gloss/example edges hang on the
    -- synset; walking the word as subject empties the unit pool and degenerates
    -- to topic-echo (#878). Elect the best sense when one exists.
    SELECT s.synset_id INTO v_syn
    FROM lexical.senses(p_topic) s
    ORDER BY s.witnesses DESC, s.eff_mu DESC NULLS LAST, s.synset_id
    LIMIT 1;
    IF v_syn IS NOT NULL THEN
        p_topic := v_syn;
    END IF;

    -- UNITS + their weight. The topic's own attested sentences (gloss, examples).
    -- REMOVED: a structural.containers_of() arm over every sense-subject of the topic
    -- ("sentences the topic appears in"). Measured 2026-07-27, topic = dog:
    -- that arm alone ran >100s and never returned. The asserted arm costs 0.03s
    -- and is not short of material (45 tier-3 sentences for dog).
    SELECT coalesce(array_agg(x.id ORDER BY x.w DESC, x.id), ARRAY[]::bytea[]),
           coalesce(array_agg(x.w  ORDER BY x.w DESC, x.id), ARRAY[]::float8[])
    INTO u_id, u_w
    FROM (
        SELECT u.id, max(u.w) AS w
        FROM (
            SELECT c.object_id AS id,
                   consensus.relation_rank_resolved(c.type_id)
                     * consensus.eff_mu(c.rating, c.rd)::float8
                     * (c.witness_count::float8 / (1.0 + c.witness_count)) AS w
            FROM laplace.consensus c
            JOIN laplace.entities e ON e.id = c.object_id AND e.tier >= 3
            WHERE c.subject_id = p_topic
        ) u
        WHERE u.w > 0
        GROUP BY u.id
    ) x;

    IF coalesce(array_length(u_id, 1), 0) = 0 THEN RETURN NULL; END IF;

    -- An explicit caller pool cuts the rated order before the concept lift;
    -- NULL retains the complete population.
    IF p_pool IS NOT NULL AND array_length(u_id, 1) > p_pool THEN
        u_id := u_id[1:p_pool];
        u_w  := u_w[1:p_pool];
    END IF;

    -- CONCEPTS per unit: tier-2 realize.constituents lifted to synsets. SET-BASED,
    -- NOT PER WORD (taxonomy.top_synset per row hung at 73s for 48 dog units).
    -- Fence HAS_SENSE family once (incl. dynamic children via relation_in_family).
    SELECT coalesce(array_agg(q.unit ORDER BY q.unit, q.concept), ARRAY[]::bytea[]),
           coalesce(array_agg(q.concept ORDER BY q.unit, q.concept), ARRAY[]::bytea[])
    INTO c_unit, c_concept
    FROM (
        SELECT DISTINCT ON (p.id, tp.entity_id) p.id AS unit, sc.object_id AS concept
        FROM unnest(u_id) AS p(id)
        CROSS JOIN LATERAL generation.trajectory_unpacked_points(p.id) tp
        JOIN laplace.consensus sc ON sc.subject_id = tp.entity_id
        JOIN (
            SELECT e.id
            FROM laplace.entities e
            WHERE e.type_id = laplace.entity_type_id('RelationType')
              AND consensus.relation_in_family(e.id, 'HAS_SENSE')
        ) fam ON fam.id = sc.type_id
        WHERE tp.ctier = 2
        ORDER BY p.id, tp.entity_id, consensus.eff_mu(sc.rating, sc.rd) DESC, sc.object_id
    ) q;

    -- ANSWER IN THE LANGUAGE THAT WAS ASKED. Kept in HASH SPACE.
    -- A unit with no language evidence at all is KEPT, not dropped.
    -- Units with a winning language vote in another language drop; units with
    -- no language evidence stay (absence is not evidence of a foreign language).
    IF p_lang IS NOT NULL AND coalesce(array_length(c_unit, 1), 0) > 0 THEN
        SELECT coalesce(array_agg(u ORDER BY ord), ARRAY[]::bytea[]),
               coalesce(array_agg(w ORDER BY ord), ARRAY[]::float8[])
        INTO u_id, u_w
        FROM (
            SELECT u, w, ord
            FROM unnest(u_id, u_w) WITH ORDINALITY AS x(u, w, ord)
            WHERE NOT EXISTS (
                SELECT 1
                FROM (
                    SELECT DISTINCT ON (t.unit) t.unit, t.lg
                    FROM (
                        SELECT k.unit, lc.object_id AS lg, count(*) AS votes
                        FROM unnest(c_unit, c_concept) AS k(unit, concept)
                        JOIN laplace.consensus lc ON lc.subject_id = k.concept
                                         AND lc.type_id = laplace.relation_type_id('HAS_LANGUAGE')
                        GROUP BY k.unit, lc.object_id
                    ) t
                    ORDER BY t.unit, t.votes DESC, t.lg
                ) foreign_top
                WHERE foreign_top.unit = x.u AND foreign_top.lg <> p_lang
            )
        ) kept;

        SELECT coalesce(array_agg(cu ORDER BY cu, cc), ARRAY[]::bytea[]),
               coalesce(array_agg(cc ORDER BY cu, cc), ARRAY[]::bytea[])
        INTO c_unit, c_concept
        FROM unnest(c_unit, c_concept) AS k(cu, cc)
        WHERE cu = ANY (u_id);
    END IF;

    IF coalesce(array_length(u_id, 1), 0) = 0 THEN RETURN NULL; END IF;

    -- OPEN on the best-rated unit (arrays already ordered by w DESC, id).
    cur := u_id[1];

    FOR i IN 1..p_steps LOOP
        EXIT WHEN cur IS NULL;
        said := said || cur;
        seen := seen || ARRAY(
            SELECT cc FROM unnest(c_unit, c_concept) AS k(cu, cc) WHERE cu = cur);

        -- STEER BY SHARED CONCEPTS (intersection), edge mass as tiebreak.
        -- Two direction-pinned reads UNION ALL — never an OR join (#871 / #878).
        SELECT n.unit INTO cur
        FROM (
            SELECT k.unit,
                   count(*) AS shared,
                   COALESCE((
                       SELECT sum(consensus.relation_rank_resolved(c.type_id)
                                  * consensus.eff_mu(c.rating, c.rd)::float8)
                       FROM laplace.consensus c
                       WHERE c.subject_id = ANY (ARRAY(
                                 SELECT cc FROM unnest(c_unit, c_concept) AS x(cu, cc)
                                 WHERE cu = k.unit))
                         AND c.object_id = ANY(seen)
                   ), 0)
                   + COALESCE((
                       SELECT sum(consensus.relation_rank_resolved(c.type_id)
                                  * consensus.eff_mu(c.rating, c.rd)::float8)
                       FROM laplace.consensus c
                       WHERE c.object_id = ANY (ARRAY(
                                 SELECT cc FROM unnest(c_unit, c_concept) AS x(cu, cc)
                                 WHERE cu = k.unit))
                         AND c.subject_id = ANY(seen)
                   ), 0) AS pull
            FROM unnest(c_unit, c_concept) AS k(unit, concept)
            WHERE NOT (k.unit = ANY(said))
              AND k.concept = ANY(seen)
              AND EXISTS (
                  SELECT 1 FROM unnest(c_unit, c_concept) AS nk(unit, concept)
                   WHERE nk.unit = k.unit AND NOT (nk.concept = ANY(seen)))
            GROUP BY k.unit
        ) n
        JOIN LATERAL (
            SELECT u_w[array_position(u_id, n.unit)] AS w
        ) u ON true
        ORDER BY n.shared DESC, n.pull DESC, u.w DESC NULLS LAST, n.unit
        LIMIT 1;
    END LOOP;

    -- REALIZE verbatim, in walk order. Terminate each unit that does not already
    -- end in punctuation (clause seam, not content rewrite).
    said_realized := realize.batch(said, p_lang);
    said_rendered := realize.render_text_batch(said, 512);
    FOR i IN 1..COALESCE(array_length(said, 1), 0) LOOP
        s := btrim(COALESCE(said_realized[i], said_rendered[i]));
        IF s IS NOT NULL AND s <> '' THEN
            IF s !~ '[.!?;:,]$' THEN s := s || '.'; END IF;
            parts := parts || s;
        END IF;
    END LOOP;

    IF array_length(parts, 1) IS NULL THEN RETURN NULL; END IF;
    RETURN btrim(regexp_replace(array_to_string(parts, ' '), '\s+', ' ', 'g'));
END;
$$;
