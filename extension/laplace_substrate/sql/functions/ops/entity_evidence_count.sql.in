CREATE OR REPLACE FUNCTION ops._entity_evidence_counts_c(p_ids bytea[])
RETURNS TABLE(ordinal bigint,evidence bigint)
AS 'EXECUTION_LIBRARY', 'pg_laplace_entity_evidence_counts'
LANGUAGE C STABLE PARALLEL SAFE;

CREATE OR REPLACE FUNCTION ops.entity_evidence_counts(p_ids bytea[])
RETURNS TABLE(ordinal bigint,evidence bigint)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
SELECT ordinal, evidence FROM ops._entity_evidence_counts_c(p_ids);
END;

CREATE OR REPLACE FUNCTION ops.entity_evidence_count(p_subject bytea) RETURNS bigint
LANGUAGE sql STABLE
BEGIN ATOMIC
 SELECT evidence FROM ops.entity_evidence_counts(ARRAY[p_subject]);
END;

