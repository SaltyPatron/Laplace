        {
          "path": "",
          "literal": "ToUnicode"
        },
        {
          "path": "value()",
          "splitLast": "[], ",
          "side": "Each",
          "nested": true
        }
      ]
    },
    {
      "syntaxPath": "record/@toAsciiN",
      "propertyName": "toAsciiN",
      "valueKind": "Text",
      "disposition": "Testimony",
      "relationName": "NORMALIZES_TO",
      "qualifiers": [
        "mapping/ToASCII"
      ],
