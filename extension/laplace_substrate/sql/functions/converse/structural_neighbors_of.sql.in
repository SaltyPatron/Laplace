-- Entity-id keyed structural KNN with S³ coords (explore glome overlay).
-- Unlike structural.neighbors(text), does not re-resolve via prompt_state.
--
-- Shape axis: Frechet over REALIZED curves (entity_curve), never packed
-- laplace.physicalities.trajectory (Rule #3 / Issue 51).
-- GH #862 / #860: structural.neighbors_of, no SET, real schema names.
DROP FUNCTION IF EXISTS laplace.structural_neighbors_of(bytea, integer);
CREATE OR REPLACE FUNCTION structural.neighbors_of(
    p_id bytea,
    p_k  integer DEFAULT 10)
    RETURNS TABLE(
        neighbor_id bytea,
        neighbor    text,
        x           double precision,
        y           double precision,
        z           double precision,
        m           double precision,
        radius      double precision,
        geodesic    double precision,
        frechet     double precision)
    LANGUAGE plpgsql STABLE
    AS $sn$
DECLARE
    v_coord geometry;
    v_curve geometry;
BEGIN
    SELECT a.coord, structural.entity_curve(p_id)
      INTO v_coord, v_curve
    FROM structural.word_anchor(p_id) a;
    IF v_coord IS NULL OR public.laplace_direction_4d(v_coord) IS NULL THEN
        RETURN;
    END IF;

    RETURN QUERY
    WITH nearest AS (
        SELECT w.id AS entity_id, w.coord, w.radius_origin,
               public.laplace_angular_distance_4d(w.coord, v_coord) AS geo
        FROM laplace.v_word_points w
        WHERE w.id <> p_id
          AND public.laplace_direction_4d(w.coord) IS NOT NULL
        ORDER BY public.laplace_direction_4d(w.coord)
                 <<->> public.laplace_direction_4d(v_coord)
        LIMIT p_k),
    ordered AS (
        SELECT n.*, row_number() OVER (ORDER BY n.geo) AS ord
        FROM nearest n
    ),
    curves AS (
        -- Cache realized curves once per survivor (never rebuild inside Frechet).
        SELECT o.entity_id, o.coord, o.radius_origin, o.geo, o.ord,
               structural.entity_curve(o.entity_id) AS curve
        FROM ordered o
    ),
    labels AS (
        -- Full-mesh resolution via ONE realize_batch over the <= p_k survivors
        -- (was: scalar realize per neighbour): synset/ILI hubs resolve through
        -- the name/synset-lemma/translation arms to the real word; hex stays
        -- only as the genuine last resort so the node still plots.
        SELECT realize.batch(array_agg(c.entity_id ORDER BY c.ord)) AS l
        FROM curves c
    )
    SELECT c.entity_id,
           COALESCE(NULLIF(labels.l[c.ord], ''), left(encode(c.entity_id, 'hex'), 16)),
           ST_X(c.coord), ST_Y(c.coord), ST_Z(c.coord), ST_M(c.coord),
           c.radius_origin,
           c.geo,
           CASE WHEN c.curve IS NOT NULL AND v_curve IS NOT NULL
                THEN public.laplace_frechet_4d(c.curve, v_curve) END
    FROM curves c, labels
    ORDER BY c.ord;
END;
$sn$;
