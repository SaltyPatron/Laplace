-- converse.about(syn, lang): the REALIZE half of converse.converse() -- weave prose for an
-- ALREADY-RESOLVED topic synset. Internal seam so callers that have already
-- oriented (converse.chat() resolves its topic once per turn) do not pay converse.converse()'s
-- prompt re-segmentation + band-mass re-orientation just to describe a synset
-- they hold in hand.
--
-- The facts come from converse.facts() -- the walk-driven fact engine (native
-- beam walk for the taxonomy chain, ranked consensus for the listings), each
-- row carrying provenance (consensus.eff_mu, witnesses, path). This wrapper is prose-only:
-- callers that want the provenance columns query converse_facts directly. The
-- 'web' arrow-chain row is a drill-down surface, not prose -- excluded here.
DROP FUNCTION IF EXISTS laplace.converse_about(bytea, bytea);
CREATE OR REPLACE FUNCTION converse.about(p_syn bytea,
                                          p_lang bytea,
                                          p_part_limit int,
                                          p_kin_limit int)
    RETURNS text
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT CASE
        WHEN p_syn IS NULL THEN NULL::text
        ELSE btrim(COALESCE(
            (SELECT string_agg(f.sentence, ' ' ORDER BY f.ord)
             FROM converse.facts(p_syn, p_lang, p_part_limit, p_kin_limit)
                  WITH ORDINALITY AS f(fact_kind, sentence, eff_mu, witnesses, path, types, ord)
             WHERE f.fact_kind <> 'web'),
            (SELECT 'The concept ' || lbl || ' is one I hold.'
             FROM (SELECT realize.realize(p_syn, p_lang) AS lbl) r
             WHERE r.lbl IS NOT NULL),
            ''))
    END;
END;

-- Existing prose surface preserves dependency identity while delegating to
-- the one capacity-aware implementation. Omitted listing capacities are exact.
CREATE OR REPLACE FUNCTION converse.about(p_syn bytea, p_lang bytea DEFAULT NULL)
    RETURNS text
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT converse.about(p_syn, p_lang, NULL, NULL);
END;
