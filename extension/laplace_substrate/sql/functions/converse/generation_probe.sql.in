-- The W5 seed-variance probe as an installed surface: run both generation
-- lanes (incumbent converse_walk, challenger converse_compose) over a prompt
-- and a seed set, one row per (lane, seed). This is the measurement
-- converse_compose's header gates wiring on — "different text for different
-- seeds (recombination rather than replay), on topic" — made repeatable per
-- seed wave instead of living as ad-hoc operator SQL. Distinctness is then
-- count(DISTINCT reply) per lane over this table; topicality is read against
-- the topic's own consensus by the caller.
DROP FUNCTION IF EXISTS laplace.generation_probe(text, bigint[], int, bytea);
CREATE OR REPLACE FUNCTION generation.probe(p_prompt text,
                                            p_seeds bigint[],
                                            p_steps int DEFAULT 30,
                                            p_lang bytea DEFAULT NULL)
    RETURNS TABLE(lane text, seed bigint, reply text)
    LANGUAGE sql VOLATILE AS $$
    SELECT 'walk', b.seed, b.reply
    FROM generation.walk_batch(p_prompt, p_steps, p_seeds) b
    UNION ALL
    SELECT 'compose', b.seed, b.reply
    FROM generation.compose_batch(p_prompt, p_steps, p_lang, p_seeds) b
$$;
