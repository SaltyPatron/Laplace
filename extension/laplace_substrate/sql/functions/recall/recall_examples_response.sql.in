CREATE OR REPLACE FUNCTION converse.recall_examples_response(p_topic bytea)
    RETURNS TABLE(reply text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH topic AS MATERIALIZED (SELECT (SELECT lp_l.content FROM public.laplace_labels(array_remove(ARRAY[(p_topic)::bytea],NULL)::public.blake3[]) lp_l) AS label)
    SELECT replace(e.example, '%s', t.label), e.eff_mu, e.witnesses
    FROM lexical.examples(p_topic) e CROSS JOIN topic t;
END;
