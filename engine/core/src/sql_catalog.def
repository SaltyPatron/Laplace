SQL_QUERY("structural.nearest_neighbors_4d", "text,int4",
    "SELECT neighbor, geodesic, frechet FROM structural.nearest_neighbors_4d($1, $2)")

SQL_QUERY("ops.consensus_out_readable_batch", "bytea[],int4",
    "SELECT u.ord, r.type, r.object, r.eff_mu, r.witnesses\nFROM unnest($1::bytea[]) WITH ORDINALITY AS u(id, ord)\nCROSS JOIN LATERAL ops.consensus_out_readable(u.id, $2)\n    WITH ORDINALITY AS r(type, object, eff_mu, witnesses, rord)\nORDER BY u.ord, r.rord")

SQL_QUERY("inspection.explore_resolve", "text",
    "WITH resolved AS (\n    SELECT CASE\n        WHEN $1 ~ '^[0-9a-f]{32}$' THEN decode($1, 'hex')\n        ELSE COALESCE(lexical.concept_ref($1), laplace.word_id($1))\n    END AS id,\n    CASE\n        WHEN $1 ~ '^[0-9a-f]{32}$' THEN 'hex'\n        WHEN lexical.concept_ref($1) IS NOT NULL THEN 'concept'\n        WHEN laplace.word_id($1) IS NOT NULL THEN 'word'\n        ELSE 'not_found'\n    END AS ref_kind\n)\nSELECT r.id, converse.label_or_hex(r.id), r.ref_kind,\n       consensus.entity_exists(r.id) AS exists\nFROM resolved r\nWHERE r.id IS NOT NULL")

SQL_QUERY("structural.explore_anchor_neighbors", "float8,float8,float8,float8,text,int4,int4,float8",
    "SELECT n.axis, encode(n.entity_id, 'hex'), n.label, n.tier, n.geodesic, n.frechet\nFROM structural.explore_anchor_neighbors(\n    $1, $2, $3, $4, $5, $6, $7, $8) n")

SQL_QUERY("ops.witnessed_words", "text[]",
    "WITH c AS (\n    SELECT s, laplace.word_id(s) AS id\n    FROM unnest($1) AS s\n)\nSELECT c.s, encode(c.id, 'hex'),\n       ops.evidence_count(NULL, NULL, c.id)\nFROM c\nWHERE consensus.entity_exists(c.id)")

SQL_QUERY("structural.neighbors_of", "bytea,int4",
    "SELECT encode(n.neighbor_id, 'hex'), n.neighbor,\n       n.geodesic, n.frechet, n.x, n.y, n.z, n.m, n.radius\nFROM structural.neighbors_of($1, $2) n")

SQL_QUERY("lexical.concept_members_rendered", "bytea,int4",
    "SELECT encode(m.member, 'hex'), m.kind,\n       COALESCE(NULLIF(realize.render_text_fast(m.member, 8), ''),\n                converse.label_or_hex(m.member)), m.mu, m.witnesses\nFROM lexical.concept_members($1) m\nORDER BY m.mu DESC NULLS LAST, m.member\nLIMIT $2")

SQL_QUERY("lexical.concept_peers", "bytea,int4",
    "SELECT peer, kind, strength FROM lexical.concept_peers($1, $2)")

SQL_QUERY("lexical.word_peer_ids_batch", "bytea[],int4",
    "SELECT word_id, peer_id, strength FROM lexical.word_peer_ids_batch($1, $2)")

SQL_QUERY("consensus.completions_rendered", "text,int4",
    "SELECT\n    encode(c.object_id, 'hex') AS object_id_hex,\n    encode(c.type_id, 'hex') AS type_id_hex,\n    c.eff_mu,\n    c.witnesses,\n    converse.label_or_hex(c.object_id) AS object_label\nFROM consensus.completions(converse.resolve($1), $2) c\nORDER BY c.eff_mu DESC")

SQL_QUERY("ops.evidence_counts_batch", "bytea[]",
    "SELECT u.ord, ops.evidence_count(NULL, NULL, u.id)\nFROM unnest($1::bytea[]) WITH ORDINALITY AS u(id, ord)")

SQL_QUERY("consensus.walk_branches_rendered", "text,int4,int4",
    "SELECT\n    gt.depth,\n    ARRAY(SELECT encode(x, 'hex') FROM unnest(gt.path) AS u(x)) AS path_hex,\n    ARRAY(SELECT encode(x, 'hex') FROM unnest(gt.types) AS u(x)) AS type_path_hex,\n    encode(gt.entity_id, 'hex') AS entity_id_hex,\n    converse.label_or_hex(gt.entity_id) AS entity_label,\n    gt.eff_mu,\n    gt.path_mu,\n    gt.witnesses\nFROM consensus.walk_branches(converse.resolve($1), NULL, $2, $3) gt\nORDER BY gt.depth, gt.path_mu DESC")

SQL_QUERY("ops.attestations_out_batch", "bytea[],int4",
    "SELECT u.ord,\n    encode(a.type_id, 'hex'),\n    encode(a.object_id, 'hex'),\n    encode(a.source_id, 'hex'),\n    CASE WHEN a.context_id IS NULL THEN NULL ELSE encode(a.context_id, 'hex') END,\n    a.outcome,\n    a.observation_count\nFROM unnest($1::bytea[]) WITH ORDINALITY AS u(id, ord)\nCROSS JOIN LATERAL ops.attestations_out(u.id, $2)\n    WITH ORDINALITY AS a(type_id, object_id, source_id, context_id, outcome, observation_count, aord)\nORDER BY u.ord, a.aord")

SQL_QUERY("ops.evidence_for_target", "text,int4",
    "WITH resolved AS (\n    SELECT converse.resolve_ref($1) AS id\n)\nSELECT\n    r.id,\n    CASE\n        WHEN $1 ~ '^[0-9a-f]{32}$' THEN COALESCE(\n            NULLIF(realize.render_text_fast(r.id, 8), ''),\n            'Unrealized entity')\n        ELSE $1\n    END,\n    encode(e.type_id, 'hex'),\n    e.type_label,\n    encode(e.object_id, 'hex'),\n    e.object_label,\n    e.source_labels,\n    e.witness_count,\n    e.eff_mu\nFROM resolved r\nLEFT JOIN LATERAL ops.evidence_receipt(r.id, $2) e ON true\nWHERE r.id IS NOT NULL")

SQL_QUERY("inspection.embedding_lookup", "text,int4,bool,text[]",
    "WITH resolved AS (\n    SELECT converse.resolve_ref($1) AS id\n),\ndirect_meaning AS (\n    SELECT sf.type AS rel, sf.fact AS obj, sf.eff_mu, sf.witnesses, sf.ord\n    FROM resolved r\n    CROSS JOIN LATERAL consensus.salient_facts(r.id, NULL, $2)\n        WITH ORDINALITY AS sf(type, fact, eff_mu, witnesses, ord)\n    WHERE $3 AND r.id IS NOT NULL\n    UNION ALL\n    SELECT 'PEER'::text AS rel, cp.peer AS obj, round(cp.strength::numeric, 1) AS eff_mu, 1::bigint AS witnesses, (100 + cp.ord) AS ord\n    FROM resolved r\n    CROSS JOIN LATERAL lexical.concept_peers(r.id, GREATEST(4, $2 / 2))\n        WITH ORDINALITY AS cp(peer, kind, strength, ord)\n    WHERE $3 AND r.id IS NOT NULL\n),\nfallback_direct AS (\n    SELECT m.type AS rel, m.object AS obj, m.eff_mu, m.witnesses, (200 + m.ord) AS ord\n    FROM resolved r\n    CROSS JOIN LATERAL ops.consensus_out_readable(r.id, $2)\n        WITH ORDINALITY AS m(type, object, eff_mu, witnesses, ord)\n    WHERE $3 AND r.id IS NOT NULL\n      AND NOT EXISTS (SELECT 1 FROM direct_meaning)\n),\nconstituent_meaning AS (\n    SELECT (u.term || ':' || sf.type) AS rel, sf.fact AS obj, sf.eff_mu, sf.witnesses, (u.tord * 100 + sf.sord) AS ord\n    FROM resolved r\n    CROSS JOIN LATERAL unnest(COALESCE($4, ARRAY[]::text[])) WITH ORDINALITY AS u(term, tord)\n    CROSS JOIN LATERAL (SELECT converse.resolve_ref(u.term) AS wid) w\n    CROSS JOIN LATERAL consensus.salient_facts(w.wid, NULL, GREATEST(2, $2 / GREATEST(1, COALESCE(array_length($4, 1), 1))))\n        WITH ORDINALITY AS sf(type, fact, eff_mu, witnesses, sord)\n    WHERE $3 AND r.id IS NULL AND w.wid IS NOT NULL\n),\nall_meaning AS (\n    SELECT rel, obj, eff_mu, witnesses, ord FROM (\n        SELECT rel, obj, eff_mu, witnesses, ord FROM direct_meaning\n        UNION ALL\n        SELECT rel, obj, eff_mu, witnesses, ord FROM fallback_direct\n        UNION ALL\n        SELECT rel, obj, eff_mu, witnesses, ord FROM constituent_meaning\n    ) combined\n    ORDER BY ord\n    LIMIT $2\n)\nSELECT 0 AS kind, 0::bigint AS ord, r.id AS eid,\n       f.x, f.y, f.z, f.m, f.radius, f.n_constituents,\n       NULL::text, NULL::text, NULL::numeric, NULL::bigint\nFROM resolved r\nLEFT JOIN LATERAL (\n    SELECT x, y, z, m, radius, n_constituents\n    FROM ops.entity_physicalities(r.id)\n    ORDER BY type\n    LIMIT 1\n) f ON true\nUNION ALL\nSELECT 1 AS kind, m.ord, r.id,\n       NULL::float8, NULL::float8, NULL::float8, NULL::float8, NULL::float8, NULL::int,\n       m.rel, m.obj, m.eff_mu, m.witnesses\nFROM resolved r\nCROSS JOIN all_meaning m\nORDER BY kind, ord")

SQL_QUERY("consensus.top_relations_rendered", "int4",
    "WITH t AS MATERIALIZED (\n    SELECT r.subject_id, r.type_id, r.object_id, r.eff_mu, r.witnesses,\n           row_number() OVER () AS ord\n    FROM consensus.top_relations($1) r\n),\nids AS MATERIALIZED (\n    SELECT array_agg(v.id ORDER BY t.ord, v.slot) AS a\n    FROM t\n    CROSS JOIN LATERAL (VALUES (t.subject_id, 1), (t.object_id, 2)) AS v(id, slot)\n),\nrel AS MATERIALIZED (\n    SELECT d.type_id,\n           COALESCE(NULLIF(consensus.relation_canonical(d.type_id), ''),\n                    converse.label_or_hex(d.type_id)) AS relation\n    FROM (SELECT DISTINCT t.type_id FROM t) d\n),\nlbl AS MATERIALIZED (\n    SELECT realize.batch(ids.a, NULL) AS l FROM ids\n)\nSELECT\n    encode(t.subject_id, 'hex') AS subject_id_hex,\n    COALESCE(lbl.l[(t.ord - 1) * 2 + 1], converse.label_or_hex(t.subject_id)) AS subject_label,\n    encode(t.type_id, 'hex') AS type_id_hex,\n    rel.relation AS type_label,\n    encode(t.object_id, 'hex') AS object_id_hex,\n    COALESCE(lbl.l[(t.ord - 1) * 2 + 2], converse.label_or_hex(t.object_id)) AS object_label,\n    t.eff_mu,\n    t.witnesses\nFROM t\nJOIN rel ON rel.type_id = t.type_id\nCROSS JOIN lbl\nORDER BY t.ord")

SQL_QUERY("lexical.senses_rendered", "bytea",
    "SELECT encode(s.sense_id, 'hex'), encode(s.synset_id, 'hex'),\n       COALESCE(\n           NULLIF(realize._synset_lemma(s.synset_id, converse.word_language($1)), ''),\n           NULLIF(realize.render_text_fast(s.synset_id, 8), ''),\n           'Unrealized sense'),\n       s.eff_mu, s.witnesses\nFROM lexical.senses($1) s")

SQL_QUERY("realize.constituents_rendered", "bytea",
    "SELECT c.ordinal, encode(c.child_id, 'hex'), c.run_length, c.flags,\n       COALESCE(\n           NULLIF(realize.render_text_fast(c.child_id, 8), ''),\n           'Unrealized entity')\nFROM realize.constituents($1) c")

SQL_QUERY("inspection.packed_trajectory_vertices", "bytea",
    "SELECT u.ordinal,\n       public.ST_X(dp.geom), public.ST_Y(dp.geom),\n       public.ST_Z(dp.geom), public.ST_M(dp.geom),\n       encode(u.entity_id, 'hex'),\n       GREATEST(u.run_length, 1),\n       u.flags\nFROM (\n    SELECT w.trajectory\n    FROM laplace.v_word_points w\n    WHERE w.id = $1 AND w.trajectory IS NOT NULL\n    LIMIT 1\n) t,\n     LATERAL public.ST_DumpPoints(t.trajectory) dp,\n     LATERAL public.laplace_mantissa_unpack(dp.geom) u\nORDER BY u.ordinal")

SQL_QUERY("inspection.realized_trajectory_vertices", "bytea",
    "SELECT c.ordinal,\n       public.ST_X(p.coord), public.ST_Y(p.coord),\n       public.ST_Z(p.coord), public.ST_M(p.coord),\n       encode(c.child_id, 'hex'),\n       COALESCE(\n           NULLIF(realize.render_text_fast(c.child_id, 8), ''),\n           'Unrealized entity'),\n       p.radius_origin\nFROM realize.constituents($1) c\nJOIN laplace.physicalities p\n  ON p.entity_id = c.child_id AND p.type = 1\nWHERE p.coord IS NOT NULL\nORDER BY c.ordinal")

SQL_QUERY("consensus.explore_web_rendered", "bytea,int4,int4,int4",
    "SELECT encode(w.source_id, 'hex'), encode(w.type_id, 'hex'), encode(w.object_id, 'hex'),\n       w.hop, consensus.eff_mu(w.rating, w.rd), w.witness_count,\n       consensus.walk_edge_weight(w.rating, w.rd),\n       consensus.refuted(w.rating, w.rd)\nFROM consensus.explore_web($1, $2, $3, $4) w")

SQL_QUERY("consensus.explore_induced_edges_rendered", "bytea[]",
    "SELECT encode(e.source_id, 'hex'), encode(e.type_id, 'hex'), encode(e.object_id, 'hex'),\n       e.rating::numeric / 1000000000::numeric,\n       e.rd::numeric / 1000000000::numeric,\n       e.volatility::numeric / 1000000000::numeric,\n       consensus.eff_mu(e.rating, e.rd),\n       e.witness_count,\n       consensus.walk_edge_weight(e.rating, e.rd),\n       consensus.refuted(e.rating, e.rd)\nFROM consensus.explore_induced_edges($1) e")

SQL_QUERY("realize.labels_fast", "bytea[]",
    "WITH inp AS MATERIALIZED (\n    SELECT x.id, x.ord, e.tier\n    FROM unnest($1::bytea[]) WITH ORDINALITY AS x(id, ord)\n    LEFT JOIN laplace.entities e ON e.id = x.id\n), names AS MATERIALIZED (\n    SELECT realize.resolve_name_batch($1::bytea[]) AS labels\n), shallow_ids AS MATERIALIZED (\n    SELECT COALESCE(\n               array_agg(i.id ORDER BY i.ord) FILTER (WHERE i.tier <= 3),\n               '{}'::bytea[]) AS ids\n    FROM inp i\n), shallow_labels AS MATERIALIZED (\n    SELECT s.ids, realize.render_text_batch(s.ids, 3) AS labels\n    FROM shallow_ids s\n), shallow AS MATERIALIZED (\n    SELECT s.ids[n] AS id, s.labels[n] AS label\n    FROM shallow_labels s,\n         generate_subscripts(s.ids, 1) AS n\n)\nSELECT encode(i.id, 'hex'),\n       COALESCE(\n           NULLIF(n.name, ''),\n           NULLIF(names.labels[i.ord], ''),\n           NULLIF(shallow.label, '')),\n       i.tier\nFROM inp i\nCROSS JOIN names\nLEFT JOIN shallow ON shallow.id = i.id\nLEFT JOIN laplace.canonical_names n ON n.id = i.id\nORDER BY i.ord")

SQL_QUERY("consensus.edges_raw", "bytea,text,bytea[],int4,bool,text",
    "SELECT e.direction, e.type_id, e.neighbour_id,\n       e.rating, e.rd, e.witness_count\nFROM consensus.edges_raw($1, $2, $3, $4, $5, $6) e")

SQL_QUERY("consensus.best_outbound_by_subjects", "bytea[],bytea,bool",
    "SELECT s.id, e.neighbour_id,\n       consensus.eff_mu_display(e.rating, e.rd),\n       e.witness_count\nFROM unnest($1::bytea[]) AS s(id)\nCROSS JOIN LATERAL consensus.edges_raw(\n    s.id, 'out', ARRAY[$2]::bytea[], 1, $3, 'eff_mu') e")

SQL_QUERY("converse.translations", "text,int4",
    "SELECT t.translation, t.language, t.eff_mu, t.witnesses\nFROM converse.translations(converse.resolve_ref($1), $2) t")

SQL_QUERY("consensus.walk_branches_for_prompt", "text,text,text,int4,int4",
    "WITH node AS (SELECT CASE WHEN $2 IS NULL THEN converse.resolve($1)\n                          ELSE decode($2, 'hex') END AS id)\nSELECT w.depth,\n       realize.path(w.path, w.types) AS path,\n       w.eff_mu, w.path_mu, w.witnesses\nFROM node, consensus.walk_branches(\n         node.id,\n         CASE WHEN $3 IS NULL THEN NULL ELSE laplace.relation_type_id($3) END,\n         $4, $5) w\nORDER BY w.depth, w.path_mu DESC")

SQL_QUERY("ops.api_catalog", "text",
    "SELECT name, args, returns, kind FROM ops.api($1) ORDER BY name, args")

SQL_QUERY("consensus.band_facts", "bytea,int4[],int4",
    "WITH requested_bands AS MATERIALIZED (\n    SELECT b.band, b.name, b.rank,\n           laplace.relation_band_types(b.band) AS type_ids\n    FROM converse.relation_band_catalog() b\n    WHERE $2::int[] IS NULL OR b.band = ANY($2::int[])\n), ranked AS MATERIALIZED (\n    SELECT b.name, b.rank, z.*\n    FROM requested_bands b\n    CROSS JOIN LATERAL consensus.edges_raw(\n        $1, 'both', b.type_ids, $3, true, 'eff_mu') z\n)\nSELECT z.name || ' · ' || consensus.relation_canonical(z.type_id)\n         || CASE z.direction WHEN 'in' THEN ' ← ' ELSE ' → ' END\n         || converse.label_or_hex(z.neighbour_id) AS reply,\n       consensus.eff_mu_display(z.rating, z.rd) AS eff_mu,\n       z.witness_count\nFROM ranked z\nORDER BY z.rank DESC,\n         consensus.eff_mu(z.rating, z.rd) DESC,\n         z.neighbour_id,\n         z.type_id,\n         CASE z.direction WHEN 'out' THEN 0 ELSE 1 END\nLIMIT $3")

SQL_QUERY("consensus.walk_strongest_rendered", "bytea,int4",
    "SELECT converse.label_or_hex(w.entity_id)\n         || ' (' || consensus.relation_canonical(w.type_id) || ')' AS reply,\n       w.eff_mu, NULL::bigint\nFROM consensus.walk_strongest($1, NULL, $2) w\nORDER BY w.step")

SQL_QUERY("consensus.walk_branches_beam", "bytea,text,int4[],int4,int4,int4",
    "WITH mask AS (\n    SELECT CASE WHEN $3::int[] IS NULL THEN NULL\n                ELSE consensus.highway_mask_from_bits(\n                         (SELECT array_agg(DISTINCT bit)\n                          FROM unnest($3::int[]) AS b(band),\n                               LATERAL unnest(consensus.highway_mask_bits(\n                                   consensus.highway_band_mask(b.band))) AS t(bit)))\n           END AS m\n)\nSELECT repeat('  ', w.depth) || realize.path(w.path, w.types) AS reply,\n       w.path_mu, w.witnesses\nFROM mask, consensus.walk_branches(\n         $1,\n         CASE WHEN $2::text IS NULL THEN NULL\n              ELSE laplace.relation_type_id($2::text) END,\n         $4, $5, mask.m) w\nORDER BY w.path_mu DESC\nLIMIT $6")

SQL_QUERY("converse.astar_path_rendered", "bytea,bytea,int4,bool,bool",
    "SELECT repeat('  ', p.step) || converse.label_or_hex(p.entity_id) AS reply,\n       p.g::numeric, NULL::bigint\nFROM converse.astar_path($1, ARRAY[$2]::bytea[], $3, NULL,\n                        $4, $5) p\nORDER BY p.step")

SQL_QUERY("generation.walk_continuations_rendered", "bytea,int4,int4,float8,int4,int8",
    "SELECT converse.label_or_hex(w.entity) AS reply, NULL::numeric, NULL::bigint\nFROM generation.walk_continuations(ARRAY[$1]::bytea[], $2, $3,\n                                $4, $5, $6) w\nORDER BY w.step")

SQL_QUERY("chess.ranked", "int4,int4,text,text",
    "SELECT rank, encode(player_id, 'hex'), name, games, rating, rd, eff_mu\nFROM chess.ranked($1, $2, $3, $4)")

SQL_QUERY("chess.players_by_initial", "text[],int4,int4,text,text",
    "SELECT encode(player_id, 'hex'), name, games, rating, rd, eff_mu\nFROM chess.players_by_initial($1, $2, $3, $4, $5)")

SQL_QUERY("chess.find_player", "text",
    "WITH p AS (SELECT chess.player_id($1) AS id)\nSELECT encode(p.id, 'hex'), converse.label_or_hex(p.id),\n       COALESCE(o.witness_count, 0),\n       round((COALESCE(o.rating, consensus.glicko2_neutral_mu()) / 1e9)::numeric, 3)::double precision,\n       round((COALESCE(o.rd, consensus.glicko2_initial_rd()) / 1e9)::numeric, 3)::double precision,\n       consensus.eff_mu_display(\n           COALESCE(o.rating, consensus.glicko2_neutral_mu()),\n           COALESCE(o.rd, consensus.glicko2_initial_rd()))::double precision\nFROM p\nJOIN laplace.entities pe\n  ON pe.id = p.id\n AND pe.type_id = laplace.entity_type_id('Chess_Player')\nLEFT JOIN LATERAL consensus.edges_raw(\n    p.id, 'out',\n    ARRAY[laplace.relation_type_id('OUTCOME')],\n    1, true, 'eff_mu') o ON true")

SQL_QUERY("chess.player_record", "bytea",
    "SELECT as_white, games, wins, draws, losses, unscored, score\nFROM chess.player_record($1)")

SQL_QUERY("chess.player_ratings", "bytea",
    "SELECT rating, games FROM chess.player_ratings($1)")

SQL_QUERY("chess.player_profile_edges_rendered", "bytea",
    "WITH profile AS MATERIALIZED (\n    SELECT p.*,\n           row_number() OVER (\n               ORDER BY p.subject_id, p.type_id, p.object_id) AS rn\n    FROM chess.player_profile_edges($1) p\n), rendered AS MATERIALIZED (\n    SELECT realize.render_batch(array_agg(type_id ORDER BY rn)) AS relations,\n           realize.render_batch(array_agg(object_id ORDER BY rn)) AS values\n    FROM profile\n)\nSELECT encode(p.subject_id, 'hex'),\n       r.relations[p.rn::integer], r.values[p.rn::integer]\nFROM profile p\nCROSS JOIN rendered r\nORDER BY p.rn")

SQL_QUERY("chess.head_to_head", "bytea,int4",
    "SELECT encode(opponent_id, 'hex'), opponent, games, rating, rd, eff_mu\nFROM chess.head_to_head($1, $2)")

SQL_QUERY("chess.player_games", "bytea,int4,int4",
    "SELECT encode(event_id, 'hex'), played_on, event, eco, as_white,\n       encode(opponent_id, 'hex'), opponent, result, outcome\nFROM chess.player_games($1, $2, $3)")

SQL_QUERY("chess.game", "bytea",
    "SELECT encode(white_id, 'hex'), white, encode(black_id, 'hex'), black,\n       result, played_on, event, eco, termination, time_control,\n       tc_class\nFROM chess.game($1)")

SQL_QUERY("generation.content_trajectory_constituents", "bytea[]",
    "SELECT d.id, p.entity_id, p.ordinal::integer\nFROM generation.typed_trajectory_points($1, ARRAY[1::smallint]) p\nJOIN unnest($1) d(id) ON d.id = p.parent_id\nORDER BY d.id, p.ordinal")

SQL_QUERY("generation.typed_trajectory_constituents", "bytea[],int2[]",
    "SELECT d.id, lane.type, p.entity_id, p.ordinal::integer\nFROM generation.typed_trajectory_points($1, $2) p\nJOIN unnest($1) d(id) ON d.id = p.parent_id\nJOIN unnest($2) lane(type) ON lane.type = p.physicality_type\nORDER BY d.id, lane.type, p.ordinal")

SQL_QUERY("generation.nested_trajectory_constituents", "bytea[]",
    "SELECT d.id, a.ord::integer, a.entity_id, f.ord::integer, f.entity_id\nFROM unnest($1) AS d(id)\nCROSS JOIN LATERAL generation.trajectory_unpacked_points(d.id)\n     WITH ORDINALITY AS a(entity_id, run_length, ctier, ord)\nCROSS JOIN LATERAL generation.trajectory_unpacked_points(a.entity_id)\n     WITH ORDINALITY AS f(entity_id, run_length, ctier, ord)\nORDER BY d.id, a.ord, f.ord")

SQL_QUERY("ops.entity_counts_by_types", "bytea[]",
    "SELECT type_id, entities FROM ops.entity_counts_by_types($1)")

SQL_QUERY("inspection.trajectory_tree_dump_points", "bytea",
    "WITH RECURSIVE tree(id) AS (\n    SELECT $1\n    UNION\n    SELECT unnest(public.laplace_trajectory_constituent_ids(w.trajectory))\n    FROM tree t\n    JOIN laplace.v_word_points w\n      ON w.id = t.id AND w.trajectory IS NOT NULL\n)\nSELECT w.id, w.n_constituents, (g.path)[1],\n       ST_X(g.geom), ST_Y(g.geom), ST_Z(g.geom), ST_M(g.geom)\nFROM laplace.v_word_points w\nJOIN tree t ON t.id = w.id\nCROSS JOIN LATERAL ST_DumpPoints(w.trajectory) AS g\nWHERE w.trajectory IS NOT NULL")

SQL_QUERY("chess.move_entities", "bytea",
    "SELECT e.id, public.laplace_trajectory_constituent_ids(p.trajectory)\nFROM laplace.entities e\nJOIN laplace.physicalities p\n  ON p.entity_id = e.id AND p.type = 1 AND p.trajectory IS NOT NULL\nWHERE e.type_id = $1")

SQL_QUERY("chess.learned_moves_atoms", "int4",
    "SELECT lm.plays, lm.mover_score,\n       public.laplace_trajectory_constituent_ids(p.trajectory)\nFROM chess.learned_moves($1) lm\nJOIN laplace.physicalities p\n  ON p.entity_id = lm.move_id AND p.type = 1 AND p.trajectory IS NOT NULL")

SQL_QUERY("chess.moves", "bytea,int4",
    "SELECT next_position, eff_mu, rd, witness_count\nFROM chess.moves($1, $2)")

SQL_QUERY("chess.player_moves", "bytea,bytea,bool,int4",
    "SELECT next_position, games, score\nFROM chess.player_moves($1, $2, $3, $4)")

SQL_QUERY("chess.opening_catalog", "bytea,bytea,bytea",
    "WITH named AS MATERIALIZED (\n    SELECT n.subject_id AS line_id,\n           n.object_id AS name_id,\n           e.object_id AS eco_id,\n           consensus.eff_mu(c.rating, c.rd) AS rank\n    FROM laplace.attestations n\n    LEFT JOIN laplace.attestations e\n           ON e.subject_id = n.subject_id\n          AND e.type_id    = $2\n          AND e.source_id  = $3\n    LEFT JOIN laplace.consensus c\n           ON c.subject_id = n.subject_id\n          AND c.type_id    = n.type_id\n          AND c.object_id  = n.object_id\n    WHERE n.type_id   = $1\n      AND n.source_id = $3\n), terminal AS MATERIALIZED (\n    SELECT n.name_id, n.eco_id, n.rank, p.entity_id AS position_id\n    FROM named n\n    CROSS JOIN LATERAL (\n        SELECT u.entity_id\n        FROM generation.trajectory_unpacked_points(n.line_id, 3::smallint)\n             WITH ORDINALITY AS u(entity_id, run_length, ctier, ord)\n        ORDER BY u.ord DESC\n        LIMIT 1\n    ) p\n)\nSELECT position_id, name_id, eco_id\nFROM terminal\nORDER BY position_id, rank DESC NULLS LAST, name_id, eco_id ASC NULLS LAST")

SQL_QUERY("generation.trajectory_token_text_batch", "bytea[]",
    "WITH doc AS (\n    SELECT id FROM unnest($1) AS x(id)\n),\ntok AS (\n    -- WITH ORDINALITY, not row_number() OVER (): the function ORDERs BY its\n    -- internal ordinal, but that ordering is not guaranteed to survive into an\n    -- outer window over a lateral join. Measured — the same document rebuilt to\n    -- 101 tokens on one run and 107 on the next.\n    --\n    -- The common unpacker expands RLE with the native trajectory\n    -- kernel. Every row is one logical token, including repeats.\n    SELECT d.id AS doc_id, p.entity_id, p.ord AS tord\n    FROM doc d\n    CROSS JOIN LATERAL (\n        SELECT t.entity_id, t.run_length, o AS ord\n        FROM generation.trajectory_unpacked_points(d.id) WITH ORDINALITY AS t(entity_id, run_length, ctier, o)\n    ) p\n),\ndistinct_ids AS (\n    SELECT COALESCE(array_agg(DISTINCT entity_id), '{}'::bytea[]) AS a FROM tok\n),\nlabel AS (\n    SELECT p.id AS eid, t.txt\n    FROM distinct_ids b,\n         LATERAL unnest(b.a) WITH ORDINALITY AS p(id, i),\n         LATERAL unnest(realize.batch(b.a, NULL)) WITH ORDINALITY AS t(txt, j)\n    WHERE p.i = t.j\n)\nSELECT tok.doc_id, string_agg(label.txt, ' ' ORDER BY tok.tord)\nFROM tok JOIN label ON label.eid = tok.entity_id\nGROUP BY tok.doc_id")

SQL_QUERY("chess.event_id_page", "bytea,bytea,bytea[],bytea,int4",
    "SELECT DISTINCT e.id\nFROM laplace.entities e\nJOIN laplace.attestations pl\n  ON pl.subject_id = e.id\n AND pl.type_id = $2\n AND pl.source_id = ANY($3)\nWHERE e.type_id = $1\n  AND (octet_length($4) = 0 OR e.id > $4)\nORDER BY e.id\nLIMIT $5")

SQL_QUERY("chess.line_id_page", "bytea,bytea[],bytea,int4",
    "SELECT DISTINCT pl.object_id\nFROM laplace.attestations pl\nWHERE pl.type_id = $1\n  AND pl.source_id = ANY($2)\n  AND (octet_length($3) = 0 OR pl.object_id > $3)\nORDER BY pl.object_id\nLIMIT $4")

SQL_QUERY("chess.players_missing_physicality_page", "bytea,int2,bytea,int4",
    "WITH candidates AS MATERIALIZED (\n    SELECT e.id\n    FROM laplace.entities e\n    WHERE e.type_id = $1\n      AND (octet_length($3) = 0 OR e.id > $3)\n      AND NOT EXISTS (\n          SELECT 1\n          FROM laplace.physicalities p\n          WHERE p.entity_id = e.id AND p.type = $2)\n    ORDER BY e.id\n    LIMIT $4\n)\nSELECT c.id, NULLIF(realize.resolve_name(c.id), '')\nFROM candidates c\nORDER BY c.id")

SQL_QUERY("evidence.by_subjects_and_type", "bytea[],bytea",
    "SELECT a.subject_id, a.object_id\nFROM laplace.attestations a\nWHERE a.subject_id = ANY($1)\n  AND a.type_id = $2")

SQL_QUERY("evidence.by_subjects_and_types", "bytea[],bytea[]",
    "SELECT a.subject_id, a.type_id, a.object_id, a.context_id, a.qualifier_mask\nFROM laplace.attestations a\nWHERE a.subject_id = ANY($1)\n  AND a.type_id = ANY($2)")

SQL_QUERY("generation.trajectory_constituents_for_type", "bytea[],int2",
    "SELECT d.id, p.entity_id, p.ordinal::integer\nFROM generation.typed_trajectory_points($1, ARRAY[$2]) p\nJOIN unnest($1) d(id) ON d.id = p.parent_id\nORDER BY d.id, p.ordinal")

SQL_QUERY("ops.multi_source_entity_count", "",
    "SELECT ops.multi_source_entity_count()")

SQL_QUERY("ops.entity_evidence_count", "bytea",
    "SELECT ops.entity_evidence_count($1)")

SQL_QUERY("converse.first_placed_topic", "text",
    "SELECT converse.first_placed_topic($1)")

SQL_QUERY("converse.resolve_ref", "text",
    "SELECT converse.resolve_ref($1)")

SQL_QUERY("laplace.word_id", "text",
    "SELECT laplace.word_id($1)")

SQL_QUERY("converse.chat", "text,bytea,bytea,text,int4[],bool",
    "SELECT converse.chat($1, $2, $3, $4, $5, NULL, NULL, NULL, $6)")

SQL_QUERY("readiness.perfcache_probe", "",
    "SELECT laplace.word_id('the');")

SQL_QUERY("realize.label_or_hex", "bytea",
    "SELECT COALESCE(\n    NULLIF(realize.render_text_fast($1, 8), ''),\n    converse.label_or_hex($1));")

SQL_QUERY("chess.setup_position", "bytea",
    "SELECT a.object_id\nFROM laplace.attestations pl\nJOIN laplace.attestations a\n  ON a.subject_id = pl.object_id\n AND a.context_id = pl.subject_id\n AND a.type_id = laplace.relation_type_id('HAS_SETUP')\nWHERE pl.subject_id = $1\n  AND pl.type_id = laplace.relation_type_id('PLAYS_LINE')\nORDER BY a.id\nLIMIT 1")

SQL_QUERY("chess.line_for_playing", "bytea",
    "SELECT object_id\nFROM laplace.attestations\nWHERE subject_id = $1\n  AND type_id = laplace.relation_type_id('PLAYS_LINE')\nORDER BY id\nLIMIT 1")

SQL_QUERY("evidence.first_subject", "bytea,bytea",
    "SELECT subject_id FROM laplace.attestations\nWHERE object_id = $1 AND type_id = $2\nLIMIT 1")

SQL_QUERY("realize.render_text_batch", "bytea[]",
    "SELECT realize.render_text_batch($1)")

SQL_QUERY("generation.recall_trajectory_answer", "text,int4",
    "SELECT answer FROM generation.recall_trajectories(laplace.word_id($1), $2) LIMIT 1")

SQL_QUERY("consensus.salient_fact_for_word", "text,int4",
    "SELECT fact FROM consensus.salient_facts(laplace.word_id($1), NULL, $2)\nORDER BY eff_mu DESC LIMIT 1")

SQL_QUERY("chess.count_events_with_plays_line", "bytea,bytea,bytea[]",
    "SELECT count(DISTINCT e.id)\nFROM laplace.entities e\nJOIN laplace.attestations pl\n  ON pl.subject_id = e.id\n AND pl.type_id = $2\n AND pl.source_id = ANY($3)\nWHERE e.type_id = $1")

SQL_QUERY("chess.count_lines_with_plays_line", "bytea,bytea[]",
    "SELECT count(DISTINCT pl.object_id)\nFROM laplace.attestations pl\nWHERE pl.type_id = $1\n  AND pl.source_id = ANY($2)")

