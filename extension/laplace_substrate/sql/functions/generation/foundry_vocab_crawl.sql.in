DROP FUNCTION IF EXISTS laplace.foundry_vocab_crawl(text[], int, int, int, float8);
CREATE OR REPLACE FUNCTION generation.foundry_vocab_crawl(
        p_seeds text[], p_max int DEFAULT 32000, p_hops int DEFAULT 3, p_fanout int DEFAULT 64,
        p_rank_floor float8 DEFAULT 0.5)
    RETURNS TABLE(entity_id bytea, surface text, weight bigint)
    LANGUAGE sql VOLATILE AS $$
    WITH seed_ids AS (
        SELECT coalesce(array_agg(wid), '{}'::bytea[]) AS ids
        FROM (SELECT laplace.word_id(s) AS wid FROM unnest(p_seeds) AS s) q
        WHERE wid IS NOT NULL
    ),
    
    
    
    
    
    
    
    
    rel_types AS (



        SELECT array_agg(e.id) AS ids
        FROM laplace.entities e
        WHERE e.type_id = realize.canonical_id('RelationType')
          AND consensus.relation_rank_resolved(e.id) >= p_rank_floor
    ),
    crawled AS (
        SELECT c.entity_id, c.weight,
               row_number() OVER (ORDER BY c.weight DESC, c.entity_id) AS rn
        FROM seed_ids si, rel_types rt
        CROSS JOIN LATERAL generation.foundry_crawl(si.ids, p_max, p_hops, p_fanout, rt.ids) c
    ),
    
    
    
    
    
    -- Pillar 5 (2026-07-20): sequence proposals come from geometry_successors --
    -- the next content constituent in the text projection of every trajectory --
    -- not from PRECEDES consensus, which merely materialized the same sequence
    -- the trajectory already holds (Pillar 3a, e5e1b42). Weight is observed
    -- frequency (seen), not consensus.eff_mu, because there is no rated edge to read.
    -- This is proposal evidence, not a direct semantic edge: the underlying
    -- structural path remains point -> containing composition -> constituent.
    order1 AS (
        SELECT gs.point_id,
               gs.successor_id AS entity_id,
               gs.seen::numeric AS w,
               row_number() OVER (PARTITION BY gs.point_id ORDER BY gs.seen DESC, gs.successor_id) AS rn
        FROM seed_ids si
        CROSS JOIN LATERAL structural.geometry_successors_batch(si.ids, p_fanout, 8, false) gs
        JOIN laplace.entities e ON e.id = gs.successor_id AND e.type_id = realize.canonical_id('Word')
    ),
    order1_cut AS (
        SELECT point_id, entity_id, w, w::bigint AS weight
        FROM order1 WHERE rn <= p_fanout
    ),
    order2 AS (
        SELECT tc.object_id AS entity_id,
               (o.w * tc.weight::numeric)::bigint AS weight,
               row_number() OVER (ORDER BY o.w * tc.weight DESC, tc.object_id) AS rn
        FROM order1_cut o
        CROSS JOIN LATERAL generation.trajectory_continuations(
            ARRAY[o.point_id, o.entity_id], p_fanout) tc
        JOIN laplace.entities e ON e.id = tc.object_id AND e.type_id = realize.canonical_id('Word')
    ),
    order2_cut AS (
        SELECT entity_id, weight FROM order2 WHERE rn <= p_max
    ),
    order_lemma AS (
        SELECT c.object_id AS entity_id, o.weight
        FROM (SELECT entity_id, max(weight) AS weight FROM (
                  SELECT entity_id, weight FROM order1_cut
                  UNION ALL SELECT entity_id, weight FROM order2_cut
              ) u GROUP BY entity_id) o
        JOIN laplace.v_consensus_unrefuted c ON c.subject_id = o.entity_id
            AND c.type_id = laplace.relation_type_id('IS_LEMMA_OF')
            AND c.object_id IS NOT NULL
        JOIN laplace.entities e ON e.id = c.object_id AND e.type_id = realize.canonical_id('Word')
    ),
    order_closure AS (
        SELECT entity_id, max(weight) AS weight,
               row_number() OVER (ORDER BY max(weight) DESC, entity_id) AS rn
        FROM (
            SELECT entity_id, weight FROM order1_cut
            UNION ALL SELECT entity_id, weight FROM order2_cut
            UNION ALL SELECT entity_id, weight FROM order_lemma
        ) u
        GROUP BY entity_id
    ),
    
    
    
    
    
    
    
    -- The scaffold is contextual vocabulary, so discover it from trajectories
    -- containing at least one requested seed.  The previous global branch sorted
    -- by content hash, cut at 400,000 trajectories regardless of p_max, and only
    -- then unpacked them: a 100-token request took 126.9 seconds while returning
    -- 57 rows.  Overlap is the GIN-served reduction boundary; ordinal unpack and
    -- frequency aggregation happen only over the matching physical observations.
    --
    -- No parent-entity type join belongs before that boundary.  It scanned 10.6M
    -- Sentence/Document entity rows to validate 13,457 already-matched trajectories
    -- in the measured `king` probe.  A word's own grapheme trajectory cannot contain
    -- its word id, so seed overlap already selects compositions in which the word
    -- participates.  The final rendered-content predicates below reject separators
    -- and non-token surfaces after aggregation, over the reduced ID set.
    scaffold_traj AS MATERIALIZED (
        SELECT DISTINCT ON (p.entity_id) p.entity_id, p.trajectory
        FROM seed_ids s, laplace.physicalities p
        WHERE p.type = 1
          AND p.trajectory IS NOT NULL
          AND public.laplace_trajectory_constituent_ids(p.trajectory) && s.ids
        ORDER BY p.entity_id, p.id
    ),
    scaffold AS (
        SELECT tc.entity_id AS entity_id,
               count(*)::bigint AS weight,
               row_number() OVER (ORDER BY count(*) DESC, tc.entity_id) AS rn
        FROM scaffold_traj t
        CROSS JOIN LATERAL public.laplace_trajectory_constituents(t.trajectory) tc
        GROUP BY tc.entity_id
    ),
    picked AS (
        SELECT entity_id, weight, 2 AS pri FROM order_closure WHERE rn <= p_max / 4
        UNION ALL
        SELECT entity_id, weight, 1 AS pri FROM crawled  WHERE rn <= p_max - p_max / 2
        UNION ALL
        SELECT entity_id, weight, 0 AS pri FROM scaffold WHERE rn <= p_max / 4
    ),
    uniq AS (
        SELECT DISTINCT ON (entity_id) entity_id, weight, pri
        FROM picked ORDER BY entity_id, pri DESC, weight DESC
    ),
    ids_arr AS (
        SELECT array_agg(entity_id ORDER BY pri DESC, weight DESC) AS ids,
               array_agg(weight     ORDER BY pri DESC, weight DESC) AS ws,
               array_agg(pri        ORDER BY pri DESC, weight DESC) AS prs
        FROM uniq
    ),
    rendered AS (
        SELECT u.entity_id, u.s, a.ws[u.ord::int] AS weight, a.prs[u.ord::int] AS pri
        FROM ids_arr a
        CROSS JOIN LATERAL unnest(a.ids, realize.render_text_batch(a.ids, 8))
                   WITH ORDINALITY AS u(entity_id, s, ord)
        WHERE a.ids IS NOT NULL AND cardinality(a.ids) > 0
    ),
    clean AS (
        SELECT DISTINCT ON (n.s) n.entity_id, n.s, n.weight, n.pri
        FROM rendered n
        WHERE n.s IS NOT NULL AND btrim(n.s) <> '' AND NOT realize.is_all_whitespace(n.s)
          AND position(' ' IN n.s) = 0 AND char_length(n.s) <= 40
          -- 2026-07-09 (finish-line Phase 2): the old `~ '[[:alpha:]]'` gate made
          -- punctuation and numerals unrepresentable — no synthesized model could emit
          -- a sentence boundary. Non-whitespace is content; only ILI ids stay out.
          AND n.s !~ '^i[0-9]+$'
        ORDER BY n.s, n.pri DESC, n.weight DESC
    )
    SELECT c.entity_id, c.s, c.weight FROM clean c ORDER BY c.pri DESC, c.weight DESC LIMIT p_max
$$;
