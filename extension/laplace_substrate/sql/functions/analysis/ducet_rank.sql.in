-- DUCET ordering and S3 coverage are deliberately separate.
--
-- Unicode seed assigns every codepoint a zero-based DUCET/UCA rank, then feeds
-- that rank to the prefix-stable open Super-Fibonacci map.  Its radial parameter
-- is the base-2 radical inverse of the rank, so early ranks cover the whole
-- shell instead of occupying one latitude band.
--
-- public.laplace_super_fibonacci_open_index reverses that mapping using the
-- configured atom window as the significant-width bound.  Geometry therefore
-- still carries a reversible collation address without making collation order
-- spatially monotone.
CREATE OR REPLACE FUNCTION ops.ducet_rank(p_coord geometry)
RETURNS double precision
LANGUAGE sql IMMUTABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT public.laplace_super_fibonacci_open_index(
               p_coord, laplace.atom_window())::double precision + 0.5;
END;

COMMENT ON FUNCTION ops.ducet_rank(geometry) IS
    'DUCET collation rank recovered from prefix-stable open Super-Fibonacci geometry. Returns i+0.5.';


-- Collation-ordered atom listing.
--
-- The B-tree is over the exact recovered zero-based index, not x^2+y^2.  That
-- distinction is essential: x^2+y^2 is intentionally bit-reversed so prefixes
-- spread across S3 and is therefore not monotone in DUCET order.
CREATE OR REPLACE FUNCTION ops.ducet_ordered(p_from  integer DEFAULT 0,
                                             p_limit integer DEFAULT 50)
RETURNS TABLE(rank double precision, codepoint integer, ch text)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT w.rnk0::double precision + 0.5,
           cp.cp_val,
           CASE WHEN cp.cp_val BETWEEN 32 AND 1114111
                THEN chr(cp.cp_val) END
    FROM (
        SELECT e.id AS eid,
               public.laplace_super_fibonacci_open_index(
                   p.coord, laplace.atom_window()) AS rnk0
        FROM laplace.entities e
        JOIN laplace.physicalities p ON p.entity_id = e.id
        WHERE e.tier = 0
          AND public.laplace_super_fibonacci_open_index(
                  p.coord, laplace.atom_window()) >= p_from
        ORDER BY public.laplace_super_fibonacci_open_index(
                     p.coord, laplace.atom_window())
        LIMIT p_limit
    ) w
    CROSS JOIN LATERAL (SELECT realize.codepoint_for_id(w.eid) AS cp_val) cp
    ORDER BY w.rnk0;
END;

COMMENT ON FUNCTION ops.ducet_ordered(integer, integer) IS
    'Atoms in DUCET order via the reversible open Super-Fibonacci index. '
    'Codepoint resolution runs only on the LIMITed rows.';
