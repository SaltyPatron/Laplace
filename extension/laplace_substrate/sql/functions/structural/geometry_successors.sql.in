-- The geometry-native continuation operator: for a content point, the next (or
-- previous) CONTENT constituent in every trajectory that contains it, aggregated
-- by frequency. Reads the ordered sequence straight from the content-addressed
-- geometry (a single-key GIN reverse probe + the central separator alphabet) --
-- no PRECEDES attestation, no gen_corpus flat corpus.
-- Native because the walk (find the point, skip separators, take the neighbour,
-- aggregate) is pointer/loop work SQL cannot do at scale; see geometry_successors.c.
--
-- p_backward flips the walk. The trajectory holds the EXACT ordered sequence of
-- everything ingested, so "what precedes x" is exactly as answerable as "what
-- follows x" -- same containment query, same separator set, same aggregation.
-- Asking the question is always legal; what is banned is MATERIALISING the answer
-- as stored PRECEDES rows when the geometry already holds it losslessly.
-- Multi-root form for sequence-projection expansion.  One GIN overlap probe reads every
-- trajectory containing ANY requested point, then native code preserves the
-- scalar contract independently for each root: first occurrence per physical
-- observation, first non-separator within p_window, top p_limit successors.
-- This is the set operator; callers with an array must not invoke the scalar
-- function row by row and rescan the same corpus for every frontier member.
-- "Successor" is not a direct substrate relationship: this operation projects
-- a container's ordered constituents into a text-generation stream. Structural
-- inference retains the point -> container -> constituent hop via containers_of().
DROP FUNCTION IF EXISTS laplace.geometry_successors_batch(bytea[], int, int, boolean);
CREATE OR REPLACE FUNCTION structural.geometry_successors_batch(
        p_points   bytea[],
        p_limit    int DEFAULT 20,
        p_window   int DEFAULT 8,
        p_backward boolean DEFAULT false)
    RETURNS TABLE(point_id bytea, successor_id bytea, seen bigint)
    AS 'MODULE_PATHNAME', 'pg_laplace_geometry_successors_batch'
    LANGUAGE C STABLE;

CREATE OR REPLACE FUNCTION structural.geometry_successors_batch_typed(
        p_points   bytea[],
        p_limit    int,
        p_window   int,
        p_backward boolean,
        p_type     smallint)
    RETURNS TABLE(point_id bytea, successor_id bytea, seen bigint)
    AS 'MODULE_PATHNAME', 'pg_laplace_geometry_successors_batch'
    LANGUAGE C STABLE;

DROP FUNCTION IF EXISTS laplace.geometry_successors(bytea, int, int, boolean);
CREATE OR REPLACE FUNCTION structural.geometry_successors(
        p_point    bytea,
        p_limit    int DEFAULT 20,
        p_window   int DEFAULT 8,
        p_backward boolean DEFAULT false)
    RETURNS TABLE(successor_id bytea, seen bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    -- Scalar is an adapter over the one set-native implementation. The former
    -- scalar C entry point owned a separate single-key SPI plan and duplicated
    -- the complete trajectory walk; callers now share batch semantics exactly.
    SELECT b.successor_id, b.seen
    FROM structural.geometry_successors_batch(
        ARRAY[p_point]::bytea[], p_limit, p_window, p_backward) b
    ORDER BY b.seen DESC, b.successor_id;
END;

CREATE OR REPLACE FUNCTION structural.geometry_successors_typed(
        p_point    bytea,
        p_limit    int,
        p_window   int,
        p_backward boolean,
        p_type     smallint)
    RETURNS TABLE(successor_id bytea, seen bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT b.successor_id, b.seen
    FROM structural.geometry_successors_batch_typed(
        ARRAY[p_point]::bytea[], p_limit, p_window, p_backward, p_type) b
    ORDER BY b.seen DESC, b.successor_id;
END;

-- Named mirror: "what comes before x", read from the same sequence.
DROP FUNCTION IF EXISTS laplace.geometry_predecessors(bytea, int, int);
CREATE OR REPLACE FUNCTION structural.geometry_predecessors(
        p_point  bytea,
        p_limit  int DEFAULT 20,
        p_window int DEFAULT 8)
    RETURNS TABLE(predecessor_id bytea, seen bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
 AS $$
    SELECT successor_id, seen FROM structural.geometry_successors(p_point, p_limit, p_window, true)
$$;

-- Both directions at once, for the symmetric questions (shared-usage overlap,
-- domain co-occurrence) that must not be silently halved to fit a one-way walk.
DROP FUNCTION IF EXISTS laplace.geometry_neighbours(bytea, int, int);
CREATE OR REPLACE FUNCTION structural.geometry_neighbours(
        p_point  bytea,
        p_limit  int DEFAULT 20,
        p_window int DEFAULT 8)
    RETURNS TABLE(neighbour_id bytea, seen bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
 AS $$
    SELECT n.id, sum(n.seen)::bigint
    FROM (
        SELECT successor_id AS id, seen FROM structural.geometry_successors(p_point, p_limit, p_window, false)
        UNION ALL
        SELECT successor_id AS id, seen FROM structural.geometry_successors(p_point, p_limit, p_window, true)
    ) n
    GROUP BY n.id
    ORDER BY 2 DESC
$$;
