LAPLACE_CUTECHESS=<path-to-cutechess-cli.exe>
LAPLACE_CUTECHESS_GUI=<path-to-cutechess.exe>
LAPLACE_CUTECHESS_GUI_RECEIPT=<path-to-laplace-cutechess-gui-build.json>
LAPLACE_STOCKFISH=<path-to-stockfish.exe>
LAPLACE_QT_BIN=<path-to-qt-msvc-bin>
# The ladder (deploy/chess-ladder-release.json pins each; laplace-uci check --require-ladder checks them).
# fastchess conducts matches, SPRT and the ladder; cutechess stays for the GUI and as a cross-check.
LAPLACE_FASTCHESS=<path-to-fastchess.exe>
LAPLACE_ORDO=<path-to-ordo-win64.exe>
# Lc0 runs only in chess-GPU mode (Laplace-Operations chess\chess-gpu.ps1 on); the conductor starts it per match.
LAPLACE_LC0=<path-to-lc0.exe>
LAPLACE_LC0_NET=<path-to-network.pb.gz>
LAPLACE_LC0_BACKEND=cuda-fp16
# official-stockfish/books at the pinned commit, unpacked (UHO_Lichess_4852_v1.epd, 8moves_v3.pgn, noob_3moves.epd, endgames.epd)
LAPLACE_CHESS_BOOKS=<path-to-Games\Chess\books\65815cc>
# Stockfish's tablebases in lab matches: the installed set unless a job names stockfishSyzygyPath (or "none")
LAPLACE_SYZYGY=<path-to-syzygy\3-4-5>
LAPLACE_CHESS_OPENINGS=<directory-containing-a.tsv-through-e.tsv>
LAPLACE_CHESS_LAB_DIR=<writable-chess-job-output-directory>
LAPLACE_ZSTD_LIBRARY=<path-to-zstd.dll>
# Select this public file with LAPLACE_CHESS_ENV in the service/client declaration.
# The packaged monorepo UCI is discovered within the selected release; LAPLACE_UCI
# may explicitly override it. No build directory is needed by installed consumers.
