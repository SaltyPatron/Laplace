-- Drops entities_tier_btree. Tier is altitude, not identity or layout: entities
-- are HASH(id) and a tier-only btree serves no admitted read.
DO $do$
BEGIN
    -- Release extension membership first (a no-op when the index is not a
    -- member); the guarded DROP then removes the object.
    BEGIN
        EXECUTE format('ALTER EXTENSION %I DROP INDEX laplace.entities_tier_btree',
                       'laplace_substrate');
    EXCEPTION WHEN OTHERS THEN
        NULL;  -- not a member
    END;
    EXECUTE 'DROP INDEX IF EXISTS laplace.entities_tier_btree';
END $do$;
