-- p_ordinal_continuity and p_use_geometry both default false for one reason:
-- laplace.physicalities is HASH(id) over 64 partitions, and both features join
-- it by entity_id, which cannot prune. Every probe fans out across all 64.
-- MEASURED live, 200-node frontier / 21,413 candidate edges: the batch edge
-- query costs 30,305ms with the coordinate joins and 408ms without.
-- See generate_walk.c above WALK_BATCH_QUERY.
--
-- Highway masks are rebuildable accelerator projections. The historical native
-- p_intent_mask branch hard-gated candidate entities by their stored aggregate
-- mask, so a stale/partial mask changed the answer. Keep the native ABI installed
-- behind a private surface, but pass NULL for the mask from the canonical public
-- operation until a sound accelerator implementation can prove parity with the
-- authoritative relation set. Explicit p_type remains the semantic relation scope.
DROP FUNCTION IF EXISTS laplace.walk_branches(bytea, bytea, int, int, bytea, bytea[], bool);
DROP FUNCTION IF EXISTS consensus.walk_branches(bytea, bytea, int, int, bytea, bytea[], bool);
-- Preserve this stable native ABI's OID: the parsed SQL public wrapper and
-- converse.recall_walk_response depend on it during extension upgrades.

CREATE OR REPLACE FUNCTION consensus.walk_branches_native(
    p_prompt              bytea,
    p_type                bytea,
    p_depth               int,
    p_breadth             int,
    p_intent_mask         bytea,
    p_topic_bias          bytea[],
    p_ordinal_continuity  bool,
    p_use_geometry        bool)
    RETURNS TABLE(depth int, path bytea[], types bytea[], entity_id bytea,
                  eff_mu numeric, path_mu numeric, witnesses bigint)
    AS 'MODULE_PATHNAME', 'pg_laplace_walk_branches'
    LANGUAGE C STABLE;

CREATE OR REPLACE FUNCTION consensus.walk_branches(
    p_prompt              bytea,
    p_type                bytea    DEFAULT NULL,
    p_depth               int      DEFAULT 4,
    p_breadth             int      DEFAULT 5,
    p_intent_mask         bytea    DEFAULT NULL,
    p_topic_bias          bytea[]  DEFAULT NULL,
    p_ordinal_continuity  bool     DEFAULT false,
    p_use_geometry        bool     DEFAULT false)
    RETURNS TABLE(depth int, path bytea[], types bytea[], entity_id bytea,
                  eff_mu numeric, path_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT *
    FROM consensus.walk_branches_native(
        p_prompt,
        p_type,
        p_depth,
        p_breadth,
        NULL::bytea,
        p_topic_bias,
        p_ordinal_continuity,
        p_use_geometry);
END;
