-- The public batch operation enters native C directly. C owns relation lookup,
-- dynamic-family resolution, pair reduction, bit operations and tuple updates.
-- Canonical relation pairs require no consensus reread. The caller retains its
-- entity-sharded batching and the native writer retains ordered row acquisition.
--
-- When the registry is unavailable, the same native entry point retains the
-- exact zipped pairs through one prepared SPI INSERT. SQL persists that batch;
-- it does not reimplement mask computation. Reconciliation later invokes the
-- same operation with those retained pairs. A zero return counts zero changed
-- entity masks, never discarded work. Repair procedures orchestrate batches and
-- transactions separately in highway_mask_rebuild.sql.in.
DROP FUNCTION IF EXISTS laplace.highway_mask_deposit(bytea[], bytea[]);

CREATE OR REPLACE FUNCTION consensus.highway_mask_deposit(
    p_entity_ids bytea[], p_type_ids bytea[])
    RETURNS bigint
    AS 'MODULE_PATHNAME', 'pg_laplace_highway_mask_deposit'
    LANGUAGE C VOLATILE;

-- Preserve the already-declared alias without a second implementation.
CREATE OR REPLACE FUNCTION consensus.highway_mask_deposit_native(
    p_entity_ids bytea[], p_type_ids bytea[])
    RETURNS bigint
    AS 'MODULE_PATHNAME', 'pg_laplace_highway_mask_deposit'
    LANGUAGE C VOLATILE;
