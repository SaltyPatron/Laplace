-- Extension update. Side tables the substrate no longer keeps:
-- index_cycle_journal: no ingest drops a production index, so nothing journals one.
-- relation_band_live_counts: band membership is the relation registry; row counts are
-- planner estimates or the explicit ops.relation_band_census().
DROP TABLE IF EXISTS laplace.index_cycle_journal;
DROP TRIGGER IF EXISTS relation_band_counts_insert ON laplace.consensus;
DROP TRIGGER IF EXISTS relation_band_counts_delete ON laplace.consensus;
DROP TRIGGER IF EXISTS relation_band_counts_update ON laplace.consensus;
DROP TRIGGER IF EXISTS relation_band_counts_truncate ON laplace.consensus;
DROP FUNCTION IF EXISTS converse.relation_band_counts_after_insert();
DROP FUNCTION IF EXISTS converse.relation_band_counts_after_delete();
DROP FUNCTION IF EXISTS converse.relation_band_counts_after_update();
DROP FUNCTION IF EXISTS converse.relation_band_counts_after_truncate();
DROP TABLE IF EXISTS converse.relation_band_live_counts;
