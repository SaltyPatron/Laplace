DROP FUNCTION IF EXISTS laplace.attestation_unary_response_type(bytea, bytea, bytea[], bytea);
DROP FUNCTION IF EXISTS ops.attestation_unary_response_type(bytea, bytea, bytea[], bytea);
CREATE OR REPLACE FUNCTION ops.attestation_unary_response_type(
    p_subject_id   bytea,
    p_relation_type_id      bytea,
    p_source_scope bytea[]    DEFAULT NULL,
    p_context_id   bytea      DEFAULT NULL
)
RETURNS TABLE(
    combined_eff_mu  double precision,
    source_count     integer,
    rating_fp1e9     bigint,
    rd_fp1e9         bigint
)
LANGUAGE sql STABLE
    AS $$
    SELECT * FROM ops.attestation_unary_response(p_subject_id, p_relation_type_id, p_source_scope, p_context_id)
$$;
