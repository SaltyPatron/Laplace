    "VALUES($1,$2,$3,$4,now(),now()) ON CONFLICT(tenant_id,session_key) DO UPDATE SET last_turn_at=now(), "
    "title=COALESCE(app.conversation_sessions.title,EXCLUDED.title) WHERE app.conversation_sessions.user_id=EXCLUDED.user_id")
