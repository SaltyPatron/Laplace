-- View still binds the flat name until its CREATE OR REPLACE later in the
-- install chain; drop it so the dual-name ban (#532) DROP can proceed.
DROP VIEW IF EXISTS laplace.v_attestation_readable;
CREATE OR REPLACE FUNCTION converse.label_or_hex(p_id bytea)
    RETURNS text
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    -- Human-facing realize.render with a stable fallback: the entity's label, or its
    -- hex content id when unlabelled. Centralizes the `COALESCE(realize.label(x),
    -- encode(x,'hex'))` idiom repeated 9x across SubstrateClient's audit,
    -- ExplainTrace, relations and Evidence queries. No SET search_path so it
    -- inlines into the caller's projection.
    SELECT COALESCE(realize.label(p_id), encode(p_id, 'hex'))
$$;
