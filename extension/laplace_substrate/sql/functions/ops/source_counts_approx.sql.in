CREATE OR REPLACE FUNCTION ops.source_counts_approx()
    RETURNS TABLE(source text, source_id bytea, evidence_approx bigint)
    LANGUAGE plpgsql STABLE
AS $source_counts$
BEGIN
    IF to_regclass('public.entity') IS NOT NULL THEN
        -- Witnesses come from the (witness, lineage) skip scan; each one's attestation
        -- count is the planner-statistics estimate summed over the claim partitions:
        -- its witness MCV frequency, else the non-MCV residual share, times the
        -- partition's reltuples. Nothing here scans attestations, so the read stays
        -- bounded as sources grow. A partition never analyzed is left out of the sum.
        RETURN QUERY EXECUTE
            'WITH t AS MATERIALIZED (SELECT witness FROM public.laplace_witness_trust()),
             p AS MATERIALIZED (
                SELECT c.reltuples::float8 AS rows, s.null_frac::float8 AS nulls,
                       (CASE WHEN s.n_distinct < 0 THEN -s.n_distinct * c.reltuples ELSE s.n_distinct END)::float8 AS distinct_values,
                       s.most_common_vals::text::text[] AS vals, s.most_common_freqs::float8[] AS freqs
                FROM pg_catalog.pg_inherits i
                JOIN pg_catalog.pg_class c ON c.oid = i.inhrelid
                JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
                LEFT JOIN pg_catalog.pg_stats s
                  ON s.schemaname = n.nspname AND s.tablename = c.relname AND s.attname = ''witness''
                WHERE i.inhparent = ''public.attestation''::regclass),
             w AS (
                SELECT t.witness AS id, sum(p.rows * coalesce(p.freqs[array_position(p.vals, t.witness::text)],
                         greatest(1 - p.nulls - (SELECT coalesce(sum(f), 0) FROM unnest(p.freqs) f), 0)
                         / greatest(p.distinct_values - coalesce(cardinality(p.vals), 0), 1)))::bigint AS attestations
                FROM t CROSS JOIN p GROUP BY t.witness)
             SELECT coalesce(j.source_name,c.source_label,w.id::text),public.blake3_send(w.id),w.attestations
             FROM w LEFT JOIN ops.witness_catalog() c ON c.id=w.id
             LEFT JOIN LATERAL (SELECT source_name FROM laplace.ingest_run_journal
                WHERE source_id=public.blake3_send(w.id) ORDER BY started_at DESC LIMIT 1) j ON true
             ORDER BY w.id';
        RETURN;
    END IF;
    RETURN QUERY
    -- Planner-statistics form of ops.source_counts(), which full-scans
    -- attestations: per-source evidence = source_id MCV frequency x reltuples.
    -- ANALYZE freshness bounds the error; sources below the MCV cutoff do not
    -- appear. Exact counts: ops.evidence_count(NULL, source_id).
    WITH st AS (
        SELECT s.most_common_vals::text::bytea[] AS vals,
               s.most_common_freqs               AS freqs
        FROM pg_stats s
        WHERE s.schemaname = '@extschema@'
          AND s.tablename  = 'attestations'
          AND s.attname    = 'source_id'
    ), rt AS (
        SELECT c.reltuples
        FROM pg_class c
        JOIN pg_namespace n ON n.oid = c.relnamespace
        WHERE n.nspname = '@extschema@' AND c.relname = 'attestations'
    )
    , raw AS MATERIALIZED (
      SELECT m.sid AS source_id, (m.freq * rt.reltuples)::bigint AS evidence_approx
      FROM st, rt, LATERAL unnest(st.vals, st.freqs) AS m(sid, freq)
    ), numbered AS MATERIALIZED (
      SELECT r.*, row_number() OVER (ORDER BY evidence_approx DESC, source_id) AS rn FROM raw r
    ), batch AS MATERIALIZED (
      SELECT ARRAY(SELECT lp_l.content FROM unnest((array_agg(source_id ORDER BY rn))::bytea[]) WITH ORDINALITY lp_u(x,n) LEFT JOIN (SELECT DISTINCT ON (lp_d.entity) lp_d.entity,lp_d.content FROM public.laplace_labels(array_remove((array_agg(source_id ORDER BY rn))::bytea[],NULL)::public.blake3[]) lp_d) lp_l ON lp_l.entity=lp_u.x::public.blake3 ORDER BY lp_u.n) AS labels FROM numbered
    )
    SELECT b.labels[n.rn], n.source_id, n.evidence_approx
    FROM numbered n CROSS JOIN batch b ORDER BY n.rn;
END
$source_counts$;
