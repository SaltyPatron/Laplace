-- Content entities (those with a Content physicality), overall or among one
-- source's attestation subjects.
DROP FUNCTION IF EXISTS laplace.content_count(bytea);

CREATE OR REPLACE FUNCTION ops.content_count(p_source bytea DEFAULT NULL)
    RETURNS bigint
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT CASE
        WHEN p_source IS NULL THEN
            (SELECT count(*) FROM laplace.physicalities p WHERE p.type = 1)
        ELSE
            -- Dedup the source's subjects in one hash-aggregate pass, then probe
            -- physicalities by entity_id, instead of joining every attestation row.
            (SELECT count(*)
             FROM (SELECT DISTINCT a.subject_id
                   FROM laplace.attestations a
                   WHERE a.source_id = p_source) s
             WHERE EXISTS (SELECT 1 FROM laplace.physicalities p
                           WHERE p.entity_id = s.subject_id AND p.type = 1))
    END;
END;
