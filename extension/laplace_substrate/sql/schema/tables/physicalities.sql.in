-- physicalities: the typed physical realizations of an entity (entity_id,
-- type): coord (PointZM in the unit 4-ball), hilbert_index (its Hilbert
-- locality key), and, for compositions, the GeometryZM trajectory manifest of
-- ordered constituents. Geometry reads
-- (KNN over coord, constituent GIN probes) and REALIZE all read this face.
--
-- HASH(id): ids are content hashes, so the 64 leaves are uniform and parallel
-- bulk COPY splits evenly. hilbert_index is a curve position, not a hash, so it
-- is indexed, not used as the partition key. PK (id) alone: a hash partition
-- key must be in every unique constraint. entity_id lookups use
-- physicalities_entity_btree. No FK to entities (see consensus.sql.in).
-- GREENFIELD: a database with any other partition layout is recreated and
-- reseeded, not repartitioned in place.
CREATE TABLE IF NOT EXISTS physicalities (
    id                 bytea            NOT NULL CHECK (octet_length(id) = 16),
    entity_id          bytea            NOT NULL,
    type               smallint         NOT NULL,
    coord              geometry(PointZM)    NOT NULL,
    hilbert_index      bytea                NOT NULL CHECK (octet_length(hilbert_index) = 16),
    trajectory         geometry(GeometryZM),
    -- 4D distance from the origin, computed by the native
    -- public.laplace_radius_origin so there is one definition of the radius.
    radius_origin      double precision GENERATED ALWAYS AS (
        public.laplace_radius_origin(coord)
    ) STORED,
    n_constituents     integer          NOT NULL DEFAULT 0 CHECK (n_constituents >= 0),
    alignment_residual double precision,
    source_dim         integer          CHECK (source_dim IS NULL OR source_dim > 0),
    observed_at        timestamptz      NOT NULL DEFAULT now(),
    PRIMARY KEY (id)
) PARTITION BY HASH (id);

DO $$
DECLARE
    b int;
    suffix text;
BEGIN
    IF (SELECT c.relkind FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
        WHERE n.nspname = current_schema() AND c.relname = 'physicalities') <> 'p' THEN
        RETURN;  -- legacy plain table
    END IF;
    IF to_regclass(current_schema() || '.physicalities_h00') IS NOT NULL THEN
        RETURN;  -- buckets already exist
    END IF;
    -- CREATE TABLE IF NOT EXISTS no-ops against a parent partitioned any other
    -- way; refuse by name instead of letting MODULUS/REMAINDER bounds fail with
    -- an error that names neither the table nor the remedy.
    IF (SELECT p.partstrat FROM pg_partitioned_table p
        WHERE p.partrelid = (current_schema() || '.physicalities')::regclass) <> 'h' THEN
        RAISE EXCEPTION
            'physicalities is not HASH-partitioned in this database (found strategy %). '
            'This extension version partitions it HASH(id); the bands it still carries are '
            'the old RANGE(hilbert_index) layout. Recreate the database (DB — lifecycle ops, '
            'operation=recreate) and reseed — see the GREENFIELD note at the top of this file.',
            (SELECT p.partstrat FROM pg_partitioned_table p
             WHERE p.partrelid = (current_schema() || '.physicalities')::regclass);
    END IF;
    FOR b IN 0..63 LOOP
        suffix := lpad(to_hex(b), 2, '0');
        EXECUTE format('CREATE TABLE physicalities_h%s PARTITION OF physicalities'
                       || ' FOR VALUES WITH (MODULUS 64, REMAINDER %s)',
                       suffix, b);
        -- Per-leaf tuning (PG forbids storage params on partitioned parents):
        -- no PostGIS ND-stats on the geometry columns, which are reached through
        -- GiST KNN and GIN probes, never histograms; autoanalyze at 2% / 100k.
        EXECUTE format('ALTER TABLE physicalities_h%s ALTER COLUMN coord SET STATISTICS 0,'
                       || ' ALTER COLUMN trajectory SET STATISTICS 0',
                       suffix);
        EXECUTE format('ALTER TABLE physicalities_h%s SET (autovacuum_analyze_scale_factor'
                       || ' = 0.02, autovacuum_analyze_threshold = 100000)',
                       suffix);
    END LOOP;
END $$;

-- Parent-level column stats target (applies when ANALYZE samples the hierarchy
-- into parent stats; per-leaf targets are set at leaf creation above).
ALTER TABLE physicalities ALTER COLUMN coord      SET STATISTICS 0;
ALTER TABLE physicalities ALTER COLUMN trajectory SET STATISTICS 0;

SELECT pg_extension_config_dump('physicalities', '');
