DROP FUNCTION IF EXISTS consensus_neighbors_undirected(bytea, bytea[], int);
-- Neighbours in BOTH directions of one type set, unrefuted, eff_mu order. Thin
-- wrapper over edges_raw(); the UNION ALL it used to hand-roll is that function.
CREATE OR REPLACE FUNCTION consensus_neighbors_undirected(
    p_subject bytea, p_types bytea[], p_limit int)
    RETURNS TABLE(nbr bytea, rating bigint, rd bigint, witness_count bigint)
-- Class A per GH #860: RETURNS TABLE, not STRICT, not VOLATILE, single SELECT.
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    SELECT e.neighbour_id, e.rating, e.rd, e.witness_count
    FROM @extschema@.edges_raw(p_subject, 'both', p_types, p_limit, false, 'eff_mu') e
$$;
