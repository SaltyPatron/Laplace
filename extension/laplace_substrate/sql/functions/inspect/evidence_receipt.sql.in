DROP FUNCTION IF EXISTS laplace.evidence_receipt(bytea, integer);
DROP FUNCTION IF EXISTS consensus.evidence_receipt(bytea, integer);
CREATE OR REPLACE FUNCTION ops.evidence_receipt(p_id bytea, p_limit integer DEFAULT 25)
    RETURNS TABLE(
        type_id bytea,
        object_id bytea,
        type_label text,
        object_label text,
        eff_mu numeric,
        witness_count bigint,
        source_labels text)
    LANGUAGE sql STABLE 
    AS $$
    WITH subj(id) AS (
        SELECT p_id
        UNION
        SELECT sn.synset_id FROM lexical.senses(p_id) sn
    ), feat_dynamic AS MATERIALIZED (
        SELECT c.subject_id AS id FROM laplace.consensus c
        WHERE c.type_id = laplace.relation_type_id('IS_A')
          AND c.object_id = laplace.relation_type_id('HAS_FEATURE')
    ), filtered AS MATERIALIZED (
        SELECT a.type_id, a.object_id, a.source_id,
               sum(a.observation_count) AS obs
        FROM laplace.attestations a
        WHERE a.subject_id IN (SELECT id FROM subj)
          AND a.object_id IS NOT NULL
          AND EXISTS (
              SELECT 1 FROM laplace.entities et
              WHERE et.id = a.type_id AND et.type_id = laplace.entity_type_id('RelationType'))
          AND NOT consensus.relation_type_in_family(a.type_id, 'HAS_POS')
          AND NOT consensus.relation_type_in_family(a.type_id, 'HAS_FEATURE')
          AND a.type_id NOT IN (SELECT id FROM feat_dynamic)
          AND a.type_id NOT IN (
              laplace.relation_type_id('HAS_SENSE'), laplace.relation_type_id('IS_SENSE_OF'),
              laplace.relation_type_id('HAS_LANGUAGE'), laplace.relation_type_id('PRECEDES'),
              laplace.relation_type_id('FOLLOWS'), laplace.relation_type_id('CO_OCCURS_WITH'),
              laplace.relation_type_id('OCCURS_IN_CONTEXT'), laplace.relation_type_id('HAS_LEX_CATEGORY'),
              laplace.relation_type_id('HAS_VERB_FRAME'),
              laplace.relation_type_id('IS_LEMMA_OF'), laplace.relation_type_id('IS_TRANSLATION_OF'),
              laplace.relation_type_id('HAS_EXAMPLE'), laplace.relation_type_id('EVOKES_FRAME'),
              laplace.relation_type_id('HAS_SYNSET_KEY'), laplace.relation_type_id('IS_TYPED_AS'),
              laplace.relation_type_id('HAS_NAME_ALIAS'))
          AND NOT EXISTS (
              SELECT 1 FROM laplace.entities et
              WHERE et.id = a.object_id AND et.type_id = laplace.entity_type_id('RelationType'))
          AND NOT (
              a.type_id = laplace.relation_type_id('IS_SYNONYM_OF')
              AND a.object_id IN (SELECT id FROM subj))
        GROUP BY a.type_id, a.object_id, a.source_id
    ), src_labels AS MATERIALIZED (
        SELECT s.source_id,
               regexp_replace(realize.render(s.source_id),
                   '^substrate/source/([^/]+)(?:/v[0-9]+)?$', '\1') AS label
        FROM (SELECT DISTINCT f.source_id FROM filtered f) s
    ), folded AS (
        SELECT f.type_id, f.object_id,
               sum(f.obs) AS witness_count,
               string_agg(DISTINCT sl.label, ', ' ORDER BY sl.label) AS source_labels
        FROM filtered f
        JOIN src_labels sl ON sl.source_id = f.source_id
        GROUP BY f.type_id, f.object_id
    ), best AS MATERIALIZED (
        SELECT DISTINCT ON (c.type_id, c.object_id)
               c.type_id, c.object_id,
               consensus.eff_mu(c.rating, c.rd) AS mu_raw,
               consensus.eff_mu_display(c.rating, c.rd) AS mu_disp
        FROM laplace.consensus c
        WHERE c.subject_id IN (SELECT id FROM subj)
          AND c.object_id IS NOT NULL
        ORDER BY c.type_id, c.object_id, consensus.eff_mu(c.rating, c.rd) DESC
    ), ranked AS (
        SELECT fo.type_id, fo.object_id, fo.witness_count, fo.source_labels,
               COALESCE(b.mu_raw, 0)  AS mu_raw,
               COALESCE(b.mu_disp, 0) AS eff_mu_disp
        FROM folded fo
        LEFT JOIN best b
               ON b.type_id = fo.type_id AND b.object_id = fo.object_id
        WHERE fo.source_labels IS NOT NULL AND fo.source_labels <> ''
        ORDER BY consensus.edge_rank(fo.type_id, COALESCE(b.mu_raw, 0)) DESC,
                 fo.witness_count DESC
        LIMIT GREATEST(1, p_limit) * 3 + 8
    ), ordered AS (
        SELECT rk.*, row_number() OVER (
                   ORDER BY consensus.edge_rank(rk.type_id, rk.mu_raw) DESC,
                            rk.witness_count DESC) AS ord
        FROM ranked rk
    ), labels AS MATERIALIZED (
        SELECT realize.batch(array_agg(o.object_id ORDER BY o.ord),
                             converse.word_language(p_id)) AS l
        FROM ordered o
    ), labeled AS (
        SELECT o.type_id, o.object_id, o.witness_count, o.source_labels,
               o.mu_raw, o.eff_mu_disp,
               lexical.type_label(o.type_id) AS rel,
               COALESCE(NULLIF(labels.l[o.ord], ''),
                        left(encode(o.object_id, 'hex'), 16)) AS obj
        FROM ordered o, labels
    )
    SELECT lb.type_id, lb.object_id, lb.rel, lb.obj,
           lb.eff_mu_disp,
           lb.witness_count,
           lb.source_labels
    FROM labeled lb
    WHERE lb.obj IS NOT NULL AND lb.obj <> ''
      AND right(lb.obj, 1) <> U&'\2026'
      AND right(lb.rel, 1) <> U&'\2026'
    ORDER BY consensus.edge_rank(lb.type_id, lb.mu_raw) DESC,
             lb.witness_count DESC
    LIMIT GREATEST(1, p_limit)
$$;
