CREATE OR REPLACE FUNCTION recall_related_response(p_topic bytea, p_type_name text)
    RETURNS TABLE(reply text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
    AS $$
    SELECT replace(f.fact, '%s', @extschema@.label(p_topic)), f.eff_mu, f.witnesses
    FROM @extschema@.related(p_topic, @extschema@.relation_type_id(p_type_name), @extschema@.word_language(p_topic)) f
$$;
