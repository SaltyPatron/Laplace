CREATE OR REPLACE FUNCTION grapheme_order(p_vocab bytea[], p_words int DEFAULT 50000, p_gap int DEFAULT 1)
    RETURNS TABLE(subject_id bytea, object_id bytea, w double precision)
    LANGUAGE sql STABLE PARALLEL SAFE
    AS $$
    
    
    
    
    
    WITH v(id) AS (SELECT DISTINCT u FROM unnest(p_vocab) AS u),
    t AS (
        
        
        
        
        -- Role by TYPE, not tier. `tier = 2` was never "word": bootstrap mints relation
        -- types, trust classes, POS tags, sources and languages at tier 2 too, so this
        -- was spelling out the grapheme runs of RelationType and Language entities. It
        -- also missed single-grapheme words, which collapse to tier 0.
        --
        -- Ranked by length rather than content hash (an arbitrary LIMIT is a missing
        -- ranking); DISTINCT ON dropped, since (entity_id, type) is already unique.
        SELECT w.id AS wid, w.trajectory
        FROM @extschema@.v_word_points w
        WHERE w.type_id = @extschema@.canonical_id('Word')
          AND w.trajectory IS NOT NULL
        -- Sampling is by content hash, which is ARBITRARY -- an arbitrary LIMIT without
        -- an ordering is a missing ranking. The honest ranking is by trajectory length,
        -- but MEASURED 2026-08-01 that plans as a seq scan of every physicality partition
        -- plus a full sort (no index serves n_constituents), so it trades an arbitrary
        -- sample for an unusable one. Left arbitrary DELIBERATELY until an index exists
        -- that ingest is willing to pay for; the defect is recorded, not hidden.
        ORDER BY w.id, w.physicality_id
        LIMIT p_words
    ),
    g AS (
        
        
        
        
        SELECT t.wid, tc.ordinal AS ord, gs.i AS sub, tc.entity_id AS ch
        FROM t CROSS JOIN LATERAL public.laplace_trajectory_constituents(t.trajectory) tc
        CROSS JOIN LATERAL generate_series(1, GREATEST(tc.run_length, 1)) gs(i)
    ),
    bg AS (
        SELECT ch AS cur, lead(ch, p_gap) OVER (PARTITION BY wid ORDER BY ord, sub) AS nxt FROM g
    ),
    cnt AS (
        SELECT cur, nxt, count(*)::float8 AS c
        FROM bg WHERE nxt IS NOT NULL GROUP BY cur, nxt
    )
    SELECT b.cur, b.nxt, b.c
    FROM cnt b
    JOIN v vs ON vs.id = b.cur
    JOIN v vo ON vo.id = b.nxt
$$;
