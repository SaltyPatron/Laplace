-- consensus.relate_path — GH #862.
DROP FUNCTION IF EXISTS laplace.relate_path(bytea, bytea, int);
CREATE OR REPLACE FUNCTION consensus.relate_path(p_x bytea, p_y bytea, p_depth int DEFAULT 7)
    RETURNS TABLE(chain text, path_mu numeric, plane text)
    LANGUAGE sql STABLE PARALLEL SAFE
    -- No SET search_path (GH #860). Body is purpose-/laplace-qualified; CTE names
    -- (xset/yset/lat/…) are local and need no schema.
AS $$
    -- Candidate discovery is id/attestation logic only: every candidate carries
    -- its node/type/direction arrays and numeric score, and the single winner is
    -- picked on (len, mu) before any rendering. realize_path/type_label run
    -- exactly once, on the winning row -- never inside the search. (The old body
    -- rendered the chain text for every direct candidate edge even though
    -- ORDER BY len, mu LIMIT 1 kept one row.)
    WITH RECURSIVE
    -- The lateral and upward relation sets were CTEs of relation_type_id() over literal
    -- arrays -- constants -- and each predicate read them back as `type_id IN (SELECT k
    -- FROM lat)`. relation_type_id is IMMUTABLE (a BLAKE3 hash, no table), so called
    -- INLINE these fold to a literal bytea[] before planning and the LIST partitions
    -- prune. Read back from a CTE column they are per-row variables and nothing prunes --
    -- and two of the four sites sit inside RECURSIVE arms, so the unbound form paid that
    -- on every iteration. Same defect as realize.resolve_name.
    x_top AS (SELECT sn.synset_id FROM lexical.senses(p_x) sn
              ORDER BY sn.eff_mu DESC NULLS LAST LIMIT 1),
    y_top AS (SELECT sn.synset_id FROM lexical.senses(p_y) sn
              ORDER BY sn.eff_mu DESC NULLS LAST LIMIT 1),
    xset(id) AS (SELECT p_x UNION SELECT synset_id FROM x_top),
    yset(id) AS (SELECT p_y UNION SELECT synset_id FROM y_top),
    direct AS (
        SELECT ARRAY[x.id, c.object_id] AS nodes, ARRAY[c.type_id] AS types,
               ARRAY[1] AS dirs, consensus.eff_mu_display(c.rating, c.rd) AS mu, 1 AS len,
               c.type_id AS plane_type
        FROM xset x JOIN laplace.v_consensus_unrefuted c ON c.subject_id = x.id
          AND c.object_id IN (SELECT id FROM yset)
          AND c.type_id = ANY (ARRAY[laplace.relation_type_id('IS_SYNONYM_OF'), laplace.relation_type_id('IS_SIMILAR_TO'),
                          laplace.relation_type_id('IS_ANTONYM_OF'), laplace.relation_type_id('HAS_PART'),
                          laplace.relation_type_id('HAS_MEMBER'), laplace.relation_type_id('HAS_SUBSTANCE'),
                          laplace.relation_type_id('DERIVATIONALLY_RELATED'), laplace.relation_type_id('PERTAINS_TO'),
                          laplace.relation_type_id('ALSO_SEE'), laplace.relation_type_id('IN_VERB_GROUP_WITH'),
                          laplace.relation_type_id('HAS_ATTRIBUTE')])
        UNION ALL
        SELECT ARRAY[x.id, c.subject_id], ARRAY[c.type_id], ARRAY[-1],
               consensus.eff_mu_display(c.rating, c.rd), 1, c.type_id
        FROM xset x JOIN laplace.v_consensus_unrefuted c ON c.object_id = x.id
          AND c.subject_id IN (SELECT id FROM yset)
          AND c.type_id = ANY (ARRAY[laplace.relation_type_id('IS_SYNONYM_OF'), laplace.relation_type_id('IS_SIMILAR_TO'),
                          laplace.relation_type_id('IS_ANTONYM_OF'), laplace.relation_type_id('HAS_PART'),
                          laplace.relation_type_id('HAS_MEMBER'), laplace.relation_type_id('HAS_SUBSTANCE'),
                          laplace.relation_type_id('DERIVATIONALLY_RELATED'), laplace.relation_type_id('PERTAINS_TO'),
                          laplace.relation_type_id('ALSO_SEE'), laplace.relation_type_id('IN_VERB_GROUP_WITH'),
                          laplace.relation_type_id('HAS_ATTRIBUTE')])
    ),
    ux(node, path, types, mu, d) AS (
        SELECT id, ARRAY[id], ARRAY[]::bytea[], NULL::numeric, 0 FROM xset
        UNION ALL
        SELECT c.object_id, u.path || c.object_id, u.types || c.type_id,
               LEAST(COALESCE(u.mu, consensus.eff_mu_display(c.rating, c.rd)),
                     consensus.eff_mu_display(c.rating, c.rd)), u.d + 1
        FROM ux u JOIN laplace.v_consensus_unrefuted c ON c.subject_id = u.node
          AND c.type_id = ANY (ARRAY[laplace.relation_type_id('IS_A'), laplace.relation_type_id('IS_INSTANCE_OF')]) AND c.object_id IS NOT NULL
          AND NOT (c.object_id = ANY (u.path))
        WHERE u.d < p_depth
    ),
    uy(node, path, types, mu, d) AS (
        SELECT id, ARRAY[id], ARRAY[]::bytea[], NULL::numeric, 0 FROM yset
        UNION ALL
        SELECT c.object_id, u.path || c.object_id, u.types || c.type_id,
               LEAST(COALESCE(u.mu, consensus.eff_mu_display(c.rating, c.rd)),
                     consensus.eff_mu_display(c.rating, c.rd)), u.d + 1
        FROM uy u JOIN laplace.v_consensus_unrefuted c ON c.subject_id = u.node
          AND c.type_id = ANY (ARRAY[laplace.relation_type_id('IS_A'), laplace.relation_type_id('IS_INSTANCE_OF')]) AND c.object_id IS NOT NULL
          AND NOT (c.object_id = ANY (u.path))
        WHERE u.d < p_depth
    ),
    lca_pick AS (
        SELECT ux.path AS xp, ux.types AS xk, uy.path AS yp, uy.types AS yk,
               LEAST(ux.mu, uy.mu) AS mu, ux.d + uy.d AS len
        FROM ux JOIN uy ON ux.node = uy.node
        WHERE ux.d > 0 OR uy.d > 0
        ORDER BY ux.d + uy.d, LEAST(ux.mu, uy.mu) DESC NULLS LAST LIMIT 1
    ),
    winner AS (
        SELECT a.nodes, a.types, a.dirs, a.mu, a.len, a.plane_type
        FROM (
            SELECT nodes, types, dirs, mu, len, plane_type FROM direct
            UNION ALL
            SELECT xp || array_reverse(yp[1:cardinality(yp)-1]),
                   xk || array_reverse(yk),
                   (SELECT COALESCE(array_agg(1), ARRAY[]::int[]) FROM generate_subscripts(xk, 1))
                       || (SELECT COALESCE(array_agg(-1), ARRAY[]::int[]) FROM generate_subscripts(yk, 1)),
                   mu, len, NULL::bytea
            FROM lca_pick
        ) a ORDER BY a.len, a.mu DESC NULLS LAST LIMIT 1
    )
    SELECT realize.path(w.nodes, w.types, w.dirs,
                        COALESCE(converse.word_language(p_x), converse.word_language(p_y))) AS chain,
           w.mu AS path_mu,
           CASE WHEN w.plane_type IS NULL THEN 'taxonomy'
                ELSE lexical.type_label(w.plane_type) END AS plane
    FROM winner w
$$;
