-- One round of the trunk-to-leaf content-addressed existence probe.
--
-- The C# orchestrator still descends by structural tier so it can stop walking
-- children of a proven content node. That scheduling fact does not make tier an
-- entity key: canonical storage is id-only/HASH(id), and a present content id
-- proves the content regardless of which interpretation/floor led the caller to
-- it. Bits are set only by a positive perfcache/codepoint or committed-row hit.
CREATE OR REPLACE FUNCTION laplace.tier_batch_existence_probe(ids bytea[])
    RETURNS bytea
    AS 'MODULE_PATHNAME', 'pg_laplace_tier_batch_existence_probe'
    LANGUAGE C STABLE;

-- Compatibility overload for callers whose round state already carries tiers.
-- Tier participates in traversal scheduling only; it is intentionally ignored
-- by canonical presence.
CREATE OR REPLACE FUNCTION laplace.tier_batch_existence_probe(ids bytea[], tiers smallint[])
    RETURNS bytea
    LANGUAGE sql STABLE PARALLEL RESTRICTED
BEGIN ATOMIC
    SELECT laplace.tier_batch_existence_probe(ids);
END;
