-- consensus.edges_raw() — THE consensus edge scan. Every other edge reader is a wrapper.
--
-- Six functions were the same scan with different axes hard-coded, and no caller
-- ever chose those axes — they inherited whichever function they happened to
-- reach for:
--
--   fn                              table       dir   rank       consensus.refuted
--   consensus_out                   consensus   out   consensus.edge_rank  INCLUDED
--   consensus_in                    consensus   in    consensus.edge_rank  INCLUDED
--   consensus_neighbors_directed    unrefuted   out   consensus.eff_mu     excluded
--   consensus_neighbors_undirected  unrefuted   both  consensus.eff_mu     excluded
--   explore_web_neighbors           consensus   both  consensus.eff_mu     INCLUDED
--   foundry_crawl_neighbors         consensus   out   consensus.eff_mu     INCLUDED
--
-- Four of the six return consensus.refuted edges. That is a semantic split — a consensus.refuted edge
-- is one the fold has rated BELOW neutral at its optimistic bound, i.e. the
-- substrate's own verdict is "this claim lost" — and it was distributed by
-- accident, not by design. consensus_out and consensus_in are the pair a new
-- caller reaches for first, and they are on the including side.
--
-- Now the axes are arguments with stated defaults, one implementation behind
-- them, and each historical function keeps its exact signature and output shape
-- as a thin wrapper pinning its own axes. Nothing changes for existing callers;
-- what changes is that the next reader does not have to diff six bodies to learn
-- which one excludes refutation.
--
-- RAW on purpose: ids and Glicko state, no labels. Labeling is a separate layer
-- (consensus.edges(), which wraps this and resolves in one realize_batch after the limit),
-- because the native walkers that consume edges want ids and would pay for text
-- they never realize.render.
DROP FUNCTION IF EXISTS laplace.edges_raw(bytea, text, bytea[], int, boolean, text);
-- BEGIN ATOMIC: GH #764. No SET search_path (#617/#860) — inlining into wrappers.
CREATE OR REPLACE FUNCTION consensus.edges_raw(
        p_subject   bytea,
        p_direction text    DEFAULT 'both',   -- 'out' | 'in' | 'both'
        p_types     bytea[] DEFAULT NULL,     -- NULL = every relation type
        p_limit     int     DEFAULT 40,       -- a QUERY limit over the ranking
        p_refuted   boolean DEFAULT false,    -- include edges the fold consensus.refuted
        p_rank      text    DEFAULT 'edge_rank')  -- 'edge_rank' | 'eff_mu'
    RETURNS TABLE(direction text, type_id bytea, neighbour_id bytea,
                  rating bigint, rd bigint, volatility bigint, witness_count bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH key AS (SELECT encode(p_subject,'hex')::public.blake3 AS id),
    native_claims AS MATERIALIZED (
        SELECT c.* FROM key k CROSS JOIN LATERAL public.laplace_claims_each(
            ARRAY[k.id],NULL::bigint,ARRAY[public.laplace_bank_bit('kind','claim')],
            '{}'::public.blake3[]) c
        WHERE (p_direction IN ('out','both') AND public.laplace_path_starts(c.path,k.id))
           OR (p_direction IN ('in','both') AND public.laplace_path_ends(c.path,k.id))
    ), parts AS MATERIALIZED (
        SELECT * FROM public.laplace_constituents(ARRAY(SELECT entity FROM native_claims))
    ), previews AS MATERIALIZED (
        SELECT * FROM public.laplace_claim_preview(ARRAY(SELECT entity FROM native_claims))
    ), native_edges AS MATERIALIZED (
        SELECT c.entity,
               CASE WHEN public.laplace_path_starts(c.path,k.id) AND p_direction<>'in' THEN 'out' ELSE 'in' END AS direction,
               decode(v.predicate::text,'hex') AS type_id,
               CASE WHEN public.laplace_path_starts(c.path,k.id) AND p_direction<>'in'
                    THEN decode(v.object::text,'hex') ELSE decode(s.child::text,'hex') END AS neighbour_id,
               round(c.rating::numeric*1e9)::bigint AS rating,
               round(c.deviation::numeric*1e9)::bigint AS rd,
               round(c.volatility::numeric*1e9)::bigint AS volatility
        FROM native_claims c CROSS JOIN key k JOIN previews v ON v.entity=c.entity
        JOIN parts s ON s.entity=c.entity AND s.ordinal=1
        WHERE (p_types IS NULL OR decode(v.predicate::text,'hex')=ANY(p_types))
          AND (p_refuted OR NOT consensus.refuted(round(c.rating::numeric*1e9)::bigint,round(c.deviation::numeric*1e9)::bigint))
        ORDER BY CASE WHEN p_rank='edge_rank' THEN consensus.edge_rank(
            decode(v.predicate::text,'hex'),round((c.rating-2*c.deviation)::numeric*1e9)::bigint)
            ELSE c.rating-2*c.deviation END DESC,c.entity LIMIT p_limit
    ), provenance AS MATERIALIZED (
        SELECT a.claim,count(*) AS witnesses
        FROM public.laplace_attribution(ARRAY(SELECT entity FROM native_edges)) a GROUP BY a.claim
    )
    SELECT e.direction, e.type_id, e.neighbour_id,
           e.rating, e.rd, e.volatility, e.witness_count
    FROM (
        SELECT n.direction,n.type_id,n.neighbour_id,n.rating,n.rd,n.volatility,
               coalesce(p.witnesses,0)::bigint AS witness_count
        FROM native_edges n LEFT JOIN provenance p ON p.claim=n.entity
        WHERE p_refuted OR NOT consensus.refuted(n.rating,n.rd)
        UNION ALL
        SELECT 'out'::text AS direction, c.type_id, c.object_id AS neighbour_id,
               c.rating, c.rd, c.volatility, c.witness_count
        FROM laplace.consensus c
        WHERE p_direction IN ('out', 'both')
          AND c.subject_id = p_subject
          AND NOT EXISTS(SELECT FROM public.entity WHERE id=encode(p_subject,'hex')::public.blake3)
          AND c.object_id IS NOT NULL
          AND (p_types IS NULL OR c.type_id = ANY (p_types))
          AND (p_refuted OR NOT consensus.refuted(c.rating, c.rd))
        UNION ALL
        SELECT 'in'::text, c.type_id, c.subject_id,
               c.rating, c.rd, c.volatility, c.witness_count
        FROM laplace.consensus c
        WHERE p_direction IN ('in', 'both')
          AND c.object_id = p_subject
          AND NOT EXISTS(SELECT FROM public.entity WHERE id=encode(p_subject,'hex')::public.blake3)
          -- SELF-EDGE, ONCE PER SCAN. An edge whose object IS its subject satisfies BOTH
          -- arms, so 'both' emitted it twice — identical in every column but `direction`.
          -- That is one row mirrored, not two observations, and it costs a slot in the
          -- LIMIT below: measured 2026-08-16 over twelve common nouns at p_limit=12, cat,
          -- green, house and run each spent 2 of 12 slots on the same mirrored self-edge,
          -- displacing real strands from a fixed-width beam.
          --
          -- Suppressed on the INBOUND arm because the outbound arm already emitted it and
          -- 'out' is the direction the core returns. Guarded on p_direction so an 'in'-only
          -- scan still yields it — there the outbound arm never ran, and dropping it would
          -- turn a duplicate into a silent omission.
          AND (p_direction = 'in' OR c.subject_id <> p_subject)
          AND (p_types IS NULL OR c.type_id = ANY (p_types))
          AND (p_refuted OR NOT consensus.refuted(c.rating, c.rd))
    ) e
    ORDER BY CASE WHEN p_rank = 'edge_rank'
                  THEN consensus.edge_rank(e.type_id, consensus.eff_mu(e.rating, e.rd))
                  ELSE (consensus.eff_mu(e.rating, e.rd))::float8 / 1e9
             END DESC,
             e.neighbour_id,
             e.type_id,
             CASE e.direction WHEN 'out' THEN 0 ELSE 1 END
    LIMIT p_limit;
END;
