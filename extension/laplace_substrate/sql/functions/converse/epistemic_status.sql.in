-- converse.epistemic_status_core — the VERDICT rule alone, numeric end to end.
-- Split out 2026-08-21: ops.entity_record needs four counts, but the only surface
-- carrying the rule also rendered + realized up to p_limit object texts
-- (render_text_batch AND realize.batch) that a counter throws away. MEASURED on a
-- hot entity (Carlsen, limit 500): 1,984 ms through the rendering wrapper, 308 ms
-- through this core — identical counts (8/0/0/317). One rule, two consumers:
-- epistemic_status adds the text; counters stop paying for it.
DROP FUNCTION IF EXISTS converse.epistemic_status_core(bytea, int);
CREATE OR REPLACE FUNCTION converse.epistemic_status_core(p_word bytea, p_limit int DEFAULT 30)
    RETURNS TABLE(type_id bytea, object_id bytea, status text, rating bigint,
                  rd bigint, volatility bigint, witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    WITH subj(id) AS (SELECT p_word UNION SELECT sn.synset_id FROM lexical.senses(p_word) sn),
         rels AS (
            SELECT c.type_id, c.object_id, c.rating, c.rd, c.volatility, c.witness_count
            FROM laplace.consensus c JOIN subj s ON c.subject_id = s.id
            WHERE c.object_id IS NOT NULL
              AND c.type_id NOT IN (laplace.relation_type_id('HAS_SENSE'),
                                    laplace.relation_type_id('IS_SENSE_OF'),
                                    laplace.relation_type_id('HAS_LANGUAGE'))
            ORDER BY consensus.edge_rank(c.type_id, consensus.eff_mu(c.rating, c.rd)) DESC
            LIMIT p_limit)
    SELECT r.type_id, r.object_id,
           CASE WHEN consensus.refuted(r.rating, r.rd) THEN 'refuted'
                WHEN consensus.eff_mu(r.rating, r.rd) > consensus.glicko2_neutral_mu() THEN 'confirmed'
                WHEN r.volatility::numeric > consensus.glicko2_initial_volatility() * 1.5 THEN 'contested'
                ELSE 'thin' END,
           r.rating, r.rd, r.volatility, r.witness_count
    FROM rels r
    ORDER BY consensus.edge_rank(r.type_id, consensus.eff_mu(r.rating, r.rd)) DESC
$$;

-- converse.epistemic_status — GH #862 / #860. No SET, real schema names.
-- The verdict rule lives in epistemic_status_core; this wrapper ADDS the rendered
-- fact text and type labels for surfaces that show them.
DROP FUNCTION IF EXISTS laplace.epistemic_status(bytea, bytea, int);
CREATE OR REPLACE FUNCTION converse.epistemic_status(p_word bytea, p_lang bytea DEFAULT NULL,
                                            p_limit int DEFAULT 30)
    RETURNS TABLE(type text, fact text, status text, mu numeric,
                  volatility numeric, witnesses bigint)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    WITH rels AS MATERIALIZED (
            SELECT * FROM converse.epistemic_status_core(p_word, p_limit)),
         lang(id) AS (SELECT COALESCE(p_lang, converse.word_language(p_word))),
         object_ids AS MATERIALIZED (
            SELECT array_agg(DISTINCT object_id ORDER BY object_id) AS a FROM rels),
         rendered AS (
            SELECT i.id,NULLIF(r.s,'') AS rendered,z.s AS realized
            FROM object_ids,
              LATERAL unnest(object_ids.a) WITH ORDINALITY i(id,ord),
              LATERAL unnest(realize.render_text_batch(object_ids.a))
                WITH ORDINALITY r(s,ord),
              LATERAL unnest(realize.batch(object_ids.a,(SELECT id FROM lang)))
                WITH ORDINALITY z(s,ord)
            WHERE i.ord=r.ord AND i.ord=z.ord
         ),
         type_ids AS MATERIALIZED (
            SELECT array_agg(DISTINCT type_id ORDER BY type_id) AS a FROM rels),
         type_labels AS (
            SELECT i.id,t.s AS type_label
            FROM type_ids,
              LATERAL unnest(type_ids.a) WITH ORDINALITY i(id,ord),
              LATERAL unnest(lexical.type_label_batch(type_ids.a))
                WITH ORDINALITY t(s,ord)
            WHERE i.ord=t.ord
         )
    SELECT td.type_label,
           COALESCE(rd.rendered, rd.realized),
           r.status,
           consensus.eff_mu_display(r.rating, r.rd),
           round(r.volatility / 1e9, 4), r.witnesses
    FROM rels r
    LEFT JOIN rendered rd ON rd.id = r.object_id
    LEFT JOIN type_labels td ON td.id = r.type_id
    ORDER BY consensus.edge_rank(r.type_id, consensus.eff_mu(r.rating, r.rd)) DESC
$$;
