-- Bulk constituent closure for native no-SPI render assembly (R1).
-- The C realize.render(generate_walk.c) runs this ONCE per render call and assembles text in C.
--
-- History / why this shape: the prior version called the SQL wrapper realize.constituents(id) per
-- node — and realize.constituents() is NON-INLINABLE (ORDER BY ... LIMIT 1 + a lateral SRF), so the
-- planner emitted a real function-call per node, in BOTH the recursive term AND the final
-- projection (every node expanded twice, through the slow path). Rendering ~15 short names
-- fanned into hundreds of per-node function calls and timed out under load.
--
-- This version removes the per-node function entirely and keeps the work bounded:
--   * reach  — node-recursion (dedup on entity_id, so a shared node is expanded once per depth
--               it is reached at, NOT once per incoming edge; edge-recursion would re-expand a
--               common word/codepoint once per parent — a fan-in blow-up on real documents).
--               The physicalities probe + trajectory SRF are INLINED, not the realize.constituents()
--               wrapper.
--   * picked — ONE physicalities row per reached node, chosen SET-BASED via DISTINCT ON over a
--               join, replacing N correlated `ORDER BY id LIMIT 1` subqueries with one sort.
--   * final  — expand each distinct node exactly once to emit its edges.
-- Termination: the content law makes the constituent DAG acyclic (constituents are strictly
-- lower-tier), and the depth cap is a belt-and-braces bound; leaves (codepoints, no type-1
-- trajectory) yield zero rows and stop the descent.
DROP FUNCTION IF EXISTS laplace.constituents_closure(bytea[], integer);
CREATE OR REPLACE FUNCTION realize.constituents_closure(
    p_roots bytea[],
    p_max_depth integer DEFAULT 32
)
RETURNS TABLE(
    parent_id bytea,
    ordinal integer,
    child_id bytea,
    run_length integer,
    flags bigint
)
LANGUAGE sql STABLE PARALLEL SAFE
-- NO `SET search_path`. MEASURED 2026-08-07: this function was 59 ms to return
-- three rows, of which ~30 ms was PLANNING. A SET clause invalidates plan caching --
-- the body is re-planned on every invocation because the search_path in effect can
-- change what an unqualified name resolves to. Without it the plan is cached for the
-- session, and this is the most-called query in the system (1,496,183 calls), so 30 ms
-- of planner work was being paid a million and a half times for a walk that executes
-- in 5 ms.
AS $$
WITH RECURSIVE reach(entity_id, depth) AS (
    SELECT r.id, 0
    FROM unnest(COALESCE(p_roots, ARRAY[]::bytea[])) AS r(id)
    WHERE r.id IS NOT NULL
    UNION
    SELECT u.entity_id, rc.depth + 1
    FROM reach rc
    CROSS JOIN LATERAL (
        -- SAME TIEBREAK AS `picked`, AND IT IS THE SAME LAW. `physicality_id`
        -- alone does not order these rows: 5,063 entities carry two type-1 rows
        -- with the same (entity_id, type, id) and DIFFERENT trajectories, so the
        -- plan chose which one won. `picked` was given ST_NPoints DESC for that
        -- reason and this arm was not, which let the RECURSION walk one
        -- decomposition while the RENDER walked the other -- the traversal and
        -- the output disagreeing about what a node contains. ST_NPoints DESC
        -- prefers the finer decomposition, the one that reaches the tier-0 floor
        -- and reconstructs the text, which is what both arms are walking for.
        -- Cost here is per node, over that node's 1-2 candidate rows, not over
        -- the whole node set: the ~11 ms figure in `picked` is a sort across
        -- every node, not a per-row price.
        SELECT w.trajectory
        FROM laplace.v_word_points w
        WHERE w.id = rc.entity_id AND w.trajectory IS NOT NULL
        ORDER BY w.physicality_id, public.ST_NPoints(w.trajectory) DESC
        LIMIT 1
    ) ph
    CROSS JOIN LATERAL public.laplace_trajectory_constituents(ph.trajectory) AS u
    WHERE rc.depth < GREATEST(COALESCE(p_max_depth, 32), 0)
),
node AS (
    SELECT DISTINCT entity_id
    FROM reach
    WHERE depth < GREATEST(COALESCE(p_max_depth, 32), 0)
),
picked AS (
    -- One physicalities row per node, set-based (not a per-node LIMIT 1).
    --
    -- THE TIEBREAK IS LOAD-BEARING. `ORDER BY p2.entity_id, p2.id` alone is NOT
    -- deterministic here: 5,063 entities carry TWO type-1 rows with the SAME
    -- (entity_id, type, id) and DIFFERENT trajectories, because the same content
    -- is stored at tier 2 and tier 3 with two decompositions. mince.01 has an
    -- 8-point word decomposition (m|i|n|c|e|.|0|1) and a 3-point sentence one
    -- (mince|.|01) under one physicality id.
    --
    -- With the sort key tied, the PLAN decides which survives — so batch size
    -- changed the answer: render_text_batch returned mince.01 for a 1-id array
    -- and NULL for the same id inside a 500-id array, because the two calls got
    -- different plans and therefore different trajectories. Every consumer of
    -- render_text_batch inherits that: realize_batch, and through it related,
    -- related_in, salient_facts, converse.chat()'s band lens and consensus.edges().
    --
    -- ST_NPoints DESC breaks the tie deterministically and prefers the FINER
    -- decomposition — the one that reaches the tier-0 floor and reconstructs the
    -- text, which is what render walks for. Same answer every call, every batch
    -- size, every plan.
    --
    -- This makes reads deterministic; it does NOT fix the duplication. Two rows
    -- sharing a physicality id means that id is not a function of what it holds,
    -- and the tier-2/tier-3 pair means collapse_idx did not fire for content that
    -- is span-identical to its own single child. Both are upstream of here.
    -- ST_NPoints costs ~11 ms of this function's ~14 ms execution (measured
    -- 2026-08-07: 2.7 ms without it in the sort key, 14.1 ms with), and only 5,063
    -- entities in the substrate actually need the tiebreak. Splitting it so single-
    -- candidate ids skip PostGIS is the right optimisation and it is NOT done here:
    -- the obvious form puts a DISTINCT ON arm under a UNION ALL, where the trailing
    -- ORDER BY binds to the whole union and the alias is out of scope. It needs each
    -- arm self-contained in its own subquery. Left as written rather than shipped
    -- half-right -- the SET removal above is the larger win (~30 ms of per-call
    -- planning) and is independent of this.
    SELECT DISTINCT ON (w.id) w.id AS entity_id, w.trajectory
    FROM laplace.v_word_points w
    JOIN node n ON n.entity_id = w.id
    WHERE w.trajectory IS NOT NULL
    ORDER BY w.id, w.physicality_id, public.ST_NPoints(w.trajectory) DESC
)
SELECT pk.entity_id AS parent_id, u.ordinal, u.entity_id AS child_id, u.run_length, u.flags
FROM picked pk
CROSS JOIN LATERAL public.laplace_trajectory_constituents(pk.trajectory) AS u
ORDER BY pk.entity_id, u.ordinal
$$;
