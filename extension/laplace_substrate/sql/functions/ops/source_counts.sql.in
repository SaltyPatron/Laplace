DROP FUNCTION IF EXISTS laplace.source_counts();
CREATE OR REPLACE FUNCTION ops.source_counts()
    RETURNS TABLE(source text, source_id bytea, evidence bigint, content bigint)
    LANGUAGE plpgsql STABLE
AS $source_counts$
BEGIN
    IF to_regclass('public.entity') IS NOT NULL THEN
        RETURN QUERY SELECT c.source,c.source_id,c.evidence_approx,NULL::bigint FROM ops.source_counts_approx() c;
        RETURN;
    END IF;
    RETURN QUERY
    WITH raw AS MATERIALIZED (
    SELECT COALESCE(ev.sid, ct.sid)                     AS source_id,
           COALESCE(ev.evidence, 0)                     AS evidence,
           COALESCE(ct.content, 0)                      AS content



    FROM (SELECT a.source_id AS sid, count(*) AS evidence
          FROM @extschema@.attestations a GROUP BY a.source_id) ev
    FULL JOIN (SELECT s.source_id AS sid, count(*) AS content
               FROM (SELECT DISTINCT a.source_id, a.subject_id
                     FROM @extschema@.attestations a) s
               WHERE EXISTS (SELECT 1 FROM @extschema@.physicalities p
                             WHERE p.entity_id = s.subject_id AND p.type = 1)
               GROUP BY s.source_id) ct
      ON ev.sid = ct.sid
    ), numbered AS MATERIALIZED (
      SELECT r.*, row_number() OVER (ORDER BY r.evidence DESC NULLS LAST, r.source_id) AS rn FROM raw r
    ), batch AS MATERIALIZED (
      SELECT realize.render_batch(array_agg(source_id ORDER BY rn)) AS labels FROM numbered
    )
    SELECT b.labels[n.rn], n.source_id, n.evidence, n.content
    FROM numbered n CROSS JOIN batch b ORDER BY n.rn;
END
$source_counts$;
