-- The governed relation registry: one row per assigned highway bit, from the compiled
-- relation law and the highway perfcache. Relation types are registry bits, not
-- substrate entities; readers that need the relation roster enumerate this.
CREATE OR REPLACE FUNCTION laplace.relation_registry()
    RETURNS TABLE(highway_bit smallint, type_id bytea, canonical text, band smallint,
                  rank real, symmetric boolean, family_root bytea, parent bytea)
    AS 'MODULE_PATHNAME', 'pg_laplace_relation_registry'
    LANGUAGE C STABLE PARALLEL SAFE ROWS 256;
