-- converse.chat_scaffold — per-language connective templates for converse.chat.
--
-- GH #901: converse.chat()'s render side was gluing realized labels with hardcoded English
-- connectives while the parse side and language tally were language-agnostic.
-- A Bulgarian prompt correctly resolved lang, then wrapped Bulgarian labels in
-- English scaffolding — the 2026-07-25 Bulgarian-dog defect one layer down.
--
-- This is the minimal per-language template table (keyed on the resolved lang
-- id). English and Bulgarian ship as first citizens (the two languages that
-- exposed the defect). Every other lang falls back to a typographic form that
-- carries no English verbs: "Topic: labels." That is honest S9 fallback, not a
-- pretend translation. Connectives-as-realized-entities through consensus remains
-- the longer inventively-correct path; this stops the lie now.
--
-- p_key is a fixed slot name (parts / kinds / related / core / no_edges / no_type /
-- no_forward / band). p_topic and p_labels / p_extra fill the slots. Missing
-- pieces yield NULL so the caller can decide, not empty-string silence.
DROP FUNCTION IF EXISTS laplace.chat_scaffold(bytea, text, text, text, text);
CREATE OR REPLACE FUNCTION converse.chat_scaffold(
        p_lang   bytea,
        p_key    text,
        p_topic  text DEFAULT NULL,
        p_labels text DEFAULT NULL,
        p_extra  text DEFAULT NULL)
    RETURNS text
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH vars AS (
        SELECT COALESCE(p_topic, '') AS t,
               COALESCE(p_labels, '') AS l,
               COALESCE(p_extra, '') AS x
    )
    SELECT CASE
        WHEN p_key IS NULL THEN NULL::text
        WHEN p_lang IS NULL OR p_lang = realize.canonical_id('language:eng') THEN
            CASE p_key
                WHEN 'parts'      THEN initcap(v.t) || ' has parts such as ' || v.l || '.'
                WHEN 'kinds'      THEN 'Kinds of ' || v.t || ' include ' || v.l || '.'
                WHEN 'related'    THEN initcap(v.t) || ' is related to ' || v.l || '.'
                WHEN 'core'       THEN 'That is the core of what I hold about ' || v.t || '.'
                WHEN 'no_edges'   THEN 'I hold no witnessed edges for ' || v.t || ' in the selected bands yet.'
                WHEN 'no_type'    THEN 'I hold no witnessed ' || lower(v.x) || ' for ' || v.t || ' yet.'
                WHEN 'no_forward' THEN CASE WHEN v.t = ''
                                       THEN 'No witnessed continuation was selected in this forward pass.'
                                       ELSE 'No witnessed continuation was selected for ' || v.t || ' in this forward pass.'
                                   END
                WHEN 'band'       THEN v.x || ': ' || v.l || '.'
                ELSE NULL::text
            END
        WHEN p_lang = realize.canonical_id('language:bul') THEN
            CASE p_key
                WHEN 'parts'      THEN initcap(v.t) || ' има части като ' || v.l || '.'
                WHEN 'kinds'      THEN 'Видове ' || v.t || ' включват ' || v.l || '.'
                WHEN 'related'    THEN initcap(v.t) || ' е свързано с ' || v.l || '.'
                WHEN 'core'       THEN 'Това е същността на това, което знам за ' || v.t || '.'
                WHEN 'no_edges'   THEN 'Нямам засвидетелствани връзки за ' || v.t || ' в избраните ленти още.'
                WHEN 'no_type'    THEN 'Нямам засвидетелствано ' || lower(v.x) || ' за ' || v.t || ' още.'
                WHEN 'no_forward' THEN CASE WHEN v.t = ''
                                       THEN 'Няма избрано засвидетелствано продължение в този ход.'
                                       ELSE 'Няма избрано засвидетелствано продължение за ' || v.t || ' в този ход.'
                                   END
                WHEN 'band'       THEN v.x || ': ' || v.l || '.'
                ELSE NULL::text
            END
        ELSE
            CASE p_key
                WHEN 'parts'      THEN initcap(v.t) || ': ' || v.l || '.'
                WHEN 'kinds'      THEN initcap(v.t) || ': ' || v.l || '.'
                WHEN 'related'    THEN initcap(v.t) || ': ' || v.l || '.'
                WHEN 'core'       THEN initcap(v.t) || '.'
                WHEN 'no_edges'   THEN initcap(v.t) || '.'
                WHEN 'no_type'    THEN initcap(v.t) || '.'
                WHEN 'no_forward' THEN CASE WHEN v.t = '' THEN '∅' ELSE v.t || ': ∅' END
                WHEN 'band'       THEN v.l || '.'
                ELSE NULL::text
            END
    END
    FROM vars v;
END;
