-- Canonical entities are HASH(id)-partitioned.  type_id/tier are compatibility
-- summaries over explicit entity_interpretations, so physical row order is hash
-- order and a BRIN on either summary has no locality to exploit.  Do not charge
-- every canonical insert for a non-selective summary index.
DO $do$
BEGIN
    BEGIN
        EXECUTE format('ALTER EXTENSION %I DROP INDEX laplace.entities_tier_type_brin',
                       'laplace_substrate');
    EXCEPTION WHEN OTHERS THEN
        NULL;
    END;
    EXECUTE 'DROP INDEX IF EXISTS laplace.entities_tier_type_brin';
END $do$;
