-- Canonical entity identity is the content id. Tier/type/source are observed
-- structural/typing projections and must never participate in uniqueness.
--
-- The compatibility columns on `entities` remain a deterministic summary for
-- existing readers while `entity_interpretations` retains every distinct
-- (id,tier,type) observation. On a repeated id the summary converges by byte/
-- numeric minimum rather than arrival order; no second logical entity can be
-- created. New readers that care about tier/type multiplicity must read the
-- interpretation relation, not treat the compatibility summary as authority.
--
-- HASH(id) is the physical layout because ids are content hashes and therefore
-- distribute independently of modality-relative tier. This schema is created in
-- a new database; an existing LIST(tier)/(id,tier) database remains intact and
-- is rejected here until an explicit data-preserving conversion is provided.
CREATE TABLE IF NOT EXISTS entities (
    id                 bytea            NOT NULL CHECK (octet_length(id) = 16),
    tier               smallint         NOT NULL CHECK (tier >= 0 AND tier < 256),
    type_id            bytea            NOT NULL CHECK (octet_length(type_id) = 16),
    first_observed_by  bytea            CHECK (first_observed_by IS NULL OR octet_length(first_observed_by) = 16),
    created_at         timestamptz      NOT NULL DEFAULT now(),
    highway_mask       bytea            CHECK (highway_mask IS NULL OR octet_length(highway_mask) = 32),
    PRIMARY KEY (id)
) PARTITION BY HASH (id);

DO $$
DECLARE
    b int;
    suffix text;
    strategy "char";
    opts constant text := ' SET (autovacuum_analyze_scale_factor = 0.02, autovacuum_analyze_threshold = 100000)';
BEGIN
    IF (SELECT c.relkind FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
        WHERE n.nspname = current_schema() AND c.relname = 'entities') <> 'p' THEN
        RAISE EXCEPTION
            'entities uses a legacy non-partitioned layout; canonical entity identity is id-only and this version requires HASH(id). Create a new canonical database and retain the existing database for transfer or rollback.';
    END IF;

    SELECT p.partstrat INTO strategy
    FROM pg_partitioned_table p
    WHERE p.partrelid = (current_schema() || '.entities')::regclass;
    IF strategy <> 'h' THEN
        RAISE EXCEPTION
            'entities uses obsolete partition strategy %; canonical entity identity is id-only and this version requires HASH(id). Create a new canonical database and retain the existing database for transfer or rollback.',
            strategy;
    END IF;

    IF to_regclass(current_schema() || '.entities_h00') IS NOT NULL THEN
        RETURN;
    END IF;

    FOR b IN 0..63 LOOP
        suffix := lpad(to_hex(b), 2, '0');
        EXECUTE format('CREATE TABLE entities_h%s PARTITION OF entities FOR VALUES WITH (MODULUS 64, REMAINDER %s)',
                       suffix, b);
        EXECUTE format('ALTER TABLE entities_h%s', suffix) || opts;
    END LOOP;
END $$;

-- Explicit home for structural altitude/type observations. Distinct sources
-- witnessing the same interpretation converge on the same row; provenance of
-- semantic claims remains in attestations, while first_observed_by is retained
-- only as non-authoritative compatibility metadata.
CREATE TABLE IF NOT EXISTS entity_interpretations (
    entity_id          bytea        NOT NULL CHECK (octet_length(entity_id) = 16),
    tier               smallint     NOT NULL CHECK (tier >= 0 AND tier < 256),
    type_id            bytea        NOT NULL CHECK (octet_length(type_id) = 16),
    first_observed_by  bytea        CHECK (first_observed_by IS NULL OR octet_length(first_observed_by) = 16),
    observed_at        timestamptz  NOT NULL DEFAULT now(),
    PRIMARY KEY (entity_id, tier, type_id)
) PARTITION BY HASH (entity_id);

DO $$
DECLARE
    b int;
    suffix text;
    opts constant text := ' SET (autovacuum_analyze_scale_factor = 0.02, autovacuum_analyze_threshold = 100000)';
BEGIN
    IF to_regclass(current_schema() || '.entity_interpretations_h00') IS NOT NULL THEN
        RETURN;
    END IF;
    FOR b IN 0..63 LOOP
        suffix := lpad(to_hex(b), 2, '0');
        EXECUTE format('CREATE TABLE entity_interpretations_h%s PARTITION OF entity_interpretations FOR VALUES WITH (MODULUS 64, REMAINDER %s)',
                       suffix, b);
        EXECUTE format('ALTER TABLE entity_interpretations_h%s', suffix) || opts;
    END LOOP;
END $$;

-- Storage invariant fallback. The normal ingest spine publishes all
-- interpretations set-wise after canonical COPY in the same control transaction.
-- Direct SQL/legacy callers still pass through here, so no caller can create a
-- second logical entity or lose a previously unseen tier/type interpretation.
CREATE OR REPLACE FUNCTION @extschema@.entity_identity_admit()
RETURNS trigger
LANGUAGE plpgsql
AS $$
DECLARE
    summary_tier smallint;
    summary_type bytea;
    summary_source bytea;
BEGIN
    -- The outer trigger owns interpretation admission. Its inner canonical upsert
    -- re-enters this trigger only to let PostgreSQL's id primary key perform the
    -- same-id serialization; do not recursively publish the facet a second time.
    IF pg_trigger_depth() > 1 THEN
        RETURN NEW;
    END IF;

    INSERT INTO @extschema@.entity_interpretations AS ei(
        entity_id, tier, type_id, first_observed_by)
    VALUES (NEW.id, NEW.tier, NEW.type_id, NEW.first_observed_by)
    ON CONFLICT (entity_id, tier, type_id) DO UPDATE
       SET first_observed_by = CASE
             WHEN ei.first_observed_by IS NULL THEN EXCLUDED.first_observed_by
             WHEN EXCLUDED.first_observed_by IS NULL THEN ei.first_observed_by
             WHEN ei.first_observed_by <= EXCLUDED.first_observed_by THEN ei.first_observed_by
             ELSE EXCLUDED.first_observed_by
           END
     WHERE EXCLUDED.first_observed_by IS NOT NULL
       AND (ei.first_observed_by IS NULL
            OR EXCLUDED.first_observed_by < ei.first_observed_by);

    -- Include every already-committed interpretation, not only NEW, so an ordinary
    -- insert also repairs a stale compatibility summary. A concurrent first writer
    -- can still be invisible here; the canonical id upsert below combines this
    -- summary monotonically with the row that won the primary-key race.
    SELECT min(i.tier)::smallint,
           (array_agg(i.type_id ORDER BY i.type_id))[1],
           (array_agg(i.first_observed_by ORDER BY i.first_observed_by)
               FILTER (WHERE i.first_observed_by IS NOT NULL))[1]
      INTO summary_tier, summary_type, summary_source
      FROM @extschema@.entity_interpretations i
     WHERE i.entity_id = NEW.id;

    -- Use the canonical entity row itself as the concurrency owner. Concurrent
    -- inserts for different content ids stay independent; concurrent inserts for
    -- the same id meet at the primary key and fold summaries by deterministic
    -- minima after PostgreSQL resolves the conflict. No global advisory mutex is
    -- required, and transaction-sized COPY batches do not accumulate per-id locks.
    INSERT INTO @extschema@.entities AS e(
        id, tier, type_id, first_observed_by, created_at, highway_mask)
    VALUES (
        NEW.id, summary_tier, summary_type, summary_source,
        NEW.created_at, NEW.highway_mask)
    ON CONFLICT (id) DO UPDATE
       SET tier = LEAST(e.tier, EXCLUDED.tier),
           type_id = CASE
             WHEN e.type_id <= EXCLUDED.type_id THEN e.type_id
             ELSE EXCLUDED.type_id
           END,
           first_observed_by = CASE
             WHEN e.first_observed_by IS NULL THEN EXCLUDED.first_observed_by
             WHEN EXCLUDED.first_observed_by IS NULL THEN e.first_observed_by
             WHEN e.first_observed_by <= EXCLUDED.first_observed_by THEN e.first_observed_by
             ELSE EXCLUDED.first_observed_by
           END
     WHERE (e.tier, e.type_id, e.first_observed_by)
           IS DISTINCT FROM
           (LEAST(e.tier, EXCLUDED.tier),
            CASE WHEN e.type_id <= EXCLUDED.type_id THEN e.type_id ELSE EXCLUDED.type_id END,
            CASE
              WHEN e.first_observed_by IS NULL THEN EXCLUDED.first_observed_by
              WHEN EXCLUDED.first_observed_by IS NULL THEN e.first_observed_by
              WHEN e.first_observed_by <= EXCLUDED.first_observed_by THEN e.first_observed_by
              ELSE EXCLUDED.first_observed_by
            END);

    -- The inner upsert performed the physical insert/update. Suppress the outer
    -- row so it cannot attempt a second insert after the same-id race is resolved.
    RETURN NULL;
END;
$$;

DROP TRIGGER IF EXISTS entity_identity_admit ON entities;
CREATE TRIGGER entity_identity_admit
BEFORE INSERT ON entities
FOR EACH ROW EXECUTE FUNCTION @extschema@.entity_identity_admit();

SELECT pg_extension_config_dump('entities', '');
SELECT pg_extension_config_dump('entity_interpretations', '');