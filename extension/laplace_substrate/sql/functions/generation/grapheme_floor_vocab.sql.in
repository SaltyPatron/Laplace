DROP FUNCTION IF EXISTS laplace.grapheme_floor_vocab(int, int);
CREATE OR REPLACE FUNCTION generation.grapheme_floor_vocab(p_size int DEFAULT 512, p_words int DEFAULT 50000)
    RETURNS TABLE(entity_id bytea, surface text, weight bigint)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    
    
    
    
    WITH t AS (
        SELECT w.trajectory
        FROM laplace.v_word_points w
        WHERE w.type_id = laplace.canonical_id('Word')
          AND w.trajectory IS NOT NULL
        ORDER BY w.id LIMIT p_words
    ),
    g AS (
        SELECT tc.entity_id, tc.run_length
        FROM t CROSS JOIN LATERAL laplace_trajectory_constituents(t.trajectory) tc
    ),
    agg AS (
        
        
        SELECT g.entity_id, sum(GREATEST(g.run_length,1))::bigint AS cnt
        FROM g JOIN laplace.entities e ON e.id = g.entity_id AND e.type_id IN (laplace.canonical_id('Codepoint'), laplace.canonical_id('Grapheme'))
        GROUP BY g.entity_id
    ),
    named AS (
        SELECT a.entity_id, laplace.render_text(a.entity_id, 8) AS s, a.cnt
        FROM agg a ORDER BY a.cnt DESC LIMIT p_size * 2
    )
    SELECT n.entity_id, n.s, n.cnt
    FROM named n
    WHERE char_length(n.s) = 1 AND NOT laplace.is_all_whitespace(n.s)
    ORDER BY n.cnt DESC LIMIT p_size
$$;
