-- Leading 64 bits of a content id as bigint: the one lo64 helper for seeds,
-- advisory locks, and walk RNG.
CREATE OR REPLACE FUNCTION laplace.hash128_lo(p_id bytea)
    RETURNS bigint
    LANGUAGE sql
    IMMUTABLE
    STRICT
    PARALLEL SAFE
BEGIN ATOMIC
    SELECT ('x' || encode(substring(p_id FOR 8), 'hex'))::bit(64)::bigint;
END;
