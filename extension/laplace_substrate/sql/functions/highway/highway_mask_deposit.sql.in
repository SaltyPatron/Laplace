-- Deposit highway-mask bits for the (entity, relation-type) pairs an epoch's
-- edges actually touched — the fold KNOWS every pair in RAM, so the mask is
-- populated at deposit time with ZERO consensus re-reads. This replaces the
-- per-epoch highway_mask_refresh recompute, whose object-side join probed every
-- consensus leaf per touched entity (measured: 75s of a 118s fold).
-- OR-accumulate is correct at ingest: edges are only ever ADDED, so bits only
-- ever turn on; idempotent and chunk-order-free. On a greenfield seed this
-- deposit IS the population — highway_mask_refresh/rebuild are repair verbs for
-- pre-deposit databases and for bit-clearing maintenance.
--
-- The Highway registry is an acceleration dependency, not permission to lose
-- state. If it is temporarily unavailable, preserve the exact zipped
-- (entity,type) pairs in laplace.highway_mask_pending. Once the registry is
-- available, laplace.highway_mask_pending_drain() replays those exact pairs
-- through the same native OR path. No consensus re-read is required for the
-- missed-write window.
DROP FUNCTION IF EXISTS laplace.highway_mask_deposit(bytea[], bytea[]);
DROP FUNCTION IF EXISTS consensus.highway_mask_deposit(bytea[], bytea[]);
DROP FUNCTION IF EXISTS consensus.highway_mask_deposit_native(bytea[], bytea[]);

CREATE OR REPLACE FUNCTION consensus.highway_mask_deposit_native(
    p_entity_ids bytea[], p_type_ids bytea[])
    RETURNS bigint
    AS 'MODULE_PATHNAME', 'pg_laplace_highway_mask_deposit'
    LANGUAGE C VOLATILE;

CREATE OR REPLACE FUNCTION consensus.highway_mask_deposit(
    p_entity_ids bytea[], p_type_ids bytea[])
    RETURNS bigint
    LANGUAGE plpgsql VOLATILE AS $$
DECLARE
    n_entities int := COALESCE(cardinality(p_entity_ids), 0);
    n_types int := COALESCE(cardinality(p_type_ids), 0);
BEGIN
    IF n_entities <> n_types THEN
        RAISE EXCEPTION 'highway_mask_deposit: entity/type arrays must share length (% vs %)',
            n_entities, n_types;
    END IF;
    IF n_entities = 0 THEN
        RETURN 0;
    END IF;
    IF EXISTS (
        SELECT 1
        FROM unnest(p_entity_ids, p_type_ids) AS p(entity_id, type_id)
        WHERE (entity_id IS NOT NULL AND octet_length(entity_id) <> 16)
           OR (type_id IS NOT NULL AND octet_length(type_id) <> 16)
    ) THEN
        RAISE EXCEPTION 'highway_mask_deposit: entity/type ids must be exactly 16 bytes';
    END IF;

    IF consensus.highway_ready() THEN
        RETURN consensus.highway_mask_deposit_native(p_entity_ids, p_type_ids);
    END IF;

    INSERT INTO laplace.highway_mask_pending(entity_id, type_id)
    SELECT p.entity_id, p.type_id
    FROM unnest(p_entity_ids, p_type_ids) AS p(entity_id, type_id)
    WHERE p.entity_id IS NOT NULL AND p.type_id IS NOT NULL
    ON CONFLICT (entity_id, type_id) DO NOTHING;

    -- The consensus write remains accepted because its exact mask work has been
    -- durably retained. Returning zero preserves the historical "rows updated"
    -- meaning of this function; queued pairs are not claimed as written masks.
    RETURN 0;
END $$;

DROP PROCEDURE IF EXISTS laplace.highway_mask_pending_drain(int);
CREATE OR REPLACE PROCEDURE laplace.highway_mask_pending_drain(p_batch int DEFAULT 250000)
    LANGUAGE plpgsql AS $$
DECLARE
    entity_ids bytea[];
    type_ids bytea[];
    drained bigint := 0;
    n bigint;
BEGIN
    IF p_batch IS NULL OR p_batch < 1 THEN
        RAISE EXCEPTION 'highway_mask_pending_drain: p_batch must be >= 1';
    END IF;
    IF NOT consensus.highway_ready() THEN
        RAISE LOG 'highway_mask_pending_drain: Highway registry unavailable; exact pending pairs retained';
        RETURN;
    END IF;

    LOOP
        SELECT array_agg(q.entity_id ORDER BY q.entity_id, q.type_id),
               array_agg(q.type_id ORDER BY q.entity_id, q.type_id)
        INTO entity_ids, type_ids
        FROM (
            SELECT entity_id, type_id
            FROM laplace.highway_mask_pending
            ORDER BY entity_id, type_id
            LIMIT p_batch
            FOR UPDATE SKIP LOCKED
        ) AS q;

        EXIT WHEN entity_ids IS NULL;
        PERFORM consensus.highway_mask_deposit_native(entity_ids, type_ids);

        DELETE FROM laplace.highway_mask_pending p
        USING unnest(entity_ids, type_ids) AS q(entity_id, type_id)
        WHERE p.entity_id = q.entity_id AND p.type_id = q.type_id;
        GET DIAGNOSTICS n = ROW_COUNT;
        drained := drained + n;
        RAISE LOG 'highway_mask_pending_drain: % exact pairs drained', drained;
        COMMIT;
    END LOOP;
END $$;
