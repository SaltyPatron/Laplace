-- Declared UNQUALIFIED until 2026-08-10, so it installed wherever search_path
-- pointed -- laplace.evidence_receipt -- while every caller and all three of its
-- siblings in this directory (ops.entity_facets, ops.evidence_count,
-- ops.entity_physicalities) use ops. NpgsqlSubstrateReads.EvidenceReceiptAsync
-- asked for ops.evidence_receipt, got 42883, and because SubstrateClient.Explore
-- fans the nine entity reads through one Task.WhenAll, that single missing
-- function failed the WHOLE Explore entity page as "Explore entity query failed."
DROP FUNCTION IF EXISTS laplace.evidence_receipt(bytea, integer);
CREATE OR REPLACE FUNCTION ops.evidence_receipt(p_id bytea, p_limit integer DEFAULT 25)
    RETURNS TABLE(
        type_id bytea,
        object_id bytea,
        type_label text,
        object_label text,
        eff_mu numeric,
        witness_count bigint,
        source_labels text)
    LANGUAGE sql STABLE
    AS $$
    WITH subj(id) AS (
        SELECT p_id
        UNION
        SELECT sn.synset_id FROM lexical.senses(p_id) sn
    ), feat_dynamic AS MATERIALIZED (
        -- Dynamic HAS_FEATURE children fenced once; consensus.relation_in_family() never
        -- inlines (SET search_path), so calling it per attestation row ran its
        -- EXISTS probe per row. Same truth table: static family via the C check
        -- below, dynamic membership via this set.
        SELECT c.subject_id AS id FROM laplace.consensus c
        WHERE c.type_id = laplace.relation_type_id('IS_A')
          AND c.object_id = laplace.relation_type_id('HAS_FEATURE')
    ), filtered AS MATERIALIZED (
        -- Fenced: without the fence the downstream LIMIT flips the planner into
        -- a cheap-startup nested loop that seq-scans EVERY attestations partition
        -- once per subj id (measured 2026-07-23 on the live 133.5M-row table:
        -- >180s for the "run" hub vs 991ms for this same CTE planned standalone).
        SELECT a.type_id, a.object_id, a.source_id,
               sum(a.observation_count) AS obs
        FROM laplace.attestations a
        WHERE a.subject_id IN (SELECT id FROM subj)
          AND a.object_id IS NOT NULL
          AND EXISTS (
              SELECT 1 FROM laplace.entities et
              WHERE et.id = a.type_id AND et.type_id = laplace.entity_type_id('RelationType'))
          AND a.type_id <> ALL (consensus.relation_family_ids('HAS_POS'))
          AND a.type_id <> ALL (consensus.relation_family_ids('HAS_FEATURE'))
          AND a.type_id NOT IN (SELECT id FROM feat_dynamic)
          AND -- The exclusion set is DECLARED: engine/manifest/relation_types.toml [[set]]
          -- NON_SALIENT_STRUCTURAL. It was a byte-identical 16-name NOT IN list here AND
          -- in the sibling function -- one judgement about what is not a content fact,
          -- kept in two files with nothing holding them in step. `<> ALL` matches the two
          -- family exclusions above and is exactly equivalent to NOT IN here: type_id is
          -- NOT NULL on both laplace.consensus and laplace.attestations (catalog-verified).
          a.type_id <> ALL (consensus.relation_set_ids('NON_SALIENT_STRUCTURAL'))
          -- UNDECLARED VOCABULARY, kept inline deliberately: CO_OCCURS_WITH and
          -- OCCURS_IN_CONTEXT are in neither the manifest's canonicals nor its
          -- aliases, though both exist as live RelationType entities. Codegen
          -- REFUSES a set naming them (an undeclared member would emit NULL and
          -- silently match nothing), and inventing a bit/rank/symmetry for them
          -- is an operator decision. Row counts are deliberately NOT cited as the reason
          -- either way: spec 36's CORRECTION 2026-07-25 retracts exactly that move for this
          -- family of relations ("a low PRECEDES count is not a status signal -- do not cite
          -- it"), because sequence lives in the trajectory and these are views of it.
          AND a.type_id NOT IN (
                laplace.relation_type_id('CO_OCCURS_WITH'),
                laplace.relation_type_id('OCCURS_IN_CONTEXT'))
          AND NOT EXISTS (
              SELECT 1 FROM laplace.entities et
              WHERE et.id = a.object_id AND et.type_id = laplace.entity_type_id('RelationType'))
          AND NOT (
              a.type_id = laplace.relation_type_id('IS_SYNONYM_OF')
              AND a.object_id IN (SELECT id FROM subj))
        GROUP BY a.type_id, a.object_id, a.source_id
    ), src_ids AS MATERIALIZED (
        SELECT array_agg(DISTINCT f.source_id ORDER BY f.source_id) AS a FROM filtered f
    ), src_labels AS MATERIALIZED (
        -- Label each DISTINCT source ONCE (sources number in the dozens), fenced
        -- so realize.render() cannot be pushed back down to run per (type, object, source)
        -- group (~3,129 renders for one entity before this map existed). The
        -- string_agg below keeps the exact DISTINCT + ORDER BY label semantics of
        -- the old inline expression, so output is byte-identical.
        SELECT i.id AS source_id,
               regexp_replace(r.txt,
                   '^substrate/source/([^/]+)(?:/v[0-9]+)?$', '\1') AS label
        FROM src_ids,
          LATERAL unnest(src_ids.a) WITH ORDINALITY i(id,ord),
          LATERAL unnest(realize.render_batch(src_ids.a)) WITH ORDINALITY r(txt,ord)
        WHERE i.ord=r.ord
    ), folded AS (
        SELECT f.type_id, f.object_id,
               sum(f.obs) AS witness_count,
               string_agg(DISTINCT sl.label, ', ' ORDER BY sl.label) AS source_labels
        FROM filtered f
        JOIN src_labels sl ON sl.source_id = f.source_id
        GROUP BY f.type_id, f.object_id
    ), best AS MATERIALIZED (
        -- One subject-side indexed scan replaces the old per-folded-row LATERAL
        -- probe. The lateral shape re-probed consensus once per folded group
        -- (~19.7k groups for a hub word), each probe Append-planned across the
        -- type partitions — measured >120s for "run"; this whole set is ~22k rows
        -- and aggregates in well under a second. DISTINCT ON keeps the exact
        -- "single best row by eff_mu" semantics of the old ORDER BY ... LIMIT 1.
        SELECT DISTINCT ON (c.type_id, c.object_id)
               c.type_id, c.object_id,
               consensus.eff_mu(c.rating, c.rd) AS mu_raw,
               consensus.eff_mu_display(c.rating, c.rd) AS mu_disp
        FROM laplace.consensus c
        WHERE c.subject_id IN (SELECT id FROM subj)
          AND c.object_id IS NOT NULL
        ORDER BY c.type_id, c.object_id, consensus.eff_mu(c.rating, c.rd) DESC
    ), ranked AS (
        -- Issue 52: rank BEFORE labeling. The old shape labeled every folded claim
        -- (type_label + _realize_synset_lemma/render_text, ~6ms/row — 3,129 labels
        -- to return 3 rows, >25s cold) and only then ordered/limited. Ranking needs
        -- only the consensus join, so it runs first over everything. Labels are
        -- total below: unrenderable ids receive deterministic hash labels rather
        -- than disappearing. The requested head is therefore exact; the old
        -- `3x+8` over-fetch was an unsupported probability bet.
        SELECT fo.type_id, fo.object_id, fo.witness_count, fo.source_labels,
               COALESCE(b.mu_raw, 0)  AS mu_raw,
               COALESCE(b.mu_disp, 0) AS eff_mu_disp
        FROM folded fo
        LEFT JOIN best b
               ON b.type_id = fo.type_id AND b.object_id = fo.object_id
        WHERE fo.source_labels IS NOT NULL AND fo.source_labels <> ''
        ORDER BY consensus.edge_rank(fo.type_id, COALESCE(b.mu_raw, 0)) DESC,
                 fo.witness_count DESC,
                 fo.type_id,
                 fo.object_id
        LIMIT GREATEST(p_limit, 0)
    ), ordered AS (
        SELECT rk.*, row_number() OVER (
                   ORDER BY consensus.edge_rank(rk.type_id, rk.mu_raw) DESC,
                            rk.witness_count DESC) AS ord
        FROM ranked rk
    ), labels AS MATERIALIZED (
        -- MATERIALIZED is load-bearing: this is a single-row realize_batch over
        -- the whole `ordered` window. Un-fenced, PG inlines it into the final
        -- `labeled` join, and because the labels array is subscripted by o.ord
        -- the planner re-evaluates the entire array_agg + realize_batch ONCE PER
        -- OUTPUT ROW (128 loops × ~160ms = 20s for the "run" hub; measured
        -- 2026-07-24 — the exact regression that reappeared after an upstream
        -- cardinality-estimate shift flipped the inlining decision). Fenced, it
        -- runs exactly once. Output is byte-identical (proven run/emperor/king,
        -- both EXCEPT directions empty).
        -- Full-mesh labels via ONE realize.batch(was: a shorter hand-rolled
        -- synset-lemma -> render -> HEX ladder per row). Gains the
        -- HAS_NAME/translation/canonical/gloss arms; hex stays the genuine
        -- last resort so every claim still shows. Approved behavior change.
        SELECT realize.batch(array_agg(o.object_id ORDER BY o.ord),
                             converse.word_language(p_id)) AS l,
               lexical.type_label_batch(array_agg(o.type_id ORDER BY o.ord)) AS types
        FROM ordered o
    ), labeled AS (
        SELECT o.type_id, o.object_id, o.witness_count, o.source_labels,
               o.mu_raw, o.eff_mu_disp,
               COALESCE(NULLIF(labels.types[o.ord], ''),
                        consensus.relation_canonical(o.type_id),
                        left(encode(o.type_id, 'hex'), 16)) AS rel,
               COALESCE(NULLIF(labels.l[o.ord], ''),
                        left(encode(o.object_id, 'hex'), 16)) AS obj
        FROM ordered o, labels
    )
    SELECT lb.type_id, lb.object_id, lb.rel, lb.obj,
           lb.eff_mu_disp,
           lb.witness_count,
           lb.source_labels
    FROM labeled lb
    ORDER BY consensus.edge_rank(lb.type_id, lb.mu_raw) DESC,
             lb.witness_count DESC,
             lb.type_id,
             lb.object_id
    LIMIT GREATEST(p_limit, 0)
$$;
