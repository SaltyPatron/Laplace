-- lexical.translations — peer subjects sharing a band-typed object (sense /
-- translation-shaped co-denotation). Prefer lexical over taxonomy: the row is
-- a same-plane peer set, not a hierarchy walk. Old names dropped (#532).
-- BEGIN ATOMIC: GH #764.
DROP FUNCTION IF EXISTS laplace.laplace_translations(bytea, bytea);
DROP FUNCTION IF EXISTS laplace.laplace_translations(bytea, bytea);
DROP FUNCTION IF EXISTS lexical.translations(bytea, bytea);
CREATE OR REPLACE FUNCTION lexical.translations(
    p_entity_id bytea, p_band_mask bytea)
RETURNS TABLE(translation_id bytea, shared_object_id bytea, eff_mu numeric)
LANGUAGE sql STABLE
BEGIN ATOMIC
    WITH band_types AS (
        SELECT id FROM unnest(consensus.relation_mask_types(p_band_mask)) AS t(id)
    )
    SELECT DISTINCT a2.subject_id, a1.object_id,
           consensus.eff_mu_display(a2.rating, a2.rd)
    FROM laplace.consensus a1
    JOIN band_types bt ON bt.id = a1.type_id
    JOIN laplace.consensus a2
      ON a2.object_id  = a1.object_id
     AND a2.subject_id != a1.subject_id
     AND a2.type_id    = a1.type_id
    WHERE a1.subject_id = p_entity_id
      AND a1.object_id IS NOT NULL
      AND consensus.eff_mu(a1.rating, a1.rd) > 0
      AND consensus.eff_mu(a2.rating, a2.rd) > 0;
END;
