-- BEGIN ATOMIC: GH #764.
-- Dedup subjects first, then probe v_word_points (JOIN shape exploded on UD).
CREATE OR REPLACE FUNCTION content_count(p_source bytea DEFAULT NULL)
    RETURNS bigint
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT CASE
        WHEN p_source IS NULL THEN
            (SELECT count(*) FROM @extschema@.v_word_points)
        ELSE
            (SELECT count(*)
             FROM (SELECT DISTINCT a.subject_id
                   FROM @extschema@.attestations a
                   WHERE a.source_id = p_source) s
             WHERE EXISTS (SELECT 1 FROM @extschema@.v_word_points w
                           WHERE w.id = s.subject_id))
    END;
END;
