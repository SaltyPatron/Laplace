DROP FUNCTION IF EXISTS astar_path(bytea, bytea[], int, bytea[], bool);
CREATE OR REPLACE FUNCTION astar_path(
    p_start bytea, p_goals bytea[], p_max_depth int DEFAULT 7,
    p_types bytea[] DEFAULT NULL, p_directed bool DEFAULT false,
    p_use_geometry bool DEFAULT false)
    RETURNS TABLE(step int, entity_id bytea, g double precision)
    LANGUAGE sql STABLE PARALLEL SAFE
    AS $$
    SELECT * FROM @extschema@.astar_path_raw(p_start, p_goals,
        COALESCE(p_types, ARRAY[
            @extschema@.relation_type_id('IS_A'), @extschema@.relation_type_id('IS_INSTANCE_OF'), @extschema@.relation_type_id('IS_SYNONYM_OF'),
            @extschema@.relation_type_id('IS_SIMILAR_TO'), @extschema@.relation_type_id('HAS_PART'), @extschema@.relation_type_id('HAS_MEMBER'),
            @extschema@.relation_type_id('HAS_SUBSTANCE'), @extschema@.relation_type_id('DERIVATIONALLY_RELATED'),
            @extschema@.relation_type_id('PERTAINS_TO'), @extschema@.relation_type_id('ALSO_SEE'), @extschema@.relation_type_id('IS_ANTONYM_OF'),
            @extschema@.relation_type_id('HAS_ATTRIBUTE'), @extschema@.relation_type_id('IN_VERB_GROUP_WITH')]),
        p_max_depth, p_directed, p_use_geometry)
$$;
