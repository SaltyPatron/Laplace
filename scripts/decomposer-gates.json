{
  "version": 1,
  "description": "Per-source ingest gates — consensus thresholds mirror .github/workflows/*.yml; prerequisites mirror witness-manifest signal-dependency order. The chess lanes were absent from this file entirely, so ingest-source.sh's journal verification never ran for them and their CI seed jobs were green on the exit code alone.",
  "naming": {
    "canonical_db": "laplace",
    "isolate_prefix": "laplace_d",
    "isolated_pattern": "{prefix}_{source}",
    "law": "laplace = cumulative canonical DB (promote-only re-ingest). laplace_d_<source> = throwaway isolated proof DB (fresh db-isolate + prerequisite ingests + target). No pg clone between isolated DBs."
  },
  "manifest_order": [
    "unicode",
    "iso639",
    "cili",
    "document",
    "wordnet",
    "omw",
    "verbnet",
    "propbank",
    "framenet",
    "mapnet",
    "wordframenet",
    "semlink",
    "conceptnet",
    "atomic2020",
    "ud",
    "wiktionary",
    "tatoeba",
    "opensubtitles"
  ],
  "sources": {
    "unicode": {
      "decomposer": "UnicodeDecomposer",
      "layer": 0,
      "prerequisites": [],
      "consensus_gates": [
        { "relation": "HAS_SCRIPT", "min": 1 },
        { "relation": "DECODES_TO", "min": 1 },
        { "relation": "CONFUSABLE_WITH", "min": 1 }
      ]
    },
    "iso639": {
      "decomposer": "ISO639Decomposer",
      "layer": 1,
      "prerequisites": ["unicode"],
      "consensus_gates": [
        {
          "relation": "HAS_ISO639_2_CODE",
          "min": 1,
          "fallback": "source_evidence",
          "fallback_relations": ["HAS_ISO639_1_CODE", "HAS_ISO639_2_CODE", "HAS_ISO639_3_CODE"],
          "fallback_min": 1
        },
        { "relation": "USES_SCRIPT", "min": 1 }
      ]
    },
    "cili": {
      "decomposer": "CILIDecomposer",
      "layer": 2,
      "prerequisites": ["iso639"],
      "consensus_gates": [
        { "relation": "HAS_DEFINITION", "min": 1 },
        { "relation": "IS_TYPED_AS", "min": 1 }
      ]
    },
    "document": {
      "decomposer": "DocumentDecomposer",
      "layer": 2,
      "prerequisites": ["iso639"],
      "consensus_gates": [
        { "relation": "CONTAINS", "min": 1, "constant_rating_ok": "structural file-to-document containment" }
      ]
    },
    "wordnet": {
      "decomposer": "WordNetDecomposer",
      "layer": 2,
      "prerequisites": ["cili"],
      "consensus_gates": [
        { "relation": "IS_A", "min": 50000 },
        { "relation": "HAS_DOMAIN_TOPIC", "min": 1 },
        { "relation": "HAS_VERB_FRAME", "min": 1 }
      ]
    },
    "omw": {
      "decomposer": "OMWDecomposer",
      "layer": 3,
      "prerequisites": ["wordnet"],
      "consensus_gates": [ { "relation": "HAS_LANGUAGE", "min": 1 } ]
    },
    "verbnet": {
      "decomposer": "VerbNetDecomposer",
      "layer": 2,
      "prerequisites": ["iso639"],
      "consensus_gates": [
        { "relation": "HAS_THEMATIC_ROLE", "min": 500 },
        { "relation": "HAS_VERB_FRAME", "min": 1000 }
      ]
    },
    "propbank": {
      "decomposer": "PropBankDecomposer",
      "layer": 2,
      "prerequisites": ["iso639"],
      "consensus_gates": [
        { "relation": "HAS_SEMANTIC_ROLE", "min": 10000 },
        { "relation": "HAS_SENSE", "min": 5000 }
      ]
    },
    "framenet": {
      "decomposer": "FrameNetDecomposer",
      "layer": 3,
      "prerequisites": ["wordnet"],
      "consensus_gates": [
        { "relation": "EVOKES_FRAME", "min": 5000 },
        { "relation": "HAS_FRAME_ELEMENT", "min": 5000 }
      ]
    },
    "mapnet": {
      "decomposer": "MapNetDecomposer",
      "layer": 4,
      "prerequisites": ["framenet"],
      "consensus_gates": [ { "relation": "CORRESPONDS_TO", "min": 1000 } ]
    },
    "wordframenet": {
      "decomposer": "WordFrameNetDecomposer",
      "layer": 4,
      "prerequisites": ["framenet"],
      "consensus_gates": [ { "relation": "EVOKES_FRAME", "min": 1000 } ]
    },
    "semlink": {
      "decomposer": "SemLinkDecomposer",
      "layer": 4,
      "prerequisites": ["verbnet", "propbank", "framenet"],
      "consensus_gates": [ { "relation": "CORRESPONDS_TO", "min": 1000 } ]
    },
    "conceptnet": {
      "decomposer": "ConceptNetDecomposer",
      "layer": 2,
      "prerequisites": ["iso639"],
      "consensus_gates": [
        { "relation": "IS_A", "min": 1000 },
        { "relation": "IS_RELATED_TO", "min": 1000 }
      ]
    },
    "atomic2020": {
      "decomposer": "Atomic2020Decomposer",
      "layer": 2,
      "prerequisites": ["iso639"],
      "consensus_gates": [ { "relation": "CAUSES", "min": 1000 } ]
    },
    "ud": {
      "decomposer": "UDDecomposer",
      "layer": 2,
      "prerequisites": ["iso639"],
      "consensus_gates": [
        { "relation": "DEPENDS_ON", "min": 1000, "family": true },
        { "relation": "HAS_FEATURE", "min": 1000, "family": true }
      ]
    },
    "wiktionary": {
      "decomposer": "WiktionaryDecomposer",
      "layer": 3,
      "prerequisites": ["iso639"],
      "consensus_gates": [
        { "relation": "HAS_DEFINITION", "min": 1000 },
        { "relation": "HAS_LANGUAGE", "min": 1000 }
      ]
    },
    "tatoeba": {
      "decomposer": "TatoebaDecomposer",
      "layer": 3,
      "prerequisites": ["iso639"],
      "consensus_gates": [ { "relation": "IS_TRANSLATION_OF", "min": 1000 } ]
    },
    "opensubtitles": {
      "decomposer": "OpenSubtitlesDecomposer",
      "layer": 3,
      "prerequisites": ["iso639"],
      "consensus_gates": [ { "relation": "IS_TRANSLATION_OF", "min": 1000 } ]
    },
    "chess": {
      "decomposer": "ChessPgn",
      "layer": 5,
      "prerequisites": [],
      "skip_layer_complete": true,
      "consensus_gates": []
    },
    "chess-analyze": {
      "decomposer": "ChessAnalysis",
      "layer": 6,
      "prerequisites": ["chess"],
      "skip_layer_complete": true,
      "consensus_gates": []
    },
    "chess-trajectory": {
      "decomposer": "ChessTrajectory",
      "layer": 6,
      "prerequisites": ["chess"],
      "marker_entities": "ChessTrajectoryMarker",
      "consensus_gates": []
    },
    "chess-transitions": {
      "decomposer": "ChessTransitions",
      "layer": 6,
      "prerequisites": ["chess"],
      "skip_layer_complete": true,
      "consensus_gates": []
    },
    "chess-move-outcomes": {
      "decomposer": "ChessMoveOutcomes",
      "layer": 6,
      "prerequisites": ["chess"],
      "skip_layer_complete": true,
      "consensus_gates": []
    },
    "chess-position-outcomes": {
      "decomposer": "ChessPositionOutcomes",
      "layer": 6,
      "prerequisites": ["chess"],
      "skip_layer_complete": true,
      "consensus_gates": []
    },
    "chess-eval": {
      "decomposer": "ChessStockfish",
      "layer": 6,
      "prerequisites": ["chess"],
      "skip_layer_complete": true,
      "consensus_gates": []
    },
    "chess-syzygy": {
      "decomposer": "ChessSyzygy",
      "layer": 6,
      "prerequisites": [],
      "skip_layer_complete": true,
      "consensus_gates": []
    },
    "chess-opening-match": {
      "decomposer": "ChessOpeningMatch",
      "layer": 6,
      "prerequisites": ["chess", "openings"],
      "skip_layer_complete": true,
      "consensus_gates": []
    },
    "openings": {
      "decomposer": "ChessOpenings",
      "layer": 5,
      "prerequisites": [],
      "skip_layer_complete": true,
      "consensus_gates": []
    },
    "chess-books": {
      "decomposer": "ChessBook",
      "layer": 6,
      "prerequisites": [],
      "skip_layer_complete": true,
      "consensus_gates": []
    }
  }
}
