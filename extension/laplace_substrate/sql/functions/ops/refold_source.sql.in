-- ops.refold_source — the NON-DESTRUCTIVE half of evict_source (GH #1176).
--
-- THE INCIDENT THIS REPAIRS, measured 2026-08-21: the conceptnet ingest (run
-- 32502815485) applied all 651 units and then died mid-fold on pool exhaustion
-- (#1271). The ledger says applied; the folds never drained. Result: relation
-- aa43543b… holds 163,585 attestations but 28,793 consensus rows; 3d5f97dc…
-- 108,863 vs 66,789 — lanes whose folds finished are exact. Per-file resume
-- true-skips the files (their HasLayerCompleted markers exist), so re-running
-- repairs nothing, and until this procedure existed the ONLY recovery was
-- evict + full re-ingest: destroying 963,549 evidence rows to rebuild rows
-- that are all still present.
--
-- Consensus is DERIVED state: every cell is exactly the consensus_fold of its
-- surviving attestations. evict_source already proves it — its step (b) refolds
-- every touched cell in place after deleting testimony. This is the complete
-- rebuild form of that arm with NOTHING deleted: enumerate the cells the source's
-- testimony touches, refold each from ALL evidence in one grouped rating period,
-- with a neutral-prior seed, and UPSERT the derived row. The stable traversal
-- (last_observed_at, id) does not invent a separate period for each observation.
-- The INSERT half matters: an interrupted first fold can leave durable evidence
-- with no consensus row at all, and UPDATE-only repair cannot reconstruct it.
-- Idempotent by construction — a second run recomputes identical values. Touches
-- only laplace.consensus rows whose evidence justifies them; never mutates evidence.
--
-- Batched COMMITs exactly like evict_source, so a canceled repair keeps every
-- relation already refolded. No SET clause (a procedure carrying one may not
-- COMMIT); references schema-qualified instead — the ops.evict_source rule.
--
-- Run (operator, via the measurement lane like evict):
--   CALL ops.refold_source('ConceptNetDecomposer');
DROP PROCEDURE IF EXISTS ops.refold_source(text, boolean);

CREATE OR REPLACE PROCEDURE ops.refold_source(
    p_source_name text,
    p_dry_run     boolean DEFAULT false)
    LANGUAGE plpgsql AS $$
DECLARE
    src            bytea;
    rels           bytea[];
    operational_types bytea[];
    rel            bytea;
    n_cells        bigint;
    n              bigint;
    refold_total   bigint := 0;
    t0             timestamptz := clock_timestamp();
BEGIN
    src := laplace.source_id(p_source_name);
    IF src IS NULL THEN
        RAISE EXCEPTION 'refold_source: unknown source %', p_source_name;
    END IF;

    -- A transient-calibration receipt has already consumed its continuous
    -- native score inside the original atomic write.  It is durable provenance,
    -- not a replayable fold input; rebuilding a cell from its categorical
    -- receipt would silently replace the original model result with 0/½/1.
    IF EXISTS (
        SELECT 1
        FROM laplace.attestations source_evidence
        JOIN laplace.attestations transient_evidence
          ON transient_evidence.type_id = source_evidence.type_id
         AND transient_evidence.subject_id = source_evidence.subject_id
         AND transient_evidence.object_id IS NOT DISTINCT FROM source_evidence.object_id
        WHERE source_evidence.source_id = src
          AND transient_evidence.fold_replayable = false
    ) THEN
        RAISE EXCEPTION 'refold_source: source % touches transient-calibration evidence; no score replay exists',
            p_source_name;
    END IF;

    -- Match ConsensusAccumulatingWriter's bounded operational namespace.
    -- These rows prove admission; they never supply rating observations.
    SELECT array_agg(type_id) INTO operational_types
    FROM (
        SELECT realize.canonical_id('substrate/type/HasFileMetadata/v1') AS type_id
        UNION ALL
        SELECT realize.canonical_id('substrate/type/HasLayerCompleted/' || layer::text || '/v1')
        FROM generate_series(0, 255) AS layers(layer)
        UNION ALL
        SELECT realize.canonical_id('substrate/type/HasUnitCompleted/' || layer::text || '/v1')
        FROM generate_series(0, 255) AS units(layer)
    ) marker_types;

    SELECT array_agg(DISTINCT a.type_id) INTO rels
    FROM laplace.attestations a
    WHERE a.source_id = src AND NOT (a.type_id = ANY(operational_types));
    IF rels IS NULL THEN
        RAISE LOG 'refold_source: % has no testimony — nothing to refold', p_source_name;
        RETURN;
    END IF;

    CREATE TEMP TABLE IF NOT EXISTS _refold_cells (
        subject_id bytea NOT NULL,
        object_id  bytea,
        UNIQUE NULLS NOT DISTINCT (subject_id, object_id));

    FOREACH rel IN ARRAY rels LOOP
        TRUNCATE _refold_cells;
        EXECUTE format($q$
            INSERT INTO _refold_cells (subject_id, object_id)
            SELECT DISTINCT a.subject_id, a.object_id
            FROM laplace.attestations a
            WHERE a.source_id = %L::bytea AND a.type_id = %L::bytea
            ON CONFLICT DO NOTHING
        $q$, src, rel);
        GET DIAGNOSTICS n_cells = ROW_COUNT;

        IF p_dry_run THEN
            RAISE LOG 'refold_source: WOULD refold % cell(s) of relation %',
                n_cells, encode(rel, 'hex');
            CONTINUE;
        END IF;

        IF n_cells = 0 THEN
            CONTINUE;
        END IF;

        -- The native repair owner takes the same sorted canonical target locks
        -- as admission, then reads a fresh READ COMMITTED snapshot of ALL A.
        -- It checks replayability again inside that lock window, so a concurrent
        -- transient receipt cannot be replaced with its categorical value.
        -- No incoming delta is fabricated and no neutral placeholder is committed.
        SELECT consensus.refold_evidence_type(
            rel,
            array_agg(subject_id ORDER BY subject_id, object_id NULLS FIRST),
            array_agg(object_id ORDER BY subject_id, object_id NULLS FIRST))
        INTO n
        FROM _refold_cells;
        refold_total := refold_total + n;
        RAISE LOG 'refold_source: relation % — % cell(s) touched, % consensus row(s) rebuilt',
            encode(rel, 'hex'), n_cells, n;
        COMMIT;
    END LOOP;

    DROP TABLE IF EXISTS _refold_cells;
    RAISE LOG 'refold_source: % — % row(s) rebuilt across % relation(s) in %s',
        p_source_name, refold_total, array_length(rels, 1),
        round(extract(epoch FROM clock_timestamp() - t0)::numeric, 1);
END;
$$;
