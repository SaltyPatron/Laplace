DROP FUNCTION IF EXISTS laplace.completions(bytea, integer);
CREATE OR REPLACE FUNCTION consensus.completions(p_subject bytea, p_limit integer DEFAULT 40)
    RETURNS TABLE(object_id bytea, type_id bytea, eff_mu numeric, witnesses bigint)
-- No SET search_path — blocks inlining, costs the consensus index path. GH #860.
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT c.object_id, c.type_id, c.eff_mu, c.witness_count
    FROM laplace.v_consensus_resolved c
    WHERE c.subject_id = p_subject AND c.object_id IS NOT NULL
    ORDER BY consensus.edge_rank(c.type_id, c.eff_mu_raw) DESC
    LIMIT p_limit;
END;
