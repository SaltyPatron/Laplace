-- Every witnessed edge of a word, ranked by the salience-weighted readout.
--
-- RELATION LABELS RESOLVE PER DISTINCT TYPE, NOT PER ROW — a correctness/shape
-- fix, NOT a speedup. Be clear about that, because the first version of this
-- comment claimed a speedup it does not deliver.
--
-- A relation type comes from a governed vocabulary of ~189, so one subject's
-- edges span a handful — eight on `Self_motion`, the densest word in the
-- substrate (6,687 edges). Calling realize.label() per ROW asked the same question 836
-- times over on average. Fencing the distinct types turns 6,687 calls into 8, and
-- the plan confirms it: `CTE rel` executes in 4.9 ms for 8 rows.
--
-- IT DID NOT MAKE converse.links() FASTER. Measured 2026-07-28, three runs each:
--   before  140.9 s
--   after   147.0 / 148.4 / 146.7 s
--
-- The reason is a mis-measurement worth recording. Timing each arm ALONE gave
-- realize.label(type_id) 75.9 s and realize.label(object_id) 42.3 s, which looks additive against
-- a 140.9 s total. It is not: both arms call resolve_name, which reads the same
-- consensus pages, so whichever ran second found them warm. Removing the type arm
-- freed almost no I/O — the object arm still faults the same pages in. Per-arm
-- timings taken in isolation cannot be attributed to a combined query.
--
-- What the plan actually shows: 88.7 M shared buffer hits, essentially all of it
-- in the projection, i.e. realize.label(object_id) at ~22 ms and ~13 k buffers PER CALL.
-- Those 6,686 ids are nearly all distinct, so deduping cannot help — that arm
-- needs a BATCHED label, which does not exist. realize.batch() is batched but is a
-- DIFFERENT ladder: it abstains with NULL where realize.label() falls back to a cleaned
-- realize.render and finally to hex, so substituting it changes what every caller
-- receives. A label_batch() in C beside realize_batch is the real fix and is not
-- in this change.
--
-- Semantics here are unchanged by construction: same function, same argument,
-- same COALESCE(NULLIF(consensus.relation_canonical, ''), label) ladder. Only the number of
-- evaluations changes.
CREATE OR REPLACE FUNCTION converse.links(p_word text)
    RETURNS TABLE(relation text, target text, strength double precision)
    LANGUAGE sql STABLE PARALLEL SAFE
    AS $$
    WITH base AS MATERIALIZED (
        SELECT c.type_id, c.object_id,
               consensus.eff_mu(c.rating, c.rd) AS emu
        FROM laplace.consensus c
        WHERE c.subject_id = laplace.word_id(p_word)
    ),
    ids AS MATERIALIZED (
        SELECT COALESCE(array_agg(DISTINCT x.id ORDER BY x.id), '{}'::bytea[]) AS a
        FROM (SELECT type_id AS id FROM base UNION SELECT object_id FROM base) x
    ), labels AS MATERIALIZED (
        SELECT i.id, l.txt
        FROM ids b,
             LATERAL unnest(b.a) WITH ORDINALITY AS i(id, ord),
             LATERAL unnest(realize.label_batch(b.a)) WITH ORDINALITY AS l(txt, ord)
        WHERE i.ord = l.ord
    ), rel AS MATERIALIZED (
        SELECT t.type_id,
               COALESCE(NULLIF(consensus.relation_canonical(t.type_id), ''), l.txt) AS relation
        FROM (SELECT DISTINCT b.type_id FROM base b) t
        JOIN labels l ON l.id = t.type_id
    )
    SELECT r.relation,
           l.txt AS target,
           (b.emu)::float8 / 1e9 AS strength
    FROM base b
    JOIN rel r ON r.type_id = b.type_id
    JOIN labels l ON l.id = b.object_id
    ORDER BY consensus.edge_rank(b.type_id, b.emu) DESC,
             strength DESC, r.relation
$$;
