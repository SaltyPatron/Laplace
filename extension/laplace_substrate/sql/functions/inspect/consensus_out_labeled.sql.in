DROP FUNCTION IF EXISTS laplace.consensus_out_labeled(bytea, integer);
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.consensus_out_labeled(bytea, integer)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(type_id bytea, object_id bytea, type_label text, object_label text, eff_mu numeric, witnesses bigint)'
             OR proargnames IS DISTINCT FROM ARRAY['p_id','p_limit','type_id','object_id','type_label','object_label','eff_mu','witnesses']::text[])) THEN
        DROP FUNCTION ops.consensus_out_labeled(bytea, integer);
    END IF;
END $upgrade_shape$;
CREATE OR REPLACE FUNCTION ops.consensus_out_labeled(p_id bytea, p_limit integer DEFAULT 40)
    RETURNS TABLE(
        type_id bytea,
        object_id bytea,
        type_label text,
        object_label text,
        eff_mu numeric,
        witnesses bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    -- This is an entity inspection primitive, not a lexical expansion. The caller
    -- already has the exact content/governed id; sense/synset navigation is exposed
    -- separately through lexical.senses. Flattening those subjects here erased the
    -- subject identity and manufactured duplicate-looking consensus rows.
    WITH ranked AS (
        SELECT c.type_id, c.object_id, c.eff_mu, c.witness_count,
               consensus.edge_rank(c.type_id, c.eff_mu_raw) AS rnk
        FROM laplace.v_consensus_resolved c
        WHERE c.subject_id = p_id
          AND c.object_id IS NOT NULL
        ORDER BY consensus.edge_rank(c.type_id, c.eff_mu_raw) DESC, c.type_id, c.object_id
        LIMIT GREATEST(p_limit, 0)
    )
    , ordered AS (
        SELECT r.*, row_number() OVER (ORDER BY r.rnk DESC, r.type_id, r.object_id) AS ord
        FROM ranked r
    ), ids AS (
        SELECT type_id AS id FROM ordered UNION SELECT object_id FROM ordered
    ), labels AS MATERIALIZED (
        -- A source-defined relation is content, too. The immutable registry lookup
        -- lexical.type_label cannot render it. Label each distinct endpoint once
        -- through the shared native display pipeline, retaining unresolved identity.
        SELECT d.id, d.label
        FROM realize.display_label_batch(ARRAY(SELECT id FROM ids ORDER BY id)) d
    )
    SELECT o.type_id, o.object_id,
           t.label, v.label,
           o.eff_mu,
           o.witness_count
    FROM ordered o
    JOIN labels t ON t.id = o.type_id
    JOIN labels v ON v.id = o.object_id
    ORDER BY o.ord;
END;
