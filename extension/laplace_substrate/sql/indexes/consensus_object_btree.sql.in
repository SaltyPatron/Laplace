-- consensus_object_btree (object_id) is a strict prefix of
-- consensus_object_type_btree (object_id, type_id) under the same partial
-- predicate, so it serves no read the composite does not and only adds write
-- cost. This file drops it; both manifests list it.
DO $do$
BEGIN
    -- Release extension membership first (a no-op when the index is not a
    -- member); the guarded DROP then removes the object.
    IF EXISTS (SELECT FROM pg_depend d JOIN pg_extension e ON e.oid=d.refobjid
        WHERE d.classid='pg_class'::regclass AND d.objid=to_regclass('laplace.consensus_object_btree')
          AND d.refclassid='pg_extension'::regclass AND d.deptype='e'
          AND e.extname='laplace_substrate') THEN
        EXECUTE format('ALTER EXTENSION %I DROP INDEX laplace.consensus_object_btree',
                       'laplace_substrate');
    END IF;
    EXECUTE 'DROP INDEX IF EXISTS laplace.consensus_object_btree';
END $do$;
