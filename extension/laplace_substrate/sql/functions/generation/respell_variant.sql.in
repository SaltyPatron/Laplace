DROP FUNCTION IF EXISTS laplace.respell_variant(text, text, float8, int, int);
CREATE OR REPLACE FUNCTION generation.respell_variant(p_node_type text, p_modality text DEFAULT 'c-sharp',
                     p_substitution_rate float8 DEFAULT 0.3, p_k int DEFAULT 6, p_depth int DEFAULT 4)
    RETURNS text
    AS 'MODULE_PATHNAME', 'pg_laplace_respell_variant'
    LANGUAGE C VOLATILE;
