-- converse.prompt_state — GH #862 / #860. No SET, real schema names.
DROP FUNCTION IF EXISTS laplace.prompt_state(text);
CREATE OR REPLACE FUNCTION converse.prompt_state(p_text text)
    RETURNS TABLE(ord int, word text, id bytea, language bytea)
    LANGUAGE sql LAPLACE_STABLE_STRICT AS $$
    SELECT pw.ord, pw.word, pw.id, converse.word_language(pw.id)
    FROM converse.prompt_words(p_text) pw
    WHERE pw.id IS NOT NULL
$$;
