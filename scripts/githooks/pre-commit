#!/usr/bin/env bash
# Auto-heal docs/INVENTORY.md so agents cannot forget to regenerate it.
# CI --check stays as backstop; this removes the memory tax.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

python3 scripts/docs-inventory.py >/dev/null

if ! git diff --quiet -- docs/INVENTORY.md 2>/dev/null; then
  git add -- docs/INVENTORY.md
  echo "pre-commit: refreshed and staged docs/INVENTORY.md"
fi
