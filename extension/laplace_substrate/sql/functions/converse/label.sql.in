-- A semantic label is a projection of the universal realization contract, not a
-- second parser over already-rendered text.  Identity stays in id space; content
-- reconstructs from the Merkle/physicality path; names are selected from witnessed
-- name/sense evidence under the requested language.  Registry names and id handles
-- remain explicit metadata in realize.display_batch().
DROP FUNCTION IF EXISTS laplace.label(bytea);

CREATE OR REPLACE FUNCTION realize.label(p_id bytea, p_lang bytea)
    RETURNS text
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    SELECT CASE WHEN d.realization IN ('content', 'name') THEN d.label END
    FROM realize.display_batch(ARRAY[p_id], p_lang) d
    WHERE d.ord = 1
$$;

-- Installed one-argument compatibility surface.  Keep the exact signature/OID so
-- BEGIN-ATOMIC dependents remain upgrade-safe; NULL language means no preference.
CREATE OR REPLACE FUNCTION realize.label(p_id bytea)
    RETURNS text
    LANGUAGE sql LAPLACE_STABLE_STRICT AS $$
    SELECT realize.label(p_id, NULL::bytea)
$$;
