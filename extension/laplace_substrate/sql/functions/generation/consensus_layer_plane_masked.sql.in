DROP FUNCTION IF EXISTS laplace.consensus_layer_plane_masked(bytea[], bytea, int);
CREATE OR REPLACE FUNCTION generation.consensus_layer_plane_masked(
        p_vocab bytea[], p_band_mask bytea, p_degree_cap int DEFAULT 48)
    RETURNS TABLE(subject_id bytea, object_id bytea, w double precision, layer_rank double precision)
    LANGUAGE sql STABLE PARALLEL RESTRICTED AS $$
    WITH v(id) AS (SELECT DISTINCT u FROM unnest(p_vocab) AS u),
         band_types AS (
             SELECT t.id, consensus.relation_rank_resolved(t.id) AS rank
             FROM unnest(consensus.relation_mask_types(p_band_mask)) AS t(id)
         ),
         edges AS (
             SELECT c.subject_id, c.object_id, c.rating, c.rd, c.witness_count, c.type_id,
                    bt.rank
             FROM v
             JOIN laplace.consensus c ON c.subject_id = v.id
             JOIN v vo        ON vo.id = c.object_id
             JOIN band_types bt ON bt.id = c.type_id
             WHERE bt.rank IS NOT NULL
         ),
         -- P5 Glicko-complete weight (doc 14 M5): signed, rd-discounted,
         -- witness-saturated. consensus.walk_edge_weight IS the law; kappa resolved once
         -- rather than per row.
         kappa(k) AS (SELECT consensus.foundry_rd_kappa()),
         ranked AS (
             SELECT e.subject_id, e.object_id,
                    consensus.walk_edge_weight(e.rating, e.rd, e.witness_count,
                                     (SELECT k FROM kappa)) AS w,
                    e.rank AS rk
             FROM edges e
         ),
         capped AS (
             SELECT r.subject_id, r.object_id, r.w, r.rk,
                    row_number() OVER (PARTITION BY r.subject_id ORDER BY r.rk * abs(r.w) DESC, r.object_id) AS rn
             FROM ranked r
         )
    SELECT c.subject_id, c.object_id, c.w, c.rk FROM capped c WHERE c.rn <= p_degree_cap
$$;
