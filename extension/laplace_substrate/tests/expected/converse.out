-- The natural-language compiler routes through witnessed semantic frames, not
-- a surface regex, and leaves the lexicalized content as the operand.
SELECT c.shape = 'what_is' AS compiled_what_is,
       c.request_ids = ARRAY[public.blake3_send(public.laplace_text_id('compilerrequest'))]::bytea[] AS request_is_routed,
       c.binder_ids = ARRAY[public.blake3_send(public.laplace_text_id('compilerbinder'))]::bytea[] AS binder_is_routed,
       c.operand_ids = ARRAY[public.blake3_send(public.laplace_text_id('dog'))]::bytea[] AS dog_is_operand
FROM converse.compile_prompt(
    'compilerrequest compilerbinder dog',
    public.blake3_send(public.laplace_text_id('en'))) c;
