DROP FUNCTION IF EXISTS laplace.entity_physicality_coords(bytea[]);
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('ops.entity_physicality_coords(bytea[])')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(entity_id bytea, x double precision, y double precision, z double precision, m double precision)'
             OR proargnames IS DISTINCT FROM ARRAY['p_ids','entity_id','x','y','z','m']::text[])) THEN
        DROP FUNCTION ops.entity_physicality_coords(bytea[]);
    END IF;
END $upgrade_shape$;
CREATE OR REPLACE FUNCTION ops.entity_physicality_coords(p_ids bytea[])
    RETURNS TABLE(entity_id bytea, x double precision, y double precision,
                  z double precision, m double precision)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT DISTINCT ON (p.entity_id) p.entity_id,
           public.ST_X(p.coord), public.ST_Y(p.coord), public.ST_Z(p.coord), public.ST_M(p.coord)
    FROM laplace.physicalities p
    WHERE p.entity_id = ANY(p_ids)
      AND p.type = 1
      AND p.coord IS NOT NULL
    ORDER BY p.entity_id, p.id;
END;
