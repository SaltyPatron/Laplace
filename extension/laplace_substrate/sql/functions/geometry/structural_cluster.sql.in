-- Scalar adapter over the canonical set implementation. Shape distance is Frechet over
-- REALIZED entity curves, never packed physicalities.trajectory (Rule #3 / Issue 51).
DROP FUNCTION IF EXISTS laplace.structural_cluster(bytea, double precision, integer);
-- Keep current OIDs and their parsed SQL dependencies; retire only an older shape.
DO $upgrade_shape$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE oid = to_regprocedure('structural.cluster(bytea, double precision, integer)')
        AND (pg_get_function_result(oid) IS DISTINCT FROM 'TABLE(entity_id bytea, label text, frechet double precision, recurrence bigint)'
             OR proargnames IS DISTINCT FROM ARRAY['p_seed','p_eps','p_limit','entity_id','label','frechet','recurrence']::text[])) THEN
        DROP FUNCTION structural.cluster(bytea, double precision, integer);
    END IF;
END $upgrade_shape$;
CREATE OR REPLACE FUNCTION structural.cluster(
        p_seed bytea, p_eps double precision DEFAULT 0.05, p_limit integer DEFAULT 200)
    RETURNS TABLE(entity_id bytea, label text, frechet double precision, recurrence bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT b.entity_id, b.label, b.frechet, b.recurrence
    FROM structural.cluster_batch(ARRAY[p_seed]::bytea[], p_eps, p_limit) b
    WHERE b.input_ordinal = 1
    ORDER BY b.frechet, b.entity_id;
END;
