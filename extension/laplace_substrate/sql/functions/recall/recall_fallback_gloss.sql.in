-- Labelled gloss, the default answer when the caller named no read shape.
-- Restored SET-free after an empty-file SET-strip accident left the live
-- function stranded with proconfig (GH #860 residual / schema-repair).
DROP FUNCTION IF EXISTS laplace.recall_fallback_gloss(bytea, bytea[]);
CREATE OR REPLACE FUNCTION laplace.recall_fallback_gloss(
        p_topic bytea, p_context_ids bytea[] DEFAULT NULL)
    RETURNS TABLE(reply text, eff_mu numeric, witnesses bigint)
    LANGUAGE sql
    STABLE
    PARALLEL SAFE
AS $$
    SELECT realize.label(p_topic) || ': ' || d.definition, d.eff_mu, d.witnesses
    FROM converse.define_fast(p_topic, COALESCE(p_context_ids, ARRAY[]::bytea[]), 3) d
$$;
