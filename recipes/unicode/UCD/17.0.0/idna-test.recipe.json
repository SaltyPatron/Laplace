  "delimitedSyntax": {
    "recordName": "record",
    "separator": ";",
    "commentPrefix": "#",
    "trimFields": true,
    "columns": [
      "source",
      "toUnicode",
      "toUnicodeStatus",
      "toAsciiN",
      "toAsciiNStatus",
      "toAsciiT",
      "toAsciiTStatus"
    ],
    "unicodeEscapes": true,
    "blankDefaults": {
      "toUnicode": "source",
      "toAsciiN": "toUnicode",
      "toAsciiNStatus": "toUnicodeStatus",
      "toAsciiT": "toAsciiN",
