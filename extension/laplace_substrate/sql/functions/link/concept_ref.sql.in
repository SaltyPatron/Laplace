DROP FUNCTION IF EXISTS laplace.concept_ref(text);
CREATE OR REPLACE FUNCTION lexical.concept_ref(p_ref text)
    RETURNS bytea
    LANGUAGE plpgsql STABLE STRICT PARALLEL SAFE
AS $fn$
DECLARE
    v_ref text := NULLIF(btrim(p_ref), '');
    v_key text;
    v_anchor bytea;
BEGIN
    -- Resolve an external concept identifier to its content-addressed anchor
    -- entity, so callers can link things by ILI / WordNet synset key / frame
    -- name. Every shape is keyed off the SAME content hash the ingest
    -- decomposers used (laplace.word_id = laplace_content_root_id), so the anchor id is
    -- reconstructed, never resolved by rendered surface:
    --   * ILI id       'i68021'       -> the synset entity IS that hash
    --                  'ili:i68021'   -> CILI's prefixed name of the same ILI
    --   * WordNet key   '05510358-n'  -> that hash is the offset-pos key
    --                  'pwn30:05510358-n' (CILI's prefixed name of it)
    --                                    entity; the synset (ILI) anchor is the
    --                                    HAS_SYNSET_KEY subject pointing at it
    --   * frame / other 'Self_motion' -> the category entity IS that hash
    -- Returns NULL only when the identifier is empty.
    --
    -- CILI input is never dropped silently (Laplace#1879). A WordNet 3.0 key
    -- that no standing claim maps to an ILI used to come back NULL, and the
    -- explorer's COALESCE then read the key as a word: a synset offset turned
    -- into the hash of its own digits. A CILI prefixed name (ili:, pwn30:) fell
    -- through to the same word hash, and so did another WordNet version's
    -- offset (pwn31:, odwn13:), which is a different key: 622 offsets name one
    -- concept in WordNet 3.0 and another in 3.1 (CILI ili-map-pwn30.tab against
    -- ili-map-pwn31.tab; 00029677-n is i35587 in 3.0, i35586 in 3.1). Each of
    -- those now raises, naming the input and why, so a caller fails where the
    -- concept was lost rather than three joins later.
    IF v_ref IS NULL THEN
        RETURN NULL;
    END IF;
    IF v_ref ~ '^ili:i[0-9]+$' THEN
        RETURN laplace.word_id(substr(v_ref, 5));
    END IF;
    IF v_ref ~ '^(pwn30:)?[0-9]{8}-[nvasr]$' THEN
        v_key := regexp_replace(v_ref, '^pwn30:', '');
        -- Ranked, not arbitrary: nothing forbids two anchors claiming one
        -- offset-pos key (a partial or double seed produces exactly that), and
        -- unordered this returned whichever the index reached first. Strongest
        -- standing claim wins; the id breaks the tie so the answer is stable.
        SELECT c.subject_id INTO v_anchor
        FROM laplace.consensus c
        WHERE c.object_id = laplace.word_id(v_key)
          AND c.type_id = laplace.relation_type_id('HAS_SYNSET_KEY')
          -- Standing claim only: a fully-refuted HAS_SYNSET_KEY is not
          -- a mapping (Copilot #918). Non-positive eff_mu is no mapping.
          AND consensus.eff_mu(c.rating, c.rd) > 0
        ORDER BY consensus.eff_mu(c.rating, c.rd) DESC, c.subject_id
        LIMIT 1;
        IF v_anchor IS NULL THEN
            RAISE EXCEPTION 'concept_ref: the WordNet 3.0 key % names no concept: no standing synset-key claim maps it to an ILI', v_ref
                USING ERRCODE = 'no_data_found',
                      HINT = 'ingest CILI (ili.ttl) and the wordnet that states the key, or pass the ILI itself (i123)';
        END IF;
        RETURN v_anchor;
    END IF;
    IF v_ref ~ '^[A-Za-z][A-Za-z0-9]*:[0-9]{8}-[nvasr]$' THEN
        RAISE EXCEPTION 'concept_ref: % is a synset key of %, not of WordNet 3.0: its offsets are other keys, and no synset-key claim here is of that version', v_ref, split_part(v_ref, ':', 1)
            USING ERRCODE = 'invalid_parameter_value',
                  HINT = 'pass the ILI (i123), or a WordNet 3.0 key (pwn30:00001740-a)';
    END IF;
    IF v_ref ~ '^ili:' THEN
        RAISE EXCEPTION 'concept_ref: % is not a CILI identifier (ili:i followed by digits)', v_ref
            USING ERRCODE = 'invalid_parameter_value';
    END IF;
    RETURN laplace.word_id(v_ref);
END;
$fn$;
