-- Deposit highway-mask bits for the (entity, relation-type) pairs an epoch's
-- edges actually touched — the fold KNOWS every pair in RAM, so the mask is
-- populated at deposit time with ZERO consensus re-reads. This replaces the
-- per-epoch highway_mask_refresh recompute, whose object-side join probed every
-- consensus leaf per touched entity (measured: 75s of a 118s fold).
-- OR-accumulate is correct at ingest: edges are only ever ADDED, so bits only
-- ever turn on; idempotent and chunk-order-free. On a greenfield seed this
-- deposit IS the population — highway_mask_refresh/rebuild are legacy repair
-- verbs for pre-deposit databases and retire once no such DB exists.
--
-- ONE DEPOSIT AT A TIME, by advisory lock — the third and final shape of the
-- 2026-07-29 deadlock fix, and the ledger of why the first two were wrong:
--
--   bd10fcf  moved the deposit server-side and CONCURRENT → AB/BA deadlocks
--            between fold lanes on shared entity rows (hot words appear in
--            every delta), 10/10 whole-batch retries lost.
--   #729     ordered the locks WITHIN one statement → still deadlocked: the
--            transaction ran a SEQUENCE of chunk statements holding prior
--            chunks' locks.
--   #732/#733 sorted the pairs client-side and committed per chunk → deadlock
--            gone, replaced by a MEASURED 6.4 ms/row FOR NO KEY UPDATE tax
--            (EXPLAIN ANALYZE: 84 ms to find+sort 5,000 rows, 32,039 ms in
--            LockRows) — concurrent lockers minting multixacts per tuple.
--            Fold masks/s: 3,305 (crashing run) → 333 (correct, convoyed).
--
-- The enumeration that licenses serialization: during ingest, deposits are the
-- ONLY writers of entities rows. highway_mask_refresh is reachable solely from
-- the highway_mask_rebuild repair verb (never during ingest; ops law forbids
-- it); WS_APPLY merges target attestations; COPY inserts proven-novel rows
-- only; consensus_upsert touches consensus. So one-at-a-time deposits eliminate
-- ALL entity-row contention: no cycle (single writer), no per-row lock tax
-- (uncontended xmax, no multixacts), no ordering machinery. The caller commits
-- per chunk (ConsensusAccumulatingWriter), so the advisory lock is held for one
-- chunk's work and waiters queue in chunk-sized steps. Serial-and-fast beats
-- parallel-and-taxed: the parallelism never parallelised the row updates, it
-- only manufactured the contention (the pre-bd10fcf C# scheduler knew this).
CREATE OR REPLACE FUNCTION highway_mask_deposit(p_entity_ids bytea[], p_type_ids bytea[])
    RETURNS bigint
    LANGUAGE plpgsql VOLATILE
    SET search_path = @extschema@, public AS $$
DECLARE
    updated bigint;
BEGIN
    IF NOT laplace_highway_ready() THEN
        RAISE WARNING 'highway_mask_deposit: highway perfcache not configured — masks not deposited (set laplace_substrate.highway_perfcache_path)';
        RETURN 0;
    END IF;

    -- xact-scoped: released at the caller's per-chunk COMMIT. hashtext of the
    -- function's own name — one well-known key, not a magic number.
    PERFORM pg_advisory_xact_lock(hashtext('laplace.highway_mask_deposit')::bigint);

    WITH pairs AS (
        SELECT DISTINCT u.eid, u.tid
        FROM unnest(p_entity_ids, p_type_ids) AS u(eid, tid)
    ),
    types AS (SELECT DISTINCT p.tid FROM pairs p),
    tbits AS (
        -- A DYNAMIC relation (EDEP_nsubj, FEAT_case, ...) has no bit of its own;
        -- it contributes its FAMILY ROOT's bit via its IS_A edge (SeedDynamic).
        -- Bounded: one probe per DISTINCT type this epoch (dozens), not per entity.
        SELECT t.tid,
               COALESCE(relation_highway_bit(t.tid),
                        relation_highway_bit(fam.object_id)) AS bit
        FROM types t
        LEFT JOIN consensus fam
          ON fam.subject_id = t.tid
         AND fam.type_id = relation_type_id('IS_A')
    ),
    m AS (
        SELECT p.eid, array_agg(DISTINCT tb.bit) AS bits
        FROM pairs p
        JOIN tbits tb ON tb.tid = p.tid
        WHERE tb.bit IS NOT NULL
        GROUP BY p.eid
    ),
    upd AS (
        UPDATE entities e
        SET highway_mask = laplace_highway_mask_from_bits(
                COALESCE(laplace_highway_mask_bits(e.highway_mask), ARRAY[]::int[]) || m.bits)
        FROM m
        WHERE e.id = m.eid
          AND (e.highway_mask IS NULL
               OR NOT (laplace_highway_mask_bits(e.highway_mask) @> m.bits))
        RETURNING 1
    )
    SELECT count(*) INTO updated FROM upd;
    RETURN updated;
END $$;
