CREATE OR REPLACE FUNCTION entity_type_counts_approx()
    RETURNS TABLE(type text, type_id bytea, entities_approx bigint)
    LANGUAGE sql STABLE 
    SET search_path = @extschema@, public AS $$
    -- entity_type_counts() GROUP BYs the whole of entities (44M rows and climbing).
    -- It cannot return under the 15s statement timeout the serving boundary enforces
    -- (SubstrateTools.cs), so the ONE operation that answers "what is actually in the
    -- substrate, by type" goes dark exactly when the substrate is large enough for the
    -- question to matter -- and the answer gets guessed instead. Guessed wrong: the
    -- distinct chess position count was argued at 10M vs 597M for a whole session
    -- because nothing could state it. This form answers it in ~20ms.
    --
    -- Planner-statistics form, the same sanctioned pattern as source_counts_approx and
    -- substrate_counts: per-type share = MCV frequency x reltuples, zero table access.
    -- entities is partitioned, so the parent's stats are the inherited ones and its
    -- reltuples is the tree total (both maintained by ANALYZE on the parent).
    --
    -- Bounds on the answer, stated rather than implied:
    --   * ANALYZE freshness bounds the error. Dominant types are accurate (the top
    --     buckets here sum to the substrate_counts() total); the tail is not, and a
    --     type below the MCV cutoff does not appear at all. Raise
    --     entities.type_id statistics target if a long tail matters.
    --   * No tier column. Univariate MCV cannot produce (tier, type) pairs; that
    --     needs CREATE STATISTICS (mcv) ON tier, type_id, which is a separate,
    --     larger decision. Exact per-(type, tier) stays entity_type_counts()'s job,
    --     off the serving path where a full scan is affordable.
    --
    -- render() is called once per MCV entry (~100 max), not per row -- measured 20ms
    -- total including name resolution, versus 9ms without it.
    WITH st AS (
        SELECT s.most_common_vals::text::bytea[] AS vals,
               s.most_common_freqs               AS freqs
        FROM pg_stats s
        WHERE s.schemaname = '@extschema@'
          AND s.tablename  = 'entities'
          AND s.attname    = 'type_id'
    ), rt AS (
        SELECT c.reltuples
        FROM pg_class c
        JOIN pg_namespace n ON n.oid = c.relnamespace
        WHERE n.nspname = '@extschema@' AND c.relname = 'entities'
    )
    SELECT render(m.tid)                        AS type,
           m.tid                                AS type_id,
           (m.freq * rt.reltuples)::bigint      AS entities_approx
    FROM st, rt, LATERAL unnest(st.vals, st.freqs) AS m(tid, freq)
    ORDER BY entities_approx DESC
$$;
