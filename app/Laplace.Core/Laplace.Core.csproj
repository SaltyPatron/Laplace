    <AssemblyName>Laplace.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Laplace.Data" />
    <InternalsVisibleTo Include="Laplace.Data.Tests" />
    <InternalsVisibleTo Include="Laplace.Hosting" />
    <InternalsVisibleTo Include="Laplace.Mcp" />
    <InternalsVisibleTo Include="Laplace.Cli" />
    <InternalsVisibleTo Include="Laplace.Cli.Tests" />
    <InternalsVisibleTo Include="Laplace.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" />
    <ProjectReference Include="$(LaplaceNativeInteropProject)"
                      AdditionalProperties="LaplaceNativeGenerated=$(LaplaceNativeGenerated)" />
  </ItemGroup>

</Project>
