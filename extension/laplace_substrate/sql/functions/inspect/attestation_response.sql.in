DROP FUNCTION IF EXISTS laplace.attestation_response(bytea, bytea, bytea[], bytea, integer);
-- Source/context filters bind witnessed support. Standing remains the declared
-- pooled prior; it is not a source-only refold. Counts are distinct sources in
-- that support, independent of repeated observations or consensus witness mass.
CREATE OR REPLACE FUNCTION ops.attestation_response_batch(
    p_subject_ids bytea[], p_relation_type_id bytea,
    p_source_scope bytea[] DEFAULT NULL, p_context_id bytea DEFAULT NULL,
    p_top_k integer DEFAULT NULL, p_unary boolean DEFAULT false)
RETURNS TABLE(subject_id bytea, object_id bytea, combined_eff_mu double precision,
    source_count integer, rating_fp1e9 bigint, rd_fp1e9 bigint, standing_scope text)
AS 'EXECUTION_LIBRARY', 'pg_laplace_attestation_response_batch'
LANGUAGE C STABLE;

CREATE OR REPLACE FUNCTION ops.attestation_response(
    p_subject_id bytea, p_relation_type_id bytea,
    p_source_scope bytea[] DEFAULT NULL, p_context_id bytea DEFAULT NULL,
    p_top_k integer DEFAULT 32)
RETURNS TABLE(object_id bytea, combined_eff_mu double precision,
    source_count integer, rating_fp1e9 bigint, rd_fp1e9 bigint)
LANGUAGE sql STABLE
BEGIN ATOMIC
    SELECT r.object_id,r.combined_eff_mu,r.source_count,r.rating_fp1e9,r.rd_fp1e9
    FROM ops.attestation_response_batch(ARRAY[p_subject_id],p_relation_type_id,
        p_source_scope,p_context_id,GREATEST(p_top_k,0)) r;
END;
