-- Drives an orphaned 'running' journal row to a cut-off terminal status and
-- closes every non-terminal file row of the run with it, so the ledger never
-- shows files still running under a closed run. SQL cannot verify process
-- liveness: the caller confirms no live ingest owns the run before closing.
-- Refuses rows not currently 'running' and statuses outside that vocabulary.
DROP FUNCTION IF EXISTS laplace.ingest_run_close(uuid, text);

CREATE OR REPLACE FUNCTION ops.ingest_run_close_open_files(p_run_id uuid)
    RETURNS bigint
    LANGUAGE sql
    VOLATILE
AS $$
    WITH closed AS (
        UPDATE laplace.ingest_file_journal f
           SET status = 'cancelled',
               ended_at = COALESCE(f.ended_at, clock_timestamp()),
               error = COALESCE(f.error,
                   'file did not reach completion: owning ingest run was cut off')
         WHERE f.run_id = p_run_id
           AND f.status IN ('inventoried', 'running', 'composed')
        RETURNING f.file_label
    )
    SELECT count(*) FROM closed;
$$;

CREATE OR REPLACE FUNCTION ops.ingest_run_close(p_run_id uuid, p_status text DEFAULT 'cancelled')
    RETURNS laplace.ingest_run_journal
    LANGUAGE plpgsql VOLATILE
    AS $$
DECLARE
    r laplace.ingest_run_journal%ROWTYPE;
BEGIN
    IF p_status NOT IN ('failed', 'cancelled') THEN
        RAISE EXCEPTION 'ingest_run_close: % is not a cut-off terminal status (failed|cancelled)', p_status;
    END IF;
    UPDATE laplace.ingest_run_journal
       SET status = p_status, ended_at = now()
     WHERE run_id = p_run_id AND status = 'running'
    RETURNING * INTO r;
    IF r.run_id IS NULL THEN
        RAISE EXCEPTION 'ingest_run_close: run % has no row in status=running', p_run_id;
    END IF;
    PERFORM ops.ingest_run_close_open_files(p_run_id);
    RETURN r;
END $$;
