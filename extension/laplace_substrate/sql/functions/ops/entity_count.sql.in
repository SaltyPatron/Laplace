-- BEGIN ATOMIC: GH #764.

CREATE OR REPLACE FUNCTION ops.entity_count(p_type bytea)
    RETURNS bigint
    LANGUAGE sql STABLE
BEGIN ATOMIC
    -- Scalar counterpart to ops.entity_type_counts(). That function aggregates every
    -- type in the substrate; a caller that wants one type's count should not pay
    -- a full GROUP BY over entities to read a single row. Here p_type arrives as
    -- a plain equality the planner can drive from the type_id index.
    --
    -- NULL p_type counts nothing, not everything: `type_id = NULL` matches no
    -- rows, and an unspecified type is not a wildcard. Callers that want the
    -- whole-table count already have ops.substrate_counts().
    SELECT count(*) FROM laplace.entities e WHERE e.type_id = p_type;
END;

CREATE OR REPLACE FUNCTION ops.entity_counts_by_types(p_types bytea[])
    RETURNS TABLE(type_id bytea, entities bigint)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    -- Batch form: one round trip for N types, and every requested type comes back
    -- whether or not it has rows. A LEFT JOIN, not an inner one -- a type with no
    -- entities is a 0, and dropping it would make "absent from the result" and
    -- "count zero" the same answer, which is the tri-state collapse the read law
    -- names. Callers resolving names should aggregate ids and batch, not loop.
    SELECT t.type_id, count(e.id)
    FROM unnest(p_types) AS t(type_id)
    LEFT JOIN laplace.entities e ON e.type_id = t.type_id
    GROUP BY t.type_id;
END;
