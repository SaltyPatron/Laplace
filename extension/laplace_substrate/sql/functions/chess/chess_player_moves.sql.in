DROP FUNCTION IF EXISTS laplace.chess_player_moves(bytea, bytea, boolean, integer);
CREATE OR REPLACE FUNCTION chess.player_moves(
        p_position bytea, p_player bytea, p_as_white boolean,
        p_limit integer DEFAULT 12)
    RETURNS TABLE(next_position bytea, games bigint, score double precision)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    -- The transition decomposer materializes every witnessed position --MOVE--> position
    -- with context_id = the playing event. Start at that indexed exact-position evidence,
    -- then keep only contexts whose colour header names this player. This is a constant number
    -- of indexed evidence hops; it never opens every full line trajectory in the repertoire.
    --
    -- One playing contributes at most once to the same successor even if another source has
    -- witnessed the identical transition. Colour and result are still joined on both the line
    -- and playing context, so a shared line cannot leak another playing's side or score.
    WITH rel AS MATERIALIZED (
        SELECT consensus.relation_family_ids('HAS_RESULT') AS result_types
    ),
    transition_playings AS MATERIALIZED (
        SELECT t.context_id AS playing_id, t.object_id AS next_position
        FROM laplace.attestations t
        WHERE t.subject_id = p_position
          -- Keep the immutable family directly in the predicate so PostgreSQL can prune the
          -- LIST relation partitions before touching the position-keyed MOVE leaf.
          AND t.type_id = ANY (consensus.relation_family_ids('MOVE'))
          AND t.object_id IS NOT NULL
          AND t.context_id IS NOT NULL
        GROUP BY t.context_id, t.object_id
    ),
    player_steps AS MATERIALIZED (
        SELECT tp.next_position, h.subject_id AS line_id, h.context_id AS playing_id,
               max(h.observation_count)::bigint AS games
        FROM transition_playings tp
        JOIN laplace.attestations h ON h.context_id = tp.playing_id
        WHERE h.type_id = laplace.relation_type_id(
                  CASE WHEN p_as_white THEN 'HAS_WHITE' ELSE 'HAS_BLACK' END)
          AND h.object_id = p_player
          AND h.context_id IS NOT NULL
        GROUP BY tp.next_position, h.subject_id, h.context_id
    ),
    results AS MATERIALIZED (
        SELECT ps.next_position, ps.line_id, ps.playing_id, ps.games,
               max(r.object_id) AS result_id
        FROM player_steps ps
        JOIN laplace.attestations r
          ON r.subject_id = ps.line_id
         AND r.context_id = ps.playing_id
        JOIN rel ON r.type_id = ANY (rel.result_types)
        GROUP BY ps.next_position, ps.line_id, ps.playing_id, ps.games
    ),
    scored_steps AS MATERIALIZED (
        SELECT r.next_position, r.games,
               chess.outcome(p_as_white, r.result_id)::double precision / 2.0 AS score
        FROM results r
        WHERE chess.outcome(p_as_white, r.result_id) IS NOT NULL
    )
    SELECT next_position,
           sum(games)::bigint AS games,
           (sum(score * games) / sum(games))::double precision AS score
    FROM scored_steps
    GROUP BY next_position
    ORDER BY games DESC
    LIMIT p_limit
$$;
