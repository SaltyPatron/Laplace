-- explore_anchor_neighbors: neighbour search from a COMPUTED anchor geometry,
-- not a stored one. When a word (or any content) is typed but never witnessed,
-- its content hash resolves to an id with no laplace.entities/laplace.physicalities row
-- (exists = false) -- yet its geometry is fully determined: HashComposer pins
-- every codepoint on S3 from the t0 perfcache and composes the parent coord and
-- trajectory in-process. The endpoint hands that computed anchor here as bound
-- parameters (centroid coord + optional trajectory WKT), so the KNN runs on a
-- real index-ordered scan (bound param, GiST-eligible -- unlike a correlated
-- subquery anchor) instead of returning nothing for want of a stored row.
--
-- Two axes, deliberately different notions of "near" (both returned so the UI
-- can navigate either way):
--   geodesic -- nearest witnessed content of ANY tier by the anchor centroid on
--     the glome. Positional/content proximity; centroids commute, so it mixes
--     tiers/modalities. Fast: index-ordered coord <<->> prefilter.
--   shape    -- nearest witnessed WORDS by REALIZED curve shape (Frechet over
--     entity_curve = ST_MakeLine(child.coord ORDER BY ordinal)). p_traj_wkt from
--     ExploreDecomposeService is already a realized LINESTRING ZM of child
--     coords; candidates must use entity_curve, never packed
--     laplace.physicalities.trajectory (Rule #3 / Issue 51).
DROP FUNCTION IF EXISTS laplace.explore_anchor_neighbors(float8, float8, float8, float8, text, integer, integer, float8);
CREATE OR REPLACE FUNCTION structural.explore_anchor_neighbors(
    p_cx float8, p_cy float8, p_cz float8, p_cm float8,
    p_traj_wkt   text    DEFAULT NULL,
    p_geodesic_k integer DEFAULT 12,
    p_frechet_k  integer DEFAULT 12,
    p_frechet_max float8  DEFAULT 0.08)
RETURNS TABLE(
    axis        text,
    entity_id   bytea,
    label       text,
    tier        smallint,
    geodesic    float8,
    frechet     float8)
LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH params AS MATERIALIZED (
        SELECT public.ST_SetSRID(public.ST_MakePoint(p_cx, p_cy, p_cz, p_cm), 0) AS v_anchor,
               CASE
                   WHEN p_traj_wkt IS NULL OR p_traj_wkt = '' THEN NULL::geometry
                   ELSE public.ST_SetSRID(public.ST_GeomFromText(p_traj_wkt), 0)
               END AS v_traj
    ),
    g AS (
        SELECT w.id AS entity_id,
               public.laplace_angular_distance_4d(w.coord, pr.v_anchor) AS geo
        FROM params pr
        JOIN laplace.v_word_points w
          ON public.laplace_direction_4d(w.coord) IS NOT NULL
         AND public.laplace_direction_4d(pr.v_anchor) IS NOT NULL
        ORDER BY public.laplace_direction_4d(w.coord)
                 <<->> public.laplace_direction_4d(pr.v_anchor)
        LIMIT p_geodesic_k
    ), geo_numbered AS MATERIALIZED (
        SELECT g.*, row_number() OVER (ORDER BY g.geo, g.entity_id) AS rn FROM g
    ), geo_ids AS MATERIALIZED (
        SELECT array_agg(geo_numbered.entity_id ORDER BY geo_numbered.rn) AS a FROM geo_numbered
    ), geo_display AS MATERIALIZED (
        SELECT realize.render_text_batch(a) AS rendered,
               realize.label_batch(a) AS labels
        FROM geo_ids
    ),
    pre AS (
        SELECT w.id AS entity_id, pr.v_traj
        FROM params pr
        JOIN laplace.v_word_points w
          ON w.type_id = laplace.entity_type_id('Word') AND w.trajectory IS NOT NULL
        WHERE pr.v_traj IS NOT NULL
        ORDER BY w.coord <<->> pr.v_anchor
        LIMIT p_frechet_k
    ),
    f AS (
        SELECT c.entity_id,
               public.laplace_frechet_4d(c.curve, c.v_traj) AS fr
        FROM (
            SELECT pre.entity_id, pre.v_traj, structural.entity_curve(pre.entity_id) AS curve
            FROM pre
        ) c
        WHERE c.curve IS NOT NULL
    ), shape_survivors AS MATERIALIZED (
        SELECT f.entity_id, f.fr
        FROM f
        WHERE f.fr IS NOT NULL AND f.fr <= p_frechet_max
        ORDER BY f.fr, f.entity_id
    ), shape_numbered AS MATERIALIZED (
        SELECT s.*, row_number() OVER (ORDER BY s.fr, s.entity_id) AS rn FROM shape_survivors s
    ), shape_ids AS MATERIALIZED (
        SELECT array_agg(shape_numbered.entity_id ORDER BY shape_numbered.rn) AS a FROM shape_numbered
    ), shape_display AS MATERIALIZED (
        SELECT realize.render_text_batch(a) AS rendered,
               realize.label_batch(a) AS labels
        FROM shape_ids
    )
    SELECT * FROM (
        SELECT 'geodesic'::text AS axis,
               n.entity_id,
               COALESCE(NULLIF(d.rendered[n.rn], ''), d.labels[n.rn]) AS label,
               (SELECT min(e.tier) FROM laplace.entities e WHERE e.id = n.entity_id) AS tier,
               n.geo AS geodesic,
               NULL::float8 AS frechet
        FROM geo_numbered n CROSS JOIN geo_display d
        ORDER BY n.geo
    ) geo_rows
    UNION ALL
    SELECT * FROM (
        SELECT 'shape'::text AS axis,
               f.entity_id,
               COALESCE(NULLIF(d.rendered[f.rn], ''), d.labels[f.rn]) AS label,
               (SELECT min(e.tier) FROM laplace.entities e WHERE e.id = f.entity_id) AS tier,
               NULL::float8 AS geodesic,
               f.fr AS frechet
        FROM shape_numbered f CROSS JOIN shape_display d
        ORDER BY f.fr
    ) shape_rows;
END;
