-- The IS_A tree around a topic: dir='self' the root (a bare surface hops to
-- its top synset — taxonomy lives on concepts, not spellings), dir='up' the
-- parent chain to the root, dir='child' the strongest sub-kinds.
CREATE OR REPLACE FUNCTION taxonomy.tree(
    p_id bytea,
    p_depth integer DEFAULT NULL,
    p_child_limit integer DEFAULT NULL)
    RETURNS TABLE(dir text, ord int, id bytea, label text, eff_mu numeric)
    LANGUAGE sql STABLE
BEGIN ATOMIC
    WITH rel AS MATERIALIZED (
        SELECT laplace.relation_type_id('IS_A') AS is_a
    ), root AS MATERIALIZED (
        SELECT COALESCE(taxonomy.top_synset(p_id), p_id) AS id
    ), raw AS MATERIALIZED (
      SELECT 'self'::text AS dir, 0 AS ord, root.id, NULL::numeric AS eff_mu FROM root
      UNION ALL
      SELECT 'up', w.step, w.entity_id, w.eff_mu
      FROM root CROSS JOIN LATERAL (SELECT (u.n-1)::int AS step,
                public.blake3_send((public.laplace_parts(pp.path))[2]) AS type_id,
                public.blake3_send(u.x) AS entity_id,
                (st.rating-2*st.deviation)::numeric AS eff_mu
         FROM (SELECT w.chain,w.claims FROM public.laplace_pull(ARRAY[public.blake3_from_bytea(root.id)],NULL,
                   COALESCE(p_depth,4),64::bigint,4096::bigint,ARRAY[public.laplace_text_id('hypernym')]) w
               WHERE w.hops>=1 ORDER BY w.hops DESC,w.cost,w.ordinal LIMIT 1) b
         CROSS JOIN LATERAL unnest(b.chain) WITH ORDINALITY u(x,n)
         LEFT JOIN public.laplace_paths(b.claims) pp ON pp.entity=b.claims[u.n-1]
         LEFT JOIN public.laplace_standings(b.claims) st ON st.claim=b.claims[u.n-1]
         WHERE u.n>1) w
      UNION ALL
      (SELECT 'child',
            row_number() OVER (ORDER BY ch.mu DESC, ch.subject_id)::int,
            ch.subject_id,
            ch.mu
       FROM (
         SELECT DISTINCT ON (x.subject_id)
                x.subject_id, x.mu
         FROM (
           SELECT c.subject_id, consensus.eff_mu_display(c.rating, c.rd) AS mu
           FROM root CROSS JOIN rel r JOIN laplace.consensus c
             ON c.object_id = root.id AND c.type_id = r.is_a
           UNION ALL
           SELECT e.neighbour_id AS subject_id, consensus.eff_mu_display(e.rating, e.rd) AS mu
           FROM root CROSS JOIN rel r
           CROSS JOIN LATERAL consensus.edges_raw(root.id, 'in', ARRAY[r.is_a], GREATEST(COALESCE(p_child_limit, 32), 0), true, 'eff_mu') e
           WHERE e.neighbour_id IS NOT NULL
         ) x
         ORDER BY x.subject_id, x.mu DESC
       ) ch
       ORDER BY ch.mu DESC, ch.subject_id
       LIMIT GREATEST(COALESCE(p_child_limit, 32), 0))
    ), ids AS MATERIALIZED (
      SELECT array_agg(DISTINCT id ORDER BY id) AS a FROM raw
    ), labels AS MATERIALIZED (
      SELECT i.id, i.txt FROM ids,
        LATERAL ROWS FROM (
          unnest(ids.a), unnest(realize.label_batch(ids.a))
        ) i(id, txt)
    )
    SELECT r.dir, r.ord, r.id, l.txt, r.eff_mu
    FROM raw r JOIN labels l ON l.id=r.id
    ORDER BY CASE r.dir WHEN 'self' THEN 0 WHEN 'up' THEN 1 ELSE 2 END, r.ord;
END;
