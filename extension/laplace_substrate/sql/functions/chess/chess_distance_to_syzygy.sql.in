-- chess.distance_to_syzygy(line): observed distance along a line to the first
-- substrate-resident closing transition. Silence is not a draw — empty when the
-- line never reaches a decoded tablebase position.  Legacy v2 attestations remain
-- readable until the clean compact seed replaces them.
--
-- Relation vocabulary via chess_has_wdl_type / chess.has_dtz_type(ISA G3).
DROP FUNCTION IF EXISTS laplace.chess_distance_to_syzygy(bytea);
CREATE OR REPLACE FUNCTION chess.distance_to_syzygy(p_line bytea)
    RETURNS TABLE(
        position_id bytea,
        plies_to_close integer,
        d_men integer,
        wdl text,
        dtz text)
    LANGUAGE sql STABLE
 AS $$
WITH rel AS MATERIALIZED (
    SELECT chess.has_wdl_type() AS wdl, chess.has_dtz_type() AS dtz
),
line AS MATERIALIZED (
    SELECT (u.ord - 1)::int AS ply, u.entity_id AS pos
    FROM LATERAL generation.trajectory_unpacked_points(p_line, 3::smallint)
         WITH ORDINALITY AS u(entity_id, run_length, ctier, ord)
),
compact AS MATERIALIZED (
    SELECT l.ply, l.pos, t.wdl, t.dtz
    FROM line l
    CROSS JOIN LATERAL chess.syzygy_transition(l.pos) t
    ORDER BY l.ply
    LIMIT 1
),
legacy AS MATERIALIZED (
    SELECT l.ply, l.pos,
           max(a.object_id) FILTER (WHERE a.type_id = r.wdl) AS wdl_id,
           max(a.object_id) FILTER (WHERE a.type_id = r.dtz) AS dtz_id
    FROM line l
    JOIN rel r ON true
    JOIN laplace.attestations a ON a.subject_id = l.pos
                       AND a.type_id IN (r.wdl, r.dtz)
    GROUP BY l.ply, l.pos
    HAVING max(a.object_id) FILTER (WHERE a.type_id = r.wdl) IS NOT NULL
    ORDER BY l.ply
    LIMIT 1
),
hit AS MATERIALIZED (
    SELECT c.ply, c.pos, c.wdl, c.dtz::text AS dtz,
           NULL::bytea AS wdl_id, NULL::bytea AS dtz_id
    FROM compact c
    UNION ALL
    SELECT l.ply, l.pos, NULL::integer, NULL::text, l.wdl_id, l.dtz_id
    FROM legacy l
    WHERE NOT EXISTS (SELECT 1 FROM compact)
),
surfaces AS MATERIALIZED (
    SELECT COALESCE(array_agg(DISTINCT s), '{}'::bytea[]) AS ids
    FROM hit h, LATERAL (VALUES (h.wdl_id), (h.dtz_id)) v(s)
    WHERE s IS NOT NULL
),
label AS MATERIALIZED (
    SELECT p.id, p.txt
    FROM surfaces b,
         LATERAL ROWS FROM (
             unnest(b.ids), unnest(realize.batch(b.ids, NULL))
         ) AS p(id, txt)
)
SELECT h.pos,
       h.ply,
       -- Exact men is a board fact (compose-time). Not stored on laplace.physicalities;
       -- NULL here rather than lying with n_constituents (substructure count).
       NULL::integer,
       COALESCE(
           CASE h.wdl
               WHEN 0 THEN 'loss'
               WHEN 1 THEN 'blessed-loss'
               WHEN 2 THEN 'draw'
               WHEN 3 THEN 'cursed-win'
               WHEN 4 THEN 'win'
           END,
           w.txt),
       COALESCE(h.dtz, d.txt)
FROM hit h
LEFT JOIN label w ON w.id = h.wdl_id
LEFT JOIN label d ON d.id = h.dtz_id
$$;
