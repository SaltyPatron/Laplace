-- The relation-type ids in a salience band, as an ARRAY the planner can prune with.
--
-- THE DEFECT THIS RETIRES. 25 sites across the read path wrote the band test as
-- `relation_highway_band(c.type_id) = N` directly against consensus. consensus is
-- LIST-partitioned by type_id and holds ~48M rows, so a function applied to the
-- partition key means: no partition pruning (the planner cannot evaluate a C
-- STABLE call at plan time), no index on the predicate, and one function
-- invocation PER EDGE SCANNED. The band is a property of ~221 relation types, and
-- it was being recomputed tens of millions of times to filter rows.
--
-- chat.sql.in's band lens already had the right shape and said why: resolve the
-- types up front, "there are ~189 governed types, so resolving the set up front
-- turns the filter into an indexed (subject_id, type_id) probe". This makes that
-- one call instead of a hand-rolled CTE at every site.
--
-- Applying relation_highway_band to the RelationType entities is fine and is the
-- point: 221 rows, once, versus 48M rows, per query. Same predicate, moved to the
-- small side of the join.
--
-- STABLE, not IMMUTABLE: relation_highway_band resolves through the manifest and
-- the entity set can gain dynamically-minted relations at ingest. PARALLEL SAFE
-- and no SET search_path, so it inlines into the caller's plan and the array
-- becomes a bound parameter rather than an opaque function scan.
CREATE OR REPLACE FUNCTION relation_band_types(p_band int)
    RETURNS bytea[]
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    SELECT COALESCE(array_agg(e.id), '{}'::bytea[])
    FROM @extschema@.entities e
    WHERE e.type_id = @extschema@.entity_type_id('RelationType')
      AND @extschema@.relation_highway_band(e.id) = p_band
$$;

-- Multi-band form. Callers testing several bands (the content bands 1/2/4/7 are
-- the common set) get one array rather than N calls unioned, so the probe stays a
-- single `= ANY`.
CREATE OR REPLACE FUNCTION relation_band_types(p_bands int[])
    RETURNS bytea[]
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    SELECT COALESCE(array_agg(e.id), '{}'::bytea[])
    FROM @extschema@.entities e
    WHERE e.type_id = @extschema@.entity_type_id('RelationType')
      AND @extschema@.relation_highway_band(e.id) = ANY (p_bands)
$$;

-- Family form, same reasoning. relation_type_in_family is IMMUTABLE and cheap per
-- call, but seven predicate sites still ran it per consensus edge instead of per
-- relation type. relation_family_members() already returns the rows; this returns
-- them as the array shape a partition-pruning probe needs.
CREATE OR REPLACE FUNCTION relation_family_type_ids(p_family text)
    RETURNS bytea[]
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    SELECT COALESCE(array_agg(m.id), '{}'::bytea[])
    FROM @extschema@.relation_family_members(p_family) m
$$;
