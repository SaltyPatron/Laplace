-- consensus.relation_summary(x, y): how two terms relate, from their strongest coupling
-- evidence (converse.couple), realized in the terms' language.
--   relation  the realized evidence: "<x key> · <relation or ancestor> · <y key>"
--   plane     the coupling channel: usage / fact / ancestor
--   mu        the evidence weight (specificity-weighted)
--   usage     how many structures contain both terms
DROP FUNCTION IF EXISTS laplace.relation_summary(bytea, bytea);
CREATE OR REPLACE FUNCTION consensus.relation_summary(p_x bytea, p_y bytea)
    RETURNS TABLE(relation text, plane text, mu numeric, usage bigint,
                  geodesic double precision, verdict text)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH lang AS (
        SELECT converse.terms_language(ARRAY[p_x, p_y]) AS l
    ), ev AS MATERIALIZED (
        SELECT c.* FROM lang, converse.couple(p_x, p_y, lang.l, 256) c
    ), best AS (
        SELECT e.* FROM ev e WHERE e.channel <> 'usage' ORDER BY e.weight DESC LIMIT 1
    ), shared AS (
        SELECT count(*)::bigint AS n FROM ev WHERE channel = 'usage'
    ), labels AS (
        SELECT realize.batch(ARRAY[b.x_key, b.via, b.y_key], (SELECT l FROM lang)) AS l,
               lexical.type_label(b.relation) AS rel
        FROM best b
    )
    SELECT CASE WHEN b.channel IS NULL THEN NULL
                ELSE concat_ws(' · ', lb.l[1],
                               COALESCE(lb.rel, CASE WHEN b.channel = 'ancestor' THEN 'both are kinds of' END),
                               lb.l[2], lb.l[3]) END,
           b.channel,
           round(b.weight::numeric, 6),
           s.n,
           public.laplace_angular_distance_4d(
               (SELECT coord FROM laplace.v_word_points WHERE id = p_x AND coord IS NOT NULL LIMIT 1),
               (SELECT coord FROM laplace.v_word_points WHERE id = p_y AND coord IS NOT NULL LIMIT 1)),
           concat_ws('',
             CASE WHEN b.channel IS NOT NULL THEN 'related via ' || b.channel
                  ELSE 'no witnessed coupling' END,
             CASE WHEN s.n > 0 THEN '; shared usage (' || s.n || ')' ELSE '' END)
    FROM (SELECT 1) one
    CROSS JOIN shared s
    LEFT JOIN best b ON true
    LEFT JOIN labels lb ON true;
END;
