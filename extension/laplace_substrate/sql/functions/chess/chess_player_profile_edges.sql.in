-- Profile testimony asserted directly about the requested player identity plus provider
-- identities explicitly associated by a witnessed, context-bearing link.
--
-- Historical name-derived CORRESPONDS_TO rows were contextless. They are deliberately
-- excluded here: equal names are candidate referents, not identity. New explicit Lab
-- associations carry a deterministic provenance context, so the read can materialize the
-- selected provider profile without reopening the old contamination path.
--
-- Source and relation predicates are applied before rendering or ordering, so game volume
-- cannot crowd profile data out of this read.
CREATE OR REPLACE FUNCTION chess.player_profile_edges(p_player bytea)
    RETURNS TABLE(subject_id bytea, type_id bytea, object_id bytea)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH identity_ids(id) AS MATERIALIZED (
        SELECT p_player
        UNION
        SELECT a.object_id
        FROM laplace.attestations a
        WHERE a.subject_id = p_player
          AND a.object_id IS NOT NULL
          AND a.context_id IS NOT NULL
          AND a.type_id = ANY (consensus.relation_set_ids('CHESS_PROFILE_IDENTITY'))
          AND a.source_id = ANY (ARRAY[
              laplace.source_id('LichessPlayerProfile'),
              laplace.source_id('ChessComPlayerProfile'),
              laplace.source_id('FidePlayerProfile')
          ]::bytea[])
        UNION
        SELECT a.subject_id
        FROM laplace.attestations a
        WHERE a.object_id = p_player
          AND a.context_id IS NOT NULL
          AND a.type_id = ANY (consensus.relation_set_ids('CHESS_PROFILE_IDENTITY'))
          AND a.source_id = ANY (ARRAY[
              laplace.source_id('LichessPlayerProfile'),
              laplace.source_id('ChessComPlayerProfile'),
              laplace.source_id('FidePlayerProfile')
          ]::bytea[])
    )
    SELECT DISTINCT i.id, a.type_id, a.object_id
    FROM identity_ids i
    JOIN laplace.attestations a ON a.subject_id = i.id
    WHERE a.source_id = ANY (ARRAY[
              laplace.source_id('LichessPlayerProfile'),
              laplace.source_id('ChessComPlayerProfile'),
              laplace.source_id('FidePlayerProfile')
          ]::bytea[])
      AND a.type_id = ANY (consensus.relation_set_ids('CHESS_PROFILE_FACTS'))
    ORDER BY i.id, a.type_id, a.object_id;
END;
