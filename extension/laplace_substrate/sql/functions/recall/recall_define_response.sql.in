-- Witnessed glosses for a topic, sense-disambiguated by the other content ids
-- the caller resolved. Takes ids, not prompt text: what disambiguates a sense is
-- the company it keeps in the substrate, not the sentence it arrived in.
CREATE OR REPLACE FUNCTION converse.recall_define_response(p_topic bytea, p_context_ids bytea[] DEFAULT NULL)
    RETURNS TABLE(reply text, eff_mu numeric, witnesses bigint)
    LANGUAGE plpgsql STABLE PARALLEL SAFE
AS $$
BEGIN
    RETURN QUERY
    SELECT d.definition AS reply, d.eff_mu, d.witnesses
    FROM converse.define_fast(p_topic, COALESCE(p_context_ids, ARRAY[]::bytea[])) d;
    IF FOUND THEN
        RETURN;
    END IF;
    RETURN QUERY
    SELECT l.definition, l.eff_mu, l.witnesses
    FROM lexical.define(p_topic, 5) l;
END;
$$;
