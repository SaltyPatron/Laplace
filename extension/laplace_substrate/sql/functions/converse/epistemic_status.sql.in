-- converse.epistemic_status_core: the VERDICT rule alone, on Laplace-Native's
-- standing scale. The strands are the attested compositions that hold the entity
-- (public.laplace_claims_each over the containment index), each with its
-- standing from public.consensus, keyed by the strand's entity id. No triple:
-- a strand is a composition of any arity, its parts read through its path.
--
-- Verdict, read through public.laplace_confidence (anchor 1500):
--   refuted    its optimistic bound loses to the anchor     (consensus.refuted)
--   confirmed  its conservative bound beats the anchor      (consensus.eff_mu > 1/2)
--   contested  volatility above 1.5x the unrated volatility (Native LP_GLICKO_VOLATILITY)
--   thin       otherwise
CREATE OR REPLACE FUNCTION converse.epistemic_status_core(p_entity bytea, p_limit int DEFAULT 30)
    RETURNS TABLE(strand bytea, parts bytea[], status text, rating double precision,
                  deviation double precision, volatility double precision, matches bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH held AS (
        SELECT c.entity, c.path, c.rating, c.deviation, c.volatility, c.matches
        FROM public.laplace_claims_each(ARRAY[public.blake3_from_bytea(p_entity)], NULL::bigint,
                                        '{}'::smallint[], '{}'::public.blake3[], 0::smallint) c
        WHERE c.rating IS NOT NULL
        ORDER BY consensus.eff_mu(c.rating, c.deviation) DESC, c.entity
        LIMIT p_limit)
    SELECT public.blake3_send(h.entity),
           ARRAY(SELECT public.blake3_send(p) FROM unnest(public.laplace_parts(h.path)) WITH ORDINALITY u(p, o) ORDER BY o),
           CASE WHEN consensus.refuted(h.rating, h.deviation) THEN 'refuted'
                WHEN consensus.eff_mu(h.rating, h.deviation) > 0.5 THEN 'confirmed'
                WHEN h.volatility > consensus.glicko2_initial_volatility() * 1.5 THEN 'contested'
                ELSE 'thin' END,
           h.rating, h.deviation, h.volatility, h.matches
    FROM held h
    ORDER BY consensus.eff_mu(h.rating, h.deviation) DESC, h.entity;
END;

-- converse.epistemic_status adds each strand's text (public.laplace_text of the
-- composition, recomposed from the substrate) and its displayed confidence.
CREATE OR REPLACE FUNCTION converse.epistemic_status(p_entity bytea, p_limit int DEFAULT 30)
    RETURNS TABLE(strand bytea, fact text, status text, confidence numeric,
                  volatility numeric, matches bigint)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT r.strand, public.laplace_text(public.blake3_from_bytea(r.strand)), r.status,
           consensus.eff_mu_display(r.rating, r.deviation),
           round(r.volatility::numeric, 4), r.matches
    FROM converse.epistemic_status_core(p_entity, p_limit) r;
END;
