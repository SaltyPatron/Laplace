-- consensus.walk_edge_weight(rating, rd, witness_count [, kappa]) -> float8
--
-- The Glicko-complete signed edge weight (doc 14 P5), and the ONLY expression
-- of it. Signed by the RATING against neutral; magnitude discounted by RD
-- (exp(-kappa*rd)) and saturated by witness count (Michaelis-Menten, half-max
-- at 4). Refutation stays negative; a wide-RD win ranks low but stays walkable.
-- The full rationale for the sign law is in glicko2.c above
-- laplace_walk_edge_weight -- not restated here, because restating it is the
-- defect this function exists to remove.
--
-- Before this function the formula was written twice: once in C (glicko2.c,
-- used by generate_walk.c's beam and astar_path.c's edge_cost) and once as a
-- hand-typed SQL expression inside consensus_adjacency.sql.in. So the weight
-- the ENGINE walks and the weight the FOUNDRY exports -- the same claim about
-- the same edge -- came from two separately-maintained bodies, with the
-- witness half-max (4.0) written into both. Nothing tested that they agreed;
-- the only cross-language parity test in the tree pinned eff_mu, the trivial
-- one. tests/sql/walk_edge_weight_parity.sql now pins THIS.
--
-- kappa defaults to consensus.foundry_rd_kappa(), the same SQL tunable the native
-- walkers fetch through spi_fetch_rd_kappa(). That was already single-sourced
-- and stays so; only the formula and the half-max were duplicated.
--
-- NOT eff_mu. consensus.eff_mu(rating - 2*rd) remains the conservative RANKING key --
-- it is the indexed expression and the correct ORDER BY for reads. This is the
-- WEIGHT: what an edge contributes to a walk score or an exported tensor.
-- Using eff_mu as a sign/gate is the bug glicko2.c documents (99.04% of won
-- claims scored negative, an accidental floor at eff_mu >= neutral).
DROP FUNCTION IF EXISTS laplace.walk_edge_weight(bigint, bigint, bigint, double precision);
CREATE OR REPLACE FUNCTION consensus.walk_edge_weight(
        p_rating bigint, p_rd bigint, p_witness_count bigint, p_kappa double precision)
    RETURNS double precision
    AS 'MODULE_PATHNAME', 'pg_laplace_walk_edge_weight'
    LANGUAGE C LAPLACE_IMMUTABLE_STRICT;

DROP FUNCTION IF EXISTS laplace.walk_edge_weight(bigint, bigint, bigint);
CREATE OR REPLACE FUNCTION consensus.walk_edge_weight(
        p_rating bigint, p_rd bigint, p_witness_count bigint)
    RETURNS double precision
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT consensus.walk_edge_weight(p_rating, p_rd, p_witness_count,
                                        consensus.foundry_rd_kappa());
END;
