-- lexical.lexical_peers — GH #862 / #860. No SET (it blocks plan caching and SQL
-- inlining, so the body re-plans per call); real schema names, no build-time
-- placeholder.
DROP FUNCTION IF EXISTS laplace.lexical_peers(bytea);
CREATE OR REPLACE FUNCTION lexical.lexical_peers(p_word bytea)
    RETURNS bytea[]
    LANGUAGE plpgsql STABLE STRICT PARALLEL SAFE AS $$
DECLARE
    v bytea[];
BEGIN
    -- WIDENING IS A FALLBACK, AND plpgsql IS WHAT MAKES IT ONE.
    --
    -- dog, Dog and DOG are DIFFERENT CONTENT, so different hashes and different
    -- entities (laplace.word_id('dog') = 01cdcce1..., word_id('Dog') = af1513f0...).
    -- Merging them asserts an equivalence the identity scheme denies, and case folding
    -- exists only in bicameral scripts. Where the relation is real the graph attests it:
    -- dog and Dog carry an IS_SYNONYM_OF edge.
    --
    -- THIS WAS WRITTEN IN SQL FIRST AND THE GUARD DID NOT HOLD. A `CASE WHEN exists
    -- THEN ARRAY[p_word] ELSE (widening) END` returns the right ANSWER but still does
    -- the WORK: the sub-SELECT in the ELSE is hoisted to an InitPlan and evaluated
    -- unconditionally. Verified by call count -- lexical_peers(word_id('dog')), which
    -- resolves exactly and returns one peer, still invoked lexical.word_case_variants
    -- once. Rewriting the guard as `WHERE NOT EXISTS (...)` on the widening arm did not
    -- help either; the set-returning function was still invoked. plpgsql IF is the
    -- construct that actually skips it.
    --
    -- What that call costs, measured in laplace.pg_stat_statements on one
    -- converse.prompt_coherence('the capital of France is'): word_case_variants 5 calls /
    -- 98.5 ms mean, and the per-id realize.render_text inside it another 5 / 88.4 ms --
    -- ~934 ms, about half that function, for five tokens that all resolve exactly.
    IF EXISTS (SELECT 1 FROM laplace.consensus c
                WHERE c.subject_id = p_word
                  AND c.type_id = ANY (consensus.relation_family_ids('HAS_SENSE')))
    THEN
        RETURN ARRAY[p_word];
    END IF;

    SELECT COALESCE(array_agg(DISTINCT id ORDER BY id), ARRAY[p_word])
      INTO v
      FROM (SELECT p_word AS id
            UNION SELECT unnest(lexical.word_case_variant_ids(p_word)) AS id) m
     WHERE id IS NOT NULL;
    RETURN v;
END $$;
