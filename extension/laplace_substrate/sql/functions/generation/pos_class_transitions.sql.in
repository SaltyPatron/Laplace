-- Finish-line Phase 4 v1b (the syntax organ, lm_head composition path): the
-- pos_transition_plane word-pair projection caps at 512 arbitrary-tiebreak
-- rows per word — wrong grain for a floor correction. The lm_head wants the
-- ~18x18 CLASS table + each vocab word's dominant class; the dense compose
-- M[x,y] += gain * T[class(x),class(y)] happens client-side over the full
-- V x V table (SQL returns the small fact tables; C# orchestrates).
CREATE OR REPLACE FUNCTION generation.vocab_dominant_pos(p_vocab bytea[])
    RETURNS TABLE(word_id bytea, pos_id bytea)
    LANGUAGE plpgsql STABLE PARALLEL RESTRICTED AS $$
DECLARE
    v_type bytea;
BEGIN
    v_type := laplace.relation_type_id('HAS_POS');
    RETURN QUERY
    WITH v(id) AS (SELECT DISTINCT u FROM unnest(p_vocab) AS u),
    direct AS (
        SELECT DISTINCT ON (c.subject_id) c.subject_id AS wid, c.object_id AS pos
        FROM v
        JOIN laplace.v_consensus_unrefuted c ON c.subject_id = v.id
            AND c.type_id = v_type
        WHERE c.object_id IS NOT NULL
        ORDER BY c.subject_id, consensus.eff_mu(c.rating, c.rd) DESC
    ),
    -- CASE-VARIANT ASYMMETRY, resolved through the ATTESTED case surface.
    -- 'ALL' may carry no HAS_POS witness while 'all' does. They are different
    -- content and therefore different ids -- that is the identity law, not a
    -- defect -- and the substrate already holds the link: HAS_UPPERCASE_MAPPING /
    -- HAS_LOWERCASE_MAPPING / HAS_TITLECASE_MAPPING are governed in
    -- relation_types.toml, witnessed per codepoint from UnicodeData.txt fields
    -- 12/13/14, and composed to word grain natively and batched by
    -- lexical.word_case_variants(src/lexical_case.c), which also gates on entity_exists.
    --
    -- This previously read `laplace.word_id(lower(realize.render(vv.id)))`: realize.render the id back to
    -- text, case-fold the text, then MINT AN ID FROM THE FOLDED STRING. Not a
    -- lookup -- a fabrication. It leaves hash space mid-operation, discards the
    -- attested edges, and laplace.word_id() mints unconditionally, so an unwitnessed fold
    -- yields a well-formed id for content that may have no entity at all (the
    -- `m.fid IS NOT NULL` guard cannot catch that; laplace.word_id is never null). The
    -- result feeds pos_transition_plane and therefore the exported model's POS
    -- shaping, so a fabricated identity here becomes a weight.
    --
    -- Any attested variant is admissible, not just the lowercase one: the
    -- asymmetry runs both ways ('all' -> 'All' when only the title form is
    -- witnessed). Ties break on consensus.eff_mu then id, so the choice stays deterministic.
    missing AS (
        SELECT vv.id, unnest(lexical.word_case_variants(vv.id)) AS fid
        FROM v vv
        WHERE NOT EXISTS (SELECT 1 FROM direct d WHERE d.wid = vv.id)
    ),
    folded AS (
        SELECT DISTINCT ON (m.id) m.id AS wid, c.object_id AS pos
        FROM missing m
        JOIN laplace.v_consensus_unrefuted c ON c.subject_id = m.fid
            AND c.type_id = v_type
        WHERE c.object_id IS NOT NULL AND m.fid IS NOT NULL AND m.fid <> m.id
        ORDER BY m.id, consensus.eff_mu(c.rating, c.rd) DESC, m.fid
    )
    SELECT d.wid, d.pos FROM direct d
    UNION ALL
    SELECT f.wid, f.pos FROM folded f;
END;
$$;

-- Class-transition log-conditionals P^(class(y) | class(x)) from the same
-- fused continuation evidence as the conditional plane (word_order trajectory
-- adjacency), aggregated to the dominant-POS classes.
--
-- Pillar 5 (2026-07-20): PRECEDES-consensus leg removed. word_order reads the
-- ordered sequence straight from laplace.physicalities.trajectory via
-- laplace_trajectory_constituents, which is the same knowledge PRECEDES
-- materialized as redundant laplace.attestations(Pillar 3a, e5e1b42).
CREATE OR REPLACE FUNCTION generation.pos_class_transitions(
        p_vocab bytea[], p_trajs int DEFAULT 200000, p_smooth_k double precision DEFAULT 0.5)
    RETURNS TABLE(subject_id bytea, object_id bytea, w double precision)
    LANGUAGE plpgsql STABLE PARALLEL RESTRICTED AS $$
BEGIN
    RETURN QUERY
    WITH v(id) AS (SELECT DISTINCT u FROM unnest(p_vocab) AS u),
    word_pos AS MATERIALIZED (
        SELECT wp.word_id AS wid, wp.pos_id AS pos FROM generation.vocab_dominant_pos(p_vocab) wp
    ),
    nclasses AS (SELECT count(DISTINCT pos)::float8 AS n FROM word_pos),
    pairs AS (
        SELECT wo.subject_id AS x, wo.object_id AS y, wo.w AS c
        FROM generation.word_order(p_vocab, p_trajs, 1) wo
    ),
    class_pairs AS (
        SELECT wx.pos AS px, wy.pos AS py, sum(p.c) AS c
        FROM pairs p
        JOIN word_pos wx ON wx.wid = p.x
        JOIN word_pos wy ON wy.wid = p.y
        GROUP BY wx.pos, wy.pos
    ),
    class_marginals AS (
        SELECT cp.px, sum(cp.c) AS cx FROM class_pairs cp GROUP BY cp.px
    )
    SELECT cp.px, cp.py,
           ln((cp.c + p_smooth_k) / (cm.cx + p_smooth_k * nc.n))
    FROM class_pairs cp
    JOIN class_marginals cm ON cm.px = cp.px
    CROSS JOIN nclasses nc;
END;
$$;
