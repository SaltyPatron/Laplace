-- First-constituent index over the Content trajectory: which compositions
-- begin with this child, as one range scan (a first-codepoint browse needs no
-- realized names). Maintained transactionally on write.
--
-- The expression uses only laplace_trajectory_constituent_ids, which
-- laplace_geom has always exported: laplace_geom has no upgrade script and an
-- index expression is evaluated at CREATE INDEX, so a newer geom function would
-- fail on an installed database.
CREATE INDEX IF NOT EXISTS physicalities_traj_first_id_btree
    ON physicalities (((public.laplace_trajectory_constituent_ids(trajectory))[1]))
    WHERE trajectory IS NOT NULL AND type = 1;
