-- DUCET range index for the prefix-stable Unicode floor.
--
-- The legacy index used x^2+y^2 because bounded Super-Fibonacci made DUCET rank
-- literally monotone in Hopf latitude.  That coupling created the visible
-- "pool-ball stripe": an early DUCET prefix occupied an early radial band.
--
-- Open placement intentionally bit-reverses the radial parameter, so index the
-- reversible zero-based rank itself.  The expression is immutable and exactly
-- matches ops.ducet_ordered().
CREATE INDEX IF NOT EXISTS physicalities_ducet_rank_btree
    ON physicalities ((
        public.laplace_super_fibonacci_open_index(
            coord, laplace.atom_window())
    ));
