-- Entity-id keyed structural KNN with S³ coords (explore glome overlay).
-- Unlike structural.neighbors(text), does not re-resolve via prompt_state.
--
-- Shape axis: Frechet over REALIZED curves (entity_curve), never packed
-- laplace.physicalities.trajectory (Rule #3 / Issue 51).
-- GH #862 / #860: structural.neighbors_of, no SET, real schema names.
DROP FUNCTION IF EXISTS laplace.structural_neighbors_of(bytea, integer);
CREATE OR REPLACE FUNCTION structural.neighbors_of(
    p_id bytea,
    p_k  integer DEFAULT 10)
    RETURNS TABLE(
        neighbor_id bytea,
        neighbor    text,
        x           double precision,
        y           double precision,
        z           double precision,
        m           double precision,
        radius      double precision,
        geodesic    double precision,
        frechet     double precision)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    WITH anchor AS MATERIALIZED (
        SELECT e.coord,structural.entity_curve(p_id) AS curve
        FROM public.laplace_entities(ARRAY[encode(p_id,'hex')::public.blake3]) e
    ), nearest AS MATERIALIZED (
        SELECT n.* FROM anchor a CROSS JOIN LATERAL
            structural.angular_nearest(a.coord,p_k,NULL,p_id) n
    ), labels AS MATERIALIZED (
        SELECT * FROM public.laplace_labels(ARRAY(SELECT encode(entity_id,'hex')::public.blake3 FROM nearest ORDER BY entity_id))
    )
    SELECT n.entity_id,coalesce(l.content,'Unrealized entity'),
           public.ST_X(n.coord),public.ST_Y(n.coord),public.ST_Z(n.coord),public.ST_M(n.coord),
           public.laplace_radius_origin(n.coord),n.distance,
           public.laplace_frechet_4d(structural.entity_curve(n.entity_id),a.curve)
    FROM nearest n CROSS JOIN anchor a LEFT JOIN labels l ON l.entity=encode(n.entity_id,'hex')::public.blake3
    ORDER BY n.distance,n.entity_id;
END;
