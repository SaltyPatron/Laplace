-- One round of the trunk-to-leaf existence probe. The caller descends by tier
-- so it can stop at children of a proven node; tier schedules the walk but is
-- not a key. Presence is by content id alone, and a bit is set only by a
-- positive perfcache/codepoint hit or a committed row.
CREATE OR REPLACE FUNCTION laplace.tier_batch_existence_probe(ids bytea[])
    RETURNS bytea
    AS 'EXECUTION_LIBRARY', 'pg_laplace_tier_batch_existence_probe'
    LANGUAGE C STABLE;

-- Two-array call shape for rounds that carry tiers; tiers are ignored.
CREATE OR REPLACE FUNCTION laplace.tier_batch_existence_probe(ids bytea[], tiers smallint[])
    RETURNS bytea
    LANGUAGE sql STABLE PARALLEL RESTRICTED
BEGIN ATOMIC
    SELECT laplace.tier_batch_existence_probe(ids);
END;
