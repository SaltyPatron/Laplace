-- converse.walk(prompt, steps, seed): the FUSED free-form walk.
--
-- Sequence PROPOSES, meaning STEERS -- now with real semantic steering:
--   ORIENT  -> the prompt's richest concept synset (as converse.converse()).
--   GATHER  -> ordered token trajectories of the concept's own attested sentence
--              (weight 50, the seed) plus the tier-3 sentences that contain the
--              topic word (weight 40). Drawn from physicality trajectories =
--              precedes/follows/co-occurrence. Each token carries its source's
--              topic weight, so the corpus knows what is central vs peripheral.
--              Set-based: laplace.render_text runs once per DISTINCT token id to drop
--              whitespace laplace.constituents(the old loop rendered every occurrence
--              of every token of every sentence).
--   WALK    -> converse.steered_walk_raw(steered_walk.c): trigram->bigram backoff over
--              the restricted stream, SEEDED from the core concept's own
--              sentence and STEERED by topic weight (RNG breaks ties), with the
--              anti-repeat guard forcing novel recombination at shared n-gram
--              pivots. Ends at a sentence boundary once it has said enough.
--              Grounded only in attested token order; deterministic per seed.
--   REALIZE -> laplace.render_text of the emitted token ids.
DROP FUNCTION IF EXISTS laplace.converse_walk(text, int, bigint);
CREATE OR REPLACE FUNCTION converse.walk(p_prompt text, p_steps int DEFAULT 40,
                                         p_seed bigint DEFAULT NULL)
    RETURNS text
    LANGUAGE plpgsql VOLATILE AS $$
DECLARE
    -- Only the definitional band survives here: it selects the concept's own gloss
    -- as the GATHER seed below. The taxonomic/partitive/associative constants went
    -- with the orientation block that used them for band-mass. They were magic
    -- integers duplicated across this file, converse.converse() and converse.facts() anyway
    -- -- converse.relation_band_catalog() is the published surface for band identity.
    b_def  int := 1;   -- definitional band (gloss)
    -- Resolved once (see converse_facts): a function on consensus.type_id is a
    -- function on the partition key, so it prunes nothing and runs per edge.
    t_def  bytea[];
    SENT   bytea := '\x00';
    MINLEN int := 5;
    syn    bytea;
    topic_word bytea;   -- the tier-2 word whose usage lives in the tier above
    stream bytea[];
    w      bigint[];    -- per-token topic weight, aligned to stream
    starts bytea[];     -- starts of CORE sentences (on-topic seed)
    core_seq bytea[];   -- longest CORE gloss (deterministic seed)
    n      int;
    rng    bigint;
    out_ids bytea[];
BEGIN
    t_def := consensus.relation_band_types(b_def);
    -- ORIENT: the same native election converse.chat() and converse.converse() run — one election,
    -- one key order, so the three cannot disagree about what a prompt is about.
    -- prompt_coherence returns the elected TOKEN alongside its synset, which is
    -- what this lane needs for the tier fan-out below, so both come off one call.
    --
    -- This replaces a verbatim copy of converse.converse()'s pre-specificity ranking. Its
    -- primary sort key was lower(realize.realize(x.syn)) = x.surface -- case-folding used
    -- as an identity test. "King" and "king" are different content and therefore
    -- different ids, and the substrate already attests the link both ways
    -- (K --HAS_LOWERCASE_MAPPING--> k, k --HAS_UPPERCASE_MAPPING--> K, resolved
    -- natively by word_case_variants); lower() discards those edges to re-derive a
    -- worse answer in string space, per row. The rest of that block was two renders
    -- per candidate, a char_length tiebreak, a 29.6s correlated band-mass count and
    -- a 73s top_synset per token. See converse.sql.in for the full ledger.
    SELECT y.tok, y.synset_id INTO topic_word, syn
    FROM converse.prompt_coherence(p_prompt) y
    ORDER BY y.specificity DESC NULLS LAST,
             y.rel_mass DESC NULLS LAST,
             y.peers DESC,
             y.ord DESC,
             y.denote_mu DESC NULLS LAST,
             y.synset_id
    LIMIT 1;
    IF syn IS NULL THEN RETURN NULL; END IF;

    -- GATHER: the concept's own gloss (tier-1 definition, the seed) PLUS the
    -- TIER FAN-OUT -- a word's usage lives in the tier above it, so pull the
    -- tier-3 sentences that contain the topic word as a constituent (dense real
    -- usage) via the laplace.constituents index. This is the corpus, not just the gloss.
    -- Word-level tokens only: the inter-word whitespace laplace.constituents are
    -- dropped, else (word,space) bigrams match every boundary and the walk
    -- jumps (e.g. "a"+space -> "creek" from "...than a creek").
    -- The corpus is ranked by the WEB, not by storage order. containers_of walks
    -- the trajectory constituent index, which is GEOMETRY -- identity and
    -- retrieval, never semantics. What a candidate sentence is WORTH is the
    -- Glicko fold's answer, and it is already on the edge that attests it.
    --
    -- The old ORDER BY was `is_core DESC, gid`: content-hash order. MEASURED on
    -- 'water', of the 400 tier-3 containers returned, 398 are the object of a
    -- HAS_DEFINITION consensus edge whose laplace.eff_mu spans 1.17e12 to 1.46e12 -- a
    -- 25% spread, witness_count up to 4. The signal was sitting on 99.5% of the
    -- candidates and the corpus that decides what this engine SAYS was picked by
    -- hash instead.
    --
    -- Rank on the INBOUND edge (c.object_id = the sentence). A usage sentence is
    -- rated by what attests it -- HAS_DEFINITION, HAS_EXAMPLE -- not by anything
    -- it asserts itself; probing c.subject_id finds almost nothing (4 of 400) and
    -- is the wrong direction. LEFT JOIN so an unrated candidate still competes at
    -- the neutral prior rather than being silently dropped: absence of evidence is
    -- not evidence of worthlessness, and dropping it would be an
    -- operator-invented floor.
    --
    -- LIMIT 160 is now honest top-k -- a query LIMIT over a rated ordering, which
    -- is the only form of top-k the substrate law allows.
    WITH gids AS (
        -- DISTINCT: a gloss reachable through two def-band relation types
        -- contributes its token stream once, not twice.
        SELECT DISTINCT g.gid, g.wt, g.is_core FROM (
            SELECT c.object_id AS gid, 50::bigint AS wt, true AS is_core,
                   consensus.eff_mu(c.rating, c.rd) AS mu
            FROM laplace.consensus c
            WHERE c.subject_id = syn AND c.type_id = ANY (t_def)
            UNION ALL
            SELECT co.entity_id, 40, false,
                   COALESCE(MAX(consensus.eff_mu(k.rating, k.rd)), laplace.glicko2_neutral_mu())
            FROM structural.containers_of(topic_word, 1, 400) co
            LEFT JOIN laplace.consensus k ON k.object_id = co.entity_id
            WHERE co.tier = 3
            GROUP BY co.entity_id
            ORDER BY is_core DESC, mu DESC
            LIMIT 160
        ) g
    ),
    toks AS (
        -- The WHOLE attested constituent sequence, at whatever tier the content
        -- decomposed into. NO ctier filter: tier is a FLOOR, never an identity,
        -- so selecting the walk's alphabet by tier is a tokenizer -- the fixed
        -- vocabulary assumption this engine exists to replace.
        --
        -- What the filter discarded, MEASURED over 12 containers of 'water':
        --   ctier 0 : 164 laplace.constituents,  12 distinct  <- the separators
        --   ctier 2 : 144 laplace.constituents,  94 distinct  <- the words
        -- The separators were in the trajectory all along, in attested order.
        -- Dropping them is why REALIZE had to invent a ' ', false for every script
        -- that does not space its words.
        --
        -- The letter-by-letter worry the old comment recorded is real but narrow:
        -- a ONE-WORD gloss, where the tier-is-a-floor collapse makes the gloss root
        -- its own word, so unpacking reaches that word's codepoints. 12 distinct
        -- tier-0 ids across 12 sentences is punctuation, not spelling -- a word is
        -- a single tier-2 id. The cnt >= 2 guard below already drops the degenerate
        -- one-word case, and that is what actually handled it.
        SELECT g.gid, g.wt, g.is_core, u.entity_id, u.ord
        FROM gids g
        CROSS JOIN LATERAL generation.trajectory_unpacked_points(g.gid)
             WITH ORDINALITY AS u(entity_id, run_length, ctier, ord)
    ),
    -- The whitespace classification that sat here is GONE. It rendered every
    -- DISTINCT token to text to ask "is this blank" -- MEASURED on 'water' (1,645
    -- distinct tokens over 400 containers) at 29,899ms of a 48,435ms
    -- converse_walk, 18ms per token, purely to answer a predicate.
    --
    -- Against this stream it was a NO-OP as well as a cost: `toks` restricts to
    -- u.ctier = 2, and separator tokens live below tier 2, so the set it filtered
    -- could not contain one. Removing it left the emitted token sequence
    -- byte-identical and cut converse_walk 39,588ms -> 27,760ms.
    --
    -- The general form of the mistake is rendering an entity to text in order to
    -- classify it. corpus_whitespace_vocab_indices had the same shape and reading
    -- the attested HAS_GENERAL_CATEGORY instead measured 22.6ms against 29,899ms
    -- with zero disagreement (#688/#689). Nothing here needs to classify at all,
    -- so this just goes.
    kept AS MATERIALIZED (
        SELECT q.* FROM (
            SELECT t.gid, t.wt, t.is_core, t.entity_id,
                   row_number() OVER (PARTITION BY t.gid ORDER BY t.ord) AS rn,
                   count(*)    OVER (PARTITION BY t.gid) AS cnt
            FROM toks t
        ) q
        WHERE q.cnt >= 2
    ),
    seq AS MATERIALIZED (
        -- Each sentence's tokens in order, then one SENT boundary (weight 0)
        -- ordered past every real token of its sentence.
        SELECT k.gid, k.is_core, k.wt, k.entity_id AS id, k.rn
        FROM kept k
        UNION ALL
        SELECT DISTINCT k.gid, k.is_core, 0::bigint, SENT, 2147483647::bigint
        FROM kept k
    )
    SELECT (SELECT array_agg(s.id ORDER BY s.is_core DESC, s.gid, s.rn) FROM seq s),
           (SELECT array_agg(s.wt ORDER BY s.is_core DESC, s.gid, s.rn) FROM seq s),
           -- Core starts when the gloss survives; otherwise the fall-through
           -- the toks comment promises: a one-word gloss (an OMW/Wiktionary
           -- translation like "roi") leaves no core rows, and the walk seeds
           -- from the on-topic tier-3 usage sentences instead of going dark.
           COALESCE(
               (SELECT array_agg(k.entity_id ORDER BY k.gid) FROM kept k
                 WHERE k.is_core AND k.rn = 1),
               (SELECT array_agg(k.entity_id ORDER BY k.gid) FROM kept k
                 WHERE k.rn = 1)),
           (SELECT array_agg(k.entity_id ORDER BY k.rn) FROM kept k
             WHERE k.is_core AND k.gid = (
                 SELECT k2.gid FROM kept k2 WHERE k2.is_core
                 GROUP BY k2.gid ORDER BY max(k2.cnt) DESC, k2.gid LIMIT 1))
    INTO stream, w, starts, core_seq;

    n := COALESCE(array_length(stream,1), 0);
    IF n < 3 OR starts IS NULL THEN RETURN NULL; END IF;

    rng := abs(COALESCE(p_seed, ('x'||substr(md5(p_prompt),1,8))::bit(32)::bigint)) % 2147483647;

    -- SEED + WALK run natively; single-token results fall out of a seed with no
    -- attested successor (the old `IF b IS NULL` path).
    out_ids := converse.steered_walk_raw(stream, w, COALESCE(core_seq, ARRAY[]::bytea[]),
                                starts, p_steps, MINLEN, rng);
    IF out_ids IS NULL OR array_length(out_ids,1) IS NULL THEN RETURN NULL; END IF;
    IF array_length(out_ids,1) = 1 THEN RETURN realize.render_text(out_ids[1], 64); END IF;

    -- REALIZE: no punctuation scrub, no whitespace normalization. The old tail ran
    -- regexp_replace('\s*[();:]\s*') then regexp_replace('\s+') because REALIZE
    -- had just wedged a ' ' between every token, orphaning the brackets the gloss
    -- actually attested. With separators carried through, the spacing IS the
    -- corpus's -- scrubbing it overwrites testimony with a rule, and a
    -- hardcoded-ASCII one ([();:] says nothing about U+3001, U+060C or U+0E5A).
    RETURN btrim(
            -- laplace.render_text_batch over the DISTINCT emitted ids, re-expanded in
            -- emission order -- not laplace.render_text per row (MEASURED same-session on
            -- 1,645 tokens: 1,895ms batched against 15.6ms each, ~15.8x).
            -- laplace.render_text_batch and NOT realize_batch: they answer different
            -- questions. laplace.render_text reconstructs the content's bytes, realize
            -- LABELS an entity for a human -- realize.render_text(U+0020) is ' ' where
            -- realize.realize(U+0020) is 'SPACE', realize.render_text(U+0028) is '(' where realize
            -- is 'LEFT PARENTHESIS'. Generation emits content, so it renders.
            (WITH ids AS MATERIALIZED (
                 SELECT array_agg(DISTINCT u.t) AS a FROM unnest(out_ids) AS u(t)
             ),
             realized AS MATERIALIZED (
                 SELECT i.a AS a, realize.render_text_batch(i.a, 64) AS s FROM ids i
             ),
             m AS (
                 SELECT (r.a)[k] AS id, (r.s)[k] AS txt
                 FROM realized r, generate_subscripts(r.a, 1) AS k
             )
             SELECT string_agg(COALESCE(m.txt,''), '' ORDER BY gg.o)
             FROM unnest(out_ids) WITH ORDINALITY gg(t,o)
             LEFT JOIN m ON m.id = gg.t));
END;
$$;
