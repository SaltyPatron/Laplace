-- Exact realize.render() ladder for an aligned id array (content before names). Graph/name work is
-- batched; only cheap codepoint and final text projection remain per element.
DROP FUNCTION IF EXISTS laplace.render_batch(bytea[]);
CREATE OR REPLACE FUNCTION realize.render_batch(p_ids bytea[])
    RETURNS text[]
    AS 'EXECUTION_LIBRARY', 'pg_laplace_render_batch'
    LANGUAGE C STABLE STRICT PARALLEL SAFE;
