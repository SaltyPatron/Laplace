CREATE OR REPLACE FUNCTION chess.player_moves(
        p_position bytea, p_player bytea, p_as_white boolean,
        p_limit integer DEFAULT 12)
    RETURNS TABLE(next_position bytea, games bigint, score double precision)
    LANGUAGE sql STABLE PARALLEL SAFE AS $$
    -- Player-scoped repertoire: a PROVENANCE read over evidence, not a fold.
    -- GH #736: MOVE evidence rows carry context_id = the playing-EVENT they
    -- were played in, and the colour facts subject the shared LINE with
    -- context = that same event -- so this join threads CONTEXT equality (the
    -- events where the player held the colour), never the colour fact's
    -- subject: that is the line, and joining on it would cross every OTHER
    -- playing of the same content into his repertoire. The caller resolves
    -- which colour the player held from the position's side to move (moves out
    -- of a white-to-move position in his games are his only when he is White).
    -- score is the mover's net outcome in [0,1], weighted by observation_count
    -- (outcome is the net CLASS on the folded evidence row).
    SELECT a.object_id,
           sum(a.observation_count)::bigint AS games,
           (sum(a.outcome::double precision * a.observation_count)
                / (2.0 * sum(a.observation_count)))::double precision AS score
    FROM laplace.attestations a
    WHERE a.subject_id = p_position
      AND a.type_id = laplace.relation_type_id('MOVE')
      AND a.context_id IN (
            SELECT g.context_id
            FROM laplace.attestations g
            WHERE g.type_id = laplace.relation_type_id(
                      CASE WHEN p_as_white THEN 'HAS_WHITE' ELSE 'HAS_BLACK' END)
              AND g.object_id = p_player
              AND g.context_id IS NOT NULL)
    GROUP BY a.object_id
    ORDER BY games DESC
    LIMIT p_limit
$$;
