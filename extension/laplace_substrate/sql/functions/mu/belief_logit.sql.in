-- consensus.belief_logit(rating, deviation): the Native conservative standing as
-- log-odds of beating the anchor, so exp() of it is a Bradley-Terry weight on
-- belief. Strictly monotone in consensus.eff_mu.
CREATE OR REPLACE FUNCTION consensus.belief_logit(p_rating double precision, p_deviation double precision)
    RETURNS double precision
    LANGUAGE sql IMMUTABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT ln(c) - ln(1 - c)
    FROM (SELECT least(greatest(consensus.eff_mu(p_rating, p_deviation), 1e-300), 1 - 1e-16) AS c) s;
END;
