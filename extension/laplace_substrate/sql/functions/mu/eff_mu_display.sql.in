-- Display form of a conservative standing (consensus.eff_mu): three decimals of
-- the Native confidence. One definition; never re-derived inline.
CREATE OR REPLACE FUNCTION consensus.eff_mu_display(p_rating double precision, p_deviation double precision)
    RETURNS numeric LANGUAGE sql LAPLACE_IMMUTABLE
BEGIN ATOMIC
    SELECT round(consensus.eff_mu(p_rating, p_deviation)::numeric, 3);
END;

-- Display form of an already-read confidence.
CREATE OR REPLACE FUNCTION consensus.eff_mu_display(p_confidence double precision)
    RETURNS numeric LANGUAGE sql LAPLACE_IMMUTABLE
BEGIN ATOMIC
    SELECT round(p_confidence::numeric, 3);
END;
