-- Distinct subjects that participate as the subject of a consensus edge of
-- the given relation type. consensus is LIST(type_id), so the type equality
-- prunes to one partition; callers must not open-code that scan.
-- BEGIN ATOMIC: GH #764.
CREATE OR REPLACE FUNCTION consensus.subjects_of_type(p_type bytea)
    RETURNS TABLE(subject_id bytea)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT DISTINCT c.subject_id
    FROM laplace.consensus c
    WHERE c.type_id = p_type;
END;

CREATE OR REPLACE FUNCTION consensus.subjects_of_type(p_relation text)
    RETURNS TABLE(subject_id bytea)
    LANGUAGE sql STABLE PARALLEL SAFE
BEGIN ATOMIC
    SELECT s.subject_id
    FROM consensus.subjects_of_type(laplace.relation_type_id(p_relation)) s;
END;
