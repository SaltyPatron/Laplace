-- One exact Syzygy edge from the substrate-resident material graph.
--
-- Material ingest stores each table entry as three adjacent Projection vertices:
--
--     position (role 0, WDL/DTZ) -> typed move (role 1) -> position (role 2)
--
-- The projection constituent GIN finds the chunk containing the position.  Decoding
-- three adjacent vertices is independent of corpus size; no relation scan and no
-- per-position attestation join is involved.
CREATE OR REPLACE FUNCTION chess.syzygy_transition(p_position bytea)
    RETURNS TABLE(move_id bytea, next_position bytea, wdl integer, dtz integer)
    LANGUAGE sql STABLE PARALLEL SAFE ROWS 1
 AS $$
WITH chunks AS MATERIALIZED (
    SELECT p.entity_id, p.trajectory
    FROM laplace.physicalities p
    WHERE p.type = 3::smallint
      AND p.source_id = laplace.source_id('ChessSyzygy')
      AND p.trajectory IS NOT NULL
      AND public.laplace_trajectory_constituent_ids(p.trajectory)
            @> ARRAY[p_position]::bytea[]
),
vertices AS MATERIALIZED (
    SELECT c.entity_id AS chunk_id,
           u.ordinal,
           u.entity_id,
           u.flags,
           ((u.flags >> 8) & 3)::integer AS role
    FROM chunks c,
         LATERAL public.ST_DumpPoints(c.trajectory) dp,
         LATERAL public.laplace_mantissa_unpack(dp.geom) u
),
edge AS (
    SELECT m.entity_id AS move_id,
           n.entity_id AS next_position,
           ((s.flags >> 10) & 7)::integer AS wdl,
           (s.flags >> 16)::bigint AS zigzag_dtz
    FROM vertices s
    JOIN vertices m ON m.chunk_id = s.chunk_id
                   AND m.ordinal = s.ordinal + 1
                   AND m.role = 1
    JOIN vertices n ON n.chunk_id = s.chunk_id
                   AND n.ordinal = s.ordinal + 2
                   AND n.role = 2
    WHERE s.entity_id = p_position
      AND s.role = 0
    ORDER BY s.chunk_id, s.ordinal
    LIMIT 1
)
SELECT e.move_id,
       e.next_position,
       e.wdl,
       ((e.zigzag_dtz >> 1) # -(e.zigzag_dtz & 1))::integer AS dtz
FROM edge e
$$;
