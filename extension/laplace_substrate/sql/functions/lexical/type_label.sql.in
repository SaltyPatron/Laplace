-- NO `SET search_path` (GH #617 item 6). This is a labeling scalar called PER ROW in
-- every arrow render and relation listing; the clause made each of those a full
-- non-inlined function execution for one string operation.
--
-- STRICT is KEPT (LAPLACE_STABLE_STRICT). It also blocks inlining, but here it is
-- load-bearing rather than incidental: render(NULL) is the label of nothing, and the
-- callers -- realize_path, the walk responders -- COALESCE a NULL type_label to '?'
-- to mark an unrenderable relation. Dropping STRICT would push NULL through
-- replace()/lower() and still return NULL, so the value is unchanged, but the
-- declaration is what documents that a NULL type has no label rather than a blank
-- one. The search_path clause was the free half of this win; STRICT is not.
CREATE OR REPLACE FUNCTION type_label(p_type bytea)
    RETURNS text
    LANGUAGE sql LAPLACE_STABLE_STRICT AS $$
    SELECT lower(replace(@extschema@.render(p_type), '_', ' '))
$$;
