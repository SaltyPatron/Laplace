    "stripe_session_id,stripe_checkout_url,created_at,expires_at "
    "FROM app.billing_quotes WHERE quote_id=$1")
SQL_QUERY("billing.record_usage", "text,text,text,int4,int8,timestamptz",
    "INSERT INTO app.billing_usage(quote_id,tenant,service_id,units,amount_cents,executed_at) "
    "VALUES($1,$2,$3,$4,$5,$6)")
SQL_QUERY("billing.usage_by_tenant", "text",
