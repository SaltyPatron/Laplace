-- Roster staleness detector for the highway-axis partition layout.
--
-- consensus/attestations are LIST-partitioned on type_id; only relations flagged
-- `hot = true` in engine/manifest/relation_types.toml get dedicated HASH(subject_id)
-- x8 partitions, and everything else shares ONE default heap+btree. That roster is
-- a human judgement about traffic, and it goes stale silently: a new decomposer can
-- become the single largest writer in the database while every one of its rows piles
-- into the default, and nothing says so. That is exactly how Tatoeba's
-- HAS_EXTERNAL_ID / IS_TRANSLATION_OF reached 4.8M rows in consensus_rdefault
-- (5.2 GB, the largest consensus table) — discovered only by watching an ingest's
-- input rate decay from 8,190 to 5,093 rec/s under LWLock.BufferContent contention.
--
-- This names the offenders from planner statistics, not by scanning both DEFAULT
-- partitions after every ingest. ANALYZE is already part of the completion envelope;
-- MCV frequency x reltuples gives the crowding population without turning a diagnostic
-- into a second corpus pass. Relations below the MCV roster are, by definition, not the
-- dominant crowding population this operation is meant to find.
--
-- Not part of substrate_health(): that function gates IDENTITY law. This is
-- physical layout, a different claim on a different layer.
DROP FUNCTION IF EXISTS laplace.consensus_partition_pressure(bigint);
DROP FUNCTION IF EXISTS ops.consensus_partition_pressure(bigint);
DROP FUNCTION IF EXISTS ops.consensus_partition_pressure();
CREATE OR REPLACE FUNCTION ops.consensus_partition_pressure()
RETURNS TABLE(
    tbl         text,
    relation    text,
    type_id     bytea,
    rows        bigint,
    pct_of_default numeric
)
LANGUAGE sql
STABLE
    AS $$
    WITH targets(tbl, relname) AS (
        VALUES ('consensus'::text, 'consensus_rdefault'::text),
               ('attestations'::text, 'attestations_rdefault'::text)
    ),
    stats AS (
        SELECT t.tbl,
               c.reltuples,
               s.most_common_vals::text::bytea[] AS vals,
               s.most_common_freqs AS freqs
        FROM targets t
        JOIN pg_class c ON c.relname = t.relname
        JOIN pg_namespace n ON n.oid = c.relnamespace AND n.nspname = '@extschema@'
        JOIN pg_stats s ON s.schemaname = '@extschema@'
                       AND s.tablename = t.relname
                       AND s.attname = 'type_id'
    ), raw AS MATERIALIZED (
        SELECT st.tbl,
               m.type_id,
               (m.freq * st.reltuples)::bigint AS rows,
               round((100.0 * m.freq)::numeric, 2) AS pct_of_default
        FROM stats st,
             LATERAL unnest(st.vals, st.freqs) AS m(type_id, freq)
    ), numbered AS MATERIALIZED (
      SELECT raw.*,
             row_number() OVER (ORDER BY rows DESC, tbl, type_id) AS rn
      FROM raw
    ), batch AS MATERIALIZED (
      SELECT realize.label_batch(array_agg(type_id ORDER BY rn)) AS labels FROM numbered
    )
    SELECT
        agg.tbl,
        b.labels[agg.rn] AS relation,
        agg.type_id,
        agg.rows,
        agg.pct_of_default
      FROM numbered agg CROSS JOIN batch b
     ORDER BY agg.rn;
$$;
