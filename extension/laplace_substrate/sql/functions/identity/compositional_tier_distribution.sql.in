-- BEGIN ATOMIC: distribution of canonical compositional entity floors.
CREATE OR REPLACE FUNCTION laplace.compositional_tier_distribution()
RETURNS TABLE(tier smallint, n bigint)
LANGUAGE sql
STABLE
BEGIN ATOMIC
    SELECT e.tier, count(*)::bigint
    FROM laplace.entities e
    WHERE e.type_id = ANY(laplace.compositional_type_ids())
    GROUP BY e.tier
    ORDER BY e.tier;
END;
